@@ -0,0 +1,109 @@
+"""Étapes `kpi` et `prevision` : Passage autoportant (Story 5.1)."""
+
+from datetime import date
+
+import polars as pl
+import pytest
+
+from tests.unit.chaine.environnement import DATE_ARRETE, INSTANT, horloge_figee, preparer_racine
+from usine.chaine.etapes import EtapeKpi, EtapePrevision
+from usine.composition import PassageLance, construire_rapport, lancer_rapport
+from usine.consultation.passage import ConsultationPassage
+from usine.contrats.config import ConfigUsine
+from usine.contrats.passage import ContextePassage, Etape, StatutEtape
+from usine.contrats.prevision import (
+    ContenuPrevisions,
+    FacteurExplicatif,
+    MethodePrevision,
+    Prevision,
+    StatutPrevision,
+)
+from usine.contrats.trace import EntreeTrace, TypeTrace
+from usine.ports.consultation import Consultation
+
+
+@pytest.fixture(scope="module")
+def passage(tmp_path_factory: pytest.TempPathFactory) -> PassageLance:
+    racine = preparer_racine(tmp_path_factory.mktemp("racine"))
+    return lancer_rapport(racine, DATE_ARRETE, horloge=horloge_figee())
+
+
+def _consultation(passage: PassageLance) -> ConsultationPassage:
+    return ConsultationPassage(passage.repertoire)
+
+
+def test_passage_autoportant(passage: PassageLance) -> None:
+    fichiers = {p.name for p in passage.repertoire.iterdir()}
+    assert {"kpi.parquet", "tendances.parquet", "previsions.json"} <= fichiers
+    assert not (passage.repertoire / "trace").exists() or not list(
+        (passage.repertoire / "trace").glob("previsions.jsonl")
+    )  # aucune Prévision : aucune trace
+    etapes = {e.etape: e.statut for e in passage.manifeste.etapes}
+    assert etapes[Etape.kpi] is StatutEtape.reussie
+    assert etapes[Etape.prevision] is StatutEtape.reussie
+
+
+def test_kpi_couvre_chaque_jour_ouvre(passage: PassageLance) -> None:
+    consultation = _consultation(passage)
+    jours = set(pl.read_parquet(passage.repertoire / "kpi.parquet").get_column("date").to_list())
+    assert jours == set(consultation.dates_disponibles())
+    assert max(jours) == DATE_ARRETE
+
+
+def test_tendances_a_la_date_d_arrete(passage: PassageLance) -> None:
+    tendances = _consultation(passage).tendances()
+    assert not tendances.is_empty()
+    assert tendances.get_column("date").max() == DATE_ARRETE
+
+
+def _ctx(passage: PassageLance, configuration: ConfigUsine) -> ContextePassage[Consultation]:
+    return ContextePassage(
+        DATE_ARRETE, passage.manifeste.passage_id, configuration, _consultation(passage)
+    )
+
+
+def test_etape_kpi_refuse_date_anterieure(passage: PassageLance) -> None:
+    rapport_conf = construire_rapport_configuration(passage)
+    etape = EtapeKpi(["X"], date(2026, 12, 1))
+    with pytest.raises(Exception, match="antérieure"):
+        etape.executer(_ctx(passage, rapport_conf))
+
+
+def construire_rapport_configuration(passage: PassageLance) -> ConfigUsine:
+    # `<racine>/sorties/passages/<date>/<id>`
+    racine = passage.repertoire.parents[3]
+    return construire_rapport(racine).configuration
+
+
+def _prevision() -> Prevision:
+    return Prevision(
+        date_arrete=DATE_ARRETE,
+        entite="E1",
+        methode=MethodePrevision.baseline,
+        statut=StatutPrevision.pas_de_sortie_projetee,
+        probabilite_numerateur=0,
+        probabilite_denominateur=1,
+        horizon_jours_ouvres=10,
+        facteurs=(FacteurExplicatif(nom="stock", libelle="Stock", numerateur=3, denominateur=1),),
+        version_grille="g1",
+    )
+
+
+def test_etape_prevision_une_trace_par_prevision(passage: PassageLance) -> None:
+    contenu = ContenuPrevisions(previsions=(_prevision(),), risques=())
+    etape = EtapePrevision("d1", horloge_figee(), lambda _consultation, _date: contenu)
+    resultat = etape.executer(_ctx(passage, construire_rapport_configuration(passage)))
+    assert resultat.sorties["previsions"] == contenu
+    (trace,) = resultat.traces
+    assert isinstance(trace, EntreeTrace)
+    assert trace.type_trace is TypeTrace.prevision
+    assert (trace.entite, trace.version_grille, trace.version_donnees) == ("E1", "g1", "d1")
+    assert trace.horodatage == INSTANT
+    assert trace.passage_id == passage.manifeste.passage_id
+
+
+def test_etape_prevision_sans_calcul_est_vide(passage: PassageLance) -> None:
+    etape = EtapePrevision("d1", horloge_figee())
+    resultat = etape.executer(_ctx(passage, construire_rapport_configuration(passage)))
+    assert resultat.sorties["previsions"] == ContenuPrevisions(previsions=(), risques=())
+    assert resultat.traces == ()
