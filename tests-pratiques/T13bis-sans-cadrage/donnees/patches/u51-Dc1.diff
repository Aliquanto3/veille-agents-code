+CalculPrevisions = Callable[[Consultation, date], ContenuPrevisions]
+"""Calcul déterministe des Prévisions et Risques (domaine de Prévision) à une Date d'arrêté."""
+
+
+def _trace_prevision(
+    prevision: Prevision, ctx: ContextePassage[Consultation], horodatage: datetime, version: str
+) -> EntreeTrace:
+    return EntreeTrace(
+        type_trace=TypeTrace.prevision,
+        horodatage=horodatage,
+        passage_id=ctx.passage_id,
+        date_arrete=prevision.date_arrete,
+        entite=prevision.entite,
+        cible=prevision.entite,
+        version_grille=prevision.version_grille,
+        version_donnees=version,
+        entree_pseudonymisee=", ".join(
+            f"{f.nom}={f.numerateur}/{f.denominateur}" for f in prevision.facteurs
+        ),
+        sortie=prevision.model_dump_json(),
+    )
+
+
+class EtapePrevision:
+    """Prévisions de sortie du rouge et Risques d'entrée en rouge, avec leurs traces (AD-16).
+
+    Le calcul est celui du domaine de Prévision, injecté : l'étape ne recalcule rien. Sans
+    calcul, le contenu est vide (aucune Prévision ni Risque).
+    """
+
+    def __init__(
+        self,
+        version_donnees: str,
+        horloge: Callable[[], datetime],
+        calcul: CalculPrevisions | None = None,
+    ) -> None:
+        self._version_donnees = version_donnees
+        self._horloge = horloge
+        self._calcul = calcul
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sortie `previsions` et une trace par Prévision (`trace/previsions.jsonl`)."""
+        contenu = (
+            self._calcul(ctx.consultation, ctx.date_arrete)
+            if self._calcul is not None
+            else ContenuPrevisions(previsions=(), risques=())
+        )
+        horodatage = self._horloge()
+        traces = tuple(
+            _trace_prevision(prevision, ctx, horodatage, self._version_donnees)
+            for prevision in contenu.previsions
+        )
+        return ResultatEtape(StatutEtape.reussie, {"previsions": contenu}, traces)
+
+
