+"""Architecture `raptor` : arbre de résumés par regroupement récursif, interrogé à plat (FR-23)."""
+
+import logging
+from pathlib import Path
+from typing import Annotated, Any, ClassVar
+
+import numpy as np
+from pydantic import Field, model_validator
+
+from wavelibrarian.architectures._passages import ecrire_passages
+from wavelibrarian.architectures.naive_rag import _LOT, _SOUS_DOSSIER, NaiveRag
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.ids import sha16
+from wavelibrarian.core.types import ModelRefMeta, ParsedCorpus, Passage
+from wavelibrarian.ports.architecture import ArchCapabilities, CorpusChange
+from wavelibrarian.ports.components import VectorStore
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.registry import register
+
+_log = logging.getLogger(__name__)
+
+_SYSTEM = (
+    "Résume fidèlement les passages suivants en un seul texte court, dans leur langue. "
+    "Ne garde que ce qu'ils affirment : n'ajoute aucune information."
+)
+
+
+@register("architecture", "raptor")
+class Raptor(NaiveRag):
+    """Arbre de résumés construit à l'indexation, puis recherche dense sur l'arbre aplati.
+
+    Niveau 0 : les feuilles (Passages du chunker). Chaque niveau n+1 regroupe les nœuds du niveau
+    n de façon gloutonne et déterministe : la graine est le premier nœud restant (ordre des
+    `passage_id`), le groupe est la graine et ses `group_max - 1` plus proches voisins (cosinus,
+    départage par id). Les groupes sont donc pleins ; seul le dernier groupe d'un niveau peut
+    compter moins de `group_min` nœuds (règle documentée : on ne fusionne pas ce reste). Chaque
+    groupe est résumé par le rôle `summarize`. La construction s'arrête à `max_depth` ou quand un
+    niveau ne compte plus qu'un nœud. Pas de mise à jour incrémentale : l'arbre est reconstruit.
+    Une Citation d'un nœud devient des Citations vers les Ancrages de ses feuilles (`labeled`).
+    """
+
+    name = "raptor"
+    capabilities = ArchCapabilities(incremental_update=False, retrieval_method="ranked")
+    query_params: ClassVar[frozenset[str]] = frozenset({"k"})
+
+    class Params(NaiveRag.Params):
+        group_min: int = Field(default=5, gt=0)
+        group_max: int = Field(default=10, gt=0)
+        max_depth: int = Field(default=3, gt=0)
+        summarize_model: Annotated[str | None, ModelRefMeta("generator_models[0]")] = None
+        summary_max_tokens: int = Field(default=256, gt=0)
+
+        @model_validator(mode="after")
+        def _coherence(self) -> "Raptor.Params":
+            if self.group_max < 2:
+                raise ValueError("`group_max` doit valoir au moins 2")
+            if self.group_min > self.group_max:
+                raise ValueError("`group_min` ne peut pas dépasser `group_max`")
+            return self
+
+    def __init__(self, params: Any, ctx: Any) -> None:
+        if params.retriever.name != "dense":
+            raise ConfigError(
+                "retriever",
+                f"`raptor` cherche dans l'index dense de l'arbre aplati : retriever `dense` "
+                f"seul, pas `{params.retriever.name}`",
+            )
+        super().__init__(params, ctx)
+        self._summarize_model: str = (
+            params.summarize_model or ctx.profile.defaults.generator_models[0]
+        )
+
+    def _encoder_vecteurs(self, store: VectorStore, passages: list[Passage]) -> Any:
+        """Encode par lots, remplit le store et rend les vecteurs unitaires (un par Passage)."""
+        morceaux = []
+        for debut in range(0, len(passages), _LOT):
+            lot = passages[debut : debut + _LOT]
+            vecteurs = np.asarray(
+                self.embedder.embed_passages([p.text for p in lot]), dtype=np.float32
+            )
+            store.add([p.passage_id for p in lot], vecteurs)
+            morceaux.append(vecteurs)
+        matrice = np.concatenate(morceaux) if morceaux else np.zeros((0, 0), np.float32)
+        normes = np.linalg.norm(matrice, axis=1, keepdims=True) if len(matrice) else matrice
+        return matrice / np.where(normes > 0.0, normes, 1.0) if len(matrice) else matrice
+
+    def _groupes(self, noeuds: list[Passage], vecteurs: Any) -> list[list[Passage]]:
+        """Regroupement glouton : `noeuds` triés par id, `vecteurs` alignés et unitaires."""
+        taille: int = self.params.group_max  # type: ignore[attr-defined]
+        restants = list(range(len(noeuds)))
+        groupes: list[list[Passage]] = []
+        while restants:
+            graine, autres = restants[0], restants[1:]
+            sims = {i: float(vecteurs[graine] @ vecteurs[i]) for i in autres}
+            voisins = sorted(autres, key=lambda i: (-sims[i], noeuds[i].passage_id))
+            choisis = [graine, *voisins[: taille - 1]]
+            pris = set(choisis)
+            restants = [i for i in restants if i not in pris]
+            groupes.append(sorted((noeuds[i] for i in choisis), key=lambda p: p.passage_id))
+        return groupes
+
+    def _resumer(self, enfants: list[Passage], niveau: int) -> str:
+        texte = "\n\n".join(p.text for p in enfants)
+        requete = LLMRequest(
+            model_id=self._summarize_model,
+            role="summarize",
+            step=f"raptor.summarize.level{niveau}",
+            system=_SYSTEM,
+            messages=(Message(role="user", content=texte),),
+            max_tokens=self.params.summary_max_tokens,  # type: ignore[attr-defined]
+            seed=self.ctx.seed,  # type: ignore[attr-defined]
+            inputs={"text": texte},
+        )
+        resume = str(self.ctx.gateway.complete(requete).text).strip()  # type: ignore[attr-defined]
+        if not resume:
+            _log.warning(
+                "raptor : résumé vide au niveau %d, repli sur la concaténation des enfants", niveau
+            )
+            return texte
+        return resume
+
+    def _noeud(self, enfants: list[Passage], niveau: int) -> Passage:
+        ids = sorted(p.passage_id for p in enfants)
+        ancrages = tuple(dict.fromkeys(a for p in enfants for a in p.anchor_ids))
+        docs = {p.doc_id for p in enfants}
+        return Passage(
+            passage_id=sha16("node", "raptor", str(niveau), *ids),
+            doc_id=next(iter(docs)) if len(docs) == 1 else None,
+            text=self._resumer(enfants, niveau),
+            anchor_ids=ancrages,
+            level=niveau,
+            child_ids=tuple(ids),
+        )
+
+    def index(self, corpus: ParsedCorpus, directory: Path) -> None:
+        feuilles = [p for doc in corpus.documents for p in self.chunker.chunk(doc)]  # type: ignore[attr-defined]
+        feuilles.sort(key=lambda p: p.passage_id)
+        store = self._nouveau_store()
+        tous = list(feuilles)
+        courant, vecteurs = feuilles, self._encoder_vecteurs(store, feuilles)
+        niveau = 0
+        max_depth: int = self.params.max_depth  # type: ignore[attr-defined]
+        while niveau < max_depth and len(courant) > 1:
+            niveau += 1
+            noeuds = [self._noeud(g, niveau) for g in self._groupes(courant, vecteurs)]
+            noeuds.sort(key=lambda p: p.passage_id)
+            vecteurs = self._encoder_vecteurs(store, noeuds)
+            tous.extend(noeuds)
+            courant = noeuds
+        ecrire_passages(directory, tous)
+        store.save(directory / _SOUS_DOSSIER)
+
+    def update(
+        self,
+        change: CorpusChange,
+        corpus_after: ParsedCorpus,
+        old_directory: Path,
+        new_directory: Path,
+    ) -> None:
+        """Pas d'incrémental : l'arbre est reconstruit sur le corpus après changement."""
+        self.index(corpus_after, new_directory)
