@@ -13,3 +18,28 @@ app = typer.Typer(
 @app.callback()
 def principal() -> None:
     """WaveLibrarian : banc de comparaison des architectures de recherche documentaire IA."""
+
+
+@app.command("registre")
+def registre(
+    kind: Annotated[
+        str | None, typer.Option("--kind", help="Limite la liste à ce type de Composant.")
+    ] = None,
+) -> None:
+    """Liste les Composants et Architectures enregistrés, avec leurs Params."""
+    try:
+        registry.discover()
+        entrees = registry.list_components(kind=kind)
+    except ConfigError as erreur:
+        typer.echo(f"Erreur : {erreur}", err=True)
+        raise typer.Exit(1) from erreur
+    if not entrees:
+        typer.echo("Aucun Composant enregistré.")
+        return
+    for entree in entrees:
+        typer.echo(f"{entree.kind}/{entree.name} : {entree.description or '(sans description)'}")
+        if not entree.params:
+            typer.echo("  Params : aucun")
+        for p in entree.params:
+            defaut = "requis" if p.required else f"défaut {p.default!r}"
+            typer.echo(f"  - {p.name} ({p.type}) : {defaut}")
