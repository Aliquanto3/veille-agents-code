index 0000000..f4d4cdd
--- /dev/null
+++ b/tests/unit/ui/test_outillage.py
@@ -0,0 +1,23 @@
+"""Écran « Ce qu'il faut pour le faire en vrai » : lecture de la fiche d'outillage."""
+
+from pathlib import Path
+
+from usine.ui.outillage import FICHE_ABSENTE, FICHIER_FICHE, LEGENDE, lire_fiche
+
+DEPOT = Path(__file__).resolve().parents[3]
+
+
+def test_lire_fiche_du_depot() -> None:
+    fiche = lire_fiche(DEPOT)
+    assert fiche == (DEPOT / FICHIER_FICHE).read_text(encoding="utf-8")
+    assert "Demandes, par ordre de priorité" in fiche
+    assert "Correspondance par brique" in fiche
+
+
+def test_lire_fiche_absente(tmp_path: Path) -> None:
+    assert lire_fiche(tmp_path) is None
+
+
+def test_textes() -> None:
+    assert FICHIER_FICHE in FICHE_ABSENTE
+    assert FICHIER_FICHE in LEGENDE
