+"""Tâche `doublons` : paires d'Anomalies ouvertes probablement en doublon (FR-36).
+
+Tâche locale d'AD-12 : déterministe, sans appel au fournisseur, à la passerelle ni au cache.
+Le titre et la description de chaque Anomalie ouverte sont pseudonymisés par le callable
+injecté (en production, `Pseudonymiseur.apercu`, qui n'écrit pas la table), puis comparés par
+l'indice de Jaccard des mots normalisés, entre Anomalies d'une même Entité. Les paires sont des
+suggestions à revoir par le Pilote : aucune fusion, aucune écriture dans Jira.
+"""
+
+import re
+import unicodedata
+from collections import defaultdict
+from collections.abc import Callable, Collection
+from datetime import date
+from itertools import combinations
+
+import polars as pl
+
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import PaireDoublon, SortieDoublons, StatutControle
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import SCHEMA_TICKET_TEXTE, TypeTicket, rang_cle
+
+SEUIL_DOUBLONS = 0.5
+"""Score de similarité à partir duquel une paire est proposée au Pilote."""
+
+_CLE_TICKET = re.compile(r"[A-Z]+-\d+")
+_MOT = re.compile(r"\w+")
+
+
+def _mots(texte: str) -> frozenset[str]:
+    """Mots normalisés du texte : clés de ticket retirées, minuscules, sans accents."""
+    sans_cles = _CLE_TICKET.sub(" ", texte).lower()
+    decompose = unicodedata.normalize("NFKD", sans_cles)
+    sans_accents = "".join(c for c in decompose if not unicodedata.combining(c))
+    return frozenset(_MOT.findall(sans_accents))
+
+
+def score_similarite(texte_a: str, texte_b: str) -> float:
+    """Indice de Jaccard des mots normalisés, de 0 à 1 (4 décimales) ; 0.0 si un texte est vide."""
+    mots_a, mots_b = _mots(texte_a), _mots(texte_b)
+    if not mots_a or not mots_b:
+        return 0.0
+    return round(len(mots_a & mots_b) / len(mots_a | mots_b), 4)
+
+
+def detecter_doublons(
+    textes: pl.DataFrame,
+    cles_ouvertes: Collection[str],
+    date_arrete: date,
+    pseudonymiser: Callable[[str], str],
+    seuil: float = SEUIL_DOUBLONS,
+) -> SortieDoublons:
+    """Paires d'Anomalies ouvertes d'une même Entité dont le score atteint `seuil`.
+
+    Triées par score décroissant puis par rang de clés ; `cle_a` précède `cle_b`. Un `seuil`
+    hors de 0 à 1 ou une table non conforme à `SCHEMA_TICKET_TEXTE` lèvent une `UsineErreur`.
+    """
+    if not 0 <= seuil <= 1:
+        raise UsineErreur(f"seuil de doublons {seuil} hors de l'intervalle 0 à 1")
+    valider(textes, SCHEMA_TICKET_TEXTE)
+    ouvertes = set(cles_ouvertes)
+    lignes = textes.filter(pl.col("type_ticket") == TypeTicket.anomalie.value)
+    groupes: dict[str | None, list[tuple[str, str]]] = defaultdict(list)
+    for ligne in sorted(lignes.iter_rows(named=True), key=lambda r: rang_cle(r["cle_ticket"])):
+        if ligne["cle_ticket"] not in ouvertes:
+            continue
+        texte = pseudonymiser(f"{ligne['titre'] or ''}\n{ligne['description'] or ''}")
+        groupes[ligne["entite"]].append((ligne["cle_ticket"], texte))
+
+    paires: list[PaireDoublon] = []
+    for membres in groupes.values():
+        for (cle_a, texte_a), (cle_b, texte_b) in combinations(membres, 2):
+            score = score_similarite(texte_a, texte_b)
+            if score >= seuil:
+                paires.append(PaireDoublon(cle_a=cle_a, cle_b=cle_b, score=score))
+    paires.sort(key=lambda p: (-p.score, rang_cle(p.cle_a), rang_cle(p.cle_b)))
+    return SortieDoublons(
+        date_arrete=date_arrete,
+        seuil=seuil,
+        paires=tuple(paires),
+        statut_controle=StatutControle.non_controle,
+    )
diff --git a/tests/unit/ia/test_doublons.py b/tests/unit/ia/test_doublons.py
