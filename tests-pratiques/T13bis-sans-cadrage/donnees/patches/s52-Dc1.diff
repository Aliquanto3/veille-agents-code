+"""Fonctions de texte partagées (AD-29) : normalisation, mots, nombres, Kandel-Moles.
+
+Le banc, l'anti-fuite et la construction du jeu appellent ces seules fonctions, afin
+qu'un score soit calculé d'une seule façon. Toute modification d'une règle incrémente
+`VERSION_TEXTE` ; le test de non-régression des valeurs de référence l'exige.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from decimal import Decimal
+
+VERSION_TEXTE = 1
+
+_VOYELLES = "aeiouyàâäéèêëîïôöùûüÿœæ"
+_GROUPE_VOCALIQUE = re.compile(f"[{_VOYELLES}]+")
+_FIN_PHRASE = re.compile(r"(?<=[.!?…])\s+")
+_NOMBRE = re.compile(
+    r"(?<![\d.,])"
+    r"(\d{1,3}(?: \d{3})+(?:[.,]\d+)?|\d+(?:[.,]\d+)?)"
+    r"(?![\d])"
+)
+
+
+def normaliser(texte: str) -> str:
+    """Normalise en NFKC, minuscules, sans ponctuation, avec des espaces uniques.
+
+    Les caractères de ponctuation et de symboles sont remplacés par une espace.
+    La fonction est idempotente.
+    """
+    texte = unicodedata.normalize("NFKC", texte).casefold()
+    texte = "".join(" " if unicodedata.category(c)[0] in "PSZC" else c for c in texte)
+    return " ".join(unicodedata.normalize("NFKC", texte).split())
+
+
+def _mots(texte: str) -> list[str]:
+    """Mots séparés par des blancs et contenant au moins un caractère alphanumérique."""
+    texte = unicodedata.normalize("NFKC", texte)
+    return [m for m in texte.split() if any(c.isalnum() for c in m)]
+
+
+def compter_mots(texte: str) -> int:
+    """Nombre de mots (segments séparés par des blancs, ponctuation seule exclue)."""
+    return len(_mots(texte))
+
+
+def decouper_phrases(texte: str) -> list[str]:
+    """Découpe en phrases après `.`, `!`, `?` ou `…` suivis d'un blanc ; sans phrase vide."""
+    texte = unicodedata.normalize("NFKC", texte).strip()
+    return [p.strip() for p in _FIN_PHRASE.split(texte) if p.strip()]
+
+
+def extraire_nombres(texte: str) -> list[Decimal]:
+    """Extrait les nombres écrits à la française, dans l'ordre d'apparition.
+
+    Espace (y compris insécable) comme séparateur de milliers, virgule décimale :
+    « 1 234,56 € » donne `Decimal("1234.56")`. Le point décimal est aussi accepté.
+    """
+    texte = unicodedata.normalize("NFKC", texte)
+    return [Decimal(m.group(1).replace(" ", "").replace(",", ".")) for m in _NOMBRE.finditer(texte)]
+
+
+def syllabes(texte: str) -> int:
+    """Compte les syllabes par groupes vocaliques, avec la règle du e muet final.
+
+    Un « e » final seul (précédé d'une consonne) n'est pas compté, sauf dans un mot
+    d'une seule syllabe (« le », « de »). Sur un texte, somme sur ses mots.
+    """
+    total = 0
+    for mot in _mots(texte):
+        for segment in re.findall(r"[^\W\d_]+", mot.casefold()):
+            groupes = _GROUPE_VOCALIQUE.findall(segment)
+            n = len(groupes)
+            if n > 1 and segment.endswith("e") and groupes[-1] == "e":
+                n -= 1
+            total += n
+    return total
+
+
+def kandel_moles(texte: str) -> float:
+    """Indice de Kandel-Moles : 207 − 1,015 × mots/phrase − 73,6 × syllabes/mot."""
+    mots = compter_mots(texte)
+    phrases = len(decouper_phrases(texte))
+    if mots == 0 or phrases == 0:
+        raise ValueError("Indice de Kandel-Moles indéfini : le texte ne contient aucun mot.")
+    return 207 - 1.015 * mots / phrases - 73.6 * syllabes(texte) / mots
+
+
+def ngrammes(texte: str, n: int = 3) -> frozenset[tuple[str, ...]]:
+    """Ensemble des n-grammes de mots du texte normalisé (vide si moins de `n` mots)."""
+    if n < 1:
+        raise ValueError(f"La taille des n-grammes doit être au moins 1 : {n}.")
+    mots = normaliser(texte).split()
+    return frozenset(tuple(mots[i : i + n]) for i in range(len(mots) - n + 1))
