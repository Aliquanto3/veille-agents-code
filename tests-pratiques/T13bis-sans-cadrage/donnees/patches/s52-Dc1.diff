+"""Tests des fonctions de texte partagées (story 5.2) : valeurs calculées à la main."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+import pytest
+
+from slmsp.core.texte import (
+    VERSION_TEXTE,
+    compter_mots,
+    decouper_phrases,
+    extraire_nombres,
+    kandel_moles,
+    ngrammes,
+    normaliser,
+    syllabes,
+)
+
+SIMPLE = "Le chat dort."
+ADMINISTRATIF = "L'administration procède à la notification de la décision."
+
+
+@pytest.mark.parametrize(
+    ("brut", "attendu"),
+    [
+        ("  Bonjour,   MONDE !  ", "bonjour monde"),
+        ("L’État, c’est « moi » ; ça va.", "l état c est moi ça va"),
+        ("ﬁn du mois", "fin du mois"),
+        ("Ｔｅｓｔ １２３", "test 123"),
+        ("", ""),
+    ],
+)
+def test_normaliser(brut, attendu):
+    assert normaliser(brut) == attendu
+    assert normaliser(attendu) == attendu
+
+
+@pytest.mark.parametrize("brut", ["Été -- « Ça » !", "a  b\tc\n", "ﬁ ² 3,5 %"])
+def test_normaliser_idempotent(brut):
+    assert normaliser(normaliser(brut)) == normaliser(brut)
+
+
+def test_compter_mots_et_phrases():
+    assert compter_mots(SIMPLE) == 3
+    assert compter_mots(ADMINISTRATIF) == 8
+    assert compter_mots("Oui ! — non ?") == 2
+    assert decouper_phrases("Un. Deux ! Trois ? Prix : 3,5 euros.") == [
+        "Un.",
+        "Deux !",
+        "Trois ?",
+        "Prix : 3,5 euros.",
+    ]
+    assert decouper_phrases("   ") == []
+
+
+@pytest.mark.parametrize(
+    ("texte", "attendu"),
+    [
+        ("1 234,56 €", [Decimal("1234.56")]),
+        ("12,50 €", [Decimal("12.50")]),
+        ("25 €", [Decimal(25)]),
+        ("3,5 %", [Decimal("3.5")]),
+        ("1 234,56 € et 2 000 €", [Decimal("1234.56"), Decimal(2000)]),
+        ("Article 12 du code, 25 € puis 3,5 %.", [Decimal(12), Decimal(25), Decimal("3.5")]),
+        ("aucun nombre", []),
+    ],
+)
+def test_extraire_nombres(texte, attendu):
+    assert extraire_nombres(texte) == attendu
+
+
+@pytest.mark.parametrize(
+    ("mot", "attendu"),
+    [
+        ("le", 1),
+        ("chat", 1),
+        ("procède", 2),
+        ("notification", 5),
+        ("administration", 5),
+        ("vie", 1),
+        ("que", 1),
+        ("décision", 3),
+        ("", 0),
+    ],
+)
+def test_syllabes(mot, attendu):
+    assert syllabes(mot) == attendu
+
+
+def test_kandel_moles_valeurs_calculees_a_la_main():
+    # 3 mots, 1 phrase, 3 syllabes : 207 - 1,015 × 3 - 73,6 × 1
+    assert kandel_moles(SIMPLE) == pytest.approx(130.355, abs=0.1)
+    # 8 mots, 1 phrase, 19 syllabes : 207 - 1,015 × 8 - 73,6 × 19/8
+    assert kandel_moles(ADMINISTRATIF) == pytest.approx(24.08, abs=0.1)
+    # 2 phrases de 3 mots (6 syllabes) : mots/phrase = 3
+    assert kandel_moles(SIMPLE + " Il dort.") == pytest.approx(
+        207 - 1.015 * 5 / 2 - 73.6 * 1, abs=0.1
+    )
+
+
+def test_texte_simplifie_plus_lisible_que_version_administrative():
+    assert kandel_moles(SIMPLE) > kandel_moles(ADMINISTRATIF)
+
+
+def test_kandel_moles_texte_vide():
+    with pytest.raises(ValueError, match="aucun mot"):
+        kandel_moles("   ")
+
+
+def test_ngrammes():
+    assert ngrammes("Un chat, un CHAT dort", 2) == {
+        ("un", "chat"),
+        ("chat", "un"),
+        ("chat", "dort"),
+    }
+    assert ngrammes("un deux", 3) == frozenset()
+    with pytest.raises(ValueError, match="au moins 1"):
+        ngrammes("a b", 0)
+
+
+def test_non_regression_version_texte():
+    """Toute règle modifiée change ces valeurs : incrémenter `VERSION_TEXTE` ET ce test."""
+    assert VERSION_TEXTE == 1
+    reference = {
+        "normaliser": normaliser("L’État, c’est « moi » !"),
+        "mots": compter_mots(ADMINISTRATIF),
+        "syllabes": syllabes(ADMINISTRATIF),
+        "nombres": extraire_nombres("1 234,56 € et 3,5 %"),
+        "kandel": round(kandel_moles(ADMINISTRATIF), 2),
+    }
+    assert reference == {
+        "normaliser": "l état c est moi",
+        "mots": 8,
+        "syllabes": 19,
+        "nombres": [Decimal("1234.56"), Decimal("3.5")],
+        "kandel": 24.08,
+    }
