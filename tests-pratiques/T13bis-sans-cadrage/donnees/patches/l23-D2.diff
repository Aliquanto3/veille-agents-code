+"""Tests du Parser PDF et de son ingestion (story 2.3)."""
+
+from pathlib import Path
+
+import yaml
+from fpdf import FPDF
+
+from wavelibrarian import registry
+from wavelibrarian.components.parsers.pdf_text import PdfTextParser
+from wavelibrarian.core.ids import sha16_bytes
+from wavelibrarian.core.types import DocMeta
+from wavelibrarian.corpus.declare import declare
+from wavelibrarian.corpus.ingest import ingest
+
+
+def _pdf(pages: list[str]) -> bytes:
+    pdf = FPDF()
+    pdf.set_font("Helvetica", size=12)
+    for texte in pages:
+        pdf.add_page()
+        if texte:
+            pdf.cell(text=texte)
+    return bytes(pdf.output())
+
+
+def _parse(raw: bytes):
+    return PdfTextParser().parse("docs/registre.pdf", raw, "fr", DocMeta())
+
+
+def test_enregistrement_au_registre():
+    registry.discover()
+    assert "pdf_text" in registry.names("parser")
+    assert registry.get("parser", "pdf_text").formats == frozenset({"pdf"})
+
+
+def test_trois_pages_ancrees():
+    raw = _pdf(["Premiere page", "Deuxieme page", "Troisieme page"])
+    doc = _parse(raw)
+    d = sha16_bytes(raw)
+    assert doc.format == "pdf"
+    assert [b.anchor_id for b in doc.blocks] == [f"{d}#p1", f"{d}#p2", f"{d}#p3"]
+    assert [b.text for b in doc.blocks] == ["Premiere page", "Deuxieme page", "Troisieme page"]
+    assert list(doc.anchors) == [f"{d}#p1", f"{d}#p2", f"{d}#p3"]
+    assert [a.page for a in doc.anchors.values()] == [1, 2, 3]
+
+
+def test_page_sans_texte_garde_son_ancrage():
+    raw = _pdf(["Debut", "", "Fin"])
+    doc = _parse(raw)
+    d = sha16_bytes(raw)
+    assert list(doc.anchors) == [f"{d}#p1", f"{d}#p2", f"{d}#p3"]
+    assert [b.anchor_id for b in doc.blocks] == [f"{d}#p1", f"{d}#p3"]
+
+
+def _corpus(racine: Path, fichiers: dict[str, bytes]) -> Path:
+    docs = racine / "docs"
+    docs.mkdir(parents=True, exist_ok=True)
+    for nom, contenu in fichiers.items():
+        (docs / nom).write_bytes(contenu)
+    spec = {
+        "corpus_id": "demo",
+        "path": "docs",
+        "lang": "fr",
+        "license": "CC-BY-4.0",
+        "publishable": True,
+        "volatility": "low",
+    }
+    fichier = racine / "corpus.yaml"
+    fichier.write_text(yaml.safe_dump(spec), encoding="utf-8")
+    return fichier
+
+
+def test_pdf_illisible_ignore_et_resolve(tmp_path: Path, wl_home: Path):
+    bon = _pdf(["Un", "Deux"])
+    corpus = declare(
+        _corpus(tmp_path, {"registre.pdf": bon, "casse.pdf": bon[:40], "n.txt": b"texte"})
+    )
+    parse = ingest(corpus, wl_home=wl_home)
+    assert [d.source_path for d in parse.documents] == ["n.txt", "registre.pdf"]
+    d = sha16_bytes(bon)
+    assert parse.resolve("registre.pdf", 2, ()) == f"{d}#p2"
+    assert parse.resolve("registre.pdf", 9, ()) is None
