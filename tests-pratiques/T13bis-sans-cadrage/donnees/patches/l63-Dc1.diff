index 0000000..e1e2656
--- /dev/null
+++ b/tests/unit/architectures/test_story_6_3.py
@@ -0,0 +1,157 @@
+"""Story 6.3 : Architecture `hyde` (recherche dense par réponse hypothétique)."""
+
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pytest
+
+from wavelibrarian import registry
+from wavelibrarian.architectures.hyde import Hyde
+from wavelibrarian.core.types import ParsedCorpus, QuestionInput
+from wavelibrarian.llm.providers.fake import FakeProvider
+from wavelibrarian.ports.components import ComponentSpec
+from wavelibrarian.runner.context import Context as RunCtx
+
+PETITS = {"name": "fixed_tokens", "params": {"size": 40, "overlap": 5}}
+MARQUEUR = "zxqmarqueur"
+
+
+@pytest.fixture
+def ctx(tmp_path: Path):  # type: ignore[no-untyped-def]
+    provider = FakeProvider()
+    c = RunCtx.from_profile(
+        "test", wl_home=tmp_path / "wl", run_id="r-1", seed=1, providers={"fake": provider}
+    )
+    c.parser = "markdown"
+    c.provider = provider  # type: ignore[attr-defined]
+    with c:
+        yield c
+
+
+def _arch(ctx: RunCtx, nom: str = "hyde", **params: Any) -> Any:
+    params.setdefault("embedder", {"name": "fake"})
+    params.setdefault("chunker", PETITS)
+    return ctx.build("architecture", ComponentSpec(name=nom, params=params))
+
+
+def _charger(ctx: RunCtx, arch: Any, corpus: ParsedCorpus, dossier: Path) -> None:
+    with ctx.scope(post="indexing"):
+        arch.index(corpus, dossier)
+    arch.load(dossier)
+
+
+def _question() -> QuestionInput:
+    return QuestionInput(question_id="q-001", text="Que sait-on de la guilde Orvane ?", lang="fr")
+
+
+def _repondre(arch: Any, ctx: RunCtx) -> Any:
+    with ctx.scope(post="query", question_id="q-001"):
+        return arch.answer(_question())
+
+
+def _spans(ctx: RunCtx) -> list[dict[str, Any]]:
+    lignes = (ctx.run_dir / "traces.jsonl").read_text(encoding="utf-8").splitlines()
+    return [json.loads(x) for x in lignes]
+
+
+def test_hyde_est_enregistree_avec_ses_query_params() -> None:
+    assert registry.get("architecture", "hyde") is Hyde
+    assert Hyde.query_params == {"k", "mix_question", "hyde_model"}
+    assert Hyde.Params().mix_question is False
+
+
+def test_hyde_span_hyde_distinct_de_generate_au_poste_query(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    arch = _arch(ctx)
+    _charger(ctx, arch, minicorpus, tmp_path / "i")
+    _repondre(arch, ctx)
+    hyde = [s for s in _spans(ctx) if s["wl.step"] == "hyde"]
+    generate = [s for s in _spans(ctx) if s["wl.step"] == "generate"]
+    assert len(hyde) == 1
+    assert len(generate) == 1
+    assert hyde[0]["wl.post"] == "query"
+
+
+def test_hyde_le_vecteur_est_celui_de_la_reponse_hypothetique(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    arch = _arch(ctx)
+    _charger(ctx, arch, minicorpus, tmp_path / "i")
+    ctx.provider.script("hyde", "hyde", "Le phare de Keld brûle une flamme verte.")  # type: ignore[attr-defined]
+    vus: list[Any] = []
+    vrai = arch.retriever.retrieve
+
+    def espion(query: str, k: int, index: Any, query_vector: Any = None) -> Any:
+        vus.append(query_vector)
+        return vrai(query, k, index, query_vector)
+
+    monkeypatch.setattr(arch.retriever, "retrieve", espion)
+    _repondre(arch, ctx)
+    with ctx.scope(post="query"):
+        attendu = arch.embedder.embed_queries(["Le phare de Keld brûle une flamme verte."])[0]
+    assert len(vus) == 1
+    assert np.allclose(vus[0], attendu)
+
+
+def test_hyde_mix_question_moyenne_renormalisee(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    arch = _arch(ctx, mix_question=True)
+    _charger(ctx, arch, minicorpus, tmp_path / "i")
+    hypothese = "Le phare de Keld brûle une flamme verte."
+    ctx.provider.script("hyde", "hyde", hypothese)  # type: ignore[attr-defined]
+    vus: list[Any] = []
+    vrai = arch.retriever.retrieve
+
+    def espion(query: str, k: int, index: Any, query_vector: Any = None) -> Any:
+        vus.append(query_vector)
+        return vrai(query, k, index, query_vector)
+
+    monkeypatch.setattr(arch.retriever, "retrieve", espion)
+    _repondre(arch, ctx)
+    with ctx.scope(post="query"):
+        va, vq = arch.embedder.embed_queries([hypothese, _question().text])
+    moyenne = (np.asarray(va) + np.asarray(vq)) / 2
+    attendu = moyenne / np.linalg.norm(moyenne)
+    assert np.allclose(vus[0], attendu, atol=1e-6)
+    assert float(np.linalg.norm(vus[0])) == pytest.approx(1.0, abs=1e-5)
+
+
+def test_hyde_la_reponse_hypothetique_n_entre_ni_dans_le_contexte_ni_les_citations(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    arch = _arch(ctx)
+    _charger(ctx, arch, minicorpus, tmp_path / "i")
+    ctx.provider.script("hyde", "hyde", f"{MARQUEUR} phare Keld flamme")  # type: ignore[attr-defined]
+    reponse = _repondre(arch, ctx)
+    assert reponse.retrieved
+    assert all(MARQUEUR not in p.passage.text.lower() for p in reponse.retrieved)
+    assert MARQUEUR not in reponse.text.lower()
+    anchors = {a for p in reponse.retrieved for a in p.passage.anchor_ids}
+    assert {c.anchor_id for c in reponse.citations} <= anchors
+
+
+def test_hyde_passage_vise_par_la_reponse_hypothetique_au_rang_1(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    arch = _arch(ctx)
+    _charger(ctx, arch, minicorpus, tmp_path / "i")
+    cible = sorted(arch._index.passages.values(), key=lambda p: p.passage_id)[3]
+    ctx.provider.script("hyde", "hyde", cible.text)  # type: ignore[attr-defined]
+    reponse = _repondre(arch, ctx)
+    assert reponse.retrieved[0].passage.passage_id == cible.passage_id
+    assert reponse.retrieved[0].rank == 1
+
+
+def test_hyde_reutilise_l_index_de_naive_rag(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    naive = _arch(ctx, "naive_rag")
+    with ctx.scope(post="indexing"):
+        naive.index(minicorpus, tmp_path / "i")
+    hyde = _arch(ctx)
+    hyde.load(tmp_path / "i")
+    assert _repondre(hyde, ctx).retrieved
