+"""Tests du Parser pdf_text et de l'ingestion PDF (story 2.3)."""
+
+from pathlib import Path
+
+import pytest
+import yaml
+from fpdf import FPDF
+
+from wavelibrarian import registry
+from wavelibrarian.components.parsers.pdf_text import PdfTextParser
+from wavelibrarian.core.ids import sha16_bytes
+from wavelibrarian.core.types import DocMeta
+from wavelibrarian.corpus.declare import declare
+from wavelibrarian.corpus.ingest import ingest
+
+
+def _pdf(pages: list[str]) -> bytes:
+    """PDF généré par fpdf2 ; une page de texte vide reste sans texte extractible."""
+    pdf = FPDF()
+    pdf.set_font("Helvetica", size=12)
+    for texte in pages:
+        pdf.add_page()
+        if texte:
+            pdf.multi_cell(0, 10, texte)
+    return bytes(pdf.output())
+
+
+def _parse(raw: bytes):
+    return PdfTextParser().parse("docs/registre.pdf", raw, "fr", DocMeta())
+
+
+def test_enregistrement_au_registre():
+    registry.discover()
+    assert registry.get("parser", "pdf_text") is PdfTextParser
+    assert PdfTextParser.formats == frozenset({"pdf"})
+
+
+def test_trois_pages_ancrees_dès_1():
+    raw = _pdf(["Premiere page", "Deuxieme page", "Troisieme page"])
+    doc = _parse(raw)
+    did = sha16_bytes(raw)
+    assert doc.format == "pdf"
+    assert [b.anchor_id for b in doc.blocks] == [f"{did}#p1", f"{did}#p2", f"{did}#p3"]
+    assert [b.text for b in doc.blocks] == ["Premiere page", "Deuxieme page", "Troisieme page"]
+    assert all(b.kind == "text" for b in doc.blocks)
+    assert list(doc.anchors) == [f"{did}#p1", f"{did}#p2", f"{did}#p3"]
+    assert [a.page for a in doc.anchors.values()] == [1, 2, 3]
+    assert all(
+        a.source_path == "docs/registre.pdf" and a.doc_id == did for a in doc.anchors.values()
+    )
+
+
+def test_page_sans_texte_garde_son_ancrage():
+    raw = _pdf(["Debut", "", "Fin"])
+    doc = _parse(raw)
+    did = sha16_bytes(raw)
+    assert list(doc.anchors) == [f"{did}#p1", f"{did}#p2", f"{did}#p3"]
+    assert [b.anchor_id for b in doc.blocks] == [f"{did}#p1", f"{did}#p3"]
+
+
+def test_pdf_illisible_leve_valueerror():
+    raw = _pdf(["Une page", "Deux pages"])
+    with pytest.raises(ValueError, match="illisible"):
+        _parse(raw[: len(raw) // 3])
+
+
+def _corpus(racine: Path, fichiers: dict[str, bytes]) -> Path:
+    docs = racine / "docs"
+    docs.mkdir(parents=True)
+    for nom, contenu in fichiers.items():
+        (docs / nom).write_bytes(contenu)
+    spec = {
+        "corpus_id": "demo",
+        "path": "docs",
+        "lang": "fr",
+        "license": "CC-BY-4.0",
+        "publishable": True,
+        "volatility": "low",
+    }
+    fichier = racine / "corpus.yaml"
+    fichier.write_text(yaml.safe_dump(spec), encoding="utf-8")
+    return fichier
+
+
+def test_ingest_ignore_le_pdf_tronque_et_resolve(
+    tmp_path: Path, wl_home: Path, caplog: pytest.LogCaptureFixture
+):
+    bon = _pdf(["Un", "Deux", "Trois"])
+    fichier = _corpus(
+        tmp_path, {"registre.pdf": bon, "casse.pdf": bon[:50] + b"xx", "note.txt": b"bonjour"}
+    )
+    with caplog.at_level("WARNING"):
+        parse = ingest(declare(fichier), wl_home=wl_home)
+    assert [d.source_path for d in parse.documents] == ["note.txt", "registre.pdf"]
+    assert "casse.pdf" in caplog.text
+    did = sha16_bytes(bon)
+    assert parse.resolve("registre.pdf", 2, ()) == f"{did}#p2"
+    assert parse.resolve("registre.pdf", 9, ()) is None
+    assert parse.anchor_text(f"{did}#p3") == "Trois"
+    # seconde ingestion : relue depuis le cache
+    assert ingest(declare(fichier), wl_home=wl_home).documents[1] == parse.documents[1]
