+"""Parser PDF (pypdfium2) : un Ancrage `<doc_id>#p<page>` par page, numérotée à partir de 1 (AD-5).
+
+Une page sans texte extractible garde son Ancrage mais ne produit aucun Block.
+Pas d'OCR ni de détection de titres : l'Ancrage est la page.
+"""
+
+from typing import Any
+
+import pypdfium2
+from pydantic import BaseModel, ConfigDict
+
+from wavelibrarian.core.ids import sha16_bytes
+from wavelibrarian.core.types import Anchor, Block, DocMeta, ParsedDocument
+from wavelibrarian.registry import register
+
+
+@register("parser", "pdf_text")
+class PdfTextParser:
+    """PDF texte : un Block `text` par page non vide, sous l'Ancrage `#p<page>`."""
+
+    formats = frozenset({"pdf"})
+    version = "1"  # à incrémenter quand la sortie change : invalide le cache de parsing
+
+    class Params(BaseModel):
+        model_config = ConfigDict(extra="forbid", frozen=True)
+
+    def __init__(self, params: Any = None, ctx: Any = None) -> None:
+        pass
+
+    def parse(self, source_path: str, raw: bytes, lang: str, meta: DocMeta) -> ParsedDocument:
+        doc_id = sha16_bytes(raw)
+        anchors: dict[str, Anchor] = {}
+        blocks: list[Block] = []
+        try:
+            pdf = pypdfium2.PdfDocument(raw)
+            try:
+                for n in range(1, len(pdf) + 1):
+                    texte = self._texte_page(pdf, n - 1)
+                    aid = f"{doc_id}#p{n}"
+                    anchors[aid] = Anchor(
+                        anchor_id=aid, doc_id=doc_id, source_path=source_path, page=n
+                    )
+                    if texte:
+                        blocks.append(Block(text=texte, anchor_id=aid, kind="text"))
+            finally:
+                pdf.close()
+        except Exception as exc:
+            raise ValueError(f"PDF illisible : {source_path} ({exc})") from exc
+        return ParsedDocument(
+            doc_id=doc_id,
+            source_path=source_path,
+            format="pdf",
+            lang=lang,
+            blocks=tuple(blocks),
+            anchors=anchors,
+            meta=meta,
+        )
+
+    @staticmethod
+    def _texte_page(pdf: "pypdfium2.PdfDocument", index: int) -> str:
+        """Texte nettoyé d'une page (indice à partir de 0) ; ferme les ressources pdfium."""
+        page = pdf[index]
+        try:
+            textpage = page.get_textpage()
+            try:
+                brut = textpage.get_text_bounded()
+            finally:
+                textpage.close()
+        finally:
+            page.close()
+        return brut.replace("\r\n", "\n").replace("\r", "\n").strip()
