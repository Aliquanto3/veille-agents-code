+"""Tests du Parser pdf_text et de l'ingestion PDF (story 2.3)."""
+
+import logging
+from pathlib import Path
+
+import pytest
+import yaml
+from fpdf import FPDF
+
+from wavelibrarian import registry
+from wavelibrarian.components.parsers.pdf_text import PdfTextParser
+from wavelibrarian.core.ids import sha16_bytes
+from wavelibrarian.core.types import DocMeta, ParsedCorpus
+from wavelibrarian.corpus.declare import declare
+from wavelibrarian.corpus.ingest import ingest, parsers_par_format
+
+PAGES = ["Alpha premiere page", "", "Gamma troisieme page"]
+
+
+def _pdf(pages: list[str]) -> bytes:
+    pdf = FPDF()
+    for texte in pages:
+        pdf.add_page()
+        pdf.set_font("Helvetica", size=12)
+        if texte:
+            pdf.multi_cell(0, 10, texte)
+    return bytes(pdf.output())
+
+
+def _parse(raw: bytes, nom: str = "docs/registre.pdf"):
+    return PdfTextParser().parse(nom, raw, "fr", DocMeta())
+
+
+def _corpus(racine: Path, fichiers: dict[str, bytes]) -> Path:
+    for nom, contenu in fichiers.items():
+        cible = racine / nom
+        cible.parent.mkdir(parents=True, exist_ok=True)
+        cible.write_bytes(contenu)
+    spec = {
+        "corpus_id": "demo",
+        "path": ".",
+        "lang": "fr",
+        "license": "CC-BY-4.0",
+        "publishable": True,
+        "volatility": "low",
+    }
+    fichier = racine / "corpus.yaml"
+    fichier.write_text(yaml.safe_dump(spec), encoding="utf-8")
+    return fichier
+
+
+def test_enregistrement():
+    registry.discover()
+    assert registry.get("parser", "pdf_text") is PdfTextParser
+    assert PdfTextParser.formats == frozenset({"pdf"})
+    assert parsers_par_format(["pdf"]) == {"pdf": "pdf_text"}
+
+
+def test_trois_pages():
+    raw = _pdf(["Alpha un", "Beta deux", "Gamma trois"])
+    doc = _parse(raw)
+    d = sha16_bytes(raw)
+    assert doc.format == "pdf" and doc.doc_id == d
+    assert [b.anchor_id for b in doc.blocks] == [f"{d}#p1", f"{d}#p2", f"{d}#p3"]
+    assert [b.kind for b in doc.blocks] == ["text"] * 3
+    assert [b.text for b in doc.blocks] == ["Alpha un", "Beta deux", "Gamma trois"]
+    assert [a.page for a in doc.anchors.values()] == [1, 2, 3]
+    assert all(b.anchor_id in doc.anchors for b in doc.blocks)
+
+
+def test_page_vide():
+    raw = _pdf(PAGES)
+    doc = _parse(raw)
+    d = sha16_bytes(raw)
+    assert list(doc.anchors) == [f"{d}#p1", f"{d}#p2", f"{d}#p3"]
+    assert [b.anchor_id for b in doc.blocks] == [f"{d}#p1", f"{d}#p3"]
+    corpus = ParsedCorpus(corpus_id="c", fingerprint="f", documents=(doc,))
+    assert corpus.anchor_text(f"{d}#p2") == ""
+
+
+@pytest.mark.parametrize("tronque", [None, b"%PDF-1.4 tronque"])
+def test_pdf_illisible(tronque: bytes | None):
+    if tronque is None:
+        raw = _pdf(PAGES)
+        tronque = raw[: len(raw) // 2]
+    with pytest.raises(ValueError, match="PDF illisible"):
+        _parse(tronque)
+
+
+def test_ingest_signale_et_resolve(tmp_path: Path, wl_home: Path, caplog: pytest.LogCaptureFixture):
+    pdf = _pdf(PAGES)
+    fichiers = {
+        "docs/registre.pdf": pdf,
+        "docs/note.md": b"# N\n\nx",
+        "docs/casse.pdf": pdf[: len(pdf) // 2],
+    }
+    corpus = declare(_corpus(tmp_path, fichiers))
+    with caplog.at_level(logging.WARNING):
+        parse = ingest(corpus, wl_home=wl_home)
+    assert "Document illisible ignoré" in caplog.text
+    chemins = {d.source_path for d in parse.documents}
+    assert chemins == {"docs/registre.pdf", "docs/note.md"}
+    d = sha16_bytes(pdf)
+    assert parse.resolve("docs/registre.pdf", 2, ()) == f"{d}#p2"
+    assert parse.resolve("docs/registre.pdf", 9, ()) is None
+
+
+def test_seconde_ingestion_depuis_le_cache(tmp_path: Path, wl_home: Path):
+    pdf = _pdf(PAGES)
+    corpus = declare(_corpus(tmp_path, {"docs/registre.pdf": pdf}))
+    premier = ingest(corpus, wl_home=wl_home)
+    assert (wl_home / "parse_cache" / "pdf_text" / f"{sha16_bytes(pdf)}.json").is_file()
+    second = ingest(corpus, wl_home=wl_home)
+    assert second == premier
+    doc = second.documents[0]
+    assert [a.page for a in doc.anchors.values()] == [1, 2, 3]
