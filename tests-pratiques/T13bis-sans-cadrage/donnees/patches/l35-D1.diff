@@ -0,0 +1,217 @@
+"""Filtre closed-book et `wl questions closed-book` (story 3.5), Faux LLM seul."""
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+from typer.testing import CliRunner
+
+import wavelibrarian.cli as cli
+from wavelibrarian.cli import app
+from wavelibrarian.evalset import io
+from wavelibrarian.llm.providers.fake import FakeProvider
+from wavelibrarian.ports.gateway import LLMRequest
+from wavelibrarian.runner.context import Context
+
+
+def _question(i: int, **kw: Any) -> dict[str, Any]:
+    base: dict[str, Any] = {
+        "id": f"q-{i:03d}",
+        "type": "factual",
+        "follow_up": False,
+        "cross_lingual": False,
+        "text": f"Question numéro {i} ?",
+        "lang": "fr",
+        "reference_answer": "Élodie Varn",
+        "answer_form": "short",
+        "reference_anchors": [{"doc": "a.md", "headings": ["Guide", "Alpha"]}],
+        "status": "validated",
+        "split": None,
+        "contaminated_by": [],
+        "history": [],
+        "origin": {"kind": "human", "name": "anael"},
+        "scenario_target": None,
+    }
+    base.update(kw)
+    return base
+
+
+def _ecrire(chemin: Path, questions: list[dict[str, Any]], **kw: Any) -> Path:
+    doc: dict[str, Any] = {
+        "corpus_id": "demo",
+        "target_count": 10,
+        "freeze": None,
+        "questions": questions,
+    }
+    doc.update(kw)
+    chemin.write_text(yaml.safe_dump(doc, sort_keys=False, allow_unicode=True), encoding="utf-8")
+    return chemin
+
+
+class Env:
+    def __init__(self) -> None:
+        self.provider = FakeProvider()
+        self.requetes: list[LLMRequest] = []
+
+    def reponses(self, par_modele: dict[str, str]) -> None:
+        """Sortie scénarisée du rôle `closed_book`, par modèle interrogé."""
+
+        def _sortie(req: LLMRequest) -> str:
+            self.requetes.append(req)
+            return par_modele.get(req.model_id, req.inputs["text"])
+
+        self.provider.script("closed_book", "closed_book*", _sortie)
+
+    def juge(self, sortie: str) -> None:
+        def _sortie(req: LLMRequest) -> str:
+            self.requetes.append(req)
+            return json.dumps(
+                {"verdicts": {"correctness": {"verdict": sortie, "justification": "x"}}}
+            )
+
+        self.provider.script("judge", "judge*", _sortie)
+
+
+@pytest.fixture
+def env(wl_home: Path, monkeypatch: pytest.MonkeyPatch) -> Env:
+    e = Env()
+
+    def _contexte(profil: str, seed: int) -> Context:
+        return Context.from_profile(
+            "test", wl_home=wl_home, run_id="hors-1", seed=seed, providers={"fake": e.provider}
+        )
+
+    monkeypatch.setattr(cli, "_contexte_hors_execution", _contexte)
+    return e
+
+
+def _filtrer(fichier: Path, *args: str):
+    return CliRunner().invoke(
+        app, ["questions", "closed-book", str(fichier), "--profil", "test", *args]
+    )
+
+
+def _spans(wl_home: Path) -> list[dict[str, Any]]:
+    traces = wl_home / "hors-execution" / "hors-1" / "traces.jsonl"
+    return [json.loads(x) for x in traces.read_text(encoding="utf-8").splitlines()]
+
+
+def test_chaque_question_est_posee_sans_contexte_a_chaque_modele(tmp_path: Path, env: Env) -> None:
+    env.reponses({})
+    fichier = _ecrire(
+        tmp_path / "q.yaml",
+        [
+            _question(1),
+            _question(2, status="corrected"),
+            _question(3, type="unanswerable", reference_answer=""),
+            _question(4, status="generated"),
+            _question(5, status="rejected"),
+        ],
+    )
+    res = _filtrer(fichier, "--modeles", "fake-llm-a,fake-llm-b")
+    assert res.exit_code == 0, res.output
+    assert sorted((r.model_id, r.inputs["text"]) for r in env.requetes) == [
+        ("fake-llm-a", "Question numéro 1 ?"),
+        ("fake-llm-a", "Question numéro 2 ?"),
+        ("fake-llm-b", "Question numéro 1 ?"),
+        ("fake-llm-b", "Question numéro 2 ?"),
+    ]
+    assert all(r.role == "closed_book" and len(r.messages) == 1 for r in env.requetes)
+    assert "Questions posées : 2 ; écartées" in res.output
+
+
+def test_sans_modeles_la_liste_vient_du_profil(tmp_path: Path, env: Env) -> None:
+    env.reponses({})
+    fichier = _ecrire(tmp_path / "q.yaml", [_question(1)])
+    res = _filtrer(fichier)
+    assert res.exit_code == 0, res.output
+    assert [r.model_id for r in env.requetes] == ["fake-llm-a", "fake-llm-b", "fake-llm-c"]
+
+
+def test_reponse_courte_contaminee_par_correspondance_normalisee_sans_juge(
+    tmp_path: Path, env: Env
+) -> None:
+    env.reponses({"fake-llm-b": "C'est elodie  VARN, je crois."})
+    fichier = _ecrire(tmp_path / "q.yaml", [_question(1)])
+    res = _filtrer(fichier, "--modeles", "fake-llm-a,fake-llm-b")
+    assert res.exit_code == 0, res.output
+    assert io.load(fichier).questions[0].contaminated_by == ("fake-llm-b",)
+    assert all(r.role == "closed_book" for r in env.requetes)  # aucun appel au Juge
+
+
+def test_reponse_libre_jugee_par_un_modele_d_une_autre_famille(tmp_path: Path, env: Env) -> None:
+    env.reponses({})
+    env.juge("yes")
+    fichier = _ecrire(tmp_path / "q.yaml", [_question(1, answer_form="free")])
+    res = _filtrer(fichier, "--modeles", "fake-llm-a")
+    assert res.exit_code == 0, res.output
+    assert io.load(fichier).questions[0].contaminated_by == ("fake-llm-a",)
+    (juge,) = [r for r in env.requetes if r.role == "judge"]
+    assert juge.model_id == "fake-llm-c"  # premier du réservoir hors de la Famille de fake-llm-a
+
+
+def test_verdict_non_ne_contamine_pas(tmp_path: Path, env: Env) -> None:
+    env.reponses({})
+    env.juge("no")
+    fichier = _ecrire(tmp_path / "q.yaml", [_question(1, answer_form="free")])
+    assert _filtrer(fichier, "--modeles", "fake-llm-a").exit_code == 0
+    assert io.load(fichier).questions[0].contaminated_by == ()
+
+
+def test_faux_llm_par_defaut_aucune_contamination(tmp_path: Path, env: Env) -> None:
+    fichier = _ecrire(
+        tmp_path / "q.yaml",
+        [
+            _question(1),
+            _question(2, answer_form="free", text="Que dit le passage a ?"),
+        ],
+    )
+    res = _filtrer(fichier)
+    assert res.exit_code == 0, res.output
+    assert all(q.contaminated_by == () for q in io.load(fichier).questions)
+    assert "contaminées : 0" in res.output
+
+
+def test_jeu_gele_seul_contaminated_by_change_et_spans_judging(
+    tmp_path: Path, env: Env, wl_home: Path
+) -> None:
+    env.reponses({"fake-llm-a": "Élodie Varn"})
+    gel = {"sha256": "a" * 64, "at": "2026-10-17T00:00:00Z", "seed": 42, "dev_ratio": 0.4}
+    fichier = _ecrire(
+        tmp_path / "q.yaml",
+        [_question(1, split="dev", contaminated_by=["fake-llm-z"]), _question(2, split="test")],
+        freeze=gel,
+    )
+    avant = io.load(fichier)
+    res = _filtrer(fichier, "--modeles", "fake-llm-a")
+    assert res.exit_code == 0, res.output
+    apres = io.load(fichier)
+    assert apres.freeze == avant.freeze
+    assert apres.questions[0].contaminated_by == ("fake-llm-a",)  # recalculé, plus de fake-llm-z
+
+    def _sans_contamination(f: io.QuestionsFile) -> dict[str, Any]:
+        brut = f.model_dump(mode="json", exclude={"freeze"})
+        for q in brut["questions"]:
+            q.pop("contaminated_by")
+        return brut
+
+    assert _sans_contamination(apres) == _sans_contamination(avant)  # ce que couvre l'empreinte
+    spans = _spans(wl_home)
+    assert spans and all(s["wl.post"] == "judging" for s in spans)
+    assert {s["wl.question_id"] for s in spans} == {"q-001", "q-002"}
+
+
+def test_modele_inconnu_refuse_avant_tout_appel(tmp_path: Path, env: Env) -> None:
+    env.reponses({})
+    fichier = _ecrire(tmp_path / "q.yaml", [_question(1)])
+    res = _filtrer(fichier, "--modeles", "fake-llm-a,inconnu")
+    assert res.exit_code == 2
+    assert env.requetes == []
+
+
+def test_liste_de_modeles_mal_formee(tmp_path: Path, env: Env) -> None:
+    fichier = _ecrire(tmp_path / "q.yaml", [_question(1)])
+    assert _filtrer(fichier, "--modeles", "fake-llm-a,").exit_code == 2
+    assert _filtrer(fichier, "--modeles", "fake-llm-a,fake-llm-a").exit_code == 2
