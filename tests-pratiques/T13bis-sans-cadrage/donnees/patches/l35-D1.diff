+        typer.echo(f"Erreur : {erreur}", err=True)
+        raise typer.Exit(1) from erreur
+    io.save(questions, res.fichier)
+    typer.echo(f"Modèles interrogés : {', '.join(res.modeles)}")
+    typer.echo(
+        f"Questions posées : {res.posees} ; écartées (unanswerable ou non utilisables) : "
