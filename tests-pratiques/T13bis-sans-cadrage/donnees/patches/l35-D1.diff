index 0000000..f48d26b
--- /dev/null
+++ b/src/wavelibrarian/evalset/closed_book.py
@@ -0,0 +1,137 @@
+"""Filtre closed-book : chaque Question posée sans contexte à plusieurs modèles (FR-12, AD-14).
+
+Une Question à réponse courte est contaminée par un modèle si sa sortie contient la Réponse de
+référence (correspondance exacte normalisée, sans Juge). Une Question à réponse libre passe par le
+Juge closed-book : premier modèle du réservoir d'une autre Famille que le modèle testé (AD-14).
+Les appels sont au Poste `judging` (AD-8). Seul `contaminated_by` change : l'empreinte du Gel
+l'exclut (AD-15), donc un Jeu Gelé se filtre sans invalider l'empreinte.
+Rien n'est écrit par ce module : l'appelant sauvegarde le fichier une fois le filtre terminé.
+"""
+
+from collections.abc import Sequence
+from contextlib import AbstractContextManager
+from dataclasses import dataclass
+from typing import Protocol
+
+from wavelibrarian.config.panel import closed_book_judge
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.types import CostPost, Question
+from wavelibrarian.evalset.check import UTILISABLES
+from wavelibrarian.evalset.io import QuestionsFile
+from wavelibrarian.ports.components import ComponentSpec, Judge, JudgeInput
+from wavelibrarian.ports.context import RunContext
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.scoring.answer import exact_match
+
+_SYSTEM = "Réponds à la question de mémoire, de façon concise, sans document ni contexte."
+_MAX_TOKENS = 256
+
+
+class ContexteFiltre(RunContext, Protocol):
+    """`RunContext` plus `scope` et `build`, que le contexte concret du runner fournit."""
+
+    def scope(
+        self, *, post: CostPost = ..., question_id: str | None = ...
+    ) -> AbstractContextManager[None]: ...
+
+    def build(self, kind: str, spec: ComponentSpec) -> Judge: ...
+
+
+@dataclass(frozen=True)
+class Filtre:
+    """Résultat du filtre : le fichier mis à jour et le détail du passage."""
+
+    fichier: QuestionsFile
+    modeles: tuple[str, ...]
+    posees: int  # Questions posées (chacune à tous les modèles)
+    ecartees: int  # Questions qui ne passent pas le filtre (`unanswerable`, autre statut)
+    contaminees: int  # Questions marquées par au moins un modèle
+    appels_juge: int
+
+
+def parse_modeles(texte: str) -> tuple[str, ...]:
+    """`fake-llm-a,fake-llm-b` -> `("fake-llm-a", "fake-llm-b")` ; `ConfigError` sinon."""
+    modeles = tuple(m.strip() for m in texte.split(","))
+    if not all(modeles):
+        raise ConfigError("--modeles", f"entrée vide dans la liste : {texte!r}")
+    if len(set(modeles)) != len(modeles):
+        raise ConfigError("--modeles", f"modèle répété : {texte!r}")
+    return modeles
+
+
+def passe_le_filtre(q: Question) -> bool:
+    """`validated` ou `corrected`, et répondable (une `unanswerable` n'a rien à retrouver)."""
+    return q.status in UTILISABLES and q.type != "unanswerable"
+
+
+def filtrer(ctx: ContexteFiltre, fichier: QuestionsFile, modeles: Sequence[str]) -> Filtre:
+    """Remplit `contaminated_by` des Questions qui passent le filtre ; les autres sont reprises.
+
+    `contaminated_by` est recalculé : il ne garde rien d'un passage précédent. `BudgetExceeded`
+    si le Plafond l'interdit ; `ConfigError` si un modèle est inconnu ou sans Juge d'une autre
+    Famille, avant tout appel.
+    """
+    if not modeles:
+        raise ConfigError("--modeles", "aucun modèle à interroger")
+    retenues = [q for q in fichier.questions if passe_le_filtre(q)]
+    juges: dict[str, Judge] = {}
+    for m in modeles:
+        ctx.catalog.get(m)  # modèle inconnu du Catalogue : refusé avant tout appel
+        if any(q.answer_form == "free" for q in retenues):
+            juges[m] = ctx.build(
+                "judge",
+                ComponentSpec(
+                    name="llm",
+                    params={
+                        "model": closed_book_judge(m, ctx.profile.defaults.judge_pool, ctx.catalog)
+                    },
+                ),
+            )
+    appels_juge = 0
+    contaminees: dict[str, tuple[str, ...]] = {}
+    for q in retenues:
+        marquants: list[str] = []
+        for m in modeles:
+            with ctx.scope(post="judging", question_id=q.id):
+                requete = LLMRequest(
+                    model_id=m,
+                    role="closed_book",
+                    step="closed_book",
+                    system=_SYSTEM,
+                    messages=(Message(role="user", content=q.text),),
+                    max_tokens=_MAX_TOKENS,
+                    seed=ctx.seed,
+                    inputs={"text": q.text},
+                )
+                reponse = ctx.gateway.complete(requete)
+                if q.answer_form == "short":
+                    connue = exact_match(q.reference_answer, reponse.text)
+                else:
+                    verdicts = juges[m].judge(
+                        JudgeInput(
+                            question=q.text,
+                            reference_answer=q.reference_answer,
+                            reference_texts=(),
+                            answer_text=reponse.text,
+                            context_texts=(),
+                        ),
+                        ("correctness",),
+                        0,
+                    )
+                    appels_juge += 1
+                    connue = verdicts["correctness"][0]
+            if connue:
+                marquants.append(m)
+        contaminees[q.id] = tuple(marquants)
+    questions = tuple(
+        q.model_copy(update={"contaminated_by": contaminees[q.id]}) if q.id in contaminees else q
+        for q in fichier.questions
+    )
+    return Filtre(
+        fichier=fichier.model_copy(update={"questions": questions}),
+        modeles=tuple(modeles),
+        posees=len(retenues),
+        ecartees=len(fichier.questions) - len(retenues),
+        contaminees=sum(1 for v in contaminees.values() if v),
+        appels_juge=appels_juge,
+    )
diff --git a/tests/unit/evalset/test_closed_book.py b/tests/unit/evalset/test_closed_book.py
