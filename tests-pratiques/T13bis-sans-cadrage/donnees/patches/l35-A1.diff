@@ -0,0 +1,109 @@
+"""Filtre closed-book (FR-12, AD-8 Poste `judging`, AD-14).
+
+Chaque Question utilisable est posée sans contexte à chaque modèle (rôle `closed_book`). Une
+réponse courte est tranchée par `exact_match`, une réponse libre par le Juge `closed_book_judge`
+(Critère `correctness`). Le module remplit `contaminated_by` et n'écrit rien : l'appelant
+sauvegarde une fois, donc un plafond atteint ne laisse aucune écriture partielle. Seul
+`contaminated_by` change, l'empreinte du Gel (AD-15) reste donc valide.
+"""
+
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+
+from wavelibrarian.config.panel import closed_book_judge
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.types import Question
+from wavelibrarian.evalset.generate import ContexteGeneration
+from wavelibrarian.evalset.io import QuestionsFile
+from wavelibrarian.ports.components import ComponentSpec, Judge, JudgeInput
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.scoring.answer import exact_match
+
+_SYSTEM = "Réponds à la question de mémoire, de façon concise."
+_MAX_TOKENS = 200
+_STATUTS = frozenset({"validated", "corrected"})
+
+
+@dataclass(frozen=True)
+class Filtrage:
+    """Résultat du filtre : le fichier mis à jour et le détail du tri."""
+
+    fichier: QuestionsFile
+    filtrees: tuple[str, ...]  # ids des Questions posées aux modèles
+    exclues_unanswerable: int
+    ignorees_statut: int  # generated ou rejected
+    contaminees: dict[str, tuple[str, ...]] = field(default_factory=dict)  # id -> modèles
+    cout: str = "0"
+
+
+def _requete(ctx: ContexteGeneration, q: Question, modele: str) -> LLMRequest:
+    plafond = ctx.catalog.get(modele).max_output_tokens
+    return LLMRequest(
+        model_id=modele,
+        role="closed_book",
+        step="closed_book",
+        system=_SYSTEM,
+        messages=(Message(role="user", content=q.text),),
+        max_tokens=min(_MAX_TOKENS, plafond) if plafond else _MAX_TOKENS,
+        seed=ctx.seed,
+        inputs={"text": q.text},
+    )
+
+
+def filtrer(ctx: ContexteGeneration, jeu: QuestionsFile, modeles: Sequence[str]) -> Filtrage:
+    """Pose les Questions `validated` ou `corrected` (hors `unanswerable`) à chaque modèle.
+
+    `ConfigError` avant tout appel si la liste est vide, si un modèle manque au Catalogue ou si
+    aucun Juge d'une autre Famille n'existe ; `BudgetExceeded` si le Plafond l'interdit.
+    """
+    modeles = tuple(dict.fromkeys(modeles))
+    if not modeles:
+        raise ConfigError("--modeles", "aucun modèle à interroger")
+    pool = ctx.profile.defaults.judge_pool
+    choix = {m: closed_book_judge(m, pool, ctx.catalog) for m in modeles}  # Catalogue inclus
+
+    filtrees = [q for q in jeu.questions if q.status in _STATUTS and q.type != "unanswerable"]
+    ids = {q.id for q in filtrees}
+    juges: dict[str, Judge] = {}
+    for modele in modeles:
+        juge = choix[modele]
+        if juge not in juges:
+            juges[juge] = ctx.build("judge", ComponentSpec(name="llm", params={"model": juge}))
+
+    reussies: dict[str, tuple[str, ...]] = {}
+    cout = 0
+    for q in filtrees:
+        gagnants: list[str] = []
+        for modele in modeles:
+            with ctx.scope(post="judging", question_id=q.id):
+                res = ctx.gateway.complete(_requete(ctx, q, modele))
+                cout += res.cost
+                if q.answer_form == "short":
+                    ok = exact_match(q.reference_answer, res.text)
+                else:
+                    item = JudgeInput(
+                        question=q.text,
+                        reference_answer=q.reference_answer,
+                        reference_texts=(),
+                        answer_text=res.text,
+                        context_texts=(),
+                    )
+                    ok = juges[choix[modele]].judge(item, ["correctness"], 0)["correctness"][0]
+            if ok:
+                gagnants.append(modele)
+        reussies[q.id] = tuple(gagnants)
+
+    questions = tuple(
+        q.model_copy(update={"contaminated_by": reussies[q.id]}) if q.id in ids else q
+        for q in jeu.questions
+    )
+    return Filtrage(
+        fichier=jeu.model_copy(update={"questions": questions}),
+        filtrees=tuple(q.id for q in filtrees),
+        exclues_unanswerable=sum(
+            1 for q in jeu.questions if q.status in _STATUTS and q.type == "unanswerable"
+        ),
+        ignorees_statut=sum(1 for q in jeu.questions if q.status not in _STATUTS),
+        contaminees={i: m for i, m in reussies.items() if m},
+        cout=f"{cout:f}",
+    )
