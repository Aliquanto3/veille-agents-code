+@questions_app.command("closed-book")
+def questions_closed_book(
+    questions: Annotated[Path, typer.Argument(help="Fichier `questions.yaml` à filtrer.")],
+    modeles: Annotated[
+        str | None,
+        typer.Option("--modeles", help="Modèles interrogés, séparés par des virgules."),
+    ] = None,
+    profil: Annotated[str, typer.Option("--profil", help="Profil : cpu, gpu ou test.")] = "cpu",
+    graine: Annotated[int, typer.Option("--graine", help="Graine des appels.")] = 42,
+) -> None:
+    """Pose chaque Question utilisable sans contexte aux modèles et note `contaminated_by`."""
+    try:
+        jeu = io.load(questions)
+        if modeles is None:
+            liste = list(load_profile(profil).defaults.closed_book_models)
+        else:
+            liste = [m.strip() for m in modeles.split(",") if m.strip()]
+    except ConfigError as erreur:
+        typer.echo(f"Erreur : {erreur}", err=True)
+        raise typer.Exit(2) from erreur
+    try:
+        with _contexte_hors_execution(profil, graine) as ctx:
+            res = closed_book.filtrer(ctx, jeu, liste)
+    except BudgetExceeded as erreur:
+        typer.echo(f"Plafond atteint : {erreur} ; fichier inchangé.", err=True)
+        raise typer.Exit(3) from erreur
+    except ConfigError as erreur:
+        typer.echo(f"Erreur : {erreur}", err=True)
+        raise typer.Exit(2) from erreur
+    except ProviderError as erreur:
+        typer.echo(f"Erreur : {erreur}", err=True)
+        raise typer.Exit(4) from erreur
+    except WlError as erreur:
+        typer.echo(f"Erreur : {erreur}", err=True)
+        raise typer.Exit(1) from erreur
+    avant = {q.id: q.contaminated_by for q in jeu.questions}
+    if any(q.contaminated_by != avant[q.id] for q in res.fichier.questions):
+        io.save(questions, res.fichier)
+    typer.echo(f"Questions filtrées : {len(res.filtrees)} ({questions})")
+    typer.echo(f"Exclues (unanswerable) : {res.exclues_unanswerable}")
+    typer.echo(f"Ignorées par statut : {res.ignorees_statut}")
+    typer.echo(f"Questions contaminées : {len(res.contaminees)}")
+    for ident, par in res.contaminees.items():
+        typer.echo(f"  - {ident} : {', '.join(par)}")
+    typer.echo(f"Coût : {res.cout.replace('.', ',')}, Poste judging.")
+
+
 def _fr(valeur: float, decimales: int = 2) -> str:
