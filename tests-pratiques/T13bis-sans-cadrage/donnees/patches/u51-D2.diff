@@ -0,0 +1,107 @@
+"""Étapes `kpi` et `prevision`, Passage autoportant (Story 5.1)."""
+
+import json
+from datetime import date
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.chaine.environnement import DATE_ARRETE, horloge_pas_a_pas, preparer_racine
+from tests.unit.chaine.test_execution import _executer
+from usine.chaine.etapes import EtapeKpi, EtapePrevision
+from usine.composition import Rapport, construire_rapport
+from usine.consultation.passage import ConsultationPassage
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.passage import ContextePassage, Etape, StatutEtape
+from usine.contrats.prevision import (
+    ContenuPrevisions,
+    MethodePrevision,
+    Prevision,
+    StatutPrevision,
+)
+from usine.contrats.trace import EntreeTrace, TypeTrace
+from usine.contrats.versions import CONTRATS_VERSION
+
+
+@pytest.fixture
+def rapport(tmp_path: Path) -> Rapport:
+    return construire_rapport(preparer_racine(tmp_path))
+
+
+def test_registre_reel(rapport: Rapport) -> None:
+    assert isinstance(rapport.registre[Etape.kpi], EtapeKpi)
+    assert isinstance(rapport.registre[Etape.prevision], EtapePrevision)
+
+
+def test_passage_autoportant(rapport: Rapport) -> None:
+    manifeste, ecrivain = _executer(rapport)
+    repertoire = ecrivain.repertoire_publie
+    assert repertoire is not None
+    kpi = pl.read_parquet(repertoire / "kpi.parquet")
+    instantanes = pl.read_parquet(repertoire / "instantanes.parquet")
+    premier = instantanes.get_column("date").min()
+    assert isinstance(premier, date)
+    attendus = set(jours_ouvres(premier, DATE_ARRETE))
+    assert set(kpi.get_column("date").to_list()) == attendus
+    assert (repertoire / "tendances.parquet").exists()
+    assert (repertoire / "previsions.json").exists()
+    assert manifeste.date_arrete == DATE_ARRETE
+    assert manifeste.contrats_version == CONTRATS_VERSION
+    assert manifeste.source == "journal"
+    assert manifeste.nb_tickets > 0
+    assert [e.etape for e in manifeste.etapes] == list(Etape)
+    assert all(e.duree.total_seconds() > 0 for e in manifeste.etapes)
+    contenu = json.loads((repertoire / "manifeste.json").read_text(encoding="utf-8"))
+    assert {"version_grille", "version_donnees", "contrats_version", "nb_alignements"} <= set(
+        contenu
+    )
+
+
+def _contexte(rapport: Rapport, tmp_path: Path) -> ContextePassage[ConsultationPassage]:
+    return ContextePassage(DATE_ARRETE, "20261012T073000Z-abc123", rapport.configuration, None)  # type: ignore[arg-type]
+
+
+def _prevision(entite: str) -> Prevision:
+    return Prevision(
+        date_arrete=DATE_ARRETE,
+        entite=entite,
+        methode=MethodePrevision.baseline,
+        statut=StatutPrevision.pas_de_sortie_projetee,
+        probabilite_numerateur=0,
+        probabilite_denominateur=1,
+        horizon_jours_ouvres=10,
+        facteurs=(),
+        version_grille="g" * 12,
+    )
+
+
+def test_prevision_sans_calcul(rapport: Rapport, tmp_path: Path) -> None:
+    etape = EtapePrevision("g" * 12, "d" * 12, horloge_pas_a_pas())
+    resultat = etape.executer(_contexte(rapport, tmp_path))
+    assert resultat.statut is StatutEtape.reussie
+    assert resultat.sorties["previsions"] == ContenuPrevisions(previsions=(), risques=())
+    assert resultat.traces == ()
+
+
+def test_une_trace_par_prevision(rapport: Rapport, tmp_path: Path) -> None:
+    contenu = ContenuPrevisions(previsions=(_prevision("ENT-A"), _prevision("ENT-B")), risques=())
+    etape = EtapePrevision("g" * 12, "d" * 12, horloge_pas_a_pas(), lambda ctx: contenu)
+    resultat = etape.executer(_contexte(rapport, tmp_path))
+    assert resultat.sorties["previsions"] is contenu
+    assert [t.entite for t in resultat.traces] == ["ENT-A", "ENT-B"]
+    assert all(t.type_trace is TypeTrace.prevision for t in resultat.traces)
+    assert {(t.version_grille, t.version_donnees) for t in resultat.traces} == {
+        ("g" * 12, "d" * 12)
+    }
+
+
+def test_traces_ecrites_au_passage(rapport: Rapport) -> None:
+    contenu = ContenuPrevisions(previsions=(_prevision("ENT-A"),), risques=())
+    etape = EtapePrevision("g" * 12, "d" * 12, horloge_pas_a_pas(), lambda ctx: contenu)
+    _, ecrivain = _executer(rapport, remplacements={Etape.prevision: etape})
+    assert ecrivain.repertoire_publie is not None
+    lignes = (ecrivain.repertoire_publie / "trace" / "previsions.jsonl").read_text("utf-8")
+    traces = [EntreeTrace.model_validate_json(ligne) for ligne in lignes.splitlines()]
+    assert [t.entite for t in traces] == ["ENT-A"]
+    assert traces[0].passage_id == "20261012T073000Z-abc123"
