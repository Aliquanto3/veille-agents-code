+type CalculPrevisions = Callable[[ContextePassage[Consultation]], ContenuPrevisions]
+"""Calcul des Prévisions et Risques d'un Passage : fonction du domaine, injectée (AD-18)."""
+
+
+class EtapePrevision:
+    """Prévisions et Risques d'entrée en rouge, avec une trace par Prévision (AD-16).
+
+    L'étape n'implémente aucune Prévision : elle enveloppe `calculer` (le domaine de la
+    Prévision), injecté par la composition. Sans `calculer`, `previsions.json` est vide.
+    """
+
+    def __init__(
+        self,
+        version_grille: str,
+        version_donnees: str,
+        horloge: Callable[[], datetime],
+        calculer: CalculPrevisions | None = None,
+    ) -> None:
+        self._version_grille = version_grille
+        self._version_donnees = version_donnees
+        self._horloge = horloge
+        self._calculer = calculer
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sortie `previsions` et une `EntreeTrace` par Prévision."""
+        contenu = (
+            ContenuPrevisions(previsions=(), risques=())
+            if self._calculer is None
+            else self._calculer(ctx)
+        )
+        traces = tuple(
+            EntreeTrace(
+                type_trace=TypeTrace.prevision,
+                horodatage=self._horloge(),
+                passage_id=ctx.passage_id,
+                date_arrete=ctx.date_arrete,
+                entite=prevision.entite,
+                cible=prevision.entite,
+                version_grille=self._version_grille,
+                version_donnees=self._version_donnees,
+                entree_pseudonymisee=f"{prevision.entite} {prevision.date_arrete.isoformat()}",
+                sortie=prevision.model_dump_json(),
+            )
+            for prevision in contenu.previsions
+        )
+        return ResultatEtape(StatutEtape.reussie, {"previsions": contenu}, traces)
+
