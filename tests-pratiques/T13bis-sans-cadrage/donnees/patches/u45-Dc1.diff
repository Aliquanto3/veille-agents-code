+++ b/tests/unit/recette/test_previsions_scenarios.py
@@ -0,0 +1,86 @@
+"""Recette de la Prévision sur les Scénarios de démo (Story 4.5, SM-6, FR-20, FR-21).
+
+Le Journal est généré avec la configuration livrée (Grille par défaut, graine 42) ; les
+Prévisions viennent de l'étape `prevision` d'un Passage complet, à la Date d'arrêté (dernier Jour
+ouvré de l'historique). Un écart se corrige dans le générateur, jamais dans la Baseline (SM-C3).
+"""
+
+import shutil
+from pathlib import Path
+
+import pytest
+
+from tests.unit.chaine.environnement import DATE_ARRETE, DATE_GENERATION, RACINE_DEPOT
+from tests.unit.chaine.test_execution import _executer
+from usine.composition import construire_rapport, generer_journal
+from usine.config import charger_yaml
+from usine.consultation.passage import ConsultationPassage
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.meteo import CodeIndicateur, Couleur
+from usine.contrats.prevision import StatutPrevision
+
+ENTITE_A, ENTITE_B, ENTITE_C = "ENT-A", "ENT-B", "ENT-C"
+
+
+@pytest.fixture(scope="module")
+def passage(tmp_path_factory: pytest.TempPathFactory) -> ConsultationPassage:
+    """Passage à la Date d'arrêté, sur le Journal de la configuration livrée."""
+    racine: Path = tmp_path_factory.mktemp("recette")
+    shutil.copytree(RACINE_DEPOT / "config", racine / "config")
+    shutil.copytree(RACINE_DEPOT / "gabarits", racine / "gabarits")
+    programme = charger_yaml(racine / "config" / "programme.yaml", ConfigProgramme)
+    generer_journal(programme, 42, DATE_GENERATION, racine)
+    _, ecrivain = _executer(construire_rapport(racine), date_arrete=DATE_ARRETE)
+    assert ecrivain.repertoire_publie is not None
+    return ConsultationPassage(ecrivain.repertoire_publie)
+
+
+def test_date_arrete_dernier_jour_ouvre_de_l_historique(passage: ConsultationPassage) -> None:
+    """La recette se lit au dernier Jour ouvré : A et B rouges, C non rouge."""
+    couleurs = {m.entite: m.couleur for m in passage.meteo(DATE_ARRETE)}
+    assert couleurs[ENTITE_A] is Couleur.rouge
+    assert couleurs[ENTITE_B] is Couleur.rouge
+    assert couleurs[ENTITE_C] is not Couleur.rouge
+
+
+def test_a_sort_dans_l_horizon(passage: ConsultationPassage) -> None:
+    """SM-6 : A porte une date de sortie projetée, dans l'horizon de la Prévision."""
+    prevision = next(
+        p for p in passage.previsions() if (p.date_arrete, p.entite) == (DATE_ARRETE, ENTITE_A)
+    )
+    assert prevision.statut is StatutPrevision.sortie_projetee
+    assert prevision.date_sortie_estimee is not None
+    assert prevision.date_sortie_estimee > DATE_ARRETE
+    jours = jours_ouvres(DATE_ARRETE, prevision.date_sortie_estimee)
+    assert len(jours) - 1 <= prevision.horizon_jours_ouvres
+
+
+def test_b_ne_sort_pas(passage: ConsultationPassage) -> None:
+    """SM-6 : B porte « pas de sortie projetée »."""
+    prevision = next(
+        p for p in passage.previsions() if (p.date_arrete, p.entite) == (DATE_ARRETE, ENTITE_B)
+    )
+    assert prevision.statut is StatutPrevision.pas_de_sortie_projetee
+    assert prevision.date_sortie_estimee is None
+
+
+def test_c_porte_un_risque_d_entree_en_rouge(passage: ConsultationPassage) -> None:
+    """SM-6 : C est signalée, avec sa valeur projetée remplie (`valeur_projetee_*`)."""
+    risques = [r for r in passage.risques() if (r.date_arrete, r.entite) == (DATE_ARRETE, ENTITE_C)]
+    assert risques, "C doit porter un Risque d'entrée en rouge à la Date d'arrêté"
+    for risque in risques:
+        assert risque.date_franchissement_estimee > DATE_ARRETE
+        assert risque.valeur_projetee_numerateur is not None
+        assert risque.valeur_projetee_denominateur is not None
+    assert CodeIndicateur.ind_4 in {r.indicateur for r in risques}
+
+
+def test_valeur_projetee_remplie_pour_tous_les_risques(passage: ConsultationPassage) -> None:
+    """Chaque Risque publié par l'étape `prevision` porte sa valeur projetée."""
+    risques = passage.risques()
+    assert risques
+    assert all(
+        r.valeur_projetee_numerateur is not None and r.valeur_projetee_denominateur is not None
+        for r in risques
+    )
