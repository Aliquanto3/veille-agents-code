index 0000000..faf9c8d
--- /dev/null
+++ b/tests/unit/architectures/test_story_6_5.py
@@ -0,0 +1,172 @@
+"""Story 6.5 : Architecture `cag` (Corpus préchargé dans le cache de prompt)."""
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from wavelibrarian import registry
+from wavelibrarian.architectures.cag import Cag
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.types import CorpusProfile, ParsedCorpus, QuestionInput
+from wavelibrarian.llm.providers.fake import FakeProvider
+from wavelibrarian.ports.components import ComponentSpec
+from wavelibrarian.ports.gateway import LLMRequest
+from wavelibrarian.runner.context import Context as RunCtx
+from wavelibrarian.runner.index_cache import IndexCache
+
+REPONSE = '{"answer": "Réponse.", "citations": ["S1"], "abstain": false}'
+
+
+@pytest.fixture
+def ctx(tmp_path: Path):  # type: ignore[no-untyped-def]
+    provider = FakeProvider()
+    c = RunCtx.from_profile(
+        "test", wl_home=tmp_path / "wl", run_id="r-1", seed=1, providers={"fake": provider}
+    )
+    c.parser = "markdown"
+    c.provider = provider  # type: ignore[attr-defined]
+    with c:
+        yield c
+
+
+def _arch(ctx: RunCtx, modele: str = "fake-llm-a") -> Any:
+    generateur = {"name": "llm", "params": {"model": modele}}
+    return ctx.build("architecture", ComponentSpec(name="cag", params={"generator": generateur}))
+
+
+def _question(n: int) -> QuestionInput:
+    texte = "Que sait-on de la guilde Orvane ?"
+    return QuestionInput(question_id=f"q-00{n}", text=texte, lang="fr")
+
+
+def _poser(arch: Any, ctx: RunCtx, n: int) -> Any:
+    with ctx.scope(post="query", question_id=f"q-00{n}"):
+        return arch.answer(_question(n))
+
+
+def _spans(ctx: RunCtx) -> list[dict[str, Any]]:
+    lignes = (ctx.run_dir / "traces.jsonl").read_text(encoding="utf-8").splitlines()
+    return [json.loads(x) for x in lignes]
+
+
+def _profil(n_tokens: int) -> CorpusProfile:
+    return CorpusProfile(
+        corpus_id="c",
+        fingerprint="f",
+        parser="markdown",
+        tokenizer="approx",
+        n_documents=1,
+        n_tokens=n_tokens,
+        mean_tokens_per_document=float(n_tokens),
+        heading_depth_max=1,
+        heading_depth_mean=1.0,
+        link_density=0.0,
+        table_share=0.0,
+        images_per_document=0.0,
+        dominant_lang="fr",
+        langs={"fr": 1},
+        formats={"markdown": 1},
+        volatility="low",
+    )
+
+
+def test_cag_enregistre_avec_ses_capacites() -> None:
+    assert registry.get("architecture", "cag") is Cag
+    assert Cag.capabilities.requires_prompt_cache is True
+    assert Cag.capabilities.full_corpus_in_prompt is True
+    assert Cag.capabilities.retrieval_method == "cited"
+
+
+def test_load_precharge_le_corpus_au_poste_indexing(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    vues: list[LLMRequest] = []
+
+    def sortie(req: LLMRequest) -> str:
+        vues.append(req)
+        return REPONSE
+
+    ctx.provider.script("generate", "cag.preload", sortie)  # type: ignore[attr-defined]
+    arch, _ = IndexCache(tmp_path / "home").build(ctx, lambda: _arch(ctx), minicorpus)
+
+    ancrages = [
+        a for d in minicorpus.documents for a in d.anchors if minicorpus.anchor_text(a).strip()
+    ]
+    (precharge,) = vues
+    assert precharge.cache_system is True
+    assert precharge.step == "cag.preload"
+    assert all(f"({a})" in precharge.system for a in ancrages)  # tout le Corpus, étiqueté
+    (span,) = [s for s in _spans(ctx) if s.get("wl.step") == "cag.preload"]
+    assert span["wl.post"] == "indexing"
+    assert arch.capabilities.requires_prompt_cache is True
+
+
+def test_index_servi_par_le_cache_precharge_aussi(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    ctx.provider.script("generate", "generate*", REPONSE)  # type: ignore[attr-defined]
+    cache = IndexCache(tmp_path / "home")
+    cache.build(ctx, lambda: _arch(ctx), minicorpus)
+    avant = sum(1 for s in _spans(ctx) if s.get("wl.step") == "cag.preload")
+    cache.build(ctx, lambda: _arch(ctx), minicorpus)  # index servi : `load` précharge encore
+    apres = [s for s in _spans(ctx) if s.get("wl.step") == "cag.preload"]
+    assert (avant, len(apres)) == (1, 2)
+    assert all(s["wl.post"] == "indexing" for s in apres)
+
+
+def test_seconde_question_lit_le_cache(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    ctx.provider.script("generate", "generate*", REPONSE)  # type: ignore[attr-defined]
+    arch, _ = IndexCache(tmp_path / "home").build(ctx, lambda: _arch(ctx), minicorpus)
+    r1 = _poser(arch, ctx, 1)
+    r2 = _poser(arch, ctx, 2)
+    assert r1.retrieval_method == r2.retrieval_method == "cited"
+    queries = [s for s in _spans(ctx) if s.get("wl.post") == "query"]
+    assert len(queries) == 2
+    assert queries[1]["wl.usage.cache_read_tokens"] > 0
+    # tokens en cache tracés à part des tokens d'entrée (FR-29)
+    assert queries[1]["gen_ai.usage.input_tokens"] < queries[1]["wl.usage.cache_read_tokens"]
+
+
+def test_generateur_autre_que_llm_refuse(ctx: RunCtx) -> None:
+    with pytest.raises(ConfigError):
+        ctx.build(
+            "architecture",
+            ComponentSpec(name="cag", params={"generator": {"name": "llm_test"}}),
+        )
+
+
+def test_inapplicable_au_dela_de_la_fenetre(ctx: RunCtx) -> None:
+    vues: list[LLMRequest] = []
+    ctx.provider.script(  # type: ignore[attr-defined]
+        "generate", "generate*", lambda req: (vues.append(req), REPONSE)[1]
+    )
+    res = _arch(ctx).check(_profil(120_000))
+    assert res.applicable is False
+    assert res.reason is not None and "fenêtre" in res.reason
+    assert vues == []
+
+
+def test_inapplicable_au_dela_du_palier_haiku(ctx: RunCtx) -> None:
+    res = _arch(ctx, "claude-haiku-5-5").check(_profil(80_000))  # 120 000 tokens estimés
+    assert res.applicable is False
+    assert res.reason is not None and "palier" in res.reason and "100000" in res.reason
+
+
+def test_corpus_court_precharge_sans_erreur(ctx: RunCtx, tmp_path: Path) -> None:
+    from wavelibrarian.architectures._passages import ecrire_passages
+    from wavelibrarian.core.types import Passage
+
+    ctx.provider.script("generate", "generate*", REPONSE)  # type: ignore[attr-defined]
+    dossier = tmp_path / "idx"
+    ecrire_passages(
+        dossier, [Passage(passage_id="p", doc_id="d", text="Court.", anchor_ids=("d#a",))]
+    )
+    arch = _arch(ctx)
+    with ctx.scope(post="indexing"):
+        arch.load(dossier)
+    (span,) = [s for s in _spans(ctx) if s.get("wl.step") == "cag.preload"]
+    assert span["wl.usage.cache_read_tokens"] == 0
