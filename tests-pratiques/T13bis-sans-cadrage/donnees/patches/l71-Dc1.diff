+"""Architecture `raptor` : arbre de résumés par regroupement récursif, recherche sur tout l'arbre
+(FR-23)."""
+
+from pathlib import Path
+from typing import Annotated, Any, ClassVar
+
+from pydantic import Field, model_validator
+
+from wavelibrarian.architectures._passages import ecrire_passages
+from wavelibrarian.architectures.naive_rag import _SOUS_DOSSIER, NaiveRag
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.ids import sha16
+from wavelibrarian.core.types import ModelRefMeta, ParsedCorpus, Passage
+from wavelibrarian.ports.architecture import ArchCapabilities, CorpusChange
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.registry import register
+
+_SYSTEM = (
+    "Résume fidèlement les passages suivants en un court texte, dans leur langue, sans rien "
+    "ajouter qui ne figure pas dans les passages."
+)
+_MOTS_REPLI = 60  # taille du texte d'un nœud dont le résumé est vide : début des enfants
+
+
+def _groupes(noeuds: list[Passage], group_max: int) -> list[list[Passage]]:
+    """Découpe en groupes consécutifs de `group_max` nœuds, dans l'ordre reçu (ordre des
+    Documents, donc déterministe). Règle documentée : seul le dernier groupe d'un niveau peut
+    compter moins de `group_min` nœuds, quand il n'en reste pas assez."""
+    return [noeuds[i : i + group_max] for i in range(0, len(noeuds), group_max)]
+
+
+@register("architecture", "raptor")
+class Raptor(NaiveRag):
+    """Index de `naive_rag` (feuilles) complété d'un arbre de résumés : les nœuds d'un niveau sont
+    regroupés par `group_min` à `group_max`, chaque groupe est résumé par le rôle `summarize`,
+    jusqu'à un nœud unique ou `max_depth` niveaux. La recherche dense porte sur l'arbre aplati ;
+    un résumé porte les Ancrages de ses feuilles, ses Citations y renvoient donc directement.
+    Pas de mise à jour incrémentale : l'arbre est reconstruit."""
+
+    name = "raptor"
+    capabilities = ArchCapabilities(incremental_update=False, retrieval_method="ranked")
+    query_params: ClassVar[frozenset[str]] = frozenset({"k"})
+
+    class Params(NaiveRag.Params):
+        group_min: int = Field(default=5, gt=0)
+        group_max: int = Field(default=10, gt=0)
+        max_depth: int = Field(default=3, gt=0)
+        summarize_model: Annotated[str | None, ModelRefMeta("generator_models[0]")] = None
+        summarize_max_tokens: int = Field(default=256, gt=0)
+
+        @model_validator(mode="after")
+        def _bornes(self) -> "Raptor.Params":
+            if self.group_min > self.group_max:
+                raise ValueError("`group_min` ne peut dépasser `group_max`")
+            return self
+
+    def __init__(self, params: Any, ctx: Any) -> None:
+        if params.retriever.name != "dense":
+            # `lexical` et `hybrid` exigent un index lexical que cet index n'a pas.
+            raise ConfigError(
+                "retriever",
+                f"`raptor` cherche dans l'index dense de ses nœuds : retriever `dense` seul, "
+                f"pas `{params.retriever.name}`",
+            )
+        super().__init__(params, ctx)
+        self._summarize_model: str = (
+            params.summarize_model or ctx.profile.defaults.generator_models[0]
+        )
+
+    def _resumer(self, enfants: list[Passage], niveau: int) -> Passage:
+        texte_enfants = "\n\n".join(e.text for e in enfants)
+        requete = LLMRequest(
+            model_id=self._summarize_model,
+            role="summarize",
+            step=f"raptor.summarize.level{niveau}",
+            system=_SYSTEM,
+            messages=(Message(role="user", content=texte_enfants),),
+            max_tokens=self.params.summarize_max_tokens,  # type: ignore[attr-defined]
+            seed=self.ctx.seed,  # type: ignore[attr-defined]
+            inputs={"text": texte_enfants},
+        )
+        texte = str(self.ctx.gateway.complete(requete).text).strip()  # type: ignore[attr-defined]
+        if not texte:
+            texte = " ".join(texte_enfants.split()[:_MOTS_REPLI])
+        child_ids = tuple(e.passage_id for e in enfants)
+        docs = {e.doc_id for e in enfants}
+        anchor_ids = tuple(dict.fromkeys(a for e in enfants for a in e.anchor_ids))
+        return Passage(
+            passage_id=sha16("node", "raptor", str(niveau), *sorted(child_ids)),
+            doc_id=docs.pop() if len(docs) == 1 else None,
+            text=texte,
+            anchor_ids=anchor_ids,
+            level=niveau,
+            child_ids=child_ids,
+        )
+
+    def _arbre(self, feuilles: list[Passage]) -> list[Passage]:
+        """Nœuds de résumé, niveau après niveau. Au moins un niveau dès qu'il y a une feuille."""
+        group_max: int = self.params.group_max  # type: ignore[attr-defined]
+        max_depth: int = self.params.max_depth  # type: ignore[attr-defined]
+        courant = feuilles
+        noeuds: list[Passage] = []
+        for niveau in range(1, max_depth + 1):
+            if not courant or (niveau > 1 and len(courant) == 1):
+                break
+            courant = [self._resumer(g, niveau) for g in _groupes(courant, group_max)]
+            noeuds.extend(courant)
+        return noeuds
+
+    def index(self, corpus: ParsedCorpus, directory: Path) -> None:
+        feuilles = [p for doc in corpus.documents for p in self.chunker.chunk(doc)]  # type: ignore[attr-defined]
+        passages = [*feuilles, *self._arbre(feuilles)]
+        store = self._nouveau_store()
+        self._encoder(store, passages)
+        ecrire_passages(directory, passages)
+        store.save(directory / _SOUS_DOSSIER)
+
+    def update(
+        self,
+        change: CorpusChange,
+        corpus_after: ParsedCorpus,
+        old_directory: Path,
+        new_directory: Path,
+    ) -> None:
+        """Reconstruit l'arbre sur `corpus_after` : un résumé ne se met pas à jour à la pièce."""
+        self.index(corpus_after, new_directory)
