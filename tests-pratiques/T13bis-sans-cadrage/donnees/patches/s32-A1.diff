@@ -0,0 +1,173 @@
+"""Bac à sable MCP : adaptateur de rejeu de `ToolPort` (AD-10).
+
+`BacASable` rejoue les cassettes d'un item, sans état et sans réseau. Chaque appel est
+d'abord validé contre le schéma figé (`AppelNonConforme`), puis apparié :
+
+1. exact : mêmes arguments en JSON canonique ;
+2. sinon, l'interaction du même outil qui a le plus de paires (clé, valeur) égales (à
+   égalité, la première de la cassette), avec un `Avertissement` « appel non prévu » ;
+3. sinon, la réponse vide normalisée (texte de `config/outils-mcp.toml`), avec le même
+   avertissement.
+
+Une interaction `simulation` lève l'exception de `PAR_TYPE_SIMULATION`, comme le client en
+direct. Les cassettes dont l'empreinte diffère de la config sont refusées à la construction.
+"""
+
+from __future__ import annotations
+
+import copy
+from collections.abc import Callable, Mapping, Sequence
+from pathlib import Path
+from typing import Any, Final
+
+from slmsp.core.canonique import json_canonique
+from slmsp.core.erreurs import SchemaOutilModifie
+from slmsp.core.evenements import Avertissement
+from slmsp.core.schemas.cassette import Cassette, Interaction
+from slmsp.mcp.cassettes import lire_cassette
+from slmsp.mcp.erreurs import PAR_TYPE_SIMULATION, ErreurHttp
+from slmsp.mcp.outils import charger_config, charger_outils, valider_appel
+
+__all__ = ["CODE_APPEL_NON_PREVU", "BacASable", "reponse_vide"]
+
+CODE_APPEL_NON_PREVU: Final = "appel-non-prevu"
+"""Code de l'`Avertissement` émis quand aucun appariement exact n'existe."""
+
+_METHODE_APPEL: Final = "tools/call"
+
+
+def reponse_vide(
+    texte: str | None = None, *, chemin_outils: str | Path | None = None
+) -> dict[str, Any]:
+    """Réponse vide normalisée ; `texte` vaut par défaut celui de `config/outils-mcp.toml`."""
+    if texte is None:
+        texte = charger_config(chemin_outils).texte_reponse_vide
+    return {"result": {"content": [{"type": "text", "text": texte}], "isError": False}}
+
+
+def _appel_enregistre(interaction: Interaction) -> tuple[str, dict[str, Any]] | None:
+    """Nom et arguments d'une requête `tools/call`, sinon `None`."""
+    requete = interaction.request
+    if requete.get("method") != _METHODE_APPEL:
+        return None
+    params = requete.get("params")
+    if not isinstance(params, dict) or not isinstance(params.get("name"), str):
+        return None
+    arguments = params.get("arguments")
+    return params["name"], arguments if isinstance(arguments, dict) else {}
+
+
+def _paires_egales(a: Mapping[str, Any], b: Mapping[str, Any]) -> int:
+    return sum(1 for cle in a if cle in b and json_canonique(a[cle]) == json_canonique(b[cle]))
+
+
+class BacASable:
+    """Adaptateur `ToolPort` qui rejoue des cassettes, sans état."""
+
+    def __init__(
+        self,
+        cassettes: Sequence[str | Path | Cassette],
+        *,
+        chemin_outils: str | Path | None = None,
+        signaler: Callable[[Avertissement], None] | None = None,
+    ):
+        self.chemin_outils = chemin_outils
+        self._signaler = signaler
+        attendu = charger_config(chemin_outils).tools_list_sha256
+        appels: list[tuple[str, dict[str, Any], Interaction]] = []
+        for source in cassettes:
+            cassette = source if isinstance(source, Cassette) else lire_cassette(source)
+            if cassette.tools_list_sha256 != attendu:
+                erreur = SchemaOutilModifie(
+                    "cassette enregistrée avec une autre liste d'outils que la config"
+                )
+                erreur.ecarts = ("tools_list_sha256 : empreinte différente",)  # type: ignore[attr-defined]
+                raise erreur
+            for interaction in cassette.interactions:
+                appel = _appel_enregistre(interaction)
+                if appel is not None:
+                    appels.append((appel[0], appel[1], interaction))
+        self._appels: tuple[tuple[str, dict[str, Any], Interaction], ...] = tuple(appels)
+
+    def lister_outils(self) -> list[dict[str, Any]]:
+        """Outils figés au format `tools` d'OpenAI (aucune requête)."""
+        return charger_outils(self.chemin_outils)
+
+    def _apparier(self, nom: str, arguments: Mapping[str, Any]) -> tuple[Interaction | None, bool]:
+        """Interaction à rejouer et indicateur « appel non prévu »."""
+        candidates = [(args, inter) for n, args, inter in self._appels if n == nom]
+        if not candidates:
+            return None, True
+        voulu = json_canonique(dict(arguments))
+        for args, inter in candidates:
+            if json_canonique(args) == voulu:
+                return inter, False
+        meilleure, meilleur_n = candidates[0][1], -1
+        for args, inter in candidates:
+            n = _paires_egales(arguments, args)
+            if n > meilleur_n:
+                meilleure, meilleur_n = inter, n
+        return meilleure, True
+
+    def _rejouer(
+        self, nom: str, arguments: Mapping[str, Any], id_: int | str | None
+    ) -> tuple[dict[str, Any] | None, Avertissement | None, Exception | None]:
+        valider_appel(nom, arguments, chemin=self.chemin_outils)
+        interaction, imprevu = self._apparier(nom, arguments)
+        avertissement = None
+        if imprevu:
+            cas = "réponse vide" if interaction is None else "réponse la plus proche"
+            avertissement = Avertissement(
+                code=CODE_APPEL_NON_PREVU,
+                message=f"appel non prévu à l'outil « {nom} » : {cas} rejouée",
+            )
+        if interaction is None:
+            reponse = reponse_vide(chemin_outils=self.chemin_outils)
+            if id_ is not None:
+                reponse = {"jsonrpc": "2.0", "id": id_, **reponse}
+            return reponse, avertissement, None
+        if interaction.simulation is not None:
+            return None, avertissement, _exception_simulation(interaction)
+        reponse = copy.deepcopy(interaction.response)
+        assert reponse is not None
+        if id_ is not None:
+            reponse["id"] = id_
+        return reponse, avertissement, None
+
+    def rejouer(
+        self, nom: str, arguments: Mapping[str, Any], *, id_: int | str | None = None
+    ) -> tuple[dict[str, Any], Avertissement | None]:
+        """Réponse rejouée et avertissement éventuel ; lève l'exception d'une simulation.
+
+        Lève `AppelNonConforme` sans rien rejouer si l'appel viole le schéma figé.
+        """
+        reponse, avertissement, erreur = self._rejouer(nom, arguments, id_)
+        if erreur is not None:
+            raise erreur
+        assert reponse is not None
+        return reponse, avertissement
+
+    def appeler(
+        self, nom: str, arguments: Mapping[str, Any], *, id_: int | str | None = None
+    ) -> dict[str, Any]:
+        """Rejoue l'appel (`ToolPort`) et transmet l'avertissement éventuel à `signaler`.
+
+        L'avertissement est transmis avant de lever l'exception d'une simulation.
+        """
+        reponse, avertissement, erreur = self._rejouer(nom, arguments, id_)
+        if avertissement is not None and self._signaler is not None:
+            self._signaler(avertissement)
+        if erreur is not None:
+            raise erreur
+        assert reponse is not None
+        return reponse
+
+
+def _exception_simulation(interaction: Interaction) -> Exception:
+    simulation = interaction.simulation
+    assert simulation is not None
+    classe = PAR_TYPE_SIMULATION[simulation.type]
+    message = f"panne simulée par la cassette ({simulation.type})"
+    if classe is ErreurHttp:
+        return ErreurHttp(message, statut=simulation.statut)
+    return classe(message)
