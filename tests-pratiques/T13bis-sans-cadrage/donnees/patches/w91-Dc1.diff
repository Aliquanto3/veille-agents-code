+def _server_ready(port: int) -> bool:
+    """Vrai si le serveur local répond à `GET /api/health`."""
+    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=1.0)
+    try:
+        conn.request("GET", "/api/health")
+        return conn.getresponse().status < 500
+    except (OSError, http.client.HTTPException):
+        return False
+    finally:
+        conn.close()
+
+
+def _open_browser_when_ready(port: int, timeout_s: float = ATTENTE_NAVIGATEUR_S) -> bool:
+    """Ouvre le navigateur sur l'application dès que le serveur répond ; rend `True` si fait.
+
+    Ne bloque jamais le lanceur : si le serveur ne répond pas dans `timeout_s` ou si aucun
+    navigateur n'est disponible, l'échec est journalisé et le serveur continue."""
+    url = f"http://127.0.0.1:{port}/"
+    deadline = time.monotonic() + timeout_s
+    while not _server_ready(port):
+        if time.monotonic() >= deadline:
+            logger.warning("Navigateur non ouvert : le serveur ne répond pas. Ouvrez %s", url)
+            return False
+        time.sleep(PAUSE_SONDE_S)
+    try:
+        opened = webbrowser.open(url)
+    except webbrowser.Error as exc:
+        logger.warning("Navigateur non ouvert (%s). Ouvrez %s", exc, url)
+        return False
+    if not opened:
+        logger.warning("Aucun navigateur disponible. Ouvrez %s", url)
+    return bool(opened)
+
