+def test_browser_opens_on_the_local_url_once_the_server_answers(monkeypatch):
+    ouvertures = []
+    monkeypatch.setattr("wavelocalai.__main__._server_ready", lambda port: True)
+    monkeypatch.setattr("webbrowser.open", lambda url: ouvertures.append(url) or True)
+    assert _open_browser_when_ready(8123) is True
+    assert ouvertures == ["http://127.0.0.1:8123/"]
+
+
+def test_browser_waits_for_the_server(monkeypatch):
+    reponses = iter([False, False, True])
+    ouvertures = []
+    monkeypatch.setattr("wavelocalai.__main__._server_ready", lambda port: next(reponses))
+    monkeypatch.setattr("wavelocalai.__main__.PAUSE_SONDE_S", 0)
+    monkeypatch.setattr("webbrowser.open", lambda url: ouvertures.append(url) or True)
+    assert _open_browser_when_ready(8123) is True
+    assert len(ouvertures) == 1
+
+
+def test_browser_is_not_opened_when_the_server_never_answers(monkeypatch):
+    ouvertures = []
+    monkeypatch.setattr("wavelocalai.__main__._server_ready", lambda port: False)
+    monkeypatch.setattr("wavelocalai.__main__.PAUSE_SONDE_S", 0)
+    monkeypatch.setattr("webbrowser.open", lambda url: ouvertures.append(url) or True)
+    assert _open_browser_when_ready(8123, timeout_s=0) is False
+    assert ouvertures == []
+
