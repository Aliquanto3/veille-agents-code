+++ b/tests/core/test_texte.py
@@ -0,0 +1,134 @@
+"""Tests des fonctions de texte partagées (valeurs calculées à la main)."""
+
+import pytest
+
+from slmsp.core import texte
+from slmsp.core.texte import (
+    VERSION_TEXTE,
+    compter_mots,
+    decouper_phrases,
+    extraire_nombres,
+    kandel_moles,
+    ngrammes,
+    normaliser,
+    syllabes,
+)
+
+
+@pytest.mark.parametrize(
+    ("brut", "attendu"),
+    [
+        ("  Bonjour,   LE Monde !  ", "bonjour le monde"),
+        ("L'état: « prêt » ?", "l état prêt"),
+        ("ＡＢＣ １２", "abc 12"),
+        ("", ""),
+    ],
+)
+def test_normaliser(brut, attendu):
+    assert normaliser(brut) == attendu
+    assert normaliser(normaliser(brut)) == attendu
+
+
+@pytest.mark.parametrize(
+    ("brut", "attendu"),
+    [
+        ("Le chat dort.", 3),
+        ("Il a payé 12 euros !", 5),
+        ("", 0),
+    ],
+)
+def test_compter_mots(brut, attendu):
+    assert compter_mots(brut) == attendu
+
+
+def test_decouper_phrases():
+    assert decouper_phrases("Un. Deux ! Trois ? Quatre") == ["Un.", "Deux !", "Trois ?", "Quatre"]
+    assert decouper_phrases("Prix : 3.5 euros.\n\nFin") == ["Prix : 3.5 euros.", "Fin"]
+    assert decouper_phrases("  ") == []
+
+
+@pytest.mark.parametrize(
+    ("brut", "attendu"),
+    [
+        ("1 234,56 €", [1234.56]),
+        ("12,50 €", [12.5]),
+        ("25 €", [25.0]),
+        ("3,5 %", [3.5]),
+        ("1 234,56 €", [1234.56]),
+        ("1 000 €", [1000.0]),
+        ("de 10 à 20 jours", [10.0, 20.0]),
+        ("en 2024 pour 3,5 %", [2024.0, 3.5]),
+        ("aucun nombre", []),
+    ],
+)
+def test_extraire_nombres(brut, attendu):
+    assert extraire_nombres(brut) == attendu
+
+
+@pytest.mark.parametrize(
+    ("mot", "attendu"),
+    [
+        ("chat", 1),
+        ("les", 1),
+        ("table", 1),
+        ("tables", 1),
+        ("demande", 2),
+        ("déposer", 3),
+        ("administration", 5),
+        ("vie", 1),
+        ("SNCF", 1),
+    ],
+)
+def test_syllabes(mot, attendu):
+    assert syllabes(mot) == attendu
+
+
+def test_kandel_moles_valeur_calculee_a_la_main():
+    # 3 mots, 1 phrase, 3 syllabes : 207 - 1,015 × 3 - 73,6 × 1
+    assert kandel_moles("Le chat dort.") == pytest.approx(130.355, abs=0.1)
+    # 6 mots, 2 phrases (3 mots/phrase) ; syllabes : 1+1+1 + 1+3+1... voir détail
+    # « Le chat dort. Il mange ici. » : mange = 1 (e muet), ici = 2, il = 1, le = 1
+    # total 1+1+1+1+1+2 = 7 syllabes sur 6 mots
+    attendu = 207 - 1.015 * 3 - 73.6 * 7 / 6
+    assert kandel_moles("Le chat dort. Il mange ici.") == pytest.approx(attendu, abs=0.1)
+
+
+def test_kandel_moles_simplifie_superieur_a_administratif():
+    administratif = (
+        "Conformément aux dispositions réglementaires applicables, l'intéressé "
+        "doit transmettre l'ensemble des justificatifs nécessaires à l'instruction."
+    )
+    simplifie = "Vous devez envoyer vos papiers. Nous les lirons vite."
+    assert kandel_moles(simplifie) > kandel_moles(administratif)
+
+
+def test_kandel_moles_texte_vide():
+    with pytest.raises(ValueError, match="Kandel-Moles"):
+        kandel_moles("  ...  ")
+
+
+def test_ngrammes():
+    assert ngrammes("Le chat, dort bien", 2) == [("le", "chat"), ("chat", "dort"), ("dort", "bien")]
+    assert ngrammes("a b", 3) == []
+    with pytest.raises(ValueError, match="n-grammes"):
+        ngrammes("a b", 0)
+
+
+def test_non_regression_version_texte():
+    """Si ces valeurs changent, une règle a changé : incrémenter `VERSION_TEXTE`."""
+    empreinte = (
+        normaliser("L'État : « Prêt » ?"),
+        extraire_nombres("1 234,56 € et 3,5 %"),
+        [syllabes(m) for m in ("table", "demande", "administration")],
+        round(kandel_moles("Le chat dort."), 3),
+        ngrammes("a b c", 2),
+    )
+    assert empreinte == (
+        "l état prêt",
+        [1234.56, 3.5],
+        [1, 2, 5],
+        130.355,
+        [("a", "b"), ("b", "c")],
+    )
+    assert VERSION_TEXTE == 1
+    assert texte.VERSION_TEXTE == VERSION_TEXTE
