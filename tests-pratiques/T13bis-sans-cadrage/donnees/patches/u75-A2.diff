+"""Écran « Ce qu'il faut pour le faire en vrai » : lecture de la fiche d'outillage, sans Streamlit.
+
+La fiche (`docs/fiche-outillage.md`, Story 8.1) est lue telle quelle sous la racine de l'UI et
+affichée en lecture seule ; aucun de ses textes n'est recopié dans `ui/`.
+"""
+
+from pathlib import Path
+
+from usine.contrats.erreurs import UsineErreur
+
+FICHIER_FICHE = "docs/fiche-outillage.md"
+"""Fiche d'outillage, relative à la racine de l'UI."""
+
+FICHE_ABSENTE = (
+    f"Fiche d'outillage introuvable : {FICHIER_FICHE} (sous la racine de la démo) ;"
+    " rien à afficher."
+)
+"""Avertissement de l'écran quand la fiche n'existe pas."""
+
+LEGENDE = f"Source : {FICHIER_FICHE}, affichée en lecture seule."
+"""Légende sous la fiche : nom de la source et lecture seule."""
+
+
+def lire_fiche(racine: Path) -> str | None:
+    """Texte de la fiche sous `racine`, non transformé, ou `None` si le fichier n'existe pas."""
+    chemin = racine / FICHIER_FICHE
+    try:
+        return chemin.read_bytes().decode("utf-8")
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise UsineErreur(f"{chemin} : fiche illisible ({exc.strerror or exc})") from exc
+    except UnicodeDecodeError as exc:
+        raise UsineErreur(f"{chemin} : fiche illisible (encodage UTF-8 attendu)") from exc
