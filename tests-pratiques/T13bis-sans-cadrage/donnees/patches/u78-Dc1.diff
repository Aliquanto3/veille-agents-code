+"""Outils de consultation de l'Agent (Story 7.8) : inventaire, lecture seule, dates sans Passage."""
+
+import ast
+import json
+from datetime import date, timedelta
+from pathlib import Path
+
+import pytest
+
+from usine.consultation.passage import ConsultationPassage
+from usine.contrats.agent import AucuneDonnee
+from usine.ia.agent import outils as module_outils
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+
+PASSAGE = Path(__file__).resolve().parents[3] / "demo" / "repli" / "passage"
+
+
+@pytest.fixture(scope="module")
+def outils() -> OutilsConsultation:
+    return outils_consultation(ConsultationPassage(PASSAGE))
+
+
+def _appeler(outils: OutilsConsultation, nom: str, **arguments: object) -> dict[str, object]:
+    (outil,) = [o for o in outils.outils if o.nom == nom]
+    resultat: dict[str, object] = json.loads(outil.executer(arguments))  # type: ignore[arg-type]
+    return resultat
+
+
+def test_expose_exactement_les_cinq_outils(outils: OutilsConsultation) -> None:
+    assert NOMS_OUTILS == (
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    )
+    assert tuple(o.nom for o in outils.outils) == NOMS_OUTILS
+    assert tuple(o.nom for o in outils) == NOMS_OUTILS
+
+
+def test_aucun_outil_d_ecriture_ni_acces_jira() -> None:
+    arbre = ast.parse(Path(module_outils.__file__).read_text(encoding="utf-8"))
+    importes = {n.module or "" for n in ast.walk(arbre) if isinstance(n, ast.ImportFrom)} | {
+        a.name for n in ast.walk(arbre) if isinstance(n, ast.Import) for a in n.names
+    }
+    internes = {m.split(".")[1] for m in importes if m.startswith("usine.")}
+    assert internes <= {"contrats", "ports"}
+    interdits = ("jira", "smtplib", "httpx", "requests", "adaptateurs", "config")
+    assert not [m for m in importes if any(i in m for i in interdits)]
+    assert not any(
+        nom.startswith(("create", "update", "delete", "send", "set", "write"))
+        for nom in NOMS_OUTILS
+    )
+
+
+def test_meteo_sur_la_date_du_passage(outils: OutilsConsultation) -> None:
+    resultat = _appeler(outils, "get_meteo")
+    assert resultat["meteos"]
+    assert (
+        resultat["date_arrete"] == ConsultationPassage(PASSAGE).dates_disponibles()[-1].isoformat()
+    )
+
+
+def test_meteo_filtree_par_entite(outils: OutilsConsultation) -> None:
+    entite = _appeler(outils, "get_meteo")["meteos"][0]["entite"]  # type: ignore[index]
+    resultat = _appeler(outils, "get_meteo", entite=entite)
+    assert {m["entite"] for m in resultat["meteos"]} == {entite}  # type: ignore[attr-defined]
+    assert {e["entite"] for e in resultat["evolutions"]} <= {entite}  # type: ignore[attr-defined]
+
+
+def test_anomalies_limite_et_total(outils: OutilsConsultation) -> None:
+    toutes = _appeler(outils, "list_anomalies", limite=5000)
+    un = _appeler(outils, "list_anomalies", limite=1)
+    assert len(un["anomalies"]) <= 1  # type: ignore[arg-type]
+    assert un["total"] == toutes["total"] == len(toutes["anomalies"])  # type: ignore[arg-type]
+
+
+def test_anomalies_filtre_statut(outils: OutilsConsultation) -> None:
+    toutes = _appeler(outils, "list_anomalies", limite=5000)["anomalies"]
+    statut = toutes[0]["statut"]  # type: ignore[index]
+    filtrees = _appeler(outils, "list_anomalies", statut=statut, limite=5000)
+    attendu = [a for a in toutes if a["statut"] == statut]  # type: ignore[attr-defined]
+    assert filtrees["anomalies"] == attendu
+    assert filtrees["total"] == len(attendu)
+
+
+def test_tendance_filtree(outils: OutilsConsultation) -> None:
+    points = _appeler(outils, "get_tendance")["points"]
+    assert points
+    code = points[0]["code_kpi"]  # type: ignore[index]
+    filtres = _appeler(outils, "get_tendance", code_kpi=code)["points"]
+    assert filtres
+    assert {p["code_kpi"] for p in filtres} == {code}  # type: ignore[attr-defined]
+
+
+def test_prevision_et_risques_portent_la_date(outils: OutilsConsultation) -> None:
+    jour = ConsultationPassage(PASSAGE).dates_disponibles()[-1].isoformat()
+    assert _appeler(outils, "get_prevision")["date_arrete"] == jour
+    assert _appeler(outils, "get_risques")["date_arrete"] == jour
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_date_sans_passage_donne_aucune_donnee(outils: OutilsConsultation, nom: str) -> None:
+    absente = ConsultationPassage(PASSAGE).dates_disponibles()[-1] + timedelta(days=365)
+    resultat = _appeler(outils, nom, date_arrete=absente.isoformat())
+    assert resultat == AucuneDonnee(date_arrete=absente).model_dump(mode="json")
+    assert resultat["message"] == "aucune donnée pour cette date"
+
+
+def test_date_disponible_ancienne_est_servie(outils: OutilsConsultation) -> None:
+    premiere: date = ConsultationPassage(PASSAGE).dates_disponibles()[0]
+    resultat = _appeler(outils, "get_meteo", date_arrete=premiere.isoformat())
+    assert resultat["date_arrete"] == premiere.isoformat()
+    assert "message" not in resultat
