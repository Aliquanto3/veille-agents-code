+"""Outils de consultation de l'Agent, en lecture seule (FR-39, FR-41, AD-2, AD-5, AD-11).
+
+Exactement cinq outils, servis par `Consultation` et rien d'autre : l'Agent n'a ni accès à
+Jira, ni outil d'écriture (Jira, mail, configuration). Une date que le Passage ne couvre pas
+donne `AucuneDonnee`. Les résultats sont ceux de `contrats.agent`, sérialisés en JSON : la
+passerelle les pseudonymise et les trace avant le fournisseur.
+"""
+
+from collections.abc import Callable, Iterator, Mapping
+from dataclasses import dataclass
+from datetime import date
+
+from pydantic import BaseModel, JsonValue
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.llm import OutilAgent
+from usine.ports.consultation import Consultation, Palier
+
+NOMS_OUTILS: tuple[str, ...] = (
+    "get_meteo",
+    "list_anomalies",
+    "get_tendance",
+    "get_prevision",
+    "get_risques",
+)
+"""Les seuls outils de l'Agent, tous en lecture."""
+
+
+@dataclass(frozen=True)
+class OutilsConsultation:
+    """Les cinq outils de l'Agent, adossés à une `Consultation` unique.
+
+    Chaque méthode prend les arguments de son contrat et rend son résultat, ou `AucuneDonnee`.
+    `outils` les présente au fournisseur sous forme d'`OutilAgent`.
+    """
+
+    consultation: Consultation
+    palier: Palier = 2
+
+    def _jour(self, date_arrete: date | None) -> date | AucuneDonnee:
+        """Date effective, ou `AucuneDonnee` si le Passage ne la couvre pas."""
+        disponibles = self.consultation.dates_disponibles()
+        if date_arrete is None:
+            return disponibles[-1] if disponibles else AucuneDonnee(date_arrete=None)
+        if date_arrete not in disponibles:
+            return AucuneDonnee(date_arrete=date_arrete)
+        return date_arrete
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetMeteo(
+            date_arrete=jour,
+            meteos=self.consultation.meteo(jour, arguments.entite),
+            evolutions=tuple(
+                e
+                for e in self.consultation.evolution_meteo(jour)
+                if arguments.entite is None or e.entite == arguments.entite
+            ),
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées ; `total` les compte avant la limite."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        lues = self.consultation.anomalies(
+            date_arrete=jour,
+            entite=arguments.entite,
+            gravite=arguments.gravite,
+            phase=arguments.phase,
+            domaine=arguments.domaine,
+            limite=None,
+            palier=self.palier,
+        )
+        retenues = tuple(
+            a for a in lues.anomalies if arguments.statut is None or a.statut == arguments.statut
+        )
+        return ResultatListAnomalies(
+            date_arrete=jour, anomalies=retenues[: arguments.limite], total=len(retenues)
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire, filtrés par Entité et par KPI."""
+        table = self.consultation.tendances(arguments.entite, arguments.code_kpi)
+        return ResultatGetTendance(
+            points=tuple(
+                PointTendance.model_validate(ligne) for ligne in table.iter_rows(named=True)
+            )
+        )
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetPrevision(
+            date_arrete=jour, previsions=self.consultation.previsions(jour, arguments.entite)
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetRisques(
+            date_arrete=jour, risques=self.consultation.risques(jour, arguments.entite)
+        )
+
+    @property
+    def outils(self) -> tuple[OutilAgent, ...]:
+        """Les cinq `OutilAgent`, dans l'ordre de `NOMS_OUTILS`."""
+        return (
+            _outil(
+                "get_meteo",
+                "Météo, Règles déclenchantes et évolution J-1 / J-5 des Entités.",
+                ArgumentsGetMeteo,
+                self.get_meteo,
+            ),
+            _outil(
+                "list_anomalies",
+                "Anomalies ouvertes, filtrables par Entité, Gravité, Phase, domaine et statut.",
+                ArgumentsListAnomalies,
+                self.list_anomalies,
+            ),
+            _outil(
+                "get_tendance",
+                "Tendances hebdomadaires des KPI, filtrables par Entité et par KPI.",
+                ArgumentsGetTendance,
+                self.get_tendance,
+            ),
+            _outil(
+                "get_prevision",
+                "Prévisions de sortie du rouge, par Entité.",
+                ArgumentsGetPrevision,
+                self.get_prevision,
+            ),
+            _outil(
+                "get_risques",
+                "Risques d'entrée en rouge, par Entité.",
+                ArgumentsGetRisques,
+                self.get_risques,
+            ),
+        )
+
+    def __iter__(self) -> Iterator[OutilAgent]:
+        return iter(self.outils)
+
+
+def _outil[A: BaseModel](
+    nom: str,
+    description: str,
+    arguments: type[A],
+    appel: Callable[[A], BaseModel],
+) -> OutilAgent:
+    """Outil de consultation : arguments JSON validés, résultat sérialisé en JSON."""
+
+    def executer(brut: Mapping[str, JsonValue]) -> str:
+        return appel(arguments.model_validate(dict(brut))).model_dump_json()
+
+    return OutilAgent(nom=nom, description=description, arguments=arguments, executer=executer)
+
+
+def outils_consultation(consultation: Consultation, palier: Palier = 2) -> OutilsConsultation:
+    """Outils de l'Agent servis par `consultation` (lecture seule)."""
+    return OutilsConsultation(consultation=consultation, palier=palier)
