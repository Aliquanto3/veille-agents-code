+"""Story 3.4 : Juge LLM (un appel, pass_id dans le Cache) sur le Faux LLM, sans réseau."""
+
+import json
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from wavelibrarian import registry
+from wavelibrarian.components.judges.llm import LLMJudge
+from wavelibrarian.config.catalog import load_catalog
+from wavelibrarian.config.defaults import load_profile
+from wavelibrarian.config.experiment import Budget
+from wavelibrarian.core.errors import NonConformantOutput
+from wavelibrarian.core.types import Condition, CostPost, Phase
+from wavelibrarian.llm.budget import Ledger
+from wavelibrarian.llm.cache import ResponseCache
+from wavelibrarian.llm.gateway import MeteredGateway
+from wavelibrarian.llm.providers.fake import FakeProvider
+from wavelibrarian.measure.energy import FakeEstimator
+from wavelibrarian.measure.tokenizers import ApproxTokenizer
+from wavelibrarian.measure.tracing import Tracer
+from wavelibrarian.ports.components import ComponentSpec, JudgeInput
+
+CRITERES: list[Any] = ["correctness", "completeness", "faithfulness"]
+
+
+class _Ctx:
+    run_id = "run-1"
+    config_id = "cfg-1"
+    condition: Condition = "standard"
+    tier: int | None = None
+    phase: Phase = "base"
+    post: CostPost = "query"
+    question_id: str | None = "q-1"
+    seed = 7
+
+    def __init__(self, wl_home: Path, tmp: Path) -> None:
+        self.catalog = load_catalog()
+        self.profile = load_profile("test")
+        self.fake = FakeProvider()
+        self.ledger = Ledger(Budget(per_run={}, period={}), "run-1", wl_home)
+        self.cache = ResponseCache(wl_home)
+        self.path = tmp / "traces.jsonl"
+        self.tracer = Tracer(self, self.path)
+        self.gateway = MeteredGateway(
+            catalog=self.catalog,
+            providers={"fake": self.fake},
+            ledger=self.ledger,
+            cache=self.cache,
+            tracer=self.tracer,
+            tokenizer_for=lambda _m: ApproxTokenizer(),
+            estimator=FakeEstimator(),
+            sleep=lambda _s: None,
+        )
+
+    def build(self, kind: str, spec: ComponentSpec) -> Any:
+        cls = registry.get(kind, spec.name)
+        return cls(cls.Params(**spec.params), self)
+
+    def spans(self) -> list[dict[str, Any]]:
+        lignes = self.path.read_text(encoding="utf-8").splitlines() if self.path.exists() else []
+        return [json.loads(x) for x in lignes]
+
+
+@pytest.fixture
+def ctx(wl_home: Path, tmp_path: Path) -> Iterator[_Ctx]:
+    c = _Ctx(wl_home, tmp_path)
+    yield c
+    c.ledger.close()
+    c.cache.close()
+
+
+ITEM = JudgeInput(
+    question="Quand la guilde fut-elle fondée ?",
+    reference_answer="En 1412",
+    reference_texts=("La guilde fut fondée en 1412.",),
+    answer_text="La guilde fut fondée en 1412.",
+    context_texts=("Passage S1 fourni au Generator.",),
+)
+
+
+def test_enregistre_et_un_seul_appel_pour_trois_criteres(ctx: _Ctx) -> None:
+    registry.discover()
+    assert registry.get("judge", "llm") is LLMJudge
+    juge = ctx.build("judge", ComponentSpec(name="llm"))
+    assert juge.model_id == ctx.profile.defaults.judge_pool[0]
+    res = juge.judge(ITEM, CRITERES, pass_id=0)
+    assert set(res) == set(CRITERES)
+    for verdict, justification in res.values():
+        assert isinstance(verdict, bool) and justification
+    spans = ctx.spans()
+    assert len(spans) == 1
+    assert spans[0]["wl.step"] == "judge"
+
+
+def test_sortie_non_conforme_apres_nouvel_essai(ctx: _Ctx) -> None:
+    ctx.fake.script("judge", "*", "pas du json")
+    juge = ctx.build("judge", ComponentSpec(name="llm"))
+    with pytest.raises(NonConformantOutput):
+        juge.judge(ITEM, CRITERES, pass_id=0)
+
+
+def test_pass_id_distinct_n_est_pas_servi_par_le_cache(ctx: _Ctx) -> None:
+    juge = ctx.build("judge", ComponentSpec(name="llm"))
+    juge.judge(ITEM, CRITERES, pass_id=0)
+    juge.judge(ITEM, CRITERES, pass_id=1)
+    juge.judge(ITEM, CRITERES, pass_id=0)
+    cache = [s["wl.llm_cache_hit"] for s in ctx.spans()]
+    assert cache == [False, False, True]
+
+
+def test_contexte_du_generator_transmis_pour_la_fidelite(ctx: _Ctx) -> None:
+    vues: list[str] = []
+
+    def espion(requete: Any) -> str:
+        vues.append(requete.messages[0].content)
+        return json.dumps(
+            {"verdicts": {c: {"verdict": "yes", "justification": "ok"} for c in CRITERES}}
+        )
+
+    ctx.fake.script("judge", "*", espion)
+    juge = ctx.build("judge", ComponentSpec(name="llm"))
+    juge.judge(ITEM, CRITERES, pass_id=0)
+    juge.judge(ITEM, ["correctness"], pass_id=0)
+    assert "Passage S1 fourni au Generator." in vues[0]
+    assert "Passage S1 fourni au Generator." not in vues[1]
