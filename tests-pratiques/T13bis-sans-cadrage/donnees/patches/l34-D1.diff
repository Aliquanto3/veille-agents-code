--- a/src/wavelibrarian/scoring/answer.py
+++ b/src/wavelibrarian/scoring/answer.py
@@ -1,6 +1,7 @@
 """Forme des Réponses de référence (FR-36) : `short` = au plus 5 mots, un nombre ou une date."""
 
 import re
+import unicodedata
 
 MAX_MOTS_COURTE = 5
 
@@ -16,3 +17,28 @@ def is_short_form(texte: str) -> bool:
     if len(t.split()) <= MAX_MOTS_COURTE:
         return True
     return bool(_NOMBRE.match(t) or _DATE_NUMERIQUE.match(t))
+
+
+_MILLIERS = re.compile(r"(?<=\d)[ '  ](?=\d{3}(?!\d))")
+_DECIMALE = re.compile(r"(?<=\d),(?=\d)")
+_PONCTUATION = re.compile(r"(?!(?<=\d)\.(?=\d))[^\w\s]|_")
+
+
+def _normaliser(texte: str) -> list[str]:
+    """Mots en minuscules, sans accents ni ponctuation ; nombres écrits `1412` / `3.5`."""
+    t = unicodedata.normalize("NFKC", texte).casefold()
+    t = "".join(c for c in unicodedata.normalize("NFD", t) if not unicodedata.combining(c))
+    for _ in range(3):  # un groupe de milliers par passe
+        t = _MILLIERS.sub("", t)
+    t = _DECIMALE.sub(".", t)
+    return _PONCTUATION.sub(" ", t).split()
+
+
+def exact_match(reference: str, answer: str) -> bool:
+    """Vrai si la référence normalisée figure, mot pour mot, dans la réponse normalisée."""
+    ref = _normaliser(reference)
+    rep = _normaliser(answer)
+    if not ref:
+        return False
+    n = len(ref)
+    return any(rep[i : i + n] == ref for i in range(len(rep) - n + 1))
