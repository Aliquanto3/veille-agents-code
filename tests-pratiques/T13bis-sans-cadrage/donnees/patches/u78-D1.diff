+"""Outils de consultation de l'Agent : cinq outils, lecture seule, résultats explicites."""
+
+import ast
+import inspect
+from datetime import date
+
+import pytest
+
+from tests.contrat.consultation.fabriques import passage_publie
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.tickets import STATUTS_FERMES, StatutAnomalie
+from usine.ia.agent import outils
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+
+JOUR_SANS_PASSAGE = date(2020, 1, 1)
+
+
+@pytest.fixture
+def outils_passage() -> OutilsConsultation:
+    return outils_consultation(passage_publie().consultation)
+
+
+def _publics(classe: type) -> set[str]:
+    return {nom for nom, _ in inspect.getmembers(classe, inspect.isfunction) if nom[0] != "_"}
+
+
+def test_expose_exactement_les_cinq_outils() -> None:
+    assert NOMS_OUTILS == (
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    )
+    assert _publics(OutilsConsultation) == set(NOMS_OUTILS)
+
+
+def test_lecture_seule_sans_acces_jira() -> None:
+    """Le module n'importe que contrats et ports ; aucun nom d'écriture n'est exposé."""
+    arbre = ast.parse(inspect.getsource(outils))
+    importes = {n.module or "" for n in ast.walk(arbre) if isinstance(n, ast.ImportFrom)} | {
+        a.name for n in ast.walk(arbre) if isinstance(n, ast.Import) for a in n.names
+    }
+    assert all(m.startswith(("usine.contrats", "usine.ports", "datetime")) for m in importes), (
+        importes
+    )
+    assert not any(
+        mot in nom for nom in NOMS_OUTILS for mot in ("write", "update", "send", "set_", "post")
+    )
+
+
+def test_meteo_et_filtre_entite(outils_passage: OutilsConsultation) -> None:
+    tout = outils_passage.get_meteo(ArgumentsGetMeteo())
+    assert isinstance(tout, ResultatGetMeteo)
+    assert tout.meteos
+    un = outils_passage.get_meteo(ArgumentsGetMeteo(entite="ENT-A"))
+    assert isinstance(un, ResultatGetMeteo)
+    assert {m.entite for m in un.meteos} == {"ENT-A"}
+    assert {e.entite for e in un.evolutions} <= {"ENT-A"}
+
+
+def test_anomalies_filtre_statut_et_limite(outils_passage: OutilsConsultation) -> None:
+    toutes = outils_passage.list_anomalies(ArgumentsListAnomalies())
+    assert isinstance(toutes, ResultatListAnomalies)
+    assert toutes.total >= 1
+    statut = toutes.anomalies[0].statut
+    assert statut not in STATUTS_FERMES
+    filtrees = outils_passage.list_anomalies(ArgumentsListAnomalies(statut=statut))
+    assert isinstance(filtrees, ResultatListAnomalies)
+    assert filtrees.anomalies
+    assert {a.statut for a in filtrees.anomalies} == {statut}
+    autre = next(s for s in StatutAnomalie if s != statut and s not in STATUTS_FERMES)
+    nombre = sum(a.statut == autre for a in toutes.anomalies)
+    ailleurs = outils_passage.list_anomalies(ArgumentsListAnomalies(statut=autre))
+    assert isinstance(ailleurs, ResultatListAnomalies)
+    assert ailleurs.total == nombre
+    bornee = outils_passage.list_anomalies(ArgumentsListAnomalies(limite=1))
+    assert isinstance(bornee, ResultatListAnomalies)
+    assert len(bornee.anomalies) == 1
+    assert bornee.total == toutes.total
+
+
+def test_tendance(outils_passage: OutilsConsultation) -> None:
+    resultat = outils_passage.get_tendance(ArgumentsGetTendance(entite="ENT-A"))
+    assert isinstance(resultat, ResultatGetTendance)
+    assert resultat.points
+    assert {p.perimetre for p in resultat.points} == {"ENT-A"}
+
+
+def test_prevision_et_risques_sur_le_passage(outils_passage: OutilsConsultation) -> None:
+    previsions = outils_passage.get_prevision(ArgumentsGetPrevision())
+    risques = outils_passage.get_risques(ArgumentsGetRisques())
+    assert not isinstance(previsions, AucuneDonnee)
+    assert not isinstance(risques, AucuneDonnee)
+    assert previsions.date_arrete == risques.date_arrete == date(2026, 10, 9)
+
+
+@pytest.mark.parametrize(
+    "appel",
+    [
+        lambda o: o.get_meteo(ArgumentsGetMeteo(date_arrete=JOUR_SANS_PASSAGE)),
+        lambda o: o.list_anomalies(ArgumentsListAnomalies(date_arrete=JOUR_SANS_PASSAGE)),
+        lambda o: o.get_prevision(ArgumentsGetPrevision(date_arrete=JOUR_SANS_PASSAGE)),
+        lambda o: o.get_risques(ArgumentsGetRisques(date_arrete=JOUR_SANS_PASSAGE)),
+    ],
+)
+def test_date_sans_passage(outils_passage: OutilsConsultation, appel) -> None:  # type: ignore[no-untyped-def]
+    resultat = appel(outils_passage)
+    assert resultat == AucuneDonnee(date_arrete=JOUR_SANS_PASSAGE)
+    assert resultat.message == "aucune donnée pour cette date"
