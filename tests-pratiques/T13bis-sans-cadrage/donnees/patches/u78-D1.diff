+"""Outils de consultation de l'Agent, en lecture seule (FR-39, FR-41, AD-2, AD-5, AD-11).
+
+Chaque outil lit les chiffres d'un Passage par le port `Consultation`, sans autre dépendance :
+l'Agent n'a aucun accès à Jira et n'écrit rien (Jira, mail, configuration). Une Date d'arrêté
+que le Passage ne couvre pas donne le résultat explicite `AucuneDonnee`.
+"""
+
+from datetime import date
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS: tuple[str, ...] = (
+    "get_meteo",
+    "list_anomalies",
+    "get_tendance",
+    "get_prevision",
+    "get_risques",
+)
+"""Les cinq outils de l'Agent, tous en lecture seule."""
+
+
+class OutilsConsultation:
+    """Outils de l'Agent servis par une `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _jour(self, date_arrete: date | None) -> date | AucuneDonnee:
+        """Date d'arrêté effective, ou `AucuneDonnee` si le Passage ne la couvre pas."""
+        disponibles = self._consultation.dates_disponibles()
+        if date_arrete is not None:
+            if date_arrete in disponibles:
+                return date_arrete
+            return AucuneDonnee(date_arrete=date_arrete)
+        try:
+            return self._consultation.manifeste().date_arrete
+        except UsineErreur:
+            return AucuneDonnee(date_arrete=None)
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        meteos = self._consultation.meteo(jour, arguments.entite)
+        evolutions = tuple(
+            e
+            for e in self._consultation.evolution_meteo(jour)
+            if arguments.entite is None or e.entite == arguments.entite
+        )
+        return ResultatGetMeteo(date_arrete=jour, meteos=meteos, evolutions=evolutions)
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées par Entité, Gravité, Phase, domaine et statut."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        # Le port ne filtre pas le statut : on lit tout, puis on filtre et on borne ici.
+        lues = self._consultation.anomalies(
+            jour,
+            entite=arguments.entite,
+            gravite=arguments.gravite,
+            phase=arguments.phase,
+            domaine=arguments.domaine,
+            limite=None,
+        )
+        retenues = tuple(
+            a for a in lues.anomalies if arguments.statut is None or a.statut == arguments.statut
+        )
+        return ResultatListAnomalies(
+            date_arrete=jour,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire, sur tout le Passage."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        points = tuple(
+            PointTendance(
+                date=ligne["date"],
+                perimetre=ligne["perimetre"],
+                code_kpi=ligne["code_kpi"],
+                dimension=ligne["dimension"],
+                numerateur=ligne["numerateur"],
+                denominateur=ligne["denominateur"],
+            )
+            for ligne in table.iter_rows(named=True)
+        )
+        return ResultatGetTendance(points=points)
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetPrevision(
+            date_arrete=jour, previsions=self._consultation.previsions(jour, arguments.entite)
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetRisques(
+            date_arrete=jour, risques=self._consultation.risques(jour, arguments.entite)
+        )
+
+
+def outils_consultation(consultation: Consultation) -> OutilsConsultation:
+    """Outils de l'Agent lisant le Passage `consultation`."""
+    return OutilsConsultation(consultation)
