+++ b/src/slmsp/train/masque.py
@@ -0,0 +1,93 @@
+"""Masque de perte par rendu incrémental (AD-7, H-MASQUE).
+
+Pour chaque tour `assistant`, l'intervalle de caractères appris va de la fin du rendu des
+messages précédents (avec amorce de génération) à la fin du rendu incluant ce tour. Les
+tokens entièrement contenus dans un intervalle gardent leur identifiant comme label ; tous
+les autres valent `IGNORE`.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+from slmsp.core.schemas.config_modele import ConfigModele
+from slmsp.train.rendu import apply_chat_template
+
+IGNORE = -100
+"""Label ignoré par la perte (convention PyTorch / transformers)."""
+
+
+class ErreurMasque(ValueError):
+    """Le rendu ne permet pas de délimiter les tours `assistant`."""
+
+
+def intervalles_assistant(
+    tokenizer: Any,
+    messages: Sequence[Mapping[str, Any]],
+    *,
+    tools: Sequence[Mapping[str, Any]] | None = None,
+    config: ConfigModele | None = None,
+) -> tuple[str, list[tuple[int, int]]]:
+    """Texte complet et intervalles `[début, fin)` (caractères) des tours `assistant`."""
+
+    def rendre(n: int, amorce: bool) -> str:
+        return apply_chat_template(
+            tokenizer, messages[:n], tools=tools, config=config, add_generation_prompt=amorce
+        )
+
+    texte = rendre(len(messages), False)
+    intervalles: list[tuple[int, int]] = []
+    for i, message in enumerate(messages):
+        if message.get("role") != "assistant":
+            continue
+        avant = rendre(i, True)
+        jusque = rendre(i + 1, False)
+        if not jusque.startswith(avant):
+            raise ErreurMasque(
+                f"Le rendu du message {i} ne prolonge pas celui des précédents : "
+                "rendu incrémental impossible avec ce template"
+            )
+        if not texte.startswith(jusque):
+            raise ErreurMasque(
+                f"Le rendu jusqu'au message {i} n'est pas un préfixe du rendu complet"
+            )
+        if len(jusque) == len(avant):
+            raise ErreurMasque(f"Le tour assistant {i} ne produit aucun texte")
+        intervalles.append((len(avant), len(jusque)))
+    return texte, intervalles
+
+
+def calculer_masque(
+    tokenizer: Any,
+    messages: Sequence[Mapping[str, Any]],
+    *,
+    tools: Sequence[Mapping[str, Any]] | None = None,
+    config: ConfigModele | None = None,
+) -> tuple[list[int], list[int]]:
+    """`(input_ids, labels)` : label = identifiant dans un tour `assistant`, −100 ailleurs."""
+    texte, intervalles = intervalles_assistant(tokenizer, messages, tools=tools, config=config)
+    codage = tokenizer(texte, add_special_tokens=False, return_offsets_mapping=True)
+    ids = list(codage["input_ids"])
+    decalages = codage["offset_mapping"]
+    labels = [IGNORE] * len(ids)
+    for k, (debut, fin) in enumerate(decalages):
+        if fin > debut and any(a <= debut and fin <= b for a, b in intervalles):
+            labels[k] = ids[k]
+    return ids, labels
+
+
+def texte_non_masque(tokenizer: Any, ids: Sequence[int], labels: Sequence[int]) -> list[str]:
+    """Décodage de chaque plage contiguë de tokens non masqués."""
+    if len(ids) != len(labels):
+        raise ErreurMasque("ids et labels n'ont pas la même longueur")
+    plages: list[list[int]] = []
+    precedent_appris = False
+    for identifiant, label in zip(ids, labels, strict=True):
+        appris = label != IGNORE
+        if appris:
+            if not precedent_appris:
+                plages.append([])
+            plages[-1].append(identifiant)
+        precedent_appris = appris
+    return [tokenizer.decode(p, skip_special_tokens=False) for p in plages]
diff --git a/src/slmsp/train/rendu.py b/src/slmsp/train/rendu.py
