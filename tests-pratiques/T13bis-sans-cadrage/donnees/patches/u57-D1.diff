+"""Porte Palier 1 (M3, Story 5.7) : NFR-2 avec extraction incrémentale, Rejeu idempotent.
+
+Test `lent` : exclu par défaut (`pyproject.toml`), lancé par
+`uv run pytest -m lent tests/unit/chaine/test_porte_m3.py -s` (`-s` affiche la mesure).
+Deux Passages Palier 1 de même Date d'arrêté s'exécutent sur le Journal à la volumétrie cible
+(`config/programme.yaml` livré), avec une vraie `EtapeExtraction` (source : le Journal, entrepôt
+DuckDB) à la place du bouchon : le premier extrait tout, le second est incrémental. Chacun,
+construction de la composition comprise, dure moins de 5 minutes. Les deux Passages ne diffèrent
+que par leur identifiant : le Rejeu est idempotent.
+"""
+
+import json
+import time
+from datetime import timedelta
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.chaine.environnement import (
+    DATE_ARRETE,
+    INSTANT,
+    horloge_figee,
+    preparer_racine,
+)
+from usine.adaptateurs.entrepot_duckdb import CHEMIN_ENTREPOT, EntrepotDuckDB, EtapeExtraction
+from usine.adaptateurs.journal import SourceJournal
+from usine.chaine.ecrivain import EcrivainPassage
+from usine.chaine.execution import executer_passage
+from usine.composition import construire_rapport
+from usine.contrats.passage import CHEMIN_JOURNAL, FICHIERS_PASSAGE, Etape, StatutEtape
+
+pytestmark = pytest.mark.lent
+
+CIBLE_SECONDES = 5 * 60
+"""Cible NFR-2 : un Passage en Palier 1 en moins de 5 minutes."""
+TABLES = ("tickets_etats", "instantanes", "kpi", "indicateurs", "tendances")
+
+
+def _passage(racine: Path, alea: str, instant_decalage: int) -> tuple[Path, float, int]:
+    """Un Passage avec extraction réelle : (répertoire publié, durée en s, événements ajoutés)."""
+    horloge = horloge_figee(INSTANT + timedelta(hours=instant_decalage))
+    debut = time.perf_counter()
+    rapport = construire_rapport(racine, horloge=horloge)
+    extraction = EtapeExtraction(
+        SourceJournal(racine / CHEMIN_JOURNAL),
+        racine / CHEMIN_ENTREPOT,
+        timedelta(minutes=10),
+        horloge,
+    )
+    ecrivain = EcrivainPassage(rapport.racine_sorties, horloge)
+    manifeste = executer_passage(
+        {**rapport.registre, Etape.extraction: extraction},
+        rapport.configuration,
+        DATE_ARRETE,
+        ecrivain,
+        rapport.fabrique_consultation(DATE_ARRETE),
+        horloge,
+        lambda: alea,
+        rapport.donnees,
+    )
+    duree = time.perf_counter() - debut
+    rapport.fermer()
+    statuts = {e.etape: e.statut for e in manifeste.etapes}
+    assert statuts[Etape.extraction] is StatutEtape.reussie
+    assert ecrivain.repertoire_publie is not None
+    return (
+        ecrivain.repertoire_publie,
+        duree,
+        len(list(EntrepotDuckDB(extraction.chemin).evenements())),
+    )
+
+
+def test_porte_m3(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    racine = preparer_racine(tmp_path, programme_complet=True)
+    monkeypatch.chdir(racine)  # aucun `.env` du poste lu par `Secrets`
+    monkeypatch.delenv("USINE_MODE_REPLI", raising=False)
+
+    premier, duree_complete, stockes = _passage(racine, "a1b2c3", 0)
+    second, duree_incrementale, stockes_apres = _passage(racine, "d4e5f6", 1)
+    print(
+        f"\nPorte M3 : {stockes} événements extraits ; Passage avec extraction complète "
+        f"{duree_complete:.2f} s, Passage avec extraction incrémentale "
+        f"{duree_incrementale:.2f} s (cible {CIBLE_SECONDES} s)"
+    )
+
+    assert duree_complete < CIBLE_SECONDES
+    assert duree_incrementale < CIBLE_SECONDES
+    # Rejeu : la marge de recouvrement relit des événements déjà stockés, sans doublon.
+    assert stockes_apres == stockes > 0
+
+    for nom in TABLES:
+        fichier = FICHIERS_PASSAGE[nom]
+        assert pl.read_parquet(premier / fichier).equals(pl.read_parquet(second / fichier)), nom
+    for nom in ("meteo", "previsions"):
+        contenus = [
+            json.loads((p / FICHIERS_PASSAGE[nom]).read_text(encoding="utf-8"))
+            for p in (premier, second)
+        ]
+        for contenu in contenus:
+            contenu.pop("passage_id", None)
+        assert contenus[0] == contenus[1], nom
