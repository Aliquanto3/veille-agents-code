     elif ecran is not Ecran.carte:
         assert page.subheader[0].value == ecran.value
         assert f"Story {STORY_A_VENIR[ecran]}" in page.info[-1].value
 
 
+def test_outillage_affiche_la_fiche(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    (tmp_path / "docs").mkdir()
+    (tmp_path / outillage.FICHIER_FICHE).write_text("# Fiche d'essai\n", encoding="utf-8")
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("USINE_MODE_REPLI", "1")
+    page = _page(Ecran.outillage)
+    assert not page.exception
+    assert "# Fiche d'essai" in _textes(page)
+    assert outillage.LEGENDE in [c.value for c in page.caption]
+
+
+def test_outillage_fiche_absente(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("USINE_MODE_REPLI", "1")
+    page = _page(Ecran.outillage)
+    assert not page.exception
+    assert outillage.FICHE_ABSENTE in [w.value for w in page.warning]
+
+
+def test_lire_fiche(tmp_path: Path) -> None:
+    assert outillage.lire_fiche(tmp_path) is None
+    (tmp_path / "docs").mkdir()
+    (tmp_path / outillage.FICHIER_FICHE).write_text("Contenu é\n", encoding="utf-8")
+    assert outillage.lire_fiche(tmp_path) == "Contenu é\n"
+
+
 def test_bouton_entite(racine_publiee: Path, monkeypatch: pytest.MonkeyPatch) -> None:
