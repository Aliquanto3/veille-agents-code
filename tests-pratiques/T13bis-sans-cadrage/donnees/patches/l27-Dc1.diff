@@ -0,0 +1,75 @@
+"""Paliers de volume emboîtés (story 2.7)."""
+
+from pathlib import Path
+
+import pytest
+from typer.testing import CliRunner
+
+from wavelibrarian.cli import app
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.corpus.declare import TiersSpec
+from wavelibrarian.corpus.tiers import tirer, tirer_chemins
+
+MINI = Path(__file__).resolve().parents[3] / "corpora" / "minicorpus"
+TIERS = TiersSpec(seed=42, sizes=(5, 10, 20))
+REQUIS = ("note-obsolete.md", "recette-soupe-algues.md", "atlas-vaelmor.md")
+
+
+def _chemins(minicorpus):
+    return [d.source_path for d in minicorpus.documents]
+
+
+def test_emboites_et_requis_presents(minicorpus):
+    p = tirer_chemins(_chemins(minicorpus), TIERS, REQUIS)
+    assert [len(p[t]) for t in (5, 10, 20)] == [5, 10, 20]
+    assert set(p[5]) <= set(p[10]) <= set(p[20])
+    for t in p:
+        assert set(REQUIS) <= set(p[t])
+
+
+def test_reproductible_et_graine(minicorpus):
+    chemins = _chemins(minicorpus)
+    assert tirer_chemins(chemins, TIERS, REQUIS) == tirer_chemins(chemins, TIERS, REQUIS)
+    autre = tirer_chemins(chemins, TiersSpec(seed=7, sizes=(5, 10, 20)), REQUIS)
+    assert autre[10] != tirer_chemins(chemins, TIERS, REQUIS)[10]
+
+
+def test_requis_trop_nombreux(minicorpus):
+    with pytest.raises(ConfigError, match="requis"):
+        tirer_chemins(_chemins(minicorpus), TiersSpec(seed=1, sizes=(2, 10)), REQUIS)
+
+
+def test_taille_trop_grande(minicorpus):
+    with pytest.raises(ConfigError) as exc:
+        tirer_chemins(_chemins(minicorpus), TiersSpec(seed=1, sizes=(5, 99)), REQUIS)
+    assert "tiers.sizes[1]" in str(exc.value)
+
+
+def test_requis_inconnu(minicorpus):
+    with pytest.raises(ConfigError):
+        tirer_chemins(_chemins(minicorpus), TIERS, ("absent.md",))
+
+
+def test_sous_corpus_et_fingerprint(minicorpus):
+    p = tirer(minicorpus, TIERS, REQUIS)
+    assert [len(p[t].documents) for t in (5, 10, 20)] == [5, 10, 20]
+    assert len({p[t].fingerprint for t in p}) == 3
+    assert p[20].fingerprint == minicorpus.fingerprint
+    assert p[5].corpus_id == minicorpus.corpus_id
+    assert [d.source_path for d in p[5].documents] == sorted(d.source_path for d in p[5].documents)
+
+
+def test_commande_paliers():
+    res = CliRunner().invoke(
+        app, ["corpus", "paliers", str(MINI / "corpus.yaml"), "--requis", REQUIS[0]]
+    )
+    assert res.exit_code == 0, res.output
+    assert "Palier 5 : 5 Documents" in res.output
+    assert REQUIS[0] in res.output
+
+
+def test_commande_requis_trop_nombreux():
+    args = ["corpus", "paliers", str(MINI / "corpus.yaml")]
+    for r in REQUIS + ("a.md", "b.md", "c.md"):
+        args += ["--requis", r]
+    assert CliRunner().invoke(app, args).exit_code == 2
