@@ -0,0 +1,64 @@
+"""Paliers de volume emboîtés et déterministes (FR-54, AD-20).
+
+Les Documents requis (ceux des Ancrages de référence) figurent dans tous les Paliers. Les autres
+sont classés par une empreinte dérivée de la graine : chaque Palier prend le début de ce classement,
+donc les Paliers sont emboîtés, et une autre graine change le tirage.
+"""
+
+from collections.abc import Iterable
+
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.ids import sha16
+from wavelibrarian.core.types import ParsedCorpus
+from wavelibrarian.corpus.declare import TiersSpec
+from wavelibrarian.corpus.ingest import empreinte
+
+
+def tirer_chemins(
+    chemins: Iterable[str], tiers: TiersSpec, required_paths: Iterable[str] = ()
+) -> dict[int, tuple[str, ...]]:
+    """Tire les Paliers : taille -> `source_path` triés.
+
+    `ConfigError` si un chemin requis est inconnu, si les chemins requis dépassent la plus petite
+    taille, ou si une taille dépasse le nombre de Documents (chemin `tiers.sizes[i]`).
+    """
+    tous = sorted(set(chemins))
+    requis = sorted(set(required_paths))
+    for chemin in requis:
+        if chemin not in tous:
+            raise ConfigError("required_paths", f"{chemin!r} n'est pas un Document du Corpus")
+    for i, taille in enumerate(tiers.sizes):
+        if taille > len(tous):
+            raise ConfigError(
+                f"tiers.sizes[{i}]",
+                f"la taille {taille} dépasse le nombre de Documents du Corpus ({len(tous)})",
+            )
+    if len(requis) > tiers.sizes[0]:
+        raise ConfigError(
+            "tiers.sizes[0]",
+            f"le Palier {tiers.sizes[0]} ne peut pas contenir tous les Documents requis "
+            f"({len(requis)})",
+        )
+    ordre = sorted(
+        (c for c in tous if c not in requis), key=lambda c: (sha16(str(tiers.seed), c), c)
+    )
+    return {
+        taille: tuple(sorted([*requis, *ordre[: taille - len(requis)]])) for taille in tiers.sizes
+    }
+
+
+def sous_corpus(parsed: ParsedCorpus, chemins: Iterable[str]) -> ParsedCorpus:
+    """`ParsedCorpus` restreint aux Documents `chemins`, avec sa propre `fingerprint`."""
+    gardes = set(chemins)
+    documents = tuple(d for d in parsed.documents if d.source_path in gardes)
+    return ParsedCorpus(
+        corpus_id=parsed.corpus_id, fingerprint=empreinte(documents), documents=documents
+    )
+
+
+def tirer(
+    parsed: ParsedCorpus, tiers: TiersSpec, required_paths: Iterable[str] = ()
+) -> dict[int, ParsedCorpus]:
+    """Sous-corpus de chaque Palier : taille -> `ParsedCorpus` restreint."""
+    paliers = tirer_chemins((d.source_path for d in parsed.documents), tiers, required_paths)
+    return {taille: sous_corpus(parsed, chemins) for taille, chemins in paliers.items()}
diff --git a/tests/unit/corpus/test_tiers.py b/tests/unit/corpus/test_tiers.py
