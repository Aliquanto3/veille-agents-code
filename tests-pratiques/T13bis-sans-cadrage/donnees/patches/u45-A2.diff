@@ -0,0 +1,212 @@
+"""Recette de la Prévision sur les Scénarios de démo (Story 4.5, FR-20, FR-21, SM-6).
+
+Un vrai Passage (`executer_passage`, registre de `construire_rapport`, rendu en bouchon) est
+exécuté à la Date d'arrêté D, dernier Jour ouvré de l'historique généré (Programme, Grille,
+`chaine.yaml` et Corpus livrés, Scénarios `SCENARIOS_PAR_DEFAUT`). On lit ensuite
+`previsions.json` brut : A sort dans l'horizon, B ne sort pas, C est signalée.
+
+Un écart se corrige dans les valeurs du générateur (`config/programme.yaml` et
+`SCENARIOS_PAR_DEFAUT`), jamais en réglant la Baseline, le Risque, la Grille ou `chaine.yaml`
+(SM-C3).
+"""
+
+import json
+import shutil
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+from functools import cache
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from tests.unit.chaine.environnement import RACINE_DEPOT, horloge_pas_a_pas
+from usine.chaine.ecrivain import EcrivainPassage
+from usine.chaine.etapes import EtapeBouchon
+from usine.chaine.execution import executer_passage
+from usine.composition import construire_rapport
+from usine.config import charger_yaml
+from usine.contrats.config import ConfigChaine, ConfigProgramme, GrilleMeteo
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite, Operateur
+from usine.contrats.passage import CHEMIN_JOURNAL, FICHIERS_PASSAGE, Etape
+from usine.domaine.prevision.baseline import ParametresBaseline
+from usine.domaine.prevision.commun import avancer, declenche
+from usine.domaine.prevision.risque import ParametresRisque
+from usine.generateur.corpus import CHEMIN_CORPUS, Corpus, charger_corpus
+from usine.generateur.journal import ecrire_journal, generer
+
+GRAINE = 42
+DATE_GENERATION = date(2026, 10, 12)
+GRAINES_LENTES = (1, 7, 123)
+DATES_LENTES = (
+    date(2026, 10, 13),
+    date(2026, 10, 15),
+    date(2026, 10, 16),
+    date(2026, 10, 17),
+)
+LUNDI, MARDI = 0, 1
+
+
+@dataclass(frozen=True)
+class Resultat:
+    """Passage recetté : date D, Météo à D et `previsions.json` brut."""
+
+    date_arrete: date
+    meteo: dict[str, MeteoEntite]
+    previsions: list[dict[str, Any]]
+    risques: list[dict[str, Any]]
+    grille: GrilleMeteo
+    horizon: int
+
+
+@cache
+def _corpus_versionne() -> Corpus:
+    return charger_corpus(RACINE_DEPOT / CHEMIN_CORPUS)
+
+
+def _passage(graine: int, date_generation: date, racine: Path) -> Resultat:
+    shutil.copytree(RACINE_DEPOT / "config", racine / "config")
+    shutil.copytree(RACINE_DEPOT / "gabarits", racine / "gabarits")
+    programme = charger_yaml(racine / "config" / "programme.yaml", ConfigProgramme)
+    generation = generer(programme, graine, date_generation, corpus=_corpus_versionne())
+    ecrire_journal(generation, racine / CHEMIN_JOURNAL.parent)
+    jour = generation.entete.date_injection
+
+    horloge = horloge_pas_a_pas()
+    rapport = construire_rapport(racine, horloge=horloge)
+    registre = {**rapport.registre, Etape.rendu: EtapeBouchon()}
+    ecrivain = EcrivainPassage(rapport.racine_sorties, horloge)
+    fabrique = rapport.fabrique_consultation(jour)
+    executer_passage(
+        registre,
+        rapport.configuration,
+        jour,
+        ecrivain,
+        fabrique,
+        horloge,
+        lambda: "abc123",
+        rapport.donnees,
+    )
+    publie = ecrivain.repertoire_publie
+    assert publie is not None, "Passage non publié"
+    contenu = json.loads((publie / FICHIERS_PASSAGE["previsions"]).read_text(encoding="utf-8"))
+    contenu = contenu["contenu"]
+    meteo = {m.entite: m for m in fabrique(publie).meteo(jour)}
+    grille = rapport.configuration.grille_meteo
+    assert grille is not None
+    return Resultat(
+        date_arrete=jour,
+        meteo=meteo,
+        previsions=[p for p in contenu["previsions"] if p["date_arrete"] == jour.isoformat()],
+        risques=[x for x in contenu["risques"] if x["date_arrete"] == jour.isoformat()],
+        grille=grille,
+        horizon=rapport.configuration.chaine.prevision.baseline.horizon,
+    )
+
+
+_CACHE: dict[tuple[int, date], Resultat] = {}
+
+
+def _resultat(
+    graine: int, date_generation: date, tmp_path_factory: pytest.TempPathFactory
+) -> Resultat:
+    cle = (graine, date_generation)
+    if cle not in _CACHE:
+        racine = tmp_path_factory.mktemp(f"recette-{graine}-{date_generation.isoformat()}")
+        _CACHE[cle] = _passage(graine, date_generation, racine)
+    return _CACHE[cle]
+
+
+def _verifier_sm6(r: Resultat) -> None:
+    jour = r.date_arrete
+    couleurs = {e: m.couleur for e, m in r.meteo.items()}
+    assert couleurs["ENT-A"] is Couleur.rouge, f"A à {jour} : {couleurs['ENT-A']}"
+    assert couleurs["ENT-B"] is Couleur.rouge, f"B à {jour} : {couleurs['ENT-B']}"
+    assert couleurs["ENT-C"] is not Couleur.rouge, f"C à {jour} : {couleurs['ENT-C']}"
+
+    par_entite = {p["entite"]: p for p in r.previsions}
+    assert {p["entite"] for p in r.previsions} >= {"ENT-A", "ENT-B"}
+    assert "ENT-C" not in par_entite, "C est non rouge : aucune Prévision attendue"
+
+    for code in ("ENT-A", "ENT-B"):
+        lot = [p for p in r.previsions if p["entite"] == code]
+        detail = [(p["statut"], p["regles_non_projetables"]) for p in lot]
+        assert len(lot) == 1, f"{code} : {len(lot)} Prévisions {detail}"
+        assert lot[0]["methode"] == "baseline", f"{code} : {detail}"
+        assert lot[0]["regles_non_projetables"] == [], f"{code} : {detail}"
+
+    a, b = par_entite["ENT-A"], par_entite["ENT-B"]
+    message = f"A : {a['statut']} {a['regles_non_projetables']}"
+    assert a["statut"] == "sortie_projetee", message
+    sortie = date.fromisoformat(a["date_sortie_estimee"])
+    assert jour < sortie <= avancer(jour, r.horizon), f"A : sortie {sortie} hors horizon"
+
+    message = f"B : {b['statut']} {b['regles_non_projetables']}"
+    assert b["statut"] == "pas_de_sortie_projetee", message
+    assert not any(
+        b.get(cle)
+        for cle in ("date_sortie_estimee", "date_sortie_optimiste", "date_sortie_pessimiste")
+    ), f"B porte une date de sortie : {b}"
+
+    risques_c = [x for x in r.risques if x["entite"] == "ENT-C"]
+    assert risques_c, "C ne porte aucun Risque d'entrée en rouge"
+    for risque in risques_c:
+        _verifier_risque(r, risque)
+    if jour.weekday() in (LUNDI, MARDI):
+        codes = {x["indicateur"] for x in risques_c}
+        assert CodeIndicateur.ind_4.value in codes, f"IND-4 absent des Risques de C : {codes}"
+
+
+def _verifier_risque(r: Resultat, risque: dict[str, Any]) -> None:
+    jour = r.date_arrete
+    assert "valeur_projetee_numerateur" in risque, f"valeur projetée absente : {risque}"
+    assert "valeur_projetee_denominateur" in risque, f"valeur projetée absente : {risque}"
+    projetee = Fraction(
+        risque["valeur_projetee_numerateur"], risque["valeur_projetee_denominateur"]
+    )
+    regle = r.grille.indicateurs[CodeIndicateur(risque["indicateur"])]
+    operateur, seuil = regle.seuils[Couleur.rouge]
+    assert isinstance(operateur, Operateur)
+    assert declenche(projetee, operateur, seuil), f"{risque['indicateur']} : {projetee} sans seuil"
+    franchissement = date.fromisoformat(risque["date_franchissement_estimee"])
+    assert jour < franchissement <= avancer(jour, 5), f"franchissement hors horizon : {risque}"
+
+
+def test_baseline_et_risque_par_defaut() -> None:
+    """Garde SM-C3 : `chaine.yaml` livré garde les paramètres par défaut H-7 et H-8."""
+    chaine = charger_yaml(RACINE_DEPOT / "config" / "chaine.yaml", ConfigChaine)
+    assert ParametresBaseline(**chaine.prevision.baseline.model_dump()) == ParametresBaseline()
+    assert ParametresRisque(**chaine.prevision.risque.model_dump()) == ParametresRisque()
+
+
+def test_meteo_a_d_vendredi(tmp_path_factory: pytest.TempPathFactory) -> None:
+    r = _resultat(GRAINE, DATE_GENERATION, tmp_path_factory)
+    assert r.date_arrete.weekday() == 4
+    assert r.meteo["ENT-A"].couleur is Couleur.rouge
+    assert r.meteo["ENT-B"].couleur is Couleur.rouge
+    assert r.meteo["ENT-C"].couleur is not Couleur.rouge
+
+
+def test_sm6_d_vendredi(tmp_path_factory: pytest.TempPathFactory) -> None:
+    _verifier_sm6(_resultat(GRAINE, DATE_GENERATION, tmp_path_factory))
+
+
+def test_sm6_d_mardi(tmp_path_factory: pytest.TempPathFactory) -> None:
+    r = _resultat(GRAINE, date(2026, 10, 14), tmp_path_factory)
+    assert r.date_arrete.weekday() == MARDI
+    _verifier_sm6(r)
+
+
+@pytest.mark.lent
+@pytest.mark.parametrize("date_generation", DATES_LENTES, ids=lambda d: d.isoformat())
+def test_sm6_autres_jours_de_generation(
+    date_generation: date, tmp_path_factory: pytest.TempPathFactory
+) -> None:
+    _verifier_sm6(_resultat(GRAINE, date_generation, tmp_path_factory))
+
+
+@pytest.mark.lent
+@pytest.mark.parametrize("graine", GRAINES_LENTES)
+def test_sm6_autres_graines(graine: int, tmp_path_factory: pytest.TempPathFactory) -> None:
+    _verifier_sm6(_resultat(graine, DATE_GENERATION, tmp_path_factory))
