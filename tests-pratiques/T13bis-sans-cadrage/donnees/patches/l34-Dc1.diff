--- a/src/wavelibrarian/scoring/answer.py
+++ b/src/wavelibrarian/scoring/answer.py
@@ -1,6 +1,7 @@
 """Forme des Réponses de référence (FR-36) : `short` = au plus 5 mots, un nombre ou une date."""
 
 import re
+import unicodedata
 
 MAX_MOTS_COURTE = 5
 
@@ -16,3 +17,27 @@ def is_short_form(texte: str) -> bool:
     if len(t.split()) <= MAX_MOTS_COURTE:
         return True
     return bool(_NOMBRE.match(t) or _DATE_NUMERIQUE.match(t))
+
+
+_MILLIERS = re.compile(r"(?<!\d)\d{1,3}(?:[   ']\d{3})+(?!\d)")
+_DECIMAL = re.compile(r"(?<=\d),(?=\d)")
+_JETON = re.compile(r"\d+(?:\.\d+)?|[^\W\d_]+")
+
+
+def _jetons(texte: str) -> list[str]:
+    """Texte normalisé en mots et nombres : casse, accents, ponctuation, format des nombres."""
+    t = unicodedata.normalize("NFKD", texte).casefold()
+    t = "".join(c for c in t if not unicodedata.combining(c))
+    t = _MILLIERS.sub(lambda m: re.sub(r"\D", "", m.group(0)), t)
+    t = _DECIMAL.sub(".", t)
+    return _JETON.findall(t)
+
+
+def exact_match(reference: str, answer: str) -> bool:
+    """Vrai si la référence normalisée figure, mot pour mot, dans la réponse normalisée."""
+    ref = _jetons(reference)
+    if not ref:
+        return False
+    rep = _jetons(answer)
+    n = len(ref)
+    return any(rep[i : i + n] == ref for i in range(len(rep) - n + 1))
