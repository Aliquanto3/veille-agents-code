@@ -0,0 +1,208 @@
+"""Story 6.3 : Architecture `hyde` (recherche dense avec une réponse hypothétique)."""
+
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pytest
+
+from wavelibrarian import registry
+from wavelibrarian.architectures.hyde import Hyde
+from wavelibrarian.core.types import ParsedCorpus, QuestionInput
+from wavelibrarian.llm.providers.fake import FakeProvider
+from wavelibrarian.ports.architecture import CorpusChange
+from wavelibrarian.ports.components import ComponentSpec
+from wavelibrarian.runner.context import Context as RunCtx
+from wavelibrarian.runner.index_cache import IndexCache
+
+PETITS = {"name": "fixed_tokens", "params": {"size": 40, "overlap": 5}}
+
+
+@pytest.fixture
+def ctx(tmp_path: Path):  # type: ignore[no-untyped-def]
+    provider = FakeProvider()
+    c = RunCtx.from_profile(
+        "test", wl_home=tmp_path / "wl", run_id="r-1", seed=1, providers={"fake": provider}
+    )
+    c.parser = "markdown"
+    c.provider = provider  # type: ignore[attr-defined]
+    with c:
+        yield c
+
+
+def _arch(ctx: RunCtx, **params: Any) -> Any:
+    params.setdefault("embedder", {"name": "fake"})
+    params.setdefault("chunker", PETITS)
+    return ctx.build("architecture", ComponentSpec(name="hyde", params=params))
+
+
+def _question() -> QuestionInput:
+    return QuestionInput(question_id="q-001", text="Que sait-on de la guilde Orvane ?", lang="fr")
+
+
+def _repondre(arch: Any, ctx: RunCtx) -> Any:
+    with ctx.scope(post="query", question_id="q-001"):
+        return arch.answer(_question())
+
+
+def _charger(ctx: RunCtx, corpus: ParsedCorpus, tmp_path: Path, **params: Any) -> Any:
+    arch = _arch(ctx, **params)
+    with ctx.scope(post="indexing"):
+        arch.index(corpus, tmp_path / "i")
+    arch.load(tmp_path / "i")
+    return arch
+
+
+def _spans(ctx: RunCtx) -> list[dict[str, Any]]:
+    chemin = ctx.run_dir / "traces.jsonl"
+    return [json.loads(x) for x in chemin.read_text(encoding="utf-8").splitlines()]
+
+
+def _espionner_retrieve(arch: Any) -> list[Any]:
+    vus: list[Any] = []
+    origine = arch.retriever.retrieve
+
+    def espion(query: Any, k: Any, index: Any, query_vector: Any = None) -> Any:
+        vus.append(query_vector)
+        return origine(query, k, index, query_vector=query_vector)
+
+    arch.retriever.retrieve = espion
+    return vus
+
+
+def _encoder(arch: Any, ctx: RunCtx, textes: list[str]) -> Any:
+    with ctx.scope(post="query"):
+        return arch.embedder.embed_queries(textes)
+
+
+def test_enregistrement_et_params(ctx: RunCtx) -> None:
+    assert registry.get("architecture", "hyde") is Hyde
+    assert Hyde.Params().mix_question is False
+    assert {"k", "mix_question"} <= Hyde.query_params
+    assert Hyde.capabilities.incremental_update is True
+    assert Hyde.capabilities.retrieval_method == "ranked"
+
+
+def test_cle_d_index_et_manifeste(ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path) -> None:
+    assert _arch(ctx, mix_question=True).index_key() == _arch(ctx, k=3).index_key()
+    cache = IndexCache(tmp_path / "home")
+    _, cle = cache.build(ctx, lambda: _arch(ctx), minicorpus)
+    dossier = cache.path(cle)
+    assert (dossier / "passages.jsonl").exists() and (dossier / "vectors").is_dir()
+    manifeste = json.loads((dossier / "manifest.json").read_text(encoding="utf-8"))
+    assert manifeste["embedder_dim"] == 64
+
+
+def test_defaut_vecteur_de_la_reponse_hypothetique_et_spans(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    arch = _charger(ctx, minicorpus, tmp_path)
+    vus = _espionner_retrieve(arch)
+    hypo = " ".join(_question().text.split()[:30])  # sortie par défaut du Faux LLM
+    attendu = _encoder(arch, ctx, [hypo])[0]
+    _repondre(arch, ctx)
+    assert np.allclose(vus[0], attendu)
+    appels = [s for s in _spans(ctx) if s.get("wl.kind") == "llm" and s.get("wl.post") == "query"]
+    etapes = [s["wl.step"] for s in appels]
+    assert etapes.index("hyde") < etapes.index("generate")
+    assert etapes.count("hyde") == 1
+
+
+def test_melange_moyenne_renormalisee_en_un_seul_appel(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    arch = _charger(ctx, minicorpus, tmp_path, mix_question=True)
+    vus = _espionner_retrieve(arch)
+    appels: list[list[str]] = []
+    origine = arch.embedder.embed_queries
+
+    def espion(textes: Any) -> Any:
+        appels.append(list(textes))
+        return origine(textes)
+
+    arch.embedder.embed_queries = espion
+    _repondre(arch, ctx)
+    hypo = " ".join(_question().text.split()[:30])
+    assert appels == [[hypo, _question().text]]
+    with ctx.scope(post="query"):
+        v_h, v_q = origine([hypo, _question().text])
+    somme = v_h + v_q
+    assert np.allclose(vus[0], somme / np.linalg.norm(somme))
+    assert np.isclose(np.linalg.norm(vus[0]), 1.0)
+
+
+def test_melange_norme_nulle_repli_sur_vecteur_hypothetique(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    arch = _charger(ctx, minicorpus, tmp_path, mix_question=True)
+    v = np.ones(64, np.float32) / 8
+    arch.embedder.embed_queries = lambda textes: np.stack([v, -v])
+    resultat = arch._vecteur_de_recherche("hypo", "question")
+    assert np.allclose(resultat, v)
+
+
+def test_reponse_vide_repli_sur_la_question(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    ctx.provider.script("hyde", "hyde", "   ")  # type: ignore[attr-defined]
+    arch = _charger(ctx, minicorpus, tmp_path)
+    vus = _espionner_retrieve(arch)
+    _repondre(arch, ctx)
+    assert np.allclose(vus[0], _encoder(arch, ctx, [_question().text])[0])
+
+
+def test_passage_scenarise_au_rang_1_et_hypothese_absente_du_contexte(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    arch = _charger(ctx, minicorpus, tmp_path)
+    passage = sorted(arch._index.passages.values(), key=lambda p: p.passage_id)[3]
+    ctx.provider.script("hyde", "hyde", passage.text)  # type: ignore[attr-defined]
+    rep = _repondre(arch, ctx)
+    assert rep.retrieved[0].rank == 1
+    assert rep.retrieved[0].passage.passage_id == passage.passage_id
+
+
+def test_hypothese_hors_contexte_et_citations(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    hypo = "Texte hypothétique inventé zzz qui n'est dans aucun Passage."
+    ctx.provider.script("hyde", "hyde", hypo)  # type: ignore[attr-defined]
+    ctx.provider.script(  # type: ignore[attr-defined]
+        "generate", "generate*", '{"answer": "R.", "citations": ["S1"], "abstain": false}'
+    )
+    arch = _charger(ctx, minicorpus, tmp_path)
+    rep = _repondre(arch, ctx)
+    assert all(hypo not in t for t in rep.context_texts)
+    ancrages = {a for s in rep.retrieved for a in s.passage.anchor_ids}
+    assert set(rep.context_anchor_ids) == ancrages
+    assert rep.citations
+    assert all(c.anchor_id in ancrages for c in rep.citations)
+
+
+def test_sans_load_aucun_appel_llm(ctx: RunCtx) -> None:
+    arch = _arch(ctx)
+    with pytest.raises(RuntimeError, match="load"):
+        _repondre(arch, ctx)
+    assert not (ctx.run_dir / "traces.jsonl").exists()
+
+
+def test_update_incremental_puis_load(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    docs = list(minicorpus.documents)
+    supprime = docs[0]
+    arch = _arch(ctx)
+    with ctx.scope(post="indexing"):
+        arch.index(minicorpus, tmp_path / "v1")
+    anciens = {p.passage_id for p in arch.chunker.chunk(supprime)}
+    apres = minicorpus.model_copy(update={"documents": tuple(docs[1:])})
+    with ctx.scope(post="update"):
+        _arch(ctx).update(
+            CorpusChange(removed=(supprime.doc_id,)), apres, tmp_path / "v1", tmp_path / "v2"
+        )
+    neuve = _arch(ctx)
+    neuve.load(tmp_path / "v2")
+    rep = _repondre(neuve, ctx)
+    assert anciens
+    assert not anciens & {s.passage.passage_id for s in rep.retrieved}
