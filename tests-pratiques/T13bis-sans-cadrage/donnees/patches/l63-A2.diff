+"""Architecture `hyde` : recherche dense avec l'embedding d'une réponse hypothétique."""
+
+from typing import Any, ClassVar
+
+import numpy as np
+from pydantic import ConfigDict
+
+from wavelibrarian.architectures.naive_rag import NaiveRag
+from wavelibrarian.components.context import build_arch_answer
+from wavelibrarian.core.types import ArchAnswer, QuestionInput
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.registry import register
+
+_MAX_TOKENS_HYDE = 256
+_SYSTEM_HYDE = "Rédige un court passage qui répond à la question, dans sa langue, sans préambule."
+
+
+@register("architecture", "hyde")
+class Hyde(NaiveRag):
+    """`naive_rag` dont la recherche utilise le vecteur d'une réponse hypothétique (HyDE)."""
+
+    name = "hyde"
+    query_params: ClassVar[frozenset[str]] = frozenset({"k", "mix_question"})
+
+    class Params(NaiveRag.Params):
+        model_config = ConfigDict(extra="forbid", frozen=True)
+
+        mix_question: bool = False
+
+    def _reponse_hypothetique(self, question: QuestionInput) -> str:
+        """Un appel au rôle `hyde` ; le span est émis par la passerelle."""
+        requete = LLMRequest(
+            model_id=self.generator.model_id,
+            role="hyde",
+            step="hyde",
+            system=_SYSTEM_HYDE,
+            messages=(Message(role="user", content=question.text),),
+            max_tokens=_MAX_TOKENS_HYDE,
+            temperature=0.0,
+            seed=self.ctx.seed,  # type: ignore[attr-defined]
+            inputs={"text": question.text},
+        )
+        return self.ctx.gateway.complete(requete).text  # type: ignore[attr-defined]
+
+    def _vecteur_de_recherche(self, hypo: str, question: str) -> Any:
+        """Vecteur de la réponse hypothétique (repli sur la Question si vide), mélangé ou non."""
+        texte = hypo if hypo.strip() else question
+        if not self.params.mix_question:  # type: ignore[attr-defined]
+            return self.embedder.embed_queries([texte])[0]
+        v_h, v_q = self.embedder.embed_queries([texte, question])
+        somme = v_h + v_q
+        norme = float(np.linalg.norm(somme))
+        return v_h if norme == 0.0 else (somme / norme).astype(np.float32)
+
+    def answer(self, question: QuestionInput) -> ArchAnswer:
+        if self._index is None:
+            raise RuntimeError("`load` doit précéder `answer`")
+        hypo = self._reponse_hypothetique(question)
+        vecteur = self._vecteur_de_recherche(hypo, question.text)
+        classes = self.retriever.retrieve(  # type: ignore[attr-defined]
+            question.text,
+            self.params.k,
+            self._index,
+            query_vector=vecteur,  # type: ignore[attr-defined]
+        )
+        contexte = self.context_builder.build([s.passage for s in classes])
+        resultat = self.generator.generate(question, contexte)
+        return build_arch_answer(
+            contexte,
+            resultat,
+            classes,
+            "ranked",
+            tokenizer=self.ctx.tokenizer_for(self.generator.model_id),
+        )
diff --git a/tests/unit/architectures/test_story_6_3.py b/tests/unit/architectures/test_story_6_3.py
