+"""Tests des fonctions de texte partagées (valeurs calculées à la main)."""
+
+from decimal import Decimal
+
+import pytest
+
+from slmsp.core.texte import (
+    VERSION_TEXTE,
+    compter_mots,
+    decouper_phrases,
+    extraire_nombres,
+    kandel_moles,
+    ngrammes,
+    normaliser,
+    syllabes,
+)
+
+
+@pytest.mark.parametrize(
+    ("entree", "attendu"),
+    [
+        ("Bonjour,  l’USAGER !", "bonjour l usager"),
+        ("ﬁchier", "fichier"),
+        ("  Prix : 12 € (TTC).  ", "prix 12 € ttc"),
+    ],
+)
+def test_normaliser(entree, attendu):
+    assert normaliser(entree) == attendu
+
+
+@pytest.mark.parametrize(
+    "texte",
+    ["Bonjour,  l’USAGER !", "ﬁchier", "À l'État — « oui » ; non…", "1 234,56 €", "\n\t"],
+)
+def test_normaliser_idempotent(texte):
+    une_fois = normaliser(texte)
+    assert normaliser(une_fois) == une_fois
+
+
+@pytest.mark.parametrize("sep", [" ", " ", " "])
+def test_milliers_et_decimales(sep):
+    assert extraire_nombres(f"1{sep}234,56 €") == [Decimal("1234.56")]
+
+
+@pytest.mark.parametrize(
+    ("texte", "attendu"),
+    [
+        ("12,50 € puis 25 € et 3,5 %", [Decimal("12.50"), Decimal("25"), Decimal("3.5")]),
+        ("2020-2021", [Decimal("2020"), Decimal("2021")]),
+        ("solde -3,5", [Decimal("-3.5")]),
+        ("-4 puis (−2)", [Decimal("-4"), Decimal("-2")]),
+        ("pi 3.14", [Decimal("3.14")]),
+        ("aucun nombre", []),
+    ],
+)
+def test_extraire_nombres(texte, attendu):
+    assert extraire_nombres(texte) == attendu
+
+
+@pytest.mark.parametrize(
+    ("mot", "attendu"),
+    [
+        ("administrative", 5),
+        ("demande", 2),
+        ("aide", 1),
+        ("année", 2),
+        ("le", 1),
+        ("l'usager", 3),
+        ("demandes", 2),
+    ],
+)
+def test_syllabes(mot, attendu):
+    assert syllabes(mot) == attendu
+
+
+def test_compter_mots():
+    assert compter_mots("Le demandeur doit fournir une attestation.") == 6
+    assert compter_mots("l'usager peut-être 12 fois") == 3
+    assert compter_mots("") == 0
+    assert compter_mots("123 !") == 0
+
+
+@pytest.mark.parametrize("texte", ["", "123 !"])
+def test_kandel_moles_sans_mot(texte):
+    with pytest.raises(ValueError, match="aucun mot"):
+        kandel_moles(texte)
+
+
+@pytest.mark.parametrize(
+    ("texte", "attendu"),
+    [
+        ("Une phrase. Une autre !", ["Une phrase.", "Une autre !"]),
+        ("Vraiment ? Oui… Peut-être", ["Vraiment ?", "Oui…", "Peut-être"]),
+        ("Ligne un\nLigne deux", ["Ligne un", "Ligne deux"]),
+        ("Un mot. 123. !!! Fin", ["Un mot.", "Fin"]),
+    ],
+)
+def test_decouper_phrases(texte, attendu):
+    assert decouper_phrases(texte) == attendu
+
+
+def test_ngrammes():
+    assert ngrammes("Bonjour Madame", 3) == {"bonjour madame"}
+    assert ngrammes("a b c d", 3) == {"a b c", "b c d"}
+    assert ngrammes("") == set()
+    with pytest.raises(ValueError, match="au moins 1"):
+        ngrammes("a b", 0)
+
+
+def test_kandel_moles_simplifie_superieur_a_administratif():
+    administratif = (
+        "Le demandeur doit fournir une attestation justifiant de sa situation "
+        "préalablement à l'instruction administrative du dossier."
+    )
+    simplifie = "Vous devez donner un papier. Il prouve votre situation. Nous voyons ensuite."
+    assert kandel_moles(simplifie) > kandel_moles(administratif)
+
+
+def test_non_regression_kandel_moles():
+    # Références : (mots, syllabes, phrases) -> 207 - 1,015 x mots/phrases - 73,6 x syllabes/mots
+    references = {
+        # 6 mots, 12 syllabes, 1 phrase : 207 - 6,09 - 147,2
+        "Le demandeur doit fournir une attestation.": 53.71,
+        # 4 mots, 6 syllabes, 1 phrase : 207 - 4,06 - 110,4
+        "Je dépose ma demande.": 92.54,
+        # 3 mots, 12 syllabes (5 + 3 + 4), 1 phrase : 207 - 3,045 - 294,4
+        "L'administration vérifie l'attestation.": -90.445,
+    }
+    assert VERSION_TEXTE == 1
+    for texte, attendu in references.items():
+        assert kandel_moles(texte) == pytest.approx(attendu, abs=0.1), texte
