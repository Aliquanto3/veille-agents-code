+"""Fonctions de texte partagées (AD-29).
+
+Source unique pour le banc, l'anti-fuite et la construction du jeu.
+
+Règles (v1) :
+- `normaliser` : NFKC, minuscules, ponctuation (catégorie Unicode `P*`) remplacée par une espace,
+  blancs réduits ; accents, chiffres et symboles `S*` conservés ; idempotente.
+- Mot : suite de lettres, jointe par une apostrophe ou un trait d'union internes ;
+  un nombre n'est pas un mot.
+- Phrases : coupure après `[.!?…]+` suivi d'un blanc ou de la fin, et à chaque saut de ligne.
+- Syllabes : groupes vocaliques maximaux, avec règle du e muet final (`-e`, `-es`), minimum 1.
+- Kandel-Moles : 207 - 1,015 x mots/phrase - 73,6 x syllabes/mot (non arrondi).
+- Nombres : format français (milliers par espace, virgule décimale), `Decimal`, unités ignorées.
+
+Toute modification d'une règle DOIT incrémenter `VERSION_TEXTE`
+et mettre à jour les références des tests.
+Ce module n'utilise que la bibliothèque standard et n'importe aucun paquet `slmsp`.
+"""
+
+import re
+import unicodedata
+from decimal import Decimal
+
+VERSION_TEXTE = 1
+
+_VOYELLES = "aeiouyàâäéèêëîïôöùûüÿæœ"
+
+_RE_MOT = re.compile(r"[^\W\d_]+(?:['’\-][^\W\d_]+)*")
+_RE_BLANCS = re.compile(r"\s+")
+_RE_FIN_PHRASE = re.compile(r"(?<=[.!?…])(?=\s|$)")
+_RE_GROUPE_VOCALIQUE = re.compile(f"[{_VOYELLES}]+")
+_RE_SEPARATEUR_MILLIERS = re.compile("[   ]")
+_RE_NOMBRE = re.compile(
+    r"(?:(?<![^\s(])(?P<signe>[-−]))?"
+    r"(?P<entier>\d{1,3}(?:[   ]\d{3}(?!\d))+|\d+)"
+    r"(?:[.,](?P<decimales>\d+))?"
+)
+
+
+def normaliser(texte: str) -> str:
+    """Normalise un texte : NFKC, minuscules, sans ponctuation, espaces uniques."""
+    texte = unicodedata.normalize("NFKC", texte).lower()
+    texte = "".join(" " if unicodedata.category(c).startswith("P") else c for c in texte)
+    return _RE_BLANCS.sub(" ", texte).strip()
+
+
+def _mots(texte: str) -> list[str]:
+    """Liste les mots (lettres, apostrophes et traits d'union internes) d'un texte."""
+    return _RE_MOT.findall(unicodedata.normalize("NFKC", texte))
+
+
+def compter_mots(texte: str) -> int:
+    """Compte les mots d'un texte ; les nombres ne sont pas des mots."""
+    return len(_mots(texte))
+
+
+def decouper_phrases(texte: str) -> list[str]:
+    """Découpe un texte en phrases, en écartant les segments sans mot."""
+    phrases: list[str] = []
+    for ligne in texte.splitlines():
+        for segment in _RE_FIN_PHRASE.split(ligne):
+            segment = segment.strip()
+            if _RE_MOT.search(segment):
+                phrases.append(segment)
+    return phrases
+
+
+def syllabes(mot: str) -> int:
+    """Compte les syllabes d'un mot français (groupes vocaliques, e muet final)."""
+    mot = mot.lower()
+    groupes = _RE_GROUPE_VOCALIQUE.findall(mot)
+    nombre = len(groupes)
+    if nombre >= 2 and mot.endswith(("e", "es")) and groupes[-1] == "e":
+        nombre -= 1
+    return max(nombre, 1)
+
+
+def kandel_moles(texte: str) -> float:
+    """Calcule l'indice de lisibilité de Kandel-Moles (haut = lisible)."""
+    mots = _mots(texte)
+    if not mots:
+        raise ValueError("Calcul de Kandel-Moles impossible : le texte ne contient aucun mot.")
+    phrases = max(len(decouper_phrases(texte)), 1)
+    total_syllabes = sum(syllabes(m) for m in mots)
+    return 207 - 1.015 * (len(mots) / phrases) - 73.6 * (total_syllabes / len(mots))
+
+
+def extraire_nombres(texte: str) -> list[Decimal]:
+    """Extrait les nombres écrits à la française, dans l'ordre d'apparition."""
+    nombres: list[Decimal] = []
+    for m in _RE_NOMBRE.finditer(texte):
+        entier = _RE_SEPARATEUR_MILLIERS.sub("", m["entier"])
+        valeur = Decimal(f"{entier}.{m['decimales']}" if m["decimales"] else entier)
+        nombres.append(-valeur if m["signe"] else valeur)
+    return nombres
+
+
+def ngrammes(texte: str, n: int = 3) -> set[str]:
+    """Renvoie les n-grammes de mots du texte normalisé, joints par une espace."""
+    if n < 1:
+        raise ValueError(f"n doit valoir au moins 1 (reçu : {n}).")
+    mots = normaliser(texte).split()
+    if not mots:
+        return set()
+    if len(mots) < n:
+        return {" ".join(mots)}
+    return {" ".join(mots[i : i + n]) for i in range(len(mots) - n + 1)}
