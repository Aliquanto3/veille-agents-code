+def test_judge_input_reprend_context_texts_tels_quels():
+    question = Question(
+        id="q-001",
+        type="factual",
+        text="Quand ?",
+        lang="fr",
+        reference_answer="1412",
+        answer_form="short",
+        status="validated",
+        origin={"kind": "human", "name": "anael"},
+    )
+    reponse = ArchAnswer(text="En 1412.", abstained=False, context_texts=("[S1] a", "[S2] b"))
+    item = judge_input(question, reponse, ["texte de référence"])
+    assert item.context_texts == reponse.context_texts
+    assert item.reference_texts == ("texte de référence",)
+    assert (item.question, item.reference_answer, item.answer_text) == (
+        "Quand ?",
+        "1412",
+        "En 1412.",
+    )
