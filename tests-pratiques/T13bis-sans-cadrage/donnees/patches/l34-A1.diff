+_NOMBRE = re.compile(r"^[-+]?\d[\d\s.,'  ]*\s?(%|[^\W\d_]{1,4}\.?)?$")
 _DATE_NUMERIQUE = re.compile(r"^\d{1,4}[-/.]\d{1,2}[-/.]\d{1,4}([ T]\d{1,2}:\d{2}(:\d{2})?Z?)?$")
+_ENTRE_CHIFFRES = re.compile(r"(?<=\d)[   '’](?=\d)")
+_VIRGULE_DECIMALE = re.compile(r"(?<=\d),(?=\d)")
+_PONCTUATION = re.compile(r"(?!(?<=\d)\.(?=\d))[^\w\s]|_")
+
+
+def _canon_nombre(jeton: str) -> str:
+    try:
+        n = Decimal(jeton)
+    except InvalidOperation:
+        return jeton
+    if not n.is_finite():
+        return jeton
+    return format(n.normalize(), "f")  # `normalize` retire les zéros finaux, `f` l'exposant
+
+
+def normalize_answer(texte: str) -> list[str]:
+    """Jetons normalisés : sans casse, accents ni ponctuation, nombres sous forme canonique."""
+    t = unicodedata.normalize("NFKD", texte)
+    t = "".join(c for c in t if not unicodedata.combining(c)).casefold()
+    t = _ENTRE_CHIFFRES.sub("", t)
+    t = _VIRGULE_DECIMALE.sub(".", t)
+    t = _PONCTUATION.sub(" ", t)
+    return [_canon_nombre(j) if j[0].isdigit() else j for j in t.split()]
+
+
+def exact_match(reference: str, answer: str) -> bool:
+    """Vrai si les jetons normalisés de `reference` (non vide) sont contigus dans `answer`."""
+    ref = normalize_answer(reference)
+    if not ref:
+        return False
+    rep = normalize_answer(answer)
+    n = len(ref)
+    return any(rep[i : i + n] == ref for i in range(len(rep) - n + 1))
+
+
+def judge_input(
+    question: Question, answer: ArchAnswer, reference_texts: Sequence[str]
+) -> JudgeInput:
+    """`JudgeInput` d'une Réponse ; `context_texts` repris tel que fourni au Generator (AD-6)."""
+    return JudgeInput(
+        question=question.text,
+        reference_answer=question.reference_answer,
+        reference_texts=tuple(reference_texts),
+        answer_text=answer.text,
+        context_texts=answer.context_texts,
+    )
 
 
