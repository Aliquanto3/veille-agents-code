+"""Story 3.4 : Juge LLM (un appel par `judge()`, `pass_id` dans le Cache), Faux LLM seul."""
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from wavelibrarian import registry
+from wavelibrarian.components.judges.llm import LLMJudge
+from wavelibrarian.core.errors import NonConformantOutput
+from wavelibrarian.llm.providers.fake import FakeProvider
+from wavelibrarian.ports.components import ComponentSpec, JudgeInput
+from wavelibrarian.ports.gateway import LLMRequest, LLMResult
+from wavelibrarian.runner.context import Context
+
+CRITERES: list[Any] = ["correctness", "completeness", "faithfulness"]
+
+
+def _verdicts(req: LLMRequest, verdict: str = "yes", justification: str = "ok") -> str:
+    v = {"verdict": verdict, "justification": justification}
+    return json.dumps({"verdicts": {c: v for c in req.inputs["criteria"]}})
+
+
+@pytest.fixture
+def provider() -> FakeProvider:
+    return FakeProvider()
+
+
+@pytest.fixture
+def ctx(wl_home: Path, provider: FakeProvider):
+    with Context.from_profile(
+        "test", wl_home=wl_home, run_id="juge-1", providers={"fake": provider}
+    ) as c:
+        yield c
+
+
+@pytest.fixture
+def item() -> JudgeInput:
+    return JudgeInput(
+        question="Quand la guilde fut-elle fondée ?",
+        reference_answer="1412",
+        reference_texts=("La guilde fut fondée en 1412.",),
+        answer_text="En 1412.",
+        context_texts=("[S1] La guilde fut fondée en 1412.",),
+    )
+
+
+def _juge(ctx: Context) -> LLMJudge:
+    return ctx.build("judge", ComponentSpec(name="llm"))
+
+
+def test_enregistrement_et_modele_par_defaut(ctx: Context) -> None:
+    registry.discover()
+    assert registry.get("judge", "llm") is LLMJudge
+    assert _juge(ctx).model_id == ctx.profile.defaults.judge_pool[0]
+    explicite = ctx.build("judge", ComponentSpec(name="llm", params={"model": "fake-llm-a"}))
+    assert explicite.model_id == "fake-llm-a"
+
+
+def test_un_seul_appel_pour_trois_criteres(
+    ctx: Context, provider: FakeProvider, item: JudgeInput
+) -> None:
+    requetes: list[LLMRequest] = []
+
+    def sortie(req: LLMRequest) -> str:
+        requetes.append(req)
+        return _verdicts(req, justification="  ok \n  bien ")
+
+    provider.script("judge", "judge", sortie)
+    with ctx.scope(post="judging"):
+        res = _juge(ctx).judge(item, CRITERES, pass_id=0)
+    assert len(requetes) == 1 and requetes[0].role == "judge"
+    assert requetes[0].pass_id == 0
+    assert res == {c: (True, "ok bien") for c in CRITERES}
+
+
+def test_pass_id_dans_la_cle_du_cache(
+    ctx: Context, item: JudgeInput, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    resultats: list[LLMResult] = []
+    interne = ctx.gateway.complete_structured
+
+    def espion(req: LLMRequest, schema: Any):
+        sortie, res = interne(req, schema)
+        resultats.append(res)
+        return sortie, res
+
+    monkeypatch.setattr(ctx.gateway, "complete_structured", espion)
+    juge = _juge(ctx)
+    with ctx.scope(post="judging"):
+        for pass_id in (0, 1, 0):
+            juge.judge(item, CRITERES, pass_id=pass_id)
+    assert [r.from_cache for r in resultats] == [False, False, True]
+
+
+def test_sortie_non_conforme(ctx: Context, provider: FakeProvider, item: JudgeInput) -> None:
+    provider.script("judge", "judge", "pas du json")
+    with ctx.scope(post="judging"), pytest.raises(NonConformantOutput):
+        _juge(ctx).judge(item, CRITERES, pass_id=0)
+
+
+def test_critere_manquant_ou_en_trop(
+    ctx: Context, provider: FakeProvider, item: JudgeInput
+) -> None:
+    v = {"verdict": "no", "justification": "x"}
+    provider.script("judge", "judge", json.dumps({"verdicts": {"correctness": v, "autre": v}}))
+    with ctx.scope(post="judging"), pytest.raises(NonConformantOutput, match="completeness"):
+        _juge(ctx).judge(item, ["correctness", "completeness"], pass_id=0)
+
+
+def test_contexte_seulement_pour_faithfulness(
+    ctx: Context, provider: FakeProvider, item: JudgeInput
+) -> None:
+    messages: list[str] = []
+
+    def sortie(req: LLMRequest) -> str:
+        messages.append(req.messages[0].content)
+        return _verdicts(req)
+
+    provider.script("judge", "judge", sortie)
+    with ctx.scope(post="judging"):
+        _juge(ctx).judge(item, ["correctness"], pass_id=0)
+        _juge(ctx).judge(item, ["faithfulness"], pass_id=0)
+    assert "[S1]" not in messages[0] and "[S1]" in messages[1]
