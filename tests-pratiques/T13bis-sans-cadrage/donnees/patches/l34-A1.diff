+"""Juge LLM : note plusieurs Critères en un seul appel au rôle `judge`."""
+
+import json
+from collections.abc import Sequence
+from typing import Annotated, Any
+
+from pydantic import BaseModel, ConfigDict
+
+from wavelibrarian.core.errors import NonConformantOutput
+from wavelibrarian.core.types import Criterion, ModelRefMeta
+from wavelibrarian.llm.roles import JudgeOutput
+from wavelibrarian.ports.components import JudgeInput
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.registry import register
+
+_MAX_JUSTIFICATION = 200
+
+_DEFINITIONS: dict[str, str] = {
+    "correctness": "la Réponse est exacte au regard de la réponse de référence",
+    "completeness": "la Réponse couvre tous les éléments de la réponse de référence",
+    "faithfulness": "chaque affirmation de la Réponse est appuyée par le contexte fourni",
+    "citation_correctness": "les citations de la Réponse soutiennent ses affirmations",
+    "abstention_correctness": "la Réponse s'abstient si et seulement si la source est absente",
+}
+
+_SYSTEM = (
+    "Tu es un juge strict et impartial. Pour chaque Critère demandé, réponds `yes` ou `no` "
+    "et donne une justification d'une phrase. Définitions des Critères :\n{definitions}\n"
+    'Réponds en JSON : {{"verdicts": {{"<critère>": {{"verdict": "yes"|"no", '
+    '"justification": "..."}}}}}} avec exactement les Critères demandés.'
+)
+
+
+@register("judge", "llm")
+class LLMJudge:
+    """Juge LLM : note tous les Critères demandés en un seul appel (verdict et justification)."""
+
+    class Params(BaseModel):
+        model_config = ConfigDict(extra="forbid", frozen=True)
+
+        model: Annotated[str | None, ModelRefMeta("judge_pool[0]")] = None
+
+    def __init__(self, params: "LLMJudge.Params", ctx: Any) -> None:
+        self._ctx = ctx
+        self.model_id: str = params.model or ctx.profile.defaults.judge_pool[0]
+
+    def judge(
+        self, item: JudgeInput, criteria: Sequence[Criterion], pass_id: int
+    ) -> dict[Criterion, tuple[bool, str]]:
+        ctx = self._ctx
+        criteres = list(criteria)
+        definitions = "\n".join(f"- {c} : {_DEFINITIONS.get(c, c)}" for c in criteres)
+        blocs = [
+            f"Question : {item.question}",
+            f"Réponse de référence : {item.reference_answer}",
+            "Textes de référence :\n" + "\n".join(item.reference_texts),
+            f"Réponse à juger : {item.answer_text}",
+        ]
+        if "faithfulness" in criteres:
+            blocs.append("Contexte fourni au générateur :\n" + "\n".join(item.context_texts))
+        blocs.append(f"Critères : {json.dumps(criteres)}")
+        requete = LLMRequest(
+            model_id=self.model_id,
+            role="judge",
+            step="judge",
+            system=_SYSTEM.format(definitions=definitions),
+            messages=(Message(role="user", content="\n\n".join(blocs)),),
+            max_tokens=min(
+                120 * len(criteres) + 100,
+                ctx.catalog.get(self.model_id).max_output_tokens or 4096,
+            ),
+            temperature=0,
+            seed=ctx.seed,
+            pass_id=pass_id,
+            inputs={
+                "question": item.question,
+                "reference_answer": item.reference_answer,
+                "answer": item.answer_text,
+                "criteria": criteres,
+                "reference_texts": list(item.reference_texts),
+                "context_texts": list(item.context_texts),
+            },
+        )
+        sortie, _ = ctx.gateway.complete_structured(requete, JudgeOutput)
+        if set(sortie.verdicts) != set(criteres):
+            raise NonConformantOutput(
+                f"Critères du Juge non conformes : demandés {sorted(criteres)}, "
+                f"reçus {sorted(sortie.verdicts)}"
+            )
+        return {
+            c: (
+                sortie.verdicts[c].verdict == "yes",
+                " ".join(sortie.verdicts[c].justification.split())[:_MAX_JUSTIFICATION],
+            )
+            for c in criteres
+        }
