+"""Forme des Réponses de référence (FR-36) : `short` = au plus 5 mots, un nombre ou une date.
+
+Contient aussi la correspondance exacte normalisée et le `JudgeInput` d'une Réponse.
+"""
 
 import re
+import unicodedata
+from collections.abc import Sequence
+from decimal import Decimal, InvalidOperation
+
+from wavelibrarian.core.types import ArchAnswer, Question
+from wavelibrarian.ports.components import JudgeInput
 
