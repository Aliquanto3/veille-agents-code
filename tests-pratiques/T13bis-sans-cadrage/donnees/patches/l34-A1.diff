+
+@pytest.mark.parametrize(
+    ("texte", "attendu"),
+    [
+        ("1 412", True),
+        ("2024-03-01", True),
+        ("Élodie Varn", True),
+        ("une phrase de six mots exactement ici", False),
+    ],
+)
+def test_is_short_form_matrice(texte, attendu):
+    assert is_short_form(texte) is attendu
