+def _open_browser_when_ready(port: int, *, timeout_s: float = 30.0, poll_s: float = 0.1) -> bool:
+    """Attend que `127.0.0.1:<port>` accepte une connexion, puis ouvre le navigateur une fois.
+
+    Bloquante, sans exception. Rend `True` seulement si le navigateur a été ouvert.
+    """
+    url = f"http://127.0.0.1:{port}/"
+    deadline = time.monotonic() + timeout_s
+    while True:
+        try:
+            socket.create_connection(("127.0.0.1", port), timeout=poll_s).close()
+            break
+        except OSError:
+            if time.monotonic() >= deadline:
+                logger.debug("Le port %d ne répond pas : navigateur non ouvert", port)
+                return False
+            time.sleep(poll_s)
+    try:
+        opened = webbrowser.open(url)
+    except (webbrowser.Error, OSError):
+        opened = False
+    if not opened:
+        logger.warning("Navigateur non ouvert : ouvrez %s", url)
+    return bool(opened)
+
