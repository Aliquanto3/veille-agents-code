+"""Outils de consultation de l'Agent : cinq lectures d'un Passage, sans écriture (FR-39, FR-41).
+
+Les outils ne lisent que par le port `Consultation` (AD-11) : l'Agent n'a aucun accès à Jira
+(AD-5). Les valeurs sont recopiées telles quelles, sans calcul métier (AD-9).
+"""
+
+from collections.abc import Callable, Mapping
+from datetime import date
+
+from pydantic import BaseModel, JsonValue, ValidationError
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import OutilAgent
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS: tuple[str, ...] = (
+    "get_meteo",
+    "list_anomalies",
+    "get_tendance",
+    "get_prevision",
+    "get_risques",
+)
+
+
+class OutilsConsultation:
+    """Les cinq outils de lecture seule, servis par une `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _jour(self, demande: date | None) -> date | AucuneDonnee:
+        """Résout la date demandée : la dernière date disponible si elle est absente."""
+        dates = self._consultation.dates_disponibles()
+        if demande is None:
+            return dates[-1] if dates else AucuneDonnee(date_arrete=None)
+        return demande if demande in dates else AucuneDonnee(date_arrete=demande)
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        evolutions = self._consultation.evolution_meteo(jour)
+        if arguments.entite is not None:
+            evolutions = tuple(e for e in evolutions if e.entite == arguments.entite)
+        return ResultatGetMeteo(
+            date_arrete=jour,
+            meteos=self._consultation.meteo(jour, arguments.entite),
+            evolutions=evolutions,
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes, filtrées par Entité, Gravité, Phase, domaine et statut."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        if arguments.statut is None:
+            return self._consultation.anomalies(
+                jour,
+                arguments.entite,
+                arguments.gravite,
+                arguments.phase,
+                arguments.domaine,
+                limite=arguments.limite,
+                palier=2,
+            )
+        toutes = self._consultation.anomalies(
+            jour,
+            arguments.entite,
+            arguments.gravite,
+            arguments.phase,
+            arguments.domaine,
+            limite=None,
+            palier=2,
+        )
+        retenues = tuple(a for a in toutes.anomalies if a.statut == arguments.statut)
+        return ResultatListAnomalies(
+            date_arrete=jour, anomalies=retenues[: arguments.limite], total=len(retenues)
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire, dans l'ordre de la table."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        return ResultatGetTendance(
+            points=tuple(PointTendance(**ligne) for ligne in table.iter_rows(named=True))
+        )
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetPrevision(
+            date_arrete=jour, previsions=self._consultation.previsions(jour, arguments.entite)
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetRisques(
+            date_arrete=jour, risques=self._consultation.risques(jour, arguments.entite)
+        )
+
+
+def _executeur(
+    nom: str, modele: type[BaseModel], outil: Callable[..., BaseModel]
+) -> Callable[[Mapping[str, JsonValue]], str]:
+    """Valide les arguments par `modele`, appelle l'outil et sérialise son résultat en JSON."""
+
+    def executer(arguments: Mapping[str, JsonValue]) -> str:
+        try:
+            valides = modele.model_validate(dict(arguments))
+        except ValidationError as erreur:
+            raise UsineErreur(f"outil « {nom} » : arguments invalides ({erreur})") from erreur
+        return outil(valides).model_dump_json()
+
+    return executer
+
+
+def outils_consultation(consultation: Consultation) -> tuple[OutilAgent, ...]:
+    """Les `OutilAgent` de consultation, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+    definitions: tuple[tuple[str, str, type[BaseModel], Callable[..., BaseModel]], ...] = (
+        (
+            "get_meteo",
+            "Donne la Météo des Entités, les Règles déclenchantes et l'évolution J-1 / J-5"
+            " à une Date d'arrêté.",
+            ArgumentsGetMeteo,
+            outils.get_meteo,
+        ),
+        (
+            "list_anomalies",
+            "Liste les Anomalies ouvertes, filtrables par Entité, Gravité, Phase, domaine"
+            " et statut.",
+            ArgumentsListAnomalies,
+            outils.list_anomalies,
+        ),
+        (
+            "get_tendance",
+            "Donne les Tendances hebdomadaires des KPI, par Entité et par KPI.",
+            ArgumentsGetTendance,
+            outils.get_tendance,
+        ),
+        (
+            "get_prevision",
+            "Donne les Prévisions de sortie du rouge à une Date d'arrêté.",
+            ArgumentsGetPrevision,
+            outils.get_prevision,
+        ),
+        (
+            "get_risques",
+            "Donne les Risques d'entrée en rouge à une Date d'arrêté.",
+            ArgumentsGetRisques,
+            outils.get_risques,
+        ),
+    )
+    return tuple(
+        OutilAgent(nom, description, modele, _executeur(nom, modele, fonction))
+        for nom, description, modele, fonction in definitions
+    )
