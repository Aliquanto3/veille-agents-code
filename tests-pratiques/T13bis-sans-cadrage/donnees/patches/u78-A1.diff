+"""Tests des outils de consultation de l'Agent (Story 7.8) : lecture seule, sans réseau ni LLM."""
+
+import ast
+import hashlib
+import json
+from datetime import date
+from pathlib import Path
+
+import pytest
+
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.consultation.passage import ConsultationPassage
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.tickets import StatutAnomalie
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+
+DATE_ARRETE = date(2026, 10, 9)
+LECTURES_AUTORISEES = {
+    "dates_disponibles",
+    "meteo",
+    "evolution_meteo",
+    "anomalies",
+    "tendances",
+    "previsions",
+    "risques",
+}
+MODELES = {
+    "get_meteo": ArgumentsGetMeteo,
+    "list_anomalies": ArgumentsListAnomalies,
+    "get_tendance": ArgumentsGetTendance,
+    "get_prevision": ArgumentsGetPrevision,
+    "get_risques": ArgumentsGetRisques,
+}
+ARGUMENTS_PAR_OUTIL: dict[str, dict[str, str]] = {
+    "get_meteo": {},
+    "list_anomalies": {"statut": "en_correction"},
+    "get_tendance": {"entite": "ENT-A"},
+    "get_prevision": {},
+    "get_risques": {},
+}
+
+
+@pytest.fixture(scope="module")
+def consultation() -> ConsultationPassage:
+    cas = passage_palier_2().consultation
+    assert isinstance(cas, ConsultationPassage)
+    return cas
+
+
+@pytest.fixture(scope="module")
+def outils(consultation: ConsultationPassage) -> OutilsConsultation:
+    return OutilsConsultation(consultation)
+
+
+def test_date_absente_utilise_la_derniere_date(outils: OutilsConsultation) -> None:
+    resultat = outils.get_meteo(ArgumentsGetMeteo())
+    assert isinstance(resultat, ResultatGetMeteo)
+    assert resultat.date_arrete == DATE_ARRETE
+
+
+def test_date_couverte(outils: OutilsConsultation) -> None:
+    resultat = outils.get_risques(ArgumentsGetRisques(date_arrete=DATE_ARRETE))
+    assert isinstance(resultat, ResultatGetRisques)
+    assert resultat.date_arrete == DATE_ARRETE
+
+
+@pytest.mark.parametrize("jour", [date(2026, 10, 10), date(2026, 10, 12)])
+def test_date_sans_passage_pour_les_outils_dates(outils: OutilsConsultation, jour: date) -> None:
+    attendu = AucuneDonnee(date_arrete=jour)
+    assert attendu.message == "aucune donnée pour cette date"
+    assert outils.get_meteo(ArgumentsGetMeteo(date_arrete=jour)) == attendu
+    assert outils.list_anomalies(ArgumentsListAnomalies(date_arrete=jour)) == attendu
+    assert outils.get_prevision(ArgumentsGetPrevision(date_arrete=jour)) == attendu
+    assert outils.get_risques(ArgumentsGetRisques(date_arrete=jour)) == attendu
+
+
+def test_passage_sans_meteo() -> None:
+    class Vide:
+        def dates_disponibles(self) -> tuple[date, ...]:
+            return ()
+
+    outils = OutilsConsultation(Vide())  # type: ignore[arg-type]
+    assert outils.get_meteo(ArgumentsGetMeteo()) == AucuneDonnee(date_arrete=None)
+
+
+def test_entite_inconnue_rend_un_resultat_vide(outils: OutilsConsultation) -> None:
+    meteo = outils.get_meteo(ArgumentsGetMeteo(date_arrete=DATE_ARRETE, entite="ENT-Z"))
+    assert isinstance(meteo, ResultatGetMeteo)
+    assert meteo.meteos == ()
+    assert meteo.evolutions == ()
+    anomalies = outils.list_anomalies(ArgumentsListAnomalies(entite="ENT-Z"))
+    assert isinstance(anomalies, ResultatListAnomalies)
+    assert anomalies.anomalies == ()
+    assert anomalies.total == 0
+    prevision = outils.get_prevision(ArgumentsGetPrevision(entite="ENT-Z"))
+    assert isinstance(prevision, ResultatGetPrevision)
+    assert prevision.previsions == ()
+
+
+def test_evolution_filtree_par_entite(outils: OutilsConsultation) -> None:
+    resultat = outils.get_meteo(ArgumentsGetMeteo(entite="ENT-A"))
+    assert isinstance(resultat, ResultatGetMeteo)
+    assert {e.entite for e in resultat.evolutions} == {"ENT-A"}
+
+
+def test_filtre_statut(outils: OutilsConsultation, consultation: ConsultationPassage) -> None:
+    toutes = consultation.anomalies(limite=None)
+    attendues = [a for a in toutes.anomalies if a.statut == StatutAnomalie.en_correction]
+    assert 2 < len(attendues) < len(toutes.anomalies)
+    resultat = outils.list_anomalies(
+        ArgumentsListAnomalies(statut=StatutAnomalie.en_correction, limite=2)
+    )
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert resultat.total == len(attendues)
+    assert resultat.anomalies == tuple(attendues[:2])
+
+
+def test_sans_statut_recopie_la_consultation(
+    outils: OutilsConsultation, consultation: ConsultationPassage
+) -> None:
+    resultat = outils.list_anomalies(ArgumentsListAnomalies(limite=3))
+    assert resultat == consultation.anomalies(DATE_ARRETE, limite=3)
+
+
+def test_tendance(outils: OutilsConsultation, consultation: ConsultationPassage) -> None:
+    table = consultation.tendances("ENT-A")
+    resultat = outils.get_tendance(ArgumentsGetTendance(entite="ENT-A"))
+    assert isinstance(resultat, ResultatGetTendance)
+    assert len(resultat.points) == table.height > 0
+    assert [p.code_kpi for p in resultat.points] == table["code_kpi"].to_list()
+    assert outils.get_tendance(ArgumentsGetTendance(entite="ENT-Z")).points == ()
+
+
+def test_inventaire(consultation: ConsultationPassage) -> None:
+    liste = outils_consultation(consultation)
+    assert tuple(o.nom for o in liste) == NOMS_OUTILS
+    for outil in liste:
+        assert outil.arguments is MODELES[outil.nom]
+        assert outil.description
+    ecriture = ("ecrire", "creer", "modifier", "supprimer", "envoyer", "set_", "update", "post")
+    assert not [n for n in NOMS_OUTILS if any(m in n for m in ecriture)]
+
+
+def test_executer_serialise_en_json(consultation: ConsultationPassage) -> None:
+    liste = outils_consultation(consultation)
+    for outil in liste:
+        charge = json.loads(outil.executer(ARGUMENTS_PAR_OUTIL[outil.nom]))
+        assert isinstance(charge, dict)
+    inconnue = liste[0].executer({"date_arrete": "2026-10-10"})
+    assert json.loads(inconnue)["message"] == "aucune donnée pour cette date"
+
+
+def test_arguments_invalides_nomment_l_outil(consultation: ConsultationPassage) -> None:
+    outil = outils_consultation(consultation)[1]
+    with pytest.raises(UsineErreur, match="list_anomalies"):
+        outil.executer({"gravite": "inconnue"})
+
+
+class _Espion:
+    """Mandataire qui journalise chaque attribut lu sur la Consultation."""
+
+    def __init__(self, cible: ConsultationPassage) -> None:
+        self._cible = cible
+        self.appels: list[str] = []
+
+    def __getattr__(self, nom: str) -> object:
+        self.appels.append(nom)
+        return getattr(self._cible, nom)
+
+
+def _empreintes(repertoire: Path) -> dict[str, str]:
+    return {
+        str(f.relative_to(repertoire)): hashlib.sha256(f.read_bytes()).hexdigest()
+        for f in sorted(repertoire.rglob("*"))
+        if f.is_file()
+    }
+
+
+def test_lecture_seule(consultation: ConsultationPassage) -> None:
+    espion = _Espion(consultation)
+    repertoire = consultation._repertoire
+    for outil in outils_consultation(espion):  # type: ignore[arg-type]
+        avant = _empreintes(repertoire)
+        outil.executer(ARGUMENTS_PAR_OUTIL[outil.nom])
+        assert _empreintes(repertoire) == avant
+    assert espion.appels
+    assert set(espion.appels) <= LECTURES_AUTORISEES
+
+
+def test_aucun_import_interdit() -> None:
+    racine = Path(__file__).resolve().parents[4] / "src" / "usine" / "ia" / "agent"
+    interdits = (
+        "usine.adaptateurs",
+        "usine.config",
+        "usine.generateur",
+        "usine.composition",
+        "httpx",
+        "smtplib",
+        "email",
+    )
+    for fichier in (racine / "outils.py", racine / "__init__.py"):
+        for noeud in ast.walk(ast.parse(fichier.read_text(encoding="utf-8"))):
+            if isinstance(noeud, ast.Import):
+                noms = [a.name for a in noeud.names]
+            elif isinstance(noeud, ast.ImportFrom):
+                noms = [noeud.module or ""]
+            else:
+                continue
+            for nom in noms:
+                assert not any(nom == i or nom.startswith(i + ".") for i in interdits), (
+                    fichier.name,
+                    nom,
+                )
