+def _port_answers(port: int) -> bool:
+    try:
+        with socket.create_connection((LOOPBACK, port), timeout=0.5):
+            return True
+    except OSError:
+        return False
+
+
+def _open_browser_when_ready(
+    port: int, *, timeout_s: float = 30.0, interval_s: float = 0.1
+) -> bool:
+    """Ouvre le navigateur par défaut sur l'application, une seule fois, quand le port répond.
+
+    Jamais avant : on attend au plus `timeout_s`. Si l'ouverture échoue (pas de navigateur, session
+    sans affichage) ou si le port ne répond pas, l'URL est écrite dans la console et le journal ;
+    le serveur continue. Rend `True` si le navigateur a été ouvert.
+    """
+    url = f"http://{LOOPBACK}:{port}/"
+    deadline = time.monotonic() + timeout_s
+    while not _port_answers(port):
+        if time.monotonic() >= deadline:
+            print(f"wavelocalai-v2 : ouvrez {url} dans votre navigateur.", file=sys.stderr)
+            logger.warning("Le port %d ne répond pas : navigateur non ouvert (%s)", port, url)
+            return False
+        time.sleep(interval_s)
+    try:
+        opened = webbrowser.open(url)
+    except Exception:  # noqa: BLE001 - tout échec d'ouverture est non bloquant
+        opened = False
+    if not opened:
+        print(f"wavelocalai-v2 : ouvrez {url} dans votre navigateur.", file=sys.stderr)
+        logger.warning("Navigateur non ouvert : l'application est sur %s", url)
+    return bool(opened)
+
+
