+"""Étapes `kpi` et `prevision` de la Chaîne (Story 5.1)."""
+
+import json
+from datetime import UTC, date, datetime, timedelta
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.doublures.source_en_memoire import SourceEnMemoire
+from tests.unit.chaine.environnement import DATE_ARRETE, preparer_racine
+from tests.unit.chaine.test_execution import _executer
+from tests.unit.domaine.constructeur import Flux
+from usine.chaine.etapes import EtapeInstantanes, EtapeKpi, EtapePrevision
+from usine.composition import Rapport, construire_rapport
+from usine.consultation.passage import ConsultationPassage
