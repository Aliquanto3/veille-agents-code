+class EtapeKpi:
+    """KPI quotidiens et Tendances hebdomadaires, lus depuis `tickets_etats` du Passage."""
+
+    def __init__(self, entites: Sequence[str], premier_jour: date) -> None:
+        self._entites = tuple(entites)
+        self._premier_jour = premier_jour
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sorties `kpi` (jours de l'état des tickets) et `tendances` (ancrées au premier jour)."""
+        jours = jours_du_passage(self._premier_jour, ctx.date_arrete)
+        etats = pl.concat([ctx.consultation.tickets_etats(jour) for jour in jours], how="vertical")
+        table_kpi = kpi(etats, self._entites)
+        return ResultatEtape(
+            StatutEtape.reussie,
+            {
+                "kpi": table_kpi,
+                "tendances": tendances(table_kpi, ctx.date_arrete, self._premier_jour),
+            },
+        )
+
+
+CalculPrevisions = Callable[[Consultation, date], ContenuPrevisions]
+"""Calcul des Prévisions et Risques d'un Jour ouvré, à partir de la `Consultation` du Passage."""
+
+
+def aucune_prevision(consultation: Consultation, jour: date) -> ContenuPrevisions:
+    """Calcul par défaut : aucune Prévision ni Risque (le domaine relève de l'Epic 4)."""
+    return ContenuPrevisions(previsions=(), risques=())
+
+
+def _maintenant() -> datetime:
+    return datetime.now(UTC)
+
+
+class EtapePrevision:
+    """Prévisions et Risques de chaque Jour ouvré, avec une trace par Prévision (AD-16)."""
+
+    def __init__(
+        self,
+        premier_jour: date,
+        version_grille: str,
+        version_donnees: str,
+        calcul: CalculPrevisions = aucune_prevision,
+        horloge: Callable[[], datetime] = _maintenant,
+    ) -> None:
+        self._premier_jour = premier_jour
+        self._version_grille = version_grille
+        self._version_donnees = version_donnees
+        self._calcul = calcul
+        self._horloge = horloge
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sortie `previsions` et traces ; refuse une Prévision ou un Risque mal daté."""
+        previsions: list[Prevision] = []
+        risques: list[RisqueEntreeRouge] = []
+        for jour in jours_du_passage(self._premier_jour, ctx.date_arrete):
+            contenu = self._calcul(ctx.consultation, jour)
+            elements: tuple[Prevision | RisqueEntreeRouge, ...] = (
+                *contenu.previsions,
+                *contenu.risques,
+            )
+            for element in elements:
+                if element.date_arrete != jour:
+                    raise UsineErreur(
+                        f"{type(element).__name__} de l'Entité {element.entite} datée du"
+                        f" {element.date_arrete.isoformat()} pour le jour {jour.isoformat()}"
+                    )
+            previsions.extend(contenu.previsions)
+            risques.extend(contenu.risques)
+        contenu_final = ContenuPrevisions(previsions=tuple(previsions), risques=tuple(risques))
+        traces = tuple(self._trace(ctx, p) for p in previsions)
+        return ResultatEtape(StatutEtape.reussie, {"previsions": contenu_final}, traces)
+
+    def _trace(self, ctx: ContextePassage[Consultation], p: Prevision) -> EntreeTrace:
+        facteurs = [f.model_dump(mode="json") for f in p.facteurs]
+        return EntreeTrace(
+            type_trace=TypeTrace.prevision,
+            horodatage=self._horloge(),
+            passage_id=ctx.passage_id,
+            date_arrete=p.date_arrete,
+            entite=p.entite,
+            version_grille=self._version_grille,
+            version_donnees=self._version_donnees,
+            entree_pseudonymisee=json.dumps(facteurs, sort_keys=True, ensure_ascii=False),
+            sortie=p.model_dump_json(),
+        )
+
+
 class EtapeBouchon:
