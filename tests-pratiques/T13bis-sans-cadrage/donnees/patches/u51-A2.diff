+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur
+from usine.contrats.passage import FICHIERS_PASSAGE, Etape, lire_enveloppe
+from usine.contrats.prevision import (
+    ContenuPrevisions,
+    FacteurExplicatif,
+    MethodePrevision,
+    Prevision,
+    RisqueEntreeRouge,
+    StatutPrevision,
+)
+from usine.contrats.trace import EntreeTrace, TypeTrace
+from usine.ports.consultation import Consultation
+
+PREMIER_JOUR = date(2026, 8, 17)
+
+
+@pytest.fixture
+def rapport(tmp_path: Path) -> Rapport:
+    return construire_rapport(preparer_racine(tmp_path))
+
+
+def _prevision(jour: date, entite: str = "ENT-A") -> Prevision:
+    return Prevision(
+        date_arrete=jour,
+        entite=entite,
+        methode=MethodePrevision.baseline,
+        statut=StatutPrevision.pas_de_sortie_projetee,
+        probabilite_numerateur=0,
+        probabilite_denominateur=1,
+        horizon_jours_ouvres=5,
+        facteurs=(FacteurExplicatif(nom="stock", libelle="Stock", numerateur=3, denominateur=1),),
+        version_grille="g",
+    )
+
+
+def _risque(jour: date) -> RisqueEntreeRouge:
+    return RisqueEntreeRouge(
+        date_arrete=jour,
+        entite="ENT-A",
+        indicateur=CodeIndicateur.ind_1,
+        date_franchissement_estimee=jour + timedelta(days=7),
+        horizon_jours_ouvres=5,
+        numerateur=1,
+        denominateur=1,
+        seuil_numerateur=2,
+        seuil_denominateur=1,
+        version_grille="g",
+    )
+
+
+def _calcul_complet(consultation: Consultation, jour: date) -> ContenuPrevisions:
+    return ContenuPrevisions(previsions=(_prevision(jour),), risques=(_risque(jour),))
+
+
+def _calcul_mal_date(consultation: Consultation, jour: date) -> ContenuPrevisions:
+    return ContenuPrevisions(previsions=(_prevision(jour - timedelta(days=1)),), risques=())
+
+
+def test_registre_cable(rapport: Rapport) -> None:
+    assert isinstance(rapport.registre[Etape.kpi], EtapeKpi)
+    assert isinstance(rapport.registre[Etape.prevision], EtapePrevision)
+
+
+def test_passage_nominal(rapport: Rapport) -> None:
+    _, ecrivain = _executer(rapport)
+    repertoire = ecrivain.repertoire_publie
+    assert repertoire is not None
+    etats = pl.read_parquet(repertoire / "tickets_etats.parquet")
+    kpi = pl.read_parquet(repertoire / "kpi.parquet")
+    assert set(kpi["date"].to_list()) == set(etats["date"].to_list())
+    assert pl.read_parquet(repertoire / "tendances.parquet").height > 0
+    contenu = lire_enveloppe((repertoire / "previsions.json").read_bytes(), ContenuPrevisions)
+    assert contenu.contenu.previsions == ()
+    assert contenu.contenu.risques == ()
+    assert not (repertoire / "trace" / "previsions.jsonl").exists()
+    jours = set(jours_ouvres(PREMIER_JOUR, DATE_ARRETE))
+    assert set(kpi["date"].to_list()) <= jours
+    assert set(pl.read_parquet(repertoire / "indicateurs.parquet")["date"].to_list()) == jours
+
+
+def test_calcul_injecte(rapport: Rapport) -> None:
+    etape = EtapePrevision(PREMIER_JOUR, "vg", "vd", _calcul_complet)
+    _, ecrivain = _executer(rapport, remplacements={Etape.prevision: etape})
+    repertoire = ecrivain.repertoire_publie
+    assert repertoire is not None
+    jours = list(jours_ouvres(PREMIER_JOUR, DATE_ARRETE))
+    contenu = lire_enveloppe(
+        (repertoire / "previsions.json").read_bytes(), ContenuPrevisions
+    ).contenu
+    assert [p.date_arrete for p in contenu.previsions] == jours
+    assert [r.date_arrete for r in contenu.risques] == jours
+    lignes = (repertoire / FICHIERS_PASSAGE["trace_previsions"]).read_text("utf-8").splitlines()
+    traces = [EntreeTrace.model_validate_json(ligne) for ligne in lignes]
+    assert len(traces) == len(jours)
+    assert {t.type_trace for t in traces} == {TypeTrace.prevision}
+    assert {(t.version_grille, t.version_donnees) for t in traces} == {("vg", "vd")}
+    assert json.loads(traces[0].entree_pseudonymisee)[0]["nom"] == "stock"
+    consultation = ConsultationPassage(
+        repertoire, racine_passages=repertoire.parent.parent, date_arrete=DATE_ARRETE
+    )
+    assert len(consultation.traces()) == len(jours)
+
+
+def test_aucun_ticket(rapport: Rapport) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", datetime(2026, 10, 7, 9, tzinfo=UTC))
+    premier = date(2026, 10, 5)
+    remplacements: dict[Etape, object] = {
+        Etape.instantanes: EtapeInstantanes(SourceEnMemoire(flux.evenements), premier),
+        Etape.kpi: EtapeKpi(["ENT-A", "ENT-B"], premier),
+    }
+    _, ecrivain = _executer(rapport, remplacements=remplacements, date_arrete=date(2026, 10, 6))
+    repertoire = ecrivain.repertoire_publie
+    assert repertoire is not None
+    assert pl.read_parquet(repertoire / "kpi.parquet").height == 0
+    assert pl.read_parquet(repertoire / "tendances.parquet").height == 0
+
+
+def test_prevision_mal_datee(rapport: Rapport) -> None:
+    etape = EtapePrevision(PREMIER_JOUR, "vg", "vd", _calcul_mal_date)
+    with pytest.raises(UsineErreur, match=r"ENT-A.*2026-08-17"):
+        _executer(rapport, remplacements={Etape.prevision: etape})
