@@ -0,0 +1,19 @@
+"""Isolation du registre entre tests."""
+
+import sys
+from collections.abc import Iterator
+
+import pytest
+
+from wavelibrarian import registry
+
+
+@pytest.fixture(autouse=True)
+def registre_isole(monkeypatch: pytest.MonkeyPatch) -> Iterator[None]:
+    """Remplace le registre par un dict vide et purge les modules de test importés."""
+    monkeypatch.setattr(registry, "_REGISTRE", {})
+    avant = set(sys.modules)
+    yield
+    for nom in set(sys.modules) - avant:
+        if nom.endswith("toy_mod"):
+            del sys.modules[nom]
