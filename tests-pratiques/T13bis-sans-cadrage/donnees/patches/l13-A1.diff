diff --git a/src/wavelibrarian/registry.py b/src/wavelibrarian/registry.py
index 0fbf6b0..9001f6e 100644
--- a/src/wavelibrarian/registry.py
+++ b/src/wavelibrarian/registry.py
@@ -1 +1,133 @@
-"""Registre de Composants (story 1.3)."""
+"""Registre de Composants et d'Architectures (story 1.3)."""
+
+import importlib
+import inspect
+import pkgutil
+from collections.abc import Callable
+from typing import Any, TypeVar
+
+from pydantic import BaseModel, ConfigDict
+
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.ports.components import KINDS
+
+T = TypeVar("T", bound=type)
+
+_REGISTRE: dict[tuple[str, str], type] = {}
+
+_PAQUETS_DECOUVERTE = ("wavelibrarian.components", "wavelibrarian.architectures")
+
+
+class ParamInfo(BaseModel):
+    """Description d'un paramètre d'un Composant."""
+
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    name: str
+    type: str
+    default: Any
+    required: bool
+
+
+class ComponentInfo(BaseModel):
+    """Description d'une entrée du registre."""
+
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    kind: str
+    name: str
+    description: str
+    params: dict[str, ParamInfo]
+
+
+def _verifier_params(kind: str, name: str, cls: type) -> None:
+    """Vérifie que `Params`, s'il existe, est un modèle pydantic figé et strict."""
+    chemin = f"{kind}.{name}"
+    params = getattr(cls, "Params", None)
+    if params is None:
+        return
+    if not (inspect.isclass(params) and issubclass(params, BaseModel)):
+        raise ConfigError(chemin, "`Params` doit être une sous-classe de pydantic.BaseModel")
+    if params.model_config.get("extra") != "forbid":
+        raise ConfigError(chemin, '`Params` doit déclarer extra="forbid"')
+    if params.model_config.get("frozen") is not True:
+        raise ConfigError(chemin, "`Params` doit déclarer frozen=True")
+
+
+def register(kind: str, name: str) -> Callable[[T], T]:
+    """Décorateur enregistrant une classe sous `(kind, name)`."""
+
+    def decorer(cls: T) -> T:
+        if kind not in KINDS:
+            raise ConfigError(kind, f"kind inconnu ; admis : {', '.join(KINDS)}")
+        if (kind, name) in _REGISTRE:
+            raise ConfigError(f"{kind}.{name}", "déjà enregistré")
+        _verifier_params(kind, name, cls)
+        _REGISTRE[(kind, name)] = cls
+        return cls
+
+    return decorer
+
+
+def _verifier_kind(kind: str) -> None:
+    if kind not in KINDS:
+        raise ConfigError(kind, f"kind inconnu ; admis : {', '.join(KINDS)}")
+
+
+def get(kind: str, name: str) -> type:
+    """Renvoie la classe enregistrée sous `(kind, name)`."""
+    _verifier_kind(kind)
+    try:
+        return _REGISTRE[(kind, name)]
+    except KeyError:
+        noms = sorted(n for (k, n) in _REGISTRE if k == kind)
+        if not noms:
+            raise ConfigError(f"{kind}.{name}", f"aucun Composant enregistré pour {kind}") from None
+        raise ConfigError(
+            f"{kind}.{name}", f"nom inconnu ; disponibles : {', '.join(noms)}"
+        ) from None
+
+
+def _rendre_type(annotation: Any) -> str:
+    if inspect.isclass(annotation) and not getattr(annotation, "__args__", None):
+        return annotation.__name__
+    return str(annotation).replace("typing.", "")
+
+
+def _decrire(kind: str, name: str, cls: type) -> ComponentInfo:
+    description = inspect.cleandoc(cls.__dict__.get("__doc__") or "")
+    params: dict[str, ParamInfo] = {}
+    modele = getattr(cls, "Params", None)
+    if modele is not None:
+        for champ, field in modele.model_fields.items():
+            requis = field.is_required()
+            params[champ] = ParamInfo(
+                name=champ,
+                type=_rendre_type(field.annotation),
+                default=None if requis else field.get_default(call_default_factory=True),
+                required=requis,
+            )
+    return ComponentInfo(kind=kind, name=name, description=description, params=params)
+
+
+def list_components(kind: str | None = None) -> list[ComponentInfo]:
+    """Liste les entrées, triées par ordre de `KINDS` puis par nom."""
+    if kind is not None:
+        _verifier_kind(kind)
+    cles = sorted(
+        (c for c in _REGISTRE if kind is None or c[0] == kind),
+        key=lambda c: (KINDS.index(c[0]), c[1]),
+    )
+    return [_decrire(k, n, _REGISTRE[(k, n)]) for k, n in cles]
+
+
+def discover() -> None:
+    """Importe récursivement les modules de Composants et d'Architectures."""
+    for nom in _PAQUETS_DECOUVERTE:
+        paquet = importlib.import_module(nom)
+
+        def relancer(_nom: str) -> None:
+            raise
+
+        for info in pkgutil.walk_packages(paquet.__path__, f"{nom}.", onerror=relancer):
+            importlib.import_module(info.name)
