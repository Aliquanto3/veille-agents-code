+"""Architecture `hyde` : recherche dense avec l'embedding d'une réponse hypothétique (FR-20)."""
+
+from typing import Annotated, Any, ClassVar
+
+import numpy as np
+from numpy.typing import NDArray
+from pydantic import Field
+
+from wavelibrarian.architectures.naive_rag import NaiveRag
+from wavelibrarian.components.context import build_arch_answer
+from wavelibrarian.core.types import ArchAnswer, ModelRefMeta, QuestionInput
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.registry import register
+
+_SYSTEM = (
+    "Écris un court passage de document qui répondrait à la question, dans la langue de la "
+    "question, comme s'il en était extrait. Même si tu n'es pas sûr des faits, rédige une "
+    "réponse plausible : elle ne sert qu'à la recherche et ne sera jamais montrée."
+)
+
+
+def _normaliser(vecteur: NDArray[np.float32]) -> NDArray[np.float32]:
+    norme = float(np.linalg.norm(vecteur))
+    return vecteur if norme == 0.0 else (vecteur / norme).astype(np.float32)
+
+
+@register("architecture", "hyde")
+class Hyde(NaiveRag):
+    """Même index dense que `naive_rag` ; seule la requête change : le vecteur de recherche est
+    celui de la réponse hypothétique (rôle `hyde`), jamais présente dans le Contexte."""
+
+    name = "hyde"
+    query_params: ClassVar[frozenset[str]] = frozenset({"k", "mix_question", "model", "max_tokens"})
+
+    class Params(NaiveRag.Params):
+        model: Annotated[str | None, ModelRefMeta("generator_models[0]")] = None
+        max_tokens: int = Field(default=256, gt=0)
+        # Vrai : moyenne renormalisée des vecteurs de la réponse hypothétique et de la Question.
+        mix_question: bool = False
+
+    def __init__(self, params: Any, ctx: Any) -> None:
+        super().__init__(params, ctx)
+        self._model_id: str = params.model or ctx.profile.defaults.generator_models[0]
+
+    def _reponse_hypothetique(self, question: QuestionInput) -> str:
+        requete = LLMRequest(
+            model_id=self._model_id,
+            role="hyde",
+            step="hyde",
+            system=_SYSTEM,
+            messages=(Message(role="user", content=question.text),),
+            max_tokens=self.params.max_tokens,  # type: ignore[attr-defined]
+            seed=self.ctx.seed,  # type: ignore[attr-defined]
+            inputs={"text": question.text},
+        )
+        return str(self.ctx.gateway.complete(requete).text)  # type: ignore[attr-defined]
+
+    def _vecteur_de_recherche(self, question: QuestionInput) -> NDArray[np.float32]:
+        hypothetique = self._reponse_hypothetique(question)
+        if not self.params.mix_question:  # type: ignore[attr-defined]
+            vecteurs = self.embedder.embed_queries([hypothetique])
+            return np.asarray(vecteurs[0], dtype=np.float32)
+        vecteurs = np.asarray(
+            self.embedder.embed_queries([hypothetique, question.text]), dtype=np.float32
+        )
+        return _normaliser(vecteurs.mean(axis=0))
+
+    def answer(self, question: QuestionInput) -> ArchAnswer:
+        if self._index is None:
+            raise RuntimeError("`load` doit précéder `answer`")
+        vecteur = self._vecteur_de_recherche(question)
+        classes = self.retriever.retrieve(  # type: ignore[attr-defined]
+            question.text,
+            self.params.k,  # type: ignore[attr-defined]
+            self._index,
+            query_vector=vecteur,
+        )
+        # Le Contexte et le Generator ne voient que la Question et les Passages retrouvés.
+        contexte = self.context_builder.build([s.passage for s in classes])
+        resultat = self.generator.generate(question, contexte)
+        return build_arch_answer(
+            contexte,
+            resultat,
+            classes,
+            "ranked",
+            tokenizer=self.ctx.tokenizer_for(self.generator.model_id),  # type: ignore[attr-defined]
+        )
diff --git a/tests/unit/architectures/test_story_6_3.py b/tests/unit/architectures/test_story_6_3.py
