+"""Kappa de Cohen entre deux vecteurs binaires (AD-22 : fonction pure, sans import du paquet)."""
+
+from collections.abc import Sequence
+
+
+def _en_binaire(valeurs: Sequence[bool | int], nom: str) -> list[int]:
+    sortie: list[int] = []
+    for i, v in enumerate(valeurs):
+        if isinstance(v, bool) or (isinstance(v, int) and v in (0, 1)):
+            sortie.append(int(v))
+        else:
+            raise ValueError(
+                f"valeur non binaire dans {nom}[{i}] : {v!r} (0, 1 ou booléen attendu)"
+            )
+    return sortie
+
+
+def cohen_kappa(a: Sequence[bool | int], b: Sequence[bool | int]) -> float | None:
+    """Kappa de Cohen de deux vecteurs binaires, calculé sur des comptes entiers.
+
+    Renvoie `None` quand le kappa est indéfini (accord attendu égal à 1, vecteurs vides inclus).
+    Lève `ValueError` si les longueurs diffèrent ou si une valeur n'est pas binaire.
+    """
+    if len(a) != len(b):
+        raise ValueError(f"longueurs différentes : {len(a)} et {len(b)}")
+    va = _en_binaire(a, "a")
+    vb = _en_binaire(b, "b")
+    n = len(va)
+    accords = sum(1 for x, y in zip(va, vb, strict=True) if x == y)
+    ya = sum(va)
+    yb = sum(vb)
+    pe_n2 = ya * yb + (n - ya) * (n - yb)
+    if n * n == pe_n2:
+        return None
+    return (n * accords - pe_n2) / (n * n - pe_n2)
