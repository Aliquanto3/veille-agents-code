+"""Annotations humaines (contracts §4.6) : chargement strict et rapprochement (FR-38)."""
+
+import json
+import logging
+from collections.abc import Collection, Mapping
+from pathlib import Path
+from typing import Any, Literal, NamedTuple
+
+from pydantic import BaseModel, ConfigDict, field_validator
+
+from wavelibrarian.config.defaults import charger_yaml
+from wavelibrarian.config.schemas import valider
+from wavelibrarian.core.errors import ConfigError
+
+CleAnnotation = tuple[str, str, str]  # (annotateur, answer_id, critère)
+
+
+class Annotation(BaseModel):
+    """Un verdict humain sur un Critère d'une Réponse."""
+
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    answer_id: str
+    criterion: Literal["correctness", "completeness", "faithfulness"]
+    verdict: bool
+    note: str = ""
+
+    @field_validator("verdict", mode="before")
+    @classmethod
+    def _verdict(cls, v: Any) -> bool:
+        if isinstance(v, bool):
+            return v
+        if v == "yes" and isinstance(v, str):
+            return True
+        if v == "no" and isinstance(v, str):
+            return False
+        raise ValueError(f"verdict invalide : {v!r} (attendu : yes ou no)")
+
+
+class AnnotationsFile(BaseModel):
+    """Document `annotations/<annotateur>.yaml`."""
+
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    annotator: str
+    annotations: tuple[Annotation, ...]
+
+
+class Rapprochement(NamedTuple):
+    retenues: dict[CleAnnotation, bool]
+    ignorees: tuple[str, ...]
+
+
+def _charger_fichier(chemin: Path) -> dict[CleAnnotation, bool]:
+    donnees: Any = charger_yaml(chemin)
+    if not isinstance(donnees, dict):
+        raise ConfigError(str(chemin), "un fichier d'annotations doit être un dictionnaire YAML")
+    doc = valider(AnnotationsFile, donnees, str(chemin))
+    if doc.annotator != chemin.stem:
+        raise ConfigError(
+            "annotator",
+            f"l'annotateur {doc.annotator!r} ne correspond pas au nom du fichier "
+            f"{chemin.name!r} ({chemin})",
+        )
+    cles: dict[CleAnnotation, bool] = {}
+    index: dict[CleAnnotation, int] = {}
+    for i, a in enumerate(doc.annotations):
+        cle = (doc.annotator, a.answer_id, a.criterion)
+        if cle in cles:
+            raise ConfigError(
+                f"annotations[{i}].criterion",
+                f"annotation en double : {a.answer_id!r} / {a.criterion} "
+                f"(déjà à annotations[{index[cle]}]) ({chemin})",
+            )
+        cles[cle] = a.verdict
+        index[cle] = i
+    return cles
+
+
+def charger_dossier(dossier: Path) -> dict[CleAnnotation, bool]:
+    """Charge les `*.yaml` du dossier (triés), indexés par (annotateur, answer_id, critère)."""
+    resultat: dict[CleAnnotation, bool] = {}
+    for chemin in sorted(dossier.glob("*.yaml")):
+        resultat.update(_charger_fichier(chemin))
+    return resultat
+
+
+def answer_ids_de_answers_jsonl(chemin: Path) -> frozenset[str]:
+    """Les `answer_id` d'un `answers.jsonl` (une ligne JSON par Réponse)."""
+    try:
+        texte = chemin.read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError) as exc:
+        raise ConfigError(str(chemin), f"fichier de Réponses illisible : {exc}") from exc
+    ids: set[str] = set()
+    for n, ligne in enumerate(texte.splitlines(), start=1):
+        if not ligne.strip():
+            continue
+        try:
+            objet = json.loads(ligne)
+        except json.JSONDecodeError as exc:
+            raise ConfigError(f"{chemin}[{n}]", f"ligne JSON invalide : {exc}") from exc
+        aid = objet.get("answer_id") if isinstance(objet, dict) else None
+        if not isinstance(aid, str):
+            raise ConfigError(f"{chemin}[{n}]", "answer_id absent ou n'est pas une chaîne")
+        ids.add(aid)
+    return frozenset(ids)
+
+
+def rapprocher(
+    annotations: Mapping[CleAnnotation, bool], answer_ids: Collection[str]
+) -> Rapprochement:
+    """Garde les annotations dont l'`answer_id` existe (égalité exacte) ; signale les autres."""
+    connus = set(answer_ids)
+    retenues = {cle: v for cle, v in annotations.items() if cle[1] in connus}
+    ignorees = tuple(sorted({cle[1] for cle in annotations if cle[1] not in connus}))
+    for aid in ignorees:
+        logging.warning("annotation ignorée : answer_id absent des Réponses : %s", aid)
+    return Rapprochement(retenues, ignorees)
