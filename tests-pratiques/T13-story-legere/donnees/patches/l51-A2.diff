@@ -0,0 +1,157 @@
+"""Tests des Annotations humaines (story 5.1)."""
+
+import json
+import logging
+
+import pytest
+
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.types import Answer
+from wavelibrarian.scoring.calibration import (
+    answer_ids_de_answers_jsonl,
+    charger_dossier,
+    rapprocher,
+)
+
+AID1 = "run1/cfg/standard/1/base/q1"
+AID2 = "run1/cfg/standard/1/base/q2"
+
+
+def _ecrire(dossier, nom, lignes):
+    (dossier / nom).write_text("\n".join(lignes) + "\n", encoding="utf-8")
+
+
+def _entree(aid, critere="correctness", verdict="yes"):
+    return [f"  - answer_id: {aid}", f"    criterion: {critere}", f"    verdict: {verdict}"]
+
+
+def _fichier(annotateur, *entrees):
+    lignes = [f"annotator: {annotateur}", "annotations:"]
+    for e in entrees:
+        lignes += e
+    return lignes
+
+
+def _erreur(tmp_path, lignes, nom="anael.yaml"):
+    _ecrire(tmp_path, nom, lignes)
+    with pytest.raises(ConfigError) as exc:
+        charger_dossier(tmp_path)
+    return exc.value
+
+
+def test_nominal_deux_annotateurs(tmp_path):
+    _ecrire(
+        tmp_path,
+        "anael.yaml",
+        _fichier("anael", _entree(AID1), _entree(AID1, "faithfulness", "no")),
+    )
+    _ecrire(tmp_path, "collegue.yaml", _fichier("collegue", _entree(AID1, verdict='"no"')))
+    assert charger_dossier(tmp_path) == {
+        ("anael", AID1, "correctness"): True,
+        ("anael", AID1, "faithfulness"): False,
+        ("collegue", AID1, "correctness"): False,
+    }
+
+
+def test_verdicts_nus_et_guillemets(tmp_path):
+    _ecrire(
+        tmp_path,
+        "anael.yaml",
+        _fichier("anael", _entree(AID1, verdict="no"), _entree(AID2, verdict='"yes"')),
+    )
+    cles = charger_dossier(tmp_path)
+    assert cles[("anael", AID1, "correctness")] is False
+    assert cles[("anael", AID2, "correctness")] is True
+
+
+def test_critere_inconnu(tmp_path):
+    valides = [_entree(AID1, c) for c in ("correctness", "completeness", "faithfulness")]
+    err = _erreur(tmp_path, _fichier("anael", *valides, _entree(AID1, "citation_correctness")))
+    assert err.path == "annotations[3].criterion"
+    assert "anael.yaml" in str(err)
+
+
+@pytest.mark.parametrize("verdict", ["peut-être", '"oui"', "1"])
+def test_verdict_invalide(tmp_path, verdict):
+    err = _erreur(tmp_path, _fichier("anael", _entree(AID1, verdict=verdict)))
+    assert err.path == "annotations[0].verdict"
+
+
+def test_doublon(tmp_path):
+    err = _erreur(
+        tmp_path,
+        _fichier(
+            "anael",
+            _entree(AID1),
+            _entree(AID2),
+            _entree(AID2, "faithfulness"),
+            _entree(AID1, "completeness"),
+            _entree(AID1, verdict="no"),
+        ),
+    )
+    assert err.path == "annotations[4].criterion"
+    assert "annotations[0]" in str(err)
+
+
+def test_annotateur_incoherent(tmp_path):
+    err = _erreur(tmp_path, _fichier("bob", _entree(AID1)))
+    assert err.path == "annotator"
+    assert "anael.yaml" in str(err)
+
+
+def test_dossier_vide(tmp_path):
+    assert charger_dossier(tmp_path) == {}
+
+
+def test_answers_jsonl_et_rapprochement(tmp_path, caplog):
+    reponses = [
+        Answer(
+            text="x",
+            abstained=False,
+            answer_id=AID1,
+            question_id="q1",
+            config_id="cfg",
+            tier=1,
+            status="ok",
+        ),
+    ]
+    jsonl = tmp_path / "answers.jsonl"
+    jsonl.write_text(
+        "\n".join(json.dumps(r.model_dump(mode="json")) for r in reponses) + "\n\n",
+        encoding="utf-8",
+    )
+    ids = answer_ids_de_answers_jsonl(jsonl)
+    assert ids == {AID1}
+
+    annotations = {
+        ("anael", AID1, "correctness"): True,
+        ("anael", AID2, "correctness"): False,
+        ("collegue", AID2, "faithfulness"): True,
+        ("anael", "run1/cfg/standard/q3", "correctness"): True,  # sans tier ni phase
+    }
+    with caplog.at_level(logging.WARNING):
+        res = rapprocher(annotations, ids)
+    assert res.retenues == {("anael", AID1, "correctness"): True}
+    assert res.ignorees == (AID2, "run1/cfg/standard/q3")
+    assert AID2 in caplog.text
+
+
+def test_answers_jsonl_ligne_invalide(tmp_path):
+    jsonl = tmp_path / "answers.jsonl"
+    jsonl.write_text('{"answer_id": "a"}\nnon json\n', encoding="utf-8")
+    with pytest.raises(ConfigError) as exc:
+        answer_ids_de_answers_jsonl(jsonl)
+    assert exc.value.path == f"{jsonl}[2]"
+
+
+def test_answers_jsonl_sans_answer_id(tmp_path):
+    jsonl = tmp_path / "answers.jsonl"
+    jsonl.write_text('{"answer_id": 3}\n', encoding="utf-8")
+    with pytest.raises(ConfigError) as exc:
+        answer_ids_de_answers_jsonl(jsonl)
+    assert exc.value.path == f"{jsonl}[1]"
+
+
+def test_answers_jsonl_illisible(tmp_path):
+    with pytest.raises(ConfigError):
+        answer_ids_de_answers_jsonl(tmp_path / "absent.jsonl")
