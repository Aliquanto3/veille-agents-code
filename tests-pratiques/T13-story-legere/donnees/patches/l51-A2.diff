@@ -0,0 +1,45 @@
+"""Tests du kappa de Cohen (story 5.1)."""
+
+import pytest
+
+from wavelibrarian.stats.kappa import cohen_kappa
+
+
+def test_table_connue():
+    # 20 oui-oui, 5 oui-non, 10 non-oui, 15 non-non : po = 35/50 = 0,7 ; pe = 0,5 * 0,6 + 0,5 * 0,4
+    a = [True] * 20 + [True] * 5 + [False] * 10 + [False] * 15
+    b = [True] * 20 + [False] * 5 + [True] * 10 + [False] * 15
+    assert cohen_kappa(a, b) == pytest.approx(0.4, abs=1e-12)
+
+
+def test_identiques():
+    v = [True, False, True, True, False]
+    assert cohen_kappa(v, v) == 1.0
+
+
+def test_une_seule_classe():
+    assert cohen_kappa([True] * 4, [True] * 4) is None
+    assert cohen_kappa([False] * 4, [False] * 4) is None
+
+
+def test_vides():
+    assert cohen_kappa([], []) is None
+
+
+def test_classes_opposees_constantes():
+    assert cohen_kappa([True] * 4, [False] * 4) == 0.0
+
+
+def test_longueurs_differentes():
+    with pytest.raises(ValueError, match="longueurs"):
+        cohen_kappa([True], [True, False])
+
+
+@pytest.mark.parametrize("mauvaise", [2, -1, 0.5, "1", None])
+def test_valeur_non_binaire(mauvaise):
+    with pytest.raises(ValueError, match="non binaire"):
+        cohen_kappa([True, mauvaise], [True, False])
+
+
+def test_entiers_acceptes():
+    assert cohen_kappa([1, 0, 1, 0], [True, False, True, False]) == 1.0
