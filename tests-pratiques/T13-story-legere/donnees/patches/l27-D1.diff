@@ -0,0 +1,81 @@
+"""Paliers de volume (story 2.7) : emboîtement, requis, reproductibilité, erreurs, CLI."""
+
+from pathlib import Path
+
+import pytest
+from typer.testing import CliRunner
+
+from wavelibrarian.cli import app
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.types import ParsedCorpus
+from wavelibrarian.corpus.declare import TiersSpec
+from wavelibrarian.corpus.tiers import tirer, tirer_chemins
+
+MINI = Path(__file__).resolve().parents[3] / "corpora" / "minicorpus" / "corpus.yaml"
+TIERS = TiersSpec(seed=42, sizes=(5, 10, 20))
+
+
+def _chemins(minicorpus: ParsedCorpus) -> list[str]:
+    return [d.source_path for d in minicorpus.documents]
+
+
+def test_emboitement_et_requis(minicorpus: ParsedCorpus):
+    chemins = _chemins(minicorpus)
+    requis = chemins[-3:]
+    paliers = tirer_chemins(chemins, TIERS, requis)
+    assert [len(p) for p in paliers.values()] == [5, 10, 20]
+    assert set(paliers[5]) < set(paliers[10]) < set(paliers[20])
+    assert all(set(requis) <= set(p) for p in paliers.values())
+
+
+def test_reproductible_et_graine(minicorpus: ParsedCorpus):
+    chemins = _chemins(minicorpus)
+    requis = chemins[:3]
+    base = tirer_chemins(chemins, TIERS, requis)
+    assert tirer_chemins(chemins, TIERS, requis) == base
+    autre = tirer_chemins(chemins, TiersSpec(seed=7, sizes=(5, 10, 20)), requis)
+    assert autre[10] != base[10]
+
+
+def test_requis_trop_nombreux(minicorpus: ParsedCorpus):
+    chemins = _chemins(minicorpus)
+    with pytest.raises(ConfigError, match="ne peut pas contenir"):
+        tirer_chemins(chemins, TIERS, chemins[:6])
+
+
+def test_taille_superieure_au_corpus(minicorpus: ParsedCorpus):
+    chemins = _chemins(minicorpus)
+    tiers = TiersSpec(seed=1, sizes=(5, len(chemins) + 1))
+    with pytest.raises(ConfigError) as e:
+        tirer_chemins(chemins, tiers)
+    assert e.value.path == "tiers.sizes[1]"
+
+
+def test_sous_corpus(minicorpus: ParsedCorpus):
+    sous = tirer(minicorpus, TIERS)
+    assert len(sous[5].documents) == 5
+    assert sous[5].corpus_id == minicorpus.corpus_id
+    assert len({c.fingerprint for c in sous.values()}) == 3
+    assert sous[5].fingerprint != minicorpus.fingerprint
+
+
+def test_cli_paliers():
+    res = CliRunner().invoke(app, ["corpus", "paliers", str(MINI)])
+    assert res.exit_code == 0
+    assert "Palier 5" in res.output
+    assert "Palier 20" in res.output
+    assert ".md" in res.output
+
+
+def test_cli_sans_tiers(tmp_path: Path):
+    (tmp_path / "docs").mkdir()
+    (tmp_path / "docs" / "a.md").write_text("# A\n\ntexte\n", encoding="utf-8")
+    yaml_ = tmp_path / "corpus.yaml"
+    yaml_.write_text(
+        "corpus_id: sans-paliers\npath: docs\nlang: fr\nlicense: CC-BY-4.0\n"
+        "publishable: true\nvolatility: low\n",
+        encoding="utf-8",
+    )
+    res = CliRunner().invoke(app, ["corpus", "paliers", str(yaml_)])
+    assert res.exit_code == 0
+    assert "tiers" in res.output
