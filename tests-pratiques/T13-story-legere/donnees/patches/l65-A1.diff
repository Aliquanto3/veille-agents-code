@@ -0,0 +1,254 @@
+"""Story 6.5 : Architecture `cag` (préchargement du Corpus dans le cache de prompt)."""
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+
+from wavelibrarian import registry
+from wavelibrarian.architectures.cag import Cag
+from wavelibrarian.architectures.long_context import LongContext
+from wavelibrarian.config.validate import validate_file
+from wavelibrarian.core.errors import ConfigError, ValidationFailed
+from wavelibrarian.core.types import CorpusProfile, ParsedCorpus, QuestionInput
+from wavelibrarian.llm.providers.fake import FakeProvider, ProviderResponse, Usage
+from wavelibrarian.ports.components import ComponentSpec
+from wavelibrarian.ports.gateway import LLMRequest
+from wavelibrarian.runner.context import Context as RunCtx
+from wavelibrarian.runner.index_cache import IndexCache
+
+REPONSE = '{"answer": "Réponse.", "citations": ["S1"], "abstain": false}'
+GEN = {"name": "llm", "params": {"model": "fake-llm-a"}}
+
+
+def _monter(tmp_path: Path, provider: FakeProvider, run_id: str = "r-1") -> RunCtx:
+    c = RunCtx.from_profile(
+        "test", wl_home=tmp_path / "wl", run_id=run_id, seed=1, providers={"fake": provider}
+    )
+    c.parser = "markdown"
+    c.provider = provider  # type: ignore[attr-defined]
+    return c
+
+
+@pytest.fixture
+def ctx(tmp_path: Path):  # type: ignore[no-untyped-def]
+    with _monter(tmp_path, FakeProvider()) as c:
+        yield c
+
+
+def _arch(ctx: RunCtx, **params: Any) -> Any:
+    params.setdefault("generator", GEN)
+    return ctx.build("architecture", ComponentSpec(name="cag", params=params))
+
+
+def _profil(n_tokens: int) -> CorpusProfile:
+    return CorpusProfile(
+        corpus_id="c",
+        fingerprint="f",
+        parser="markdown",
+        tokenizer="approx",
+        n_documents=1,
+        n_tokens=n_tokens,
+        mean_tokens_per_document=float(n_tokens),
+        heading_depth_max=1,
+        heading_depth_mean=1.0,
+        link_density=0.0,
+        table_share=0.0,
+        images_per_document=0.0,
+        dominant_lang="fr",
+        langs={"fr": 1},
+        formats={"markdown": 1},
+        volatility="low",
+    )
+
+
+def _question(n: int) -> QuestionInput:
+    return QuestionInput(question_id=f"q-{n:03d}", text=f"Que sait-on de Orvane ({n}) ?", lang="fr")
+
+
+def _spans_llm(ctx: RunCtx) -> list[dict[str, Any]]:
+    lignes = (ctx.run_dir / "traces.jsonl").read_text(encoding="utf-8").splitlines()
+    return [s for s in map(json.loads, lignes) if s.get("wl.kind") == "llm"]
+
+
+def _espionner(ctx: RunCtx) -> list[LLMRequest]:
+    vues: list[LLMRequest] = []
+
+    def sortie(req: LLMRequest) -> str:
+        vues.append(req)
+        return REPONSE
+
+    ctx.provider.script("generate", "*", sortie)  # type: ignore[attr-defined]
+    return vues
+
+
+def _construire(ctx: RunCtx, corpus: ParsedCorpus, tmp_path: Path) -> tuple[Any, Any]:
+    return IndexCache(tmp_path / "home").build(ctx, lambda: _arch(ctx), corpus)
+
+
+def _repondre(arch: Any, ctx: RunCtx, n: int = 1) -> Any:
+    with ctx.scope(post="query", question_id=f"q-{n:03d}"):
+        return arch.answer(_question(n))
+
+
+def test_enregistrement_et_capacites(ctx: RunCtx) -> None:
+    arch = _arch(ctx)
+    assert registry.get("architecture", "cag") is Cag
+    assert issubclass(Cag, LongContext)
+    assert Cag.capabilities.requires_prompt_cache is True
+    assert Cag.capabilities.full_corpus_in_prompt is True
+    assert Cag.capabilities.retrieval_method == "cited"
+    assert arch.params.generator.params["cache_system"] is True
+    defaut = ctx.build("architecture", ComponentSpec(name="cag"))
+    assert defaut.params.generator.params["cache_system"] is True
+
+
+def test_prechargement_via_index_cache(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    vues = _espionner(ctx)
+    arch, _ = _construire(ctx, minicorpus, tmp_path)
+    assert arch._contexte is not None
+    precharges = [s for s in _spans_llm(ctx) if s["wl.step"] == "cag.preload"]
+    assert len(precharges) == 1 and len(_spans_llm(ctx)) == 1
+    assert precharges[0]["wl.post"] == "indexing"
+    assert precharges[0]["wl.status"] == "ok"
+    requete = vues[0]
+    assert requete.cache_system is True and requete.role == "generate"
+    attendus = [
+        a for d in minicorpus.documents for a in d.anchors if minicorpus.anchor_text(a).strip()
+    ]
+    assert all(f"[S{i}] ({a})" in requete.system for i, a in enumerate(attendus, start=1))
+    # le préfixe est celui de `generate`
+    _repondre(arch, ctx)
+    assert vues[1].system == requete.system and vues[1].step == "generate"
+    assert vues[1].cache_system is True
+
+
+def test_second_build_cache_present_precharge_de_nouveau(
+    tmp_path: Path, minicorpus: ParsedCorpus
+) -> None:
+    with _monter(tmp_path, FakeProvider(), "r-1") as c1:
+        _, servi = _construire(c1, minicorpus, tmp_path)
+        assert servi is False or servi is not None
+    with _monter(tmp_path, FakeProvider(), "r-2") as c2:
+        appels: list[Any] = []
+        origine = Cag.index
+
+        def index_espion(self: Any, corpus: Any, directory: Path) -> None:
+            appels.append(directory)
+            origine(self, corpus, directory)
+
+        Cag.index = index_espion  # type: ignore[method-assign]
+        try:
+            _construire(c2, minicorpus, tmp_path)
+        finally:
+            Cag.index = origine  # type: ignore[method-assign]
+        assert appels == []  # index servi par le cache
+        precharges = [s for s in _spans_llm(c2) if s["wl.step"] == "cag.preload"]
+        assert len(precharges) == 1 and precharges[0]["wl.post"] == "indexing"
+
+
+def test_deux_questions_lisent_le_cache(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    ctx.provider.script("generate", "*", REPONSE)  # type: ignore[attr-defined]
+    arch, _ = _construire(ctx, minicorpus, tmp_path)
+    r1 = _repondre(arch, ctx, 1)
+    r2 = _repondre(arch, ctx, 2)
+    assert r1.retrieval_method == "cited" and r2.retrieval_method == "cited"
+    generates = [s for s in _spans_llm(ctx) if s["wl.step"] == "generate"]
+    assert len(generates) == 2
+    lus = generates[1]["wl.usage.cache_read_tokens"]
+    assert lus > 0
+    # les tokens en cache ne comptent pas dans les tokens d'entrée
+    assert generates[1]["gen_ai.usage.input_tokens"] < lus
+    assert generates[0]["wl.usage.cache_read_tokens"] > 0  # lu dès Q1 grâce au préchargement
+
+
+def test_inapplicable_au_dela_de_la_fenetre_sans_appel(ctx: RunCtx) -> None:
+    arch = _arch(ctx)
+    res = arch.check(_profil(120_000))
+    assert res.applicable is False and "fenêtre" in (res.reason or "")
+    assert arch.check(_profil(10_000)).applicable is True
+    assert _spans_llm(ctx) == [] if (ctx.run_dir / "traces.jsonl").exists() else True
+
+
+def test_inapplicable_au_dela_du_palier_haiku(ctx: RunCtx) -> None:
+    arch = _arch(ctx, generator={"name": "llm", "params": {"model": "claude-haiku-5-5"}})
+    res = arch.check(_profil(80_000))
+    assert res.applicable is False and "palier" in (res.reason or "")
+    assert arch.check(_profil(60_000)).applicable is True
+
+
+class _FournisseurSeuil(FakeProvider):
+    """Rend 0 token en cache tant que le préfixe est plus court que `seuil` (min_cacheable)."""
+
+    seuil = 10_000
+
+    def complete(self, request: LLMRequest, **kw: Any) -> ProviderResponse:
+        rep = super().complete(request, **kw)
+        if len(request.system.split()) >= self.seuil:
+            return rep
+        u = rep.usage
+        usage = Usage(
+            input_tokens=u.input_tokens + u.cache_read_tokens,
+            output_tokens=u.output_tokens,
+            cache_read_tokens=0,
+        )
+        return ProviderResponse(text=rep.text, usage=usage, latency_s=rep.latency_s)
+
+
+def test_corpus_court_precharge_sans_erreur_et_sans_cache(
+    tmp_path: Path, minicorpus: ParsedCorpus
+) -> None:
+    with _monter(tmp_path, _FournisseurSeuil()) as c:
+        c.provider.script("generate", "*", REPONSE)  # type: ignore[attr-defined]
+        arch, _ = _construire(c, minicorpus, tmp_path)
+        _repondre(arch, c, 1)
+        _repondre(arch, c, 2)
+        spans = _spans_llm(c)
+        assert [s["wl.step"] for s in spans] == ["cag.preload", "generate", "generate"]
+        assert all(s["wl.usage.cache_read_tokens"] == 0 for s in spans)
+        assert all(s.get("wl.status", "ok") == "ok" for s in spans)
+
+
+def test_validation_refuse_un_modele_sans_cache_de_prompt(tmp_path: Path, wl_home: Path) -> None:
+    catalogue = yaml.safe_load(
+        (Path(__file__).parents[3] / "src/wavelibrarian/defaults/models.yaml").read_text("utf-8")
+    )
+    for m in catalogue["models"]:
+        if m["id"] == "fake-llm-a":
+            m["prompt_cache"] = False
+    (tmp_path / "models.yaml").write_text(yaml.safe_dump(catalogue), encoding="utf-8")
+    donnees = {
+        "experiment_id": "exp-test",
+        "seed": 42,
+        "profile": "test",
+        "corpus": "c.yaml",
+        "questions": "q.yaml",
+        "catalog": "models.yaml",
+        "configurations": [{"id": "a", "architecture": "cag", "params": {"generator": GEN}}],
+    }
+    chemin = tmp_path / "exp.yaml"
+    chemin.write_text(yaml.safe_dump(donnees, sort_keys=False), encoding="utf-8")
+    with pytest.raises(ValidationFailed) as echec:
+        validate_file(chemin, wl_home)
+    assert "prompt_cache: false" in str(echec.value)
+
+
+def test_generator_non_llm_refuse(ctx: RunCtx) -> None:
+    ctx.build("architecture", ComponentSpec(name="cag"))  # découverte des Composants
+    other = registry.get("generator", "llm")
+    assert other is not None
+    with pytest.raises(ConfigError):
+        _arch(ctx, generator={"name": "autre"})
+
+
+def test_cache_system_false_refuse(ctx: RunCtx) -> None:
+    with pytest.raises(ConfigError, match="cag"):
+        _arch(
+            ctx, generator={"name": "llm", "params": {"model": "fake-llm-a", "cache_system": False}}
+        )
