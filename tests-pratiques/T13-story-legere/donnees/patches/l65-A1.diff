+    def preload(self, context: Context) -> None:
+        """Précharge le Contexte dans le cache de prompt : même préfixe que `generate` (rôle,
+        system, schéma), seuls l'étape et le message user diffèrent."""
+        if not self._cache_system:
+            raise WlError("`preload` exige `cache_system: true`")
+        question = "Question : (préchargement du contexte)"
+        requete = LLMRequest(
+            model_id=self.model_id,
+            role="generate",
+            step="cag.preload",
