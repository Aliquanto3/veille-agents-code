+"""Architecture `cag` : tout le Corpus préchargé dans le cache de prompt (FR-22)."""
+
+from pathlib import Path
+from typing import Any
+
+from pydantic import field_validator
+
+from wavelibrarian.architectures.long_context import LongContext
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.ports.architecture import ArchCapabilities
+from wavelibrarian.ports.components import ComponentSpec
+from wavelibrarian.registry import register
+
+
+@register("architecture", "cag")
+class Cag(LongContext):
+    """Comme `long_context`, mais `load` émet un appel de préchargement dont le system est celui
+    de `generate` : le coût d'écriture du cache est imputé au poste fixé par le runner (AD-8) et
+    les Questions lisent ce préfixe en cache."""
+
+    name = "cag"
+    capabilities = ArchCapabilities(
+        retrieval_method="cited", full_corpus_in_prompt=True, requires_prompt_cache=True
+    )
+
+    class Params(LongContext.Params):
+        @field_validator("generator")
+        @classmethod
+        def _system_en_cache(cls, spec: ComponentSpec) -> ComponentSpec:
+            """Le Generator `llm` met toujours le system (le Corpus) en cache (FR-16)."""
+            if spec.name != "llm":
+                return spec
+            if spec.params.get("cache_system", True) is not True:
+                raise ValueError("`cag` exige `cache_system: true` pour le Generator `llm`")
+            return ComponentSpec(name=spec.name, params={**spec.params, "cache_system": True})
+
+    def __init__(self, params: Any, ctx: Any) -> None:
+        if params.generator.name != "llm":
+            raise ConfigError(
+                "generator",
+                f"`cag` précharge le cache de prompt : Generator `llm` seul, "
+                f"pas `{params.generator.name}`",
+            )
+        super().__init__(params, ctx)
+
+    def load(self, directory: Path) -> None:
+        super().load(directory)
+        self.generator.preload(self._contexte)  # poste fixé par le runner (AD-8)
