+def test_valeur_projetee_dans_le_contrat() -> None:
+    for projete in _calculer(_reference()).risques:
+        risque = projete.risque
+        assert risque.valeur_projetee_numerateur == projete.valeur_projetee.numerator
+        assert risque.valeur_projetee_denominateur == projete.valeur_projetee.denominator
+        publie = risque.model_dump_json()
+        assert "valeur_projetee_numerateur" in publie
+        assert "valeur_projetee_denominateur" in publie
+
+
