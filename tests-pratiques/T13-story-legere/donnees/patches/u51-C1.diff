+"""`EtapeKpi` et `EtapePrevision` : enveloppes du domaine, sans recalcul (Story 5.1)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+from typing import cast
+
+import polars as pl
+import pytest
+
+from tests.unit.chaine.environnement import horloge_pas_a_pas, preparer_racine
+from tests.unit.domaine.constructeur import Flux
+from usine.chaine.etapes import EtapeKpi, EtapePrevision
+from usine.composition import construire_rapport
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur
+from usine.contrats.passage import ContextePassage, StatutEtape
+from usine.contrats.prevision import (
+    ContenuPrevisions,
+    MethodePrevision,
+    Prevision,
+    RisqueEntreeRouge,
+    StatutPrevision,
+)
+from usine.contrats.trace import TypeTrace
+from usine.domaine.instantanes import tickets_etats
+from usine.domaine.kpi import kpi, tendances
+from usine.ports.consultation import Consultation
+
+PREMIER_JOUR = date(2026, 10, 5)
+DATE_ARRETE = date(2026, 10, 9)
+ENTITES = ["ENT-A", "ENT-B"]
+PASSAGE_ID = "20261012T073000Z-abc123"
+VERSION_GRILLE = "abcdef012345"
+VERSION_DONNEES = "123456abcdef"
+
+
+class ConsultationEtats:
+    """Consultation minimale : `tickets_etats(jour)` filtre une table construite d'avance."""
+
+    def __init__(self, etats: pl.DataFrame) -> None:
+        self._etats = etats
+
+    def tickets_etats(self, jour: date) -> pl.DataFrame:
+        return self._etats.filter(pl.col("date") == jour)
+
+
+@pytest.fixture
+def configuration(tmp_path: Path):  # type: ignore[no-untyped-def]
+    return construire_rapport(preparer_racine(tmp_path)).configuration
+
+
+def _contexte(configuration, consultation: object, jour: date = DATE_ARRETE):  # type: ignore[no-untyped-def]
+    return ContextePassage(jour, PASSAGE_ID, configuration, cast(Consultation, consultation))
+
+
+def _prevision(entite: str = "ENT-A") -> Prevision:
+    return Prevision(
+        date_arrete=DATE_ARRETE,
+        entite=entite,
+        methode=MethodePrevision.baseline,
+        statut=StatutPrevision.sortie_projetee,
+        date_sortie_estimee=date(2026, 10, 16),
+        probabilite_numerateur=1,
+        probabilite_denominateur=2,
+        horizon_jours_ouvres=10,
+        facteurs=(),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _risque(entite: str = "ENT-B") -> RisqueEntreeRouge:
+    return RisqueEntreeRouge(
+        date_arrete=DATE_ARRETE,
+        entite=entite,
+        indicateur=CodeIndicateur.ind_1,
+        date_franchissement_estimee=date(2026, 10, 14),
+        horizon_jours_ouvres=10,
+        numerateur=3,
+        denominateur=1,
+        seuil_numerateur=5,
+        seuil_denominateur=1,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _etape(contenu: object) -> EtapePrevision:
+    return EtapePrevision(
+        lambda ctx: cast(ContenuPrevisions, contenu),
+        VERSION_DONNEES,
+        horloge_pas_a_pas(datetime(2026, 10, 12, 7, 30, tzinfo=UTC)),
+    )
+
+
+def test_prevision_contenu_et_traces(configuration) -> None:  # type: ignore[no-untyped-def]
+    contenu = ContenuPrevisions(previsions=(_prevision(),), risques=(_risque(),))
+    resultat = _etape(contenu).executer(_contexte(configuration, object()))
+    assert resultat.statut is StatutEtape.reussie
+    assert resultat.sorties == {"previsions": contenu}
+    prevision, risque = resultat.traces
+    assert [t.type_trace for t in resultat.traces] == [TypeTrace.prevision] * 2
+    assert [t.cible for t in resultat.traces] == ["ENT-A", "ENT-B"]
+    assert {t.passage_id for t in resultat.traces} == {PASSAGE_ID}
+    assert {t.date_arrete for t in resultat.traces} == {DATE_ARRETE}
+    assert {t.version_grille for t in resultat.traces} == {VERSION_GRILLE}
+    assert {t.version_donnees for t in resultat.traces} == {VERSION_DONNEES}
+    assert prevision.sortie == contenu.previsions[0].model_dump_json()
+    assert risque.sortie == contenu.risques[0].model_dump_json()
+    assert '"methode": "baseline"' in prevision.entree_pseudonymisee
+    assert '"indicateur": "IND-1"' in risque.entree_pseudonymisee
+    assert risque.horodatage > prevision.horodatage
+
+
+def test_prevision_ordre_previsions_puis_risques(configuration) -> None:  # type: ignore[no-untyped-def]
+    contenu = ContenuPrevisions(
+        previsions=(_prevision("ENT-B"), _prevision("ENT-A")), risques=(_risque("ENT-A"),)
+    )
+    resultat = _etape(contenu).executer(_contexte(configuration, object()))
+    assert [t.cible for t in resultat.traces] == ["ENT-B", "ENT-A", "ENT-A"]
+    assert [t.sortie for t in resultat.traces[:2]] == [
+        p.model_dump_json() for p in contenu.previsions
+    ]
+
+
+def test_prevision_contenu_vide(configuration) -> None:  # type: ignore[no-untyped-def]
+    contenu = ContenuPrevisions(previsions=(), risques=())
+    resultat = _etape(contenu).executer(_contexte(configuration, object()))
+    assert resultat.sorties == {"previsions": contenu}
+    assert resultat.traces == ()
+
+
+def test_prevision_type_refuse(configuration) -> None:  # type: ignore[no-untyped-def]
+    with pytest.raises(UsineErreur, match=r"prevision.*dict"):
+        _etape({}).executer(_contexte(configuration, object()))
+
+
+def _etats(flux: Flux, jour: date = DATE_ARRETE) -> pl.DataFrame:
+    return tickets_etats(flux.evenements, jours_ouvres(PREMIER_JOUR, jour))
+
+
+def test_kpi_egal_au_domaine(configuration) -> None:  # type: ignore[no-untyped-def]
+    flux = Flux()
+    flux.anomalie("DEMO-1", datetime(2026, 10, 5, 9, tzinfo=UTC))
+    flux.anomalie("DEMO-2", datetime(2026, 10, 7, 9, tzinfo=UTC), entite="ENT-B")
+    flux.transition("DEMO-1", datetime(2026, 10, 8, 9, tzinfo=UTC), "nouvelle", "rejetee")
+    etats = _etats(flux)
+    resultat = EtapeKpi(ENTITES, PREMIER_JOUR).executer(
+        _contexte(configuration, ConsultationEtats(etats))
+    )
+    attendu = kpi(etats, ENTITES)
+    assert resultat.statut is StatutEtape.reussie
+    assert set(resultat.sorties) == {"kpi", "tendances"}
+    assert resultat.traces == ()
+    assert cast(pl.DataFrame, resultat.sorties["kpi"]).equals(attendu)
+    assert cast(pl.DataFrame, resultat.sorties["tendances"]).equals(
+        tendances(attendu, DATE_ARRETE, PREMIER_JOUR)
+    )
+    dates = sorted(attendu["date"].unique().to_list())
+    assert dates == list(jours_ouvres(PREMIER_JOUR, DATE_ARRETE))
+
+
+def test_kpi_sans_ticket(configuration) -> None:  # type: ignore[no-untyped-def]
+    flux = Flux()
+    flux.anomalie("DEMO-1", datetime(2026, 10, 12, 9, tzinfo=UTC))
+    etats = _etats(flux, date(2026, 10, 12))  # aucun ticket avant le 12
+    assert etats.filter(pl.col("date") <= DATE_ARRETE).is_empty()
+    resultat = EtapeKpi(ENTITES, PREMIER_JOUR).executer(
+        _contexte(configuration, ConsultationEtats(etats))
+    )
+    assert cast(pl.DataFrame, resultat.sorties["kpi"]).is_empty()
+    assert cast(pl.DataFrame, resultat.sorties["tendances"]).is_empty()
+
+
+def test_kpi_date_anterieure_a_l_historique(configuration) -> None:  # type: ignore[no-untyped-def]
+    etape = EtapeKpi(ENTITES, PREMIER_JOUR)
+    with pytest.raises(UsineErreur, match="2026-10-02"):
+        etape.executer(
+            _contexte(configuration, ConsultationEtats(_etats(Flux())), date(2026, 10, 2))
+        )
