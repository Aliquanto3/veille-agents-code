+class EtapeKpi:
+    """KPI quotidiens et Tendances, pour chaque Jour ouvré de l'historique.
+
+    `premier_jour` est l'ancrage des semaines du Programme.
+    """
+
+    def __init__(self, entites: Sequence[str], premier_jour: date) -> None:
+        self._entites = tuple(entites)
+        self._premier_jour = premier_jour
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sorties `kpi` et `tendances`, lues depuis `tickets_etats` du Passage."""
+        jours = jours_du_passage(self._premier_jour, ctx.date_arrete)
+        etats = pl.concat([ctx.consultation.tickets_etats(jour) for jour in jours], how="vertical")
+        quotidiens = kpi(etats, self._entites)
+        return ResultatEtape(
+            StatutEtape.reussie,
+            {
+                "kpi": quotidiens,
+                "tendances": tendances(quotidiens, ctx.date_arrete, self._premier_jour),
+            },
+        )
+
+
+class EtapePrevision:
+    """Écrit les Prévisions et Risques rendus par une fonction injectée, avec leurs traces."""
+
+    def __init__(
+        self,
+        prevoir: Callable[[ContextePassage[Consultation]], ContenuPrevisions],
+        version_donnees: str,
+        horloge: Callable[[], datetime],
+    ) -> None:
+        self._prevoir = prevoir
+        self._version_donnees = version_donnees
+        self._horloge = horloge
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sortie `previsions` et une trace par Prévision puis par Risque, dans cet ordre."""
+        contenu = self._prevoir(ctx)
+        if not isinstance(contenu, ContenuPrevisions):
+            raise UsineErreur(
+                f"étape prevision : contenu de type {type(contenu).__name__},"
+                " ContenuPrevisions attendu"
+            )
+        traces = [
+            self._trace(
+                ctx,
+                prevision.date_arrete,
+                prevision.entite,
+                prevision.version_grille,
+                {"methode": prevision.methode.value},
+                prevision.model_dump_json(),
+            )
+            for prevision in contenu.previsions
+        ]
+        traces.extend(
+            self._trace(
+                ctx,
+                risque.date_arrete,
+                risque.entite,
+                risque.version_grille,
+                {"indicateur": risque.indicateur.value},
+                risque.model_dump_json(),
+            )
+            for risque in contenu.risques
+        )
+        return ResultatEtape(StatutEtape.reussie, {"previsions": contenu}, tuple(traces))
+
+    def _trace(
+        self,
+        ctx: ContextePassage[Consultation],
+        date_arrete: date,
+        entite: str,
+        version_grille: str,
+        identite: dict[str, str],
+        sortie: str,
+    ) -> EntreeTrace:
+        identite = {"date_arrete": date_arrete.isoformat(), "entite": entite, **identite}
+        return EntreeTrace(
+            type_trace=TypeTrace.prevision,
+            horodatage=self._horloge(),
+            passage_id=ctx.passage_id,
+            date_arrete=date_arrete,
+            entite=entite,
+            cible=entite,
+            version_grille=version_grille,
+            version_donnees=self._version_donnees,
+            entree_pseudonymisee=json.dumps(identite, ensure_ascii=False),
+            sortie=sortie,
+        )
+
+
 class EtapeBouchon:
     """Étape pas encore implémentée : réussie, sans sortie."""
 
