+"""Architecture `hyde` : recherche dense avec l'embedding d'une réponse hypothétique (FR-20)."""
+
+from typing import Annotated, Any, ClassVar
+
+import numpy as np
+from numpy.typing import NDArray
+from pydantic import Field
+
+from wavelibrarian.architectures.naive_rag import NaiveRag
+from wavelibrarian.components.context import build_arch_answer
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.types import ArchAnswer, ModelRefMeta, QuestionInput
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.registry import register
+
+_SYSTEM = (
+    "Rédige un court passage de documentation qui répondrait à la question, dans la langue de "
+    "la question, comme s'il en était extrait. Si tu ignores la réponse, invente une réponse "
+    "plausible : ce texte sert uniquement à la recherche, il n'est jamais montré."
+)
+
+
+def _normaliser(vecteur: NDArray[np.float32]) -> NDArray[np.float32]:
+    norme = float(np.linalg.norm(vecteur))
+    return vecteur if norme == 0.0 else (vecteur / norme).astype(np.float32)
+
+
+@register("architecture", "hyde")
+class Hyde(NaiveRag):
+    """Même index que `naive_rag` ; seule la requête change : le vecteur de recherche est celui
+    d'une réponse hypothétique générée (rôle `hyde`), éventuellement moyenné avec la Question."""
+
+    name = "hyde"
+    query_params: ClassVar[frozenset[str]] = frozenset(
+        {"k", "mix_question", "hyde_model", "hyde_max_tokens"}
+    )
+
+    class Params(NaiveRag.Params):
+        mix_question: bool = False
+        hyde_model: Annotated[str | None, ModelRefMeta("generator_models[0]")] = None
+        hyde_max_tokens: int = Field(default=256, gt=0)
+
+    def __init__(self, params: Any, ctx: Any) -> None:
+        if params.retriever.name == "lexical":
+            raise ConfigError(
+                "retriever",
+                "le retriever `lexical` ignore le vecteur de la réponse hypothétique ; "
+                "utiliser `dense` ou `hybrid`",
+            )
+        super().__init__(params, ctx)
+        self._hyde_model: str = params.hyde_model or ctx.profile.defaults.generator_models[0]
+
+    def _hypothese(self, question: QuestionInput) -> str:
+        requete = LLMRequest(
+            model_id=self._hyde_model,
+            role="hyde",
+            step="hyde",
+            system=_SYSTEM,
+            messages=(Message(role="user", content=question.text),),
+            max_tokens=self.params.hyde_max_tokens,  # type: ignore[attr-defined]
+            seed=self.ctx.seed,  # type: ignore[attr-defined]
+            inputs={"text": question.text},
+        )
+        return self.ctx.gateway.complete(requete).text.strip()  # type: ignore[attr-defined]
+
+    def _vecteur_recherche(self, question: QuestionInput) -> NDArray[np.float32]:
+        hypothese = self._hypothese(question)
+        if not hypothese:  # rien à encoder : retour à la recherche par la Question
+            return np.asarray(self.embedder.embed_queries([question.text])[0], dtype=np.float32)
+        if not self.params.mix_question:  # type: ignore[attr-defined]
+            return np.asarray(self.embedder.embed_queries([hypothese])[0], dtype=np.float32)
+        vecteurs = np.asarray(
+            self.embedder.embed_queries([hypothese, question.text]), dtype=np.float32
+        )
+        somme = vecteurs.mean(axis=0)
+        if float(np.linalg.norm(somme)) == 0.0:  # vecteurs opposés : l'hypothèse seule
+            return _normaliser(vecteurs[0])
+        return _normaliser(somme)
+
+    def answer(self, question: QuestionInput) -> ArchAnswer:
+        if self._index is None:
+            raise RuntimeError("`load` doit précéder `answer`")
+        vecteur = self._vecteur_recherche(question)
+        classes = self.retriever.retrieve(  # type: ignore[attr-defined]
+            question.text,
+            self.params.k,  # type: ignore[attr-defined]
+            self._index,
+            vecteur,
+        )
+        contexte = self.context_builder.build([s.passage for s in classes])
+        resultat = self.generator.generate(question, contexte)
+        return build_arch_answer(
+            contexte,
+            resultat,
+            classes,
+            "ranked",
+            tokenizer=self.ctx.tokenizer_for(self.generator.model_id),
+        )
diff --git a/tests/unit/architectures/test_story_6_3.py b/tests/unit/architectures/test_story_6_3.py
