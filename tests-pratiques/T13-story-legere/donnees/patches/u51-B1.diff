+class EtapeKpi:
+    """KPI quotidiens et Tendances, pour chaque Jour ouvré jusqu'à la Date d'arrêté."""
+
+    def __init__(self, entites: Sequence[str], premier_jour: date) -> None:
+        self._entites = tuple(entites)
+        self._premier_jour = premier_jour
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sorties `kpi` et `tendances`, calculées par le domaine sur `tickets_etats`."""
+        jours = jours_du_passage(self._premier_jour, ctx.date_arrete)
+        etats = pl.concat([ctx.consultation.tickets_etats(jour) for jour in jours], how="vertical")
+        table_kpi = kpi(etats, self._entites)
+        return ResultatEtape(
+            StatutEtape.reussie,
+            {
+                "kpi": table_kpi,
+                "tendances": tendances(table_kpi, ctx.date_arrete, self._premier_jour),
+            },
+        )
+
+
+FonctionPrevision = Callable[[pl.DataFrame, tuple[MeteoEntite, ...], date], ContenuPrevisions]
+"""Fonction de Prévision : (Indicateurs, Météos, Date d'arrêté) vers `ContenuPrevisions`."""
+
+
+def aucune_prevision(
+    indicateurs: pl.DataFrame, meteos: tuple[MeteoEntite, ...], date_arrete: date
+) -> ContenuPrevisions:
+    """Prévision par défaut : aucune Prévision ni Risque (l'algorithme est hors périmètre)."""
+    return ContenuPrevisions(previsions=(), risques=())
+
+
+class EtapePrevision:
+    """Écrit `previsions.json` et une trace de type `prevision` par Prévision (AD-16)."""
+
+    def __init__(
+        self,
+        prevoir: FonctionPrevision,
+        version_donnees: str,
+        horloge: Callable[[], datetime],
+    ) -> None:
+        self._prevoir = prevoir
+        self._version_donnees = version_donnees
+        self._horloge = horloge
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sortie `previsions` et traces des Prévisions."""
+        contenu = self._prevoir(
+            ctx.consultation.indicateurs(),
+            ctx.consultation.meteo(ctx.date_arrete),
+            ctx.date_arrete,
+        )
+        traces = tuple(
+            EntreeTrace(
+                type_trace=TypeTrace.prevision,
+                horodatage=self._horloge(),
+                passage_id=ctx.passage_id,
+                date_arrete=ctx.date_arrete,
+                entite=prevision.entite,
+                version_grille=prevision.version_grille,
+                version_donnees=self._version_donnees,
+                entree_pseudonymisee=json.dumps(
+                    [f.model_dump(mode="json") for f in prevision.facteurs],
+                    ensure_ascii=False,
+                ),
+                sortie=prevision.model_dump_json(),
+            )
+            for prevision in contenu.previsions
+        )
+        return ResultatEtape(StatutEtape.reussie, {"previsions": contenu}, traces)
+
+
 class EtapeBouchon:
     """Étape pas encore implémentée : réussie, sans sortie."""
 
