@@ -0,0 +1,156 @@
+"""Étapes déterministes `kpi` et `prevision` et Passage autoportant (Story 5.1)."""
+
+import json
+from datetime import date, timedelta
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.chaine.environnement import DATE_ARRETE, horloge_figee, preparer_racine
+from usine.chaine.etapes import EtapeKpi, EtapePrevision, aucune_prevision
+from usine.composition import construire_rapport, lancer_rapport
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.meteo import MeteoEntite
+from usine.contrats.passage import ManifestePassage
+from usine.contrats.prevision import (
+    ContenuPrevisions,
+    FacteurExplicatif,
+    MethodePrevision,
+    Prevision,
+    StatutPrevision,
+)
+from usine.contrats.trace import EntreeTrace, TypeTrace
+from usine.domaine.kpi import kpi, tendances
+
+HUIT_FICHIERS = {
+    "tickets_etats.parquet",
+    "tickets_textes.parquet",
+    "instantanes.parquet",
+    "kpi.parquet",
+    "indicateurs.parquet",
+    "meteo.json",
+    "tendances.parquet",
+    "previsions.json",
+}
+
+
+@pytest.fixture
+def lance(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):  # type: ignore[no-untyped-def]
+    for variable in ("USINE_MODE_REPLI", "JIRA_EMAIL", "JIRA_TOKEN_LECTURE", "JIRA_DC_PAT"):
+        monkeypatch.delenv(variable, raising=False)
+    racine = preparer_racine(tmp_path)
+    return racine, lancer_rapport(racine, DATE_ARRETE, horloge_figee())
+
+
+def test_huit_fichiers_et_manifeste(lance) -> None:  # type: ignore[no-untyped-def]
+    racine, resultat = lance
+    noms = {p.name for p in resultat.repertoire.iterdir()}
+    assert noms >= HUIT_FICHIERS
+    assert not (resultat.repertoire / "trace" / "previsions.jsonl").exists()
+    manifeste = ManifestePassage.model_validate_json(
+        (resultat.repertoire / "manifeste.json").read_bytes()
+    )
+    rapport = construire_rapport(racine)
+    assert manifeste.date_arrete == DATE_ARRETE
+    assert manifeste.source == "journal"
+    assert manifeste.nb_alignements == 0
+    assert manifeste.horodatage_extraction is None
+    assert manifeste.version_grille == rapport.donnees.version_grille
+    assert manifeste.version_donnees == rapport.donnees.version_donnees
+    assert manifeste.contrats_version
+    etats = pl.read_parquet(resultat.repertoire / "tickets_etats.parquet")
+    assert manifeste.nb_tickets == etats.filter(pl.col("date") == DATE_ARRETE).height
+    assert all(e.horodatage_fin >= e.horodatage_debut for e in manifeste.etapes)
+
+
+def date_min(table: pl.DataFrame) -> date:
+    """Plus petite date de la colonne `date`."""
+    premier = table["date"].min()
+    assert isinstance(premier, date)
+    return premier
+
+
+def test_kpi_et_tendances_egaux_au_domaine(lance) -> None:  # type: ignore[no-untyped-def]
+    _, resultat = lance
+    rep = resultat.repertoire
+    etats = pl.read_parquet(rep / "tickets_etats.parquet")
+    table_kpi = pl.read_parquet(rep / "kpi.parquet")
+    entites = sorted(e for e in etats["entite"].unique().to_list() if e is not None)
+    attendu = kpi(etats, entites)
+    assert table_kpi.sort(attendu.columns).equals(attendu.sort(attendu.columns))
+    premier = date_min(etats)
+    jours = set(jours_ouvres(premier, DATE_ARRETE))
+    assert set(table_kpi["date"].unique().to_list()) == jours
+    relues = pl.read_parquet(rep / "tendances.parquet")
+    voulues = tendances(attendu, DATE_ARRETE, premier)
+    assert relues.sort(voulues.columns).equals(voulues.sort(voulues.columns))
+
+
+def test_aucune_prevision() -> None:
+    vide = pl.DataFrame()
+    assert aucune_prevision(vide, (), DATE_ARRETE) == ContenuPrevisions(previsions=(), risques=())
+
+
+def _prevision(entite: str) -> Prevision:
+    return Prevision(
+        date_arrete=DATE_ARRETE,
+        entite=entite,
+        methode=MethodePrevision.baseline,
+        statut=StatutPrevision.sortie_projetee,
+        date_sortie_estimee=DATE_ARRETE + timedelta(days=7),
+        probabilite_numerateur=1,
+        probabilite_denominateur=2,
+        horizon_jours_ouvres=10,
+        facteurs=(FacteurExplicatif(nom="stock", libelle="Stock", numerateur=3, denominateur=1),),
+        version_grille="abcdef012345",
+    )
+
+
+class _Consultation:
+    def indicateurs(self) -> pl.DataFrame:
+        return pl.DataFrame()
+
+    def meteo(self, date_arrete: date) -> tuple[MeteoEntite, ...]:
+        return ()
+
+
+def _executer(nb: int):  # type: ignore[no-untyped-def]
+    from usine.contrats.passage import ContextePassage
+
+    def prevoir(
+        indicateurs: pl.DataFrame, meteos: tuple[MeteoEntite, ...], jour: date
+    ) -> ContenuPrevisions:
+        return ContenuPrevisions(
+            previsions=tuple(_prevision(f"ENT-{i}") for i in range(nb)), risques=()
+        )
+
+    etape = EtapePrevision(prevoir, "donnees01", horloge_figee())
+    ctx = ContextePassage(
+        DATE_ARRETE,
+        "20261012T073000Z-abc123",
+        None,  # type: ignore[arg-type]
+        _Consultation(),
+    )
+    return etape.executer(ctx)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("nb", [0, 2])
+def test_une_trace_par_prevision(nb: int) -> None:
+    resultat = _executer(nb)
+    assert len(resultat.traces) == nb
+    assert len(resultat.sorties["previsions"].previsions) == nb
+    for trace in resultat.traces:
+        assert isinstance(trace, EntreeTrace)
+        assert trace.type_trace is TypeTrace.prevision
+        assert trace.tache is None
+        assert not trace.depuis_cache
+        assert trace.passage_id == "20261012T073000Z-abc123"
+        assert trace.version_donnees == "donnees01"
+        assert trace.version_grille == "abcdef012345"
+        assert json.loads(trace.sortie)["entite"] == trace.entite
+        assert json.loads(trace.entree_pseudonymisee)[0]["nom"] == "stock"
+
+
+def test_etape_kpi_est_exportee() -> None:
+    assert EtapeKpi(["ENT-A"], date(2026, 1, 5))
