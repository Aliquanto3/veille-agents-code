@@ -0,0 +1,119 @@
+"""Chargement du manifeste d'injection et clés Jira dans `SourceJournal` (Story 2.5, FR-8)."""
+
+import json
+from datetime import date
+from pathlib import Path
+
+import pytest
+
+from usine.adaptateurs.journal import CHEMIN_MANIFESTE_INJECTION, SourceJournal, charger_manifeste
+from usine.config import charger_yaml
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.evenements import ManifesteInjection
+from usine.generateur.journal import Generation, generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[4]
+
+
+@pytest.fixture(scope="module")
+def generation() -> Generation:
+    config = charger_yaml(RACINE / "tests/unit/generateur/programme_reduit.yaml", ConfigProgramme)
+    return generer(config, 42, date(2026, 10, 12))
+
+
+def donnees_manifeste(correspondance: dict[str, str]) -> dict[str, object]:
+    return {
+        "date_injection": "2026-10-12",
+        "debut_injection": "2026-10-12T08:00:00Z",
+        "horodatage_fin_injection": "2026-10-12T08:05:00Z",
+        "cle_projet": "DEMO",
+        "correspondance_cles": correspondance,
+    }
+
+
+def ecrire_manifeste(chemin: Path, correspondance: dict[str, str]) -> ManifesteInjection:
+    chemin.write_text(json.dumps(donnees_manifeste(correspondance)), encoding="utf-8")
+    return charger_manifeste(chemin)
+
+
+def correspondance_bijective(generation: Generation) -> dict[str, str]:
+    cles = sorted({e.cle_ticket for e in generation.evenements})
+    return {cle: f"DEMO-{i}" for i, cle in enumerate(cles, start=1)}
+
+
+def test_chemin_par_defaut() -> None:
+    assert Path("donnees/injection/manifeste_injection.json") == CHEMIN_MANIFESTE_INJECTION
+
+
+def test_manifeste_valide(tmp_path: Path) -> None:
+    manifeste = ecrire_manifeste(tmp_path / "m.json", {"GEN-1": "DEMO-1"})
+    assert dict(manifeste.correspondance_cles) == {"GEN-1": "DEMO-1"}
+
+
+def test_manifeste_absent(tmp_path: Path) -> None:
+    with pytest.raises(UsineErreur, match=r"m\.json : manifeste d'injection introuvable"):
+        charger_manifeste(tmp_path / "m.json")
+
+
+def test_manifeste_json_illisible(tmp_path: Path) -> None:
+    chemin = tmp_path / "m.json"
+    chemin.write_text("{pas du json", encoding="utf-8")
+    with pytest.raises(UsineErreur, match=r"m\.json : manifeste d'injection, JSON illisible"):
+        charger_manifeste(chemin)
+
+
+def test_manifeste_non_injectif(tmp_path: Path) -> None:
+    with pytest.raises(UsineErreur, match=r"m\.json : manifeste d'injection invalide.*injective"):
+        ecrire_manifeste(tmp_path / "m.json", {"GEN-1": "DEMO-1", "GEN-2": "DEMO-1"})
+
+
+def test_cles_jira_appliquees(tmp_path: Path, generation: Generation) -> None:
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generation))
+    table = correspondance_bijective(generation)
+    manifeste = ecrire_manifeste(tmp_path / "m.json", table)
+    rendus = list(SourceJournal(chemin, manifeste).evenements())
+    assert len(rendus) == len(generation.evenements)
+    for rendu, origine in zip(rendus, generation.evenements, strict=True):
+        assert rendu == origine.model_copy(update={"cle_ticket": table[origine.cle_ticket]})
+
+
+def test_cles_jira_avec_depuis(tmp_path: Path, generation: Generation) -> None:
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generation))
+    table = correspondance_bijective(generation)
+    manifeste = ecrire_manifeste(tmp_path / "m.json", table)
+    depuis = generation.evenements[10].horodatage
+    rendus = list(SourceJournal(chemin, manifeste).evenements(depuis))
+    assert rendus
+    assert {e.cle_ticket for e in rendus} <= set(table.values())
+    assert [e.id_evenement for e in rendus] == [
+        e.id_evenement for e in generation.evenements if e.horodatage >= depuis
+    ]
+
+
+def test_cle_sans_correspondance(tmp_path: Path, generation: Generation) -> None:
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generation))
+    table = correspondance_bijective(generation)
+    retiree = sorted(table)[-1]
+    del table[retiree]
+    manifeste = ecrire_manifeste(tmp_path / "m.json", table)
+    with pytest.raises(UsineErreur, match=rf"journal\.jsonl.*{retiree}"):
+        SourceJournal(chemin, manifeste)
+
+
+def test_correspondance_excedentaire_tolérée(tmp_path: Path, generation: Generation) -> None:
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generation))
+    table = correspondance_bijective(generation)
+    table["ZZZ-999"] = "DEMO-99999"
+    manifeste = ecrire_manifeste(tmp_path / "m.json", table)
+    assert list(SourceJournal(chemin, manifeste).evenements())
+
+
+def test_sans_manifeste(tmp_path: Path, generation: Generation) -> None:
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generation))
+    assert tuple(SourceJournal(chemin, None).evenements()) == generation.evenements
