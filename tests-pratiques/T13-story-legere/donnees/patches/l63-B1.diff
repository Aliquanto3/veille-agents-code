+"""Architecture `hyde` : recherche dense par l'embedding d'une réponse hypothétique (FR-20)."""
+
+from typing import Annotated, ClassVar
+
+import numpy as np
+from pydantic import Field
+
+from wavelibrarian.architectures.naive_rag import NaiveRag
+from wavelibrarian.components.context import build_arch_answer
+from wavelibrarian.core.types import ArchAnswer, ModelRefMeta, QuestionInput
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.registry import register
+
+_SYSTEM = (
+    "Rédige un court passage plausible qui répondrait à la question, dans la langue de la "
+    "question. Ce passage sert uniquement à la recherche : il n'a pas besoin d'être exact."
+)
+
+
+@register("architecture", "hyde")
+class Hyde(NaiveRag):
+    """Même index que `naive_rag` ; le vecteur de recherche vient d'une réponse hypothétique."""
+
+    name = "hyde"
+    query_params: ClassVar[frozenset[str]] = frozenset({"k", "mix_question"})
+
+    class Params(NaiveRag.Params):
+        mix_question: bool = False
+        hyde_model: Annotated[str | None, ModelRefMeta("generator_models[0]")] = None
+        hyde_max_tokens: int = Field(default=256, gt=0)
+
+    def _hypothese(self, question: QuestionInput) -> str:
+        params = self.params  # type: ignore[attr-defined]
+        requete = LLMRequest(
+            model_id=params.hyde_model or self.ctx.profile.defaults.generator_models[0],  # type: ignore[attr-defined]
+            role="hyde",
+            step="hyde",
+            system=_SYSTEM,
+            messages=(Message(role="user", content=f"Question : {question.text}"),),
+            max_tokens=params.hyde_max_tokens,
+            seed=self.ctx.seed,  # type: ignore[attr-defined]
+            inputs={"text": question.text},
+        )
+        return self.ctx.gateway.complete(requete).text  # type: ignore[attr-defined]
+
+    def answer(self, question: QuestionInput) -> ArchAnswer:
+        if self._index is None:
+            raise RuntimeError("`load` doit précéder `answer`")
+        params = self.params  # type: ignore[attr-defined]
+        hypothese = self._hypothese(question)
+        if params.mix_question:
+            h, q = np.asarray(self.embedder.embed_queries([hypothese, question.text]))
+            somme = (h + q).astype(np.float64)
+            vecteur = (somme / np.linalg.norm(somme)).astype(np.float32)
+        else:
+            vecteur = np.asarray(self.embedder.embed_queries([hypothese]), dtype=np.float32)[0]
+        classes = self.retriever.retrieve(  # type: ignore[attr-defined]
+            question.text, params.k, self._index, query_vector=vecteur
+        )
+        contexte = self.context_builder.build([s.passage for s in classes])  # type: ignore[attr-defined]
+        resultat = self.generator.generate(question, contexte)  # type: ignore[attr-defined]
+        return build_arch_answer(
+            contexte,
+            resultat,
+            classes,
+            "ranked",
+            tokenizer=self.ctx.tokenizer_for(self.generator.model_id),  # type: ignore[attr-defined]
+        )
diff --git a/tests/unit/architectures/test_story_6_3.py b/tests/unit/architectures/test_story_6_3.py
