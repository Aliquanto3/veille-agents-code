+"""`SourceJournal` à la volumétrie cible de `config/programme.yaml`, sans réseau (Story 2.5)."""
+
+from datetime import date
+from pathlib import Path
+
+import pytest
+
+from tests.unit.adaptateurs.journal.outils_manifeste import cle_jira, ecrire_manifeste
+from usine.adaptateurs.journal import SourceJournal, charger_manifeste
+from usine.config import charger_yaml
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import SCHEMA_TICKET_ETAT
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.generateur.journal import generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[4]
+
+pytestmark = pytest.mark.lent
+
+
+def _jour_ouvre(jour: date) -> date:
+    return jour if est_jour_ouvre(jour) else jour_ouvre_suivant(jour)
+
+
+@pytest.mark.usefixtures("sans_reseau")
+def test_journal_complet_avec_cles_jira(tmp_path: Path) -> None:
+    config = charger_yaml(RACINE / "config/programme.yaml", ConfigProgramme)
+    generation = generer(config, 42, date(2026, 10, 12))
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generation))
+    cles = {e.cle_ticket for e in generation.evenements}
+    manifeste = charger_manifeste(
+        ecrire_manifeste(tmp_path / "manifeste.json", cles, generation.entete.date_injection)
+    )
+
+    source = SourceJournal(chemin, manifeste)
+    evenements = tuple(source.evenements())
+
+    assert len(evenements) == len(generation.evenements) > 30_000
+    assert all(
+        e.cle_ticket == cle_jira(b.cle_ticket)
+        for e, b in zip(evenements, generation.evenements, strict=True)
+    )
+    premier = _jour_ouvre(generation.entete.ancrage_semaines)
+    injection = _jour_ouvre(generation.entete.date_injection)
+    milieu = _jour_ouvre(premier + (injection - premier) / 2)
+    etats = tickets_etats(evenements, [premier, milieu, injection])
+    valider(etats, SCHEMA_TICKET_ETAT)
+    assert etats.height > 0
+    assert set(etats["date"].unique()) == {premier, milieu, injection}
+    assert set(etats["cle_ticket"].unique()) <= {cle_jira(c) for c in cles}
+    assert instantane(etats).height > 0
