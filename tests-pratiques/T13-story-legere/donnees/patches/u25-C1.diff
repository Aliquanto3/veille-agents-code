+"""Manifestes d'essai : correspondance `DEMO-n → DEMO-(n+500)`."""
+
+import json
+from collections.abc import Iterable
+from datetime import date
+from pathlib import Path
+
+DECALAGE = 500
+
+
+def cle_jira(cle: str) -> str:
+    """Clé Jira fictive d'une clé générée `DEMO-n`."""
+    prefixe, numero = cle.rsplit("-", 1)
+    return f"{prefixe}-{int(numero) + DECALAGE}"
+
+
+def ecrire_manifeste(
+    chemin: Path, cles: Iterable[str], date_injection: date, *, sans: str | None = None
+) -> Path:
+    """Écrit un manifeste valide ; `sans` retire une clé de la correspondance."""
+    chemin.parent.mkdir(parents=True, exist_ok=True)
+    correspondance = {cle: cle_jira(cle) for cle in sorted(set(cles)) if cle != sans}
+    contenu = {
+        "date_injection": date_injection.isoformat(),
+        "debut_injection": "2026-10-12T07:00:00Z",
+        "horodatage_fin_injection": "2026-10-12T07:20:00Z",
+        "cle_projet": "DEMO",
+        "correspondance_cles": correspondance,
+    }
+    chemin.write_text(json.dumps(contenu), encoding="utf-8")
+    return chemin
