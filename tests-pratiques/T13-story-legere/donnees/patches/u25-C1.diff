+"""`SourceJournal` avec `ManifesteInjection` : clés Jira appliquées à la lecture (Story 2.5)."""
+
+import json
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import pytest
+
+from tests.unit.adaptateurs.journal.outils_manifeste import cle_jira, ecrire_manifeste
+from usine.adaptateurs.journal import (
+    CHEMIN_MANIFESTE_INJECTION,
+    SourceJournal,
+    charger_manifeste,
+)
+from usine.config import charger_yaml
