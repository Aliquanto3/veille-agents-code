+from usine.contrats.erreurs import UsineErreur
+from usine.generateur.journal import Generation, generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[4]
+
+
+@pytest.fixture(scope="module")
+def generation() -> Generation:
+    config = charger_yaml(RACINE / "tests/unit/generateur/programme_reduit.yaml", ConfigProgramme)
+    return generer(config, 42, date(2026, 10, 12))
+
+
+@pytest.fixture
+def chemin_journal(tmp_path: Path, generation: Generation) -> Path:
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generation))
+    return chemin
+
+
+def _manifeste(tmp_path: Path, generation: Generation, **options: object) -> Path:
+    cles = {e.cle_ticket for e in generation.evenements}
+    return ecrire_manifeste(
+        tmp_path / "manifeste.json",
+        cles,
+        generation.entete.date_injection,
+        **options,  # type: ignore[arg-type]
+    )
+
+
+def test_chemin_par_defaut() -> None:
+    assert Path("donnees/injection/manifeste_injection.json") == CHEMIN_MANIFESTE_INJECTION
+
+
+def test_sans_manifeste_flux_inchange(chemin_journal: Path, generation: Generation) -> None:
+    source = SourceJournal(chemin_journal)
+    assert source.manifeste is None
+    assert tuple(source.evenements()) == generation.evenements
+
+
+def test_correspondance_remplace_seulement_la_cle(
+    tmp_path: Path, chemin_journal: Path, generation: Generation
+) -> None:
+    manifeste = charger_manifeste(_manifeste(tmp_path, generation))
+    source = SourceJournal(chemin_journal, manifeste)
+    assert source.manifeste is manifeste
+    obtenus = tuple(source.evenements())
+    assert len(obtenus) == len(generation.evenements)
+    for obtenu, brut in zip(obtenus, generation.evenements, strict=True):
+        assert obtenu.cle_ticket == cle_jira(brut.cle_ticket)
+        assert obtenu == brut.model_copy(update={"cle_ticket": cle_jira(brut.cle_ticket)})
+        assert obtenu.id_evenement == brut.id_evenement
+        assert obtenu.source == brut.source
+
+
+def test_depuis_avec_manifeste(
+    tmp_path: Path, chemin_journal: Path, generation: Generation
+) -> None:
+    source = SourceJournal(chemin_journal, charger_manifeste(_manifeste(tmp_path, generation)))
+    coupe = generation.evenements[len(generation.evenements) // 2].horodatage
+    attendus = [cle_jira(e.cle_ticket) for e in generation.evenements if e.horodatage >= coupe]
+    assert [e.cle_ticket for e in source.evenements(coupe)] == attendus
+    with pytest.raises(UsineErreur, match="fuseau"):
+        list(source.evenements(datetime(2026, 10, 1)))  # noqa: DTZ001
+
+
+def test_cle_manquante(tmp_path: Path, chemin_journal: Path, generation: Generation) -> None:
+    manifeste = charger_manifeste(_manifeste(tmp_path, generation, sans="DEMO-3"))
+    with pytest.raises(UsineErreur, match=r"journal\.jsonl.*ligne \d+.*DEMO-3"):
+        SourceJournal(chemin_journal, manifeste)
+
+
+def test_date_incoherente(tmp_path: Path, chemin_journal: Path, generation: Generation) -> None:
+    cles = {e.cle_ticket for e in generation.evenements}
+    autre = date(2026, 10, 8)
+    assert autre != generation.entete.date_injection
+    chemin = ecrire_manifeste(tmp_path / "m.json", cles, autre)
+    with pytest.raises(UsineErreur) as erreur:
+        SourceJournal(chemin_journal, charger_manifeste(chemin))
+    message = str(erreur.value)
+    assert "journal.jsonl" in message
+    assert autre.isoformat() in message
+    assert generation.entete.date_injection.isoformat() in message
+
+
+def test_manifeste_introuvable(tmp_path: Path) -> None:
+    with pytest.raises(UsineErreur, match=r"absent\.json"):
+        charger_manifeste(tmp_path / "absent.json")
+
+
+@pytest.mark.parametrize(
+    "contenu", ["{pas du json", "[1, 2]", "{}", '{"date_injection": "2026-10-12"}'], ids=str
+)
+def test_manifeste_illisible_ou_invalide(tmp_path: Path, contenu: str) -> None:
+    chemin = tmp_path / "manifeste.json"
+    chemin.write_text(contenu, encoding="utf-8")
+    with pytest.raises(UsineErreur, match=r"manifeste\.json"):
+        charger_manifeste(chemin)
+
+
+def test_manifeste_non_utf8(tmp_path: Path) -> None:
+    chemin = tmp_path / "manifeste.json"
+    chemin.write_bytes(b"\xff\xfe\x00")
+    with pytest.raises(UsineErreur, match=r"manifeste\.json.*UTF-8"):
+        charger_manifeste(chemin)
+
+
+def test_manifeste_valide_relu(tmp_path: Path, generation: Generation) -> None:
+    chemin = _manifeste(tmp_path, generation)
+    manifeste = charger_manifeste(chemin)
+    assert manifeste.cle_projet == "DEMO"
+    assert manifeste.debut_injection == datetime(2026, 10, 12, 7, 0, tzinfo=UTC)
+    assert json.loads(chemin.read_text(encoding="utf-8"))["cle_projet"] == "DEMO"
