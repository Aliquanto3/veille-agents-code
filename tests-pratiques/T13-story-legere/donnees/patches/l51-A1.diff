@@ -0,0 +1,106 @@
+"""Annotations humaines (contracts §4.6) : chargement strict et rapprochement des Réponses."""
+
+import json
+import logging
+from collections.abc import Collection, Mapping
+from pathlib import Path
+from typing import Annotated, Any, Literal, NamedTuple
+
+from pydantic import BaseModel, BeforeValidator, ConfigDict, Field
+
+from wavelibrarian.config.defaults import charger_yaml
+from wavelibrarian.config.schemas import valider
+from wavelibrarian.core.errors import ConfigError, WlError
+from wavelibrarian.core.types import Criterion
+
+_log = logging.getLogger(__name__)
+
+Cle = tuple[str, str, Criterion]
+
+
+def _verdict(v: object) -> bool:
+    if isinstance(v, bool):
+        return v
+    if isinstance(v, str) and v in ("yes", "no"):
+        return v == "yes"
+    raise ValueError("verdict attendu : yes ou no")
+
+
+class _Annotation(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    answer_id: str
+    criterion: Literal["correctness", "completeness", "faithfulness"]
+    verdict: Annotated[bool, BeforeValidator(_verdict)]
+    note: str = ""
+
+
+class _FichierAnnotations(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    annotator: str = Field(min_length=1)
+    annotations: tuple[_Annotation, ...]
+
+
+class Rapprochement(NamedTuple):
+    """Annotations retenues et `answer_id` ignorés (absents des Réponses)."""
+
+    retenues: dict[Cle, bool]
+    ignorees: tuple[str, ...]
+
+
+def charger_dossier(dossier: Path) -> dict[Cle, bool]:
+    """Charge les `*.yaml` du dossier, indexés par (annotateur, `answer_id`, Critère)."""
+    if not dossier.is_dir():
+        raise ConfigError(str(dossier), "dossier d'annotations introuvable")
+    resultat: dict[Cle, bool] = {}
+    origine: dict[Cle, tuple[Path, int]] = {}
+    for fichier in sorted(dossier.glob("*.yaml")):
+        donnees: Any = charger_yaml(fichier)
+        if not isinstance(donnees, dict):
+            raise ConfigError(
+                str(fichier), "un fichier d'annotations doit être un dictionnaire YAML"
+            )
+        doc = valider(_FichierAnnotations, donnees, str(fichier))
+        for i, a in enumerate(doc.annotations):
+            cle: Cle = (doc.annotator, a.answer_id, a.criterion)
+            if cle in origine:
+                premier, j = origine[cle]
+                raise ConfigError(
+                    f"annotations[{i}].criterion",
+                    f"annotation en double : {a.answer_id!r} / {a.criterion} pour "
+                    f"{doc.annotator!r} ({fichier}) ; déjà à annotations[{j}] de {premier}",
+                )
+            origine[cle] = (fichier, i)
+            resultat[cle] = a.verdict
+    return resultat
+
+
+def answer_ids_de_answers_jsonl(chemin: Path) -> set[str]:
+    """Les `answer_id` d'un `answers.jsonl` (lecture seule)."""
+    try:
+        lignes = chemin.read_text(encoding="utf-8").splitlines()
+    except OSError as exc:
+        raise WlError(f"{chemin} illisible : {exc}") from exc
+    ids: set[str] = set()
+    for no, ligne in enumerate(lignes, start=1):
+        if not ligne.strip():
+            continue
+        try:
+            obj = json.loads(ligne)
+        except json.JSONDecodeError as exc:
+            raise WlError(f"{chemin} ligne {no} : JSON invalide ({exc})") from exc
+        if not isinstance(obj, dict) or not isinstance(obj.get("answer_id"), str):
+            raise WlError(f"{chemin} ligne {no} : champ answer_id absent")
+        ids.add(obj["answer_id"])
+    return ids
+
+
+def rapprocher(annotations: Mapping[Cle, bool], answer_ids: Collection[str]) -> Rapprochement:
+    """Écarte les annotations dont l'`answer_id` n'est pas dans `answer_ids` (signalées)."""
+    connus = set(answer_ids)
+    retenues = {k: v for k, v in annotations.items() if k[1] in connus}
+    ignorees = tuple(sorted({k[1] for k in annotations if k[1] not in connus}))
+    for answer_id in ignorees:
+        _log.warning("annotation ignorée : answer_id absent des Réponses : %s", answer_id)
+    return Rapprochement(retenues, ignorees)
diff --git a/src/wavelibrarian/stats/kappa.py b/src/wavelibrarian/stats/kappa.py
