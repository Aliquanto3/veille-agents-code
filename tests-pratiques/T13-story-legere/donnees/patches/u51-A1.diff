+FonctionPrevision = Callable[
+    [date, pl.DataFrame, pl.DataFrame, tuple[MeteoEntite, ...]], ContenuPrevisions
+]
+"""Fonction de Prévision : (jour, KPI ≤ jour, indicateurs ≤ jour, Météos ≤ jour) → contenu."""
+
+
+def aucune_prevision(
+    jour: date,
+    kpi_jusqua: pl.DataFrame,
+    indicateurs_jusqua: pl.DataFrame,
+    meteos_jusqua: tuple[MeteoEntite, ...],
+) -> ContenuPrevisions:
+    """Fonction de Prévision par défaut : ni Prévision ni Risque."""
+    return ContenuPrevisions(previsions=(), risques=())
+
+
+class EtapePrevision:
+    """Prévisions et Risques pour chaque Jour ouvré, avec une trace par Prévision (FR-34)."""
+
+    def __init__(
+        self,
+        prevoir: FonctionPrevision,
+        version_grille: str,
+        version_donnees: str,
+        premier_jour: date,
+        horloge: Callable[[], datetime],
+    ) -> None:
+        self._prevoir = prevoir
+        self._version_grille = version_grille
+        self._version_donnees = version_donnees
+        self._premier_jour = premier_jour
+        self._horloge = horloge
+
+    def _verifier(self, contenu: ContenuPrevisions, jour: date) -> None:
+        objets: tuple[Prevision | RisqueEntreeRouge, ...] = (*contenu.previsions, *contenu.risques)
+        for objet in objets:
+            if objet.date_arrete != jour:
+                raise UsineErreur(
+                    f"Prévision du {jour.isoformat()}, Entité {objet.entite} : date d'arrêté"
+                    f" {objet.date_arrete.isoformat()} différente du jour"
+                )
+        for prevision in contenu.previsions:
+            if prevision.version_grille != self._version_grille:
+                raise UsineErreur(
+                    f"Prévision du {jour.isoformat()}, Entité {prevision.entite} : version de"
+                    f" grille {prevision.version_grille} différente de celle du Passage"
+                    f" {self._version_grille}"
+                )
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sortie `previsions` ; les lectures de chaque jour sont limitées à ce jour."""
+        previsions: list[Prevision] = []
+        risques: list[RisqueEntreeRouge] = []
+        traces: list[EntreeTrace] = []
+        kpis: list[pl.DataFrame] = []
+        indicateurs_lus: list[pl.DataFrame] = []
+        meteos: list[MeteoEntite] = []
+        for jour in jours_du_passage(self._premier_jour, ctx.date_arrete):
+            kpis.append(ctx.consultation.kpi(jour))
+            indicateurs_lus.append(ctx.consultation.indicateurs(jour))
+            meteos.extend(ctx.consultation.meteo(jour))
+            contenu = self._prevoir(
+                jour,
+                pl.concat(kpis, how="vertical"),
+                pl.concat(indicateurs_lus, how="vertical"),
+                tuple(meteos),
+            )
+            self._verifier(contenu, jour)
+            previsions.extend(contenu.previsions)
+            risques.extend(contenu.risques)
+            for prevision in contenu.previsions:
+                entree = json.dumps(
+                    {
+                        "date_arrete": prevision.date_arrete.isoformat(),
+                        "entite": prevision.entite,
+                        "horizon_jours_ouvres": prevision.horizon_jours_ouvres,
+                        "methode": prevision.methode.value,
+                    },
+                    sort_keys=True,
+                )
+                traces.append(
+                    EntreeTrace(
+                        type_trace=TypeTrace.prevision,
+                        horodatage=self._horloge(),
+                        passage_id=ctx.passage_id,
+                        date_arrete=prevision.date_arrete,
+                        entite=prevision.entite,
+                        cible=prevision.entite,
+                        version_grille=self._version_grille,
+                        version_donnees=self._version_donnees,
+                        entree_pseudonymisee=entree,
+                        sortie=prevision.model_dump_json(),
+                    )
+                )
+        return ResultatEtape(
+            StatutEtape.reussie,
+            {"previsions": ContenuPrevisions(previsions=tuple(previsions), risques=tuple(risques))},
+            tuple(traces),
+        )
+
