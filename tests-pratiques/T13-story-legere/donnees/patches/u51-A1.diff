+def test_previsions_injectees_et_traces(rapport: Rapport) -> None:
+    version = rapport.donnees.version_grille
+
+    def prevoir(
+        jour: date, k: pl.DataFrame, i: pl.DataFrame, m: tuple[MeteoEntite, ...]
+    ) -> ContenuPrevisions:
+        assert k["date"].max() == jour
+        assert i["date"].max() == jour
+        assert max(x.date_arrete for x in m) == jour
+        return ContenuPrevisions(previsions=(_prevision(jour, version),), risques=())
+
+    etape = _etape_prevision(rapport, prevoir)
+    manifeste, ecrivain = _executer(rapport, {Etape.prevision: etape})
+    repertoire = ecrivain.repertoire_publie
+    assert repertoire is not None
+    premier_jour = SourceJournal(
+        rapport.racine_sorties.parent / CHEMIN_JOURNAL
+    ).entete.ancrage_semaines
+    jours = jours_ouvres(premier_jour, DATE_ARRETE)
+    contenu = json.loads((repertoire / "previsions.json").read_text(encoding="utf-8"))["contenu"]
+    assert [p["date_arrete"] for p in contenu["previsions"]] == [j.isoformat() for j in jours]
+    lignes = (repertoire / "trace" / "previsions.jsonl").read_text(encoding="utf-8").splitlines()
+    traces = [EntreeTrace.model_validate_json(ligne) for ligne in lignes]
+    assert len(traces) == len(jours)
+    for trace in traces:
+        assert trace.type_trace is TypeTrace.prevision
+        assert trace.entite == trace.cible == "ENT-A"
+        assert trace.version_grille == manifeste.version_grille
+        assert trace.version_donnees == manifeste.version_donnees
+        assert trace.passage_id == manifeste.passage_id
+
