+FICHIERS_DETERMINISTES = (
+    "tickets_etats.parquet",
+    "tickets_textes.parquet",
+    "instantanes.parquet",
+    "kpi.parquet",
+    "indicateurs.parquet",
+    "meteo.json",
+    "tendances.parquet",
+    "previsions.json",
+)
+
+
+@pytest.fixture
+def rapport(tmp_path: Path) -> Rapport:
+    return construire_rapport(preparer_racine(tmp_path))
+
+
+def _prevision(jour: date, version_grille: str, entite: str = "ENT-A") -> Prevision:
+    return Prevision(
+        date_arrete=jour,
+        entite=entite,
+        methode=MethodePrevision.baseline,
+        statut=StatutPrevision.pas_de_sortie_projetee,
+        probabilite_numerateur=0,
+        probabilite_denominateur=1,
+        horizon_jours_ouvres=5,
+        facteurs=(),
+        version_grille=version_grille,
+    )
+
+
+def _executer(
+    rapport: Rapport, remplacements: dict[Etape, PortEtape] | None = None
+) -> tuple[ManifestePassage, EcrivainPassage]:
+    horloge = horloge_pas_a_pas()
+    ecrivain = EcrivainPassage(rapport.racine_sorties, horloge)
+    manifeste = executer_passage(
+        {**rapport.registre, **(remplacements or {})},
+        rapport.configuration,
+        DATE_ARRETE,
+        ecrivain,
+        ConsultationPassage,
+        horloge,
+        lambda: "abc123",
+        rapport.donnees,
+    )
+    return manifeste, ecrivain
+
+
+def _etape_prevision(rapport: Rapport, prevoir) -> EtapePrevision:  # type: ignore[no-untyped-def]
+    premier_jour = SourceJournal(
+        rapport.racine_sorties.parent / CHEMIN_JOURNAL
+    ).entete.ancrage_semaines
+    return EtapePrevision(
+        prevoir,
+        rapport.donnees.version_grille,
+        rapport.donnees.version_donnees,
+        premier_jour,
+        horloge_pas_a_pas(),
+    )
+
+
+def test_passage_complet_et_dates(rapport: Rapport) -> None:
+    _, ecrivain = _executer(rapport)
+    repertoire = ecrivain.repertoire_publie
+    assert repertoire is not None
+    for nom in FICHIERS_DETERMINISTES:
+        assert (repertoire / nom).exists(), nom
+    consultation = ConsultationPassage(repertoire)
+    premier_jour = SourceJournal(
+        rapport.racine_sorties.parent / CHEMIN_JOURNAL
+    ).entete.ancrage_semaines
+    attendu = set(jours_ouvres(premier_jour, DATE_ARRETE))
+    assert set(pl.read_parquet(repertoire / "kpi.parquet")["date"]) == attendu
+    assert set(pl.read_parquet(repertoire / "indicateurs.parquet")["date"]) == attendu
+    meteos = json.loads((repertoire / "meteo.json").read_text(encoding="utf-8"))["contenu"]
+    assert {date.fromisoformat(m["date_arrete"]) for m in meteos} == attendu
+    assert consultation.tendances().height > 0
+    assert consultation.previsions() is not None
+
+
+def test_kpi_et_tendances_sans_recalcul(rapport: Rapport) -> None:
+    _, ecrivain = _executer(rapport)
+    repertoire = ecrivain.repertoire_publie
+    assert repertoire is not None
+    premier_jour = SourceJournal(
+        rapport.racine_sorties.parent / CHEMIN_JOURNAL
+    ).entete.ancrage_semaines
+    assert rapport.configuration.programme is not None
+    entites = [e.code for e in rapport.configuration.programme.entites]
+    etats = pl.concat(
+        [
+            pl.read_parquet(repertoire / "tickets_etats.parquet").filter(pl.col("date") == jour)
+            for jour in jours_ouvres(premier_jour, DATE_ARRETE)
+        ]
+    )
+    attendu = kpi(etats, entites)
+    assert pl.read_parquet(repertoire / "kpi.parquet").equals(attendu)
+    assert pl.read_parquet(repertoire / "tendances.parquet").equals(
+        tendances(attendu, DATE_ARRETE, premier_jour)
+    )
