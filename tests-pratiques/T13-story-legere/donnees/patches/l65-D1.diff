+    def preload(self, context: Context) -> None:
+        """Écrit le Contexte dans le cache de prompt (CAG) : même system que `generate`,
+        réponse minimale. Sans `cache_system`, il n'y a rien à précharger."""
+        if not self._cache_system:
+            raise WlError("`preload` exige `cache_system: true`")
+        requete = LLMRequest(
+            model_id=self.model_id,
+            role="generate",
+            step="cag.preload",
