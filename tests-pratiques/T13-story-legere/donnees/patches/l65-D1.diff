+            cache_system=True,
+            messages=(Message(role="user", content="Préchargement du contexte : réponds OK."),),
+            max_tokens=1,
+            seed=self._ctx.seed,
+            inputs={"question": "", "blocks": self._blocs(context)},
+        )
+        self._ctx.gateway.complete(requete)
+
