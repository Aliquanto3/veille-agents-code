+"""Annotations humaines (contracts §4.6) : chargement et rapprochement avec les Réponses."""
+
+import json
+import logging
+from collections.abc import Collection, Mapping
+from pathlib import Path
+from typing import Any
+
+from wavelibrarian.config.defaults import charger_yaml
+from wavelibrarian.core.errors import ConfigError
+
+log = logging.getLogger(__name__)
+
+CRITERES = ("correctness", "completeness", "faithfulness")
+VERDICTS = {"yes": True, "no": False}
+
+# (annotateur, answer_id, critère) -> verdict
+Annotations = dict[tuple[str, str, str], bool]
+
+
+def _champ_texte(entree: Any, cle: str, chemin: str) -> str:
+    valeur = entree.get(cle) if isinstance(entree, dict) else None
+    if not isinstance(valeur, str) or not valeur:
+        raise ConfigError(f"{chemin}.{cle}" if chemin else cle, "chaîne non vide attendue")
+    return valeur
+
+
+def charger_fichier(chemin: Path) -> Annotations:
+    """Charge `annotations/<annotateur>.yaml`."""
+    doc = charger_yaml(chemin)
+    if not isinstance(doc, dict):
+        raise ConfigError("annotator", f"{chemin} : mapping attendu")
+    annotateur = _champ_texte(doc, "annotator", "")
+    liste = doc.get("annotations")
+    if not isinstance(liste, list):
+        raise ConfigError("annotations", f"{chemin} : liste attendue")
+    resultat: Annotations = {}
+    for i, entree in enumerate(liste):
+        base = f"annotations[{i}]"
+        answer_id = _champ_texte(entree, "answer_id", base)
+        critere = _champ_texte(entree, "criterion", base)
+        if critere not in CRITERES:
+            raise ConfigError(
+                f"{base}.criterion",
+                f"{chemin} : Critère {critere!r} inconnu (attendus : {', '.join(CRITERES)})",
+            )
+        verdict = entree.get("verdict")
+        # YAML 1.1 lit `yes`/`no` non guillemetés comme des booléens : on les accepte tels quels.
+        if isinstance(verdict, bool):
+            booleen = verdict
+        elif isinstance(verdict, str) and verdict in VERDICTS:
+            booleen = VERDICTS[verdict]
+        else:
+            raise ConfigError(f"{base}.verdict", f"{chemin} : verdict {verdict!r} hors de yes/no")
+        cle = (annotateur, answer_id, critere)
+        if cle in resultat:
+            raise ConfigError(
+                base, f"{chemin} : doublon pour {answer_id!r} et le Critère {critere!r}"
+            )
+        resultat[cle] = booleen
+    return resultat
+
+
+def charger_dossier(dossier: Path) -> Annotations:
+    """Charge tous les `*.yaml` d'un dossier `annotations/`."""
+    resultat: Annotations = {}
+    for chemin in sorted(Path(dossier).glob("*.yaml")):
+        fichier = charger_fichier(chemin)
+        if any(cle in resultat for cle in fichier):
+            raise ConfigError(
+                "annotator", f"{chemin} : annotateur déjà déclaré dans un autre fichier"
+            )
+        resultat.update(fichier)
+    return resultat
+
+
+def answer_ids_de_answers_jsonl(chemin: Path) -> set[str]:
+    """Ensemble des `answer_id` d'un `answers.jsonl`."""
+    try:
+        lignes = Path(chemin).read_text(encoding="utf-8").splitlines()
+    except OSError as exc:
+        raise ConfigError(str(chemin), f"fichier illisible : {exc}") from exc
+    ids: set[str] = set()
+    for numero, ligne in enumerate(lignes, start=1):
+        if not ligne.strip():
+            continue
+        try:
+            ids.add(json.loads(ligne)["answer_id"])
+        except (json.JSONDecodeError, KeyError, TypeError) as exc:
+            raise ConfigError(f"{chemin}:{numero}", f"ligne sans answer_id valide : {exc}") from exc
+    return ids
+
+
+def rapprocher(
+    annotations: Mapping[tuple[str, str, str], bool], answer_ids: Collection[str]
+) -> tuple[Annotations, list[str]]:
+    """Garde les annotations dont l'`answer_id` existe ; renvoie aussi les `answer_id` ignorés."""
+    connus = set(answer_ids)
+    retenues: Annotations = {}
+    ignores: list[str] = []
+    for cle, verdict in annotations.items():
+        if cle[1] in connus:
+            retenues[cle] = verdict
+        elif cle[1] not in ignores:
+            ignores.append(cle[1])
+    for answer_id in ignores:
+        log.warning("annotation ignorée : answer_id absent d'answers.jsonl : %s", answer_id)
+    return retenues, ignores
