@@ -0,0 +1,82 @@
+"""Story 5.1 : annotations humaines et kappa de Cohen."""
+
+import json
+from pathlib import Path
+
+import pytest
+
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.scoring.calibration import (
+    answer_ids_de_answers_jsonl,
+    charger_dossier,
+    rapprocher,
+)
+from wavelibrarian.stats.kappa import cohen_kappa
+
+AID = "20261018-031500-a1b2c3/naive-haiku/standard/all/base/q-001"
+
+
+def _fichier(dossier: Path, nom: str, annotations: list[dict]) -> None:
+    lignes = [f"annotator: {nom}", "annotations:"]
+    for a in annotations:
+        lignes.append(f'  - answer_id: "{a["answer_id"]}"')
+        lignes.append(f"    criterion: {a['criterion']}")
+        lignes.append(f"    verdict: {a['verdict']}")
+    (dossier / f"{nom}.yaml").write_text("\n".join(lignes) + "\n", encoding="utf-8")
+
+
+def _ann(critere="correctness", verdict="yes", answer_id=AID) -> dict:
+    return {"answer_id": answer_id, "criterion": critere, "verdict": verdict}
+
+
+def test_chargement_indexe(tmp_path: Path) -> None:
+    _fichier(tmp_path, "anael", [_ann(), _ann("faithfulness", "no")])
+    _fichier(tmp_path, "collegue", [_ann(verdict="no")])
+    res = charger_dossier(tmp_path)
+    assert res[("anael", AID, "correctness")] is True
+    assert res[("anael", AID, "faithfulness")] is False
+    assert res[("collegue", AID, "correctness")] is False
+
+
+@pytest.mark.parametrize(
+    ("annotations", "chemin"),
+    [
+        ([_ann(), _ann("completeness"), _ann("citation_correctness")], "annotations[2].criterion"),
+        (
+            [_ann(), _ann("completeness"), _ann("faithfulness"), _ann(verdict="maybe")],
+            "annotations[3].verdict",
+        ),
+        ([_ann(), _ann()], "annotations[1]"),
+    ],
+)
+def test_erreurs(tmp_path: Path, annotations: list[dict], chemin: str) -> None:
+    _fichier(tmp_path, "anael", annotations)
+    with pytest.raises(ConfigError) as exc:
+        charger_dossier(tmp_path)
+    assert exc.value.path == chemin
+
+
+def test_rapprochement(tmp_path: Path) -> None:
+    jsonl = tmp_path / "answers.jsonl"
+    jsonl.write_text(json.dumps({"answer_id": AID}) + "\n\n", encoding="utf-8")
+    ids = answer_ids_de_answers_jsonl(jsonl)
+    assert ids == {AID}
+    annotations = {("a", AID, "correctness"): True, ("a", "inconnu", "correctness"): False}
+    retenues, ignores = rapprocher(annotations, ids)
+    assert retenues == {("a", AID, "correctness"): True}
+    assert ignores == ["inconnu"]
+
+
+def test_kappa_table_connue() -> None:
+    a = [True] * 25 + [False] * 25
+    b = [True] * 20 + [False] * 5 + [True] * 10 + [False] * 15
+    # po = 35/50 = 0,7 ; pe = 0,5 * 0,6 + 0,5 * 0,4 = 0,5 ; kappa = 0,2 / 0,5
+    assert cohen_kappa(a, b) == pytest.approx(0.4, abs=1e-12)
+
+
+def test_kappa_cas_limites() -> None:
+    v = [True, False, True, True]
+    assert cohen_kappa(v, v) == 1.0
+    assert cohen_kappa([True] * 3, [True] * 3) is None
+    with pytest.raises(ValueError):
+        cohen_kappa([True], [True, False])
