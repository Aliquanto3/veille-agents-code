@@ -0,0 +1,23 @@
+"""Kappa de Cohen entre deux vecteurs binaires (fonction pure, AD-22)."""
+
+from collections.abc import Sequence
+
+
+def cohen_kappa(a: Sequence[bool], b: Sequence[bool]) -> float | None:
+    """Kappa de Cohen de deux annotateurs binaires.
+
+    Renvoie `None` quand il est indéfini (vecteurs vides, ou accord attendu égal à 1 : une seule
+    classe chez les deux). Lève `ValueError` si les longueurs diffèrent.
+    """
+    if len(a) != len(b):
+        raise ValueError(f"longueurs différentes : {len(a)} et {len(b)}")
+    n = len(a)
+    if n == 0:
+        return None
+    observe = sum(1 for x, y in zip(a, b, strict=True) if x == y) / n
+    pa = sum(1 for x in a if x) / n
+    pb = sum(1 for y in b if y) / n
+    attendu = pa * pb + (1 - pa) * (1 - pb)
+    if attendu == 1:
+        return None
+    return (observe - attendu) / (1 - attendu)
