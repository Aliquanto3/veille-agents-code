diff --git a/tests/unit/chaine/test_etapes_deterministes.py b/tests/unit/chaine/test_etapes_deterministes.py
new file mode 100644
index 0000000..68bb93e
--- /dev/null
+++ b/tests/unit/chaine/test_etapes_deterministes.py
@@ -0,0 +1,107 @@
+"""`EtapeKpi` et `EtapePrevision` : KPI et Tendances du Passage, traces des Prévisions."""
+
+from datetime import date
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.chaine.environnement import DATE_ARRETE, INSTANT, preparer_racine
+from usine.chaine.etapes import EtapeKpi, EtapePrevision
+from usine.composition import construire_rapport
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigUsine
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.passage import ContextePassage, StatutEtape
+from usine.contrats.prevision import (
+    ContenuPrevisions,
+    FacteurExplicatif,
+    MethodePrevision,
+    Prevision,
+    StatutPrevision,
+)
+from usine.contrats.tickets import SCHEMA_TICKET_ETAT
+from usine.contrats.trace import TypeTrace
+from usine.ports.consultation import Consultation
+
+PREMIER = date(2026, 8, 17)
+
+
+class ConsultationFixe:
+    """Consultation minimale : l'état des tickets de chaque jour est donné."""
+
+    def __init__(self, etats: dict[date, pl.DataFrame]) -> None:
+        self._etats = etats
+
+    def tickets_etats(self, date_arrete: date | None = None) -> pl.DataFrame:
+        assert date_arrete is not None
+        return self._etats[date_arrete]
+
+
+def _contexte(
+    consultation: ConsultationFixe | None, configuration: ConfigUsine, jour: date
+) -> ContextePassage[Consultation]:
+    return ContextePassage(
+        jour,
+        "20261012T073000Z-abc123",
+        configuration,
+        consultation,  # type: ignore[arg-type]
+    )
+
+
+@pytest.fixture
+def configuration(tmp_path: Path) -> ConfigUsine:
+    return construire_rapport(preparer_racine(tmp_path)).configuration
+
+
+def _prevision() -> Prevision:
+    return Prevision(
+        date_arrete=DATE_ARRETE,
+        entite="ENT-A",
+        methode=MethodePrevision.baseline,
+        statut=StatutPrevision.pas_de_sortie_projetee,
+        probabilite_numerateur=0,
+        probabilite_denominateur=1,
+        horizon_jours_ouvres=10,
+        facteurs=(FacteurExplicatif(nom="stock", libelle="Stock", numerateur=3, denominateur=1),),
+        version_grille="abcdef012345",
+    )
+
+
+def test_prevision_une_trace_par_prevision(configuration: ConfigUsine) -> None:
+    contenu = ContenuPrevisions(previsions=(_prevision(), _prevision()), risques=())
+    etape = EtapePrevision(lambda ctx: contenu, "abcdef012345", "fedcba543210", lambda: INSTANT)
+    resultat = etape.executer(_contexte(None, configuration, DATE_ARRETE))
+    assert resultat.statut is StatutEtape.reussie
+    assert resultat.sorties == {"previsions": contenu}
+    assert len(resultat.traces) == 2
+    for trace in resultat.traces:
+        assert trace.type_trace is TypeTrace.prevision
+        assert trace.entite == "ENT-A"
+        assert (trace.version_grille, trace.version_donnees) == ("abcdef012345", "fedcba543210")
+        assert trace.passage_id == "20261012T073000Z-abc123"
+        assert Prevision.model_validate_json(trace.sortie) == _prevision()
+
+
+def test_prevision_sans_prevision(configuration: ConfigUsine) -> None:
+    contenu = ContenuPrevisions(previsions=(), risques=())
+    etape = EtapePrevision(lambda ctx: contenu, "abcdef012345", "fedcba543210")
+    resultat = etape.executer(_contexte(None, configuration, DATE_ARRETE))
+    assert resultat.traces == ()
+    assert resultat.sorties["previsions"] == contenu
+
+
+def test_kpi_couvre_chaque_jour_ouvre(configuration: ConfigUsine) -> None:
+    vide = pl.DataFrame(schema=dict(SCHEMA_TICKET_ETAT.colonnes))
+    consultation = ConsultationFixe({jour: vide for jour in jours_ouvres(PREMIER, DATE_ARRETE)})
+    resultat = EtapeKpi(["ENT-A", "ENT-B"], PREMIER).executer(
+        _contexte(consultation, configuration, DATE_ARRETE)
+    )
+    assert resultat.statut is StatutEtape.reussie
+    assert set(resultat.sorties) == {"kpi", "tendances"}
+
+
+def test_kpi_date_anterieure_a_l_historique(configuration: ConfigUsine) -> None:
+    ctx = _contexte(ConsultationFixe({}), configuration, date(2026, 8, 14))
+    with pytest.raises(UsineErreur, match="antérieure"):
+        EtapeKpi(["ENT-A"], PREMIER).executer(ctx)
