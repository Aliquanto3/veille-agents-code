+def cle_renumerotee(cle: str) -> str:
+    """`DEMO-n` → `DEMO-(n+1000)` : renumérotation type d'une injection."""
+    projet, numero = cle.rsplit("-", 1)
+    return f"{projet}-{int(numero) + 1000}"
+
+
+def manifeste_renumerotant(evenements: tuple[Evenement, ...]) -> ManifesteInjection:
+    """Manifeste qui renumérote chaque clé des `evenements` (projet `DEMO`)."""
+    cles = sorted({evenement.cle_ticket for evenement in evenements})
+    return ManifesteInjection(
+        date_injection=date(2026, 10, 12),
+        debut_injection=T0,
+        horodatage_fin_injection=T0 + timedelta(hours=1),
+        cle_projet="DEMO",
+        correspondance_cles={cle: cle_renumerotee(cle) for cle in cles},
+    )
+
+
+def evenements_renumerotes(evenements: tuple[Evenement, ...]) -> tuple[Evenement, ...]:
+    """`evenements` dont seule `cle_ticket` est renumérotée."""
+    return tuple(
+        e.model_copy(update={"cle_ticket": cle_renumerotee(e.cle_ticket)}) for e in evenements
+    )
+
+
+def fabrique_journal_correspondance() -> CasSourceTickets:
+    """`SourceJournal` du mini-générateur avec manifeste : flux attendu à clés Jira."""
+    config = charger_yaml(
+        Path(__file__).resolve().parents[3] / "tests/unit/generateur/programme_reduit.yaml",
+        ConfigProgramme,
+    )
+    generation = generer(config, 42, date(2026, 10, 12))
+    repertoire = Path(tempfile.mkdtemp(prefix="usine-journal-"))
+    atexit.register(shutil.rmtree, repertoire, True)
+    chemin = repertoire / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generation))
+    manifeste = manifeste_renumerotant(generation.evenements)
+    return CasSourceTickets(
+        SourceJournal(chemin, manifeste), evenements_renumerotes(generation.evenements)
+    )
+
+
