diff --git a/tests/unit/ui/test_outillage.py b/tests/unit/ui/test_outillage.py
new file mode 100644
index 0000000..2ec851d
--- /dev/null
+++ b/tests/unit/ui/test_outillage.py
@@ -0,0 +1,50 @@
+"""Écran « Ce qu'il faut pour le faire en vrai » : fiche `docs/` lue telle quelle."""
+
+from pathlib import Path
+
+import pytest
+from streamlit.testing.v1 import AppTest
+
+from usine.ui import outillage
+from usine.ui.navigation import Ecran
+
+DEPOT = Path(outillage.__file__).parents[3]
+APP = Path(outillage.__file__).parent / "app.py"
+
+
+def test_lire_fiche_du_depot() -> None:
+    assert outillage.lire_fiche(DEPOT) == (DEPOT / outillage.FICHIER_FICHE).read_text("utf-8")
+
+
+def test_lire_fiche_absente(tmp_path: Path) -> None:
+    assert outillage.lire_fiche(tmp_path) == outillage.FICHE_ABSENTE
+
+
+def test_lire_fiche_illisible(tmp_path: Path) -> None:
+    (tmp_path / "docs").mkdir()
+    (tmp_path / outillage.FICHIER_FICHE).write_bytes(b"\xff\xfe\x00")
+    assert outillage.lire_fiche(tmp_path) == outillage.FICHE_ABSENTE
+
+
+def _page(racine: Path, monkeypatch: pytest.MonkeyPatch) -> AppTest:
+    monkeypatch.setenv("USINE_RACINE", str(racine))
+    page = AppTest.from_file(str(APP), default_timeout=60).run()
+    page.sidebar.radio[0].set_value(Ecran.outillage.value).run()
+    return page
+
+
+def test_ecran_affiche_la_fiche(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    (tmp_path / "docs").mkdir()
+    (tmp_path / outillage.FICHIER_FICHE).write_text("# Fiche\n\nContenu *unique*.", "utf-8")
+    page = _page(tmp_path, monkeypatch)
+    assert not page.exception
+    assert page.subheader[0].value == Ecran.outillage.value
+    assert "# Fiche\n\nContenu *unique*." in [str(m.value) for m in page.markdown]
+    assert page.caption[-1].value == outillage.LEGENDE
+    assert not page.button  # lecture seule
+
+
+def test_ecran_fiche_absente(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    page = _page(tmp_path, monkeypatch)
+    assert not page.exception
+    assert page.warning[-1].value == outillage.FICHE_ABSENTE
