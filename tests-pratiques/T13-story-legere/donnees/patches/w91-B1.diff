+def _announce_url(url: str) -> None:
+    """Repli : l'URL va sur la console et dans le journal."""
+    print(f"wavelocalai-v2 : ouvrez {url}")
+    logger.warning("Navigateur non ouvert ; l'application est sur %s", url)
+
+
+def _server_answers(url: str) -> bool:
+    try:
+        with urllib.request.urlopen(url, timeout=1.0):  # noqa: S310
+            return True
+    except urllib.error.HTTPError:
+        return True  # toute réponse HTTP vaut « prêt »
+    except (OSError, ValueError):
+        return False
+
+
+def _open_browser_when_ready(
+    port: int, *, timeout_s: float = 30.0, interval_s: float = 0.1
+) -> bool:
+    """Ouvre le navigateur une fois que le serveur répond en HTTP ; rend `True` si ouvert.
+
+    Sans réponse à temps, sans affichage ou si l'ouverture échoue, l'URL est écrite sur la
+    console et dans le journal ; aucune exception ne sort.
+    """
+    url = f"http://127.0.0.1:{port}/"
+    try:
+        deadline = time.monotonic() + timeout_s
+        while not _server_answers(url):
+            if time.monotonic() >= deadline:
+                _announce_url(url)
+                return False
+            time.sleep(interval_s)
+        if not has_display():
+            _announce_url(url)
+            return False
+        if webbrowser.open(url):
+            return True
+    except (webbrowser.Error, OSError):
+        pass
+    _announce_url(url)
+    return False
+
+
