+# --- ouverture du navigateur (story 9.1) ---
+
+
+@pytest.fixture
+def http_server():
+    """Petit serveur HTTP local ; rend son port."""
+    import http.server
+    import threading
+
+    class Handler(http.server.BaseHTTPRequestHandler):
+        def do_GET(self):
+            self.send_response(404)  # tout statut vaut « prêt »
+            self.send_header("Content-Length", "0")
+            self.end_headers()
+
+        def log_message(self, *args):
+            pass
+
+    server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    yield server.server_address[1]
+    server.shutdown()
+    server.server_close()
+
+
+def test_opens_the_browser_once_when_the_server_answers(monkeypatch, http_server):
+    import webbrowser
+
+    from wavelocalai.__main__ import _open_browser_when_ready
+
+    calls = []
+    monkeypatch.setattr(webbrowser, "open", lambda url: calls.append(url) or True)
+    assert _open_browser_when_ready(http_server, timeout_s=5) is True
+    assert calls == [f"http://127.0.0.1:{http_server}/"]
+
+
+def test_does_not_open_before_the_server_answers(monkeypatch, capsys):
+    import webbrowser
+
+    from wavelocalai.__main__ import _open_browser_when_ready
+
+    calls = []
+    monkeypatch.setattr(webbrowser, "open", lambda url: calls.append(url) or True)
+    port = closed_port()
+    assert _open_browser_when_ready(port, timeout_s=0.3, interval_s=0.05) is False
+    assert calls == []
+    assert f"http://127.0.0.1:{port}/" in capsys.readouterr().out
+
+
+@pytest.mark.parametrize("failure", ["false", "error", "oserror"])
+def test_falls_back_to_the_url_when_opening_fails(
+    monkeypatch, http_server, capsys, caplog, failure
+):
+    import webbrowser
+
+    from wavelocalai.__main__ import _open_browser_when_ready
+
+    def fake_open(url):
+        if failure == "error":
+            raise webbrowser.Error("pas de navigateur")
+        if failure == "oserror":
+            raise OSError("échec")
+        return False
+
+    monkeypatch.setattr(webbrowser, "open", fake_open)
+    with caplog.at_level("WARNING", logger="wavelocalai"):
+        assert _open_browser_when_ready(http_server, timeout_s=5) is False
+    url = f"http://127.0.0.1:{http_server}/"
+    assert url in capsys.readouterr().out
+    assert url in caplog.text
+
+
+def test_falls_back_without_display(monkeypatch, http_server, capsys):
+    import webbrowser
+
+    from wavelocalai import __main__ as launcher
+
+    calls = []
+    monkeypatch.setattr(webbrowser, "open", lambda url: calls.append(url) or True)
+    monkeypatch.setattr(launcher.sys, "platform", "linux")
+    monkeypatch.delenv("DISPLAY", raising=False)
+    monkeypatch.delenv("WAYLAND_DISPLAY", raising=False)
+    assert launcher._open_browser_when_ready(http_server, timeout_s=5) is False
+    assert calls == []
+    assert f"http://127.0.0.1:{http_server}/" in capsys.readouterr().out
+
+
+def _run_main_with_fake_serve(monkeypatch, tmp_path, extra):
+    """Lance `main` (serve remplacé) ; rend le port et les ports passés à l'ouverture différée."""
+    import threading
+
+    from wavelocalai import __main__ as launcher
+    from wavelocalai.web import server
+
+    calls: list[int] = []
+    called = threading.Event()
+
+    def fake_open(port):
+        calls.append(port)
+        called.set()
+        return True
+
+    monkeypatch.setattr(server, "serve", lambda *a, **k: None)
+    monkeypatch.setattr(launcher, "_open_browser_when_ready", fake_open)
+    port = closed_port()
+    code = main(["--port", str(port), "--data-dir", str(tmp_path / "data"), *extra])
+    assert code == 0
+    called.wait(1.0)  # le thread daemon part depuis main ; on lui laisse le temps de passer
+    return port, calls
+
+
+def test_main_starts_one_browser_thread_by_default(monkeypatch, tmp_path):
+    port, calls = _run_main_with_fake_serve(monkeypatch, tmp_path, [])
+    assert calls == [port]
+
+
+def test_main_starts_no_browser_thread_with_no_browser(monkeypatch, tmp_path):
+    _, calls = _run_main_with_fake_serve(monkeypatch, tmp_path, ["--no-browser"])
+    assert calls == []
