index 0000000..1fa5f5f
--- /dev/null
+++ b/tests/unit/architectures/test_story_6_5.py
@@ -0,0 +1,196 @@
+"""Story 6.5 : Architecture `cag` (Corpus préchargé dans le cache de prompt)."""
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+
+from wavelibrarian import registry
+from wavelibrarian.architectures.cag import Cag
+from wavelibrarian.architectures.long_context import LongContext
+from wavelibrarian.config.validate import validate_file
+from wavelibrarian.core.errors import ConfigError, WlError
+from wavelibrarian.core.types import CorpusProfile, ParsedCorpus, QuestionInput
+from wavelibrarian.llm.providers.fake import FakeProvider, default_output
+from wavelibrarian.ports.components import ComponentSpec
+from wavelibrarian.ports.gateway import LLMRequest
+from wavelibrarian.runner.context import Context as RunCtx
+from wavelibrarian.runner.index_cache import IndexCache
+
+RACINE = Path(__file__).resolve().parents[3] / "corpora" / "minicorpus"
+_GEN = {"name": "llm", "params": {"model": "fake-llm-a"}}
+
+
+@pytest.fixture
+def ctx(tmp_path: Path):  # type: ignore[no-untyped-def]
+    provider = FakeProvider()
+    c = RunCtx.from_profile(
+        "test", wl_home=tmp_path / "wl", run_id="r-1", seed=1, providers={"fake": provider}
+    )
+    c.parser = "markdown"  # parser concret (jamais `auto`) pour la clé d'index
+    c.provider = provider  # type: ignore[attr-defined]
+    with c:
+        yield c
+
+
+def _arch(ctx: RunCtx, **params: Any) -> Any:
+    return ctx.build("architecture", ComponentSpec(name="cag", params=params))
+
+
+def _espionner(ctx: RunCtx) -> list[LLMRequest]:
+    vues: list[LLMRequest] = []
+
+    def sortie(req: LLMRequest) -> str:
+        vues.append(req)
+        return default_output("generate", req.inputs)
+
+    ctx.provider.script("generate", "*", sortie)  # type: ignore[attr-defined]
+    return vues
+
+
+def _construire(ctx: RunCtx, corpus: ParsedCorpus) -> Any:
+    arch, _ = IndexCache(ctx.wl_home).build(ctx, lambda: _arch(ctx, generator=_GEN), corpus)
+    return arch
+
+
+def _spans(ctx: RunCtx) -> list[dict[str, Any]]:
+    texte = (ctx.run_dir / "traces.jsonl").read_text(encoding="utf-8")
+    return [json.loads(ligne) for ligne in texte.splitlines()]
+
+
+def _profil(n_tokens: int) -> CorpusProfile:
+    return CorpusProfile(
+        corpus_id="c",
+        fingerprint="f",
+        parser="markdown",
+        tokenizer="approx",
+        n_documents=1,
+        n_tokens=n_tokens,
+        mean_tokens_per_document=float(n_tokens),
+        heading_depth_max=1,
+        heading_depth_mean=1.0,
+        link_density=0.0,
+        table_share=0.0,
+        images_per_document=0.0,
+        dominant_lang="fr",
+        langs={"fr": 1},
+        formats={"markdown": 1},
+        volatility="low",
+    )
+
+
+def test_cag_enregistree_avec_ses_capacites() -> None:
+    assert registry.get("architecture", "cag") is Cag
+    assert issubclass(Cag, LongContext)
+    assert Cag.capabilities.requires_prompt_cache is True
+    assert Cag.capabilities.full_corpus_in_prompt is True
+    assert Cag.capabilities.retrieval_method == "cited"
+
+
+def test_index_un_bloc_par_ancrage_et_ids_sales(
+    ctx: RunCtx, minicorpus: ParsedCorpus, tmp_path: Path
+) -> None:
+    from wavelibrarian.architectures._passages import lire_passages
+
+    cag = _arch(ctx, generator=_GEN)
+    lc = ctx.build("architecture", ComponentSpec(name="long_context", params={}))
+    cag.index(minicorpus, tmp_path / "cag")
+    lc.index(minicorpus, tmp_path / "lc")
+    passages = lire_passages(tmp_path / "cag")
+    assert passages and all(len(p.anchor_ids) == 1 for p in passages)
+    ids_lc = {p.passage_id for p in lire_passages(tmp_path / "lc")}
+    assert not ids_lc & {p.passage_id for p in passages}
+
+
+def test_precharge_au_poste_indexing_index_construit_puis_servi(
+    ctx: RunCtx, minicorpus: ParsedCorpus
+) -> None:
+    vues = _espionner(ctx)
+    arch = _construire(ctx, minicorpus)  # index construit
+    assert len(vues) == 1
+    pre = vues[0]
+    assert pre.step == "preload" and pre.cache_system is True
+    for bloc in arch._contexte.blocks:  # pyright: ignore[reportPrivateUsage]
+        assert bloc.split(") ", 1)[-1] in pre.system
+    _construire(ctx, minicorpus)  # index servi par le cache : `load` précharge à nouveau
+    # (la passerelle peut rejouer la réponse de son cache : le span, lui, est bien émis)
+    llm = [s for s in _spans(ctx) if s.get("wl.kind") == "llm"]
+    assert [s["wl.step"] for s in llm] == ["preload", "preload"]
+    assert all(s["wl.post"] == "indexing" for s in llm)
+
+
+def test_seconde_question_lit_le_cache_et_reponse_cited(
+    ctx: RunCtx, minicorpus: ParsedCorpus
+) -> None:
+    arch = _construire(ctx, minicorpus)
+    reponses = []
+    for n in (1, 2):
+        with ctx.scope(post="query", question_id=f"q-{n}"):
+            reponses.append(
+                arch.answer(QuestionInput(question_id=f"q-{n}", text="Guilde Orvane ?", lang="fr"))
+            )
+    assert all(r.retrieval_method == "cited" for r in reponses)
+    par_question = {
+        s["wl.question_id"]: s
+        for s in _spans(ctx)
+        if s.get("wl.kind") == "llm" and s["wl.post"] == "query"
+    }
+    seconde = par_question["q-2"]
+    assert seconde["wl.usage.cache_read_tokens"] > 0
+    assert "gen_ai.usage.input_tokens" in seconde  # tracé à part des tokens en cache
+
+
+def test_petit_corpus_precharge_sans_erreur(ctx: RunCtx, minicorpus: ParsedCorpus) -> None:
+    # Le Faux LLM ne lit rien au premier appel : tokens en cache nuls, sans erreur.
+    arch = _construire(ctx, minicorpus)
+    assert arch is not None
+    premier = [s for s in _spans(ctx) if s.get("wl.kind") == "llm"][0]
+    assert premier["wl.usage.cache_read_tokens"] == 0
+
+
+def test_generator_autre_que_llm_refuse(ctx: RunCtx) -> None:
+    with pytest.raises(ConfigError):
+        _arch(ctx, generator={"name": "perfect", "params": {}})
+
+
+def test_modele_sans_cache_de_prompt_refuse_avant_tout_appel(tmp_path: Path) -> None:
+    donnees = {
+        "experiment_id": "exp-6-5",
+        "seed": 1,
+        "profile": "test",
+        "corpus": str(RACINE / "corpus.yaml"),
+        "questions": str(RACINE / "questions.yaml"),
+        "split": "dev",
+        "configurations": [
+            {
+                "id": "cag",
+                "architecture": "cag",
+                "params": {"generator": {"name": "llm", "params": {"model": "qwen3.5:4b"}}},
+            }
+        ],
+    }
+    chemin = tmp_path / "exp.yaml"
+    chemin.write_text(yaml.safe_dump(donnees, allow_unicode=True), encoding="utf-8")
+    with pytest.raises(WlError) as exc:
+        validate_file(chemin, tmp_path / "wl")
+    assert "prompt_cache" in str(exc.value)
+
+
+def test_inapplicable_au_dela_du_palier_haiku_sans_appel(ctx: RunCtx) -> None:
+    vues = _espionner(ctx)
+    arch = _arch(ctx, generator={"name": "llm", "params": {"model": "claude-haiku-5-5"}})
+    res = arch.check(_profil(80_000))  # 80 000 x 1,5 = 120 000 tokens estimés
+    assert res.applicable is False
+    assert res.reason is not None and "palier" in res.reason and "100000" in res.reason
+    assert vues == []
+
+
+def test_inapplicable_au_dela_de_la_fenetre_sans_appel(ctx: RunCtx) -> None:
+    vues = _espionner(ctx)
+    arch = _arch(ctx, generator=_GEN)
+    res = arch.check(_profil(120_000))
+    assert res.applicable is False
+    assert res.reason is not None and "fenêtre" in res.reason
+    assert vues == []
