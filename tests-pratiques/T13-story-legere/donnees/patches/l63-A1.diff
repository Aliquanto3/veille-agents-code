+"""Architecture `hyde` : recherche dense avec le vecteur d'une réponse hypothétique (FR-20)."""
+
+from typing import Annotated, Any, ClassVar
+
+import numpy as np
+from numpy.typing import NDArray
+from pydantic import Field
+
+from wavelibrarian.architectures.naive_rag import NaiveRag
+from wavelibrarian.components.context import build_arch_answer
+from wavelibrarian.core.types import ArchAnswer, ModelRefMeta, QuestionInput
+from wavelibrarian.ports.gateway import LLMRequest, Message
+from wavelibrarian.registry import register
+
+_SYSTEM = (
+    "Rédige un court passage de document qui répondrait à la question, dans la langue de la "
+    "question, comme s'il en était extrait. Écris directement le passage, sans préambule ni "
+    "commentaire. Si tu n'es pas sûr des faits, reste plausible : ce texte ne sert qu'à la "
+    "recherche et ne sera jamais montré."
+)
+
+
+@register("architecture", "hyde")
+class Hyde(NaiveRag):
+    """Même index que `naive_rag` ; la recherche utilise l'embedding d'une réponse hypothétique,
+    éventuellement moyenné avec celui de la Question. Contexte et génération sont inchangés."""
+
+    name = "hyde"
+    query_params: ClassVar[frozenset[str]] = frozenset(
+        {"k", "mix_question", "hyde_model", "hyde_max_tokens"}
+    )
+
+    class Params(NaiveRag.Params):
+        mix_question: bool = False
+        hyde_model: Annotated[str | None, ModelRefMeta("generator_models[0]")] = None
+        hyde_max_tokens: int = Field(default=256, gt=0)
+
+    def __init__(self, params: Any, ctx: Any) -> None:
+        super().__init__(params, ctx)
+        self.hyde_model_id: str = params.hyde_model or ctx.profile.defaults.generator_models[0]
+
+    def _hypothese(self, question: QuestionInput) -> str:
+        """Réponse hypothétique : un appel `complete` au rôle `hyde` (span de la passerelle)."""
+        requete = LLMRequest(
+            model_id=self.hyde_model_id,
+            role="hyde",
+            step="hyde",
+            system=_SYSTEM,
+            messages=(Message(role="user", content=question.text),),
+            max_tokens=self.params.hyde_max_tokens,  # type: ignore[attr-defined]
+            seed=self.ctx.seed,  # type: ignore[attr-defined]
+            inputs={"text": question.text},
+        )
+        return str(self.ctx.gateway.complete(requete).text)  # type: ignore[attr-defined]
+
+    def _vecteur(self, question: QuestionInput) -> NDArray[np.float32]:
+        """Vecteur de recherche ; un seul appel `embed_queries` par Question."""
+        hyp = self._hypothese(question).strip() or question.text
+        if not self.params.mix_question:  # type: ignore[attr-defined]
+            return np.asarray(self.embedder.embed_queries([hyp])[0], dtype=np.float32)
+        v_h, v_q = self.embedder.embed_queries([hyp, question.text])
+        v_h = np.asarray(v_h, dtype=np.float32)
+        somme = v_h + np.asarray(v_q, dtype=np.float32)
+        norme = float(np.linalg.norm(somme))
+        return (somme / norme).astype(np.float32) if norme > 0 else v_h
+
+    def answer(self, question: QuestionInput) -> ArchAnswer:
+        if self._index is None:
+            raise RuntimeError("`load` doit précéder `answer`")
+        vecteur = self._vecteur(question)
+        classes = self.retriever.retrieve(  # type: ignore[attr-defined]
+            question.text,
+            self.params.k,
+            self._index,
+            query_vector=vecteur,  # type: ignore[attr-defined]
+        )
+        # La réponse hypothétique ne sert qu'au vecteur : elle n'entre ni dans le Contexte ni
+        # dans la génération.
+        contexte = self.context_builder.build([s.passage for s in classes])
+        resultat = self.generator.generate(question, contexte)
+        return build_arch_answer(
+            contexte,
+            resultat,
+            classes,
+            "ranked",
+            tokenizer=self.ctx.tokenizer_for(self.generator.model_id),
+        )
diff --git a/tests/unit/architectures/test_story_6_3.py b/tests/unit/architectures/test_story_6_3.py
