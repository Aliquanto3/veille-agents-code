@@ -0,0 +1,61 @@
+"""Paliers de volume emboîtés et reproductibles d'un Corpus (FR-54, AD-20, AD-22)."""
+
+from collections.abc import Sequence
+
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.ids import sha16
+from wavelibrarian.core.types import ParsedCorpus
+from wavelibrarian.corpus.declare import TiersSpec
+from wavelibrarian.corpus.ingest import empreinte
+
+
+def tirer_chemins(
+    chemins: Sequence[str], spec: TiersSpec, required_paths: Sequence[str] = ()
+) -> dict[int, tuple[str, ...]]:
+    """`source_path` de chaque Palier (taille -> chemins triés).
+
+    Les Documents non requis sont triés par `sha16(graine, chemin)` : le Palier de taille k contient
+    les requis puis les k − r premiers non requis, donc les Paliers sont emboîtés par construction.
+    """
+    disponibles = set(chemins)
+    for i, taille in enumerate(spec.sizes):
+        if taille > len(disponibles):
+            raise ConfigError(
+                f"tiers.sizes[{i}]",
+                f"la taille {taille} dépasse le nombre de Documents du Corpus ({len(disponibles)})",
+            )
+    requis = list(dict.fromkeys(required_paths))
+    for i, chemin in enumerate(required_paths):
+        if chemin not in disponibles:
+            raise ConfigError(f"required_paths[{i}]", f"{chemin!r} n'est pas un Document du Corpus")
+    if len(requis) > spec.sizes[0]:
+        raise ConfigError(
+            "tiers.sizes[0]",
+            f"le Palier {spec.sizes[0]} ne peut pas contenir tous les Documents requis "
+            f"({len(requis)})",
+        )
+    graine = str(spec.seed)
+    autres = sorted(disponibles - set(requis), key=lambda c: (sha16(graine, c), c))
+    return {
+        taille: tuple(sorted([*requis, *autres[: taille - len(requis)]])) for taille in spec.sizes
+    }
+
+
+def tirer(
+    corpus: ParsedCorpus, spec: TiersSpec, required_paths: Sequence[str] = ()
+) -> dict[int, ParsedCorpus]:
+    """Sous-corpus de chaque Palier, avec sa propre `fingerprint`."""
+    paliers = tirer_chemins([d.source_path for d in corpus.documents], spec, required_paths)
+    res: dict[int, ParsedCorpus] = {}
+    for taille, chemins in paliers.items():
+        retenus = set(chemins)
+        documents = tuple(
+            sorted(
+                (d for d in corpus.documents if d.source_path in retenus),
+                key=lambda d: d.source_path,
+            )
+        )
+        res[taille] = ParsedCorpus(
+            corpus_id=corpus.corpus_id, fingerprint=empreinte(documents), documents=documents
+        )
+    return res
