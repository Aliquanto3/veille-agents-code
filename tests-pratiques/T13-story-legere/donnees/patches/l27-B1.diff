@@ -0,0 +1,89 @@
+"""Tests des Paliers de volume (story 2.7)."""
+
+from pathlib import Path
+
+import pytest
+from typer.testing import CliRunner
+
+from wavelibrarian.cli import app
+from wavelibrarian.core.errors import ConfigError
+from wavelibrarian.core.types import ParsedCorpus
+from wavelibrarian.corpus.declare import TiersSpec
+from wavelibrarian.corpus.ingest import empreinte
+from wavelibrarian.corpus.tiers import tirer, tirer_chemins
+
+CORPUS_MINICORPUS = Path(__file__).resolve().parents[3] / "corpora" / "minicorpus" / "corpus.yaml"
+
+SPEC = TiersSpec(seed=42, sizes=(5, 10, 20))
+
+
+def _chemins(minicorpus: ParsedCorpus) -> list[str]:
+    return [d.source_path for d in minicorpus.documents]
+
+
+def test_emboitement_et_requis(minicorpus: ParsedCorpus) -> None:
+    chemins = _chemins(minicorpus)
+    requis = [chemins[-1], chemins[3], chemins[0]]
+    p = tirer_chemins(chemins, SPEC, requis)
+    assert [len(p[t]) for t in (5, 10, 20)] == [5, 10, 20]
+    assert set(p[5]) <= set(p[10]) <= set(p[20])
+    for t in (5, 10, 20):
+        assert set(requis) <= set(p[t])
+
+
+def test_graine(minicorpus: ParsedCorpus) -> None:
+    chemins = _chemins(minicorpus)
+    requis = chemins[:3]
+    assert tirer_chemins(chemins, SPEC, requis) == tirer_chemins(chemins[::-1], SPEC, requis)
+    autre = tirer_chemins(chemins, TiersSpec(seed=43, sizes=(5, 10, 20)), requis)
+    assert autre != tirer_chemins(chemins, SPEC, requis)
+
+
+def test_taille_trop_grande(minicorpus: ParsedCorpus) -> None:
+    n = len(minicorpus.documents)
+    with pytest.raises(ConfigError) as e:
+        tirer_chemins(_chemins(minicorpus), TiersSpec(seed=1, sizes=(5, n + 1)))
+    assert e.value.path == "tiers.sizes[1]"
+
+
+def test_trop_de_requis(minicorpus: ParsedCorpus) -> None:
+    chemins = _chemins(minicorpus)
+    with pytest.raises(ConfigError, match="ne peut pas contenir tous les Documents requis"):
+        tirer_chemins(chemins, TiersSpec(seed=1, sizes=(2, 5)), chemins[:3])
+
+
+def test_requis_inconnu(minicorpus: ParsedCorpus) -> None:
+    with pytest.raises(ConfigError) as e:
+        tirer_chemins(_chemins(minicorpus), SPEC, [_chemins(minicorpus)[0], "absent.md"])
+    assert e.value.path == "required_paths[1]"
+
+
+def test_sous_corpus(minicorpus: ParsedCorpus) -> None:
+    paliers = tirer(minicorpus, SPEC, _chemins(minicorpus)[:3])
+    p5 = paliers[5]
+    assert len(p5.documents) == 5
+    assert p5.corpus_id == minicorpus.corpus_id
+    assert [d.source_path for d in p5.documents] == sorted(d.source_path for d in p5.documents)
+    assert p5.fingerprint == empreinte(p5.documents)
+    assert p5.fingerprint != minicorpus.fingerprint
+
+
+def test_cli_avec_tiers() -> None:
+    res = CliRunner().invoke(app, ["corpus", "paliers", str(CORPUS_MINICORPUS)])
+    assert res.exit_code == 0
+    for t in (5, 10, 20):
+        assert f"Palier {t} : {t} Documents" in res.output
+    assert res.output.count("  - ") == 5 + 10 + 20
+
+
+def test_cli_sans_tiers(tmp_path: Path) -> None:
+    (tmp_path / "docs").mkdir()
+    (tmp_path / "docs" / "a.md").write_text("# A\n\ntexte\n", encoding="utf-8")
+    (tmp_path / "corpus.yaml").write_text(
+        "corpus_id: demo\npath: docs\nlang: fr\nlicense: CC0-1.0\npublishable: true\n"
+        "volatility: low\n",
+        encoding="utf-8",
+    )
+    res = CliRunner().invoke(app, ["corpus", "paliers", str(tmp_path / "corpus.yaml")])
+    assert res.exit_code == 0
+    assert "ne déclare pas de Paliers" in res.output
