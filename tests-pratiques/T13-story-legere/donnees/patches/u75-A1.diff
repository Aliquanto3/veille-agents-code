+"""Écran « Ce qu'il faut pour le faire en vrai » : la fiche de la Story 8.1, en lecture seule.
+
+La fiche vit dans `docs/` ; l'UI en affiche le Markdown tel quel, sans en recopier le texte.
+"""
+
+from pathlib import Path
+
+FICHIER_FICHE = "docs/fiche-outillage.md"
+"""Fiche d'outillage de la Story 8.1, relative à la racine."""
+
+FICHE_ABSENTE = (
+    f"Fiche absente : `{FICHIER_FICHE}` (Story 8.1) ; l'outillage demandé ne peut pas être affiché."
+)
+"""Avertissement affiché quand la fiche n'existe pas."""
+
+LEGENDE = f"Source : `{FICHIER_FICHE}` (Story 8.1), affichée en lecture seule."
+"""Légende sous la fiche : sa source."""
+
+
+def lire_fiche(racine: Path) -> str | None:
+    """Contenu de la fiche de la Story 8.1, ou `None` si elle est absente."""
+    chemin = racine / FICHIER_FICHE
+    if not chemin.is_file():
+        return None
+    return chemin.read_text(encoding="utf-8")
