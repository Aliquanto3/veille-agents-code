--- /dev/null
+++ b/tests/unit/ui/test_outillage.py
@@ -0,0 +1,70 @@
+"""Fiche d'outillage : lecture (présente, absente, vide, illisible) et pas de copie dans `ui/`."""
+
+from pathlib import Path
+
+import pytest
+
+from usine.contrats.erreurs import UsineErreur
+from usine.ui import outillage
+from usine.ui.outillage import FICHE_ABSENTE, FICHIER_FICHE, LEGENDE, lire_fiche
+
+DEPOT = Path(__file__).resolve().parents[3]
+REPERTOIRE_UI = Path(outillage.__file__).parent
+
+
+def _ecrire(racine: Path, octets: bytes) -> None:
+    fichier = racine / FICHIER_FICHE
+    fichier.parent.mkdir(parents=True, exist_ok=True)
+    fichier.write_bytes(octets)
+
+
+def test_constantes() -> None:
+    assert FICHIER_FICHE == "docs/fiche-outillage.md"
+    assert FICHIER_FICHE in FICHE_ABSENTE
+    assert FICHIER_FICHE in LEGENDE
+    assert "8.1" in LEGENDE
+    assert "lecture seule" in LEGENDE
+
+
+def test_fiche_presente(tmp_path: Path) -> None:
+    contenu = "# Titre\n\n| a | b |\n|---|---|\n| é | ✅ |\n"
+    _ecrire(tmp_path, contenu.encode("utf-8"))
+    assert lire_fiche(tmp_path) == contenu
+
+
+def test_fiche_du_depot() -> None:
+    fiche = lire_fiche(DEPOT)
+    assert fiche is not None
+    assert "Correspondance par brique" in fiche
+
+
+def test_fiche_absente(tmp_path: Path) -> None:
+    assert lire_fiche(tmp_path) is None
+
+
+@pytest.mark.parametrize("contenu", [b"", b" \n\t \n"])
+def test_fiche_vide(tmp_path: Path, contenu: bytes) -> None:
+    _ecrire(tmp_path, contenu)
+    assert lire_fiche(tmp_path) is None
+
+
+def test_fiche_encodage_invalide(tmp_path: Path) -> None:
+    _ecrire(tmp_path, b"\xff\xfe\x00\xff")
+    with pytest.raises(UsineErreur, match=FICHIER_FICHE):
+        lire_fiche(tmp_path)
+
+
+def test_fiche_est_un_repertoire(tmp_path: Path) -> None:
+    (tmp_path / FICHIER_FICHE).mkdir(parents=True)
+    with pytest.raises(UsineErreur, match=FICHIER_FICHE):
+        lire_fiche(tmp_path)
+
+
+def test_aucune_copie_du_texte_dans_ui() -> None:
+    lignes = (DEPOT / FICHIER_FICHE).read_text(encoding="utf-8").splitlines()
+    corps = [ligne.strip() for ligne in lignes[1:] if ligne.strip()]  # titre H1 excepté
+    assert corps
+    sources = "\n".join(
+        fichier.read_text(encoding="utf-8") for fichier in REPERTOIRE_UI.rglob("*.py")
+    )
+    assert [ligne for ligne in corps if ligne in sources] == []
