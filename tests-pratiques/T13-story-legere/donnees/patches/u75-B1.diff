+FICHE = Path(__file__).resolve().parents[3] / outillage.FICHIER_FICHE
+
+
+def _racine_avec_fiche(tmp_path: Path) -> Path:
+    cible = tmp_path / outillage.FICHIER_FICHE
+    cible.parent.mkdir(parents=True)
+    shutil.copyfile(FICHE, cible)
+    return tmp_path
+
+
+def test_outillage_fiche_presente(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.chdir(_racine_avec_fiche(tmp_path))
+    page = _page(Ecran.outillage)
+    assert not page.exception
+    assert not page.error
+    assert not page.info  # plus un emplacement
+    assert not page.warning
+    texte = _textes(page)
+    contenu = FICHE.read_text(encoding="utf-8")
+    assert contenu.strip() in texte
+    assert "| Extraction Jira |" in texte
+    assert [c.value for c in page.caption] == [outillage.LEGENDE]
+
+
+def test_outillage_fiche_modifiee(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    racine = _racine_avec_fiche(tmp_path)
+    monkeypatch.chdir(racine)
+    page = _page(Ecran.outillage)
+    (racine / outillage.FICHIER_FICHE).write_text("# Nouvelle fiche", encoding="utf-8")
