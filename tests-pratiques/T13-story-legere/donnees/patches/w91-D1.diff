+def _open_browser_when_ready(port: int, timeout_s: float = 30.0) -> bool:
+    """Ouvre le navigateur par défaut sur l'application, une seule fois, une fois le port ouvert.
+
+    Rend `True` si le navigateur a été ouvert. Sans navigateur, sans affichage, ou si le port ne
+    répond pas dans le délai, l'URL est écrite dans la console et le journal : le serveur continue.
+    """
+    url = f"http://{LOOPBACK}:{port}/"
+    deadline = time.monotonic() + timeout_s
+    while not _port_answers(port):
+        if time.monotonic() >= deadline:
+            break
+        time.sleep(0.1)
+    else:
+        try:
+            if webbrowser.open(url):
+                return True
+        except Exception:  # noqa: BLE001 - aucun échec d'ouverture ne doit arrêter le serveur
+            logger.debug("Ouverture du navigateur impossible", exc_info=True)
+    print(f"wavelocalai-v2 : ouvrez {url} dans votre navigateur.", file=sys.stderr)
+    logger.warning("Navigateur non ouvert : ouvrez %s dans votre navigateur.", url)
+    return False
+
