+"""Tests du Parser PDF `pdf_text` (story 2.3) : PDF générés à la volée par fpdf2."""
+
+import logging
+from pathlib import Path
+
+import pytest
+import yaml
+from fpdf import FPDF
+
+from wavelibrarian import registry
+from wavelibrarian.components.parsers.pdf_text import PdfTextParser
+from wavelibrarian.core.ids import sha16_bytes
+from wavelibrarian.core.types import DocMeta
+from wavelibrarian.corpus.declare import declare
+from wavelibrarian.corpus.ingest import ingest
+
+TROIS_PAGES = ["Page un", "Page deux", "Page trois"]
+
+
+def _pdf(pages: list[str]) -> bytes:
+    pdf = FPDF()
+    for texte in pages:
+        pdf.add_page()
+        pdf.set_font("Helvetica", size=12)
+        if texte:
+            pdf.cell(text=texte)
+    return bytes(pdf.output())
+
+
+def _corpus(racine: Path, fichiers: dict[str, bytes]) -> Path:
+    docs = racine / "docs"
+    for nom, contenu in fichiers.items():
+        cible = docs / nom
+        cible.parent.mkdir(parents=True, exist_ok=True)
+        cible.write_bytes(contenu)
+    spec = {
+        "corpus_id": "demo",
+        "path": "docs",
+        "lang": "fr",
+        "license": "CC-BY-4.0",
+        "publishable": True,
+        "volatility": "low",
+    }
+    fichier = racine / "corpus.yaml"
+    fichier.write_text(yaml.safe_dump(spec), encoding="utf-8")
+    return fichier
+
+
+def _parse(raw: bytes):
+    return PdfTextParser().parse("docs/registre.pdf", raw, "fr", DocMeta())
+
+
+def test_enregistrement_au_registre():
+    registry.discover()
+    assert registry.get("parser", "pdf_text").formats == frozenset({"pdf"})
+
+
+def test_trois_pages_un_ancrage_par_page():
+    raw = _pdf(TROIS_PAGES)
+    doc = _parse(raw)
+    d = sha16_bytes(raw)
+    assert doc.doc_id == d
+    assert doc.format == "pdf"
+    assert [b.anchor_id for b in doc.blocks] == [f"{d}#p1", f"{d}#p2", f"{d}#p3"]
+    assert all(b.kind == "text" for b in doc.blocks)
+    for bloc, attendu in zip(doc.blocks, TROIS_PAGES, strict=True):
+        assert attendu in bloc.text
+    assert list(doc.anchors) == [f"{d}#p1", f"{d}#p2", f"{d}#p3"]
+    assert [a.page for a in doc.anchors.values()] == [1, 2, 3]
+    assert all(a.heading_path == () for a in doc.anchors.values())
+
+
+def test_page_vide_ancrage_sans_block():
+    raw = _pdf(["Page un", "", "Page trois"])
+    doc = _parse(raw)
+    d = sha16_bytes(raw)
+    assert f"{d}#p2" in doc.anchors
+    assert doc.anchors[f"{d}#p2"].page == 2
+    assert [b.anchor_id for b in doc.blocks] == [f"{d}#p1", f"{d}#p3"]
+
+
+def test_pdf_tronque_leve_value_error():
+    raw = _pdf(TROIS_PAGES)
+    with pytest.raises(ValueError, match="PDF illisible : docs/registre.pdf"):
+        _parse(raw[: len(raw) // 2])
+
+
+def test_ingest_ignore_le_pdf_illisible(
+    tmp_path: Path, wl_home: Path, caplog: pytest.LogCaptureFixture
+):
+    raw = _pdf(TROIS_PAGES)
+    fichier = _corpus(tmp_path, {"cassé.pdf": raw[: len(raw) // 2], "ok.md": b"# Titre\n\ntexte\n"})
+    with caplog.at_level(logging.WARNING):
+        parse = ingest(declare(fichier))
+    assert [d.source_path for d in parse.documents] == ["ok.md"]
+    assert any(
+        r.levelno == logging.WARNING and "cassé.pdf" in r.getMessage() for r in caplog.records
+    )
+
+
+def test_ingest_mixte_markdown_et_pdf(tmp_path: Path, wl_home: Path):
+    fichier = _corpus(tmp_path, {"a.md": b"# A\n\nx\n", "b.pdf": _pdf(TROIS_PAGES)})
+    parse = ingest(declare(fichier))
+    assert {d.source_path: d.format for d in parse.documents} == {
+        "a.md": "markdown",
+        "b.pdf": "pdf",
+    }
+
+
+def test_resolve_page(tmp_path: Path, wl_home: Path):
+    raw = _pdf(TROIS_PAGES)
+    parse = ingest(declare(_corpus(tmp_path, {"docs/registre.pdf": raw})))
+    d = sha16_bytes(raw)
+    assert parse.resolve("docs/registre.pdf", 2, ()) == f"{d}#p2"
+    assert parse.resolve("docs/registre.pdf", 9, ()) is None
+
+
+def test_cache_de_parsing(tmp_path: Path, wl_home: Path, monkeypatch: pytest.MonkeyPatch):
+    raw = _pdf(TROIS_PAGES)
+    corpus = declare(_corpus(tmp_path, {"registre.pdf": raw}))
+    premier = ingest(corpus)
+    assert (wl_home / "parse_cache" / "pdf_text" / f"{sha16_bytes(raw)}.json").is_file()
+
+    def interdit(*args, **kwargs):
+        raise AssertionError("parse ne doit pas être appelé : le cache est relu")
+
+    monkeypatch.setattr(PdfTextParser, "parse", interdit)
+    assert ingest(corpus) == premier
