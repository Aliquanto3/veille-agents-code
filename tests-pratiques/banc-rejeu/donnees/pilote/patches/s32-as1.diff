+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from itertools import pairwise
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, kpi
+from usine.generateur.journal import Generation, generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, jours: list[date], entites: list[str] | None = None) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, jours), entites or ENTITES)
+
+
+def _tous_les_jours(debut: int, fin: int) -> list[date]:
+    return list(jours_ouvres(date(2026, 10, debut), date(2026, 10, fin)))
+
+
+def _val(
+    table: pl.DataFrame, jour: int, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == date(2026, 10, jour))
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne["numerateur"].item(), ligne["denominateur"].item()
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5))
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure")
+    flux.transition("DEMO-3", _ts(5, 10), "nouvelle", "fermee")
+    table = _kpi(flux, [date(2026, 10, 5)])
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(table, 5, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 9), "fermee", "nouvelle")
+    flux.transition("DEMO-1", _ts(7, 10), "nouvelle", "fermee")
+    table = _kpi(flux, _tous_les_jours(5, 7))
+    assert [_val(table, j, "ENT-A", "entrees_jour")[0] for j in (5, 6, 7)] == [1, 0, 1]
+    assert [_val(table, j, "ENT-A", "sorties_jour")[0] for j in (5, 6, 7)] == [0, 1, 1]
+    assert _val(table, 7, PERIMETRE_PROGRAMME, "sorties_jour") == (1, 1)
+
+
+def test_fenetre() -> None:
+    flux = Flux()
+    for rang, jour in enumerate((1, 2, 5, 6, 7, 8, 9)):
+        flux.anomalie(f"DEMO-{rang + 1}", _ts(jour))
+    flux.transition("DEMO-1", _ts(9), "nouvelle", "fermee")
+    table = _kpi(flux, _tous_les_jours(1, 9))
+    assert [_val(table, j, "ENT-A", "entrees_fenetre")[0] for j in (1, 2, 5, 9)] == [1, 2, 3, 5]
+    assert _val(table, 8, "ENT-A", "sorties_fenetre") == (0, 1)
+    assert _val(table, 9, "ENT-A", "sorties_fenetre") == (1, 1)
+
+
+def test_age() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    table = _kpi(flux, _tous_les_jours(1, 7))
+    assert _val(table, 7, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(table, 7, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(table, 1, "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+    assert _val(table, 7, "ENT-B", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(8), "fermee", "nouvelle")
+    table = _kpi(flux, _tous_les_jours(1, 9))
+    assert _val(table, 9, "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(table, 9, "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(5, 10), "nouvelle", "fermee")
+    table = _kpi(flux, _tous_les_jours(5, 6))
+    assert _val(table, 6, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(table, 6, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def _cas_de_test(flux: Flux, cle: str, statut: str, phase: str = "recette") -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(5),
+        {Champ.entite: "ENT-A", Champ.phase: phase, Champ.statut_test: statut},
+    )
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for rang, statut in enumerate(["ok"] * 3 + ["ko"] + ["non_execute"] * 2):
+        _cas_de_test(flux, f"TEST-{rang + 1}", statut)
+    table = _kpi(flux, [date(2026, 10, 5)])
+    assert _val(table, 5, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(table, 5, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(table, 5, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(table, 5, "ENT-B", "taux_non_execution_cas_de_test", "recette") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for cle, statut in (("CERT-1", "accordee"), ("CERT-2", "reservee"), ("CERT-3", "reservee")):
+        flux.creer(
+            cle,
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.entite: "ENT-A", Champ.statut_certification: statut},
+        )
+    table = _kpi(flux, [date(2026, 10, 5)])
+    assert _val(table, 5, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(table, 5, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(table, 5, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [date(2026, 10, 5), date(2026, 10, 7)])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"),
+    [(["ENT-A", "ENT-B", "ENT-A"], "ENT-A"), (["ENT-A", PERIMETRE_PROGRAMME], PERIMETRE_PROGRAMME)],
+)
+def test_entites_refusees(entites: list[str], valeur: str) -> None:
+    with pytest.raises(UsineErreur, match=valeur):
+        kpi(tickets_etats([], [date(2026, 10, 5)]), entites)
+
+
+def test_table_vide() -> None:
+    table = kpi(tickets_etats([], []), ENTITES)
+    assert table.is_empty()
+    assert table.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+
+
+def test_table_dense_et_ordonnee() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5), entite="HORS-LISTE")
+    table = _kpi(flux, _tous_les_jours(5, 6))
+    valider(table, SCHEMA_KPI)
+    par_perimetre = sum(len(dimensions) for _, dimensions in CODES_KPI)
+    assert table.height == 2 * 3 * par_perimetre
+    assert table["date"].to_list() == sorted(table["date"].to_list())
+    premiers = table.head(par_perimetre)
+    assert set(premiers["perimetre"]) == {"ENT-A"}
+    assert premiers["code_kpi"].unique(maintain_order=True).to_list() == [c for c, _ in CODES_KPI]
+    # Le Programme compte aussi les Entités hors de `entites`.
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert not any(t.is_float() for t in table.schema.values())
+
+
+@pytest.fixture(scope="module")
+def generation() -> Generation:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    return generer(config, 42, date(2026, 10, 12))
+
+
+@pytest.fixture(scope="module")
+def etats_generes(generation: Generation) -> pl.DataFrame:
+    entete = generation.entete
+    jours = jours_ouvres(entete.ancrage_semaines, entete.date_injection)
+    return tickets_etats(generation.evenements, jours)
+
+
+def test_journal_genere(etats_generes: pl.DataFrame) -> None:
+    entites = sorted(etats_generes["entite"].drop_nulls().unique().to_list())
+    table = kpi(etats_generes, entites)
+    assert table.equals(kpi(etats_generes, entites))
+    # Programme = somme des Entités pour les comptes.
+    comptes = table.filter(
+        pl.col("code_kpi").is_in(
+            ["anomalies_ouvertes", "entrees_jour", "sorties_jour", "certifications"]
+        )
+    )
+    cles = ["date", "code_kpi", "dimension"]
+    entites_somme = (
+        comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by(cles)
+        .agg(pl.col("numerateur").sum())
+        .sort(cles)
+    )
+    programme = comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME).sort(cles)
+    assert programme["numerateur"].to_list() == entites_somme["numerateur"].to_list()
+    # Stock total = Anomalies ouvertes de l'Instantané.
+    ouvertes = (
+        instantane(etats_generes)
+        .filter(
+            (pl.col("type_ticket") == TypeTicket.anomalie.value)
+            & ~pl.col("statut").cast(pl.Utf8).is_in([s.value for s in STATUTS_FERMES])
+        )
+        .group_by("date")
+        .agg(pl.col("nombre").sum())
+    )
+    stock = table.filter(
+        (pl.col("perimetre") == PERIMETRE_PROGRAMME) & (pl.col("code_kpi") == "anomalies_ouvertes")
+    )
+    attendu = dict(zip(ouvertes["date"], ouvertes["nombre"], strict=True))
+    assert {d: n for d, n in zip(stock["date"], stock["numerateur"], strict=True) if n} == attendu
+    assert sum(attendu.values()) > 0
+
+
+def test_conservation_du_stock(etats_generes: pl.DataFrame) -> None:
+    entites = sorted(etats_generes["entite"].drop_nulls().unique().to_list())
+    table = kpi(etats_generes, entites)
+    dates = sorted(table["date"].unique().to_list())
+    for perimetre in (*entites, PERIMETRE_PROGRAMME):
+        for veille, jour in pairwise(dates):
+            variation = (
+                _stock(table, jour, perimetre)
+                - _stock(table, veille, perimetre)
+                - _mouvement(table, jour, perimetre, "entrees_jour")
+                + _mouvement(table, jour, perimetre, "sorties_jour")
+            )
+            assert variation == 0, (perimetre, jour)
+
+
+def _stock(table: pl.DataFrame, jour: date, perimetre: str) -> int:
+    return _mouvement(table, jour, perimetre, "anomalies_ouvertes")
+
+
+def _mouvement(table: pl.DataFrame, jour: date, perimetre: str, code: str) -> int:
+    ligne = table.filter(
+        (pl.col("date") == jour) & (pl.col("perimetre") == perimetre) & (pl.col("code_kpi") == code)
+    )
+    return int(ligne["numerateur"].item())
