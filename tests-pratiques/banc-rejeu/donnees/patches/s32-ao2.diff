+def test_journal_genere_programme_somme_des_entites(kpi_generes: pl.DataFrame) -> None:
+    comptes = kpi_generes.filter(
+        (pl.col("denominateur") == 1) & ~pl.col("code_kpi").str.starts_with("age_")
+    )
+    entites = (
+        comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by("date", "code_kpi", "dimension")
+        .agg(pl.col("numerateur").sum().alias("somme"))
+    )
+    programme = comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME).join(
+        entites, on=["date", "code_kpi", "dimension"]
+    )
+    assert programme.height > 0
+    assert (programme["numerateur"] == programme["somme"]).all()
+
