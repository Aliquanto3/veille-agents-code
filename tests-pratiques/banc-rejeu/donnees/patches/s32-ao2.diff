+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from itertools import pairwise
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Champ,
+    Gravite,
+    Phase,
+    StatutCertification,
+    TypeTicket,
+)
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import Generation, generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+
+JEUDI = date(2026, 10, 1)
+VENDREDI = date(2026, 10, 2)
+LUNDI = date(2026, 10, 5)
+MARDI = date(2026, 10, 6)
+MERCREDI = date(2026, 10, 7)
+
+
+def _ts(jour: date, heure: int) -> datetime:
+    return datetime(jour.year, jour.month, jour.day, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, dates: list[date], entites: list[str] = ENTITES) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, dates), entites)
+
+
+def _valeur(
+    table: pl.DataFrame, jour: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == jour)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne["numerateur"][0], ligne["denominateur"][0]
+
+
+def _cas_de_test(flux: Flux, cle: str, statut: str, phase: str | None = "recette") -> None:
+    attributs = {Champ.statut_test: statut, Champ.entite: "ENT-A"}
+    if phase is not None:
+        attributs[Champ.phase] = phase
+    flux.creer(cle, TypeTicket.cas_de_test, _ts(LUNDI, 9), attributs)
+
+
+def test_catalogue() -> None:
+    assert CODES_KPI == (
+        "anomalies_ouvertes",
+        "anomalies_ouvertes_gravite",
+        "anomalies_ouvertes_phase",
+        "entrees_jour",
+        "sorties_jour",
+        "entrees_fenetre",
+        "sorties_fenetre",
+        "age_median_anomalies_ouvertes",
+        "age_max_anomalies_ouvertes",
+        "taux_ko_cas_de_test",
+        "taux_non_execution_cas_de_test",
+        "certifications",
+    )
+    assert DIMENSIONS_KPI["anomalies_ouvertes_gravite"] == tuple(g.value for g in Gravite)
+    assert DIMENSIONS_KPI["taux_ko_cas_de_test"] == tuple(p.value for p in Phase)
+    assert DIMENSIONS_KPI["certifications"] == tuple(s.value for s in StatutCertification)
+    assert DIMENSIONS_KPI["entrees_jour"] == ("",)
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    flux.anomalie("DEMO-2", _ts(LUNDI, 10))
+    flux.anomalie("DEMO-3", _ts(LUNDI, 11), entite="ENT-B", gravite="majeure")
+    flux.transition("DEMO-3", _ts(LUNDI, 12), "nouvelle", "fermee")
+    table = _kpi(flux, [LUNDI])
+    valider(table, SCHEMA_KPI)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _valeur(table, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    gravite = "anomalies_ouvertes_gravite"
+    assert _valeur(table, LUNDI, PERIMETRE_PROGRAMME, gravite, "bloquante") == (2, 1)
+    assert _valeur(table, LUNDI, PERIMETRE_PROGRAMME, gravite, "majeure") == (0, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    flux.transition("DEMO-1", _ts(MARDI, 9), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(MERCREDI, 9), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(MERCREDI, 10), "en_analyse", "rejetee")
+    table = _kpi(flux, [LUNDI, MARDI, MERCREDI])
+    jours = (LUNDI, MARDI, MERCREDI)
+    assert [_valeur(table, j, "ENT-A", "entrees_jour")[0] for j in jours] == [1, 0, 1]
+    assert [_valeur(table, j, "ENT-A", "sorties_jour")[0] for j in jours] == [0, 1, 1]
+    assert [_valeur(table, j, "ENT-B", "entrees_jour")[0] for j in jours] == [0, 0, 0]
+
+
+def test_creee_et_fermee_le_meme_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    flux.transition("DEMO-1", _ts(LUNDI, 10), "nouvelle", "fermee")
+    table = _kpi(flux, [LUNDI])
+    assert _valeur(table, LUNDI, "ENT-A", "entrees_jour") == (1, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "sorties_jour") == (1, 1)
+
+
+def test_fenetre_glissante() -> None:
+    jours = list(jours_ouvres(date(2026, 9, 28), date(2026, 10, 6)))
+    assert len(jours) == 7
+    flux = Flux()
+    for rang, jour in enumerate(jours):
+        for numero in range(rang + 1):
+            cle = f"DEMO-{rang * 10 + numero + 1}"
+            flux.anomalie(cle, _ts(jour, 9))
+            if numero % 2:
+                flux.transition(cle, _ts(jour, 10), "nouvelle", "fermee")
+    table = _kpi(flux, jours)
+    for jour in jours:
+        fenetre = fenetre_glissante(jour)
+        for code_jour, code_fenetre in (
+            ("entrees_jour", "entrees_fenetre"),
+            ("sorties_jour", "sorties_fenetre"),
+        ):
+            attendu = sum(
+                _valeur(table, j, "ENT-A", code_jour)[0] for j in fenetre if j >= jours[0]
+            )
+            assert _valeur(table, jour, "ENT-A", code_fenetre) == (attendu, 1)
+    # Premier jour : les jours antérieurs à la table comptent 0.
+    assert _valeur(table, jours[0], "ENT-A", "entrees_fenetre") == (1, 1)
+    assert _valeur(table, jours[-1], "ENT-A", "entrees_fenetre") == (3 + 4 + 5 + 6 + 7, 1)
+
+
+def test_age() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(JEUDI, 9))
+    flux.anomalie("DEMO-2", _ts(VENDREDI, 9))
+    dates = list(jours_ouvres(JEUDI, MERCREDI))
+    table = _kpi(flux, dates)
+    assert _valeur(table, MERCREDI, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _valeur(table, MERCREDI, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _valeur(table, MERCREDI, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (4, 1)
+    assert _valeur(table, JEUDI, "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+    # Calcul sur la seule date D : même âge.
+    seule = _kpi(flux, [MERCREDI])
+    assert _valeur(seule, MERCREDI, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+
+
+def test_age_median_impair() -> None:
+    flux = Flux()
+    for numero, jour in ((1, JEUDI), (2, VENDREDI), (3, LUNDI)):
+        flux.anomalie(f"DEMO-{numero}", _ts(jour, 9))
+    table = _kpi(flux, [MERCREDI])
+    assert _valeur(table, MERCREDI, "ENT-A", "age_median_anomalies_ouvertes") == (3, 1)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    j0, j2, j5, j6 = date(2026, 9, 28), date(2026, 9, 30), date(2026, 10, 5), MARDI
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(j0, 9))
+    flux.transition("DEMO-1", _ts(j2, 9), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(j5, 9), "fermee", "a_retester")
