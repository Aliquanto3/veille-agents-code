@@ -0,0 +1,274 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : l'état des tickets de chaque Jour ouvré et les Entités arrivent en paramètre.
+Définitions du Glossaire (H-17) : Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée =
+création ou réouverture (`date_derniere_entree`) ; Sortie = passage à Fermée ou Rejetée.
+Fenêtre glissante : `calendrier.fenetre_glissante` (H-19). Toute valeur est en `numerateur` /
+`denominateur` entiers ; un compte vaut `n/1`, une valeur sans objet `0/0`.
+"""
+
+from collections import Counter
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass, field
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import (
+    est_jour_ouvre,
+    fenetre_glissante,
+    jours_ouvres,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+_SANS_DIMENSION: tuple[str, ...] = ("",)
+_PHASES: tuple[str, ...] = tuple(phase.value for phase in Phase)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "anomalies_ouvertes": _SANS_DIMENSION,
+        "anomalies_ouvertes_gravite": tuple(gravite.value for gravite in Gravite),
+        "anomalies_ouvertes_phase": _PHASES,
+        "entrees_jour": _SANS_DIMENSION,
+        "sorties_jour": _SANS_DIMENSION,
+        "entrees_fenetre": _SANS_DIMENSION,
+        "sorties_fenetre": _SANS_DIMENSION,
+        "age_median_anomalies_ouvertes": _SANS_DIMENSION,
+        "age_max_anomalies_ouvertes": _SANS_DIMENSION,
+        "taux_ko_cas_de_test": _PHASES,
+        "taux_non_execution_cas_de_test": _PHASES,
+        "certifications": tuple(statut.value for statut in StatutCertification),
+    }
+)
+"""Dimensions de chaque code de KPI, dans l'ordre de sortie (`""` : KPI non ventilé)."""
+
+CODES_KPI: tuple[str, ...] = tuple(DIMENSIONS_KPI)
+"""Codes du catalogue des KPI quotidiens, dans l'ordre de sortie."""
+
+_FERMES = [statut.value for statut in STATUTS_FERMES]
+
+
+@dataclass
+class _Cumul:
+    """Mesures brutes d'un périmètre à une date."""
+
+    ouvertes: int = 0
+    par_gravite: Counter[str] = field(default_factory=Counter)
+    par_phase: Counter[str] = field(default_factory=Counter)
+    entrees: int = 0
+    sorties: int = 0
+    ages: list[int] = field(default_factory=list)
+    tests: Counter[tuple[str, str]] = field(default_factory=Counter)
+    certifications: Counter[str] = field(default_factory=Counter)
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité « {PERIMETRE_PROGRAMME} » refusée : ce code désigne le Programme entier"
+        )
+
+
+def _dates(etats: pl.DataFrame) -> list[date]:
+    """Dates de la table, triées ; refuse un week-end et tout Jour ouvré manquant."""
+    dates: list[date] = sorted(etats.get_column("date").unique().to_list())
+    for jour in dates:
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(f"KPI : {jour.isoformat()} n'est pas un Jour ouvré")
+    presentes = set(dates)
+    if dates:
+        manquantes = [j for j in jours_ouvres(dates[0], dates[-1]) if j not in presentes]
+        if manquantes:
+            raise UsineErreur(
+                "KPI : état des tickets non calculé pour le(s) Jour(s) ouvré(s) "
+                f"{', '.join(j.isoformat() for j in manquantes)} (dates contiguës attendues)"
+            )
+    return dates
+
+
+def _mouvements(etats: pl.DataFrame, dates: list[date]) -> pl.DataFrame:
+    """`etats` + `ouverte`, `entree`, `sortie` (entiers 0, 1 ou 2) de chaque Anomalie.
+
+    `ouverte_veille` vient de la date précédente de la table (ticket absent : 0). À la
+    première date, la veille n'est pas connue : une Anomalie ouverte sans Entrée ce jour-là
+    l'était déjà, toute autre ne l'était pas (début de l'historique).
+    """
+    veilles = pl.DataFrame(
+        {"date": dates, "veille": [None, *dates[:-1]][: len(dates)]},
+        schema={"date": pl.Date(), "veille": pl.Date()},
+    )
+    est_anomalie = pl.col("type_ticket") == TypeTicket.anomalie.value
+    etats = etats.with_columns(
+        (
+            est_anomalie
+            & pl.col("statut").is_not_null()
+            & ~pl.col("statut").cast(pl.Utf8).is_in(_FERMES)
+        ).alias("ouverte"),
+        (est_anomalie & (pl.col("date_derniere_entree") == pl.col("date")))
+        .fill_null(False)
+        .alias("entree"),
+    ).join(veilles, on="date", how="left")
+    precedents = etats.select(
+        pl.col("date").alias("veille"), "cle_ticket", pl.col("ouverte").alias("ouverte_veille")
+    )
+    etats = etats.join(precedents, on=["veille", "cle_ticket"], how="left")
+    return etats.with_columns(
+        pl.when(pl.col("veille").is_null())
+        .then(pl.col("ouverte") & ~pl.col("entree"))
+        .otherwise(pl.col("ouverte_veille").fill_null(False))
+        .alias("ouverte_veille")
+    ).with_columns(
+        (
+            pl.col("entree").cast(pl.Int64)
+            - pl.col("ouverte").cast(pl.Int64)
+            + pl.col("ouverte_veille").cast(pl.Int64)
+        ).alias("sortie")
+    )
+
+
+def _cumuls(
+    etats: pl.DataFrame, dates: list[date], entites: Sequence[str]
+) -> dict[tuple[date, str], _Cumul]:
+    """Mesures brutes par (date, périmètre) ; le Programme reçoit toutes les lignes."""
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    cumuls = {(jour, p): _Cumul() for jour in dates for p in perimetres}
+    connues = set(entites)
+    colonnes = [
+        "date",
+        "type_ticket",
+        "entite",
+        "gravite",
+        "phase",
+        "statut_test",
+        "statut_certification",
+        "date_derniere_entree",
+        "ouverte",
+        "entree",
+        "sortie",
+    ]
+    for ligne in etats.select(colonnes).iter_rows(named=True):
+        jour: date = ligne["date"]
+        cibles = [cumuls[(jour, PERIMETRE_PROGRAMME)]]
+        if ligne["entite"] in connues:
+            cibles.append(cumuls[(jour, ligne["entite"])])
+        type_ticket = ligne["type_ticket"]
+        for cumul in cibles:
+            if type_ticket == TypeTicket.anomalie.value:
+                cumul.entrees += int(ligne["entree"])
+                cumul.sorties += ligne["sortie"]
+                if ligne["ouverte"]:
+                    cumul.ouvertes += 1
+                    if ligne["gravite"] is not None:
+                        cumul.par_gravite[ligne["gravite"]] += 1
+                    if ligne["phase"] is not None:
+                        cumul.par_phase[ligne["phase"]] += 1
+                    if ligne["date_derniere_entree"] is not None:
+                        entree: date = ligne["date_derniere_entree"]
+                        cumul.ages.append(len(jours_ouvres(entree, jour)) - 1)
+            elif type_ticket == TypeTicket.cas_de_test.value:
+                if ligne["phase"] is not None and ligne["statut_test"] is not None:
+                    cumul.tests[(ligne["phase"], ligne["statut_test"])] += 1
+            elif ligne["statut_certification"] is not None:
+                cumul.certifications[ligne["statut_certification"]] += 1
+    return cumuls
+
+
+def _mediane(ages: list[int]) -> tuple[int, int]:
+    if not ages:
+        return 0, 0
+    tries = sorted(ages)
+    milieu = len(tries) // 2
+    if len(tries) % 2:
+        return tries[milieu], 1
+    valeur = Fraction(tries[milieu - 1] + tries[milieu], 2)
+    return valeur.numerator, valeur.denominator
+
+
+def _valeurs(
+    cumul: _Cumul, entrees_fenetre: int, sorties_fenetre: int
+) -> dict[str, dict[str, tuple[int, int]]]:
+    """Valeur `(numerateur, denominateur)` de chaque code et dimension du catalogue."""
+    taux_ko: dict[str, tuple[int, int]] = {}
+    taux_non_execution: dict[str, tuple[int, int]] = {}
+    for phase in _PHASES:
+        ok = cumul.tests[(phase, StatutTest.ok.value)]
+        ko = cumul.tests[(phase, StatutTest.ko.value)]
+        non_executes = cumul.tests[(phase, StatutTest.non_execute.value)]
+        taux_ko[phase] = (ko, ok + ko)
+        taux_non_execution[phase] = (non_executes, ok + ko + non_executes)
+    return {
+        "anomalies_ouvertes": {"": (cumul.ouvertes, 1)},
+        "anomalies_ouvertes_gravite": {
+            g: (cumul.par_gravite[g], 1) for g in DIMENSIONS_KPI["anomalies_ouvertes_gravite"]
+        },
+        "anomalies_ouvertes_phase": {p: (cumul.par_phase[p], 1) for p in _PHASES},
+        "entrees_jour": {"": (cumul.entrees, 1)},
+        "sorties_jour": {"": (cumul.sorties, 1)},
+        "entrees_fenetre": {"": (entrees_fenetre, 1)},
+        "sorties_fenetre": {"": (sorties_fenetre, 1)},
+        "age_median_anomalies_ouvertes": {"": _mediane(cumul.ages)},
+        "age_max_anomalies_ouvertes": {"": (max(cumul.ages), 1) if cumul.ages else (0, 0)},
+        "taux_ko_cas_de_test": taux_ko,
+        "taux_non_execution_cas_de_test": taux_non_execution,
+        "certifications": {
+            s: (cumul.certifications[s], 1) for s in DIMENSIONS_KPI["certifications"]
+        },
+    }
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : les codes de `CODES_KPI` pour chaque date, Entité et le Programme.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date
+    (sinon `UsineErreur`). Sortie dense (zéro explicite), triée par date, périmètre (ordre de
+    `entites`, puis `PROGRAMME`), code et dimension dans l'ordre de `DIMENSIONS_KPI`. Le
+    Programme compte toutes les lignes, y compris celles d'Entités hors de `entites`.
+
+    Sortie du jour d'une Anomalie = Entrée − (ouverte en D − ouverte la veille) : le stock
+    varie de Entrées − Sorties d'un jour au suivant. Plusieurs réouvertures d'un même ticket
+    dans la journée comptent pour une Entrée. Âge d'une Anomalie ouverte = Jours ouvrés
+    écoulés depuis sa dernière Entrée (0 le jour même). Taux de KO = KO / (OK + KO) ; taux
+    de non-exécution = non exécutés / Cas de test de la Phase ayant un statut.
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    dates = _dates(etats)
+    cumuls = _cumuls(_mouvements(etats, dates), dates, entites)
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+    for jour in dates:
+        fenetre = [j for j in fenetre_glissante(jour) if j >= dates[0]]
+        for perimetre in perimetres:
+            dans_fenetre = [cumuls[(j, perimetre)] for j in fenetre]
+            valeurs = _valeurs(
+                cumuls[(jour, perimetre)],
+                sum(c.entrees for c in dans_fenetre),
+                sum(c.sorties for c in dans_fenetre),
+            )
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    numerateur, denominateur = valeurs[code][dimension]
+                    lignes["date"].append(jour)
+                    lignes["perimetre"].append(perimetre)
+                    lignes["code_kpi"].append(code)
+                    lignes["dimension"].append(dimension)
+                    lignes["numerateur"].append(numerateur)
+                    lignes["denominateur"].append(denominateur)
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
