+def test_journal_genere_conservation(kpi_generes: pl.DataFrame) -> None:
+    valeurs = {
+        (ligne["date"], ligne["perimetre"], ligne["code_kpi"]): ligne["numerateur"]
+        for ligne in kpi_generes.filter(pl.col("dimension") == "").iter_rows(named=True)
+    }
+    dates = sorted(set(kpi_generes["date"]))
+    perimetres = set(kpi_generes["perimetre"])
+    assert sum(valeurs[(d, PERIMETRE_PROGRAMME, "sorties_jour")] for d in dates) > 0
+    for perimetre in perimetres:
+        assert valeurs[(dates[0], perimetre, "anomalies_ouvertes")] == (
+            valeurs[(dates[0], perimetre, "entrees_jour")]
+            - valeurs[(dates[0], perimetre, "sorties_jour")]
+        )
+        for veille, jour in pairwise(dates):
+            assert valeurs[(jour, perimetre, "anomalies_ouvertes")] - valeurs[
+                (veille, perimetre, "anomalies_ouvertes")
+            ] == (
+                valeurs[(jour, perimetre, "entrees_jour")]
+                - valeurs[(jour, perimetre, "sorties_jour")]
+            )
