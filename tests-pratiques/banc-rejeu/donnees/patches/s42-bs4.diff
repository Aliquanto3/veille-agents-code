@@ -0,0 +1,352 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Série sur 10 Jours ouvrés finissant à D (vendredi
+09/10/2026), x = 0..9, projection à x = 9 + h. Grille par défaut : rouge IND-1 `>= 3`, IND-3
+`>= 20`, IND-4 `>= 1/5`.
+
+IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → D + 1 JO.
+IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σy = 7, ȳ = 7/10, Σ(x−x̄)(y−ȳ) = 41/2, Σ(x−x̄)² = 165/2, pente
+41/165, ordonnée 7/10 − (41/165)(9/2) = −23/55 ; p(4) = 464/165 < 3 ; p(5) = 101/33 ≥ 3.
+IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5.
+"""
+
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-A"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Valeur = tuple[int, int] | str
+"""Valeur évaluée (numérateur, dénominateur), ou motif d'un indicateur non évaluable."""
+
+CONSTANTE = [(1, 1)] * 10
+
+
+def _grille(**modifs: dict[str, Any]) -> GrilleMeteo:
+    donnees: dict[str, Any] = yaml.safe_load(
+        (RACINE / "config" / "grille_meteo.yaml").read_text(encoding="utf-8")
+    )
+    for code, regle in modifs.items():
+        donnees["indicateurs"][code.replace("_", "-")].update(regle)
+    return GrilleMeteo.model_validate(donnees)
+
+
+def _entiers(*valeurs: int) -> list[Valeur]:
+    return [(v, 1) for v in valeurs]
+
+
+def _table(
+    series: dict[CodeIndicateur, list[Valeur]],
+    fin: date = D,
+    entite: str = ENTITE,
+    dates: dict[CodeIndicateur, list[date]] | None = None,
+) -> pl.DataFrame:
+    lignes: list[dict[str, Any]] = []
+    for code, valeurs in series.items():
+        jours = (dates or {}).get(code) or jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+        for jour, valeur in zip(jours, valeurs, strict=True):
+            evalue = not isinstance(valeur, str)
+            lignes.append(
+                {
+                    "date": jour,
+                    "entite": entite,
+                    "code": code.value,
+                    "statut": "evalue" if evalue else "non_evaluable",
+                    "motif": "" if evalue else valeur,
+                    "numerateur": valeur[0] if not isinstance(valeur, str) else 0,
+                    "denominateur": valeur[1] if not isinstance(valeur, str) else 0,
+                    "couleur": "vert",
+                }
+            )
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _regle(couleur: Couleur) -> RegleDeclenchante:
+    return RegleDeclenchante(
+        code=CodeIndicateur.ind_2,
+        couleur=couleur,
+        operateur=Operateur.superieur_ou_egal,
+        numerateur=5,
+        denominateur=1,
+        seuil_numerateur=1,
+        seuil_denominateur=1,
+        tickets_en_cause=(),
+    )
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(_regle(couleur),),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _calme() -> dict[CodeIndicateur, list[Valeur]]:
+    return {IND_1: list(CONSTANTE), IND_3: list(CONSTANTE), IND_4: [(1, 100)] * 10}
+
+
+def _calculer(
+    series: dict[CodeIndicateur, list[Valeur]], grille: GrilleMeteo | None = None, **kw: Any
+) -> ResultatRisque:
+    return risques_entree_rouge(_table(series, **kw), _meteo(), grille or _grille())
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = _calculer({**_calme(), IND_3: _entiers(*range(10, 20))})
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 12)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (19, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (20, 1)
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = _calculer({**_calme(), IND_1: _entiers(0, 0, 0, 0, 0, 1, 1, 1, 2, 2)})
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert projete.risque.horizon_jours_ouvres == 5
+    assert projete.risque.version_grille == VERSION_GRILLE
+    assert (projete.risque.date_arrete, projete.risque.entite) == (D, ENTITE)
+
+
+def test_droite_exacte_ind_1() -> None:
+    a, b = risque._droite([Fraction(v) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)])
+
+    assert (a, b) == (Fraction(-23, 55), Fraction(41, 165))
+    assert a + b * 13 == Fraction(464, 165)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    ind_4: list[Valeur] = [(n, 100) for n in range(5, 15)]
+
+    resultat = _calculer({**_calme(), IND_4: ind_4})
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_stable_ou_en_baisse() -> None:
+    resultat = _calculer(
+        {
+            IND_1: _entiers(2, 2, 2, 2, 2, 2, 2, 2, 2, 2),
+            IND_3: _entiers(*range(19, 9, -1)),
+            IND_4: [(n, 100) for n in range(14, 4, -1)],
+        }
+    )
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    ind_4: list[Valeur] = [(10, 100)] * 10
+    ind_4[3] = "volume insuffisant"
+    ind_4[5] = "autre motif"
+
+    resultat = _calculer(
+        {IND_1: _entiers(*range(0, 10)), IND_3: _entiers(*range(10, 20)), IND_4: ind_4}
+    )
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1, IND_3]
+    assert [e.code for e in resultat.exclus] == [IND_4]
+    motif = resultat.exclus[0].motif
+    assert "2026-10-01" in motif
+    assert "volume insuffisant" in motif
+    assert "autre motif" not in motif
+
+
+def test_historique_court() -> None:
+    un_seul = _calculer({**_calme(), IND_3: _entiers(19)})
+    assert un_seul.risques == ()
+    assert un_seul.exclus == (
+        IndicateurExclu(IND_3, "historique insuffisant (2 Jours ouvrés au moins requis)"),
+    )
+
+    quatre = _calculer({**_calme(), IND_3: _entiers(10, 12, 14, 16)})
+    # pente 2 : p(1) = 18, p(2) = 20 → D + 2 JO
+    assert [r.risque.indicateur for r in quatre.risques] == [IND_3]
+    assert quatre.risques[0].valeur_projetee == Fraction(20)
+    assert quatre.risques[0].risque.date_franchissement_estimee == date(2026, 10, 13)
+
+
+def test_indicateur_inactif_ou_sans_seuil_rouge_sans_lecture() -> None:
+    calme = _calme()
+    table = _table({IND_1: calme[IND_1], IND_4: calme[IND_4]})  # IND-3 absent de la table
+    inactif = risques_entree_rouge(table, _meteo(), _grille(IND_3={"active": False}))
+    assert [e.code for e in inactif.exclus] == [IND_3]
+    assert inactif.risques == ()
+
+    sans_rouge = risques_entree_rouge(
+        table, _meteo(), _grille(IND_3={"seuils": {"orange": ">= 10"}})
+    )
+    assert [e.code for e in sans_rouge.exclus] == [IND_3]
+
+
+def test_resultats_dans_l_ordre_des_codes() -> None:
+    resultat = _calculer(
+        {
+            IND_4: [(n, 20) for n in range(10, 20)],
+            IND_3: _entiers(*range(10, 20)),
+            IND_1: _entiers(*range(0, 10)),
+        }
+    )
+
