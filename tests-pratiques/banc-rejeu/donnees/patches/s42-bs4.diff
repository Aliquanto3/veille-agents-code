@@ -0,0 +1,196 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Pour une
+Entité non rouge, elle ajuste par moindres carrés une droite sur les `fenetre` derniers Jours
+ouvrés d'IND-1, IND-3 et IND-4 finissant à la Date d'arrêté D, et la projette de 1 à `horizon`
+Jours ouvrés après D. Un `RisqueEntreeRouge` est émis pour chaque indicateur dont une projection
+déclenche la règle rouge de la Grille, avec la valeur projetée à cette échéance.
+
+Les indicateurs écartés (non évaluables sur la fenêtre, historique insuffisant, sans seuil rouge
+actif) sont restitués avec leur motif.
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+from itertools import pairwise
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+INDICATEURS_PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+"""Indicateurs projetés, dans l'ordre de `CodeIndicateur`."""
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque d'entrée en rouge : paramètre {nom} invalide {valeur!r}"
+                    " (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Un `RisqueEntreeRouge` et la valeur projetée à sa date de franchissement estimée.
+
+    Le contrat porte la valeur courante ; la valeur projetée est rendue à côté.
+    """
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D sont
+    lues, et les `parametres.fenetre` dernières doivent former des Jours ouvrés consécutifs
+    finissant à D. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la table
+    est invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo {meteo.couleur}, non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in INDICATEURS_PROJETES:
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active or Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, "indicateur inactif ou sans seuil rouge"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        serie = _serie(table, meteo, code, parametres.fenetre)
+        if isinstance(serie, str):
+            exclus.append(IndicateurExclu(code, serie))
+            continue
+        a, b = _droite(serie)
+        for h in range(1, parametres.horizon + 1):
+            projetee = a + b * (len(serie) - 1 + h)
+            if declenche(projetee, operateur, seuil):
+                courante = serie[-1]
+                risques.append(
+                    RisqueProjete(
+                        RisqueEntreeRouge(
+                            date_arrete=meteo.date_arrete,
+                            entite=entite,
+                            indicateur=code,
+                            date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                            horizon_jours_ouvres=parametres.horizon,
+                            numerateur=courante.numerator,
+                            denominateur=courante.denominator,
+                            seuil_numerateur=seuil.numerator,
+                            seuil_denominateur=seuil.denominator,
+                            version_grille=meteo.version_grille,
+                        ),
+                        projetee,
+                    )
+                )
+                break
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _serie(
+    table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur, fenetre: int
+) -> list[Fraction] | str:
+    """Valeurs de l'indicateur sur la fenêtre finissant à D, ou le motif d'exclusion."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = (
+        table.filter(
+            (pl.col("entite") == entite) & (pl.col("code") == code) & (pl.col("date") <= arrete)
+        )
+        .sort("date")
+        .to_dicts()
+    )
+    precedent: date | None = None
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} {code} : {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if jour == precedent:
+            raise UsineErreur(f"Risque {entite} {code} : date {jour.isoformat()} en double")
+        precedent = jour
+    if precedent != arrete:
+        raise UsineErreur(
+            f"Risque {entite} {code} : Date d'arrêté {arrete.isoformat()} absente de la table"
+        )
+    fenetre_lignes = lignes[-fenetre:]
+    for avant, apres in pairwise(fenetre_lignes):
+        if jour_ouvre_suivant(avant["date"]) != apres["date"]:
+            raise UsineErreur(
+                f"Risque {entite} {code} : trou de Jours ouvrés entre"
+                f" {avant['date'].isoformat()} et {apres['date'].isoformat()}"
+            )
+    for ligne in fenetre_lignes:
+        if ligne["statut"] == StatutIndicateur.non_evaluable:
+            return (
+                f"{code} non évaluable le {ligne['date'].isoformat()} : {ligne['motif']}"
+                " (exclu de la projection)"
+            )
+    valeurs: list[Fraction] = []
+    for ligne in fenetre_lignes:
+        if ligne["denominateur"] <= 0:
+            raise UsineErreur(
+                f"Risque {entite} {code} : dénominateur {ligne['denominateur']} invalide"
+                f" le {ligne['date'].isoformat()}"
+            )
+        valeurs.append(Fraction(ligne["numerateur"], ligne["denominateur"]))
+    if len(valeurs) < 2:
+        return "historique insuffisant (2 Jours ouvrés au moins requis)"
+    return valeurs
+
+
+def _droite(y: list[Fraction]) -> tuple[Fraction, Fraction]:
+    """Ordonnée à l'origine et pente des moindres carrés de `y` en x = 0..n−1 (n ≥ 2)."""
+    n = len(y)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(y, Fraction(0)) / n
+    sxx = sum(((i - x_moyen) ** 2 for i in range(n)), Fraction(0))
+    sxy = sum(((i - x_moyen) * (v - y_moyen) for i, v in enumerate(y)), Fraction(0))
+    pente = sxy / sxx
+    return y_moyen - pente * x_moyen, pente
