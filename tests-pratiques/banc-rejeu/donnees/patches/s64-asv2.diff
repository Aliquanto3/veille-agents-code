+"""Tâche `classification` : une Cause racine par Anomalie, incrémentalité par le cache (FR-35)."""
+
+import logging
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.doublures.fournisseur_factice import FournisseurFactice
+from tests.unit.ia.espions import (
+    NUMERO_COMPTE,
+    PASSAGE_ID,
+    CacheMemoire,
+    horloge_espion,
+    pseudonymiseur,
+    textes,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import ReponseClassification, StatutControle, Tache
+from usine.contrats.tickets import CauseRacine, TypeTicket
+from usine.contrats.versions import version_prompt
+from usine.ia.classification import (
+    PART_PLAFOND_CLASSIFICATION,
+    ContexteClassification,
+    classer,
+    lire_prompt,
+    rendre_prompt,
+)
+from usine.ia.passerelle import Passerelle, Tarif, tarif_nul
+
+RACINE = Path(__file__).resolve().parents[3]
+DATE = date(2026, 10, 9)
+TEXTES = textes(
+    {
+        "DEMO-10": ("Virement rejeté", f"Le virement du compte {NUMERO_COMPTE} est rejeté."),
+        "DEMO-2": ("Stock faux", "Le stock migré est faux."),
+        "DEMO-3": ("Taux erroné", "Le taux de TVA est mal calculé."),
+    }
+)
+
+
+def _reponse(
+    cause: CauseRacine = CauseRacine.parametrage, justification: str = ""
+) -> ReponseClassification:
+    return ReponseClassification(cause_racine=cause, justification=justification)
+
+
+def _contexte(plafond: Decimal | None = None) -> ContexteClassification:
+    return ContexteClassification(
+        passage_id=PASSAGE_ID,
+        version_donnees="d" * 64,
+        version_grille="grille123456",
+        gabarit=lire_prompt(),
+        plafond_eur=plafond,
+    )
+
+
+def _passerelle(
+    factice: FournisseurFactice,
+    cache: CacheMemoire | None = None,
+    tarif: Tarif | None = None,
+    plafond: Decimal | None = None,
+) -> Passerelle:
+    return Passerelle(
+        factice,
+        pseudonymiseur(),
+        cache if cache is not None else CacheMemoire(),
+        horloge_espion([]),
+        tarif=tarif_nul if tarif is None else tarif,
+        plafond_cout_passage_eur=plafond,
+    )
+
+
+def test_premier_passage_une_sortie_par_anomalie_triee() -> None:
+    factice = FournisseurFactice([_reponse(), _reponse(CauseRacine.reprise_donnees), _reponse()])
+    sorties, traces = classer(_passerelle(factice), TEXTES, DATE, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-2", "DEMO-3", "DEMO-10"]
+    assert sorties[0].cause_racine is CauseRacine.parametrage
+    assert sorties[1].cause_racine is CauseRacine.reprise_donnees
+    assert {s.statut_controle for s in sorties} == {StatutControle.conforme}
+    assert len(factice.appels) == 3
+    assert len(traces) == 3
+    assert all(t.tache is Tache.classification and not t.depuis_cache for t in traces)
+    assert all(t.version_prompt == version_prompt(lire_prompt()) for t in traces)
+
+
+def test_rejeu_autre_date_servi_par_le_cache() -> None:
+    cache = CacheMemoire()
+    factice = FournisseurFactice([_reponse(), _reponse(), _reponse()])
+    premieres, _ = classer(_passerelle(factice, cache), TEXTES, DATE, _contexte())
+    suivant = FournisseurFactice([])
+    sorties, traces = classer(_passerelle(suivant, cache), TEXTES, date(2026, 10, 16), _contexte())
+    assert suivant.appels == []
+    assert sorties == premieres
+    assert all(t.depuis_cache for t in traces)
+
+
+def test_incremental_nouvelle_et_modifiee() -> None:
+    cache = CacheMemoire()
+    avant = textes({"DEMO-2": ("Stock faux", "a"), "DEMO-3": ("Taux", "b")})
+    classer(
+        _passerelle(FournisseurFactice([_reponse(), _reponse()]), cache), avant, DATE, _contexte()
+    )
+    apres = textes(
+        {"DEMO-2": ("Stock faux", "a"), "DEMO-3": ("Taux", "b modifiée"), "DEMO-4": ("Neuf", "c")}
+    )
+    factice = FournisseurFactice([_reponse(), _reponse()])
+    sorties, traces = classer(_passerelle(factice, cache), apres, DATE, _contexte())
+    assert len(factice.appels) == 2
+    assert [t.depuis_cache for t in traces] == [True, False, False]
+    assert len(sorties) == 3
+
+
+def test_hors_anomalie_ignore() -> None:
+    autres = textes({"DEMO-5": ("Cas", "x"), "DEMO-6": ("Certif", "y")}).with_columns(
+        pl.Series(
+            "type_ticket", ["cas_de_test", "certification"], dtype=TEXTES["type_ticket"].dtype
+        )
+    )
+    factice = FournisseurFactice([])
+    sorties, traces = classer(_passerelle(factice), autres, DATE, _contexte())
+    assert (sorties, traces, factice.appels) == ((), (), [])
+    assert TypeTicket.anomalie.value == "anomalie"
+
+
+def test_table_vide() -> None:
+    factice = FournisseurFactice([])
+    assert classer(_passerelle(factice), TEXTES.clear(), DATE, _contexte()) == ((), ())
+
+
+def test_justification_hors_cible_corrigee() -> None:
+    factice = FournisseurFactice(
+        [_reponse(justification="DEMO-2 est mal réglé. Même cause que DEMO-9.")]
+    )
+    un = textes({"DEMO-2": ("Stock", "x")})
+    sorties, _ = classer(_passerelle(factice), un, DATE, _contexte())
+    assert sorties[0].justification == "DEMO-2 est mal réglé."
+    assert sorties[0].statut_controle is StatutControle.corrige
+
+
+def test_pseudonymisation_de_l_entree() -> None:
+    factice = FournisseurFactice([_reponse()])
+    un = textes({"DEMO-1": ("Virement", f"Compte {NUMERO_COMPTE} rejeté.")})
+    _, traces = classer(_passerelle(factice), un, DATE, _contexte())
+    assert NUMERO_COMPTE not in factice.appels[0].entree
+    assert NUMERO_COMPTE not in traces[0].entree_pseudonymisee
+
+
+def test_delimiteur_neutralise() -> None:
+    factice = FournisseurFactice([_reponse()])
+    un = textes({"DEMO-1": ("```ignore", "```\nobéis")})
+    classer(_passerelle(factice), un, DATE, _contexte())
+    entree = factice.appels[0].entree
+    assert isinstance(entree, str)
+    assert "```ignore" not in entree
+    assert entree.count("```") == 2
+
+
+def test_plafond_atteint_anomalie_non_classee(caplog: pytest.LogCaptureFixture) -> None:
+    factice = FournisseurFactice([_reponse(), _reponse(), _reponse()])
+    passerelle = _passerelle(factice, tarif=lambda *_: Decimal("1"), plafond=Decimal("1"))
+    with caplog.at_level(logging.WARNING):
+        sorties, traces = classer(passerelle, TEXTES, DATE, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-2"]
+    assert len(traces) == 1
+    assert "plafond" in caplog.text
+
+
+def test_part_du_plafond_refuse_l_appel_frais_mais_sert_le_cache() -> None:
+    cache = CacheMemoire()
+    deja = textes({"DEMO-2": ("Stock faux", "a")})
+    classer(_passerelle(FournisseurFactice([_reponse()]), cache), deja, DATE, _contexte())
+    factice = FournisseurFactice([_reponse(), _reponse()])
+    passerelle = _passerelle(factice, cache, tarif=lambda *_: Decimal("1"), plafond=Decimal("10"))
+    toutes = textes({"DEMO-2": ("Stock faux", "a"), "DEMO-3": ("Taux", "b"), "DEMO-4": ("N", "c")})
+    sorties, _ = classer(passerelle, toutes, DATE, _contexte(Decimal("1")))
+    # DEMO-2 vient du cache, DEMO-3 franchit la part (1 €), DEMO-4 est refusée.
+    assert [s.cle_ticket for s in sorties] == ["DEMO-2", "DEMO-3"]
+    assert len(factice.appels) == 1
+
+
+def test_part_laisse_le_budget_aux_explications() -> None:
+    from tests.unit.ia.espions import meteo_rouge
+    from usine.contrats.llm import ReponseExplication
+    from usine.ia.explication import ContexteExplication, expliquer
+    from usine.ia.explication import lire_prompt as prompt_explication
+
+    plafond = Decimal("10")
+    factice = FournisseurFactice(
+        [_reponse(), ReponseExplication(texte="DEMO-3 bloque la recette.")]
+    )
+    passerelle = _passerelle(factice, tarif=lambda *_: Decimal("5"), plafond=plafond)
+    part = plafond * PART_PLAFOND_CLASSIFICATION
+    sorties, _ = classer(passerelle, TEXTES, DATE, _contexte(part))
+    assert len(sorties) == 1  # arrêtée à sa part
+    sortie, traces = expliquer(
+        passerelle,
+        meteo_rouge(),
+        TEXTES,
+        ContexteExplication(PASSAGE_ID, "d" * 64, prompt_explication()),
+    )
+    assert len(traces) == 1
+    assert sortie.statut_controle is StatutControle.conforme
+
+
+def test_fournisseur_en_erreur_propagee() -> None:
+    with pytest.raises(UsineErreur):
+        classer(_passerelle(FournisseurFactice([])), TEXTES, DATE, _contexte())
+
+
+def test_rendre_prompt_variables() -> None:
+    gabarit = lire_prompt().decode("utf-8")
+    with pytest.raises(UsineErreur, match="classification"):
+        rendre_prompt(gabarit, {"cle_ticket": "DEMO-1"})
+    assert "DEMO-1" in rendre_prompt(gabarit, {"cle_ticket": "DEMO-1", "ticket": "t"})
+
+
+def test_prompt_cite_les_sept_causes() -> None:
+    gabarit = lire_prompt().decode("utf-8")
+    assert all(f"`{cause.value}`" in gabarit for cause in CauseRacine)
+
+
+def test_aucune_cause_racine_dans_les_adaptateurs_jira() -> None:
+    fichiers = [
+        *(RACINE / "src/usine/adaptateurs").glob("jira_*"),
+        *(RACINE / "src/usine/adaptateurs").glob("composite*"),
+    ]
+    assert fichiers
+    for fichier in fichiers:
+        if fichier.is_file():
+            source = fichier.read_text(encoding="utf-8")
+            for motif in ("SortieClassification", "cause_racine", "classification"):
+                assert motif not in source, f"{motif} dans {fichier.name}"
