@@ -0,0 +1,223 @@
+"""Tâche `classification` : Cause racine proposée pour chaque Anomalie (FR-35, H-18).
+
+Un appel par Anomalie des `TicketTexte`, par la passerelle (AD-12) ; le prompt
+`prompts/classification.md` reçoit la clé, le titre et la description, entre délimiteurs
+(données, pas instructions), sans Date d'arrêté. L'incrémentalité vient du cache : la Date
+d'arrêté n'entre pas dans la clé de cache d'une classification, si bien qu'une Anomalie
+inchangée est servie sans appel ; seule une Anomalie nouvelle ou dont le texte a changé part
+au fournisseur, pseudonymisée.
+
+Le contrôle déterministe retire de la justification toute phrase qui cite une autre clé de
+ticket (`corrige`) ; sinon la sortie est `conforme`. La Cause racine n'est qu'une suggestion :
+elle n'est jamais écrite dans Jira. Plafond de coût atteint (`PlafondCoutAtteint`) : l'Anomalie
+reste sans suggestion, sans faire échouer le Passage. La classification ne dispose que d'une
+part (`PART_PLAFOND_CLASSIFICATION`) du plafond du Passage : explications et narration gardent
+leur budget, et le stock initial se complète sur quelques Passages.
+"""
+
+import logging
+import re
+from collections.abc import Mapping
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+from importlib import resources
+
+import polars as pl
+
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import (
+    ParametresAppel,
+    ReponseClassification,
+    SortieClassification,
+    StatutControle,
+    Tache,
+)
+from usine.contrats.passage import ContextePassage, ResultatEtape, StatutEtape
+from usine.contrats.tickets import TypeTicket, rang_cle
+from usine.contrats.trace import EntreeTrace
+from usine.contrats.versions import version_prompt
+from usine.ia.controles import citations, decouper_phrases, projet, retirer_citations_hors
+from usine.ia.passerelle import ContexteAppel, Controle, Passerelle, PlafondCoutAtteint
+from usine.ports.consultation import Consultation
+
+MAX_JETONS_SORTIE = 256
+"""Plafond de jetons de sortie d'une classification."""
+
+PART_PLAFOND_CLASSIFICATION = Decimal("0.5")
+"""Part du plafond de coût du Passage ouverte aux appels frais de classification (NFR-9)."""
+
+journal = logging.getLogger(__name__)
+
+_VARIABLE = re.compile(r"\{\{(\w+)\}\}")
+
+DELIMITEUR = "```"
+"""Délimiteur du bloc de données du ticket ; neutralisé dans les textes du ticket."""
+
+
+def lire_prompt() -> bytes:
+    """Octets de `ia/prompts/classification.md` (source de `version_prompt`)."""
+    return (resources.files("usine.ia") / "prompts" / "classification.md").read_bytes()
+
+
+def rendre_prompt(gabarit: str, variables: Mapping[str, str]) -> str:
+    """Remplace chaque `{{nom}}` ; une variable inconnue ou inutilisée lève une `UsineErreur`."""
+    attendues = set(_VARIABLE.findall(gabarit))
+    manquantes = sorted(attendues - set(variables))
+    en_trop = sorted(set(variables) - attendues)
+    if manquantes or en_trop:
+        raise UsineErreur(
+            f"prompt « classification » : variables manquantes {manquantes}, en trop {en_trop}"
+        )
+    return _VARIABLE.sub(lambda m: variables[m.group(1)], gabarit)
+
+
+@dataclass(frozen=True)
+class ContexteClassification:
+    """Contexte du Passage commun aux classifications."""
+
+    passage_id: str
+    version_donnees: str
+    version_grille: str
+    """Tracée seulement (AD-16) : la grille n'entre pas dans la classification."""
+    gabarit: bytes
+    """Octets du gabarit envoyé (source de `version_prompt`)."""
+    plafond_eur: Decimal | None = None
+    """Part du plafond de coût du Passage ouverte à la classification ; `None` : aucune."""
+
+    @property
+    def version_prompt(self) -> str:
+        """`version_prompt` du gabarit envoyé."""
+        return version_prompt(self.gabarit)
+
+    @property
+    def texte_gabarit(self) -> str:
+        """Gabarit décodé en UTF-8."""
+        return self.gabarit.decode("utf-8")
+
+
+def _donnee(texte: str) -> str:
+    """Texte de ticket sans délimiteur : il ne peut pas fermer le bloc de données."""
+    return texte.replace(DELIMITEUR, "'''")
+
+
+@dataclass(frozen=True)
+class _Controleur:
+    """Contrôle d'une `ReponseClassification` : justification sans autre clé de ticket."""
+
+    cle_ticket: str
+
+    def __call__(self, reponse: ReponseClassification) -> Controle[SortieClassification]:
+        autorises = frozenset({self.cle_ticket})
+        projets = frozenset({projet(self.cle_ticket)})
+        retirees = sum(
+            1
+            for phrase in decouper_phrases(reponse.justification)
+            if not citations(phrase, projets) <= autorises
+        )
+        statut = StatutControle.corrige if retirees else StatutControle.conforme
+        sortie = SortieClassification(
+            cle_ticket=self.cle_ticket,
+            cause_racine=reponse.cause_racine,
+            justification=(
+                retirer_citations_hors(reponse.justification, autorises)
+                if retirees
+                else reponse.justification
+            ),
+            statut_controle=statut,
+        )
+        return Controle(sortie, statut, retirees)
+
+
+def classer(
+    passerelle: Passerelle,
+    textes: pl.DataFrame,
+    date_arrete: date,
+    contexte: ContexteClassification,
+) -> tuple[tuple[SortieClassification, ...], tuple[EntreeTrace, ...]]:
+    """Cause racine de chaque Anomalie de `textes` (triées par `rang_cle`) et traces des appels.
+
+    Les cas de test et Certifications sont ignorés. Une Anomalie refusée par le plafond est
+    absente de la sortie ; toute autre erreur du fournisseur est propagée.
+    """
+    anomalies = textes.filter(pl.col("type_ticket") == TypeTicket.anomalie.value)
+    lignes = sorted(
+        anomalies.iter_rows(named=True), key=lambda ligne: rang_cle(ligne["cle_ticket"])
+    )
+    parametres = ParametresAppel(tache=Tache.classification, max_jetons_sortie=MAX_JETONS_SORTIE)
+    sorties: list[SortieClassification] = []
+    traces: list[EntreeTrace] = []
+    non_classees = 0
+    for ligne in lignes:
+        cle = ligne["cle_ticket"]
+        titre = ligne["titre"] or "(sans titre)"
+        description = ligne["description"] or "(sans description)"
+        prompt = rendre_prompt(
+            contexte.texte_gabarit,
+            {"cle": cle, "ticket": f"- {cle} : {_donnee(titre)}\n  {_donnee(description)}"},
+        )
+        appel = ContexteAppel(
+            passage_id=contexte.passage_id,
+            date_arrete=date_arrete,
+            cible=cle,
+            version_prompt=contexte.version_prompt,
+            version_grille=contexte.version_grille,
+            version_donnees=contexte.version_donnees,
+            entite=ligne["entite"],
+        )
+        try:
+            resultat = passerelle.executer_structure(
+                prompt,
+                ReponseClassification,
+                parametres,
+                appel,
+                _Controleur(cle),
+                plafond_eur=contexte.plafond_eur,
+            )
+        except PlafondCoutAtteint:
+            non_classees += 1
+            continue
+        sorties.append(resultat.sortie)
+        traces.append(resultat.trace)
+    if non_classees:
+        journal.warning(
+            "%d Anomalie(s) sans Cause racine proposée : plafond de coût de la classification",
+            non_classees,
+        )
+    return tuple(sorties), tuple(traces)
+
+
+class EtapeClassification:
+    """Propose une Cause racine pour chaque Anomalie des textes du Passage ; n'écrit rien.
+
+    `version_prompt` est calculée à partir des octets du gabarit qu'elle envoie (par défaut
+    `ia/prompts/classification.md`) ; `plafond_eur` borne les appels frais de classification.
+    """
+
+    def __init__(
+        self,
+        passerelle: Passerelle,
+        version_donnees: str,
+        version_grille: str,
+        gabarit: bytes | None = None,
+        plafond_eur: Decimal | None = None,
+    ) -> None:
+        self._passerelle = passerelle
+        self._version_donnees = version_donnees
+        self._version_grille = version_grille
+        self._gabarit = gabarit if gabarit is not None else lire_prompt()
+        self._plafond_eur = plafond_eur
+
+    def executer(self, ctx: ContextePassage[Consultation]) -> ResultatEtape:
+        """Sortie `classification` et une trace par Anomalie classée."""
+        contexte = ContexteClassification(
+            passage_id=ctx.passage_id,
+            version_donnees=self._version_donnees,
+            version_grille=self._version_grille,
+            gabarit=self._gabarit,
+            plafond_eur=self._plafond_eur,
+        )
+        sorties, traces = classer(
+            self._passerelle, ctx.consultation.textes_tickets(), ctx.date_arrete, contexte
+        )
+        return ResultatEtape(StatutEtape.reussie, {"classification": sorties}, traces)
