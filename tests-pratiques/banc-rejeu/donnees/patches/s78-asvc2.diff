@@ -0,0 +1,289 @@
+"""Outils de consultation de l'Agent : matrice d'entrées, lecture seule, Passage réel."""
+
+import ast
+import re
+from datetime import date
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+import usine.ia.agent as paquet_agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.contrats import agent as contrats_agent
+from usine.contrats.agent import (
+    AnomalieResume,
+    ArgumentsGetMeteo,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.passage import ManifestePassage
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+
+JOUR = date(2026, 10, 15)
+AUTRE_JOUR = date(2026, 10, 14)
+MESSAGE = "aucune donnée pour cette date"
+PORTS_INTERDITS = (
+    "usine.ports.source_tickets",
+    "usine.ports.entrepot",
+    "usine.ports.etape",
+    "usine.ports.fournisseur_llm",
+    "usine.ports.cache_llm",
+)
+OUTILS_DATES = ("get_meteo", "list_anomalies", "get_prevision", "get_risques")
+
+
+def _anomalie(cle: str, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=cle,
+        entite="ENT-A",
+        gravite=Gravite.majeure,
+        phase=Phase.recette,
+        domaine="D1",
+        statut=statut,
+        age_jours_ouvres=1,
+    )
+
+
+class _Manifeste:
+    date_arrete = JOUR
+
+
+class ConsultationFactice:
+    """Sous-ensemble de `Consultation` lu par les outils ; consigne les lectures."""
+
+    def __init__(self, dates: tuple[date, ...] = (AUTRE_JOUR, JOUR)) -> None:
+        self.dates = dates
+        self.appels: list[tuple[str, Any]] = []
+        statuts = (
+            StatutAnomalie.nouvelle,
+            StatutAnomalie.en_analyse,
+            StatutAnomalie.en_analyse,
+            StatutAnomalie.en_analyse,
+            StatutAnomalie.a_retester,
+        )
+        self.anomalies_passage = tuple(
+            _anomalie(f"MIG-{i}", s) for i, s in enumerate(statuts, start=1)
+        )
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self.dates
+
+    def manifeste(self) -> ManifestePassage:
+        return _Manifeste()  # type: ignore[return-value]
+
+    def meteo(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.appels.append(("meteo", date_arrete))
+        return ()
+
+    def evolution_meteo(self, date_arrete: date | None = None) -> tuple[()]:
+        return ()
+
+    def anomalies(
+        self,
+        date_arrete: date | None = None,
+        entite: str | None = None,
+        gravite: Gravite | None = None,
+        phase: Phase | None = None,
+        domaine: str | None = None,
+        limite: int | None = None,
+        palier: int = 2,
+    ) -> ResultatListAnomalies:
+        self.appels.append(("anomalies", limite))
+        return ResultatListAnomalies(
+            date_arrete=date_arrete or JOUR,
+            anomalies=self.anomalies_passage[:limite],
+            total=len(self.anomalies_passage),
+        )
+
+    def tendances(self, entite: str | None = None, code_kpi: str | None = None) -> pl.DataFrame:
+        return pl.DataFrame(
+            {
+                "date": [JOUR],
+                "perimetre": ["ENT-A"],
+                "code_kpi": ["KPI-1"],
+                "dimension": ["total"],
+                "numerateur": [3],
+                "denominateur": [5],
+                "extra": ["ignoré"],
+            }
+        )
+
+    def previsions(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.appels.append(("previsions", date_arrete))
+        return ()
+
+    def risques(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.appels.append(("risques", date_arrete))
+        return ()
+
+
+def _executer(consultation: Any, nom: str, arguments: dict[str, Any]) -> Any:
+    outil = {o.nom: o for o in outils_consultation(consultation)}[nom]
+    return outil.executer(arguments)
+
+
+class TestMatriceEntreesSorties:
+    @pytest.mark.parametrize("nom", OUTILS_DATES)
+    def test_date_absente_prend_la_date_du_manifeste(self, nom: str) -> None:
+        resultat = _executer(ConsultationFactice(), nom, {})
+        assert resultat.date_arrete == JOUR
+
+    @pytest.mark.parametrize("nom", OUTILS_DATES)
+    def test_date_disponible(self, nom: str) -> None:
+        resultat = _executer(ConsultationFactice(), nom, {"date_arrete": AUTRE_JOUR})
+        assert resultat.date_arrete == AUTRE_JOUR
+
+    @pytest.mark.parametrize("nom", OUTILS_DATES)
+    def test_date_sans_passage(self, nom: str) -> None:
+        consultation = ConsultationFactice()
+        resultat = _executer(consultation, nom, {"date_arrete": date(2026, 1, 1)})
+        assert resultat == AucuneDonnee(date_arrete=date(2026, 1, 1), message=MESSAGE)
+        assert consultation.appels == []
+
+    @pytest.mark.parametrize("nom", OUTILS_DATES)
+    def test_aucune_date_disponible(self, nom: str) -> None:
+        resultat = _executer(ConsultationFactice(dates=()), nom, {})
+        assert resultat == AucuneDonnee(date_arrete=None, message=MESSAGE)
+
+    def test_filtre_statut_et_limite(self) -> None:
+        resultat = _executer(
+            ConsultationFactice(), "list_anomalies", {"statut": "en_analyse", "limite": 2}
+        )
+        assert isinstance(resultat, ResultatListAnomalies)
+        assert [a.cle_ticket for a in resultat.anomalies] == ["MIG-2", "MIG-3"]
+        assert resultat.total == 3
+
+    def test_sans_statut_la_limite_passe_au_port(self) -> None:
+        consultation = ConsultationFactice()
+        resultat = _executer(consultation, "list_anomalies", {"limite": 2})
+        assert ("anomalies", 2) in consultation.appels
+        assert resultat.total == 5
+
+    def test_tendance_ne_rend_jamais_aucune_donnee(self) -> None:
+        resultat = _executer(ConsultationFactice(dates=()), "get_tendance", {})
+        assert resultat == ResultatGetTendance(
+            points=(
+                PointTendance(
+                    date=JOUR,
+                    perimetre="ENT-A",
+                    code_kpi="KPI-1",
+                    dimension="total",
+                    numerateur=3,
+                    denominateur=5,
+                ),
+            )
+        )
+
+    @pytest.mark.parametrize(
+        ("nom", "arguments"),
+        [
+            ("get_meteo", {"date_arrete": "pas une date"}),
+            ("list_anomalies", {"limite": 0}),
+            ("list_anomalies", {"statut": "inconnu"}),
+            ("get_tendance", {"inconnu": 1}),
+        ],
+    )
+    def test_arguments_invalides(self, nom: str, arguments: dict[str, Any]) -> None:
+        with pytest.raises(ValidationError):
+            _executer(ConsultationFactice(), nom, arguments)
+
+    def test_methodes_typees(self) -> None:
+        outils = OutilsConsultation(ConsultationFactice())
+        assert isinstance(outils.get_meteo(ArgumentsGetMeteo()), ResultatGetMeteo)
+        liste = outils.list_anomalies(ArgumentsListAnomalies(statut=StatutAnomalie.nouvelle))
+        assert isinstance(liste, ResultatListAnomalies)
+        assert liste.total == 1
+
+
+class TestLectureSeule:
+    def test_noms_exacts_et_contrats(self) -> None:
+        outils = outils_consultation(ConsultationFactice())
+        assert tuple(o.nom for o in outils) == NOMS_OUTILS
+        assert set(NOMS_OUTILS) == {
+            "get_meteo",
+            "list_anomalies",
+            "get_tendance",
+            "get_prevision",
+            "get_risques",
+        }
+        for outil in outils:
+            assert outil.description
+            assert outil.arguments.__module__ == contrats_agent.__name__
+            assert outil.arguments.__name__.startswith("Arguments")
+
+    def test_aucun_verbe_d_ecriture(self) -> None:
+        verbes = "set|write|create|update|delete|send|post|put|add|save|comment|transition"
+        for nom in NOMS_OUTILS:
+            assert not re.search(rf"(^|_)({verbes})(_|$)", nom)
+        publiques = [n for n in dir(OutilsConsultation) if not n.startswith("_")]
+        assert sorted(publiques) == sorted(NOMS_OUTILS)
+
+    def test_imports_de_ia_agent(self) -> None:
+        modules: set[str] = set()
+        for chemin in Path(paquet_agent.__file__).parent.glob("*.py"):
+            if chemin.name == "cli.py":
+                continue
+            source = chemin.read_text(encoding="utf-8")
+            assert "url_ticket" not in source
+            assert "SourceTickets" not in source
+            for noeud in ast.walk(ast.parse(source)):
+                if isinstance(noeud, ast.Import):
+                    modules.update(a.name for a in noeud.names)
+                elif isinstance(noeud, ast.ImportFrom) and noeud.module:
+                    modules.add(noeud.module)
+                    modules.update(f"{noeud.module}.{a.name}" for a in noeud.names)
+        for module in modules:
+            assert not module.startswith(PORTS_INTERDITS), module
+            assert not module.startswith(("usine.adaptateurs", "pydantic_ai", "httpx")), module
+            if module.startswith("usine.ports"):
+                assert module.startswith("usine.ports.consultation"), module
+
+
+class TestPassageReel:
+    @pytest.fixture
+    def consultation(self) -> Any:
+        return passage_palier_2().consultation
+
+    def test_date_absente_remplit_les_resultats(self, consultation: Any) -> None:
+        jour = consultation.manifeste().date_arrete
+        meteo = _executer(consultation, "get_meteo", {})
+        assert isinstance(meteo, ResultatGetMeteo)
+        assert meteo.date_arrete == jour
+        assert meteo.meteos
+        prevision = _executer(consultation, "get_prevision", {})
+        assert isinstance(prevision, ResultatGetPrevision)
+        assert prevision.previsions
+        risques = _executer(consultation, "get_risques", {})
+        assert isinstance(risques, ResultatGetRisques)
+        assert risques.risques
+        anomalies = _executer(consultation, "list_anomalies", {"limite": 1})
+        assert isinstance(anomalies, ResultatListAnomalies)
+        assert anomalies.date_arrete == jour
+        assert len(anomalies.anomalies) <= 1
+        assert isinstance(_executer(consultation, "get_tendance", {}), ResultatGetTendance)
+
+    def test_statut_filtre_sur_le_passage(self, consultation: Any) -> None:
+        toutes = _executer(consultation, "list_anomalies", {"limite": 1000})
+        for statut in StatutAnomalie:
+            if statut is StatutAnomalie.fermee:
+                continue
+            resultat = _executer(consultation, "list_anomalies", {"statut": statut.value})
+            attendu = [a for a in toutes.anomalies if a.statut == statut]
+            assert list(resultat.anomalies) == attendu
+            assert resultat.total == len(attendu)
+
+    @pytest.mark.parametrize("nom", OUTILS_DATES)
+    def test_date_sans_passage(self, consultation: Any, nom: str) -> None:
+        jour = date(1900, 1, 1)
+        resultat = _executer(consultation, nom, {"date_arrete": jour})
+        assert resultat == AucuneDonnee(date_arrete=jour, message=MESSAGE)
