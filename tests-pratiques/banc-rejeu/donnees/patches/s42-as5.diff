@@ -0,0 +1,391 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Table `SCHEMA_INDICATEUR` d'ENT-A sur 10 Jours ouvrés
+finissant à D = vendredi 09/10/2026 ; Météo orange ; Grille par défaut (rouge : IND-1 `>= 3`,
+IND-3 `>= 20`, IND-4 `>= 1/5`). x = 0..9, projection à x = 9 + h.
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → franchissement à D + 1 JO.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σ(x − 4,5)(y − 0,8) = 8,2, Σ(x − 4,5)² = 82,5 → pente 41/165,
+  ordonnée −23/55 ; p(4) = 464/165 < 3, p(5) = 101/33 ≥ 3 → franchissement à D + 5 JO.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+from collections.abc import Sequence
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from usine.config.chargeur import charger_yaml
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-A"
+VERSION_GRILLE = "grille-test"
+GRILLE = charger_yaml(RACINE / "config" / "grille_meteo.yaml", GrilleMeteo)
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+Valeur = tuple[int, int] | None
+"""(numérateur, dénominateur) évalué ; `None` = non évaluable (0/0)."""
+
+
+def _entier(valeurs: list[int]) -> list[Valeur]:
+    return [(v, 1) for v in valeurs]
+
+
+CONSTANTE_1: list[Valeur] = _entier([0] * 10)
+CONSTANTE_3: list[Valeur] = _entier([0] * 10)
+CONSTANTE_4: list[Valeur] = [(0, 100)] * 10
+
+
+def _table(
+    ind_1: Sequence[Valeur] = CONSTANTE_1,
+    ind_3: Sequence[Valeur] = CONSTANTE_3,
+    ind_4: Sequence[Valeur] = CONSTANTE_4,
+    entite: str = ENTITE,
+    fin: date = D,
+    motif: str = "moins de 20 tests exécutés",
+) -> pl.DataFrame:
+    lignes: list[dict[str, object]] = []
+    for code, serie in ((IND_1, ind_1), (IND_3, ind_3), (IND_4, ind_4)):
+        jours = jours_ouvres(date(2026, 1, 1), fin)[-len(serie) :]
+        for jour, valeur in zip(jours, serie, strict=True):
+            evalue = valeur is not None
+            lignes.append(
+                {
+                    "date": jour,
+                    "entite": entite,
+                    "code": code.value,
+                    "statut": (
+                        StatutIndicateur.evalue if evalue else StatutIndicateur.non_evaluable
+                    ),
+                    "motif": "" if evalue else motif,
+                    "numerateur": valeur[0] if valeur else 0,
+                    "denominateur": valeur[1] if valeur else 0,
+                    "couleur": Couleur.vert.value,
+                }
+            )
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regles = (
+        RegleDeclenchante(
+            code=CodeIndicateur.ind_5,
+            couleur=couleur,
+            operateur=Operateur.superieur_ou_egal,
+            numerateur=1,
+            denominateur=1,
+            seuil_numerateur=1,
+            seuil_denominateur=1,
+            tickets_en_cause=(),
+        ),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=regles,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _calculer(table: pl.DataFrame, **kwargs: int) -> ResultatRisque:
+    return risques_entree_rouge(table, _meteo(), GRILLE, ParametresRisque(**kwargs))
+
+
+def _grille_sans(code: CodeIndicateur, **modifs: object) -> GrilleMeteo:
+    regle = GRILLE.indicateurs[code].model_copy(update=modifs)
+    return GRILLE.model_copy(update={"indicateurs": {**GRILLE.indicateurs, code: regle}})
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = _calculer(_table(ind_3=_entier(list(range(10, 20)))))
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 12)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (19, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (20, 1)
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = _calculer(_table(ind_1=_entier([0, 0, 0, 0, 0, 1, 1, 1, 2, 2])))
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_horizon_plus_court_ne_voit_pas_le_franchissement() -> None:
+    table = _table(ind_1=_entier([0, 0, 0, 0, 0, 1, 1, 1, 2, 2]))
+
+    assert _calculer(table, horizon=4).risques == ()
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = _calculer(_table(ind_4=[(v, 100) for v in range(5, 15)]))
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_hausse_suffisante_ind_4() -> None:
+    resultat = _calculer(_table(ind_4=[(v, 100) for v in range(10, 20)]))
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_4]
+    assert resultat.risques[0].valeur_projetee == Fraction(1, 5)
+    assert (resultat.risques[0].risque.numerateur, resultat.risques[0].risque.denominateur) == (
+        19,
+        100,
+    )
+
+
+def test_stable_ou_en_baisse() -> None:
+    resultat = _calculer(
+        _table(
+            ind_1=_entier([2] * 10),
+            ind_3=_entier(list(range(19, 9, -1))),
+            ind_4=[(v, 100) for v in range(19, 9, -1)],
+        )
+    )
+
+    assert resultat == ResultatRisque((), ())
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    ind_4: list[Valeur] = [(1, 100)] * 10
+    ind_4[3] = None
+    resultat = _calculer(
+        _table(
+            ind_1=_entier([0, 0, 0, 0, 0, 1, 1, 1, 2, 2]),
+            ind_3=_entier(list(range(10, 20))),
+            ind_4=ind_4,
+        )
+    )
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1, IND_3]
+    (exclu,) = resultat.exclus
+    assert exclu.code is IND_4
+    assert "2026-10-01" in exclu.motif
+    assert "moins de 20 tests exécutés" in exclu.motif
+
+
+def test_ordre_des_codes() -> None:
+    resultat = _calculer(
+        _table(
+            ind_1=_entier([0, 0, 0, 0, 0, 1, 1, 1, 2, 2]),
+            ind_3=_entier(list(range(10, 20))),
+        )
+    )
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1, IND_3]
+
+
+def test_historique_court() -> None:
+    un_seul = _calculer(_table(ind_3=_entier([19])))
+
+    assert un_seul.risques == ()
+    assert [(e.code, "historique insuffisant" in e.motif) for e in un_seul.exclus] == [
+        (IND_3, True)
+    ]
+    # 2 JO : régression sur les JO présents (pente 10, p(1) = 29 ≥ 20).
+    deux = _calculer(_table(ind_3=_entier([9, 19])))
+    assert [r.risque.indicateur for r in deux.risques] == [IND_3]
+    assert deux.risques[0].valeur_projetee == Fraction(29)
+    # 9 JO : 11..19, pente 1, p(1) = 20.
+    neuf = _calculer(_table(ind_3=_entier(list(range(11, 20)))))
+    assert neuf.risques[0].valeur_projetee == Fraction(20)
+    assert neuf.exclus == ()
+
