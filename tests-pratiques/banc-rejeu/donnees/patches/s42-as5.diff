+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Elle lit
+la table des indicateurs (`SCHEMA_INDICATEUR`) d'une Entité non rouge à la Date d'arrêté D et,
+pour IND-1, IND-3 et IND-4 :
+
+- ajuste une régression linéaire (moindres carrés) sur les `fenetre` derniers Jours ouvrés
+  finissant à D (x = 0..n−1, n ≥ 2) ;
+- la projette de 1 à `horizon` Jours ouvrés après D ; le premier horizon dont la valeur projetée
+  déclenche la règle rouge de la Grille donne un `RisqueEntreeRouge` (date de franchissement
+  estimée) et sa valeur projetée ;
+- écarte, avec leur motif, les indicateurs sans seuil rouge actif, non évaluables sur la
+  fenêtre ou à l'historique insuffisant.
+
+Le contrat `RisqueEntreeRouge` porte la valeur courante : la valeur projetée est rendue à côté
+(`RisqueProjete`). Avance en Jours ouvrés et test de seuil viennent de `commun` (AD-18).
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite, Operateur
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque : paramètre {nom} invalide {valeur!r} (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée de l'indicateur à la date de franchissement."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D sont
+    lues, et celles de chaque indicateur actif doivent former des Jours ouvrés consécutifs
+    finissant à D. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la table
+    est invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo {meteo.couleur}, non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+    table = table.filter((pl.col("entite") == entite) & (pl.col("date") <= meteo.date_arrete))
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in (c for c in CodeIndicateur if c in PROJETES):
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active or Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, f"{code} sans seuil rouge actif dans la Grille"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        points = _serie(table, code, meteo, parametres.fenetre)
+        if isinstance(points, str):
+            exclus.append(IndicateurExclu(code, points))
+            continue
+        projete = _projeter(points, operateur, seuil, parametres.horizon, meteo, code)
+        if projete is not None:
+            risques.append(projete)
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _serie(
+    table: pl.DataFrame, code: CodeIndicateur, meteo: MeteoEntite, fenetre: int
+) -> list[Fraction] | str:
+    """Valeurs des `fenetre` derniers Jours ouvrés finissant à D, ou le motif d'exclusion."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = table.filter(pl.col("code") == code.value).sort("date").to_dicts()
+    precedent: date | None = None
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} : {code} {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if precedent == jour:
+            raise UsineErreur(f"Risque {entite} : {code} date {jour.isoformat()} en double")
+        if precedent is not None and jour_ouvre_suivant(precedent) != jour:
+            raise UsineErreur(
+                f"Risque {entite} : {code} trou de Jours ouvrés entre"
+                f" {precedent.isoformat()} et {jour.isoformat()}"
+            )
+        precedent = jour
+    if precedent != arrete:
+        raise UsineErreur(
+            f"Risque {entite} : Date d'arrêté {arrete.isoformat()} absente pour {code}"
+        )
+    fenetre_lignes = lignes[-fenetre:]
+    for ligne in fenetre_lignes:
+        if ligne["statut"] == StatutIndicateur.non_evaluable:
+            return (
+                f"{code} non évaluable le {ligne['date'].isoformat()} : {ligne['motif']}"
+                " (exclu de la projection)"
+            )
+        if ligne["denominateur"] <= 0:
+            raise UsineErreur(
+                f"Risque {entite} : {code} {ligne['date'].isoformat()} évalué avec un"
+                f" dénominateur {ligne['denominateur']}"
+            )
+    if len(fenetre_lignes) < 2:
+        return f"{code} : historique insuffisant ({len(fenetre_lignes)} Jour ouvré)"
+    return [Fraction(ligne["numerateur"], ligne["denominateur"]) for ligne in fenetre_lignes]
+
+
+def _projeter(
+    ys: list[Fraction],
+    operateur: Operateur,
+    seuil: Fraction,
+    horizon: int,
+    meteo: MeteoEntite,
+    code: CodeIndicateur,
+) -> RisqueProjete | None:
+    """Premier horizon dont la projection linéaire des moindres carrés déclenche le seuil."""
+    n = len(ys)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(ys, Fraction(0)) / n
+    ecarts = [Fraction(x) - x_moyen for x in range(n)]
+    pente = sum((e * (y - y_moyen) for e, y in zip(ecarts, ys, strict=True)), Fraction(0)) / sum(
+        (e * e for e in ecarts), Fraction(0)
+    )
+    ordonnee = y_moyen - pente * x_moyen
+    for h in range(1, horizon + 1):
+        valeur = ordonnee + pente * (n - 1 + h)
+        if declenche(valeur, operateur, seuil):
+            courante = ys[-1]
+            risque = RisqueEntreeRouge(
+                date_arrete=meteo.date_arrete,
+                entite=meteo.entite,
+                indicateur=code,
+                date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                horizon_jours_ouvres=horizon,
+                numerateur=courante.numerator,
+                denominateur=courante.denominator,
+                seuil_numerateur=seuil.numerator,
+                seuil_denominateur=seuil.denominator,
+                version_grille=meteo.version_grille,
+            )
+            return RisqueProjete(risque, valeur)
+    return None
