@@ -0,0 +1,211 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Pour
+une Entité non rouge à la Date d'arrêté D, elle ajuste une régression linéaire (moindres
+carrés) sur les `fenetre` derniers Jours ouvrés d'IND-1, IND-3 et IND-4, la projette de 1 à
+`horizon` Jours ouvrés après D et émet un `RisqueEntreeRouge` par indicateur dont une
+projection déclenche la règle rouge de la Grille.
+
+Les indicateurs écartés (inactifs ou sans seuil rouge, non évaluables sur la fenêtre,
+historique insuffisant) sont restitués avec leur motif. Les primitives partagées avec la
+Baseline (avance en Jours ouvrés, test de seuil) vivent dans `commun`.
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite, Operateur
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+INDICATEURS_PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque d'entrée en rouge : paramètre {nom} invalide {valeur!r}"
+                    " (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée à la date de franchissement estimée."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+@dataclass(frozen=True)
+class _Point:
+    date: date
+    evalue: bool
+    motif: str
+    numerateur: int
+    denominateur: int
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D
+    sont lues. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la table
+    est invalide pour un indicateur actif.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, Entité non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in INDICATEURS_PROJETES:
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, f"{code} inactif dans la Grille"))
+            continue
+        seuil_rouge = regle.seuils.get(Couleur.rouge)
+        if seuil_rouge is None:
+            exclus.append(IndicateurExclu(code, f"{code} sans seuil rouge dans la Grille"))
+            continue
+        points = _points(table, meteo, code, parametres.fenetre)
+        non_evalue = next((p for p in points if not p.evalue), None)
+        if non_evalue is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"{code} non évaluable le {non_evalue.date.isoformat()} : {non_evalue.motif}",
+                )
+            )
+            continue
+        if len(points) < 2:
+            exclus.append(IndicateurExclu(code, f"{code} : historique insuffisant (1 Jour ouvré)"))
+            continue
+        risque = _risque(meteo, code, points, seuil_rouge, parametres.horizon)
+        if risque is not None:
+            risques.append(risque)
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _points(
+    table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur, fenetre: int
+) -> list[_Point]:
+    """Les `fenetre` derniers Jours ouvrés de l'indicateur jusqu'à D, contrôlés et ordonnés."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = (
+        table.filter(
+            (pl.col("entite") == entite) & (pl.col("code") == code) & (pl.col("date") <= arrete)
+        )
+        .sort("date")
+        .to_dicts()
+    )
+    points: list[_Point] = []
+    for ligne in lignes[-fenetre:]:
+        jour: date = ligne["date"]
+        nom = f"Risque {entite} {code}"
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(f"{nom} : {jour.isoformat()} n'est pas un Jour ouvré")
+        if points and points[-1].date == jour:
+            raise UsineErreur(f"{nom} : date {jour.isoformat()} en double")
+        if points and jour_ouvre_suivant(points[-1].date) != jour:
+            raise UsineErreur(
+                f"{nom} : trou de Jours ouvrés entre"
+                f" {points[-1].date.isoformat()} et {jour.isoformat()}"
+            )
+        evalue = ligne["statut"] == StatutIndicateur.evalue
+        if evalue and ligne["denominateur"] <= 0:
+            raise UsineErreur(
+                f"{nom} : valeur évaluée de dénominateur {ligne['denominateur']}"
+                f" le {jour.isoformat()}"
+            )
+        points.append(
+            _Point(jour, evalue, ligne["motif"], ligne["numerateur"], ligne["denominateur"])
+        )
+    if not points or points[-1].date != arrete:
+        raise UsineErreur(
+            f"Risque {entite} {code} : Date d'arrêté {arrete.isoformat()} absente de la table"
+        )
+    return points
+
+
+def _risque(
+    meteo: MeteoEntite,
+    code: CodeIndicateur,
+    points: list[_Point],
+    seuil: tuple[Operateur, Fraction],
+    horizon: int,
+) -> RisqueProjete | None:
+    """Premier horizon h où la régression linéaire projetée déclenche le seuil rouge."""
+    operateur, valeur_seuil = seuil
+    n = len(points)
+    y = [Fraction(p.numerateur, p.denominateur) for p in points]
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(y, Fraction(0)) / n
+    covariance = sum(
+        ((Fraction(i) - x_moyen) * (v - y_moyen) for i, v in enumerate(y)), Fraction(0)
+    )
+    variance = sum(((Fraction(i) - x_moyen) ** 2 for i in range(n)), Fraction(0))
+    pente = covariance / variance
+    ordonnee = y_moyen - pente * x_moyen
+    for h in range(1, horizon + 1):
+        projetee = ordonnee + pente * (n - 1 + h)
+        if declenche(projetee, operateur, valeur_seuil):
+            courant = points[-1]
+            return RisqueProjete(
+                risque=RisqueEntreeRouge(
+                    date_arrete=meteo.date_arrete,
+                    entite=meteo.entite,
+                    indicateur=code,
+                    date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                    horizon_jours_ouvres=horizon,
+                    numerateur=courant.numerateur,
+                    denominateur=courant.denominateur,
+                    seuil_numerateur=valeur_seuil.numerator,
+                    seuil_denominateur=valeur_seuil.denominator,
+                    version_grille=meteo.version_grille,
+                ),
+                valeur_projetee=projetee,
+            )
+    return None
