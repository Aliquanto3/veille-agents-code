@@ -0,0 +1,359 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Fenêtre de 10 Jours ouvrés finissant à D = vendredi
+09/10/2026, x = 0..9, projection à x = 9 + h. Grille livrée (rouge : IND-1 `>= 3`,
+IND-3 `>= 20`, IND-4 `>= 0.20`) ; D + 1 = lundi 12/10, D + 5 = vendredi 16/10.
+
+- IND-3 = 10..19 : pente 1, ordonnée 10 ; h = 1 → 20 ≥ 20.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σy = 7, ȳ = 7/10, x̄ = 9/2, Σ(x − x̄)² = 165/2,
+  Σ(x − x̄)(y − ȳ) = 41/2 → pente 41/165, ordonnée 7/10 − 41/165·9/2 = −23/55 ;
+  h = 4 → 464/165 < 3 ; h = 5 → 101/33 ≥ 3.
+- IND-4 = 5/100..14/100 : pente 1/100, ordonnée 5/100 ; h = 5 → 19/100 < 1/5.
+"""
+
+from collections.abc import Sequence
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import ParametresRisque, risques_entree_rouge
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-A"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Serie = Sequence[tuple[int, int] | str]
+"""Valeurs (numérateur, dénominateur) ; une chaîne = non évaluable avec ce motif."""
+
+PLATES: dict[CodeIndicateur, Serie] = {
+    IND_1: [(0, 1)] * 10,
+    IND_3: [(0, 1)] * 10,
+    IND_4: [(0, 1)] * 10,
+}
+
+
+def _table(
+    series: dict[CodeIndicateur, Serie],
+    fin: date = D,
+    entite: str = ENTITE,
+    dates: list[date] | None = None,
+) -> pl.DataFrame:
+    lignes: list[dict[str, Any]] = []
+    for code, valeurs in series.items():
+        jours = dates or jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+        for jour, valeur in zip(jours, valeurs, strict=True):
+            evalue = not isinstance(valeur, str)
+            lignes.append(
+                {
+                    "date": jour,
+                    "entite": entite,
+                    "code": code.value,
+                    "statut": "evalue" if evalue else "non_evaluable",
+                    "motif": "" if evalue else valeur,
+                    "numerateur": valeur[0] if not isinstance(valeur, str) else 0,
+                    "denominateur": valeur[1] if not isinstance(valeur, str) else 0,
+                    "couleur": "vert",
+                }
+            )
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _grille(**regles: Any) -> GrilleMeteo:
+    donnees: dict[str, Any] = yaml.safe_load(
+        (RACINE / "config" / "grille_meteo.yaml").read_text(encoding="utf-8")
+    )
+    donnees["indicateurs"].update(regles)
+    return GrilleMeteo.model_validate(donnees)
+
+
+GRILLE = _grille()
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regles = (
+        ()
+        if couleur is Couleur.vert
+        else (
+            RegleDeclenchante(
+                code=IND_1,
+                couleur=couleur,
+                operateur=Operateur.superieur_ou_egal,
+                numerateur=2,
+                denominateur=1,
+                seuil_numerateur=2,
+                seuil_denominateur=1,
+                tickets_en_cause=(),
+            ),
+        )
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=regles,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _calculer(series: dict[CodeIndicateur, Serie], **kw: Any) -> risque.ResultatRisque:
+    return risques_entree_rouge(_table(series), _meteo(), kw.pop("grille", GRILLE), **kw)
+
+
+def _avec(**series: Serie) -> dict[CodeIndicateur, Serie]:
+    remplacements = {CodeIndicateur(c.replace("_", "-").upper()): v for c, v in series.items()}
+    return {**PLATES, **remplacements}
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = _calculer(_avec(ind_3=[(10 + i, 1) for i in range(10)]))
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.date_franchissement_estimee == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert (r.date_arrete, r.entite) == (D, ENTITE)
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = _calculer(_avec(ind_1=[(v, 1) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]))
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = _calculer(_avec(ind_4=[(5 + i, 100) for i in range(10)]))
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_horizon_plus_court_n_emet_pas_ind_1() -> None:
+    serie = _avec(ind_1=[(v, 1) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)])
+
+    assert _calculer(serie, parametres=ParametresRisque(horizon=4)).risques == ()
+
+
+@pytest.mark.parametrize("descendante", [False, True])
+def test_stable_ou_en_baisse(descendante: bool) -> None:
+    valeurs: Serie = [(10 - i, 1) for i in range(10)] if descendante else [(2, 1)] * 10
+
+    resultat = _calculer({IND_1: valeurs, IND_3: valeurs, IND_4: [(1, 10)] * 10})
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    ind_4: list[tuple[int, int] | str] = [(5 + i, 100) for i in range(10)]
+    ind_4[3] = "volume de tests insuffisant"
+    ind_4[6] = "autre motif"
+    resultat = _calculer(_avec(ind_3=[(10 + i, 1) for i in range(10)], ind_4=ind_4))
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    assert [e.code for e in resultat.exclus] == [IND_4]
+    motif = resultat.exclus[0].motif
+    assert jours_ouvres(date(2026, 1, 1), D)[-7].isoformat() in motif
+    assert "volume de tests insuffisant" in motif
+    assert "autre motif" not in motif
+
+
+def test_historique_court() -> None:
+    serie = _avec(ind_1=[(2, 1)], ind_3=[(18, 1), (19, 1)])
+    resultat = _calculer(serie)
+
+    assert [e.code for e in resultat.exclus] == [IND_1]
+    assert "historique insuffisant" in resultat.exclus[0].motif
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    assert resultat.risques[0].valeur_projetee == Fraction(20)
+
+
+def test_regression_sur_les_jours_presents() -> None:
+    resultat = _calculer(_avec(ind_3=[(14 + i, 1) for i in range(6)]))
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    assert resultat.risques[0].valeur_projetee == Fraction(20)
+    assert resultat.risques[0].risque.date_franchissement_estimee == date(2026, 10, 12)
+
+
+def test_fenetre_limitee_aux_derniers_jours() -> None:
+    ancien = [(100, 1)] * 5 + [(10 + i, 1) for i in range(10)]
+    table = _table(_avec(ind_3=ancien))
+
+    resultat = risques_entree_rouge(table, _meteo(), GRILLE)
+
+    assert resultat.risques[0].valeur_projetee == Fraction(20)
+
+
+def test_lignes_posterieures_et_autres_entites_ignorees() -> None:
+    table = pl.concat(
+        [
+            _table(_avec(ind_3=[(10 + i, 1) for i in range(10)])),
