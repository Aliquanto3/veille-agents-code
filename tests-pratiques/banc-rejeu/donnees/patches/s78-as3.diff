@@ -0,0 +1,187 @@
+"""Outils de consultation de l'Agent : matrice I/O, lecture seule, intégration (Story 7.8)."""
+
+import ast
+from datetime import date
+from pathlib import Path
+from typing import Any
+
+import pytest
+from pydantic import ValidationError
+
+import usine.ia.agent as paquet_agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.contrats import agent as contrats_agent
+from usine.contrats.agent import (
+    AnomalieResume,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+
+JOUR = date(2026, 3, 2)
+ABSENT = date(2020, 1, 1)
+MESSAGE = "aucune donnée pour cette date"
+PORTS_INTERDITS = {
+    "usine.ports.source_tickets",
+    "usine.ports.entrepot",
+    "usine.ports.etape",
+    "usine.ports.fournisseur_llm",
+    "usine.ports.cache_llm",
+}
+
+
+def _anomalie(cle: str, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=cle,
+        entite="ENT-A",
+        gravite=next(iter(Gravite)),
+        phase=next(iter(Phase)),
+        domaine="d",
+        statut=statut,
+        age_jours_ouvres=1,
+    )
+
+
+class _ManifesteFactice:
+    date_arrete = JOUR
+
+
+class _ConsultationFactice:
+    """Consultation factice : trois Anomalies `en_cours` et une d'un autre statut ouvert."""
+
+    def __init__(self, dates: tuple[date, ...] = (JOUR,)) -> None:
+        self._dates = dates
+        self.anomalies_limites: list[int | None] = []
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self._dates
+
+    def manifeste(self) -> _ManifesteFactice:
+        return _ManifesteFactice()
+
+    def meteo(self, date_arrete: Any = None, entite: Any = None) -> tuple[()]:
+        return ()
+
+    def evolution_meteo(self, date_arrete: Any = None) -> tuple[()]:
+        return ()
+
+    def previsions(self, date_arrete: Any = None, entite: Any = None) -> tuple[()]:
+        return ()
+
+    def risques(self, date_arrete: Any = None, entite: Any = None) -> tuple[()]:
+        return ()
+
+    def anomalies(
+        self, date_arrete: Any = None, limite: int | None = None, **_: Any
+    ) -> ResultatListAnomalies:
+        self.anomalies_limites.append(limite)
+        autre = StatutAnomalie.nouvelle
+        toutes = tuple(_anomalie(f"K-{i}", StatutAnomalie.en_correction) for i in range(3))
+        toutes += (_anomalie("K-9", autre),)
+        retenues = toutes if limite is None else toutes[:limite]
+        return ResultatListAnomalies(date_arrete=JOUR, anomalies=retenues, total=len(toutes))
+
+
+def _definitions(consultation: Any) -> dict[str, Any]:
+    return {d.nom: d for d in outils_consultation(consultation)}
+
+
+def test_noms_exacts_et_classes_de_contrats() -> None:
+    definitions = outils_consultation(_ConsultationFactice())  # type: ignore[arg-type]
+    assert tuple(d.nom for d in definitions) == NOMS_OUTILS
+    assert set(NOMS_OUTILS) == {
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    }
+    for d in definitions:
+        assert d.arguments.__module__ == contrats_agent.__name__
+        assert d.description
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_date_sans_passage(nom: str) -> None:
+    resultat = _definitions(_ConsultationFactice())[nom].executer(
+        {"date_arrete": ABSENT.isoformat()}
+    )
+    assert resultat == AucuneDonnee(date_arrete=ABSENT, message=MESSAGE)
+
+
+def test_aucune_date_du_tout() -> None:
+    resultat = _definitions(_ConsultationFactice(()))["get_meteo"].executer({})
+    assert resultat == AucuneDonnee(date_arrete=None)
+
+
+def test_date_absente_prend_le_manifeste() -> None:
+    definitions = _definitions(_ConsultationFactice())
+    assert isinstance(definitions["get_meteo"].executer({}), ResultatGetMeteo)
+    assert definitions["get_prevision"].executer({}).date_arrete == JOUR
+    assert definitions["get_risques"].executer({}).date_arrete == JOUR
+
+
+def test_filtre_statut_et_limite() -> None:
+    fausse = _ConsultationFactice()
+    resultat = _definitions(fausse)["list_anomalies"].executer(
+        {"statut": StatutAnomalie.en_correction.value, "limite": 2}
+    )
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert len(resultat.anomalies) == 2
+    assert resultat.total == 3
+    assert {a.statut for a in resultat.anomalies} == {StatutAnomalie.en_correction}
+    assert fausse.anomalies_limites == [None]
+
+
+def test_sans_statut_la_limite_est_deleguee() -> None:
+    fausse = _ConsultationFactice()
+    _definitions(fausse)["list_anomalies"].executer({"limite": 2})
+    assert fausse.anomalies_limites == [2]
+
+
+def test_arguments_invalides() -> None:
+    with pytest.raises(ValidationError):
+        _definitions(_ConsultationFactice())["list_anomalies"].executer({"limite": 0})
+
+
+def test_lecture_seule() -> None:
+    interdits = ("ecrire", "write", "send", "envoyer", "update", "create", "delete", "post")
+    for nom in NOMS_OUTILS:
+        assert nom.startswith(("get_", "list_"))
+        assert not any(v in nom for v in interdits)
+    publiques = [m for m in vars(OutilsConsultation) if not m.startswith("_")]
+    assert sorted(publiques) == sorted(NOMS_OUTILS)
+    for fichier in Path(paquet_agent.__file__).parent.glob("*.py"):
+        if fichier.name == "cli.py":
+            continue
+        for noeud in ast.walk(ast.parse(fichier.read_text(encoding="utf-8"))):
+            if isinstance(noeud, ast.Import):
+                modules = [a.name for a in noeud.names]
+            elif isinstance(noeud, ast.ImportFrom):
+                modules = [noeud.module or ""]
+            else:
+                continue
+            for module in modules:
+                assert not module.startswith("usine.adaptateurs"), fichier
+                assert module not in PORTS_INTERDITS, fichier
+                assert not module.startswith("pydantic_ai"), fichier
+
+
+def test_integration_passage_palier_2() -> None:
+    cas = passage_palier_2()
+    definitions = _definitions(cas.consultation)
+    jour = cas.consultation.manifeste().date_arrete
+    assert isinstance(definitions["get_meteo"].executer({"entite": cas.entite}), ResultatGetMeteo)
+    anomalies = definitions["list_anomalies"].executer({"entite": cas.entite})
+    assert isinstance(anomalies, ResultatListAnomalies)
+    assert anomalies.date_arrete == jour
+    assert isinstance(definitions["get_tendance"].executer({}), ResultatGetTendance)
+    assert isinstance(definitions["get_prevision"].executer({}), ResultatGetPrevision)
+    assert isinstance(definitions["get_risques"].executer({}), ResultatGetRisques)
+    inconnu = {"date_arrete": ABSENT.isoformat()}
+    assert definitions["get_risques"].executer(inconnu) == AucuneDonnee(date_arrete=ABSENT)
