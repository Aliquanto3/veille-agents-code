+++ b/src/usine/ia/agent/outils.py
@@ -0,0 +1,163 @@
+"""Outils de consultation de l'Agent : lecture seule, servis par `Consultation` (FR-39, FR-41).
+
+Aucun outil n'écrit (Jira, mail, configuration) et l'Agent n'a aucun accès à Jira (AD-5).
+La sérialisation en texte et la Pseudonymisation reviennent à la passerelle (Story 7.9).
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    AnomalieResume,
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS = ("get_meteo", "list_anomalies", "get_tendance", "get_prevision", "get_risques")
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Un outil : nom, description pour le LLM, classe d'arguments et exécution."""
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+
+
+class OutilsConsultation:
+    """Les cinq outils de lecture de l'Agent, lus par le seul port `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _couverte(self, date_arrete: date | None) -> bool:
+        """Vrai si la date (ou la Date d'arrêté du manifeste si absente) a un Passage."""
+        dates = self._consultation.dates_disponibles()
+        if date_arrete is None:
+            return bool(dates)
+        return date_arrete in dates
+
+    def _date(self, date_arrete: date | None) -> date:
+        return self._consultation.manifeste().date_arrete if date_arrete is None else date_arrete
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        if not self._couverte(arguments.date_arrete):
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        c = self._consultation
+        return ResultatGetMeteo(
+            date_arrete=self._date(arguments.date_arrete),
+            meteos=c.meteo(arguments.date_arrete, arguments.entite),
+            evolutions=tuple(
+                e
+                for e in c.evolution_meteo(arguments.date_arrete)
+                if arguments.entite is None or e.entite == arguments.entite
+            ),
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées par Entité, Gravité, Phase, domaine et statut."""
+        if not self._couverte(arguments.date_arrete):
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        limite = arguments.limite if arguments.statut is None else None
+        toutes = self._consultation.anomalies(
+            date_arrete=arguments.date_arrete,
+            entite=arguments.entite,
+            gravite=arguments.gravite,
+            phase=arguments.phase,
+            domaine=arguments.domaine,
+            limite=limite,
+        )
+        if arguments.statut is None:
+            return toutes
+        retenues: tuple[AnomalieResume, ...] = tuple(
+            a for a in toutes.anomalies if a.statut == arguments.statut
+        )
+        return ResultatListAnomalies(
+            date_arrete=toutes.date_arrete,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire (sans date : jamais `AucuneDonnee`)."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        champs = tuple(PointTendance.model_fields)
+        return ResultatGetTendance(
+            points=tuple(PointTendance(**ligne) for ligne in table.select(champs).to_dicts())
+        )
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        if not self._couverte(arguments.date_arrete):
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetPrevision(
+            date_arrete=self._date(arguments.date_arrete),
+            previsions=self._consultation.previsions(arguments.date_arrete, arguments.entite),
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        if not self._couverte(arguments.date_arrete):
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetRisques(
+            date_arrete=self._date(arguments.date_arrete),
+            risques=self._consultation.risques(arguments.date_arrete, arguments.entite),
+        )
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Les cinq outils de lecture, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+    return (
+        DefinitionOutil(
+            "get_meteo",
+            "Météo par Entité, Règles déclenchantes et évolution J-1 / J-5 à une Date d'arrêté.",
+            ArgumentsGetMeteo,
+            lambda a: outils.get_meteo(ArgumentsGetMeteo.model_validate(a)),
+        ),
+        DefinitionOutil(
+            "list_anomalies",
+            "Anomalies ouvertes, filtrées par Entité, Gravité, Phase, domaine et statut.",
+            ArgumentsListAnomalies,
+            lambda a: outils.list_anomalies(ArgumentsListAnomalies.model_validate(a)),
+        ),
+        DefinitionOutil(
+            "get_tendance",
+            "Tendance hebdomadaire des KPI, par Entité et par KPI.",
+            ArgumentsGetTendance,
+            lambda a: outils.get_tendance(ArgumentsGetTendance.model_validate(a)),
+        ),
+        DefinitionOutil(
+            "get_prevision",
+            "Prévisions de sortie du rouge à une Date d'arrêté.",
+            ArgumentsGetPrevision,
+            lambda a: outils.get_prevision(ArgumentsGetPrevision.model_validate(a)),
+        ),
+        DefinitionOutil(
+            "get_risques",
+            "Risques d'entrée en rouge à une Date d'arrêté.",
+            ArgumentsGetRisques,
+            lambda a: outils.get_risques(ArgumentsGetRisques.model_validate(a)),
+        ),
+    )
