@@ -0,0 +1,375 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Fenêtre de 10 Jours ouvrés finissant au vendredi
+09/10/2026 (D), x = 0..9, projection à x = 9 + h. Grille par défaut : rouge IND-1 `>= 3`,
+IND-3 `>= 20`, IND-4 `>= 1/5`.
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → D + 1 JO.
+- IND-1 = 0,0,0,0,0,1,1,1,2,2 : Σy = 7, ȳ = 7/10, Σ(x−x̄)(y−ȳ) = 41/2 (Σxy = 5+6+7+16+18 = 52,
+  x̄ = 9/2 → 52 − 45/2·... ), Σ(x−x̄)² = 165/2 → pente 41/165, ordonnée −23/55 ;
+  p(4) = 464/165 < 3, p(5) = 101/33 ≥ 3 → D + 5 JO.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+import re
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from usine.config import charger_yaml
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite, RegleDeclenchante
+from usine.contrats.meteo import Operateur
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+GRILLE = charger_yaml(RACINE / "config" / "grille_meteo.yaml", GrilleMeteo)
+
+IND_1 = CodeIndicateur.ind_1
+IND_3 = CodeIndicateur.ind_3
+IND_4 = CodeIndicateur.ind_4
+
+STABLE_1 = [1] * 10
+STABLE_3 = [5] * 10
+STABLE_4 = [10] * 10  # en centièmes
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regles = (
+        ()
+        if couleur is Couleur.vert
+        else (
+            RegleDeclenchante(
+                code=CodeIndicateur.ind_5,
+                couleur=couleur,
+                operateur=Operateur.superieur_ou_egal,
+                numerateur=1,
+                denominateur=1,
+                seuil_numerateur=1,
+                seuil_denominateur=1,
+                tickets_en_cause=(),
+            ),
+        )
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=regles,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _lignes(
+    code: CodeIndicateur,
+    valeurs: list[tuple[int, int]],
+    fin: date = D,
+    entite: str = ENTITE,
+    non_evaluables: frozenset[int] = frozenset(),
+    motif: str = "",
+) -> list[dict[str, object]]:
+    dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+    lignes: list[dict[str, object]] = []
+    for i, (jour, (num, den)) in enumerate(zip(dates, valeurs, strict=True)):
+        ne = i in non_evaluables
+        lignes.append(
+            {
+                "date": jour,
+                "entite": entite,
+                "code": code.value,
+                "statut": (StatutIndicateur.non_evaluable if ne else StatutIndicateur.evalue).value,
+                "motif": motif if ne else "",
+                "numerateur": 0 if ne else num,
+                "denominateur": 0 if ne else den,
+                "couleur": Couleur.vert.value,
+            }
+        )
+    return lignes
+
+
+def _table(lignes: list[dict[str, object]]) -> pl.DataFrame:
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _entiers(valeurs: list[int], den: int = 1) -> list[tuple[int, int]]:
+    return [(v, den) for v in valeurs]
+
+
+def _table_defaut(
+    ind_1: list[int] = STABLE_1,
+    ind_3: list[int] = STABLE_3,
+    ind_4: list[int] = STABLE_4,
+) -> pl.DataFrame:
+    return _table(
+        _lignes(IND_1, _entiers(ind_1))
+        + _lignes(IND_3, _entiers(ind_3))
+        + _lignes(IND_4, _entiers(ind_4, 100))
+    )
+
+
+def _grille_sans(code: CodeIndicateur, **changements: object) -> GrilleMeteo:
+    regle = GRILLE.indicateurs[code].model_copy(update=changements)
+    return GRILLE.model_copy(update={"indicateurs": {**GRILLE.indicateurs, code: regle}})
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = risques_entree_rouge(_table_defaut(ind_3=list(range(10, 20))), _meteo(), GRILLE)
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    assert resultat.exclus == ()
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.date_franchissement_estimee == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert r.date_arrete == D
+    assert r.entite == ENTITE
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = risques_entree_rouge(
+        _table_defaut(ind_1=[0, 0, 0, 0, 0, 1, 1, 1, 2, 2]), _meteo(), GRILLE
+    )
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+
+
+def test_horizon_trop_court_ind_1() -> None:
+    resultat = risques_entree_rouge(
+        _table_defaut(ind_1=[0, 0, 0, 0, 0, 1, 1, 1, 2, 2]),
+        _meteo(),
+        GRILLE,
+        ParametresRisque(horizon=4),
+    )
+
+    assert resultat.risques == ()
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = risques_entree_rouge(_table_defaut(ind_4=list(range(5, 15))), _meteo(), GRILLE)
+
+    assert resultat == ResultatRisque((), ())
+
+
+def test_hausse_suffisante_ind_4() -> None:
+    resultat = risques_entree_rouge(_table_defaut(ind_4=list(range(10, 20))), _meteo(), GRILLE)
+
+    # pente 1/100, p(1) = 20/100 = 1/5 ≥ 1/5
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_4]
+    assert resultat.risques[0].valeur_projetee == Fraction(1, 5)
+    assert (resultat.risques[0].risque.numerateur, resultat.risques[0].risque.denominateur) == (
+        19,
+        100,
+    )
+
+
+def test_stable_ou_en_baisse() -> None:
+    table = _table_defaut(
+        ind_1=[2, 2, 2, 2, 2, 2, 2, 2, 2, 2],
+        ind_3=list(range(19, 9, -1)),
+        ind_4=list(range(19, 9, -1)),
+    )
+
+    assert risques_entree_rouge(table, _meteo(), GRILLE) == ResultatRisque((), ())
+
+
+def test_meteo_verte_acceptee() -> None:
+    table = _table_defaut(ind_3=list(range(10, 20)))
+
+    assert len(risques_entree_rouge(table, _meteo(Couleur.vert), GRILLE).risques) == 1
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    lignes = (
+        _lignes(IND_1, _entiers([0, 0, 0, 0, 0, 1, 1, 1, 2, 2]))
+        + _lignes(IND_3, _entiers(list(range(10, 20))))
+        + _lignes(
+            IND_4,
+            _entiers(list(range(10, 20)), 100),
+            non_evaluables=frozenset({3, 4}),
+            motif="moins de 20 tests exécutés",
+        )
+    )
+
+    resultat = risques_entree_rouge(_table(lignes), _meteo(), GRILLE)
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1, IND_3]
+    assert len(resultat.exclus) == 1
+    exclu = resultat.exclus[0]
+    assert exclu.code is IND_4
+    premiere = jours_ouvres(date(2026, 1, 1), D)[-10:][3]
+    assert premiere.isoformat() in exclu.motif
+    assert "moins de 20 tests exécutés" in exclu.motif
+
+
+def test_historique_court() -> None:
+    un_seul = _table(
+        _lignes(IND_1, _entiers(STABLE_1))
+        + _lignes(IND_3, _entiers([19]))
+        + _lignes(IND_4, _entiers(STABLE_4, 100))
+    )
+    resultat = risques_entree_rouge(un_seul, _meteo(), GRILLE)
+    assert resultat.risques == ()
+    assert [(e.code, "historique insuffisant" in e.motif) for e in resultat.exclus] == [(IND_3, True)]
+
+    deux = _table(
+        _lignes(IND_1, _entiers(STABLE_1))
+        + _lignes(IND_3, _entiers([18, 19]))
+        + _lignes(IND_4, _entiers(STABLE_4, 100))
+    )
+    resultat = risques_entree_rouge(deux, _meteo(), GRILLE)
+    # pente 1 sur 2 points : p(1) = 20
