+def test_entrees_invalides() -> None:
+    bonne = _table_defaut()
+    with pytest.raises(UsineErreur, match=ENTITE):
+        risques_entree_rouge(bonne, _meteo(Couleur.rouge), GRILLE)
+
+    # D absente pour IND-3
+    sans_d = _table(
+        _lignes(IND_1, _entiers(STABLE_1))
+        + _lignes(IND_3, _entiers(STABLE_3), fin=date(2026, 10, 8))
+        + _lignes(IND_4, _entiers(STABLE_4, 100))
+    )
+    with pytest.raises(UsineErreur, match=ENTITE):
+        risques_entree_rouge(sans_d, _meteo(), GRILLE)
+
+    complet = _lignes(IND_1, _entiers(STABLE_1)) + _lignes(IND_4, _entiers(STABLE_4, 100))
+    ind_3 = _lignes(IND_3, _entiers(STABLE_3))
+
+    trou = _table(complet + ind_3[:4] + ind_3[5:])
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*trou"):
+        risques_entree_rouge(trou, _meteo(), GRILLE)
+
+    samedi = _table(complet + ind_3[:4] + [{**ind_3[4], "date": date(2026, 10, 3)}] + ind_3[5:])
+    with pytest.raises(UsineErreur, match=ENTITE):
+        risques_entree_rouge(samedi, _meteo(), GRILLE)
+
+    doublon = _table(complet + ind_3 + [ind_3[-1]])
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*double"):
+        risques_entree_rouge(doublon, _meteo(), GRILLE)
+
+    denominateur_nul = _table(complet + ind_3[:-1] + [{**ind_3[-1], "denominateur": 0}])
+    with pytest.raises(UsineErreur, match=ENTITE):
+        risques_entree_rouge(denominateur_nul, _meteo(), GRILLE)
