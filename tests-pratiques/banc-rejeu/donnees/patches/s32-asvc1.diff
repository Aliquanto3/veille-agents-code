@@ -0,0 +1,297 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11).
+
+Fonction pure : les états par ticket de chaque Jour ouvré et les Entités arrivent en paramètre.
+Tous les nombres sont entiers (AD-10) ; un taux est porté par `numerateur` et `denominateur`.
+"""
+
+from collections import defaultdict
+from collections.abc import Mapping, Sequence
+from datetime import date
+from enum import StrEnum
+from fractions import Fraction
+from types import MappingProxyType
+from typing import Any
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import (
+    est_jour_ouvre,
+    fenetre_glissante,
+    jours_ouvres,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Codes des KPI, dans l'ordre de sortie."""
+
+
+def _valeurs(enumeration: type[StrEnum]) -> tuple[str, ...]:
+    return tuple(membre.value for membre in enumeration)
+
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "anomalies_ouvertes": ("",),
+        "anomalies_ouvertes_gravite": _valeurs(Gravite),
+        "anomalies_ouvertes_phase": _valeurs(Phase),
+        "entrees_jour": ("",),
+        "sorties_jour": ("",),
+        "entrees_fenetre": ("",),
+        "sorties_fenetre": ("",),
+        "age_median_anomalies_ouvertes": ("",),
+        "age_max_anomalies_ouvertes": ("",),
+        "taux_ko_cas_de_test": _valeurs(Phase),
+        "taux_non_execution_cas_de_test": _valeurs(Phase),
+        "certifications": _valeurs(StatutCertification),
+    }
+)
+"""Dimensions de chaque KPI (`""` : non ventilé), dans l'ordre de sortie."""
+
+_FERMES = frozenset(statut.value for statut in STATUTS_FERMES)
+
+_COLONNES_ENUM = (
+    "type_ticket",
+    "gravite",
+    "phase",
+    "statut",
+    "statut_test",
+    "statut_certification",
+)
+"""Colonnes d'énumération de `SCHEMA_TICKET_ETAT`, lues en texte."""
+
+_Cle = tuple[str, str, str]
+"""(périmètre, code, dimension)."""
+
+_Mesure = tuple[int, int]
+"""(numérateur, dénominateur)."""
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée « {PERIMETRE_PROGRAMME} » : nom réservé au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Les dates sont des Jours ouvrés contigus, de la première à la dernière."""
+    for jour in dates:
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(f"{jour.isoformat()} n'est pas un Jour ouvré")
+    presentes = set(dates)
+    for jour in jours_ouvres(dates[0], dates[-1]):
+        if jour not in presentes:
+            raise UsineErreur(
+                f"Jour ouvré {jour.isoformat()} absent de l'état des tickets reçu :"
+                " les KPI exigent chaque Jour ouvré de la première à la dernière date"
+            )
+
+
+def _est_ouverte(ligne: Mapping[str, Any]) -> bool:
+    return (
+        ligne["type_ticket"] == TypeTicket.anomalie.value
+        and ligne["statut"] is not None
+        and ligne["statut"] not in _FERMES
+    )
+
+
+def _perimetres(entite: str | None, entites: Sequence[str]) -> tuple[str, ...]:
+    if entite is not None and entite in entites:
+        return (entite, PERIMETRE_PROGRAMME)
+    return (PERIMETRE_PROGRAMME,)
+
+
+def _mediane(ages: list[int]) -> _Mesure:
+    ordonnes = sorted(ages)
+    milieu = len(ordonnes) // 2
+    if len(ordonnes) % 2:
+        valeur = Fraction(ordonnes[milieu])
+    else:
+        valeur = Fraction(ordonnes[milieu - 1] + ordonnes[milieu], 2)
+    return valeur.numerator, valeur.denominator
+
+
+class _Jour:
+    """Compteurs d'un Jour ouvré, par périmètre."""
+
+    def __init__(self) -> None:
+        self.comptes: defaultdict[_Cle, int] = defaultdict(int)
+        self.denominateurs: defaultdict[_Cle, int] = defaultdict(int)
+        self.ages: defaultdict[str, list[int]] = defaultdict(list)
+        self.entrees: defaultdict[str, int] = defaultdict(int)
+        self.sorties: defaultdict[str, int] = defaultdict(int)
+
+
+def _compter_jour(
+    jour: date,
+    lignes: Sequence[Mapping[str, Any]],
+    veille: Mapping[str, bool],
+    entites: Sequence[str],
+    ages_cache: dict[tuple[date, date], int],
+) -> _Jour:
+    """Compteurs de `jour` ; `veille` : ticket → Anomalie ouverte la veille."""
+    compteurs = _Jour()
+    for ligne in lignes:
+        perimetres = _perimetres(ligne["entite"], entites)
+        type_ticket = ligne["type_ticket"]
+        if type_ticket == TypeTicket.anomalie.value:
+            ouverte = _est_ouverte(ligne)
+            entree = 1 if ligne["date_derniere_entree"] == jour else 0
+            sortie = entree - (int(ouverte) - int(veille.get(ligne["cle_ticket"], False)))
+            for perimetre in perimetres:
+                compteurs.entrees[perimetre] += entree
+                compteurs.sorties[perimetre] += sortie
+                if not ouverte:
+                    continue
+                compteurs.comptes[(perimetre, "anomalies_ouvertes", "")] += 1
+                if ligne["gravite"] is not None:
+                    compteurs.comptes[
+                        (perimetre, "anomalies_ouvertes_gravite", ligne["gravite"])
+                    ] += 1
+                if ligne["phase"] is not None:
+                    compteurs.comptes[(perimetre, "anomalies_ouvertes_phase", ligne["phase"])] += 1
+            if ouverte:
+                derniere_entree = ligne["date_derniere_entree"]
+                if derniere_entree is None:
+                    raise UsineErreur(
+                        f"Anomalie {ligne['cle_ticket']} ouverte le {jour.isoformat()} sans"
+                        " date de dernière Entrée"
+                    )
+                cle_age = (derniere_entree, jour)
+                if cle_age not in ages_cache:
+                    ages_cache[cle_age] = len(jours_ouvres(derniere_entree, jour)) - 1
+                for perimetre in perimetres:
+                    compteurs.ages[perimetre].append(ages_cache[cle_age])
+        elif type_ticket == TypeTicket.cas_de_test.value:
+            statut, phase = ligne["statut_test"], ligne["phase"]
+            if statut is None or phase is None:
+                continue
+            for perimetre in perimetres:
+                if statut in (StatutTest.ok.value, StatutTest.ko.value):
+                    compteurs.denominateurs[(perimetre, "taux_ko_cas_de_test", phase)] += 1
+                    if statut == StatutTest.ko.value:
+                        compteurs.comptes[(perimetre, "taux_ko_cas_de_test", phase)] += 1
+                compteurs.denominateurs[(perimetre, "taux_non_execution_cas_de_test", phase)] += 1
+                if statut == StatutTest.non_execute.value:
+                    compteurs.comptes[(perimetre, "taux_non_execution_cas_de_test", phase)] += 1
+        elif type_ticket == TypeTicket.certification.value:
+            statut_certification = ligne["statut_certification"]
+            if statut_certification is None:
+                continue
+            for perimetre in perimetres:
+                compteurs.comptes[(perimetre, "certifications", statut_certification)] += 1
+    return compteurs
+
+
+def _mesure(
+    code: str,
+    dimension: str,
+    perimetre: str,
+    jour: date,
+    compteurs: Mapping[date, _Jour],
+) -> _Mesure:
+    """Mesure d'un KPI ; zéro explicite quand rien n'est compté."""
+    courant = compteurs[jour]
+    cle = (perimetre, code, dimension)
+    if code in ("entrees_jour", "sorties_jour"):
+        flux = courant.entrees if code == "entrees_jour" else courant.sorties
+        return flux.get(perimetre, 0), 1
+    if code in ("entrees_fenetre", "sorties_fenetre"):
+        total = 0
+        for date_fenetre in fenetre_glissante(jour):
+            if date_fenetre in compteurs:
+                flux = (
+                    compteurs[date_fenetre].entrees
+                    if code == "entrees_fenetre"
+                    else compteurs[date_fenetre].sorties
+                )
+                total += flux.get(perimetre, 0)
+        return total, 1
+    if code.startswith("age_"):
+        ages = courant.ages.get(perimetre, [])
+        if not ages:
+            return 0, 0
+        return _mediane(ages) if code == "age_median_anomalies_ouvertes" else (max(ages), 1)
+    if code.startswith("taux_"):
+        return courant.comptes.get(cle, 0), courant.denominateurs.get(cle, 0)
+    return courant.comptes.get(cle, 0), 1
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : les douze KPI de chaque Jour ouvré, par Entité puis pour le Programme.
+
+    Définitions du Glossaire (H-17) : Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée =
+    création ou réouverture (`date_derniere_entree`) ; Sortie = passage à Fermée ou Rejetée.
+    Fenêtre glissante : `contrats.calendrier` (H-19). Âge = Jours ouvrés depuis la dernière
+    Entrée. Un taux ou un âge sans valeur vaut `0/0` ; la médiane d'un nombre pair d'âges est
+    une fraction réduite. Le Programme agrège toutes les lignes, y compris celles d'Entités
+    hors de `entites`.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date ;
+    à la première, la veille est vide (début de l'historique). Lignes triées par date,
+    périmètre (ordre de `entites`, puis `PROGRAMME`), code, dimension.
+    """
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    _verifier_entites(entites)
+    if etats.is_empty():
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = sorted(etats.get_column("date").unique().to_list())
+    _verifier_dates(dates)
+    lignes_par_jour: defaultdict[date, list[dict[str, Any]]] = defaultdict(list)
+    colonnes = etats.with_columns(pl.col(c).cast(pl.Utf8) for c in _COLONNES_ENUM)
+    for ligne in colonnes.iter_rows(named=True):
+        lignes_par_jour[ligne["date"]].append(ligne)
+
+    compteurs: dict[date, _Jour] = {}
+    ages_cache: dict[tuple[date, date], int] = {}
+    veille: dict[str, bool] = {}
+    for jour in dates:
+        lignes = lignes_par_jour[jour]
+        compteurs[jour] = _compter_jour(jour, lignes, veille, entites, ages_cache)
+        veille = {
+            ligne["cle_ticket"]: _est_ouverte(ligne)
+            for ligne in lignes
+            if ligne["type_ticket"] == TypeTicket.anomalie.value
+        }
+
+    sortie: dict[str, list[Any]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+    for jour in dates:
+        for perimetre in (*entites, PERIMETRE_PROGRAMME):
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    numerateur, denominateur = _mesure(code, dimension, perimetre, jour, compteurs)
+                    sortie["date"].append(jour)
+                    sortie["perimetre"].append(perimetre)
+                    sortie["code_kpi"].append(code)
+                    sortie["dimension"].append(dimension)
+                    sortie["numerateur"].append(numerateur)
+                    sortie["denominateur"].append(denominateur)
+    table = pl.DataFrame(sortie, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
