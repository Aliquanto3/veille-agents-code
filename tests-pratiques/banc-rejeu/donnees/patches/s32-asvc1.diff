+def _comptes(table: pl.DataFrame, code: str) -> pl.DataFrame:
+    return (
+        table.filter((pl.col("code_kpi") == code) & (pl.col("perimetre") == PERIMETRE_PROGRAMME))
+        .group_by("date")
+        .agg(pl.col("numerateur").sum())
+        .sort("date")
+    )
+
