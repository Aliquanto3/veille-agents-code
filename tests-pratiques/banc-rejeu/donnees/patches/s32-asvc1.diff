+def test_programme_somme_des_entites_et_instantane(etats_generes: pl.DataFrame) -> None:
+    entites = sorted(etats_generes.get_column("entite").drop_nulls().unique().to_list())
+    table = kpi(etats_generes, entites)
+    comptes = table.filter(
+        pl.col("code_kpi").is_in(
+            ["anomalies_ouvertes", "entrees_jour", "sorties_jour", "certifications"]
+        )
+    )
+    par_entite = (
+        comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by("date", "code_kpi", "dimension")
+        .agg(pl.col("numerateur").sum())
+    )
+    programme = comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME).select(
+        "date", "code_kpi", "dimension", "numerateur"
+    )
+    assert (
+        par_entite.join(programme, on=["date", "code_kpi", "dimension"])
+        .filter(pl.col("numerateur") != pl.col("numerateur_right"))
+        .is_empty()
+    )
+    ouvertes = instantane(etats_generes).filter(
+        (pl.col("type_ticket") == TypeTicket.anomalie.value)
+        & ~pl.col("statut").cast(pl.Utf8).is_in([s.value for s in STATUTS_FERMES])
+    )
+    attendu = ouvertes.group_by("date").agg(pl.col("nombre").sum()).sort("date")
+    stock = _comptes(table, "anomalies_ouvertes")
+    assert stock.get_column("numerateur").to_list() == attendu.get_column("nombre").to_list()
+
