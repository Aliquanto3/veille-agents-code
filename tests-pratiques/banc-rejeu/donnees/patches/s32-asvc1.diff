+def test_conservation_du_stock(etats_generes: pl.DataFrame) -> None:
+    table = kpi(etats_generes, [])
+    stock = _comptes(table, "anomalies_ouvertes").get_column("numerateur").to_list()
+    entrees = _comptes(table, "entrees_jour").get_column("numerateur").to_list()
+    sorties = _comptes(table, "sorties_jour").get_column("numerateur").to_list()
+    veille = [0, *stock[:-1]]
+    assert [s - v for s, v in zip(stock, veille, strict=True)] == [
+        e - o for e, o in zip(entrees, sorties, strict=True)
+    ]
+    assert sum(entrees) > 0
