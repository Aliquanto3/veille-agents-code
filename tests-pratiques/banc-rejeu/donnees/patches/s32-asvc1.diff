@@ -0,0 +1,268 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import fenetre_generation, generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+
+
+def _ts(jour: int, heure: int = 8) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, debut: int, fin: int, entites: list[str] | None = None) -> pl.DataFrame:
+    dates = jours_ouvres(date(2026, 10, debut), date(2026, 10, fin))
+    return kpi(tickets_etats(flux.evenements, dates), ENTITES if entites is None else entites)
+
+
+def _val(
+    table: pl.DataFrame, jour: int, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == date(2026, 10, jour))
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne.item(0, "numerateur"), ligne.item(0, "denominateur")
+
+
+def _cas_de_test(flux: Flux, cle: str, phase: str, statut: str, entite: str = "ENT-A") -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(5),
+        {
+            Champ.statut_test: statut,
+            Champ.entite: entite,
+            Champ.vague: "V1",
+            Champ.phase: phase,
+        },
+    )
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5))
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(table, 5, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 8), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(7, 9), "en_analyse", "fermee")
+    table = _kpi(flux, 5, 7)
+    entrees = [_val(table, j, "ENT-A", "entrees_jour") for j in (5, 6, 7)]
+    sorties = [_val(table, j, "ENT-A", "sorties_jour") for j in (5, 6, 7)]
+    assert entrees == [(1, 1), (0, 1), (1, 1)]
+    assert sorties == [(0, 1), (1, 1), (1, 1)]
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    for numero, jour in enumerate((1, 2, 5, 6, 7, 8, 9), start=1):
+        flux.anomalie(f"DEMO-{numero}", _ts(jour))
+    table = _kpi(flux, 1, 9)
+    assert _val(table, 9, "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(table, 7, "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(table, 2, "ENT-A", "entrees_fenetre") == (2, 1)
+    assert _val(table, 1, "ENT-A", "entrees_fenetre") == (1, 1)
+    assert _val(table, 9, "ENT-A", "sorties_fenetre") == (0, 1)
+
+
+def test_age_median_et_maximum() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    table = _kpi(flux, 1, 7)
+    assert _val(table, 7, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(table, 7, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(table, 1, "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+
+
+def test_age_d_une_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")
+    table = _kpi(flux, 1, 9)
+    assert _val(table, 9, "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(table, 9, "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_anomalie_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(table, 5, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux_de_cas_de_test() -> None:
+    flux = Flux()
+    for numero, statut in enumerate(("ok", "ok", "ok", "ko", "non_execute", "non_execute")):
+        _cas_de_test(flux, f"DEMO-{numero + 1}", "recette", statut)
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(table, 5, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(table, 5, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(table, 5, "ENT-B", "taux_non_execution_cas_de_test", "recette") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for cle, statut in (("DEMO-1", "accordee"), ("DEMO-2", "reservee"), ("DEMO-3", "reservee")):
+        flux.creer(
+            cle,
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A", Champ.vague: "V1"},
+        )
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(table, 5, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(table, 5, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [date(2026, 10, 5), date(2026, 10, 7)])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+def test_entites_invalides() -> None:
+    etats = tickets_etats(Flux().evenements, [date(2026, 10, 5)])
+    with pytest.raises(UsineErreur, match="ENT-A"):
+        kpi(etats, ["ENT-A", "ENT-A"])
+    with pytest.raises(UsineErreur, match=PERIMETRE_PROGRAMME):
+        kpi(etats, ["ENT-A", PERIMETRE_PROGRAMME])
+
+
+def test_table_vide() -> None:
+    etats = tickets_etats(Flux().evenements, [])
+    table = kpi(etats, ENTITES)
+    assert table.is_empty()
+    assert dict(table.schema) == dict(SCHEMA_KPI.colonnes)
+
+
+def test_schema_dense_et_ordre() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    table = _kpi(flux, 5, 6)
+    assert valider(table, SCHEMA_KPI).height == table.height
+    par_perimetre = sum(len(dimensions) for dimensions in DIMENSIONS_KPI.values())
+    assert table.height == 2 * 3 * par_perimetre
+    assert tuple(DIMENSIONS_KPI) == CODES_KPI
+    premiers = table.head(par_perimetre)
+    assert set(premiers.get_column("perimetre")) == {"ENT-A"}
+    assert premiers.get_column("code_kpi").unique(maintain_order=True).to_list() == list(CODES_KPI)
+    assert table.get_column("date").is_sorted()
+    assert table.tail(1).item(0, "perimetre") == PERIMETRE_PROGRAMME
+    assert all(dtype == pl.Int64 for nom, dtype in table.schema.items() if nom.endswith("ateur"))
+    assert not any(dtype.is_float() for dtype in table.schema.values())
