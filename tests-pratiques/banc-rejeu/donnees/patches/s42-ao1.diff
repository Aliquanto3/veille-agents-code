+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Table de référence ENT-C : 10 Jours ouvrés du lundi
+28/09/2026 au vendredi 09/10/2026 (D), Météo orange, Grille livrée (rouge : IND-1 `>= 3`,
+IND-3 `>= 20`, IND-4 `>= 1/5`). x = 0..9, projection p(h) = a + b·(9 + h), h = 1..5 ;
+D + 1 JO = lundi 12/10, D + 5 JO = vendredi 16/10.
+
+- IND-3 = 10..19 : b = 1, a = 10, p(1) = 20 ≥ 20.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : x̄ = 9/2, ȳ = 7/10, Σ(x − x̄)² = 165/2,
+  Σ(x − x̄)(y − ȳ) = 52 − 63/2 = 41/2 ; b = 41/165, a = 7/10 − 369/330 = −23/55 ;
+  p(4) = (533 − 69)/165 = 464/165 < 3, p(5) = 505/165 = 101/33 ≥ 3.
+- IND-4 = 5/100..14/100 : b = 1/100, a = 5/100, p(5) = 19/100 < 1/5.
+"""
+
+import re
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.commun import avancer, declenche
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+CHEMIN_GRILLE = RACINE / "config/grille_meteo.yaml"
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Valeur = tuple[int, int] | str
+"""Valeur évaluée `(numérateur, dénominateur)`, ou motif d'un indicateur non évaluable."""
+
+STABLES: dict[CodeIndicateur, list[Valeur]] = {
+    IND_1: [(1, 1)] * 10,
+    IND_3: [(5, 1)] * 10,
+    IND_4: [(1, 10)] * 10,
+}
+
+
+def _table(
+    series: dict[CodeIndicateur, list[Valeur]] | None = None,
+    fin: date = D,
+    entite: str = ENTITE,
+) -> pl.DataFrame:
+    """Table dense finissant à `fin` ; `series` remplace les séries stables par code."""
+    series = {**STABLES, **(series or {})}
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_INDICATEUR.colonnes}
+    for code, valeurs in series.items():
+        dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :] if valeurs else ()
+        for jour, valeur in zip(dates, valeurs, strict=True):
+            evaluee = isinstance(valeur, tuple)
+            numerateur, denominateur = valeur if isinstance(valeur, tuple) else (0, 0)
+            lignes["date"].append(jour)
+            lignes["entite"].append(entite)
+            lignes["code"].append(code.value)
+            lignes["statut"].append("evalue" if evaluee else "non_evaluable")
+            lignes["motif"].append("" if isinstance(valeur, tuple) else valeur)
+            lignes["numerateur"].append(numerateur)
+            lignes["denominateur"].append(denominateur)
+            lignes["couleur"].append("vert")
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes))
+    return valider(table, SCHEMA_INDICATEUR)
+
+
+def _entiers(*valeurs: int) -> list[Valeur]:
+    return [(v, 1) for v in valeurs]
+
+
+def _donnees_grille() -> dict[str, Any]:
+    donnees: dict[str, Any] = yaml.safe_load(CHEMIN_GRILLE.read_text(encoding="utf-8"))
+    return donnees
+
+
+def _grille(**indicateurs_yaml: Any) -> GrilleMeteo:
+    """Grille livrée, règles remplacées par `indicateurs_yaml`."""
+    donnees = _donnees_grille()
+    donnees["indicateurs"].update(indicateurs_yaml)
+    return GrilleMeteo.model_validate(donnees)
+
+
+GRILLE = _grille()
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regle = RegleDeclenchante(
+        code=IND_1,
+        couleur=couleur,
+        operateur=Operateur.superieur_ou_egal,
+        numerateur=1,
+        denominateur=1,
+        seuil_numerateur=1,
+        seuil_denominateur=1,
+        tickets_en_cause=(),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(regle,),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _calculer(
+    series: dict[CodeIndicateur, list[Valeur]] | None = None,
+    grille: GrilleMeteo = GRILLE,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    return risques_entree_rouge(_table(series), _meteo(), grille, parametres)
+
+
+def test_grille_de_reference() -> None:
+    seuils = {code: GRILLE.indicateurs[code].seuils[Couleur.rouge] for code in risque.PROJETES}
+    assert seuils == {
+        IND_1: (Operateur.superieur_ou_egal, Fraction(3)),
+        IND_3: (Operateur.superieur_ou_egal, Fraction(20)),
+        IND_4: (Operateur.superieur_ou_egal, Fraction(1, 5)),
+    }
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = _calculer({IND_3: _entiers(*range(10, 20))})
+
+    assert resultat.exclus == ()
+    [projete] = resultat.risques
+    assert projete.valeur_projetee == Fraction(20)
+    assert projete.risque == RisqueEntreeRouge(
+        date_arrete=D,
+        entite=ENTITE,
+        indicateur=IND_3,
+        date_franchissement_estimee=date(2026, 10, 12),
+        horizon_jours_ouvres=5,
+        numerateur=19,
+        denominateur=1,
+        seuil_numerateur=20,
+        seuil_denominateur=1,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = _calculer({IND_1: _entiers(0, 0, 0, 0, 0, 1, 1, 1, 2, 2)})
+
+    [projete] = resultat.risques
+    assert projete.risque.indicateur is IND_1
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_tendance_ind_1_hors_horizon_de_4_jours() -> None:
+    resultat = _calculer(
+        {IND_1: _entiers(0, 0, 0, 0, 0, 1, 1, 1, 2, 2)}, parametres=ParametresRisque(horizon=4)
+    )
+
+    assert resultat.risques == ()
+
+
