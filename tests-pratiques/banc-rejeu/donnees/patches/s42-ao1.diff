+def test_avancer_unique_ad_18() -> None:
+    motif = re.compile(r"^\s*def\s+_?avancer\s*\(")
+    racine = RACINE / "src/usine/domaine/prevision"
+    definitions = [
+        chemin.relative_to(RACINE).as_posix()
+        for chemin in sorted(racine.rglob("*.py"))
+        for ligne in chemin.read_text(encoding="utf-8").splitlines()
+        if motif.match(ligne)
+    ]
+    assert definitions == ["src/usine/domaine/prevision/commun.py"]
