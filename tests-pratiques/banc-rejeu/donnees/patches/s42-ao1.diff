+def _erreur(table: pl.DataFrame, meteo: MeteoEntite | None = None) -> str:
+    with pytest.raises(UsineErreur) as exc:
+        risques_entree_rouge(table, meteo or _meteo(), GRILLE)
+    message = str(exc.value)
+    assert ENTITE in message
+    return message
