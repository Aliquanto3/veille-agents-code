+"""Tâche `classification` : Cause racine par Anomalie, incrémentalité par le cache (FR-35)."""
+
+import logging
+import re
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.doublures.fournisseur_factice import FournisseurFactice
+from tests.unit.ia.espions import (
+    NUMERO_COMPTE,
+    PASSAGE_ID,
+    CacheMemoire,
+    horloge_espion,
+    meteo_rouge,
+    pseudonymiseur,
+    textes,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import (
+    ReponseClassification,
+    ReponseExplication,
+    SortieClassification,
+    StatutControle,
+    Tache,
+)
+from usine.contrats.tickets import CauseRacine
+from usine.contrats.versions import version_prompt
+from usine.ia.classification import (
+    PART_PLAFOND_CLASSIFICATION,
+    ContexteClassification,
+    classer,
+    lire_prompt,
+    rendre_prompt,
+)
+from usine.ia.explication import ContexteExplication, expliquer
+from usine.ia.explication import lire_prompt as lire_prompt_explication
+from usine.ia.passerelle import Passerelle
+
+RACINE = Path(__file__).resolve().parents[3]
+DATE_1 = date(2026, 10, 9)
+DATE_2 = date(2026, 10, 12)
+TEXTES = textes(
+    {
+        "DEMO-1": ("Virement rejeté", f"Le compte {NUMERO_COMPTE} est rejeté."),
+        "DEMO-2": ("Écart de taux", "Le taux appliqué est faux."),
+        "DEMO-10": ("Flux bloqué", "L'interface ne répond plus."),
+    }
+)
+
+
+def _contexte(plafond_eur: Decimal | None = None) -> ContexteClassification:
+    return ContexteClassification(
+        passage_id=PASSAGE_ID,
+        version_donnees="d" * 64,
+        version_grille="grille123456",
+        gabarit=lire_prompt(),
+        plafond_eur=plafond_eur,
+    )
+
+
+def _reponse(
+    cause: CauseRacine = CauseRacine.parametrage, justification: str = ""
+) -> ReponseClassification:
+    return ReponseClassification(cause_racine=cause, justification=justification)
+
+
+def _passerelle(factice: FournisseurFactice, cache: CacheMemoire, **options: object) -> Passerelle:
+    return Passerelle(factice, pseudonymiseur(), cache, horloge_espion([]), **options)  # type: ignore[arg-type]
+
+
+def test_premier_passage_un_appel_par_anomalie_trie_par_cle() -> None:
+    factice = FournisseurFactice([_reponse(CauseRacine.reprise_donnees)] * 3)
+    passerelle = _passerelle(factice, CacheMemoire())
+    sorties, traces = classer(passerelle, TEXTES, DATE_1, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert {s.cause_racine for s in sorties} == {CauseRacine.reprise_donnees}
+    assert {s.statut_controle for s in sorties} == {StatutControle.conforme}
+    assert len(factice.appels) == len(traces) == 3
+    assert {t.tache for t in traces} == {Tache.classification}
+    assert [t.cible for t in traces] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert not any(t.depuis_cache for t in traces)
+    assert {t.version_prompt for t in traces} == {version_prompt(lire_prompt())}
+    assert {t.version_grille for t in traces} == {"grille123456"}
+
+
+def test_rejeu_a_une_autre_date_sans_appel() -> None:
+    cache = CacheMemoire()
+    premier = FournisseurFactice([_reponse()] * 3)
+    sorties, _ = classer(_passerelle(premier, cache), TEXTES, DATE_1, _contexte())
+    second = FournisseurFactice()
+    rejeu, traces = classer(_passerelle(second, cache), TEXTES, DATE_2, _contexte())
+    assert second.appels == []
+    assert rejeu == sorties
+    assert all(t.depuis_cache for t in traces)
+
+
+def test_incremental_nouvelle_et_modifiee_seules_appelees() -> None:
+    cache = CacheMemoire()
+    classer(
+        _passerelle(FournisseurFactice([_reponse()] * 2), cache),
+        textes({"DEMO-1": ("A", "a"), "DEMO-2": ("B", "b")}),
+        DATE_1,
+        _contexte(),
+    )
+    factice = FournisseurFactice([_reponse(CauseRacine.environnement)] * 2)
+    sorties, traces = classer(
+        _passerelle(factice, cache),
+        textes({"DEMO-1": ("A", "a"), "DEMO-2": ("B", "b modifiée"), "DEMO-3": ("C", "c")}),
+        DATE_2,
+        _contexte(),
+    )
+    assert len(factice.appels) == 2
+    assert [t.depuis_cache for t in traces] == [True, False, False]
+    assert [s.cause_racine for s in sorties] == [
+        CauseRacine.parametrage,
+        CauseRacine.environnement,
+        CauseRacine.environnement,
+    ]
+
+
+def test_hors_anomalie_ignore() -> None:
+    table = textes({"DEMO-1": ("A", "a"), "DEMO-2": ("B", "b"), "DEMO-3": ("C", "c")})
+    type_ticket = pl.Series("type_ticket", ["anomalie", "cas_de_test", "certification"])
+    table = table.with_columns(type_ticket.cast(table.schema["type_ticket"]))
+    factice = FournisseurFactice([_reponse()])
+    sorties, traces = classer(_passerelle(factice, CacheMemoire()), table, DATE_1, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1"]
+    assert len(factice.appels) == len(traces) == 1
+
+
+def test_aucune_anomalie() -> None:
+    factice = FournisseurFactice()
+    sorties, traces = classer(_passerelle(factice, CacheMemoire()), textes({}), DATE_1, _contexte())
+    assert (sorties, traces) == ((), ())
+    assert factice.appels == []
+
+
+def test_plafond_atteint_anomalie_non_classee(caplog: pytest.LogCaptureFixture) -> None:
+    passerelle = _passerelle(
+        FournisseurFactice(), CacheMemoire(), plafond_cout_passage_eur=Decimal(0)
+    )
+    with caplog.at_level(logging.WARNING):
+        sorties, traces = classer(passerelle, TEXTES, DATE_1, _contexte())
+    assert (sorties, traces) == ((), ())
+    assert "plafond" in caplog.text
+
+
+def test_part_du_plafond_refuse_l_appel_frais_mais_sert_le_cache() -> None:
+    assert Decimal("0.5") == PART_PLAFOND_CLASSIFICATION
+    cache = CacheMemoire()
+    tarif = lambda *_: Decimal(1)  # noqa: E731
+    classer(
+        _passerelle(FournisseurFactice([_reponse()]), cache, tarif=tarif),
+        textes({"DEMO-1": ("A", "a")}),
+        DATE_1,
+        _contexte(),
+    )
+    factice = FournisseurFactice([_reponse(), _reponse()])
+    passerelle = _passerelle(factice, cache, tarif=tarif, plafond_cout_passage_eur=Decimal(10))
+    sorties, traces = classer(
+        passerelle,
+        textes(
+            {"DEMO-1": ("A", "a"), "DEMO-2": ("B", "b"), "DEMO-3": ("C", "c"), "DEMO-4": ("D", "d")}
+        ),
+        DATE_2,
+        _contexte(plafond_eur=Decimal(1)),
+    )
+    # DEMO-1 vient du cache, DEMO-2 franchit la part, DEMO-3 et DEMO-4 sont refusées.
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2"]
+    assert [t.depuis_cache for t in traces] == [True, False]
+    assert len(factice.appels) == 1
+
+
+def test_explications_encore_appelees_apres_la_part_de_classification() -> None:
+    tarif = lambda *_: Decimal(1)  # noqa: E731
+    factice = FournisseurFactice(
+        [_reponse(), _reponse(), ReponseExplication(texte="DEMO-3 est en cause.")]
+    )
+    passerelle = _passerelle(
+        factice, CacheMemoire(), tarif=tarif, plafond_cout_passage_eur=Decimal(4)
+    )
+    sorties, _ = classer(passerelle, TEXTES, DATE_1, _contexte(plafond_eur=Decimal(2)))
+    assert len(sorties) == 2
+    explication, traces = expliquer(
+        passerelle,
+        meteo_rouge(tickets=("DEMO-3",)),
+        textes({"DEMO-3": ("T", "d")}),
+        ContexteExplication(
+            passage_id=PASSAGE_ID, version_donnees="d" * 64, gabarit=lire_prompt_explication()
+        ),
+    )
+    assert explication.statut_controle is StatutControle.conforme
+    assert len(traces) == 1
+    assert len(factice.appels) == 3
+
+
+def test_justification_citant_une_autre_cle_corrigee() -> None:
+    reponse = _reponse(justification="DEMO-9 est identique. Le taux est faux dans DEMO-1.")
+    sorties, traces = classer(
+        _passerelle(FournisseurFactice([reponse]), CacheMemoire()),
+        textes({"DEMO-1": ("A", "a")}),
+        DATE_1,
+        _contexte(),
+    )
+    (sortie,) = sorties
+    assert "DEMO-9" not in sortie.justification
+    assert "DEMO-1" in sortie.justification
+    assert sortie.statut_controle is StatutControle.corrige
+    assert traces[0].statut_controle is StatutControle.corrige
+
+
+def test_entree_pseudonymisee_et_donnees_delimitees() -> None:
+    factice = FournisseurFactice([_reponse()])
+    _, traces = classer(
+        _passerelle(factice, CacheMemoire()),
+        textes({"DEMO-1": ("Titre ```piégé```", f"Compte {NUMERO_COMPTE}.")}),
+        DATE_1,
+        _contexte(),
+    )
+    (appel,) = factice.appels
+    prompt = str(appel.entree)
+    assert NUMERO_COMPTE not in prompt
+    assert re.search(r"\bCOMPTE_[0-9a-f]{6}\b", prompt)
+    assert NUMERO_COMPTE not in traces[0].entree_pseudonymisee
+    assert prompt.count("```") == 2  # seul le bloc de données du gabarit
+
+
+def test_fournisseur_en_erreur_propage() -> None:
+    passerelle = _passerelle(FournisseurFactice(), CacheMemoire())
+    with pytest.raises(UsineErreur):
+        classer(passerelle, TEXTES, DATE_1, _contexte())
+
+
+def test_prompt_liste_les_sept_causes_racines() -> None:
+    gabarit = lire_prompt().decode("utf-8")
+    assert all(f"`{cause.value}`" in gabarit for cause in CauseRacine)
+    assert len(CauseRacine) == 7
+
+
+def test_rendre_prompt_variables_inconnues() -> None:
+    with pytest.raises(UsineErreur, match="classification"):
+        rendre_prompt("{{a}}", {"b": "x"})
+    assert rendre_prompt("{{a}}", {"a": "x"}) == "x"
+
+
+def test_sortie_classification_modele() -> None:
+    assert SortieClassification(cle_ticket="DEMO-1", cause_racine=CauseRacine.parametrage)
+
+
+def test_aucune_cause_racine_dans_les_adaptateurs_jira() -> None:
+    """La Cause racine proposée n'est jamais écrite dans Jira."""
+    adaptateurs = RACINE / "src" / "usine" / "adaptateurs"
+    fichiers = [
+        f
+        for dossier in adaptateurs.iterdir()
+        if dossier.is_dir() and (dossier.name.startswith("jira_") or dossier.name == "composite")
+        for f in dossier.rglob("*.py")
+    ]
+    assert fichiers
+    for fichier in fichiers:
+        texte = fichier.read_text(encoding="utf-8")
+        for terme in ("SortieClassification", "cause_racine", "classification"):
+            assert terme not in texte, f"{terme} dans {fichier.name}"
