+class _FournisseurPalier2(FournisseurFactice):
+    """Fournisseur factice des Passages Palier 2 : classe chaque Anomalie en `reprise_donnees`.
+
+    Les réponses scriptées ne servent qu'aux explications ; `appels` ne compte que celles-ci,
+    les classifications sont dans `appels_classification`.
+    """
+
+    def __init__(
+        self,
+        reponses: list[ReponseExplication] | None = None,
+        version_modele: str = "factice:modele",
+    ) -> None:
+        super().__init__(reponses or (), version_modele=version_modele)
+        self.appels_classification: list[str] = []
+
+    def generer_structure[T: BaseModel](
+        self, prompt: str, schema: type[T], parametres: ParametresAppel
+    ) -> ReponseStructuree[T]:
+        if schema is not ReponseClassification:
+            return super().generer_structure(prompt, schema, parametres)
+        self.appels_classification.append(prompt)
+        sortie = ReponseClassification(cause_racine=CauseRacine.reprise_donnees)
+        brut = sortie.model_dump_json()
+        return ReponseStructuree[T](
+            sortie=schema.model_validate_json(brut),
+            brut=brut,
+            jetons_entree=len(prompt.split()),
+            jetons_sortie=len(brut.split()),
+            version_modele=self.version_modele,
+        )
+
+
