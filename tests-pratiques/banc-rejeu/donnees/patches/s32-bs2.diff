@@ -0,0 +1,258 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from itertools import pairwise
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.adaptateurs.journal import SourceJournal
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jour_ouvre_de, jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+
+Valeur = tuple[int, int]
+
+
+def _ts(jour: int, heure: int = 9, mois: int = 10) -> datetime:
+    return datetime(2026, mois, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, debut: date, fin: date) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, jours_ouvres(debut, fin)), ENTITES)
+
+
+def _valeur(table: pl.DataFrame, d: date, perimetre: str, code: str, dimension: str = "") -> Valeur:
+    lignes = table.filter(
+        (pl.col("date") == d)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert lignes.height == 1, (d, perimetre, code, dimension)
+    return lignes.row(0)[4], lignes.row(0)[5]
+
+
+def _cas(flux: Flux, cle: str, statut: str, phase: str = "recette", entite: str = "ENT-A") -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(5),
+        {Champ.statut_test: statut, Champ.entite: entite, Champ.phase: phase},
+    )
+
+
+def _certification(flux: Flux, cle: str, statut: str) -> None:
+    flux.creer(
+        cle,
+        TypeTicket.certification,
+        _ts(5),
+        {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+    )
+
+
+LUNDI = date(2026, 10, 5)
+MARDI = date(2026, 10, 6)
+MERCREDI = date(2026, 10, 7)
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5))
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, LUNDI, LUNDI)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _valeur(table, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 9), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(7, 10), "en_analyse", "fermee")
+    table = _kpi(flux, LUNDI, MERCREDI)
+    entrees = [_valeur(table, d, "ENT-A", "entrees_jour")[0] for d in (LUNDI, MARDI, MERCREDI)]
+    sorties = [_valeur(table, d, "ENT-A", "sorties_jour")[0] for d in (LUNDI, MARDI, MERCREDI)]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+
+
+def test_fenetre() -> None:
+    flux = Flux()
+    jours = jours_ouvres(LUNDI, date(2026, 10, 13))
+    assert len(jours) == 7
+    for i, jour in enumerate(jours):
+        flux.anomalie(f"DEMO-{i + 1}", _ts(jour.day))
+    table = _kpi(flux, LUNDI, jours[-1])
+    assert _valeur(table, jours[0], "ENT-A", "entrees_fenetre") == (1, 1)
+    assert _valeur(table, jours[-1], "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _valeur(table, jours[-1], "ENT-A", "sorties_fenetre") == (0, 1)
+
+
+def test_age() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    table = _kpi(flux, date(2026, 10, 1), MERCREDI)
+    assert _valeur(table, MERCREDI, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _valeur(table, MERCREDI, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _valeur(table, date(2026, 10, 1), "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+
+
+def test_age_apres_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(7), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(12), "fermee", "en_analyse")
+    table = _kpi(flux, LUNDI, date(2026, 10, 13))
+    assert _valeur(table, date(2026, 10, 13), "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    table = _kpi(flux, LUNDI, LUNDI)
+    assert _valeur(table, LUNDI, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _valeur(table, LUNDI, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["ok", "ok", "ok", "ko", "non_execute", "non_execute"]):
+        _cas(flux, f"DEMO-{i + 1}", statut)
+    table = _kpi(flux, LUNDI, LUNDI)
+    assert _valeur(table, LUNDI, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _valeur(table, LUNDI, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _valeur(table, LUNDI, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _valeur(table, LUNDI, "ENT-A", "taux_non_execution_cas_de_test", "tnr") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    _certification(flux, "DEMO-1", "accordee")
+    _certification(flux, "DEMO-2", "reservee")
+    _certification(flux, "DEMO-3", "reservee")
+    table = _kpi(flux, LUNDI, LUNDI)
+    assert _valeur(table, LUNDI, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI, MERCREDI])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"),
+    [(["ENT-A", "ENT-A"], "ENT-A"), (["ENT-A", PERIMETRE_PROGRAMME], PERIMETRE_PROGRAMME)],
+)
+def test_entites_invalides(entites: list[str], valeur: str) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI])
+    with pytest.raises(UsineErreur, match=valeur):
+        kpi(etats, entites)
+
+
+def test_table_vide() -> None:
+    table = kpi(tickets_etats([], []), ENTITES)
+    assert table.height == 0
+    assert table.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+
+
+def _flux_varie() -> Flux:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5), entite="ENT-B", gravite="mineure")
+    flux.transition("DEMO-2", _ts(6), "nouvelle", "rejetee")
+    _cas(flux, "DEMO-3", "ko", entite="ENT-B")
+    _certification(flux, "DEMO-4", "accordee")
+    return flux
+
+
+def test_schema_dense_et_sans_flottant() -> None:
+    table = _kpi(_flux_varie(), LUNDI, MARDI)
+    assert table.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+    assert not any(t.is_float() for t in table.schema.values())
+    par_perimetre = sum(len(DIMENSIONS_KPI[code]) for code in CODES_KPI)
+    assert table.height == 2 * 3 * par_perimetre
+    assert table.get_column("perimetre").unique().sort().to_list() == [
+        "ENT-A",
+        "ENT-B",
+        PERIMETRE_PROGRAMME,
+    ]
+
+
+def test_programme_somme_des_entites() -> None:
+    table = _kpi(_flux_varie(), LUNDI, MARDI)
+    comptes = [
+        code
+        for code in CODES_KPI
+        if not code.startswith(("age_", "taux_")) and code != "certifications"
+    ]
+    for jour in (LUNDI, MARDI):
+        for code in comptes:
+            for dimension in DIMENSIONS_KPI[code]:
+                somme = sum(_valeur(table, jour, e, code, dimension)[0] for e in ENTITES)
+                assert _valeur(table, jour, PERIMETRE_PROGRAMME, code, dimension)[0] == somme
+
+
+def test_determinisme() -> None:
+    flux = _flux_varie()
+    assert _kpi(flux, LUNDI, MARDI).equals(_kpi(flux, LUNDI, MARDI))
+
