+def test_stock_et_conservation_sur_le_journal(tmp_path: Path) -> None:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generer(config, 42, date(2026, 10, 12))))
+    source = SourceJournal(chemin)
+    evenements = list(source.evenements())
+    fin = source.entete.date_injection
+    debut = min(jour_ouvre_de(e.horodatage) for e in evenements)
+    jours = jours_ouvres(debut, fin)
+    etats = tickets_etats(evenements, jours)
+    entites = [e.code for e in config.entites]
+    table = kpi(etats, entites)
+
+    fermes = {s.value for s in STATUTS_FERMES}
+    photo = instantane(etats).filter(
+        (pl.col("type_ticket") == TypeTicket.anomalie.value)
+        & ~pl.col("statut").cast(pl.Utf8).is_in(fermes)
+    )
+    for jour in jours:
+        attendu = photo.filter(pl.col("date") == jour).get_column("nombre").sum()
+        assert _valeur(table, jour, PERIMETRE_PROGRAMME, "anomalies_ouvertes")[0] == attendu
+
+    for perimetre in [*entites, PERIMETRE_PROGRAMME]:
+        for veille, jour in pairwise(jours):
+            variation = (
+                _valeur(table, jour, perimetre, "anomalies_ouvertes")[0]
+                - _valeur(table, veille, perimetre, "anomalies_ouvertes")[0]
+            )
+            flux_du_jour = (
+                _valeur(table, jour, perimetre, "entrees_jour")[0]
+                - _valeur(table, jour, perimetre, "sorties_jour")[0]
+            )
+            assert variation == flux_du_jour, (perimetre, jour)
