+"""KPI quotidiens par Entité et pour le Programme (FR-11).
+
+Fonction pure : les états par ticket de chaque Jour ouvré (le détail de l'Instantané) et les
+Entités arrivent en paramètre. Sortie dense au format long (`SCHEMA_KPI`), en entiers : un taux
+ou une valeur sans objet vaut `0/0`.
+"""
+
+from collections import defaultdict
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des KPI, dans l'ordre de sortie ; `code_kpi` reste un texte libre (D10)."""
+
+_PHASES = tuple(p.value for p in Phase)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = {
+    "anomalies_ouvertes": ("",),
+    "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+    "anomalies_ouvertes_phase": _PHASES,
+    "entrees_jour": ("",),
+    "sorties_jour": ("",),
+    "entrees_fenetre": ("",),
+    "sorties_fenetre": ("",),
+    "age_median_anomalies_ouvertes": ("",),
+    "age_max_anomalies_ouvertes": ("",),
+    "taux_ko_cas_de_test": _PHASES,
+    "taux_non_execution_cas_de_test": _PHASES,
+    "certifications": tuple(s.value for s in StatutCertification),
+}
+"""Dimensions de chaque KPI, dans l'ordre des énumérations ; `""` si le KPI n'est pas ventilé."""
+
+_FERMES = [s.value for s in STATUTS_FERMES]
+
+_Cle = tuple[date, str]
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité {PERIMETRE_PROGRAMME} interdite : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Les dates couvrent chaque Jour ouvré de la première à la dernière."""
+    presentes = set(dates)
+    attendues = jours_ouvres(min(dates), max(dates))
+    for jour in attendues:
+        if jour not in presentes:
+            raise UsineErreur(
+                f"Date {jour.isoformat()} absente de l'état des tickets reçu : les KPI exigent"
+                " chaque Jour ouvré de la première à la dernière date"
+            )
+    hors = sorted(presentes - set(attendues))
+    if hors:
+        raise UsineErreur(f"{hors[0].isoformat()} n'est pas un Jour ouvré")
+
+
+def _par_perimetre(etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """Chaque ligne une fois par Entité demandée, et toutes les lignes pour le Programme."""
+    entites_demandees = etats.filter(pl.col("entite").is_in(list(entites))).with_columns(
+        pl.col("entite").alias("perimetre")
+    )
+    programme = etats.with_columns(pl.lit(PERIMETRE_PROGRAMME).alias("perimetre"))
+    return pl.concat([entites_demandees, programme], how="vertical")
+
+
+def _compter(table: pl.DataFrame, *cles: str) -> dict[tuple[object, ...], int]:
+    """Nombre de lignes par valeur de `cles` (valeurs nulles écartées)."""
+    if not table.height:
+        return {}
+    groupes = table.drop_nulls(list(cles)).group_by(list(cles)).agg(pl.len().alias("n"))
+    return {tuple(ligne[:-1]): int(ligne[-1]) for ligne in groupes.iter_rows()}
+
+
+def _enum_texte(colonne: str) -> pl.Expr:
+    return pl.col(colonne).cast(pl.Utf8)
+
+
+def _mouvements(anomalies: pl.DataFrame) -> pl.DataFrame:
+    """Entrée (`E`) et Sortie (`S = E − δ`) de chaque Anomalie à chaque date."""
+    return (
+        anomalies.sort(["cle_ticket", "date"])
+        .with_columns(
+            (pl.col("date_derniere_entree") == pl.col("date")).cast(pl.Int64).alias("entree"),
+            pl.col("ouverte").cast(pl.Int64).alias("ouverte_i"),
+        )
+        .with_columns(
+            pl.col("ouverte_i").shift(1).over("cle_ticket").fill_null(0).alias("ouverte_veille")
+        )
+        .with_columns(
+            (pl.col("entree") - (pl.col("ouverte_i") - pl.col("ouverte_veille"))).alias("sortie")
+        )
+    )
+
+
+def _ages(ouvertes: pl.DataFrame) -> dict[_Cle, list[int]]:
+    """Âges (Jours ouvrés depuis la dernière Entrée) des Anomalies ouvertes, par date, périmètre."""
+    ages: dict[_Cle, list[int]] = defaultdict(list)
+    memoire: dict[tuple[date, date], int] = {}
+    for jour, perimetre, entree in ouvertes.select(
+        "date", "perimetre", "date_derniere_entree"
+    ).iter_rows():
+        if entree is None:
+            raise UsineErreur(
+                f"Anomalie ouverte sans date de dernière Entrée au {jour.isoformat()}"
+            )
+        if (entree, jour) not in memoire:
+            memoire[(entree, jour)] = len(jours_ouvres(entree, jour)) - 1
+        ages[(jour, perimetre)].append(memoire[(entree, jour)])
+    return ages
+
+
+def _mediane(ages: list[int]) -> tuple[int, int]:
+    """Médiane exacte en fraction réduite ; `0/0` sans âge."""
+    if not ages:
+        return 0, 0
+    triees = sorted(ages)
+    milieu = len(triees) // 2
+    if len(triees) % 2:
+        valeur = Fraction(triees[milieu])
+    else:
+        valeur = Fraction(triees[milieu - 1] + triees[milieu], 2)
+    return valeur.numerator, valeur.denominator
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : une ligne par date, périmètre (Entités puis Programme), code et dimension.
+
+    Définitions H-17 : Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée = création ou
+    réouverture (`date_derniere_entree`) ; Sortie = passage à Fermée ou Rejetée. La Fenêtre
+    glissante vient de `contrats.calendrier` (H-19) ; les jours antérieurs à la table comptent 0.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date
+    (sinon `UsineErreur`) ; à sa première date, la veille est vide.
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    if not etats.height:
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = sorted(set(etats.get_column("date").to_list()))
+    _verifier_dates(dates)
+
+    etats = etats.with_columns(_enum_texte("gravite"), _enum_texte("phase"))
+    # Mouvements au grain ticket (la veille d'un ticket est la sienne, quelle que soit son
+    # Entité), puis rattachés à l'Entité du ticket en D.
+    mouvements = _mouvements(
+        etats.filter(pl.col("type_ticket") == TypeTicket.anomalie.value).with_columns(
+            (pl.col("statut").is_not_null() & ~_enum_texte("statut").is_in(_FERMES)).alias(
+                "ouverte"
+            )
+        )
+    )
+    mouvements = _par_perimetre(mouvements, entites)
+    ouvertes = mouvements.filter(pl.col("ouverte"))
+    etats = _par_perimetre(etats, entites)
+    tests = etats.filter(pl.col("type_ticket") == TypeTicket.cas_de_test.value).with_columns(
+        _enum_texte("statut_test").alias("statut_test")
+    )
+    certifications = etats.filter(
+        pl.col("type_ticket") == TypeTicket.certification.value
+    ).with_columns(_enum_texte("statut_certification").alias("statut_certification"))
+
+    stock = _compter(ouvertes, "date", "perimetre")
+    par_gravite = _compter(ouvertes, "date", "perimetre", "gravite")
+    par_phase = _compter(ouvertes, "date", "perimetre", "phase")
+    entrees = {
+        (j, p): int(n)
+        for j, p, n in mouvements.group_by("date", "perimetre")
+        .agg(pl.col("entree").sum())
+        .iter_rows()
+    }
+    sorties = {
+        (j, p): int(n)
+        for j, p, n in mouvements.group_by("date", "perimetre")
+        .agg(pl.col("sortie").sum())
+        .iter_rows()
+    }
+    ages = _ages(ouvertes)
+    tests_par_statut = _compter(tests, "date", "perimetre", "phase", "statut_test")
+    tests_par_phase = _compter(
+        tests.filter(pl.col("statut_test").is_not_null()), "date", "perimetre", "phase"
+    )
+    certifs = _compter(certifications, "date", "perimetre", "statut_certification")
+
+    def fenetre(serie: dict[_Cle, int], jour: date, perimetre: str) -> int:
+        return sum(serie.get((j, perimetre), 0) for j in fenetre_glissante(jour))
+
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+
+    def ajouter(jour: date, perimetre: str, code: str, dimension: str, num: int, den: int) -> None:
+        for colonne, valeur in zip(
+            lignes, (jour, perimetre, code, dimension, num, den), strict=True
+        ):
+            lignes[colonne].append(valeur)
+
+    for jour in dates:
+        for perimetre in perimetres:
+            cle = (jour, perimetre)
+            liste_ages = ages.get(cle, [])
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    num, den = 0, 1
+                    match code:
+                        case "anomalies_ouvertes":
+                            num = stock.get(cle, 0)
+                        case "anomalies_ouvertes_gravite":
+                            num = par_gravite.get((*cle, dimension), 0)
+                        case "anomalies_ouvertes_phase":
+                            num = par_phase.get((*cle, dimension), 0)
+                        case "entrees_jour":
+                            num = entrees.get(cle, 0)
+                        case "sorties_jour":
+                            num = sorties.get(cle, 0)
+                        case "entrees_fenetre":
+                            num = fenetre(entrees, jour, perimetre)
+                        case "sorties_fenetre":
+                            num = fenetre(sorties, jour, perimetre)
+                        case "age_median_anomalies_ouvertes":
+                            num, den = _mediane(liste_ages)
+                        case "age_max_anomalies_ouvertes":
+                            num, den = (max(liste_ages), 1) if liste_ages else (0, 0)
+                        case "taux_ko_cas_de_test":
+                            ko = tests_par_statut.get((*cle, dimension, StatutTest.ko.value), 0)
+                            ok = tests_par_statut.get((*cle, dimension, StatutTest.ok.value), 0)
+                            num, den = ko, ko + ok
+                        case "taux_non_execution_cas_de_test":
+                            num = tests_par_statut.get(
+                                (*cle, dimension, StatutTest.non_execute.value), 0
+                            )
+                            den = tests_par_phase.get((*cle, dimension), 0)
+                        case "certifications":
+                            num = certifs.get((*cle, dimension), 0)
+                    ajouter(jour, perimetre, code, dimension, num, den)
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
