+    textes,
+)
+from usine.contrats.config import ConfigChaine, ConfigUsine
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import (
+    ReponseClassification,
+    ReponseExplication,
+    SortieClassification,
+    StatutControle,
+    Tache,
+)
+from usine.contrats.passage import ContextePassage, StatutEtape
+from usine.contrats.tickets import SCHEMA_TICKET_TEXTE, CauseRacine
+from usine.contrats.trace import EntreeTrace
+from usine.contrats.versions import version_prompt
+from usine.ia.classification import (
+    PART_PLAFOND_CLASSIFICATION,
+    ContexteClassification,
+    EtapeClassification,
+    classer,
+    lire_prompt,
+    rendre_prompt,
+)
+from usine.ia.explication import ContexteExplication, expliquer
+from usine.ia.explication import lire_prompt as lire_prompt_explication
+from usine.ia.passerelle import Passerelle
+from usine.ports.consultation import Consultation
+from usine.ports.etape import Etape as PortEtape
+
+RACINE = Path(__file__).resolve().parents[3]
+TROIS = {
+    "DEMO-10": ("Flux en échec", "Le flux de paie ne part plus."),
+    "DEMO-2": ("Taux faux", "Le taux de TVA est mal paramétré."),
+    "DEMO-1": ("Solde faux", "Le solde repris de l'ancien SI est faux."),
+}
+
+
+def _contexte(plafond_eur: Decimal | None = None) -> ContexteClassification:
+    return ContexteClassification(
+        passage_id=PASSAGE_ID,
+        version_grille="grille123456",
+        version_donnees="d" * 64,
+        gabarit=lire_prompt(),
+        plafond_eur=plafond_eur,
+    )
+
+
+def _reponse(
+    cause: CauseRacine = CauseRacine.parametrage, justification: str = ""
+) -> ReponseClassification:
+    return ReponseClassification(cause_racine=cause, justification=justification)
+
+
+def _passerelle(
+    factice: FournisseurFactice,
+    cache: CacheMemoire | None = None,
+    plafond: Decimal | None = None,
+) -> Passerelle:
+    return Passerelle(
+        factice,
+        pseudonymiseur(),
+        cache if cache is not None else CacheMemoire(),
+        horloge_espion([]),
+        tarif=lambda *_: Decimal(1),
+        plafond_cout_passage_eur=plafond,
+    )
+
+
+def _classer(
+    factice: FournisseurFactice,
+    table: pl.DataFrame,
+    cache: CacheMemoire | None = None,
+    date_arrete: date = DATE_ARRETE,
+) -> tuple[tuple[SortieClassification, ...], tuple[EntreeTrace, ...]]:
+    return classer(_passerelle(factice, cache), table, date_arrete, _contexte())
+
+
+def test_premier_passage_une_sortie_par_anomalie_triee() -> None:
+    factice = FournisseurFactice(
+        [
+            _reponse(CauseRacine.reprise_donnees, "Le solde de DEMO-1 vient de la reprise."),
+            _reponse(CauseRacine.parametrage),
+            _reponse(CauseRacine.interface_flux),
+        ]
+    )
+    sorties, traces = _classer(factice, textes(TROIS))
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert [s.cause_racine for s in sorties] == [
+        CauseRacine.reprise_donnees,
+        CauseRacine.parametrage,
+        CauseRacine.interface_flux,
+    ]
+    assert {s.statut_controle for s in sorties} == {StatutControle.conforme}
+    assert sorties[0].justification == "Le solde de DEMO-1 vient de la reprise."
+    assert len(factice.appels) == 3
+    assert {a.parametres.tache for a in factice.appels} == {Tache.classification}
+    assert [t.cible for t in traces] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert {t.tache for t in traces} == {Tache.classification}
+    assert {t.depuis_cache for t in traces} == {False}
+    assert {t.entite for t in traces} == {"ENT-A"}
+    assert {t.version_grille for t in traces} == {"grille123456"}
+    assert {t.version_prompt for t in traces} == {version_prompt(lire_prompt())}
+
+
+def test_rejeu_autre_date_d_arrete_tout_du_cache() -> None:
+    cache = CacheMemoire()
+    reponses = [_reponse(c) for c in (CauseRacine.environnement,) * 3]
+    premieres, _ = _classer(FournisseurFactice(reponses), textes(TROIS), cache)
+    factice = FournisseurFactice()  # aucune réponse : tout vient du cache
+    sorties, traces = _classer(factice, textes(TROIS), cache, DATE_ARRETE + timedelta(days=1))
+    assert factice.appels == []
+    assert sorties == premieres
+    assert {t.depuis_cache for t in traces} == {True}
+
+
+def test_incremental_seules_les_anomalies_nouvelles_ou_modifiees_partent() -> None:
+    cache = CacheMemoire()
+    avant = {"DEMO-1": TROIS["DEMO-1"], "DEMO-2": TROIS["DEMO-2"]}
+    _classer(FournisseurFactice([_reponse(), _reponse()]), textes(avant), cache)
+    apres = {
+        "DEMO-1": TROIS["DEMO-1"],  # inchangée
+        "DEMO-2": ("Taux faux", "Le taux de TVA est faux depuis la reprise."),  # modifiée
