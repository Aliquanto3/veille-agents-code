+def test_part_du_plafond_cache_servi_et_explications_encore_appelees() -> None:
+    """NFR-9 : au-delà de sa part, la classification n'appelle plus ; le cache reste servi et
+    les explications gardent le reste du plafond du Passage."""
+    cache = CacheMemoire()
+    plafond = Decimal(4)
+    part = plafond * PART_PLAFOND_CLASSIFICATION
+    assert part == Decimal(2)
+    table = textes(TROIS)
+    # Un premier Passage met DEMO-1 en cache.
+    classer(
+        _passerelle(FournisseurFactice([_reponse()]), cache, plafond),
+        textes({"DEMO-1": TROIS["DEMO-1"]}),
+        DATE_ARRETE,
+        _contexte(part),
+    )
+    factice = FournisseurFactice(
+        [_reponse(), _reponse(), ReponseExplication(texte="DEMO-1 est en cause.")]
+    )
+    passerelle = _passerelle(factice, cache, plafond)
+    contexte = ContexteClassification(
+        passage_id="20261013T073000Z-def456",
+        version_grille="grille123456",
+        version_donnees="d" * 64,
+        gabarit=lire_prompt(),
+        plafond_eur=part,
+    )
+    sorties, traces = classer(passerelle, table, DATE_ARRETE, contexte)
+    # DEMO-1 du cache (0 €), DEMO-2 et DEMO-10 frais (1 € chacun) : la part (2 €) est atteinte
+    # après DEMO-10, dernier de l'ordre des clés.
+    assert [(t.cible, t.depuis_cache) for t in traces] == [
+        ("DEMO-1", True),
+        ("DEMO-2", False),
+        ("DEMO-10", False),
+    ]
+    assert passerelle.cout_cumule_eur(contexte.passage_id) == part
+    # Part atteinte : un nouvel appel frais est refusé, le cache reste servi.
+    autre = textes({**TROIS, "DEMO-11": ("Nouvelle", "Description.")})
+    sorties, traces = classer(passerelle, autre, DATE_ARRETE, contexte)
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert {t.depuis_cache for t in traces} == {True}
+    assert len(factice.appels) == 2
+    # Les explications disposent du reste du plafond du Passage.
+    explication, traces_explication = expliquer(
+        passerelle,
+        meteo_rouge("ENT-A", ("DEMO-1",)),
+        table,
+        ContexteExplication(
+            passage_id=contexte.passage_id,
+            version_donnees="d" * 64,
+            gabarit=lire_prompt_explication(),
+        ),
+    )
+    assert len(factice.appels) == 3
+    assert explication.statut_controle is StatutControle.conforme
+    assert not traces_explication[0].depuis_cache
+
