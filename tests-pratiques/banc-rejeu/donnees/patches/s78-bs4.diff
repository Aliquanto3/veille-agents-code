+++ b/src/usine/ia/agent/outils.py
@@ -0,0 +1,179 @@
+"""Outils de consultation de l'Agent : lecture seule, servis par `Consultation` (FR-39, AD-11).
+
+Chaque outil prend un `Arguments*` de `contrats.agent` et rend un `Resultat*`, ou `AucuneDonnee`
+quand le Passage ne couvre pas la Date d'arrêté demandée. La sérialisation en texte et la
+Pseudonymisation reviennent à la passerelle (Story 7.9).
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports import Consultation
+
+NOMS_OUTILS: tuple[str, ...] = (
+    "get_meteo",
+    "list_anomalies",
+    "get_tendance",
+    "get_prevision",
+    "get_risques",
+)
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Un outil de l'Agent : nom, description, classe d'arguments et exécution."""
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+    """Valide les arguments JSON (`ValidationError` sinon) puis lit le Passage."""
+
+
+class OutilsConsultation:
+    """Les cinq outils de lecture de l'Agent, au-dessus d'une `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _date(self, demandee: date | None) -> date | None:
+        """Date d'arrêté à lire, ou `None` si le Passage ne la couvre pas."""
+        disponibles = self._consultation.dates_disponibles()
+        if not disponibles:
+            return None
+        date_arrete = (
+            demandee if demandee is not None else self._consultation.manifeste().date_arrete
+        )
+        return date_arrete if date_arrete in disponibles else None
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        date_arrete = self._date(arguments.date_arrete)
+        if date_arrete is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        evolutions = self._consultation.evolution_meteo(date_arrete)
+        if arguments.entite is not None:
+            evolutions = tuple(e for e in evolutions if e.entite == arguments.entite)
+        return ResultatGetMeteo(
+            date_arrete=date_arrete,
+            meteos=self._consultation.meteo(date_arrete, arguments.entite),
+            evolutions=evolutions,
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées ; `total` compte avant la limite."""
+        date_arrete = self._date(arguments.date_arrete)
+        if date_arrete is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        filtres: dict[str, Any] = {
+            "date_arrete": date_arrete,
+            "entite": arguments.entite,
+            "gravite": arguments.gravite,
+            "phase": arguments.phase,
+            "domaine": arguments.domaine,
+        }
+        if arguments.statut is None:
+            return self._consultation.anomalies(limite=arguments.limite, **filtres)
+        toutes = self._consultation.anomalies(limite=None, **filtres)
+        retenues = tuple(a for a in toutes.anomalies if a.statut == arguments.statut)
+        return ResultatListAnomalies(
+            date_arrete=date_arrete,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire (sans date : jamais `AucuneDonnee`)."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        champs = list(PointTendance.model_fields)
+        points = tuple(PointTendance(**ligne) for ligne in table.select(champs).to_dicts())
+        return ResultatGetTendance(points=points)
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        date_arrete = self._date(arguments.date_arrete)
+        if date_arrete is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetPrevision(
+            date_arrete=date_arrete,
+            previsions=self._consultation.previsions(date_arrete, arguments.entite),
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        date_arrete = self._date(arguments.date_arrete)
+        if date_arrete is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetRisques(
+            date_arrete=date_arrete,
+            risques=self._consultation.risques(date_arrete, arguments.entite),
+        )
+
+
+def _definir[A: Enregistrement](
+    nom: str, description: str, arguments: type[A], appel: Callable[[A], Enregistrement]
+) -> DefinitionOutil:
+    return DefinitionOutil(
+        nom=nom,
+        description=description,
+        arguments=arguments,
+        executer=lambda brut: appel(arguments.model_validate(brut)),
+    )
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Les cinq outils de l'Agent, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+    return (
+        _definir(
+            "get_meteo",
+            "Météo, Règles déclenchantes et évolution J-1 / J-5 par Entité.",
+            ArgumentsGetMeteo,
+            outils.get_meteo,
+        ),
+        _definir(
+            "list_anomalies",
+            "Anomalies ouvertes, filtrées par Entité, Gravité, Phase, domaine et statut.",
+            ArgumentsListAnomalies,
+            outils.list_anomalies,
+        ),
+        _definir(
+            "get_tendance",
+            "Tendances hebdomadaires des KPI, par Entité et par KPI.",
+            ArgumentsGetTendance,
+            outils.get_tendance,
+        ),
+        _definir(
+            "get_prevision",
+            "Prévisions de sortie du rouge par Entité.",
+            ArgumentsGetPrevision,
+            outils.get_prevision,
+        ),
+        _definir(
+            "get_risques",
+            "Risques d'entrée en rouge par Entité.",
+            ArgumentsGetRisques,
+            outils.get_risques,
+        ),
+    )
