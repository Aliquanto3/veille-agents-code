+"""Tâche `classification` : une Cause racine par Anomalie, incrémentale par le cache (FR-35)."""
+
+import logging
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.doublures.fournisseur_factice import FournisseurFactice
+from tests.unit.ia.espions import (
+    NUMERO_COMPTE,
+    PASSAGE_ID,
+    CacheMemoire,
+    horloge_espion,
+    jeton_compte,
+    pseudonymiseur,
+    textes,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import ReponseClassification, StatutControle, Tache
+from usine.contrats.tickets import SCHEMA_TICKET_TEXTE, CauseRacine
+from usine.contrats.versions import version_prompt
+from usine.ia.classification import (
+    PART_PLAFOND_CLASSIFICATION,
+    ContexteClassification,
+    classer,
+    lire_prompt,
+    rendre_prompt,
+)
+from usine.ia.passerelle import Passerelle
+
+RACINE = Path(__file__).resolve().parents[3]
+DATE_1 = date(2026, 10, 9)
+DATE_2 = date(2026, 10, 12)
+TEXTES = {
+    "DEMO-10": ("Virement rejeté", f"Le virement du compte {NUMERO_COMPTE} est rejeté."),
+    "DEMO-2": ("Table de taux", "Le taux est mal réglé."),
+    "DEMO-1": ("Écart de solde", "Le solde migré diffère."),
+}
+
+
+def _contexte(plafond: Decimal | None = None) -> ContexteClassification:
+    return ContexteClassification(
+        passage_id=PASSAGE_ID,
+        version_donnees="d" * 64,
+        version_grille="grille123456",
+        gabarit=lire_prompt(),
+        plafond_eur=plafond,
+    )
+
+
+def _reponse(
+    cause: CauseRacine = CauseRacine.parametrage, justification: str = ""
+) -> ReponseClassification:
+    return ReponseClassification(cause_racine=cause, justification=justification)
+
+
+def _passerelle(
+    factice: FournisseurFactice, cache: CacheMemoire | None = None, **kwargs: object
+) -> Passerelle:
+    return Passerelle(
+        factice,
+        pseudonymiseur(),
+        cache if cache is not None else CacheMemoire(),
+        horloge_espion([]),
+        **kwargs,  # type: ignore[arg-type]
+    )
+
+
+def test_premier_passage_un_appel_par_anomalie_tri_par_rang_cle() -> None:
+    factice = FournisseurFactice(
+        [_reponse(CauseRacine.reprise_donnees), _reponse(), _reponse(CauseRacine.environnement)]
+    )
+    sorties, traces = classer(_passerelle(factice), textes(TEXTES), DATE_1, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert [s.cause_racine for s in sorties] == [
+        CauseRacine.reprise_donnees,
+        CauseRacine.parametrage,
+        CauseRacine.environnement,
+    ]
+    assert {s.statut_controle for s in sorties} == {StatutControle.conforme}
+    assert len(factice.appels) == len(traces) == 3
+    assert {t.tache for t in traces} == {Tache.classification}
+    assert [t.cible for t in traces] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert {t.depuis_cache for t in traces} == {False}
+    assert {t.version_grille for t in traces} == {"grille123456"}
+    assert {t.version_prompt for t in traces} == {version_prompt(lire_prompt())}
+
+
+def test_rejeu_autre_date_d_arrete_sans_appel() -> None:
+    cache = CacheMemoire()
+    premier = FournisseurFactice([_reponse(), _reponse(), _reponse()])
+    sorties, _ = classer(_passerelle(premier, cache), textes(TEXTES), DATE_1, _contexte())
+    second = FournisseurFactice()
+    rejouees, traces = classer(_passerelle(second, cache), textes(TEXTES), DATE_2, _contexte())
+    assert second.appels == []
+    assert rejouees == sorties
+    assert {t.depuis_cache for t in traces} == {True}
+
+
+def test_incremental_nouvelle_et_modifiee() -> None:
+    cache = CacheMemoire()
+    premier = FournisseurFactice([_reponse(), _reponse()])
+    ancien = {cle: TEXTES[cle] for cle in ("DEMO-1", "DEMO-2")}
+    classer(_passerelle(premier, cache), textes(ancien), DATE_1, _contexte())
+    nouveau = {
+        "DEMO-1": ancien["DEMO-1"],
+        "DEMO-2": (ancien["DEMO-2"][0], "Description modifiée."),
+        "DEMO-3": ("Nouvelle", "Anomalie nouvelle."),
+    }
+    second = FournisseurFactice([_reponse(), _reponse()])
+    _, traces = classer(_passerelle(second, cache), textes(nouveau), DATE_2, _contexte())
+    assert len(second.appels) == 2
+    assert {t.cible: t.depuis_cache for t in traces} == {
+        "DEMO-1": True,
+        "DEMO-2": False,
+        "DEMO-3": False,
+    }
+
+
+def test_hors_anomalie_ignore() -> None:
+    table = pl.concat(
+        [
+            textes({"DEMO-1": ("Titre", "Description")}),
+            textes({"DEMO-2": ("Cas", "Cas de test")}).with_columns(
+                pl.lit("cas_de_test")
+                .cast(SCHEMA_TICKET_TEXTE.colonnes["type_ticket"])
+                .alias("type_ticket")
+            ),
+            textes({"DEMO-3": ("Certif", "Certification")}).with_columns(
+                pl.lit("certification")
+                .cast(SCHEMA_TICKET_TEXTE.colonnes["type_ticket"])
+                .alias("type_ticket")
+            ),
+        ]
+    )
+    factice = FournisseurFactice([_reponse()])
+    sorties, traces = classer(_passerelle(factice), table, DATE_1, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1"]
+    assert len(factice.appels) == len(traces) == 1
+
+
+def test_aucune_anomalie() -> None:
+    factice = FournisseurFactice()
+    sorties, traces = classer(_passerelle(factice), textes({}), DATE_1, _contexte())
+    assert (sorties, traces) == ((), ())
+    assert factice.appels == []
+
+
+def test_plafond_atteint_anomalie_non_classee(caplog: pytest.LogCaptureFixture) -> None:
+    factice = FournisseurFactice()
+    passerelle = _passerelle(factice, plafond_cout_passage_eur=Decimal(0))
+    with caplog.at_level(logging.WARNING):
+        sorties, traces = classer(passerelle, textes(TEXTES), DATE_1, _contexte())
+    assert (sorties, traces) == ((), ())
+    assert factice.appels == []
+    assert "plafond" in caplog.text
+
+
+def test_part_du_plafond_refuse_l_appel_frais_mais_sert_le_cache() -> None:
+    assert Decimal("0.5") == PART_PLAFOND_CLASSIFICATION
+    cache = CacheMemoire()
+    deja = {"DEMO-1": TEXTES["DEMO-1"]}
+    classer(_passerelle(FournisseurFactice([_reponse()]), cache), textes(deja), DATE_1, _contexte())
+    factice = FournisseurFactice([_reponse(), _reponse()])
+    passerelle = _passerelle(
+        factice, cache, tarif=lambda *_: Decimal("0.6"), plafond_cout_passage_eur=Decimal(10)
+    )
+    part = Decimal("0.5")
+    tous = {cle: TEXTES[cle] for cle in ("DEMO-1", "DEMO-2", "DEMO-10")}
+    sorties, traces = classer(passerelle, textes(tous), DATE_2, _contexte(part))
+    # DEMO-1 vient du cache ; DEMO-2 franchit la part (0,6 €) ; DEMO-10 est refusée.
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2"]
+    assert len(factice.appels) == 1
+    assert [t.depuis_cache for t in traces] == [True, False]
+    # Le plafond du Passage n'est pas atteint : une autre tâche peut encore appeler.
+    assert passerelle.cout_cumule_eur(PASSAGE_ID) == Decimal("0.6") < Decimal(10)
+
+
+def test_justification_hors_cible_corrigee() -> None:
+    factice = FournisseurFactice(
+        [_reponse(justification="DEMO-1 est mal migré. DEMO-9 aggrave le retard.")]
+    )
+    sorties, _ = classer(
+        _passerelle(factice), textes({"DEMO-1": TEXTES["DEMO-1"]}), DATE_1, _contexte()
+    )
+    (sortie,) = sorties
+    assert sortie.justification == "DEMO-1 est mal migré."
+    assert "DEMO-9" not in sortie.justification
+    assert sortie.statut_controle is StatutControle.corrige
+
+
+def test_pseudonymisation_de_l_entree_et_delimiteurs() -> None:
+    factice = FournisseurFactice([_reponse()])
+    table = textes({"DEMO-10": ("Titre ``` piégé", TEXTES["DEMO-10"][1])})
+    classer(_passerelle(factice), table, DATE_1, _contexte())
+    (appel,) = factice.appels
+    prompt = str(appel.entree)
+    assert NUMERO_COMPTE not in prompt
+    assert jeton_compte() in prompt
+    assert prompt.count("```") == 2  # le bloc de données, sans délimiteur dans le titre
+    assert appel.parametres.tache is Tache.classification
+
+
+def test_fournisseur_en_erreur_propage() -> None:
+    factice = FournisseurFactice()
+    with pytest.raises(UsineErreur):
+        classer(_passerelle(factice), textes(TEXTES), DATE_1, _contexte())
+
+
+def test_prompt_sept_causes_et_variables() -> None:
+    gabarit = lire_prompt().decode("utf-8")
+    prompt = rendre_prompt(gabarit, {"cle": "DEMO-1", "causes": "- x", "ticket": "t"})
+    assert "{{" not in prompt
+    with pytest.raises(UsineErreur, match="manquantes"):
+        rendre_prompt(gabarit, {"cle": "DEMO-1"})
+    factice = FournisseurFactice([_reponse()])
+    classer(_passerelle(factice), textes({"DEMO-1": ("t", "d")}), DATE_1, _contexte())
+    envoye = str(factice.appels[0].entree)
+    assert all(cause.value in envoye for cause in CauseRacine)
+
+
+@pytest.mark.parametrize("motif", ["jira_cloud", "jira_dc", "jira_http", "composite"])
+def test_aucune_cause_racine_dans_les_adaptateurs_jira(motif: str) -> None:
