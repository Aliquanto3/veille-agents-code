+class FournisseurClassifieur(FournisseurFactice):
+    """Fournisseur factice qui répond seul à la classification (hors file scriptée).
+
+    Les prompts de classification sont dans `classifications` ; `appels` ne compte que les
+    autres appels (explications).
+    """
+
+    def __init__(self, *args: Any, **kwargs: Any) -> None:
+        super().__init__(*args, **kwargs)
+        self.classifications: list[str] = []
+
+    def generer_structure[T: BaseModel](
+        self, prompt: str, schema: type[T], parametres: ParametresAppel
+    ) -> ReponseStructuree[T]:
+        if schema is not ReponseClassification:
+            return super().generer_structure(prompt, schema, parametres)
+        self.classifications.append(prompt)
+        sortie = ReponseClassification(
+            cause_racine=CauseRacine.parametrage, justification="Table mal réglée."
+        )
+        brut = sortie.model_dump_json()
+        return ReponseStructuree[T](
+            sortie=cast(T, sortie),
+            brut=brut,
+            jetons_entree=len(prompt.split()),
+            jetons_sortie=len(brut.split()),
+            version_modele=self.version_modele,
+        )
+
+
