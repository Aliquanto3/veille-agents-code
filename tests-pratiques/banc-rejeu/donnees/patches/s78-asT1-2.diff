+"""Outils de consultation de l'Agent, en lecture seule (FR-39, FR-41, AD-5, AD-11).
+
+Chaque outil prend un `Arguments*` de `contrats.agent` et rend un `Resultat*` lu par
+`Consultation`, ou `AucuneDonnee` quand le Passage ne couvre pas la Date d'arrêté demandée.
+La sérialisation en texte et la Pseudonymisation reviennent à la passerelle.
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS = ("get_meteo", "list_anomalies", "get_tendance", "get_prevision", "get_risques")
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Un outil : nom, description, classe d'arguments et exécution sur des arguments JSON."""
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+
+
+class OutilsConsultation:
+    """Les cinq outils de lecture, servis par `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _jour(self, demandee: date | None) -> date | None:
+        """Date à lire, ou `None` quand le Passage ne couvre pas la date demandée."""
+        disponibles = self._consultation.dates_disponibles()
+        jour = demandee if demandee is not None else self._date_du_manifeste(disponibles)
+        return jour if jour in disponibles else None
+
+    def _date_du_manifeste(self, disponibles: tuple[date, ...]) -> date | None:
+        return self._consultation.manifeste().date_arrete if disponibles else None
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        evolutions = self._consultation.evolution_meteo(jour)
+        return ResultatGetMeteo(
+            date_arrete=jour,
+            meteos=self._consultation.meteo(jour, arguments.entite),
+            evolutions=tuple(e for e in evolutions if arguments.entite in (None, e.entite)),
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        # Le statut ne se filtre pas dans `Consultation` : on lit tout, puis on borne ici.
+        limite = arguments.limite if arguments.statut is None else None
+        toutes = self._consultation.anomalies(
+            jour,
+            entite=arguments.entite,
+            gravite=arguments.gravite,
+            phase=arguments.phase,
+            domaine=arguments.domaine,
+            limite=limite,
+        )
+        if arguments.statut is None:
+            return toutes
+        retenues = tuple(a for a in toutes.anomalies if a.statut == arguments.statut)
+        return ResultatListAnomalies(
+            date_arrete=jour, anomalies=retenues[: arguments.limite], total=len(retenues)
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        champs = PointTendance.model_fields
+        return ResultatGetTendance(
+            points=tuple(
+                PointTendance.model_validate({k: v for k, v in ligne.items() if k in champs})
+                for ligne in table.iter_rows(named=True)
+            )
+        )
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetPrevision(
+            date_arrete=jour, previsions=self._consultation.previsions(jour, arguments.entite)
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetRisques(
+            date_arrete=jour, risques=self._consultation.risques(jour, arguments.entite)
+        )
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Les cinq outils de consultation, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+    return (
+        DefinitionOutil(
+            nom="get_meteo",
+            description=(
+                "Météo de chaque Entité à une Date d'arrêté, avec les Règles déclenchantes"
+                " et l'évolution à J-1 et J-5."
+            ),
+            arguments=ArgumentsGetMeteo,
+            executer=lambda brut: outils.get_meteo(ArgumentsGetMeteo.model_validate(brut)),
+        ),
+        DefinitionOutil(
+            nom="list_anomalies",
+            description=(
+                "Anomalies ouvertes, filtrables par Entité, Gravité, Phase, domaine et statut."
+            ),
+            arguments=ArgumentsListAnomalies,
+            executer=lambda brut: outils.list_anomalies(
+                ArgumentsListAnomalies.model_validate(brut)
+            ),
+        ),
+        DefinitionOutil(
+            nom="get_tendance",
+            description="Tendances hebdomadaires des KPI, filtrables par Entité et par KPI.",
+            arguments=ArgumentsGetTendance,
+            executer=lambda brut: outils.get_tendance(ArgumentsGetTendance.model_validate(brut)),
+        ),
+        DefinitionOutil(
+            nom="get_prevision",
+            description="Prévisions de sortie du rouge à une Date d'arrêté.",
+            arguments=ArgumentsGetPrevision,
+            executer=lambda brut: outils.get_prevision(ArgumentsGetPrevision.model_validate(brut)),
+        ),
+        DefinitionOutil(
+            nom="get_risques",
+            description="Risques d'entrée en rouge à une Date d'arrêté.",
+            arguments=ArgumentsGetRisques,
+            executer=lambda brut: outils.get_risques(ArgumentsGetRisques.model_validate(brut)),
+        ),
+    )
