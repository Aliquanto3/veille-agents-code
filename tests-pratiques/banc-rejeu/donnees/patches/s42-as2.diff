+def test_entrees_invalides(grille: GrilleMeteo) -> None:
+    serie = _series()
+    with pytest.raises(UsineErreur, match=ENTITE):
+        risques_entree_rouge(serie, _meteo(Couleur.rouge), grille)
+    # D absente pour IND-3
+    sans_d = _table(
+        _lignes(IND_1, CONSTANT) + _lignes(IND_3, CONSTANT)[:-1] + _lignes(IND_4, [(1, 100)] * 10)
+    )
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*IND-3"):
+        risques_entree_rouge(sans_d, _meteo(), grille)
+    # trou
+    lignes = _lignes(IND_3, CONSTANT)
+    trou = _table(
+        _lignes(IND_1, CONSTANT) + lignes[:4] + lignes[5:] + _lignes(IND_4, [(1, 100)] * 10)
+    )
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*trou"):
+        risques_entree_rouge(trou, _meteo(), grille)
+    # date non ouvrée
+    samedi = (date(2026, 10, 3), ENTITE, IND_3, "evalue", "", 1, 1, "vert")
+    non_ouvre = _table(serie_lignes(samedi))
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*Jour ouvré"):
+        risques_entree_rouge(non_ouvre, _meteo(), grille)
+    # doublon
+    doublon = _table(
+        _lignes(IND_1, CONSTANT)
+        + _lignes(IND_3, CONSTANT)
+        + [_lignes(IND_3, CONSTANT)[-1]]
+        + _lignes(IND_4, [(1, 100)] * 10)
+    )
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*double"):
+        risques_entree_rouge(doublon, _meteo(), grille)
+    # dénominateur 0 sur une valeur évaluée
+    zero = _series(ind3=[(1, 1)] * 9 + [(1, 0)])
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*dénominateur"):
+        risques_entree_rouge(zero, _meteo(), grille)
+
