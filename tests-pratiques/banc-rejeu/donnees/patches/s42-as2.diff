@@ -0,0 +1,370 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main sur 10 Jours ouvrés finissant le vendredi 09/10/2026 (D),
+x = 0..9, projection à x = 9 + h. Grille livrée : rouge IND-1 `>= 3`, IND-3 `>= 20`,
+IND-4 `>= 1/5`.
+
+- IND-3 = 10..19 : pente 1, ordonnée 10, p(1) = 20 ≥ 20 → D + 1 JO.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σy = 7, ȳ = 7/10, Σ(x − 9/2)² = 165/2, Σ(x − x̄)(y − ȳ) = 41/2
+  → pente 41/165, ordonnée 7/10 − 41/165·9/2 = −23/55 ; p(4) = 464/165 < 3, p(5) = 101/33 ≥ 3.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5.
+"""
+
+from collections.abc import Sequence
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.config import charger_yaml
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import ParametresRisque, risques_entree_rouge
+
+RACINE = Path(__file__).resolve().parents[4]
+CHEMIN_GRILLE = RACINE / "config" / "grille_meteo.yaml"
+D = date(2026, 10, 9)
+ENTITE = "ENT-A"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Valeur = tuple[int, int]
+CONSTANT = [(1, 1)] * 10
+
+
+def _jours(n: int = 10) -> Sequence[date]:
+    return jours_ouvres(date(2026, 1, 1), D)[-n:]
+
+
+def _lignes(
+    code: CodeIndicateur, valeurs: Sequence[Valeur | str], entite: str = ENTITE
+) -> list[Any]:
+    """Une ligne par Jour ouvré finissant à D ; une `str` vaut « non évaluable » avec ce motif."""
+    lignes = []
+    for jour, valeur in zip(_jours(len(valeurs)), valeurs, strict=True):
+        evalue = not isinstance(valeur, str)
+        lignes.append(
+            (
+                jour,
+                entite,
+                code,
+                "evalue" if evalue else "non_evaluable",
+                "" if evalue else valeur,
+                valeur[0] if not isinstance(valeur, str) else 0,
+                valeur[1] if not isinstance(valeur, str) else 0,
+                "vert",
+            )
+        )
+    return lignes
+
+
+def _table(lignes: list[Any]) -> pl.DataFrame:
+    colonnes = list(SCHEMA_INDICATEUR.colonnes)
+    brut = pl.DataFrame(
+        {c: [ligne[i] for ligne in lignes] for i, c in enumerate(colonnes)},
+        schema=dict(SCHEMA_INDICATEUR.colonnes),
+    )
+    return valider(brut, SCHEMA_INDICATEUR)
+
+
+def _series(
+    ind1: Sequence[Valeur | str] | None = None,
+    ind3: Sequence[Valeur | str] | None = None,
+    ind4: Sequence[Valeur | str] | None = None,
+) -> pl.DataFrame:
+    constant = CONSTANT
+    return _table(
+        _lignes(IND_1, ind1 or constant)
+        + _lignes(IND_3, ind3 or constant)
+        + _lignes(IND_4, ind4 or [(1, 100)] * 10)
+    )
+
+
+def _entiers(*valeurs: int) -> list[Valeur | str]:
+    return [(v, 1) for v in valeurs]
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regle = RegleDeclenchante(
+        code=CodeIndicateur.ind_5,
+        couleur=couleur,
+        operateur=Operateur.superieur_ou_egal,
+        numerateur=1,
+        denominateur=1,
+        seuil_numerateur=1,
+        seuil_denominateur=1,
+        tickets_en_cause=(),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(regle,),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+@pytest.fixture(scope="module")
+def grille() -> GrilleMeteo:
+    return charger_yaml(CHEMIN_GRILLE, GrilleMeteo)
+
+
+def _grille_modifiee(modifier: Any) -> GrilleMeteo:
+    donnees = yaml.safe_load(CHEMIN_GRILLE.read_text(encoding="utf-8"))
+    modifier(donnees["indicateurs"])
+    return GrilleMeteo.model_validate(donnees)
+
+
+def test_franchissement_ind_3(grille: GrilleMeteo) -> None:
+    resultat = risques_entree_rouge(_series(ind3=_entiers(*range(10, 20))), _meteo(), grille)
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    (projete,) = resultat.risques
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.date_franchissement_estimee == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert r.date_arrete == D
+    assert r.entite == ENTITE
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1(grille: GrilleMeteo) -> None:
+    ind1 = _entiers(0, 0, 0, 0, 0, 1, 1, 1, 2, 2)
+    pente, ordonnee = risque._regression([Fraction(v, 1) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)])
+    assert (pente, ordonnee) == (Fraction(41, 165), Fraction(-23, 55))
+    resultat = risques_entree_rouge(_series(ind1=ind1), _meteo(), grille)
+    (projete,) = resultat.risques
+    assert projete.risque.indicateur is IND_1
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_horizon_plus_court_sans_risque(grille: GrilleMeteo) -> None:
+    ind1 = _entiers(0, 0, 0, 0, 0, 1, 1, 1, 2, 2)
+    resultat = risques_entree_rouge(
+        _series(ind1=ind1), _meteo(), grille, ParametresRisque(horizon=4)
+    )
+    assert resultat.risques == ()
+
+
+def test_hausse_insuffisante_ind_4(grille: GrilleMeteo) -> None:
+    ind4: list[Valeur | str] = [(n, 100) for n in range(5, 15)]
+    resultat = risques_entree_rouge(_series(ind4=ind4), _meteo(), grille)
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_franchissement_ind_4(grille: GrilleMeteo) -> None:
+    ind4: list[Valeur | str] = [(n, 100) for n in range(10, 20)]
+    resultat = risques_entree_rouge(_series(ind4=ind4), _meteo(), grille)
+    (projete,) = resultat.risques
+    assert projete.risque.indicateur is IND_4
+    assert projete.valeur_projetee == Fraction(1, 5)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 12)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (19, 100)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (1, 5)
+
+
+def test_stable_ou_en_baisse(grille: GrilleMeteo) -> None:
+    resultat = risques_entree_rouge(
+        _series(
+            ind1=_entiers(2, 2, 2, 2, 2, 2, 2, 2, 2, 2),
+            ind3=_entiers(*range(19, 9, -1)),
+            ind4=[(n, 100) for n in range(19, 9, -1)],
+        ),
+        _meteo(),
+        grille,
+    )
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind_4_non_evaluable_en_partie(grille: GrilleMeteo) -> None:
+    ind4: list[Valeur | str] = [(n, 100) for n in range(10, 20)]
+    ind4[3] = "Moins de 10 tests exécutés"
+    ind3 = _entiers(*range(10, 20))
+    resultat = risques_entree_rouge(_series(ind3=ind3, ind4=ind4), _meteo(), grille)
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    (exclu,) = resultat.exclus
+    assert exclu.code is IND_4
+    assert _jours()[3].isoformat() in exclu.motif
+    assert "Moins de 10 tests exécutés" in exclu.motif
+
+
+def test_historique_court(grille: GrilleMeteo) -> None:
+    table = _table(
+        _lignes(IND_1, _entiers(1))
+        + _lignes(IND_3, _entiers(18, 19))
+        + _lignes(IND_4, [(1, 100)] * 10)
+    )
+    resultat = risques_entree_rouge(table, _meteo(), grille)
+    assert [e.code for e in resultat.exclus] == [IND_1]
