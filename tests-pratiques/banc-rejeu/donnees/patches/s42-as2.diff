@@ -0,0 +1,201 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Elle lit
+la table des indicateurs (`SCHEMA_INDICATEUR`) d'une Entité non rouge à la Date d'arrêté D et,
+pour IND-1, IND-3 et IND-4 :
+
+- ajuste une droite par moindres carrés sur les `fenetre` derniers Jours ouvrés finissant à D
+  (x = 0..n−1, n ≥ 2 points) ;
+- projette la valeur p(h) = a + b·(n − 1 + h) pour h = 1..`horizon` Jours ouvrés après D ;
+- émet un `RisqueEntreeRouge` si le premier h où p(h) déclenche la règle rouge de la Grille existe ;
+- restitue avec leur motif les indicateurs écartés (non évaluables sur la fenêtre, historique
+  insuffisant, inactifs ou sans seuil rouge).
+
+Le contrat `RisqueEntreeRouge` porte la valeur courante : la valeur projetée est rendue à côté
+(`RisqueProjete`). La vélocité de la Baseline n'est pas réutilisée (taux de KO sans `SerieStock`) ;
+seules les primitives de `commun` sont partagées (AD-18).
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+from typing import Any
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du risque, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque d'entrée en rouge : paramètre {nom} invalide {valeur!r}"
+                    " (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Un `RisqueEntreeRouge` et la valeur projetée à sa date de franchissement."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    Seules les lignes de l'Entité datées au plus D sont lues ; elles doivent former des Jours
+    ouvrés consécutifs finissant à D pour chaque indicateur actif. Lève une `UsineErreur`
+    nommant l'Entité si la Météo est rouge ou si la table est invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, Entité non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+    table = table.filter((pl.col("entite") == entite) & (pl.col("date") <= meteo.date_arrete))
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in CodeIndicateur:
+        if code not in PROJETES:
+            continue
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, f"{code} inactif dans la Grille"))
+            continue
+        if Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, f"{code} sans seuil rouge dans la Grille"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        lignes = _lignes(table, code, meteo)
+        fenetre = lignes[-parametres.fenetre :]
+        if len(fenetre) < 2:
+            exclus.append(IndicateurExclu(code, f"{code} : historique insuffisant"))
+            continue
+        non_evaluable = next(
+            (ligne for ligne in fenetre if ligne["statut"] != StatutIndicateur.evalue), None
+        )
+        if non_evaluable is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"{code} non évaluable le {non_evaluable['date'].isoformat()} :"
+                    f" {non_evaluable['motif']}",
+                )
+            )
+            continue
+        valeurs = [_valeur(ligne, entite, code) for ligne in fenetre]
+        n = len(valeurs)
+        pente, ordonnee = _regression(valeurs)
+        for h in range(1, parametres.horizon + 1):
+            projetee = ordonnee + pente * (n - 1 + h)
+            if declenche(projetee, operateur, seuil):
+                courante = valeurs[-1]
+                risques.append(
+                    RisqueProjete(
+                        risque=RisqueEntreeRouge(
+                            date_arrete=meteo.date_arrete,
+                            entite=entite,
+                            indicateur=code,
+                            date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                            horizon_jours_ouvres=parametres.horizon,
+                            numerateur=courante.numerator,
+                            denominateur=courante.denominator,
+                            seuil_numerateur=seuil.numerator,
+                            seuil_denominateur=seuil.denominator,
+                            version_grille=meteo.version_grille,
+                        ),
+                        valeur_projetee=projetee,
+                    )
+                )
+                break
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _lignes(table: pl.DataFrame, code: CodeIndicateur, meteo: MeteoEntite) -> list[dict[str, Any]]:
+    """Lignes de l'indicateur jusqu'à D : Jours ouvrés consécutifs, finissant à D."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = table.filter(pl.col("code") == code).sort("date").to_dicts()
+    precedent: date | None = None
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} : {code} {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if precedent == jour:
+            raise UsineErreur(f"Risque {entite} : {code} date {jour.isoformat()} en double")
+        if precedent is not None and jour_ouvre_suivant(precedent) != jour:
+            raise UsineErreur(
+                f"Risque {entite} : {code} trou de Jours ouvrés entre"
+                f" {precedent.isoformat()} et {jour.isoformat()}"
+            )
+        precedent = jour
+    if precedent != arrete:
+        raise UsineErreur(
+            f"Risque {entite} : Date d'arrêté {arrete.isoformat()} absente pour {code}"
+        )
+    return lignes
+
+
+def _valeur(ligne: dict[str, Any], entite: str, code: CodeIndicateur) -> Fraction:
+    if ligne["denominateur"] <= 0:
+        raise UsineErreur(
+            f"Risque {entite} : {code} {ligne['date'].isoformat()} évalué avec un"
+            f" dénominateur {ligne['denominateur']} (> 0 attendu)"
+        )
+    return Fraction(ligne["numerateur"], ligne["denominateur"])
+
+
+def _regression(valeurs: list[Fraction]) -> tuple[Fraction, Fraction]:
+    """Pente et ordonnée à l'origine des moindres carrés de `valeurs` en x = 0..n−1 (n ≥ 2)."""
+    n = len(valeurs)
+    x_moy = Fraction(n - 1, 2)
+    y_moy = sum(valeurs, Fraction(0)) / n
+    sxx = sum(((x - x_moy) ** 2 for x in range(n)), Fraction(0))
+    sxy = sum(((x - x_moy) * (y - y_moy) for x, y in enumerate(valeurs)), Fraction(0))
+    pente = sxy / sxx
+    return pente, y_moy - pente * x_moy
