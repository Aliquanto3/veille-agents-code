+def serie_lignes(extra: tuple[Any, ...]) -> list[Any]:
+    """Séries constantes complètes plus une ligne supplémentaire."""
+    return [
+        *_lignes(IND_1, CONSTANT),
+        *_lignes(IND_3, CONSTANT),
+        extra,
+        *_lignes(IND_4, [(1, 100)] * 10),
+    ]
+
