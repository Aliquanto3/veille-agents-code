+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : états des tickets et Entités arrivent en paramètre. Définitions H-17 : Anomalie
+ouverte = statut hors `STATUTS_FERMES` ; Entrée = création ou réouverture
+(`date_derniere_entree`) ; Sortie = passage à Fermée ou Rejetée. Fenêtre glissante H-19
+(`contrats.calendrier`).
+"""
+
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass, field
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des `code_kpi`, dans l'ordre des lignes de sortie."""
+
+_SANS_DIMENSION: tuple[str, ...] = ("",)
+_PHASES = tuple(p.value for p in Phase)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "anomalies_ouvertes": _SANS_DIMENSION,
+        "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+        "anomalies_ouvertes_phase": _PHASES,
+        "entrees_jour": _SANS_DIMENSION,
+        "sorties_jour": _SANS_DIMENSION,
+        "entrees_fenetre": _SANS_DIMENSION,
+        "sorties_fenetre": _SANS_DIMENSION,
+        "age_median_anomalies_ouvertes": _SANS_DIMENSION,
+        "age_max_anomalies_ouvertes": _SANS_DIMENSION,
+        "taux_ko_cas_de_test": _PHASES,
+        "taux_non_execution_cas_de_test": _PHASES,
+        "certifications": tuple(s.value for s in StatutCertification),
+    }
+)
+"""Valeurs de `dimension` de chaque code, dans l'ordre de leur énumération."""
+
+_FERMES = frozenset(s.value for s in STATUTS_FERMES)
+
+_Mesures = dict[tuple[str, str], tuple[int, int]]
+
+
+@dataclass
+class _Compteurs:
+    """Comptes d'un périmètre à une date."""
+
+    ouvertes: list[tuple[str, str | None, str | None, date | None]] = field(default_factory=list)
+    entrees: int = 0
+    sorties: int = 0
+    tests: list[tuple[str | None, str]] = field(default_factory=list)
+    certifications: list[str] = field(default_factory=list)
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée « {PERIMETRE_PROGRAMME} » : valeur réservée au Programme entier"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Les dates couvrent chaque Jour ouvré de la première à la dernière, sans autre date."""
+    attendues = jours_ouvres(dates[0], dates[-1])
+    presentes = set(dates)
+    for jour in attendues:
+        if jour not in presentes:
+            raise UsineErreur(
+                f"KPI : date {jour.isoformat()} absente de l'état des tickets reçu"
+                " (chaque Jour ouvré entre la première et la dernière date est requis)"
+            )
+    hors_calendrier = sorted(presentes - set(attendues))
+    if hors_calendrier:
+        raise UsineErreur(f"KPI : {hors_calendrier[0].isoformat()} n'est pas un Jour ouvré")
+
+
+def _age(entree: date | None, jour: date, cle: str) -> int:
+    if entree is None:
+        raise UsineErreur(f"KPI : Anomalie ouverte {cle} sans date de dernière Entrée")
+    return len(jours_ouvres(entree, jour)) - 1
+
+
+def _mediane(ages: list[int]) -> tuple[int, int]:
+    if not ages:
+        return 0, 0
+    tries = sorted(ages)
+    milieu = len(tries) // 2
+    if len(tries) % 2:
+        valeur = Fraction(tries[milieu])
+    else:
+        valeur = Fraction(tries[milieu - 1] + tries[milieu], 2)
+    return valeur.numerator, valeur.denominator
+
+
+def _mesures(compteurs: _Compteurs, flux_fenetre: tuple[int, int], ages: list[int]) -> _Mesures:
+    mesures: _Mesures = {}
+    ouvertes = compteurs.ouvertes
+    mesures["anomalies_ouvertes", ""] = (len(ouvertes), 1)
+    for gravite in DIMENSIONS_KPI["anomalies_ouvertes_gravite"]:
+        mesures["anomalies_ouvertes_gravite", gravite] = (
+            sum(1 for _, g, _, _ in ouvertes if g == gravite),
+            1,
+        )
+    for phase in _PHASES:
+        mesures["anomalies_ouvertes_phase", phase] = (
+            sum(1 for _, _, p, _ in ouvertes if p == phase),
+            1,
+        )
+    mesures["entrees_jour", ""] = (compteurs.entrees, 1)
+    mesures["sorties_jour", ""] = (compteurs.sorties, 1)
+    mesures["entrees_fenetre", ""] = (flux_fenetre[0], 1)
+    mesures["sorties_fenetre", ""] = (flux_fenetre[1], 1)
+    mesures["age_median_anomalies_ouvertes", ""] = _mediane(ages)
+    mesures["age_max_anomalies_ouvertes", ""] = (max(ages), 1) if ages else (0, 0)
+    for phase in _PHASES:
+        ok = sum(1 for p, s in compteurs.tests if p == phase and s == StatutTest.ok.value)
+        ko = sum(1 for p, s in compteurs.tests if p == phase and s == StatutTest.ko.value)
+        total = sum(1 for p, _ in compteurs.tests if p == phase)
+        mesures["taux_ko_cas_de_test", phase] = (ko, ok + ko)
+        mesures["taux_non_execution_cas_de_test", phase] = (total - ok - ko, total)
+    for statut in DIMENSIONS_KPI["certifications"]:
+        mesures["certifications", statut] = (
+            sum(1 for s in compteurs.certifications if s == statut),
+            1,
+        )
+    return mesures
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : les douze codes du catalogue par Jour ouvré, Entité et Programme.
+
+    Sortie dense (zéro explicite), triée par date, périmètre (ordre de `entites`, puis
+    `PROGRAMME`), code (ordre de `CODES_KPI`) et dimension. Comptes en `n/1`, taux et âges en
+    `numerateur`/`denominateur` entiers ; `0/0` = pas de valeur.
+
+    Entrée d'une Anomalie : `date_derniere_entree == D`. Sortie : Entrée moins la variation du
+    statut ouvert entre D-1 et D (plusieurs réouvertures dans la journée comptent pour une
+    Entrée). Le périmètre d'un mouvement est l'Entité du ticket en D. Âge : Jours ouvrés après la
+    dernière Entrée jusqu'à D. `PROGRAMME` couvre toutes les lignes, Entités hors de `entites`
+    comprises.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date ;
+    à la première date, l'historique commence (la veille est vide).
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    colonnes = dict(SCHEMA_KPI.colonnes)
+    if etats.is_empty():
+        return valider(pl.DataFrame(schema=colonnes), SCHEMA_KPI)
+    dates = sorted(set(etats.get_column("date").to_list()))
+    _verifier_dates(dates)
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    connues = set(entites)
+
+    ouvert_veille: dict[str, bool] = {}
+    flux_jour: dict[tuple[str, date], tuple[int, int]] = {}
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in colonnes}
+
+    for rang, jour in enumerate(dates):
+        compteurs = {perimetre: _Compteurs() for perimetre in perimetres}
+        ouvert_jour: dict[str, bool] = {}
+        for ligne in etats.filter(pl.col("date") == jour).iter_rows(named=True):
+            cle = ligne["cle_ticket"]
+            cibles = [PERIMETRE_PROGRAMME]
+            if ligne["entite"] in connues:
+                cibles.append(ligne["entite"])
+            type_ticket = ligne["type_ticket"]
+            if type_ticket == TypeTicket.anomalie.value:
+                ouvert = ligne["statut"] is not None and ligne["statut"] not in _FERMES
+                ouvert_jour[cle] = ouvert
+                entree = 1 if ligne["date_derniere_entree"] == jour else 0
+                if rang == 0:
+                    # Début de l'historique : seule une Entrée du jour a une veille connue.
+                    avant = False if entree else ouvert
+                else:
+                    avant = ouvert_veille.get(cle, False)
+                sortie = entree - (int(ouvert) - int(avant))
+                for cible in cibles:
+                    c = compteurs[cible]
+                    c.entrees += entree
+                    c.sorties += sortie
+                    if ouvert:
+                        c.ouvertes.append(
+                            (cle, ligne["gravite"], ligne["phase"], ligne["date_derniere_entree"])
+                        )
+            elif type_ticket == TypeTicket.cas_de_test.value:
+                if ligne["statut_test"] is not None:
+                    for cible in cibles:
+                        compteurs[cible].tests.append((ligne["phase"], ligne["statut_test"]))
+            elif ligne["statut_certification"] is not None:
+                for cible in cibles:
+                    compteurs[cible].certifications.append(ligne["statut_certification"])
+        ouvert_veille = ouvert_jour
+        for perimetre in perimetres:
+            c = compteurs[perimetre]
+            flux_jour[perimetre, jour] = (c.entrees, c.sorties)
+
+        fenetre = fenetre_glissante(jour)
+        for perimetre in perimetres:
+            c = compteurs[perimetre]
+            vus = [flux_jour[perimetre, j] for j in fenetre if (perimetre, j) in flux_jour]
+            ages = [_age(entree, jour, cle) for cle, _, _, entree in c.ouvertes]
+            mesures = _mesures(c, (sum(e for e, _ in vus), sum(s for _, s in vus)), ages)
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    numerateur, denominateur = mesures[code, dimension]
+                    lignes["date"].append(jour)
+                    lignes["perimetre"].append(perimetre)
+                    lignes["code_kpi"].append(code)
+                    lignes["dimension"].append(dimension)
+                    lignes["numerateur"].append(numerateur)
+                    lignes["denominateur"].append(denominateur)
+    return valider(pl.DataFrame(lignes, schema=colonnes), SCHEMA_KPI)
