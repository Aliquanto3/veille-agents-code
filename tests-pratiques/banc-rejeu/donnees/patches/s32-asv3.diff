+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import Generation, generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+
+JEUDI = date(2026, 10, 1)
+LUNDI = date(2026, 10, 5)
+MARDI = date(2026, 10, 6)
+MERCREDI = date(2026, 10, 7)
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, debut: date, fin: date) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, jours_ouvres(debut, fin)), ENTITES)
+
+
+def _val(
+    table: pl.DataFrame, jour: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    lignes = table.filter(
+        (pl.col("date") == jour)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert lignes.height == 1, f"{jour} {perimetre} {code} {dimension} : {lignes.height} ligne(s)"
+    return lignes["numerateur"][0], lignes["denominateur"][0]
+
+
+def _serie(table: pl.DataFrame, perimetre: str, code: str, jours: tuple[date, ...]) -> list[int]:
+    return [_val(table, jour, perimetre, code)[0] for jour in jours]
+
+
+def _test(flux: Flux, cle: str, statut: str) -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(5),
+        {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: "recette"},
+    )
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5))
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, LUNDI, LUNDI)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(table, LUNDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(table, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    code = "anomalies_ouvertes_gravite"
+    assert _val(table, LUNDI, PERIMETRE_PROGRAMME, code, "bloquante") == (2, 1)
+    assert _val(table, LUNDI, PERIMETRE_PROGRAMME, code, "majeure") == (0, 1)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 9), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(7, 10), "en_analyse", "fermee")
+    table = _kpi(flux, LUNDI, MERCREDI)
+    jours = (LUNDI, MARDI, MERCREDI)
+    for perimetre in ("ENT-A", PERIMETRE_PROGRAMME):
+        assert _serie(table, perimetre, "entrees_jour", jours) == [1, 0, 1]
+        assert _serie(table, perimetre, "sorties_jour", jours) == [0, 1, 1]
+    assert _serie(table, "ENT-B", "entrees_jour", jours) == [0, 0, 0]
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    jours = jours_ouvres(JEUDI, date(2026, 10, 9))
+    assert len(jours) == 7
+    for jour in jours:
+        flux.anomalie(f"DEMO-{jour.day}", _ts(jour.day))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    table = _kpi(flux, JEUDI, date(2026, 10, 9))
+    assert _serie(table, PERIMETRE_PROGRAMME, "entrees_jour", jours) == [1] * 7
+    assert _serie(table, PERIMETRE_PROGRAMME, "entrees_fenetre", jours) == [1, 2, 3, 4, 5, 5, 5]
+    assert _serie(table, PERIMETRE_PROGRAMME, "sorties_fenetre", jours) == [0, 0, 0, 1, 1, 1, 1]
+
+
+def test_age() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    table = _kpi(flux, JEUDI, MERCREDI)
+    assert _val(table, MERCREDI, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(table, MERCREDI, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(table, JEUDI, "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+    assert _val(table, MERCREDI, "ENT-B", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_age_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")
+    table = _kpi(flux, JEUDI, date(2026, 10, 9))
+    assert _val(table, date(2026, 10, 9), "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(table, date(2026, 10, 9), "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    table = _kpi(flux, LUNDI, LUNDI)
+    assert _val(table, LUNDI, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(table, LUNDI, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["ok", "ok", "ok", "ko", "non_execute", "non_execute"]):
+        _test(flux, f"DEMO-{i + 1}", statut)
+    table = _kpi(flux, LUNDI, LUNDI)
+    ko, non_execution = "taux_ko_cas_de_test", "taux_non_execution_cas_de_test"
+    assert _val(table, LUNDI, "ENT-A", ko, "recette") == (1, 4)
+    assert _val(table, LUNDI, PERIMETRE_PROGRAMME, non_execution, "recette") == (2, 6)
+    assert _val(table, LUNDI, "ENT-A", ko, "tnr") == (0, 0)
+    assert _val(table, LUNDI, "ENT-A", non_execution, "tnr") == (0, 0)
+    assert _val(table, LUNDI, "ENT-B", ko, "recette") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for cle, statut in [("DEMO-1", "accordee"), ("DEMO-2", "reservee"), ("DEMO-3", "reservee")]:
+        flux.creer(
+            cle,
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    table = _kpi(flux, LUNDI, LUNDI)
+    assert _val(table, LUNDI, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(table, LUNDI, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(table, LUNDI, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI, MERCREDI])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"),
+    [(["ENT-A", "ENT-A"], "ENT-A"), (["ENT-A", PERIMETRE_PROGRAMME], PERIMETRE_PROGRAMME)],
+)
+def test_entites_refusees(entites: list[str], valeur: str) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI])
+    with pytest.raises(UsineErreur, match=valeur):
+        kpi(etats, entites)
+
+
+def test_table_vide() -> None:
+    table = kpi(tickets_etats([], []), ENTITES)
+    assert table.is_empty()
+    assert dict(table.schema) == dict(SCHEMA_KPI.colonnes)
+
+
+def test_catalogue_dense_trie_sans_flottant() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    table = _kpi(flux, LUNDI, MARDI)
+    assert valider(table, SCHEMA_KPI).equals(table)
+    assert not any(t.is_float() for t in table.schema.values())
+    par_perimetre = sum(len(DIMENSIONS_KPI[code]) for code in CODES_KPI)
+    assert table.height == 2 * 3 * par_perimetre
+    attendu = [
+        (jour, perimetre, code, dimension)
+        for jour in (LUNDI, MARDI)
+        for perimetre in (*ENTITES, PERIMETRE_PROGRAMME)
+        for code in CODES_KPI
+        for dimension in DIMENSIONS_KPI[code]
+    ]
+    assert table.select("date", "perimetre", "code_kpi", "dimension").rows() == attendu
+
+
+@pytest.fixture(scope="module")
+def generation() -> Generation:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    return generer(config, 42, date(2026, 10, 12))
+
+
+def test_journal_genere(generation: Generation) -> None:
+    entete = generation.entete
+    etats = tickets_etats(
