@@ -0,0 +1,198 @@
+"""Outils de consultation de l'Agent, en lecture seule (FR-39, FR-41, AD-5, AD-11).
+
+Chaque outil lit un Passage par le seul port `Consultation` et rend un `Resultat*` de
+`contrats.agent`, ou `AucuneDonnee` quand la Date d'arrêté demandée n'est pas couverte. Aucun
+chiffre n'est calculé ici ; la sérialisation en texte et la Pseudonymisation reviennent à la
+passerelle de l'Agent.
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS: tuple[str, ...] = (
+    "get_meteo",
+    "list_anomalies",
+    "get_tendance",
+    "get_prevision",
+    "get_risques",
+)
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Un outil de l'Agent : la passerelle en fait un `OutilAgent` (Story 7.9)."""
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+    """Valide les arguments JSON (`ValidationError` si invalides) puis lit la Consultation."""
+
+
+class OutilsConsultation:
+    """Les cinq outils de lecture, servis par une `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _sans_donnee(self, date_arrete: date | None) -> AucuneDonnee | None:
+        """`AucuneDonnee` si le Passage ne couvre pas la date demandée (`None` : la sienne)."""
+        disponibles = self._consultation.dates_disponibles()
+        if date_arrete is None:
+            if not disponibles or self._consultation.manifeste().date_arrete not in disponibles:
+                return AucuneDonnee(date_arrete=None)
+            return None
+        if date_arrete not in disponibles:
+            return AucuneDonnee(date_arrete=date_arrete)
+        return None
+
+    def _date(self, date_arrete: date | None) -> date:
+        if date_arrete is not None:
+            return date_arrete
+        return self._consultation.manifeste().date_arrete
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        if (vide := self._sans_donnee(arguments.date_arrete)) is not None:
+            return vide
+        c = self._consultation
+        evolutions = c.evolution_meteo(arguments.date_arrete)
+        if arguments.entite is not None:
+            evolutions = tuple(e for e in evolutions if e.entite == arguments.entite)
+        return ResultatGetMeteo(
+            date_arrete=self._date(arguments.date_arrete),
+            meteos=c.meteo(arguments.date_arrete, arguments.entite),
+            evolutions=evolutions,
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées par Entité, Gravité, Phase, domaine et statut."""
+        if (vide := self._sans_donnee(arguments.date_arrete)) is not None:
+            return vide
+        c = self._consultation
+        if arguments.statut is None:
+            return c.anomalies(
+                date_arrete=arguments.date_arrete,
+                entite=arguments.entite,
+                gravite=arguments.gravite,
+                phase=arguments.phase,
+                domaine=arguments.domaine,
+                limite=arguments.limite,
+            )
+        toutes = c.anomalies(
+            date_arrete=arguments.date_arrete,
+            entite=arguments.entite,
+            gravite=arguments.gravite,
+            phase=arguments.phase,
+            domaine=arguments.domaine,
+            limite=None,
+        )
+        retenues = tuple(a for a in toutes.anomalies if a.statut == arguments.statut)
+        return ResultatListAnomalies(
+            date_arrete=toutes.date_arrete,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire (sans date : jamais `AucuneDonnee`)."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        champs = tuple(PointTendance.model_fields)
+        return ResultatGetTendance(
+            points=tuple(
+                PointTendance.model_validate(dict((k, ligne[k]) for k in champs))
+                for ligne in table.to_dicts()
+            )
+        )
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        if (vide := self._sans_donnee(arguments.date_arrete)) is not None:
+            return vide
+        return ResultatGetPrevision(
+            date_arrete=self._date(arguments.date_arrete),
+            previsions=self._consultation.previsions(arguments.date_arrete, arguments.entite),
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        if (vide := self._sans_donnee(arguments.date_arrete)) is not None:
+            return vide
+        return ResultatGetRisques(
+            date_arrete=self._date(arguments.date_arrete),
+            risques=self._consultation.risques(arguments.date_arrete, arguments.entite),
+        )
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Les cinq outils de l'Agent, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+
+    def definition[A: Enregistrement](
+        nom: str,
+        description: str,
+        arguments: type[A],
+        appel: Callable[[A], Enregistrement],
+    ) -> DefinitionOutil:
+        return DefinitionOutil(
+            nom=nom,
+            description=description,
+            arguments=arguments,
+            executer=lambda brut: appel(arguments.model_validate(dict(brut))),
+        )
+
+    return (
+        definition(
+            "get_meteo",
+            "Météo par Entité, Règles déclenchantes et évolution J-1 / J-5 à une Date d'arrêté.",
+            ArgumentsGetMeteo,
+            outils.get_meteo,
+        ),
+        definition(
+            "list_anomalies",
+            "Anomalies ouvertes, filtrables par Entité, Gravité, Phase, domaine et statut.",
+            ArgumentsListAnomalies,
+            outils.list_anomalies,
+        ),
+        definition(
+            "get_tendance",
+            "Tendances hebdomadaires des KPI, filtrables par Entité et KPI.",
+            ArgumentsGetTendance,
+            outils.get_tendance,
+        ),
+        definition(
+            "get_prevision",
+            "Prévisions de sortie du rouge à une Date d'arrêté.",
+            ArgumentsGetPrevision,
+            outils.get_prevision,
+        ),
+        definition(
+            "get_risques",
+            "Risques d'entrée en rouge à une Date d'arrêté.",
+            ArgumentsGetRisques,
+            outils.get_risques,
+        ),
+    )
