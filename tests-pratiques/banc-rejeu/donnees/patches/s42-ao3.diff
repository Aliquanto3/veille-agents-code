+"""Risque d'entrée en rouge (FR-21, AD-9, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Elle
+lit la table `SCHEMA_INDICATEUR` d'une Entité non rouge et sa `MeteoEntite` à la Date d'arrêté
+D, et projette IND-1, IND-3 et IND-4 :
+
+- régression linéaire par moindres carrés sur les `fenetre` derniers Jours ouvrés finissant à
+  D (x = 0..n−1, n ≥ 2) : b = Σ(x − x̄)(y − ȳ) / Σ(x − x̄)², a = ȳ − b·x̄ ;
+- projection p(h) = a + b·(n − 1 + h) pour h = 1..`horizon` ; le premier h où p(h) déclenche
+  la règle rouge de la Grille donne un `RisqueEntreeRouge` daté de D avancée de h Jours ouvrés,
+  rendu avec la valeur projetée (`RisqueProjete`, hors contrat gelé).
+
+Un indicateur inactif, sans seuil rouge, non évaluable sur un Jour ouvré de la fenêtre ou à
+l'historique insuffisant est écarté avec son motif (`IndicateurExclu`). Les primitives
+partagées avec la Baseline (avance en Jours ouvrés, test de seuil) viennent de `commun`.
+"""
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+"""Indicateurs projetés (FR-21), dans l'ordre de `CodeIndicateur`."""
+
+HISTORIQUE_INSUFFISANT = "historique insuffisant"
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque d'entrée en rouge : paramètre {nom} invalide {valeur!r}"
+                    " (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée à la date de franchissement estimée."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, chacun dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+@dataclass(frozen=True)
+class _Point:
+    date: date
+    evalue: bool
+    motif: str
+    valeur: Fraction
+    """`numerateur/denominateur` si évalué, 0 sinon."""
+    numerateur: int
+    denominateur: int
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D
+    sont lues, et, pour chaque indicateur projeté, elles doivent former des Jours ouvrés
+    consécutifs finissant à D. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge
+    ou si la table est invalide.
+    """
+    entite, arrete = meteo.entite, meteo.date_arrete
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(
+            f"Risque d'entrée en rouge {entite} : Météo rouge, Entité non rouge attendue"
+        )
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque d'entrée en rouge {entite} : {exc}") from exc
+    table = table.filter((pl.col("entite") == entite) & (pl.col("date") <= arrete))
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in PROJETES:
+        regle = grille.indicateurs.get(code)
+        if regle is None:
+            exclus.append(IndicateurExclu(code, "absent de la Grille"))
+            continue
+        if not regle.active:
+            exclus.append(IndicateurExclu(code, "inactif dans la Grille"))
+            continue
+        seuil_rouge = regle.seuils.get(Couleur.rouge)
+        if seuil_rouge is None:
+            exclus.append(IndicateurExclu(code, "sans seuil rouge dans la Grille"))
+            continue
+        fenetre = _points(table, meteo, code)[-parametres.fenetre :]
+        non_evalue = next((p for p in fenetre if not p.evalue), None)
+        if non_evalue is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"non évaluable le {non_evalue.date.isoformat()} : {non_evalue.motif}",
+                )
+            )
+            continue
+        if len(fenetre) < 2:
+            exclus.append(IndicateurExclu(code, HISTORIQUE_INSUFFISANT))
+            continue
+        operateur, seuil = seuil_rouge
+        projections = _projections(fenetre, parametres.horizon)
+        h, valeur = next(
+            ((h, p) for h, p in enumerate(projections, 1) if declenche(p, operateur, seuil)),
+            (0, Fraction(0)),
+        )
+        if not h:
+            continue
+        courant = fenetre[-1]
+        risques.append(
+            RisqueProjete(
+                risque=RisqueEntreeRouge(
+                    date_arrete=arrete,
+                    entite=entite,
+                    indicateur=code,
+                    date_franchissement_estimee=avancer(arrete, h),
+                    horizon_jours_ouvres=parametres.horizon,
+                    numerateur=courant.numerateur,
+                    denominateur=courant.denominateur,
+                    seuil_numerateur=seuil.numerator,
+                    seuil_denominateur=seuil.denominator,
+                    version_grille=meteo.version_grille,
+                ),
+                valeur_projetee=valeur,
+            )
+        )
+    return ResultatRisque(risques=tuple(risques), exclus=tuple(exclus))
+
+
+def _points(table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur) -> list[_Point]:
+    """Jours ouvrés de l'indicateur `code` jusqu'à D, contrôlés et dans l'ordre."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    prefixe = f"Risque d'entrée en rouge {entite} {code}"
+    lignes = table.filter(pl.col("code") == code.value).sort("date").to_dicts()
+    points: list[_Point] = []
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(f"{prefixe} : {jour.isoformat()} n'est pas un Jour ouvré")
+        if points and points[-1].date == jour:
+            raise UsineErreur(f"{prefixe} : date {jour.isoformat()} en double")
+        if points and jour_ouvre_suivant(points[-1].date) != jour:
+            raise UsineErreur(
+                f"{prefixe} : trou de Jours ouvrés entre"
+                f" {points[-1].date.isoformat()} et {jour.isoformat()}"
+            )
+        evalue = ligne["statut"] == StatutIndicateur.evalue.value
+        numerateur, denominateur = ligne["numerateur"], ligne["denominateur"]
+        if evalue and denominateur <= 0:
+            raise UsineErreur(
+                f"{prefixe} : valeur évaluée {numerateur}/{denominateur} le {jour.isoformat()}"
+                " (dénominateur > 0 attendu)"
+            )
+        points.append(
+            _Point(
+                date=jour,
+                evalue=evalue,
+                motif=ligne["motif"],
+                valeur=Fraction(numerateur, denominateur) if evalue else Fraction(0),
+                numerateur=numerateur,
+                denominateur=denominateur,
+            )
+        )
+    if not points or points[-1].date != arrete:
+        raise UsineErreur(
+            f"{prefixe} : Date d'arrêté {arrete.isoformat()} absente de la table des indicateurs"
+        )
+    return points
+
+
+def _projections(points: Sequence[_Point], horizon: int) -> list[Fraction]:
+    """Projections p(1)..p(`horizon`) de la droite des moindres carrés (`len(points)` ≥ 2)."""
+    n = len(points)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum((p.valeur for p in points), Fraction(0)) / n
+    covariance = sum(
+        ((x - x_moyen) * (p.valeur - y_moyen) for x, p in enumerate(points)), Fraction(0)
+    )
+    variance = sum(((x - x_moyen) ** 2 for x in range(n)), Fraction(0))
+    pente = covariance / variance
+    ordonnee = y_moyen - pente * x_moyen
+    return [ordonnee + pente * (n - 1 + h) for h in range(1, horizon + 1)]
