+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18, H-8).
+
+Valeurs attendues calculées à la main. Table de référence ENT-C : 10 Jours ouvrés du lundi
+28/09/2026 au vendredi 09/10/2026 (D), Météo orange, Grille livrée (rouge : IND-1 `>= 3`,
+IND-3 `>= 20`, IND-4 `>= 1/5`). x = 0..9, x̄ = 9/2, Σ(x − x̄)² = 165/2 ; projection à x = 9 + h.
+
+    IND-1 = 0 0 0 0 0 1 1 1 2 2 : ȳ = 7/10, Σ(x − x̄)y = 41/2 → b = 41/165, a = −23/55 ;
+            p(4) = 464/165 < 3, p(5) = 101/33 ≥ 3 → risque à D + 5 JO (vendredi 16/10).
+    IND-3 = 10 … 19 : b = 1, a = 10 → p(1) = 20 ≥ 20 → risque à D + 1 JO (lundi 12/10).
+    IND-4 = 5/100 … 14/100 : b = 1/100 → p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+import re
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.commun import avancer, declenche
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+CHEMIN_GRILLE = RACINE / "config" / "grille_meteo.yaml"
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+IND_1 = CodeIndicateur.ind_1
+IND_3 = CodeIndicateur.ind_3
+IND_4 = CodeIndicateur.ind_4
+
+Valeur = tuple[int, int] | str
+"""Valeur évaluée `(numerateur, denominateur)`, ou motif d'un indicateur non évaluable."""
+
+SERIE_IND_1: list[Valeur] = [(v, 1) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+SERIE_IND_3: list[Valeur] = [(v, 1) for v in range(10, 20)]
+SERIE_IND_4: list[Valeur] = [(v, 100) for v in range(5, 15)]
+
+
+def _lignes(
+    code: CodeIndicateur, valeurs: list[Valeur], fin: date = D, entite: str = ENTITE
+) -> list[dict[str, object]]:
+    dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+    lignes: list[dict[str, object]] = []
+    for jour, valeur in zip(dates, valeurs, strict=True):
+        evalue = not isinstance(valeur, str)
+        numerateur, denominateur = valeur if not isinstance(valeur, str) else (0, 0)
+        lignes.append(
+            {
+                "date": jour,
+                "entite": entite,
+                "code": code.value,
+                "statut": (StatutIndicateur.evalue if evalue else StatutIndicateur.non_evaluable),
+                "motif": "" if evalue else valeur,
+                "numerateur": numerateur,
+                "denominateur": denominateur,
+                "couleur": Couleur.vert.value,
+            }
+        )
+    return lignes
+
+
+def _table(*lignes: list[dict[str, object]]) -> pl.DataFrame:
+    return valider(
+        pl.DataFrame(
+            [ligne for groupe in lignes for ligne in groupe],
+            schema=dict(SCHEMA_INDICATEUR.colonnes),
+            orient="row",
+        ),
+        SCHEMA_INDICATEUR,
+    )
+
+
+def _reference(**series: list[Valeur]) -> pl.DataFrame:
+    """Table de référence, séries remplacées par `series` (clés `ind_1`, `ind_3`, `ind_4`)."""
+    valeurs = {"ind_1": SERIE_IND_1, "ind_3": SERIE_IND_3, "ind_4": SERIE_IND_4} | series
+    return _table(*(_lignes(CodeIndicateur[nom], serie) for nom, serie in valeurs.items()))
+
+
+def _grille(**indicateurs_yaml: Any) -> GrilleMeteo:
+    """Grille livrée, règles remplacées par `indicateurs_yaml`."""
+    donnees: dict[str, Any] = yaml.safe_load(CHEMIN_GRILLE.read_text(encoding="utf-8"))
+    donnees["indicateurs"].update(indicateurs_yaml)
+    return GrilleMeteo.model_validate(donnees)
+
+
+GRILLE = _grille()
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(
+            RegleDeclenchante(
+                code=IND_1,
+                couleur=couleur,
+                operateur=Operateur.superieur_ou_egal,
+                numerateur=3 if couleur is Couleur.rouge else 2,
+                denominateur=1,
+                seuil_numerateur=3 if couleur is Couleur.rouge else 1,
+                seuil_denominateur=1,
+                tickets_en_cause=(),
+            ),
+        ),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _risques(resultat: ResultatRisque) -> dict[CodeIndicateur, tuple[date, Fraction]]:
+    return {
+        r.risque.indicateur: (r.risque.date_franchissement_estimee, r.valeur_projetee)
+        for r in resultat.risques
+    }
+
+
+# --- Matrice I/O ---
+
+
+def test_reference_franchissements_ind_1_et_ind_3() -> None:
+    resultat = risques_entree_rouge(_reference(), _meteo(), GRILLE)
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1, IND_3]
+    assert resultat.exclus == ()
+    ind_1, ind_3 = resultat.risques
+    assert ind_3.risque == RisqueEntreeRouge(
+        date_arrete=D,
+        entite=ENTITE,
+        indicateur=IND_3,
+        date_franchissement_estimee=date(2026, 10, 12),
+        horizon_jours_ouvres=5,
+        numerateur=19,
+        denominateur=1,
+        seuil_numerateur=20,
+        seuil_denominateur=1,
+        version_grille=VERSION_GRILLE,
+    )
+    assert ind_3.valeur_projetee == Fraction(20)
+    assert ind_1.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert ind_1.valeur_projetee == Fraction(101, 33)
+    assert (ind_1.risque.numerateur, ind_1.risque.denominateur) == (2, 1)
+    assert (ind_1.risque.seuil_numerateur, ind_1.risque.seuil_denominateur) == (3, 1)
+
+
+def test_tendance_non_lineaire_ind_1_franchit_au_dernier_jour() -> None:
+    plus_court = ParametresRisque(horizon=4)
+
+    assert _risques(risques_entree_rouge(_reference(), _meteo(), GRILLE))[IND_1] == (
+        date(2026, 10, 16),
+        Fraction(101, 33),
+    )
+    assert IND_1 not in _risques(risques_entree_rouge(_reference(), _meteo(), GRILLE, plus_court))
+
+
+def test_hausse_insuffisante_ind_4_sans_risque() -> None:
+    resultat = risques_entree_rouge(_reference(), _meteo(), GRILLE)
+
+    assert IND_4 not in _risques(resultat)
+    assert IND_4 not in {e.code for e in resultat.exclus}
+
+
+def test_seuil_ind_4_franchi_par_fraction() -> None:
+    serie: list[Valeur] = [(v, 100) for v in range(6, 16)]
+
+    resultat = risques_entree_rouge(_reference(ind_4=serie), _meteo(), GRILLE)
+
+    assert _risques(resultat)[IND_4] == (date(2026, 10, 16), Fraction(1, 5))
+    ind_4 = resultat.risques[-1].risque
+    assert (ind_4.numerateur, ind_4.denominateur) == (15, 100)
+    assert (ind_4.seuil_numerateur, ind_4.seuil_denominateur) == (1, 5)
+
+
+def test_series_stables_ou_en_baisse_sans_risque() -> None:
+    table = _reference(
+        ind_1=[(2, 1)] * 10,
+        ind_3=[(v, 1) for v in range(19, 9, -1)],
+        ind_4=[(19, 100)] * 10,
+    )
+
