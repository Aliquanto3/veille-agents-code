+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : l'état des tickets de chaque Jour ouvré et les Entités arrivent en paramètre.
+Sortie dense au format long (`SCHEMA_KPI`), en entiers : tout taux est un couple
+`numerateur` / `denominateur`, `0/0` valant « pas de valeur ».
+"""
+
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+from typing import Any
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des codes de KPI, dans l'ordre de sortie."""
+
+_GRAVITES = tuple(g.value for g in Gravite)
+_PHASES = tuple(p.value for p in Phase)
+_CERTIFICATIONS = tuple(s.value for s in StatutCertification)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "anomalies_ouvertes": ("",),
+        "anomalies_ouvertes_gravite": _GRAVITES,
+        "anomalies_ouvertes_phase": _PHASES,
+        "entrees_jour": ("",),
+        "sorties_jour": ("",),
+        "entrees_fenetre": ("",),
+        "sorties_fenetre": ("",),
+        "age_median_anomalies_ouvertes": ("",),
+        "age_max_anomalies_ouvertes": ("",),
+        "taux_ko_cas_de_test": _PHASES,
+        "taux_non_execution_cas_de_test": _PHASES,
+        "certifications": _CERTIFICATIONS,
+    }
+)
+"""Valeurs de `dimension` de chaque code, dans l'ordre de sortie (`""` : non ventilé)."""
+
+_STATUTS_FERMES = [s.value for s in STATUTS_FERMES]
+
+type _Mesures = dict[tuple[str, str], tuple[int, int]]
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée {PERIMETRE_PROGRAMME} : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Les dates couvrent chaque Jour ouvré de la première à la dernière, sans autre date."""
+    attendues = jours_ouvres(dates[0], dates[-1])
+    presentes = set(dates)
+    manquantes = [d for d in attendues if d not in presentes]
+    if manquantes:
+        raise UsineErreur(
+            f"État des tickets : Jour ouvré {manquantes[0].isoformat()} absent entre"
+            f" {dates[0].isoformat()} et {dates[-1].isoformat()} (dates non contiguës)"
+        )
+    en_trop = sorted(presentes - set(attendues))
+    if en_trop:
+        raise UsineErreur(f"État des tickets : {en_trop[0].isoformat()} n'est pas un Jour ouvré")
+
+
+def _preparer(etats: pl.DataFrame) -> pl.DataFrame:
+    """Texte des énumérations, plus `ouvert`, `entree` et `sortie` (0 ou 1, ou 2 pour `sortie`)."""
+    anomalie = pl.col("type_ticket") == TypeTicket.anomalie.value
+    ouvert = anomalie & pl.col("statut").is_not_null() & ~pl.col("statut").is_in(_STATUTS_FERMES)
+    # Sans ligne la veille : créé ce jour-là (veille fermée) ou début de l'historique (état
+    # de la veille supposé identique, sans mouvement).
+    veille = (
+        ouvert.shift(1)
+        .over("cle_ticket")
+        .fill_null(ouvert & (pl.col("date_derniere_entree") < pl.col("date")))
+    )
+    entree = anomalie & (pl.col("date_derniere_entree") == pl.col("date")).fill_null(False)
+    texte = [
+        pl.col(c).cast(pl.Utf8)
+        for c in ("type_ticket", "gravite", "phase", "statut_test", "statut_certification")
+    ]
+    return (
+        etats.sort("cle_ticket", "date")
+        .with_columns(
+            ouvert.alias("ouvert"),
+            entree.cast(pl.Int64).alias("entree"),
+            (ouvert.cast(pl.Int64) - veille.cast(pl.Int64)).alias("variation"),
+        )
+        .with_columns(texte)
+        .with_columns((pl.col("entree") - pl.col("variation")).alias("sortie"))
+        .sort("date", "cle_ticket")
+    )
+
+
+def _mediane(ages: list[int]) -> tuple[int, int]:
+    ages = sorted(ages)
+    milieu = len(ages) // 2
+    valeur = (
+        Fraction(ages[milieu]) if len(ages) % 2 else Fraction(ages[milieu - 1] + ages[milieu], 2)
+    )
+    return valeur.numerator, valeur.denominator
+
+
+def _mesures_jour(lignes: list[dict[str, Any]], jour: date, ages: dict[date, int]) -> _Mesures:
+    """Mesures instantanées (stocks, âges, taux, Certifications) et flux du jour d'un périmètre."""
+    mesures: _Mesures = {}
+    for code, dimensions in DIMENSIONS_KPI.items():
+        for dimension in dimensions:
+            mesures[(code, dimension)] = (0, 1)
+    ages_ouverts: list[int] = []
+    tests: dict[str, dict[str, int]] = {p: {} for p in _PHASES}
+    entrees = sorties = 0
+
+    def ajouter(code: str, dimension: str) -> None:
+        n, d = mesures[(code, dimension)]
+        mesures[(code, dimension)] = (n + 1, d)
+
+    for ligne in lignes:
+        entrees += ligne["entree"]
+        sorties += ligne["sortie"]
+        if ligne["ouvert"]:
+            ajouter("anomalies_ouvertes", "")
+            if ligne["gravite"] is not None:
+                ajouter("anomalies_ouvertes_gravite", ligne["gravite"])
+            if ligne["phase"] is not None:
+                ajouter("anomalies_ouvertes_phase", ligne["phase"])
+            entree = ligne["date_derniere_entree"]
+            if entree is None:
+                raise UsineErreur(
+                    f"Anomalie ouverte {ligne['cle_ticket']} sans date de dernière Entrée"
+                    f" au {jour.isoformat()}"
+                )
+            if entree not in ages:
+                ages[entree] = len(jours_ouvres(entree, jour)) - 1
+            ages_ouverts.append(ages[entree])
+        elif ligne["type_ticket"] == TypeTicket.cas_de_test.value:
+            statut, phase = ligne["statut_test"], ligne["phase"]
+            if statut is not None and phase is not None:
+                tests[phase][statut] = tests[phase].get(statut, 0) + 1
+        elif ligne["type_ticket"] == TypeTicket.certification.value:
+            if ligne["statut_certification"] is not None:
+                ajouter("certifications", ligne["statut_certification"])
+    mesures[("entrees_jour", "")] = (entrees, 1)
+    mesures[("sorties_jour", "")] = (sorties, 1)
+    if ages_ouverts:
+        mesures[("age_median_anomalies_ouvertes", "")] = _mediane(ages_ouverts)
+        mesures[("age_max_anomalies_ouvertes", "")] = (max(ages_ouverts), 1)
+    else:
+        mesures[("age_median_anomalies_ouvertes", "")] = (0, 0)
+        mesures[("age_max_anomalies_ouvertes", "")] = (0, 0)
+    for phase, comptes in tests.items():
+        ok, ko, non_execute = (comptes.get(s.value, 0) for s in StatutTest)
+        mesures[("taux_ko_cas_de_test", phase)] = (ko, ok + ko)
+        mesures[("taux_non_execution_cas_de_test", phase)] = (non_execute, ok + ko + non_execute)
+    return mesures
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : les douze KPI de chaque Entité de `entites` et du Programme, par date.
+
+    Définitions H-17 : Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée = création ou
+    réouverture (`date_derniere_entree`) ; Sortie = passage à Fermée ou Rejetée. Fenêtre
+    glissante H-19 : les Jours ouvrés de `fenetre_glissante`, ceux antérieurs à la table
+    comptant 0. L'âge d'une Anomalie ouverte compte les Jours ouvrés depuis sa dernière Entrée.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date,
+    sinon `UsineErreur`. Le Programme agrège toutes les lignes, y compris les Entités hors de
+    `entites`. Lignes triées par date, périmètre (ordre de `entites`, puis Programme), code
+    et dimension.
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    if etats.height == 0:
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates: list[date] = sorted(etats.get_column("date").unique().to_list())
+    _verifier_dates(dates)
+
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    mesures: dict[tuple[date, str], _Mesures] = {}
+    for partie in _preparer(etats).partition_by("date", maintain_order=True):
+        jour: date = partie.get_column("date")[0]
+        lignes = partie.to_dicts()
+        ages: dict[date, int] = {}
+        for perimetre in perimetres:
+            if perimetre == PERIMETRE_PROGRAMME:
+                sous_ensemble = lignes
+            else:
+                sous_ensemble = [ligne for ligne in lignes if ligne["entite"] == perimetre]
+            mesures[(jour, perimetre)] = _mesures_jour(sous_ensemble, jour, ages)
+
+    colonnes: dict[str, list[Any]] = {nom: [] for nom in SCHEMA_KPI.colonnes}
+    for jour in dates:
+        fenetre = fenetre_glissante(jour)
+        for perimetre in perimetres:
+            courant = mesures[(jour, perimetre)]
+            for flux in ("entrees", "sorties"):
+                total = sum(
+                    mesures[(d, perimetre)][(f"{flux}_jour", "")][0]
+                    for d in fenetre
+                    if (d, perimetre) in mesures
+                )
+                courant[(f"{flux}_fenetre", "")] = (total, 1)
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    numerateur, denominateur = courant[(code, dimension)]
+                    colonnes["date"].append(jour)
+                    colonnes["perimetre"].append(perimetre)
+                    colonnes["code_kpi"].append(code)
+                    colonnes["dimension"].append(dimension)
+                    colonnes["numerateur"].append(numerateur)
+                    colonnes["denominateur"].append(denominateur)
+    table = pl.DataFrame(colonnes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
