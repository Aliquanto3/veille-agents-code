+def test_conservation_sur_le_journal_genere(tmp_path: Path) -> None:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generer(config, 42, date(2026, 10, 12))))
+    source = SourceJournal(chemin)
+    evenements = list(source.evenements())
+    fin = source.entete.date_injection
+    jours = jours_ouvres(date(2026, 8, 3), fin)
+    entites = [e.code for e in config.entites]
+    t = kpi(tickets_etats(evenements, jours), entites)
+    jours = tuple(sorted(t["date"].unique()))
+    for perimetre in (*entites, PERIMETRE_PROGRAMME):
+        for jour in jours[1:]:
+            veille = jour_ouvre_precedent(jour)
+            variation = (
+                _val(t, jour, perimetre, "anomalies_ouvertes")[0]
+                - _val(t, veille, perimetre, "anomalies_ouvertes")[0]
+            )
+            flux_net = (
+                _val(t, jour, perimetre, "entrees_jour")[0]
+                - _val(t, jour, perimetre, "sorties_jour")[0]
+            )
+            assert variation == flux_net, (jour, perimetre)
