+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.adaptateurs.journal import SourceJournal
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jour_ouvre_precedent, jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import SCHEMA_TICKET_ETAT, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[3]
+
+JEUDI = date(2026, 10, 1)
+VENDREDI = date(2026, 10, 2)
+LUNDI = date(2026, 10, 5)
+MARDI = date(2026, 10, 6)
+MERCREDI = date(2026, 10, 7)
+ENTITES = ["ENT-A", "ENT-B"]
+
+
+def _ts(jour: int, heure: int = 10) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, debut: date, fin: date) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, jours_ouvres(debut, fin)), ENTITES)
+
+
+def _val(
+    table: pl.DataFrame, jour: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    lignes = table.filter(
+        (pl.col("date") == jour)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert lignes.height == 1
+    ligne = lignes.row(0, named=True)
+    return ligne["numerateur"], ligne["denominateur"]
+
+
+def _cas(flux: Flux, cle: str, statut: str, phase: str = "recette") -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(5),
+        {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: phase},
+    )
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5))
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure", statut="fermee")
+    t = _kpi(flux, LUNDI, LUNDI)
+    for perimetre, attendu in (("ENT-A", 2), ("ENT-B", 0), (PERIMETRE_PROGRAMME, 2)):
+        assert _val(t, LUNDI, perimetre, "anomalies_ouvertes") == (attendu, 1)
+    assert _val(t, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(t, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(t, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _val(t, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 8), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(7, 9), "en_analyse", "fermee")
+    t = _kpi(flux, LUNDI, MERCREDI)
+    entrees = [_val(t, d, PERIMETRE_PROGRAMME, "entrees_jour")[0] for d in (LUNDI, MARDI, MERCREDI)]
+    sorties = [_val(t, d, PERIMETRE_PROGRAMME, "sorties_jour")[0] for d in (LUNDI, MARDI, MERCREDI)]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+
+
+def test_fenetre() -> None:
+    flux = Flux()
+    # Une Entrée par Jour ouvré, du jeudi 1er au vendredi 9 octobre (7 Jours ouvrés).
+    for i, jour in enumerate((1, 2, 5, 6, 7, 8, 9)):
+        flux.anomalie(f"DEMO-{i + 1}", _ts(jour))
+    t = _kpi(flux, JEUDI, date(2026, 10, 9))
+    assert _val(t, JEUDI, PERIMETRE_PROGRAMME, "entrees_fenetre") == (1, 1)
+    assert _val(t, MERCREDI, PERIMETRE_PROGRAMME, "entrees_fenetre") == (5, 1)
+    assert _val(t, date(2026, 10, 9), PERIMETRE_PROGRAMME, "entrees_fenetre") == (5, 1)
+    assert _val(t, date(2026, 10, 9), PERIMETRE_PROGRAMME, "sorties_fenetre") == (0, 1)
+
+
+def test_age_median_et_maximum() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    t = _kpi(flux, JEUDI, MERCREDI)
+    assert _val(t, MERCREDI, PERIMETRE_PROGRAMME, "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(t, MERCREDI, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(t, JEUDI, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (0, 1)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")
+    t = _kpi(flux, JEUDI, date(2026, 10, 9))
+    assert _val(t, date(2026, 10, 9), "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(t, date(2026, 10, 9), "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_anomalie_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    t = _kpi(flux, LUNDI, LUNDI)
+    assert _val(t, LUNDI, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(t, LUNDI, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for i, statut in enumerate(("ok", "ok", "ok", "ko", "non_execute", "non_execute")):
+        _cas(flux, f"DEMO-{i + 1}", statut)
+    t = _kpi(flux, LUNDI, LUNDI)
+    assert _val(t, LUNDI, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(t, LUNDI, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(t, LUNDI, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(t, LUNDI, "ENT-A", "taux_non_execution_cas_de_test", "tnr") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for cle, statut in (("DEMO-1", "accordee"), ("DEMO-2", "reservee"), ("DEMO-3", "reservee")):
+        flux.creer(
+            cle,
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    t = _kpi(flux, LUNDI, LUNDI)
+    assert _val(t, LUNDI, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(t, LUNDI, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(t, LUNDI, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI, MERCREDI])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"), [(["ENT-A", "ENT-A"], "ENT-A"), (["PROGRAMME"], "PROGRAMME")]
+)
+def test_entites_invalides(entites: list[str], valeur: str) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI])
+    with pytest.raises(UsineErreur, match=valeur):
+        kpi(etats, entites)
+
+
+def test_table_vide() -> None:
+    vide = valider(tickets_etats(Flux().evenements, [LUNDI]).clear(), SCHEMA_TICKET_ETAT)
+    resultat = kpi(vide, ENTITES)
+    assert resultat.height == 0
+    assert dict(resultat.schema) == dict(SCHEMA_KPI.colonnes)
+
+
+def _flux_mixte() -> Flux:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2), entite="ENT-B", gravite="mineure")
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    _cas(flux, "DEMO-3", "ko")
+    return flux
+
+
+def test_schema_dense_et_sans_flottant() -> None:
+    t = _kpi(_flux_mixte(), JEUDI, MERCREDI)
+    valider(t, SCHEMA_KPI)
+    assert not any(dtype.is_float() for dtype in t.schema.values())
+    par_perimetre = sum(len(dims) for dims in DIMENSIONS_KPI.values())
+    assert t.height == 5 * 3 * par_perimetre
+    assert set(t["code_kpi"]) == set(CODES_KPI)
+
+
+def test_programme_somme_des_entites() -> None:
+    t = _kpi(_flux_mixte(), JEUDI, MERCREDI)
+    comptes = t.filter(
+        pl.col("code_kpi").is_in(
+            ["anomalies_ouvertes", "anomalies_ouvertes_gravite", "entrees_jour", "sorties_jour"]
+        )
+    )
+    somme = (
+        comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by("date", "code_kpi", "dimension")
+        .agg(pl.col("numerateur").sum())
+    )
+    programme = comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME).select(
+        "date", "code_kpi", "dimension", "numerateur"
+    )
+    cles = ["date", "code_kpi", "dimension"]
+    assert somme.sort(cles).equals(programme.sort(cles))
+
