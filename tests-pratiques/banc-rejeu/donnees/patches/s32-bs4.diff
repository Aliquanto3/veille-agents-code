+def test_stock_egal_instantane() -> None:
+    flux = _flux_mixte()
+    etats = tickets_etats(flux.evenements, jours_ouvres(JEUDI, MERCREDI))
+    t = kpi(etats, ENTITES)
+    inst = instantane(etats).filter(
+        (pl.col("type_ticket") == "anomalie") & ~pl.col("statut").is_in(["fermee", "rejetee"])
+    )
+    for jour in jours_ouvres(JEUDI, MERCREDI):
+        attendu = inst.filter(pl.col("date") == jour)["nombre"].sum()
+        assert _val(t, jour, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (attendu, 1)
