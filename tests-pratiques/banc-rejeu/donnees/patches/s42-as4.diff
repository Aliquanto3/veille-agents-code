@@ -0,0 +1,347 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main sur 10 Jours ouvrés finissant au vendredi 09/10/2026
+(D), x = 0..9, projection à x = 9 + h. Grille rouge : IND-1 `>= 3`, IND-3 `>= 20`,
+IND-4 `>= 1/5`.
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → D + 1 JO (lundi 12/10), valeur courante 19.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σy = 7, ȳ = 7/10, x̄ = 9/2, Σ(x − x̄)² = 165/2,
+  Σ(x − x̄)(y − ȳ) = 41/4 → pente 41/165, ordonnée 7/10 − 41/165·9/2 = −23/55 ;
+  p(4) = −23/55 + 41/165·13 = 464/165 < 3 ; p(5) = −23/55 + 41/165·14 = 101/33 ≥ 3.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5.
+"""
+
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-A"
+VERSION_GRILLE = "grille-test"
+JOURS = jours_ouvres(date(2026, 1, 1), D)[-10:]
+
+GRILLE_YAML = """
+version: 1
+couleurs: [vert, jaune, orange, rouge]
+regle_agregation: pire_couleur
+garde_fous:
+  ind4_min_tests_executes: 20
+  ind7_min_entrees_fenetre_glissante: 5
+indicateurs:
+  IND-1:
+    libelle: "IND-1"
+    seuils: { rouge: ">= 3", orange: ">= 1" }
+  IND-3:
+    libelle: "IND-3"
+    seuils: { rouge: ">= 20", orange: ">= 10" }
+  IND-4:
+    libelle: "IND-4"
+    seuils: { rouge: ">= 0.20", orange: ">= 0.10" }
+"""
+
+
+def _grille(**indicateurs: Any) -> GrilleMeteo:
+    donnees = yaml.safe_load(GRILLE_YAML)
+    for code, remplacement in indicateurs.items():
+        donnees["indicateurs"][code.replace("_", "-")].update(remplacement)
+    return GrilleMeteo.model_validate(donnees)
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+Ligne = tuple[date, str, str, str, int, int]
+
+
+def _serie(
+    code: CodeIndicateur,
+    valeurs: list[tuple[int, int]],
+    jours: list[date] | None = None,
+    statuts: dict[int, str] | None = None,
+) -> list[dict[str, Any]]:
+    jours = jours if jours is not None else JOURS[-len(valeurs) :]
+    statuts = statuts or {}
+    lignes = []
+    for i, (jour, (num, den)) in enumerate(zip(jours, valeurs, strict=True)):
+        if i in statuts:
+            lignes.append(_ligne(jour, code, StatutIndicateur.non_evaluable, statuts[i], 0, 0))
+        else:
+            lignes.append(_ligne(jour, code, StatutIndicateur.evalue, "", num, den))
+    return lignes
+
+
+def _ligne(
+    jour: date, code: CodeIndicateur, statut: StatutIndicateur, motif: str, num: int, den: int
+) -> dict[str, Any]:
+    return {
+        "date": jour,
+        "entite": ENTITE,
+        "code": code.value,
+        "statut": statut.value,
+        "motif": motif,
+        "numerateur": num,
+        "denominateur": den,
+        "couleur": Couleur.vert.value,
+    }
+
+
+def _table(*series: list[dict[str, Any]]) -> pl.DataFrame:
+    lignes = [ligne for serie in series for ligne in serie]
+    return valider(
+        pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR
+    )
+
+
+def _entiers(valeurs: list[int]) -> list[tuple[int, int]]:
+    return [(v, 1) for v in valeurs]
+
+
+IND_1_PLAT = _entiers([0] * 10)
+IND_3_PLAT = _entiers([5] * 10)
+IND_4_PLAT = [(5, 100)] * 10
+
+
+def _table_defaut(
+    ind_1: list[tuple[int, int]] = IND_1_PLAT,
+    ind_3: list[tuple[int, int]] = IND_3_PLAT,
+    ind_4: list[tuple[int, int]] = IND_4_PLAT,
+) -> pl.DataFrame:
+    return _table(
+        _serie(CodeIndicateur.ind_1, ind_1),
+        _serie(CodeIndicateur.ind_3, ind_3),
+        _serie(CodeIndicateur.ind_4, ind_4),
+    )
+
+
+def test_franchissement_ind_3() -> None:
+    table = _table_defaut(ind_3=_entiers(list(range(10, 20))))
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert [r.risque.indicateur for r in resultat.risques] == [CodeIndicateur.ind_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.date_franchissement_estimee == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert (r.date_arrete, r.entite) == (D, ENTITE)
+    assert r.horizon_jours_ouvres == 5
+    assert r.version_grille == VERSION_GRILLE
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    table = _table_defaut(ind_1=_entiers([0, 0, 0, 0, 0, 1, 1, 1, 2, 2]))
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert len(resultat.risques) == 1
+    projete = resultat.risques[0]
+    assert projete.risque.indicateur is CodeIndicateur.ind_1
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+
+
+def test_horizon_plus_court_ecarte_le_risque() -> None:
+    table = _table_defaut(ind_1=_entiers([0, 0, 0, 0, 0, 1, 1, 1, 2, 2]))
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille(), ParametresRisque(horizon=4))
+
+    assert resultat.risques == ()
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    table = _table_defaut(ind_4=[(v, 100) for v in range(5, 15)])
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+@pytest.mark.parametrize("valeurs", [[7] * 10, list(range(10, 0, -1))])
+def test_stable_ou_en_baisse(valeurs: list[int]) -> None:
+    table = _table_defaut(ind_1=_entiers(valeurs), ind_3=_entiers(valeurs))
+
+    assert risques_entree_rouge(table, _meteo(), _grille()).risques == ()
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    table = _table(
+        _serie(CodeIndicateur.ind_1, _entiers(list(range(0, 10)))),
+        _serie(CodeIndicateur.ind_3, _entiers(list(range(10, 20)))),
+        _serie(CodeIndicateur.ind_4, IND_4_PLAT, statuts={2: "moins de 20 tests"}),
+    )
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert [r.risque.indicateur for r in resultat.risques] == [
+        CodeIndicateur.ind_1,
+        CodeIndicateur.ind_3,
+    ]
+    assert len(resultat.exclus) == 1
+    exclu = resultat.exclus[0]
+    assert exclu.code is CodeIndicateur.ind_4
+    assert JOURS[2].isoformat() in exclu.motif
+    assert "moins de 20 tests" in exclu.motif
+
+
+def test_historique_court() -> None:
+    table = _table(
+        _serie(CodeIndicateur.ind_1, _entiers([1])),
+        _serie(CodeIndicateur.ind_3, _entiers([18, 19])),
+        _serie(CodeIndicateur.ind_4, IND_4_PLAT),
+    )
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert [e.code for e in resultat.exclus] == [CodeIndicateur.ind_1]
+    assert "historique insuffisant" in resultat.exclus[0].motif
+    assert [r.risque.indicateur for r in resultat.risques] == [CodeIndicateur.ind_3]
+    assert resultat.risques[0].valeur_projetee == Fraction(20)
+
+
+@pytest.mark.parametrize(
+    "grille",
+    [
+        _grille(IND_3={"active": False}),
+        _grille(IND_3={"seuils": {"orange": ">= 10"}}),
+    ],
+)
+def test_indicateur_inactif_ou_sans_seuil_rouge(grille: GrilleMeteo) -> None:
+    # Aucune ligne IND-3 dans la table : la table n'est pas lue pour un indicateur exclu.
+    table = _table(
+        _serie(CodeIndicateur.ind_1, IND_1_PLAT), _serie(CodeIndicateur.ind_4, IND_4_PLAT)
+    )
+
+    resultat = risques_entree_rouge(table, _meteo(), grille)
+
+    assert resultat.risques == ()
+    assert [e.code for e in resultat.exclus] == [CodeIndicateur.ind_3]
+    assert isinstance(resultat.exclus[0], IndicateurExclu)
+    assert resultat.exclus[0].motif
+
+
+def test_entrees_invalides() -> None:
+    bon = _table_defaut()
+    with pytest.raises(UsineErreur, match=ENTITE):
