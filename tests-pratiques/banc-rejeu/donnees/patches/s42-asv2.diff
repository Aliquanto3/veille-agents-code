@@ -0,0 +1,200 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Pour
+une Entité non rouge à la Date d'arrêté D, elle ajuste par moindres carrés la droite des
+`fenetre` derniers Jours ouvrés d'IND-1, IND-3 et IND-4, la projette de 1 à `horizon` Jours
+ouvrés après D, et émet un `RisqueEntreeRouge` par indicateur dont une projection déclenche
+la règle rouge de la Grille (premier horizon concerné). La valeur projetée est rendue à côté
+du contrat gelé, qui ne porte que la valeur courante.
+
+Les indicateurs écartés sont restitués avec leur motif : sans règle rouge active, historique
+insuffisant (moins de 2 Jours ouvrés) ou non évaluable sur une partie de la fenêtre.
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+from typing import Any
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+INDICATEURS_PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque : paramètre {nom} invalide {valeur!r} (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Un `RisqueEntreeRouge` et la valeur projetée à sa date de franchissement."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec le motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D
+    sont lues, et chaque indicateur actif doit former des Jours ouvrés consécutifs finissant
+    à D. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou la table invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, Entité déjà en rouge")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in CodeIndicateur:
+        if code not in INDICATEURS_PROJETES:
+            continue
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active or Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, "indicateur inactif ou sans seuil rouge"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        lignes = _lignes(table, meteo, code)
+        fenetre = lignes[-parametres.fenetre :]
+        if len(fenetre) < 2:
+            exclus.append(IndicateurExclu(code, "historique insuffisant"))
+            continue
+        absente = next((ligne for ligne in fenetre if _non_evaluable(ligne)), None)
+        if absente is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"non évaluable le {absente['date'].isoformat()} : {absente['motif']}",
+                )
+            )
+            continue
+        valeurs = [_valeur(entite, code, ligne) for ligne in fenetre]
+        ordonnee, pente = _regression(valeurs)
+        n = len(valeurs)
+        for h in range(1, parametres.horizon + 1):
+            projetee = ordonnee + pente * (n - 1 + h)
+            if declenche(projetee, operateur, seuil):
+                courante = valeurs[-1]
+                risques.append(
+                    RisqueProjete(
+                        RisqueEntreeRouge(
+                            date_arrete=meteo.date_arrete,
+                            entite=entite,
+                            indicateur=code,
+                            date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                            horizon_jours_ouvres=parametres.horizon,
+                            numerateur=courante.numerator,
+                            denominateur=courante.denominator,
+                            seuil_numerateur=seuil.numerator,
+                            seuil_denominateur=seuil.denominator,
+                            version_grille=meteo.version_grille,
+                        ),
+                        projetee,
+                    )
+                )
+                break
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _lignes(table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur) -> list[dict[str, Any]]:
+    """Lignes de l'indicateur de l'Entité jusqu'à D : Jours ouvrés consécutifs finissant à D."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = (
+        table.filter(
+            (pl.col("entite") == entite)
+            & (pl.col("code") == code.value)
+            & (pl.col("date") <= arrete)
+        )
+        .sort("date")
+        .to_dicts()
+    )
+    precedent: date | None = None
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} : {code} {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if precedent == jour:
+            raise UsineErreur(f"Risque {entite} : {code} date {jour.isoformat()} en double")
+        if precedent is not None and jour_ouvre_suivant(precedent) != jour:
+            raise UsineErreur(
+                f"Risque {entite} : {code} trou de Jours ouvrés entre"
+                f" {precedent.isoformat()} et {jour.isoformat()}"
+            )
+        precedent = jour
+    if precedent != arrete:
+        raise UsineErreur(
+            f"Risque {entite} : {code} absent à la Date d'arrêté {arrete.isoformat()}"
+        )
+    return lignes
+
+
+def _non_evaluable(ligne: dict[str, Any]) -> bool:
+    return bool(ligne["statut"] == StatutIndicateur.non_evaluable.value)
+
+
+def _valeur(entite: str, code: CodeIndicateur, ligne: dict[str, Any]) -> Fraction:
+    if ligne["denominateur"] <= 0:
+        raise UsineErreur(
+            f"Risque {entite} : {code} {ligne['date'].isoformat()} évalué avec un"
+            f" dénominateur {ligne['denominateur']}"
+        )
+    return Fraction(ligne["numerateur"], ligne["denominateur"])
+
+
+def _regression(valeurs: list[Fraction]) -> tuple[Fraction, Fraction]:
+    """Droite des moindres carrés y = a + b·x pour x = 0..n−1 (n ≥ 2) : renvoie (a, b)."""
+    n = len(valeurs)
+    x_moy = Fraction(n - 1, 2)
+    y_moy = sum(valeurs, Fraction(0)) / n
+    covariance = sum(((x - x_moy) * (y - y_moy) for x, y in enumerate(valeurs)), Fraction(0))
+    variance = sum(((x - x_moy) ** 2 for x in range(n)), Fraction(0))
+    pente = covariance / variance
+    return y_moy - pente * x_moy, pente
