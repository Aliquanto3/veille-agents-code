+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main, ENT-C sur 10 Jours ouvrés finissant au vendredi
+09/10/2026 (D), x = 0..9, projection à x = 9 + h. Grille par défaut : rouge IND-1 `>= 3`,
+IND-3 `>= 20`, IND-4 `>= 1/5`.
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → franchissement à D + 1 JO.
+- IND-1 = 0,0,0,0,0,1,1,1,2,2 : Σy = 7, ȳ = 7/10, x̄ = 9/2, Σ(x − x̄)² = 165/2,
+  Σ(x − x̄)(y − ȳ) = 41/2 → pente 41/165, ordonnée 7/10 − (41/165)(9/2) = −23/55 ;
+  p(4) = −23/55 + 13·41/165 = 464/165 < 3 ; p(5) = −23/55 + 14·41/165 = 101/33 ≥ 3.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+import re
+from collections.abc import Sequence
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from usine.config import charger_yaml
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import risque
+from usine.domaine.prevision.commun import avancer
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+GRILLE = charger_yaml(RACINE / "config" / "grille_meteo.yaml", GrilleMeteo)
+
+Valeur = tuple[int, int] | str | None
+"""(numérateur, dénominateur), ou motif d'un indicateur non évaluable, ou `None` (absent)."""
+
+IND_1_NON_LINEAIRE: list[Valeur] = [(v, 1) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+IND_3_MONTANT: list[Valeur] = [(v, 1) for v in range(10, 20)]
+IND_4_FAIBLE: list[Valeur] = [(v, 100) for v in range(5, 15)]
+CONSTANT_1: list[Valeur] = [(1, 1)] * 10
+CONSTANT_3: list[Valeur] = [(5, 1)] * 10
+CONSTANT_4: list[Valeur] = [(1, 10)] * 10
+
+
+def _table(
+    series: dict[CodeIndicateur, Sequence[Valeur]], entite: str = ENTITE, fin: date = D
+) -> pl.DataFrame:
+    lignes: list[dict[str, object]] = []
+    for code, valeurs in series.items():
+        dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+        for jour, valeur in zip(dates, valeurs, strict=True):
+            evalue = isinstance(valeur, tuple)
+            lignes.append(
+                {
+                    "date": jour,
+                    "entite": entite,
+                    "code": code.value,
+                    "statut": "evalue" if evalue else "non_evaluable",
+                    "motif": "" if evalue else str(valeur),
+                    "numerateur": valeur[0] if isinstance(valeur, tuple) else 0,
+                    "denominateur": valeur[1] if isinstance(valeur, tuple) else 0,
+                    "couleur": "orange" if evalue else "vert",
+                }
+            )
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _tout(
+    ind_1: Sequence[Valeur] = CONSTANT_1,
+    ind_3: Sequence[Valeur] = CONSTANT_3,
+    ind_4: Sequence[Valeur] = CONSTANT_4,
+) -> pl.DataFrame:
+    return _table(
+        {CodeIndicateur.ind_1: ind_1, CodeIndicateur.ind_3: ind_3, CodeIndicateur.ind_4: ind_4}
+    )
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regle = RegleDeclenchante(
+        code=CodeIndicateur.ind_5,
+        couleur=couleur,
+        operateur=Operateur.superieur_ou_egal,
+        numerateur=2,
+        denominateur=1,
+        seuil_numerateur=2,
+        seuil_denominateur=1,
+        tickets_en_cause=(),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(regle,),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _grille_sans(code: CodeIndicateur, **modifs: object) -> GrilleMeteo:
+    regle = GRILLE.indicateurs[code].model_copy(update=modifs)
+    return GRILLE.model_copy(update={"indicateurs": {**GRILLE.indicateurs, code: regle}})
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = risques_entree_rouge(_tout(ind_3=IND_3_MONTANT), _meteo(), GRILLE)
+
+    assert [r.risque.indicateur for r in resultat.risques] == [CodeIndicateur.ind_3]
+    projete = resultat.risques[0]
+    assert projete.risque.date_franchissement_estimee == avancer(D, 1)
+    assert projete.valeur_projetee == Fraction(20)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (19, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (20, 1)
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = risques_entree_rouge(_tout(ind_1=IND_1_NON_LINEAIRE), _meteo(), GRILLE)
+
+    assert [r.risque.indicateur for r in resultat.risques] == [CodeIndicateur.ind_1]
+    projete = resultat.risques[0]
+    assert projete.risque.date_franchissement_estimee == avancer(D, 5)
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_regression_exacte() -> None:
+    ordonnee, pente = risque._regression([Fraction(v) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)])
+
+    assert (pente, ordonnee) == (Fraction(41, 165), Fraction(-23, 55))
+    assert ordonnee + pente * 13 == Fraction(464, 165)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = risques_entree_rouge(_tout(ind_4=IND_4_FAIBLE), _meteo(), GRILLE)
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind_4_assez_forte_franchit() -> None:
+    serie = [(v, 100) for v in range(10, 20)]  # pente 1/100, p(1) = 20/100 = 1/5
+
+    resultat = risques_entree_rouge(_tout(ind_4=serie), _meteo(), GRILLE)
+
+    assert [r.risque.indicateur for r in resultat.risques] == [CodeIndicateur.ind_4]
+    assert resultat.risques[0].valeur_projetee == Fraction(1, 5)
+    assert resultat.risques[0].risque.date_franchissement_estimee == avancer(D, 1)
+
+
+def test_stable_ou_en_baisse() -> None:
+    baisse = [(v, 1) for v in range(19, 9, -1)]
+
+    resultat = risques_entree_rouge(_tout(ind_1=CONSTANT_1, ind_3=baisse), _meteo(), GRILLE)
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    ind_4: list[Valeur] = [(1, 10)] * 10
+    ind_4[3] = "aucun test exécuté"
+    ind_4[5] = "autre motif"
+
+    resultat = risques_entree_rouge(
+        _tout(ind_1=IND_1_NON_LINEAIRE, ind_3=IND_3_MONTANT, ind_4=ind_4),
+        _meteo(),
+        GRILLE,
+    )
+
+    assert [r.risque.indicateur for r in resultat.risques] == [
+        CodeIndicateur.ind_1,
+        CodeIndicateur.ind_3,
+    ]
+    assert len(resultat.exclus) == 1
+    exclu = resultat.exclus[0]
+    premiere = jours_ouvres(date(2026, 1, 1), D)[-10:][3]
+    assert exclu.code is CodeIndicateur.ind_4
+    assert premiere.isoformat() in exclu.motif
+    assert "aucun test exécuté" in exclu.motif
+    assert "autre motif" not in exclu.motif
+
+
+def test_historique_court() -> None:
+    table = _table(
+        {
+            CodeIndicateur.ind_1: [(2, 1)],
+            CodeIndicateur.ind_3: [(18, 1), (19, 1)],
+            CodeIndicateur.ind_4: [(1, 10)] * 10,
+        }
+    )
+
+    resultat = risques_entree_rouge(table, _meteo(), GRILLE)
+
+    assert [e.code for e in resultat.exclus] == [CodeIndicateur.ind_1]
+    assert "historique insuffisant" in resultat.exclus[0].motif
+    assert [r.risque.indicateur for r in resultat.risques] == [CodeIndicateur.ind_3]
+    assert resultat.risques[0].valeur_projetee == Fraction(20)
+
+
+def test_fenetre_limitee_aux_10_derniers() -> None:
+    # 12 JO : deux anciens points très élevés ne doivent pas peser sur la fenêtre de 10.
+    serie = [(100, 1), (100, 1)] + [(5, 1)] * 10
+
