index 0000000..30048d7
--- /dev/null
+++ b/src/usine/ia/agent/outils.py
@@ -0,0 +1,175 @@
+"""Outils de consultation de l'Agent, en lecture seule, servis par `Consultation` (FR-39, AD-11).
+
+La passerelle (Story 7.9) construit les `OutilAgent` à partir de ces définitions et sérialise les
+résultats ; ce module ne calcule aucun chiffre.
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS = ("get_meteo", "list_anomalies", "get_tendance", "get_prevision", "get_risques")
+"""Les cinq outils de l'Agent, tous en lecture seule."""
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Un outil : nom, description pour le modèle, classe d'arguments et exécution."""
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+
+
+class OutilsConsultation:
+    """Lectures du Passage exposées à l'Agent."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _date(self, demandee: date | None) -> date | None:
+        """Date à lire, ou `None` si le Passage ne couvre pas la date demandée."""
+        disponibles = self._consultation.dates_disponibles()
+        if demandee is None:
+            if not disponibles:
+                return None
+            return self._consultation.manifeste().date_arrete
+        return demandee if demandee in disponibles else None
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        jour = self._date(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetMeteo(
+            date_arrete=jour,
+            meteos=self._consultation.meteo(jour, arguments.entite),
+            evolutions=tuple(
+                e
+                for e in self._consultation.evolution_meteo(jour)
+                if arguments.entite is None or e.entite == arguments.entite
+            ),
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        jour = self._date(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        if arguments.statut is None:
+            return self._consultation.anomalies(
+                date_arrete=jour,
+                entite=arguments.entite,
+                gravite=arguments.gravite,
+                phase=arguments.phase,
+                domaine=arguments.domaine,
+                limite=arguments.limite,
+            )
+        lues = self._consultation.anomalies(
+            date_arrete=jour,
+            entite=arguments.entite,
+            gravite=arguments.gravite,
+            phase=arguments.phase,
+            domaine=arguments.domaine,
+            limite=None,
+        )
+        retenues = tuple(a for a in lues.anomalies if a.statut == arguments.statut)
+        return ResultatListAnomalies(
+            date_arrete=lues.date_arrete,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        return ResultatGetTendance(
+            points=tuple(PointTendance(**ligne) for ligne in table.iter_rows(named=True))
+        )
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        jour = self._date(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetPrevision(
+            date_arrete=jour, previsions=self._consultation.previsions(jour, arguments.entite)
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        jour = self._date(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetRisques(
+            date_arrete=jour, risques=self._consultation.risques(jour, arguments.entite)
+        )
+
+
+def _definition(
+    nom: str,
+    description: str,
+    arguments: type[Any],
+    methode: Callable[[Any], Enregistrement],
+) -> DefinitionOutil:
+    return DefinitionOutil(
+        nom=nom,
+        description=description,
+        arguments=arguments,
+        executer=lambda brut: methode(arguments.model_validate(dict(brut))),
+    )
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Les cinq outils de l'Agent, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+    return (
+        _definition(
+            "get_meteo",
+            "Météo par Entité, Règles déclenchantes et évolution J-1 / J-5, à une Date d'arrêté.",
+            ArgumentsGetMeteo,
+            outils.get_meteo,
+        ),
+        _definition(
+            "list_anomalies",
+            "Anomalies ouvertes, filtrables par Entité, Gravité, Phase, domaine et statut.",
+            ArgumentsListAnomalies,
+            outils.list_anomalies,
+        ),
+        _definition(
+            "get_tendance",
+            "Tendances hebdomadaires, filtrables par Entité et par KPI.",
+            ArgumentsGetTendance,
+            outils.get_tendance,
+        ),
+        _definition(
+            "get_prevision",
+            "Prévisions de sortie du rouge, à une Date d'arrêté.",
+            ArgumentsGetPrevision,
+            outils.get_prevision,
+        ),
+        _definition(
+            "get_risques",
+            "Risques d'entrée en rouge, à une Date d'arrêté.",
+            ArgumentsGetRisques,
+            outils.get_risques,
+        ),
+    )
diff --git a/tests/unit/ia/agent/test_outils.py b/tests/unit/ia/agent/test_outils.py
