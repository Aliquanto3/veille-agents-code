@@ -0,0 +1,207 @@
+"""Outils de consultation de l'Agent : lecture seule, servis par `Consultation` (FR-39, AD-5)."""
+
+import ast
+import re
+from datetime import date
+from pathlib import Path
+from typing import Any, cast
+
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+import usine.ia.agent as paquet_agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from tests.unit.ia.espions import DATE_ARRETE, prevision_rouge, risque_entree_rouge
+from usine.contrats import agent as contrats_agent
+from usine.contrats.agent import (
+    AnomalieResume,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.passage import ManifestePassage
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+from usine.ports.consultation import Consultation
+
+AUTRE_DATE = date(2026, 1, 5)
+
+
+def _anomalie(cle: str, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=cle,
+        entite="ENT-A",
+        gravite=Gravite.majeure,
+        phase=Phase.recette,
+        domaine="D",
+        statut=statut,
+        age_jours_ouvres=1,
+    )
+
+
+class ConsultationFactice:
+    def __init__(self, dates: tuple[date, ...] = (DATE_ARRETE,)) -> None:
+        self._dates = dates
+        self.anomalies_appels: list[dict[str, Any]] = []
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self._dates
+
+    def manifeste(self) -> ManifestePassage:
+        return cast(ManifestePassage, type("M", (), {"date_arrete": DATE_ARRETE})())
+
+    def meteo(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        return ()
+
+    def evolution_meteo(self, date_arrete: date | None = None) -> tuple[()]:
+        return ()
+
+    def anomalies(self, **kwargs: Any) -> ResultatListAnomalies:
+        self.anomalies_appels.append(kwargs)
+        statuts = [
+            StatutAnomalie.en_analyse,
+            StatutAnomalie.nouvelle,
+            StatutAnomalie.en_analyse,
+            StatutAnomalie.en_analyse,
+        ]
+        toutes = tuple(_anomalie(f"T-{i}", s) for i, s in enumerate(statuts))
+        limite = kwargs["limite"]
+        retenues = toutes if limite is None else toutes[:limite]
+        return ResultatListAnomalies(
+            date_arrete=kwargs["date_arrete"], anomalies=retenues, total=len(toutes)
+        )
+
+    def tendances(self, entite: str | None = None, code_kpi: str | None = None) -> pl.DataFrame:
+        return pl.DataFrame(
+            dict(
+                date=[DATE_ARRETE],
+                perimetre=["ENT-A"],
+                code_kpi=["K"],
+                dimension=["d"],
+                numerateur=[3],
+                denominateur=[4],
+            )
+        )
+
+    def previsions(self, date_arrete: date | None = None, entite: str | None = None) -> Any:
+        return (prevision_rouge(),)
+
+    def risques(self, date_arrete: date | None = None, entite: str | None = None) -> Any:
+        return (risque_entree_rouge(),)
+
+
+def _outils(consultation: Any) -> dict[str, Any]:
+    return {o.nom: o for o in outils_consultation(cast(Consultation, consultation))}
+
+
+def test_noms_exacts_et_classes_de_contrats() -> None:
+    outils = outils_consultation(cast(Consultation, ConsultationFactice()))
+    assert tuple(o.nom for o in outils) == NOMS_OUTILS
+    assert set(NOMS_OUTILS) == {
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    }
+    for o in outils:
+        assert o.arguments.__module__ == contrats_agent.__name__
+        assert o.description
+
+
+def test_aucun_verbe_d_ecriture() -> None:
+    publiques = {n for n in dir(OutilsConsultation) if not n.startswith("_")}
+    assert publiques == set(NOMS_OUTILS)
+    motif = r"write|create|update|delete|send|post|set_|ecrire|envoyer"
+    assert not any(re.search(motif, n) for n in publiques)
+
+
+def test_modules_importes_en_lecture_seule() -> None:
+    interdits = (
+        "usine.ports.source_tickets",
+        "usine.ports.entrepot",
+        "usine.ports.etape",
+        "usine.ports.fournisseur_llm",
+        "usine.ports.cache_llm",
+        "usine.adaptateurs",
+        "pydantic_ai",
+        "httpx",
+    )
+    for fichier in Path(paquet_agent.__path__[0]).glob("*.py"):
+        source = fichier.read_text(encoding="utf-8")
+        for noeud in ast.walk(ast.parse(source)):
+            if isinstance(noeud, ast.ImportFrom) and noeud.module:
+                modules = [noeud.module]
+            elif isinstance(noeud, ast.Import):
+                modules = [a.name for a in noeud.names]
+            else:
+                continue
+            for module in modules:
+                assert not module.startswith(interdits), f"{fichier.name} importe {module}"
+        assert "url_ticket" not in source
+
+
+def test_date_absente_prend_celle_du_manifeste() -> None:
+    resultat = _outils(ConsultationFactice())["get_meteo"].executer({})
+    assert isinstance(resultat, ResultatGetMeteo)
+    assert resultat.date_arrete == DATE_ARRETE
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_date_sans_passage(nom: str) -> None:
+    resultat = _outils(ConsultationFactice())[nom].executer(dict(date_arrete=AUTRE_DATE))
+    assert resultat == AucuneDonnee(date_arrete=AUTRE_DATE)
+    assert resultat.message == "aucune donnée pour cette date"
+
+
+def test_aucune_date_du_tout() -> None:
+    resultat = _outils(ConsultationFactice(dates=()))["get_risques"].executer({})
+    assert resultat == AucuneDonnee(date_arrete=None)
+
+
+def test_prevision_et_risques() -> None:
+    outils = _outils(ConsultationFactice())
+    assert isinstance(outils["get_prevision"].executer({}), ResultatGetPrevision)
+    assert isinstance(outils["get_risques"].executer({}), ResultatGetRisques)
+
+
+def test_tendance_sans_date() -> None:
+    resultat = _outils(ConsultationFactice(dates=()))["get_tendance"].executer({})
+    assert isinstance(resultat, ResultatGetTendance)
+    assert resultat.points[0].numerateur == 3
+
+
+def test_filtre_statut_et_total() -> None:
+    resultat = _outils(ConsultationFactice())["list_anomalies"].executer(
+        dict(statut="en_analyse", limite=2)
+    )
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert len(resultat.anomalies) == 2
+    assert {a.statut for a in resultat.anomalies} == {StatutAnomalie.en_analyse}
+    assert resultat.total == 3
+
+
+def test_sans_statut_la_limite_est_transmise() -> None:
+    fausse = ConsultationFactice()
+    _outils(fausse)["list_anomalies"].executer(dict(limite=2))
+    assert fausse.anomalies_appels[0]["limite"] == 2
+
+
+def test_arguments_invalides() -> None:
+    with pytest.raises(ValidationError):
+        _outils(ConsultationFactice())["list_anomalies"].executer(dict(limite=0))
+
+
+def test_integration_passage_palier_2() -> None:
+    cas = passage_palier_2()
+    outils = _outils(cas.consultation)
+    for nom in ("get_meteo", "list_anomalies", "get_prevision", "get_risques"):
+        resultat = outils[nom].executer({})
+        assert not isinstance(resultat, AucuneDonnee)
+        assert resultat.date_arrete == cas.consultation.manifeste().date_arrete
+        assert isinstance(outils[nom].executer(dict(date_arrete="1999-01-04")), AucuneDonnee)
+    assert isinstance(outils["get_tendance"].executer({}), ResultatGetTendance)
