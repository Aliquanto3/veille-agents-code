+def test_fenetre_glissante() -> None:
+    dates = list(jours_ouvres(LUNDI, date(2026, 10, 13)))
+    assert len(dates) == 7
+    entrees = [1, 2, 3, 1, 0, 2, 1]
+    flux = Flux()
+    numero = 0
+    for d, n in zip(dates, entrees, strict=True):
+        for _ in range(n):
+            numero += 1
+            flux.anomalie(f"DEMO-{numero}", _ts(d, 9))
+            flux.transition(f"DEMO-{numero}", _ts(d, 10), "nouvelle", "fermee")
+    table = _kpi(flux, dates)
+    for i, d in enumerate(dates):
+        attendu = sum(entrees[max(0, i - 4) : i + 1])
+        assert _valeur(table, d, "ENT-A", "entrees_fenetre") == (attendu, 1)
+        assert _valeur(table, d, "ENT-A", "sorties_fenetre") == (attendu, 1)
+        assert _valeur(table, d, PERIMETRE_PROGRAMME, "entrees_fenetre") == (attendu, 1)
+        jours = set(fenetre_glissante(d))
+        somme = sum(_valeur(table, j, "ENT-A", "entrees_jour")[0] for j in dates if j in jours)
+        assert somme == attendu
+
