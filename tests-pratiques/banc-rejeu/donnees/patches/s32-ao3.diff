@@ -0,0 +1,381 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-10, H-17, H-19).
+
+Fonction pure : l'état des tickets de chaque Jour ouvré et les Entités arrivent en paramètre ;
+le temps passe par `contrats.calendrier` seulement (AD-17). Tout KPI est porté en
+`numerateur` / `denominateur` entiers (AD-10) : un compte vaut `n/1`, une valeur sans objet
+(âge sans Anomalie ouverte, taux sans dénominateur) vaut `0/0`.
+
+Définitions (H-17) : Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée = création ou
+réouverture (`date_derniere_entree == D`) ; Sortie = passage à Fermée ou Rejetée, déduite de
+l'Entrée et de la variation du statut ouvert depuis la veille (`S = E − δ`), de sorte que
+stock(D) − stock(D−1) = entrées − sorties. Plusieurs réouvertures d'un même ticket dans la
+journée comptent pour une Entrée. Fenêtre glissante : `calendrier.fenetre_glissante` (H-19).
+"""
+
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import (
+    est_jour_ouvre,
+    fenetre_glissante,
+    jour_ouvre_precedent,
+    jours_ouvres,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des KPI quotidiens, dans l'ordre des lignes produites (`code_kpi` texte libre)."""
+
+_SANS_DIMENSION: tuple[str, ...] = ("",)
+_GRAVITES = tuple(g.value for g in Gravite)
+_PHASES = tuple(p.value for p in Phase)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "anomalies_ouvertes": _SANS_DIMENSION,
+        "anomalies_ouvertes_gravite": _GRAVITES,
+        "anomalies_ouvertes_phase": _PHASES,
+        "entrees_jour": _SANS_DIMENSION,
+        "sorties_jour": _SANS_DIMENSION,
+        "entrees_fenetre": _SANS_DIMENSION,
+        "sorties_fenetre": _SANS_DIMENSION,
+        "age_median_anomalies_ouvertes": _SANS_DIMENSION,
+        "age_max_anomalies_ouvertes": _SANS_DIMENSION,
+        "taux_ko_cas_de_test": _PHASES,
+        "taux_non_execution_cas_de_test": _PHASES,
+        "certifications": tuple(s.value for s in StatutCertification),
+    }
+)
+"""Dimensions de chaque KPI, dans l'ordre des lignes (`""` = KPI non ventilé)."""
+
+_CODES_SANS_OBJET = frozenset(
+    {
+        "age_median_anomalies_ouvertes",
+        "age_max_anomalies_ouvertes",
+        "taux_ko_cas_de_test",
+        "taux_non_execution_cas_de_test",
+    }
+)
+"""KPI qui valent `0/0` en l'absence de valeur ; les autres sont des comptes `n/1`."""
+
+_FENETRE = {"entrees_jour": "entrees_fenetre", "sorties_jour": "sorties_fenetre"}
+
+_FERMES = [statut.value for statut in STATUTS_FERMES]
+
+_CLES = ["date", "perimetre", "code_kpi", "dimension"]
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité {PERIMETRE_PROGRAMME!r} refusée : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(etats: pl.DataFrame) -> list[date]:
+    """Dates de la table, triées ; refuse un jour non ouvré ou un Jour ouvré manquant."""
+    dates: list[date] = sorted(set(etats.get_column("date").to_list()))
+    hors = [d.isoformat() for d in dates if not est_jour_ouvre(d)]
+    if hors:
+        raise UsineErreur(
+            f"KPI : date(s) hors Jours ouvrés dans l'état des tickets : {', '.join(hors)}"
+        )
+    if not dates:
+        return dates
+    manquantes = sorted(set(jours_ouvres(dates[0], dates[-1])) - set(dates))
+    if manquantes:
+        raise UsineErreur(
+            "KPI : Jour(s) ouvré(s) absent(s) de l'état des tickets :"
+            f" {', '.join(d.isoformat() for d in manquantes)} (dates contiguës attendues)"
+        )
+    doublons = etats.filter(pl.struct("date", "cle_ticket").is_duplicated())
+    if doublons.height:
+        ligne = doublons.row(0, named=True)
+        raise UsineErreur(
+            f"KPI : ticket {ligne['cle_ticket']} présent deux fois à la date"
+            f" {ligne['date'].isoformat()}"
+        )
+    return dates
+
+
+def _anomalies(etats: pl.DataFrame) -> pl.DataFrame:
+    """Anomalies avec `ouvert` (0/1), `entree` (0/1) et `sortie` (`entree − δ`) en D."""
+    anomalies = etats.filter(pl.col("type_ticket") == TypeTicket.anomalie.value).with_columns(
+        (pl.col("statut").is_not_null() & ~pl.col("statut").cast(pl.Utf8).is_in(_FERMES))
+        .cast(pl.Int64)
+        .alias("ouvert")
+    )
+    dates = anomalies.get_column("date").unique().to_list()
+    veilles = pl.DataFrame(
+        {"date": dates, "date_veille": [jour_ouvre_precedent(d) for d in dates]},
+        schema={"date": pl.Date(), "date_veille": pl.Date()},
+    )
+    ouverts_veille = anomalies.select(
+        pl.col("date").alias("date_veille"), "cle_ticket", pl.col("ouvert").alias("ouvert_veille")
+    )
+    return (
+        anomalies.join(veilles, on="date", how="left")
+        .join(ouverts_veille, on=["date_veille", "cle_ticket"], how="left")
+        .with_columns(
+            (pl.col("date_derniere_entree") == pl.col("date"))
+            .fill_null(False)
+            .cast(pl.Int64)
+            .alias("entree")
+        )
+        .with_columns(
+            (pl.col("entree") - pl.col("ouvert") + pl.col("ouvert_veille").fill_null(0)).alias(
+                "sortie"
+            )
+        )
+    )
+
+
+def _contribution(
+    table: pl.DataFrame,
+    code: str,
+    dimension: pl.Expr,
+    numerateur: pl.Expr,
+    denominateur: pl.Expr | None = None,
+) -> pl.DataFrame:
+    """Apport de chaque ticket au KPI `code` : une ligne par ticket et par date."""
+    return table.select(
+        "date",
+        "entite",
+        pl.lit(code).alias("code_kpi"),
+        dimension.cast(pl.Utf8).alias("dimension"),
+        numerateur.cast(pl.Int64).alias("numerateur"),
+        (pl.lit(0) if denominateur is None else denominateur).cast(pl.Int64).alias("denominateur"),
+    )
+
+
+def _comptes(etats: pl.DataFrame, anomalies: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """Stocks, flux du jour, taux et Certifications, par Entité et pour le Programme."""
+    ouvertes = anomalies.filter(pl.col("ouvert") == 1)
+    sans = pl.lit("")
+    un = pl.lit(1)
+    cas = etats.filter(
+        (pl.col("type_ticket") == TypeTicket.cas_de_test.value)
+        & pl.col("statut_test").is_not_null()
+    )
+    statut_test = pl.col("statut_test").cast(pl.Utf8)
+    executes = cas.filter(statut_test.is_in([StatutTest.ok.value, StatutTest.ko.value]))
+    certifications = etats.filter(
+        (pl.col("type_ticket") == TypeTicket.certification.value)
+        & pl.col("statut_certification").is_not_null()
+    )
+    apports = pl.concat(
+        [
+            _contribution(ouvertes, "anomalies_ouvertes", sans, un),
+            _contribution(ouvertes, "anomalies_ouvertes_gravite", pl.col("gravite"), un),
+            _contribution(ouvertes, "anomalies_ouvertes_phase", pl.col("phase"), un),
+            _contribution(anomalies, "entrees_jour", sans, pl.col("entree")),
+            _contribution(anomalies, "sorties_jour", sans, pl.col("sortie")),
+            _contribution(
+                executes,
+                "taux_ko_cas_de_test",
+                pl.col("phase"),
+                statut_test == StatutTest.ko.value,
+                un,
+            ),
+            _contribution(
+                cas,
+                "taux_non_execution_cas_de_test",
+                pl.col("phase"),
+                statut_test == StatutTest.non_execute.value,
+                un,
+            ),
+            _contribution(certifications, "certifications", pl.col("statut_certification"), un),
+        ],
+        how="vertical",
+    ).filter(pl.col("dimension").is_not_null())
+    sommes = [pl.col("numerateur").sum(), pl.col("denominateur").sum()]
+    par_entite = (
+        apports.filter(pl.col("entite").is_in(list(entites)))
+        .group_by("date", "entite", "code_kpi", "dimension")
+        .agg(sommes)
+        .rename({"entite": "perimetre"})
+    )
+    programme = (
+        apports.group_by("date", "code_kpi", "dimension")
+        .agg(sommes)
+        .with_columns(pl.lit(PERIMETRE_PROGRAMME).alias("perimetre"))
+    )
+    colonnes = [*_CLES, "numerateur", "denominateur"]
+    return pl.concat([par_entite.select(colonnes), programme.select(colonnes)])
+
+
+def _fenetres(comptes: pl.DataFrame, dates: Sequence[date]) -> pl.DataFrame:
+    """Entrées et Sorties cumulées sur la Fenêtre glissante finissant en D (H-19)."""
+    presentes = set(dates)
+    paires = [(d, j) for d in dates for j in fenetre_glissante(d) if j in presentes]
+    fenetres = pl.DataFrame(
+        {"date": [d for d, _ in paires], "jour": [j for _, j in paires]},
+        schema={"date": pl.Date(), "jour": pl.Date()},
+    )
+    jours = comptes.filter(pl.col("code_kpi").is_in(list(_FENETRE))).rename({"date": "jour"})
+    return (
+        fenetres.join(jours, on="jour", how="inner")
+        .group_by("date", "perimetre", "code_kpi", "dimension")
+        .agg(pl.col("numerateur").sum(), pl.col("denominateur").sum())
+        .with_columns(pl.col("code_kpi").replace_strict(_FENETRE, return_dtype=pl.Utf8))
+        .select(*_CLES, "numerateur", "denominateur")
+    )
+
+
+def _mediane(ages: list[int]) -> Fraction:
+    tries = sorted(ages)
+    milieu = len(tries) // 2
+    if len(tries) % 2:
+        return Fraction(tries[milieu])
+    return Fraction(tries[milieu - 1] + tries[milieu], 2)
+
+
+def _ages(anomalies: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """Âges médian et maximum des Anomalies ouvertes, en Jours ouvrés depuis la dernière Entrée."""
+    ouvertes = anomalies.filter(pl.col("ouvert") == 1)
+    invalides = ouvertes.filter(
+        pl.col("date_derniere_entree").is_null() | (pl.col("date_derniere_entree") > pl.col("date"))
+    )
+    if invalides.height:
+        ligne = invalides.row(0, named=True)
+        raise UsineErreur(
+            f"KPI : Anomalie ouverte {ligne['cle_ticket']} au {ligne['date'].isoformat()} sans"
+            " date de dernière Entrée valide (nulle ou postérieure)"
+        )
+    paires = ouvertes.select("date_derniere_entree", "date").unique().rows()
+    ages = pl.DataFrame(
+        {
+            "date_derniere_entree": [entree for entree, _ in paires],
+            "date": [d for _, d in paires],
+            "age": [len(jours_ouvres(entree, d)) - 1 for entree, d in paires],
+        },
+        schema={"date_derniere_entree": pl.Date(), "date": pl.Date(), "age": pl.Int64()},
+    )
+    avec_age = ouvertes.join(ages, on=["date_derniere_entree", "date"], how="left")
+    groupes = pl.concat(
+        [
+            avec_age.filter(pl.col("entite").is_in(list(entites)))
+            .group_by("date", "entite")
+            .agg(pl.col("age"))
+            .rename({"entite": "perimetre"}),
+            avec_age.group_by("date")
+            .agg(pl.col("age"))
+            .select("date", pl.lit(PERIMETRE_PROGRAMME).alias("perimetre"), "age"),
+        ]
+    )
+    lignes: dict[str, list[object]] = {c: [] for c in SCHEMA_KPI.colonnes}
+    for d, perimetre, liste in groupes.iter_rows():
+        mediane = _mediane(liste)
+        for code, valeur in (
+            ("age_median_anomalies_ouvertes", mediane),
+            ("age_max_anomalies_ouvertes", Fraction(max(liste))),
+        ):
+            lignes["date"].append(d)
+            lignes["perimetre"].append(perimetre)
+            lignes["code_kpi"].append(code)
+            lignes["dimension"].append("")
+            lignes["numerateur"].append(valeur.numerator)
+            lignes["denominateur"].append(valeur.denominator)
+    return pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+
+
+def _squelette(dates: Sequence[date], entites: Sequence[str]) -> pl.DataFrame:
+    """Une ligne par date, périmètre, code et dimension, avec les rangs de tri."""
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    catalogue = [
+        (code, dimension, rang_code, rang_dimension, code in _CODES_SANS_OBJET)
+        for rang_code, code in enumerate(CODES_KPI)
+        for rang_dimension, dimension in enumerate(DIMENSIONS_KPI[code])
+    ]
+    return (
+        pl.DataFrame({"date": list(dates)}, schema={"date": pl.Date()})
+        .join(
+            pl.DataFrame(
+                {"perimetre": perimetres, "rang_perimetre": list(range(len(perimetres)))},
+                schema={"perimetre": pl.Utf8(), "rang_perimetre": pl.Int64()},
+            ),
+            how="cross",
+        )
+        .join(
+            pl.DataFrame(
+                catalogue,
+                schema={
+                    "code_kpi": pl.Utf8(),
+                    "dimension": pl.Utf8(),
+                    "rang_code": pl.Int64(),
+                    "rang_dimension": pl.Int64(),
+                    "sans_objet": pl.Boolean(),
+                },
+                orient="row",
+            ),
+            how="cross",
+        )
+    )
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` dense : chaque KPI du catalogue, pour chaque date de `tickets_etats`.
+
+    Périmètres : chaque Entité de `entites` (dans l'ordre), puis `PERIMETRE_PROGRAMME`, qui
+    compte toutes les lignes de la table, y compris celles d'Entités hors de `entites`. Le
+    périmètre d'un ticket en D est son Entité en D. Lignes triées par date, périmètre, code
+    (ordre de `CODES_KPI`) et dimension (ordre de `DIMENSIONS_KPI`) ; zéro explicite.
+
+    Précondition : la table couvre chaque Jour ouvré de sa première à sa dernière date (sinon
+    `UsineErreur`) ; à sa première date, la veille est vide (début de l'historique).
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    dates = _verifier_dates(etats)
+    if not dates:
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    anomalies = _anomalies(etats)
+    comptes = _comptes(etats, anomalies, entites)
+    valeurs = pl.concat(
+        [comptes, _fenetres(comptes, dates), _ages(anomalies, entites)], how="vertical"
+    )
+    table = (
+        _squelette(dates, entites)
+        .join(valeurs, on=_CLES, how="left")
+        .with_columns(
+            pl.col("numerateur").fill_null(0),
+            pl.when(pl.col("sans_objet"))
+            .then(pl.col("denominateur").fill_null(0))
+            .otherwise(pl.lit(1, dtype=pl.Int64))
+            .alias("denominateur"),
+        )
+        .sort("date", "rang_perimetre", "rang_code", "rang_dimension")
+        .select(list(SCHEMA_KPI.colonnes))
+    )
+    return valider(table, SCHEMA_KPI)
