+def test_conservation_stock(kpi_generes: pl.DataFrame) -> None:
+    programme = kpi_generes.filter(
+        (pl.col("perimetre") == PERIMETRE_PROGRAMME) & (pl.col("dimension") == "")
+    )
+    par_code = {
+        code: programme.filter(pl.col("code_kpi") == code)["numerateur"].to_list()
+        for code in ("anomalies_ouvertes", "entrees_jour", "sorties_jour")
+    }
+    stocks, entrees, sorties = par_code.values()
+    assert sum(entrees) > 0
+    assert stocks[0] == entrees[0] - sorties[0]
+    for i in range(1, len(stocks)):
+        assert stocks[i] - stocks[i - 1] == entrees[i] - sorties[i]
+    assert min(sorties) >= 0
