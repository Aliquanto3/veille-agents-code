@@ -0,0 +1,352 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11, AD-10)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, Phase, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import Generation, generer
+
+RACINE = Path(__file__).resolve().parents[3]
+
+ENTITES = ["ENT-A", "ENT-B"]
+JEUDI = date(2026, 10, 1)
+VENDREDI = date(2026, 10, 2)
+LUNDI = date(2026, 10, 5)
+MARDI = date(2026, 10, 6)
+MERCREDI = date(2026, 10, 7)
+
+_CODES_SANS_OBJET = {
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+}
+
+
+def _ts(jour: date, heure: int) -> datetime:
+    return datetime(jour.year, jour.month, jour.day, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, dates: list[date], entites: list[str] = ENTITES) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, dates), entites)
+
+
+def _valeur(
+    table: pl.DataFrame, d: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == d)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne["numerateur"][0], ligne["denominateur"][0]
+
+
+def _cas_de_test(flux: Flux, cle: str, statut: str, entite: str = "ENT-A") -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(LUNDI, 9),
+        {Champ.statut_test: statut, Champ.entite: entite, Champ.phase: "recette"},
+    )
+
+
+def test_catalogue() -> None:
+    assert len(CODES_KPI) == 12
+    assert tuple(DIMENSIONS_KPI) == CODES_KPI
+    assert DIMENSIONS_KPI["taux_ko_cas_de_test"] == tuple(p.value for p in Phase)
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    flux.anomalie("DEMO-2", _ts(LUNDI, 10))
+    flux.anomalie("DEMO-3", _ts(LUNDI, 11), entite="ENT-B", gravite="majeure")
+    flux.transition("DEMO-3", _ts(LUNDI, 12), "nouvelle", "fermee")
+    table = _kpi(flux, [LUNDI])
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _valeur(table, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    gravite = "anomalies_ouvertes_gravite"
+    assert _valeur(table, LUNDI, PERIMETRE_PROGRAMME, gravite, "bloquante") == (2, 1)
+    assert _valeur(table, LUNDI, PERIMETRE_PROGRAMME, gravite, "majeure") == (0, 1)
+    assert _valeur(table, LUNDI, "ENT-B", gravite, "majeure") == (0, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    flux.transition("DEMO-1", _ts(MARDI, 9), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(MERCREDI, 9), "fermee", "nouvelle")
+    flux.transition("DEMO-1", _ts(MERCREDI, 10), "nouvelle", "fermee")
+    dates = [LUNDI, MARDI, MERCREDI]
+    table = _kpi(flux, dates)
+    for perimetre in ("ENT-A", PERIMETRE_PROGRAMME):
+        assert [_valeur(table, d, perimetre, "entrees_jour") for d in dates] == [
+            (1, 1),
+            (0, 1),
+            (1, 1),
+        ]
+        assert [_valeur(table, d, perimetre, "sorties_jour") for d in dates] == [
