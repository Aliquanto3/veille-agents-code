+def test_programme_somme_des_entites(kpi_generes: pl.DataFrame) -> None:
+    comptes = kpi_generes.filter(~pl.col("code_kpi").is_in(list(_CODES_SANS_OBJET)))
+    cles = ["date", "code_kpi", "dimension"]
+    entites = (
+        comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by(cles)
+        .agg(pl.col("numerateur").sum())
+        .sort(cles)
+    )
+    programme = (
+        comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME)
+        .select(*cles, "numerateur")
+        .sort(cles)
+    )
+    assert entites.equals(programme)
+    taux = kpi_generes.filter(pl.col("code_kpi").str.starts_with("taux_"))
+    sommes = (
+        taux.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by(cles)
+        .agg(pl.col("numerateur").sum(), pl.col("denominateur").sum())
+    )
+    attendu = taux.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME).select(
+        [*cles, "numerateur", "denominateur"]
+    )
+    assert sommes.sort(cles).equals(attendu.sort(cles))
+
