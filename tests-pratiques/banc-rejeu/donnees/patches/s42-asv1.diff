+def test_entrees_invalides() -> None:
+    grille = _grille()
+    standard = _standard()
+    with pytest.raises(UsineErreur, match=ENTITE):
+        risques_entree_rouge(standard, _meteo(Couleur.rouge), grille)
+
+    sans_d = _table(
+        _lignes(IND_1, _entiers(SERIE_IND_1), fin=date(2026, 10, 8))
+        + _lignes(IND_3, _entiers(SERIE_IND_3))
+        + _lignes(IND_4, SERIE_IND_4)
+    )
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*absente"):
+        risques_entree_rouge(sans_d, _meteo(), grille)
+
+    lignes = _lignes(IND_1, _entiers(SERIE_IND_1))
+    autres = _lignes(IND_3, _entiers(SERIE_IND_3)) + _lignes(IND_4, SERIE_IND_4)
+    trou = _table(lignes[:4] + lignes[5:] + autres)
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*trou"):
+        risques_entree_rouge(trou, _meteo(), grille)
+
+    double = _table([*lignes, lignes[-1], *autres])
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*double"):
+        risques_entree_rouge(double, _meteo(), grille)
+
+    non_ouvre = _lignes(IND_1, _entiers(SERIE_IND_1))
+    non_ouvre[0] = {**non_ouvre[0], "date": date(2026, 9, 26)}
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*Jour ouvré"):
+        risques_entree_rouge(_table(non_ouvre + autres), _meteo(), grille)
+
+    denominateur_nul = _lignes(IND_1, _entiers(SERIE_IND_1))
+    denominateur_nul[4] = {**denominateur_nul[4], "denominateur": 0}
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*dénominateur"):
+        risques_entree_rouge(_table(denominateur_nul + autres), _meteo(), grille)
+
