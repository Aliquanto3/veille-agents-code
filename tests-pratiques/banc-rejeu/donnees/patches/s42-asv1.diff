@@ -0,0 +1,200 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Elle
+lit la table des indicateurs (`SCHEMA_INDICATEUR`) et la `MeteoEntite` non rouge d'une Entité
+à la Date d'arrêté D :
+
+- régression linéaire (moindres carrés) sur les `fenetre` derniers Jours ouvrés d'IND-1, IND-3
+  et IND-4 finissant à D (au moins 2 points) ;
+- projection de 1 à `horizon` Jours ouvrés après D ; le premier horizon où la règle rouge de la
+  Grille se déclenche donne un `RisqueEntreeRouge`, avec la valeur projetée ;
+- les indicateurs écartés (inactif ou sans seuil rouge, non évaluable sur la fenêtre,
+  historique insuffisant) sont restitués avec leur motif.
+
+La vélocité nette de la Baseline n'est pas réutilisée ; les primitives partagées (avance en
+Jours ouvrés, test de seuil) vivent dans `commun` (AD-18).
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+from typing import Any
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+INDICATEURS_PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque d'entrée en rouge : paramètre {nom} invalide {valeur!r}"
+                    " (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée à la date de franchissement estimée."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D sont
+    lues, et elles doivent former des Jours ouvrés consécutifs finissant à D pour chaque
+    indicateur actif. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la
+    table est invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, Entité non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in CodeIndicateur:
+        if code not in INDICATEURS_PROJETES:
+            continue
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active or Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, "indicateur inactif ou sans seuil rouge actif"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        lignes = _lignes(table, meteo, code)[-parametres.fenetre :]
+        for ligne in lignes:
+            if ligne["statut"] == StatutIndicateur.non_evaluable:
+                exclus.append(
+                    IndicateurExclu(
+                        code,
+                        f"non évaluable le {ligne['date'].isoformat()} : {ligne['motif']}",
+                    )
+                )
+                break
+        else:
+            if len(lignes) < 2:
+                exclus.append(IndicateurExclu(code, "historique insuffisant"))
+                continue
+            valeurs = [_valeur(entite, code, ligne) for ligne in lignes]
+            n = len(valeurs)
+            pente, ordonnee = _regression(valeurs)
+            for h in range(1, parametres.horizon + 1):
+                projetee = ordonnee + pente * (n - 1 + h)
+                if declenche(projetee, operateur, seuil):
+                    courante = valeurs[-1]
+                    risques.append(
+                        RisqueProjete(
+                            risque=RisqueEntreeRouge(
+                                date_arrete=meteo.date_arrete,
+                                entite=entite,
+                                indicateur=code,
+                                date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                                horizon_jours_ouvres=parametres.horizon,
+                                numerateur=courante.numerator,
+                                denominateur=courante.denominator,
+                                seuil_numerateur=seuil.numerator,
+                                seuil_denominateur=seuil.denominator,
+                                version_grille=meteo.version_grille,
+                            ),
+                            valeur_projetee=projetee,
+                        )
+                    )
+                    break
+    return ResultatRisque(risques=tuple(risques), exclus=tuple(exclus))
+
+
+def _lignes(table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur) -> list[dict[str, Any]]:
+    """Lignes de l'Entité et de l'indicateur jusqu'à D, contrôlées et dans l'ordre."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = (
+        table.filter(
+            (pl.col("entite") == entite) & (pl.col("code") == code) & (pl.col("date") <= arrete)
+        )
+        .sort("date")
+        .to_dicts()
+    )
+    precedent: date | None = None
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} : {code} {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if precedent == jour:
+            raise UsineErreur(f"Risque {entite} : {code} date {jour.isoformat()} en double")
+        if precedent is not None and jour_ouvre_suivant(precedent) != jour:
+            raise UsineErreur(
+                f"Risque {entite} : {code} trou de Jours ouvrés entre"
+                f" {precedent.isoformat()} et {jour.isoformat()}"
+            )
+        precedent = jour
+    if precedent != arrete:
+        raise UsineErreur(
+            f"Risque {entite} : Date d'arrêté {arrete.isoformat()} absente pour {code}"
+        )
+    return lignes
+
+
+def _valeur(entite: str, code: CodeIndicateur, ligne: dict[str, Any]) -> Fraction:
+    if ligne["denominateur"] <= 0:
+        raise UsineErreur(
+            f"Risque {entite} : {code} {ligne['date'].isoformat()} évalué avec un dénominateur"
+            f" {ligne['denominateur']}"
+        )
+    return Fraction(ligne["numerateur"], ligne["denominateur"])
+
+
+def _regression(valeurs: list[Fraction]) -> tuple[Fraction, Fraction]:
+    """Pente et ordonnée à l'origine des moindres carrés de `valeurs` en x = 0..n−1 (n ≥ 2)."""
+    n = len(valeurs)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(valeurs, Fraction(0)) / n
+    sxx = sum(((x - x_moyen) ** 2 for x in range(n)), Fraction(0))
+    sxy = sum(((x - x_moyen) * (y - y_moyen) for x, y in enumerate(valeurs)), Fraction(0))
+    pente = sxy / sxx
+    return pente, y_moyen - pente * x_moyen
