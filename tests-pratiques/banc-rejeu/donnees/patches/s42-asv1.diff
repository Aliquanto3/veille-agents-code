@@ -0,0 +1,346 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. 10 Jours ouvrés finissant au vendredi 09/10/2026 (D),
+x = 0..9, projection à x = 9 + h :
+
+- IND-3 = 10..19 : pente 1, ordonnée 10 → p(1) = 20 ≥ 20 : franchissement à D + 1 JO ;
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : pente 41/165, ordonnée −23/55 → p(4) = 464/165 < 3,
+  p(5) = 101/33 ≥ 3 : franchissement à D + 5 JO ;
+- IND-4 = 5/100..14/100 : pente 1/100, ordonnée 5/100 → p(5) = 19/100 < 1/5 : aucun risque.
+"""
+
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+CHEMIN_GRILLE = RACINE / "config" / "grille_meteo.yaml"
+D = date(2026, 10, 9)
+ENTITE = "ENT-A"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+SERIE_IND_1 = [0, 0, 0, 0, 0, 1, 1, 1, 2, 2]
+SERIE_IND_3 = list(range(10, 20))
+SERIE_IND_4 = [(k, 100) for k in range(5, 15)]
+CONSTANTE = [(1, 100)] * 10
+
+
+def _entiers(valeurs: list[int]) -> list[tuple[int, int]]:
+    return [(v, 1) for v in valeurs]
+
+
+def _lignes(
+    code: CodeIndicateur,
+    valeurs: list[tuple[int, int]],
+    fin: date = D,
+    entite: str = ENTITE,
+    non_evaluable: dict[int, str] | None = None,
+) -> list[dict[str, Any]]:
+    dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+    lignes: list[dict[str, Any]] = []
+    for i, (jour, (num, den)) in enumerate(zip(dates, valeurs, strict=True)):
+        motif = (non_evaluable or {}).get(i)
+        lignes.append(
+            {
+                "date": jour,
+                "entite": entite,
+                "code": code,
+                "statut": StatutIndicateur.non_evaluable if motif else StatutIndicateur.evalue,
+                "motif": motif or "",
+                "numerateur": 0 if motif else num,
+                "denominateur": 0 if motif else den,
+                "couleur": Couleur.vert,
+            }
+        )
+    return lignes
+
+
+def _table(lignes: list[dict[str, Any]]) -> pl.DataFrame:
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _standard(
+    ind_1: list[int] = SERIE_IND_1,
+    ind_3: list[int] | None = None,
+    ind_4: list[tuple[int, int]] = SERIE_IND_4,
+) -> pl.DataFrame:
+    """Table de référence : IND-3 constant à 1 sauf indication."""
+    return _table(
+        _lignes(IND_1, _entiers(ind_1))
+        + _lignes(IND_3, _entiers(ind_3 if ind_3 is not None else [1] * 10))
+        + _lignes(IND_4, ind_4)
+    )
+
+
+def _regle_non_projetee(couleur: Couleur) -> RegleDeclenchante:
+    """Règle IND-5 déclenchée (non projetée) : justifie une Météo non verte."""
+    return RegleDeclenchante(
+        code=CodeIndicateur.ind_5,
+        couleur=couleur,
+        operateur=Operateur.superieur_ou_egal,
+        numerateur=1,
+        denominateur=1,
+        seuil_numerateur=1,
+        seuil_denominateur=1,
+        tickets_en_cause=(),
+    )
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(_regle_non_projetee(couleur),),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _grille(**modifs: Any) -> GrilleMeteo:
+    donnees: dict[str, Any] = yaml.safe_load(CHEMIN_GRILLE.read_text(encoding="utf-8"))
+    donnees["indicateurs"].update(modifs)
+    return GrilleMeteo.model_validate(donnees)
+
+
+def _codes(resultat: ResultatRisque) -> list[CodeIndicateur]:
+    return [r.risque.indicateur for r in resultat.risques]
+
+
+def test_franchissement_ind_3() -> None:
+    table = _standard(ind_1=[1] * 10, ind_3=SERIE_IND_3)
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert _codes(resultat) == [IND_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    risque_ = projete.risque
+    assert risque_.date_franchissement_estimee == date(2026, 10, 12)
+    assert (risque_.numerateur, risque_.denominateur) == (19, 1)
+    assert (risque_.seuil_numerateur, risque_.seuil_denominateur) == (20, 1)
+    assert (risque_.date_arrete, risque_.entite) == (D, ENTITE)
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = risques_entree_rouge(_standard(), _meteo(), _grille())
+
+    assert _codes(resultat) == [IND_1]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_regression_exacte() -> None:
+    pente, ordonnee = risque._regression([Fraction(v) for v in SERIE_IND_1])
+
+    assert (pente, ordonnee) == (Fraction(41, 165), Fraction(-23, 55))
+    assert ordonnee + pente * 13 == Fraction(464, 165)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = risques_entree_rouge(_standard(), _meteo(), _grille())
+
+    assert IND_4 not in _codes(resultat)
+    assert resultat.exclus == ()
+
+
+def test_stable_ou_en_baisse() -> None:
+    table = _table(
+        _lignes(IND_1, _entiers([2] * 10))
+        + _lignes(IND_3, _entiers(list(range(19, 9, -1))))
+        + _lignes(IND_4, [(20 - k, 100) for k in range(10)])
+    )
+
+    assert risques_entree_rouge(table, _meteo(), _grille()) == ResultatRisque((), ())
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    table = _table(
+        _lignes(IND_1, _entiers(SERIE_IND_1))
+        + _lignes(IND_3, _entiers(SERIE_IND_3))
+        + _lignes(IND_4, SERIE_IND_4, non_evaluable={3: "tests exécutés insuffisants"})
+    )
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert _codes(resultat) == [IND_1, IND_3]
+    (exclu,) = resultat.exclus
+    assert exclu.code is IND_4
+    assert jours_ouvres(date(2026, 1, 1), D)[-7].isoformat() in exclu.motif
+    assert "tests exécutés insuffisants" in exclu.motif
+
+
+def test_historique_court() -> None:
+    un_seul = _table(
+        _lignes(IND_1, _entiers(SERIE_IND_1))
+        + _lignes(IND_3, _entiers([5]))
+        + _lignes(IND_4, SERIE_IND_4)
+    )
+    resultat = risques_entree_rouge(un_seul, _meteo(), _grille())
+    assert resultat.exclus == (IndicateurExclu(IND_3, "historique insuffisant"),)
+    assert _codes(resultat) == [IND_1]
+
+    trois = _table(
+        _lignes(IND_1, _entiers([0, 1, 2]))
+        + _lignes(IND_3, _entiers([1] * 3))
+        + _lignes(IND_4, CONSTANTE[:3])
+    )
+    resultat = risques_entree_rouge(trois, _meteo(), _grille())
+    # pente 1, ordonnée 0 : p(h) = 2 + h → 3 dès h = 1
+    assert _codes(resultat) == [IND_1]
+    assert resultat.risques[0].valeur_projetee == Fraction(3)
+    assert resultat.risques[0].risque.date_franchissement_estimee == date(2026, 10, 12)
+    assert resultat.exclus == ()
+
+
+def test_fenetre_limitee_aux_derniers_jours() -> None:
+    # 5 JO anciens à 100 puis 10 JO récents constants : la fenêtre ne voit que les 10 récents
+    table = _table(
+        _lignes(IND_1, _entiers([0] * 15))
+        + _lignes(IND_3, _entiers([100] * 5 + [1] * 10))
+        + _lignes(IND_4, CONSTANTE * 2)
+    )
+
+    assert risques_entree_rouge(table, _meteo(), _grille()).risques == ()
