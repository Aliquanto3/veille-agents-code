+    [
+        {"libelle": "x", "active": False, "seuils": {"rouge": ">= 20"}},
+        {"libelle": "x", "active": True, "seuils": {"jaune": ">= 5"}},
+    ],
+)
+def test_indicateur_inactif_ou_sans_seuil_rouge(regle: dict[str, Any]) -> None:
+    # IND-3 absent de la table : prouve qu'elle n'est pas lue
+    table = _table(
+        _lignes(IND_1, _entiers(SERIE_IND_1)) + _lignes(IND_4, SERIE_IND_4),
+    )
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille(**{"IND-3": regle}))
