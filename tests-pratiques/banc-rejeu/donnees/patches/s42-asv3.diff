@@ -0,0 +1,336 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main sur 10 Jours ouvrés finissant à D (vendredi 09/10/2026),
+x = 0..9, projection à x = 9 + h :
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → D + 1 JO.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σy = 7, ȳ = 7/10, Σ(x − 9/2)(y − ȳ) = 41/2, Σ(x − 9/2)² = 165/2
+  → pente 41/165, ordonnée 7/10 − 41/165 · 9/2 = −23/55 ; p(4) = 464/165 < 3, p(5) = 101/33 ≥ 3.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5.
+"""
+
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-A"
+VERSION_GRILLE = "grille-test"
+MOTIF = "moins de 20 Cas de test exécutés"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Valeur = tuple[int, int] | None
+"""`(numérateur, dénominateur)` d'une valeur évaluée ; `None` : non évaluable (0/0, motif)."""
+
+STABLES: dict[CodeIndicateur, list[Valeur]] = {
+    IND_1: [(1, 1)] * 10,
+    IND_3: [(5, 1)] * 10,
+    IND_4: [(1, 10)] * 10,
+}
+
+
+def _lignes(
+    code: CodeIndicateur,
+    valeurs: list[Valeur],
+    fin: date = D,
+    entite: str = ENTITE,
+) -> list[dict[str, Any]]:
+    dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+    return [
+        {
+            "date": jour,
+            "entite": entite,
+            "code": code,
+            "statut": "evalue" if valeur else "non_evaluable",
+            "motif": "" if valeur else MOTIF,
+            "numerateur": valeur[0] if valeur else 0,
+            "denominateur": valeur[1] if valeur else 0,
+            "couleur": "vert",
+        }
+        for jour, valeur in zip(dates, valeurs, strict=True)
+    ]
+
+
+def _table(lignes: list[dict[str, Any]]) -> pl.DataFrame:
+    return valider(
+        pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR
+    )
+
+
+def _series(**remplacements: list[Valeur]) -> pl.DataFrame:
+    """Séries stables d'IND-1, IND-3, IND-4, remplacées par code (`ind_1`, `ind_3`, `ind_4`)."""
+    series = {IND_1: STABLES[IND_1], IND_3: STABLES[IND_3], IND_4: STABLES[IND_4]}
+    for nom, valeurs in remplacements.items():
+        series[CodeIndicateur(f"IND-{nom[-1]}")] = valeurs
+    return _table([ligne for code, valeurs in series.items() for ligne in _lignes(code, valeurs)])
+
+
+def _entiers(valeurs: list[int]) -> list[Valeur]:
+    return [(v, 1) for v in valeurs]
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(
+            RegleDeclenchante(
+                code=CodeIndicateur.ind_5,
+                couleur=couleur,
+                operateur=Operateur.superieur_ou_egal,
+                numerateur=1,
+                denominateur=1,
+                seuil_numerateur=1,
+                seuil_denominateur=1,
+                tickets_en_cause=(),
+            ),
+        ),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _grille(**regles: dict[str, Any]) -> GrilleMeteo:
+    """Grille livrée, règles remplacées ou ajustées par code (`ind_3`, …)."""
+    donnees: dict[str, Any] = yaml.safe_load(
+        (RACINE / "config" / "grille_meteo.yaml").read_text(encoding="utf-8")
+    )
+    for nom, ajustement in regles.items():
+        donnees["indicateurs"][f"IND-{nom[-1]}"].update(ajustement)
+    return GrilleMeteo.model_validate(donnees)
+
+
+def _calculer(table: pl.DataFrame, **kw: Any) -> ResultatRisque:
+    return risques_entree_rouge(table, _meteo(), _grille(), **kw)
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = _calculer(_series(ind_3=_entiers(list(range(10, 20)))))
+
+    assert resultat.exclus == ()
+    assert len(resultat.risques) == 1
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.indicateur is IND_3
+    assert r.entite == ENTITE
+    assert r.date_arrete == D
+    assert r.date_franchissement_estimee == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert r.horizon_jours_ouvres == 5
+    assert r.version_grille == VERSION_GRILLE
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    assert risque._regression([Fraction(v) for v in [0, 0, 0, 0, 0, 1, 1, 1, 2, 2]]) == (
+        Fraction(41, 165),
+        Fraction(-23, 55),
+    )
+
+    resultat = _calculer(_series(ind_1=_entiers([0, 0, 0, 0, 0, 1, 1, 1, 2, 2])))
+
+    assert len(resultat.risques) == 1
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.indicateur is IND_1
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert Fraction(-23, 55) + Fraction(41, 165) * 13 == Fraction(464, 165)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = _calculer(_series(ind_4=[(v, 100) for v in range(5, 15)]))
+
+    assert resultat == ResultatRisque((), ())
+
+
+def test_stable_ou_en_baisse() -> None:
+    assert _calculer(_series()) == ResultatRisque((), ())
+    baisse = _series(
+        ind_1=_entiers(list(range(10, 0, -1))),
+        ind_3=_entiers(list(range(19, 9, -1))),
+        ind_4=[(v, 100) for v in range(14, 4, -1)],
+    )
+    assert _calculer(baisse) == ResultatRisque((), ())
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    ind_4: list[Valeur] = [(5, 100)] * 3 + [None] + [(5, 100)] * 6
+    resultat = _calculer(_series(ind_3=_entiers(list(range(10, 20))), ind_4=ind_4))
+
+    premiere = jours_ouvres(date(2026, 1, 1), D)[-10:][3]
+    assert resultat.exclus == (
+        IndicateurExclu(IND_4, f"IND-4 non évaluable le {premiere.isoformat()} : {MOTIF}"),
+    )
+    assert [p.risque.indicateur for p in resultat.risques] == [IND_3]
+
+
+def test_historique_court() -> None:
+    un_jour = _series(ind_3=_entiers([19]))
+    resultat = _calculer(un_jour)
+    assert resultat.risques == ()
+    assert resultat.exclus == (IndicateurExclu(IND_3, "IND-3 : historique insuffisant"),)
+
+    trois = _calculer(_series(ind_3=_entiers([17, 18, 19])))
+    assert trois.exclus == ()
+    assert [p.valeur_projetee for p in trois.risques] == [Fraction(20)]
+    assert trois.risques[0].risque.date_franchissement_estimee == date(2026, 10, 12)
+
+
+def test_fenetre_limitee_aux_derniers_jours() -> None:
+    longue = _entiers([100] * 5 + list(range(10, 20)))
+
+    assert [p.risque.indicateur for p in _calculer(_series(ind_3=longue)).risques] == [IND_3]
+
+
+def test_indicateur_inactif_ou_sans_seuil_rouge() -> None:
+    donnees: dict[str, Any] = yaml.safe_load(
+        (RACINE / "config" / "grille_meteo.yaml").read_text(encoding="utf-8")
+    )
+    seuils = dict(donnees["indicateurs"]["IND-4"]["seuils"])
+    del seuils["rouge"]
+    grille = _grille(ind_3={"active": False}, ind_4={"seuils": seuils})
+    # IND-3 inactif et IND-4 sans seuil rouge : leurs lignes ne sont pas lues (D absente de IND-3).
+    lignes = _lignes(IND_1, STABLES[IND_1]) + _lignes(IND_3, _entiers([19]), D.replace(day=2))
+    table = _table(lignes)
+
+    resultat = risques_entree_rouge(table, _meteo(), grille)
+
+    assert resultat.risques == ()
+    assert [e.code for e in resultat.exclus] == [IND_3, IND_4]
+    assert all(e.motif for e in resultat.exclus)
+
