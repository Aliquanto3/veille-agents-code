+def test_trou_date_non_ouvree_et_doublon() -> None:
+    base = _lignes(IND_3, _entiers(list(range(10, 20))))
+    autres = _lignes(IND_1, STABLES[IND_1]) + _lignes(IND_4, STABLES[IND_4])
+
+    trou = base[:4] + base[5:]
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*trou"):
+        _calculer(_table(autres + trou))
+
+    samedi = [{**base[4], "date": date(2026, 10, 3)}]
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*Jour ouvré"):
+        _calculer(_table(autres + base[:4] + samedi + base[5:]))
+
+    with pytest.raises(UsineErreur, match=f"{ENTITE}.*double"):
+        _calculer(_table(autres + base + [base[-1]]))
+
