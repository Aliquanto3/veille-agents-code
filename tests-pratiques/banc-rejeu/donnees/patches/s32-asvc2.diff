+++ b/src/usine/domaine/kpi.py
@@ -0,0 +1,312 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : l'état des tickets (`SCHEMA_TICKET_ETAT`, détail de l'Instantané) et les Entités
+arrivent en paramètre. La table doit couvrir chaque Jour ouvré de sa première à sa dernière
+date ; à la première date, la veille est vide (début de l'historique). Définitions du Glossaire
+(H-17) : Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée = création ou réouverture
+(`date_derniere_entree`) ; Sortie = passage à Fermée ou Rejetée. Fenêtre glissante : H-19.
+
+Sortie dense au `SCHEMA_KPI` : une ligne par date, périmètre, code et dimension, zéro explicite.
+Tout est entier : un taux est porté par `numerateur` et `denominateur`, `0/0` = pas de valeur.
+"""
+
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import (
+    est_jour_ouvre,
+    fenetre_glissante,
+    jour_ouvre_precedent,
+    jours_ouvres,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des KPI, dans l'ordre de la sortie (`code_kpi` est un texte libre, D10)."""
+
+_SANS_DIMENSION: tuple[str, ...] = ("",)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {code: _SANS_DIMENSION for code in CODES_KPI}
+    | {
+        "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+        "anomalies_ouvertes_phase": tuple(p.value for p in Phase),
+        "taux_ko_cas_de_test": tuple(p.value for p in Phase),
+        "taux_non_execution_cas_de_test": tuple(p.value for p in Phase),
+        "certifications": tuple(s.value for s in StatutCertification),
+    }
+)
+"""Dimensions de chaque code, dans l'ordre des énumérations ; `("",)` si non ventilé."""
+
+_SANS_VALEUR = frozenset({"age_median_anomalies_ouvertes", "age_max_anomalies_ouvertes"}) | {
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+}
+"""Codes dont la valeur par défaut est `0/0` ; les autres sont des comptes, `0/1`."""
+
+_FERMES = [statut.value for statut in STATUTS_FERMES]
+_CLES = ["date", "perimetre", "code_kpi", "dimension"]
+_COLONNES_MESURE = ["numerateur", "denominateur"]
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(f"Entité {PERIMETRE_PROGRAMME} réservée au Programme : refusée")
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Dates présentes = Jours ouvrés contigus de la première à la dernière."""
+    presentes = sorted(set(dates))
+    for jour in presentes:
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(f"{jour.isoformat()} n'est pas un Jour ouvré")
+    manquantes = [j for j in jours_ouvres(presentes[0], presentes[-1]) if j not in set(presentes)]
+    if manquantes:
+        raise UsineErreur(
+            "état des tickets non calculé à chaque Jour ouvré, date(s) manquante(s) : "
+            + ", ".join(jour.isoformat() for jour in manquantes)
+        )
+
+
+def _mesure(
+    table: pl.DataFrame, code: str, numerateur: pl.Expr, denominateur: pl.Expr, dimension: pl.Expr
+) -> pl.DataFrame:
+    return table.select(
+        "date",
+        "perimetre",
+        pl.lit(code).alias("code_kpi"),
+        dimension.cast(pl.Utf8).alias("dimension"),
+        numerateur.cast(pl.Int64).alias("numerateur"),
+        denominateur.cast(pl.Int64).alias("denominateur"),
+    )
+
+
+def _mouvements(anomalies: pl.DataFrame, dates: Sequence[date]) -> pl.DataFrame:
+    """Entrées et Sorties de chaque ticket et jour : `E = 1` si Entrée en D, `S = E − δ`."""
+    veilles = pl.DataFrame(
+        {
+            "date": sorted(set(dates)),
+            "veille": [jour_ouvre_precedent(jour) for jour in sorted(set(dates))],
+        },
+        schema={"date": pl.Date(), "veille": pl.Date()},
+    )
+    precedent = anomalies.select(
+        pl.col("date").alias("veille"),
+        "cle_ticket",
+        pl.col("ouvert").alias("ouvert_veille"),
+    )
+    return (
+        anomalies.join(veilles, on="date", how="left")
+        .join(precedent, on=["veille", "cle_ticket"], how="left")
+        .with_columns(
+            (pl.col("date_derniere_entree") == pl.col("date")).cast(pl.Int64).alias("entree"),
+            (
+                pl.col("ouvert").cast(pl.Int64)
+                - pl.col("ouvert_veille").fill_null(False).cast(pl.Int64)
+            ).alias("delta"),
+        )
+        .with_columns((pl.col("entree") - pl.col("delta")).alias("sortie"))
+    )
+
+
+def _fenetres(jours: pl.DataFrame, dates: Sequence[date]) -> pl.DataFrame:
+    """Somme des Entrées et Sorties des jours de la Fenêtre glissante finissant en D."""
+    paires = pl.DataFrame(
+        [(jour, membre) for jour in sorted(set(dates)) for membre in fenetre_glissante(jour)],
+        schema={"date": pl.Date(), "membre": pl.Date()},
+        orient="row",
+    )
+    return (
+        paires.join(jours.rename({"date": "membre"}), on="membre", how="inner")
+        .group_by(["date", "perimetre"])
+        .agg(pl.col("entrees").sum(), pl.col("sorties").sum())
+    )
+
+
+def _ages(ouvertes: pl.DataFrame) -> pl.DataFrame:
+    """Âge médian (`Fraction` réduite) et maximum des Anomalies ouvertes, par date et périmètre."""
+    if ouvertes.filter(pl.col("date_derniere_entree").is_null()).height:
+        cle = ouvertes.filter(pl.col("date_derniere_entree").is_null()).item(0, "cle_ticket")
+        raise UsineErreur(f"Anomalie ouverte {cle} sans date de dernière Entrée")
+    paires = ouvertes.select("date_derniere_entree", "date").unique().iter_rows()
+    ages = {(entree, jour): len(jours_ouvres(entree, jour)) - 1 for entree, jour in paires}
+    lignes: list[tuple[date, str, str, int, int]] = []
+    groupes = ouvertes.group_by(["date", "perimetre"]).agg(pl.col("date_derniere_entree"))
+    for jour, perimetre, entrees in groupes.iter_rows():
+        valeurs = sorted(ages[(entree, jour)] for entree in entrees)
+        milieu = len(valeurs) // 2
+        if len(valeurs) % 2:
+            mediane = Fraction(valeurs[milieu])
+        else:
+            mediane = Fraction(valeurs[milieu - 1] + valeurs[milieu], 2)
+        code = "age_median_anomalies_ouvertes"
+        lignes.append((jour, perimetre, code, mediane.numerator, mediane.denominator))
+        lignes.append((jour, perimetre, "age_max_anomalies_ouvertes", valeurs[-1], 1))
+    return pl.DataFrame(
+        lignes,
+        schema={
+            "date": pl.Date(),
+            "perimetre": pl.Utf8(),
+            "code_kpi": pl.Utf8(),
+            "numerateur": pl.Int64(),
+            "denominateur": pl.Int64(),
+        },
+        orient="row",
+    ).with_columns(pl.lit("").alias("dimension"))
+
+
+def _squelette(dates: Sequence[date], perimetres: Sequence[str]) -> pl.DataFrame:
+    """Toutes les lignes attendues, avec leurs rangs de tri et le dénominateur par défaut."""
+    lignes = [
+        (jour, perimetre, rang_p, code, rang_c, dimension, rang_d, 0 if code in _SANS_VALEUR else 1)
+        for jour in sorted(set(dates))
+        for (rang_p, perimetre) in enumerate(perimetres)
+        for rang_c, code in enumerate(CODES_KPI)
+        for rang_d, dimension in enumerate(DIMENSIONS_KPI[code])
+    ]
+    return pl.DataFrame(
+        lignes,
+        schema={
+            "date": pl.Date(),
+            "perimetre": pl.Utf8(),
+            "rang_p": pl.Int64(),
+            "code_kpi": pl.Utf8(),
+            "rang_c": pl.Int64(),
+            "dimension": pl.Utf8(),
+            "rang_d": pl.Int64(),
+            "den_defaut": pl.Int64(),
+        },
+        orient="row",
+    )
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """KPI de chaque Jour ouvré de `tickets_etats`, par Entité de `entites` et pour le Programme.
+
+    Le Programme agrège toutes les lignes, y compris celles d'Entités hors de `entites`. Une
+    Anomalie sans Gravité ou sans Phase, un Cas de test sans Phase compte dans les totaux mais
+    dans aucune ventilation. Lignes triées par date, périmètre (ordre de `entites`, puis
+    Programme), code (ordre de `CODES_KPI`) et dimension (ordre des énumérations).
+    """
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    _verifier_entites(entites)
+    if etats.height == 0:
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = etats.get_column("date").to_list()
+    _verifier_dates(dates)
+
+    etats = etats.with_columns(
+        (
+            (pl.col("type_ticket") == TypeTicket.anomalie.value)
+            & pl.col("statut").is_not_null()
+            & ~pl.col("statut").cast(pl.Utf8).is_in(_FERMES)
+        ).alias("ouvert")
+    )
+    est_anomalie = pl.col("type_ticket") == TypeTicket.anomalie.value
+    anomalies = _mouvements(etats.filter(est_anomalie), dates)
+    etats = etats.join(
+        anomalies.select("date", "cle_ticket", "entree", "sortie"),
+        on=["date", "cle_ticket"],
+        how="left",
+    ).with_columns(pl.col("entree").fill_null(0), pl.col("sortie").fill_null(0))
+
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    lignes = pl.concat(
+        [
+            etats.filter(pl.col("entite").is_in(list(entites))).with_columns(
+                pl.col("entite").alias("perimetre")
+            ),
+            etats.with_columns(pl.lit(PERIMETRE_PROGRAMME).alias("perimetre")),
+        ]
+    )
+    groupe = ["date", "perimetre"]
+    ouvertes = lignes.filter(pl.col("ouvert"))
+    tests = lignes.filter(
+        (pl.col("type_ticket") == TypeTicket.cas_de_test.value)
+        & pl.col("phase").is_not_null()
+        & pl.col("statut_test").is_not_null()
+    )
+    jours = lignes.group_by(groupe).agg(
+        pl.col("entree").sum().alias("entrees"), pl.col("sortie").sum().alias("sorties")
+    )
+    fenetres = _fenetres(jours, dates)
+    un = pl.lit(1)
+    sans = pl.lit("")
+
+    def comptes(table: pl.DataFrame, code: str, colonne: str) -> pl.DataFrame:
+        agrege = table.filter(pl.col(colonne).is_not_null()).group_by([*groupe, colonne]).len()
+        return _mesure(agrege, code, pl.col("len"), un, pl.col(colonne))
+
+    ok = (pl.col("statut_test") == StatutTest.ok.value).sum()
+    ko = (pl.col("statut_test") == StatutTest.ko.value).sum()
+    non_execute = (pl.col("statut_test") == StatutTest.non_execute.value).sum()
+    taux = tests.group_by([*groupe, "phase"]).agg(
+        ko.alias("ko"), (ok + ko).alias("tenus"), non_execute.alias("ne"), pl.len().alias("total")
+    )
+    certifications = lignes.filter(
+        (pl.col("type_ticket") == TypeTicket.certification.value)
+        & pl.col("statut_certification").is_not_null()
+    )
+    mesures = pl.concat(
+        [
+            _mesure(ouvertes.group_by(groupe).len(), "anomalies_ouvertes", pl.col("len"), un, sans),
+            comptes(ouvertes, "anomalies_ouvertes_gravite", "gravite"),
+            comptes(ouvertes, "anomalies_ouvertes_phase", "phase"),
+            _mesure(jours, "entrees_jour", pl.col("entrees"), un, sans),
+            _mesure(jours, "sorties_jour", pl.col("sorties"), un, sans),
+            _mesure(fenetres, "entrees_fenetre", pl.col("entrees"), un, sans),
+            _mesure(fenetres, "sorties_fenetre", pl.col("sorties"), un, sans),
+            _ages(ouvertes).select(*_CLES[:2], "code_kpi", "dimension", *_COLONNES_MESURE),
+            _mesure(taux, "taux_ko_cas_de_test", pl.col("ko"), pl.col("tenus"), pl.col("phase")),
+            _mesure(
+                taux,
+                "taux_non_execution_cas_de_test",
+                pl.col("ne"),
+                pl.col("total"),
+                pl.col("phase"),
+            ),
+            comptes(certifications, "certifications", "statut_certification"),
+        ]
+    )
+    table = (
+        _squelette(dates, perimetres)
+        .join(mesures, on=_CLES, how="left")
+        .with_columns(
+            pl.col("numerateur").fill_null(0),
+            pl.col("denominateur").fill_null(pl.col("den_defaut")),
+        )
+        .sort(["date", "rang_p", "rang_c", "rang_d"])
+        .select(list(SCHEMA_KPI.colonnes))
+    )
+    return valider(table, SCHEMA_KPI)
