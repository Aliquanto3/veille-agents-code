@@ -0,0 +1,409 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main sur 10 Jours ouvrés finissant à D (x = 0..9, projection à
+x = 9 + h). Grille par défaut, rouge : IND-1 `>= 3`, IND-3 `>= 20`, IND-4 `>= 1/5`.
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → franchissement à D + 1.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σy = 7, ȳ = 7/10, x̄ = 9/2, Σ(x − x̄)² = 165/2, Σx·y = 52,
+  Σ(x − x̄)(y − ȳ) = 52 − 10·(9/2)·(7/10) = 41/2 → pente 41/165, ordonnée −23/55 ;
+  p(4) = 464/165 < 3, p(5) = 101/33 ≥ 3 → D + 5.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+import re
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import baseline, commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+CST_1 = [1] * 10
+CST_3 = [5] * 10
+CST_4 = [Fraction(1, 100)] * 10
+LIGNE_3 = [Fraction(v) for v in range(10, 20)]
+LIGNE_1 = [Fraction(v) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+LIGNE_4 = [Fraction(v, 100) for v in range(5, 15)]
+
+
+def _grille(**indicateurs: Any) -> GrilleMeteo:
+    donnees: dict[str, Any] = yaml.safe_load(
+        (RACINE / "config" / "grille_meteo.yaml").read_text(encoding="utf-8")
+    )
+    donnees["indicateurs"].update(indicateurs)
+    return GrilleMeteo.model_validate(donnees)
+
+
+def _meteo(couleur: Couleur = Couleur.orange, entite: str = ENTITE) -> MeteoEntite:
+    regles = (
+        ()
+        if couleur is Couleur.vert
+        else (
+            RegleDeclenchante(
+                code=IND_1,
+                couleur=couleur,
+                operateur=Operateur.superieur_ou_egal,
+                numerateur=1,
+                denominateur=1,
+                seuil_numerateur=1,
+                seuil_denominateur=1,
+                tickets_en_cause=(),
+            ),
+        )
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=entite,
+        couleur=couleur,
+        regles=regles,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _lignes(
+    code: CodeIndicateur,
+    valeurs: list[Fraction | None],
+    motif: str = "",
+    entite: str = ENTITE,
+    fin: date = D,
+) -> list[dict[str, Any]]:
+    """Lignes denses finissant à `fin` ; `None` = non évaluable (0/0, motif `motif`)."""
+    dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+    lignes: list[dict[str, Any]] = []
+    for jour, valeur in zip(dates, valeurs, strict=True):
+        evalue = valeur is not None
+        lignes.append(
+            {
+                "date": jour,
+                "entite": entite,
+                "code": code.value,
+                "statut": (StatutIndicateur.evalue if evalue else StatutIndicateur.non_evaluable),
+                "motif": "" if evalue else motif,
+                "numerateur": valeur.numerator if valeur is not None else 0,
+                "denominateur": valeur.denominator if valeur is not None else 0,
+                "couleur": Couleur.vert.value,
+            }
+        )
+    return lignes
+
+
+def _table(lignes: list[dict[str, Any]]) -> pl.DataFrame:
+    vide = pl.DataFrame(schema=SCHEMA_INDICATEUR.colonnes)
+    if not lignes:
+        return vide
+    return valider(pl.DataFrame(lignes, schema=SCHEMA_INDICATEUR.colonnes), SCHEMA_INDICATEUR)
+
+
+def _constantes() -> list[dict[str, Any]]:
+    return (
+        _lignes(IND_1, [Fraction(v) for v in CST_1])
+        + _lignes(IND_3, [Fraction(v) for v in CST_3])
+        + _lignes(IND_4, list(CST_4))
+    )
+
+
+def _sans(code: CodeIndicateur, lignes: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    return [ligne for ligne in lignes if ligne["code"] != code.value]
+
+
+def test_franchissement_ind_3() -> None:
+    lignes = _sans(IND_3, _constantes()) + _lignes(IND_3, list(LIGNE_3))
+
+    resultat = risques_entree_rouge(_table(lignes), _meteo(), _grille())
+
+    assert resultat.exclus == ()
+    assert len(resultat.risques) == 1
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    risque_ = projete.risque
+    assert risque_.indicateur is IND_3
+    assert risque_.date_franchissement_estimee == date(2026, 10, 12)
+    assert (risque_.numerateur, risque_.denominateur) == (19, 1)
+    assert (risque_.seuil_numerateur, risque_.seuil_denominateur) == (20, 1)
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    lignes = _sans(IND_1, _constantes()) + _lignes(IND_1, list(LIGNE_1))
+
+    resultat = risques_entree_rouge(_table(lignes), _meteo(), _grille())
+
+    assert len(resultat.risques) == 1
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.indicateur is IND_1
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_regression_exacte() -> None:
+    pente, ordonnee = risque._regression(LIGNE_1)
+    assert (pente, ordonnee) == (Fraction(41, 165), Fraction(-23, 55))
+    assert ordonnee + pente * 13 == Fraction(464, 165)
+    assert ordonnee + pente * 14 == Fraction(101, 33)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    lignes = _sans(IND_4, _constantes()) + _lignes(IND_4, list(LIGNE_4))
+
+    resultat = risques_entree_rouge(_table(lignes), _meteo(), _grille())
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_hausse_suffisante_ind_4() -> None:
+    hausse = [Fraction(v, 100) for v in range(10, 20)]  # p(1) = 20/100 ≥ 1/5
+    lignes = _sans(IND_4, _constantes()) + _lignes(IND_4, hausse)
+
+    resultat = risques_entree_rouge(_table(lignes), _meteo(), _grille())
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_4]
+    assert resultat.risques[0].valeur_projetee == Fraction(1, 5)
+    assert resultat.risques[0].risque.date_franchissement_estimee == date(2026, 10, 12)
+
+
+def test_stable_ou_en_baisse() -> None:
+    baisse = (
+        _lignes(IND_1, [Fraction(v) for v in range(2, -8, -1)])
+        + _lignes(IND_3, [Fraction(v) for v in range(19, 9, -1)])
+        + _lignes(IND_4, [Fraction(v, 100) for v in range(19, 9, -1)])
+    )
+
+    assert risques_entree_rouge(_table(_constantes()), _meteo(), _grille()) == ResultatRisque(
+        (), ()
+    )
+    assert risques_entree_rouge(_table(baisse), _meteo(), _grille()) == ResultatRisque((), ())
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    ind_4 = list(LIGNE_4)
+    ind_4[3] = None  # type: ignore[assignment]
+    lignes = (
+        _lignes(IND_1, list(LIGNE_1))
+        + _lignes(IND_3, list(LIGNE_3))
+        + _lignes(IND_4, ind_4, motif="moins de 20 tests exécutés")
+    )
+
+    resultat = risques_entree_rouge(_table(lignes), _meteo(), _grille())
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1, IND_3]
+    assert len(resultat.exclus) == 1
+    exclu = resultat.exclus[0]
+    assert exclu.code is IND_4
+    premiere = jours_ouvres(date(2026, 1, 1), D)[-10:][3]
+    assert premiere.isoformat() in exclu.motif
+    assert "moins de 20 tests exécutés" in exclu.motif
+
+
+def test_historique_court() -> None:
+    un_seul = _lignes(IND_3, [Fraction(19)])
+    lignes = _sans(IND_3, _constantes()) + un_seul
+
+    resultat = risques_entree_rouge(_table(lignes), _meteo(), _grille())
+
+    assert resultat.risques == ()
+    assert [(e.code, "historique insuffisant" in e.motif) for e in resultat.exclus] == [
+        (IND_3, True)
+    ]
+
+    # 2 à 9 JO : régression sur les JO présents (pente 2 : p(1) = 19 < 20, p(2) = 21 ≥ 20).
