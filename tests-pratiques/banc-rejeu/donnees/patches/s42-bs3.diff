+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Table `SCHEMA_INDICATEUR` d'ENT-C sur 10 Jours ouvrés finissant à D = vendredi 09/10/2026,
+Grille par défaut (rouge : IND-1 `>= 3`, IND-3 `>= 20`, IND-4 `>= 1/5`). x = 0..9, projection à
+x = 9 + h. Valeurs calculées à la main :
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → D + 1 JO (lundi 12/10), valeur courante 19.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σy = 7, ȳ = 7/10 ; Σ(x − 9/2)(y − ȳ) = 41/2 pour
+  Σ(x − 9/2)² = 165/2 → pente 41/165, ordonnée 7/10 − 41/165·9/2 = −23/55 ;
+  p(4) = −23/55 + 41/165·13 = 464/165 < 3 ; p(5) = −23/55 + 41/165·14 = 101/33 ≥ 3 → D + 5 JO.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+import re
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite, Operateur, RegleDeclenchante
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.commun import avancer
+from usine.domaine.prevision.risque import ParametresRisque, risques_entree_rouge
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+GRILLE = GrilleMeteo.model_validate(
+    yaml.safe_load((RACINE / "config" / "grille_meteo.yaml").read_text(encoding="utf-8"))
+)
+ZEROS = [0] * 10
+
+
+def _grille(**modifs: Any) -> GrilleMeteo:
+    donnees = yaml.safe_load((RACINE / "config" / "grille_meteo.yaml").read_text(encoding="utf-8"))
+    for code, remplacement in modifs.items():
+        donnees["indicateurs"][code.replace("_", "-")].update(remplacement)
+    return GrilleMeteo.model_validate(donnees)
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regles: tuple[RegleDeclenchante, ...] = ()
+    if couleur is not Couleur.vert:
+        regles = (
+            RegleDeclenchante(
+                code=CodeIndicateur.ind_5,
+                couleur=couleur,
+                operateur=Operateur.superieur_ou_egal,
+                numerateur=1,
+                denominateur=1,
+                seuil_numerateur=1,
+                seuil_denominateur=1,
+                tickets_en_cause=(),
+            ),
+        )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=regles,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _lignes(
+    code: CodeIndicateur,
+    numerateurs: list[int],
+    denominateur: int = 1,
+    fin: date = D,
+    entite: str = ENTITE,
+) -> list[dict[str, Any]]:
+    dates = jours_ouvres(date(2026, 1, 1), fin)[-len(numerateurs) :]
+    return [
+        {
+            "date": jour,
+            "entite": entite,
+            "code": code.value,
+            "statut": StatutIndicateur.evalue.value,
+            "motif": "",
+            "numerateur": n,
+            "denominateur": denominateur,
+            "couleur": Couleur.vert.value,
+        }
+        for jour, n in zip(dates, numerateurs, strict=True)
+    ]
+
+
+def _table(lignes: list[dict[str, Any]]) -> pl.DataFrame:
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _series(
+    ind_1: list[int] | None = None,
+    ind_3: list[int] | None = None,
+    ind_4: list[int] | None = None,
+) -> list[dict[str, Any]]:
+    return (
+        _lignes(CodeIndicateur.ind_1, ind_1 or ZEROS)
+        + _lignes(CodeIndicateur.ind_3, ind_3 or ZEROS)
+        + _lignes(CodeIndicateur.ind_4, ind_4 or ZEROS, 100)
+    )
+
+
+def _codes(resultat: risque.ResultatRisque) -> list[CodeIndicateur]:
+    return [r.risque.indicateur for r in resultat.risques]
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = risques_entree_rouge(_table(_series(ind_3=list(range(10, 20)))), _meteo(), GRILLE)
+
+    assert _codes(resultat) == [CodeIndicateur.ind_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.date_franchissement_estimee == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = risques_entree_rouge(
+        _table(_series(ind_1=[0, 0, 0, 0, 0, 1, 1, 1, 2, 2])), _meteo(), GRILLE
+    )
+
+    assert _codes(resultat) == [CodeIndicateur.ind_1]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == avancer(D, 5)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_horizon_plus_court_ne_franchit_pas() -> None:
+    resultat = risques_entree_rouge(
+        _table(_series(ind_1=[0, 0, 0, 0, 0, 1, 1, 1, 2, 2])),
+        _meteo(),
+        GRILLE,
+        ParametresRisque(horizon=4),
+    )
+
+    assert resultat.risques == ()
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = risques_entree_rouge(_table(_series(ind_4=list(range(5, 15)))), _meteo(), GRILLE)
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_hausse_suffisante_ind_4() -> None:
+    # 5/100, 7/100, …, 23/100 : pente 2/100, p(1) = 25/100 = 1/4 ≥ 1/5.
+    resultat = risques_entree_rouge(_table(_series(ind_4=list(range(5, 24, 2)))), _meteo(), GRILLE)
+
+    assert _codes(resultat) == [CodeIndicateur.ind_4]
+    assert resultat.risques[0].valeur_projetee == Fraction(1, 4)
+    assert resultat.risques[0].risque.date_franchissement_estimee == date(2026, 10, 12)
+
+
+@pytest.mark.parametrize("serie", [[7] * 10, list(range(9, -1, -1))])
+def test_stable_ou_en_baisse(serie: list[int]) -> None:
+    resultat = risques_entree_rouge(
+        _table(_series(ind_1=[s // 4 for s in serie], ind_3=serie)), _meteo(), GRILLE
+    )
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    lignes = _series(ind_3=list(range(10, 20)), ind_4=list(range(5, 15)))
+    cible = date(2026, 10, 5)
+    for ligne in lignes:
+        if ligne["code"] == "IND-4" and ligne["date"] == cible:
+            ligne.update(
+                statut=StatutIndicateur.non_evaluable.value,
+                motif="moins de 20 tests exécutés",
+                numerateur=0,
+                denominateur=0,
+            )
+
+    resultat = risques_entree_rouge(_table(lignes), _meteo(), GRILLE)
+
+    assert _codes(resultat) == [CodeIndicateur.ind_3]
+    assert [e.code for e in resultat.exclus] == [CodeIndicateur.ind_4]
+    motif = resultat.exclus[0].motif
+    assert "2026-10-05" in motif
+    assert "moins de 20 tests exécutés" in motif
+
+
+def test_historique_court() -> None:
+    un_jour = (
+        _lignes(CodeIndicateur.ind_1, ZEROS)
+        + _lignes(CodeIndicateur.ind_3, [19])
+        + _lignes(CodeIndicateur.ind_4, ZEROS, 100)
+    )
+    resultat = risques_entree_rouge(_table(un_jour), _meteo(), GRILLE)
+
+    assert resultat.risques == ()
+    assert [e.code for e in resultat.exclus] == [CodeIndicateur.ind_3]
+    assert "historique insuffisant" in resultat.exclus[0].motif
+
+    # 2 JO : régression sur les JO présents (18, 19 → p(1) = 20).
