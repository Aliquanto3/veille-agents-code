+def test_avancer_defini_uniquement_dans_commun() -> None:
+    motif = re.compile(r"^\s*def\s+(_?avancer|_?declenche)\s*\(")
+    definitions = [
+        f"{chemin.relative_to(RACINE).as_posix()}:{ligne.strip()}"
+        for chemin in sorted((RACINE / "src" / "usine" / "domaine" / "prevision").rglob("*.py"))
+        for ligne in chemin.read_text(encoding="utf-8").splitlines()
+        if motif.match(ligne)
+    ]
+    assert definitions == [
+        "src/usine/domaine/prevision/commun.py:def avancer(jour: date, n: int) -> date:",
+        "src/usine/domaine/prevision/commun.py:def declenche(valeur: Fraction, operateur:"
+        " Operateur, seuil: Fraction) -> bool:",
+    ]
