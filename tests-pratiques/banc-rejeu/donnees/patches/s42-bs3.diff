+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Elle lit
+la table des Indicateurs (`SCHEMA_INDICATEUR`) d'une Entité non rouge à la Date d'arrêté D :
+
+- régression linéaire (moindres carrés) de chaque série IND-1, IND-3, IND-4 sur les `fenetre`
+  derniers Jours ouvrés finissant à D ;
+- projection de 1 à `horizon` Jours ouvrés après D ; le premier horizon dont la valeur projetée
+  déclenche la règle rouge de la Grille donne un `RisqueEntreeRouge` ;
+- un indicateur non évaluable sur la fenêtre, sans historique suffisant ou sans seuil rouge actif
+  est exclu de la projection, avec son motif.
+
+Les primitives partagées avec la Baseline (avance en Jours ouvrés, test de seuil) vivent dans
+`commun` ; la Baseline et sa vélocité ne sont pas réécrites ici (AD-18).
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite, Operateur
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+"""Indicateurs projetés, dans l'ordre de restitution."""
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque : paramètre {nom} invalide {valeur!r} (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée à la date de franchissement.
+
+    Le contrat gelé porte la valeur courante ; la valeur projetée est rendue à côté.
+    """
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+@dataclass(frozen=True)
+class _Point:
+    date: date
+    statut: StatutIndicateur
+    motif: str
+    valeur: Fraction | None
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D sont
+    lues, et celles de chaque indicateur actif doivent former des Jours ouvrés consécutifs
+    finissant à D. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la table
+    est invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo {meteo.couleur}, non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+    table = table.filter((pl.col("entite") == entite) & (pl.col("date") <= meteo.date_arrete))
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in PROJETES:
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, f"{code} inactif dans la Grille"))
+            continue
+        if Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, f"{code} sans seuil rouge dans la Grille"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        points = _points(table, meteo, code)[-parametres.fenetre :]
+        non_evaluable = next((p for p in points if p.valeur is None), None)
+        if non_evaluable is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"{code} non évaluable au {non_evaluable.date.isoformat()} :"
+                    f" {non_evaluable.motif}",
+                )
+            )
+            continue
+        if len(points) < 2:
+            exclus.append(IndicateurExclu(code, f"{code} : historique insuffisant"))
+            continue
+        valeurs = [p.valeur for p in points if p.valeur is not None]
+        risque = _risque(valeurs, operateur, seuil, code, meteo, parametres)
+        if risque is not None:
+            risques.append(risque)
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _risque(
+    valeurs: list[Fraction],
+    operateur: Operateur,
+    seuil: Fraction,
+    code: CodeIndicateur,
+    meteo: MeteoEntite,
+    parametres: ParametresRisque,
+) -> RisqueProjete | None:
+    """Premier franchissement du seuil rouge par la projection linéaire de `valeurs`."""
+    n = len(valeurs)
+    moyenne_x = Fraction(n - 1, 2)
+    moyenne_y = sum(valeurs, Fraction(0)) / n
+    pente = sum(((x - moyenne_x) * (y - moyenne_y) for x, y in enumerate(valeurs)), Fraction(0))
+    pente /= sum(((x - moyenne_x) ** 2 for x in range(n)), Fraction(0))
+    ordonnee = moyenne_y - pente * moyenne_x
+    courante = valeurs[-1]
+    for h in range(1, parametres.horizon + 1):
+        projetee = ordonnee + pente * (n - 1 + h)
+        if declenche(projetee, operateur, seuil):
+            return RisqueProjete(
+                RisqueEntreeRouge(
+                    date_arrete=meteo.date_arrete,
+                    entite=meteo.entite,
+                    indicateur=code,
+                    date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                    horizon_jours_ouvres=parametres.horizon,
+                    numerateur=courante.numerator,
+                    denominateur=courante.denominator,
+                    seuil_numerateur=seuil.numerator,
+                    seuil_denominateur=seuil.denominator,
+                    version_grille=meteo.version_grille,
+                ),
+                projetee,
+            )
+    return None
+
+
+def _points(table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur) -> list[_Point]:
+    """Points de l'indicateur `code` jusqu'à D, contrôlés et dans l'ordre."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = table.filter(pl.col("code") == code).sort("date").to_dicts()
+    points: list[_Point] = []
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} {code} : {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if points and points[-1].date == jour:
+            raise UsineErreur(f"Risque {entite} {code} : date {jour.isoformat()} en double")
+        if points and jour_ouvre_suivant(points[-1].date) != jour:
+            raise UsineErreur(
+                f"Risque {entite} {code} : trou de Jours ouvrés entre"
+                f" {points[-1].date.isoformat()} et {jour.isoformat()}"
+            )
+        statut = StatutIndicateur(ligne["statut"])
+        valeur: Fraction | None = None
+        if statut is StatutIndicateur.evalue:
+            if ligne["denominateur"] <= 0:
+                raise UsineErreur(
+                    f"Risque {entite} {code} : dénominateur {ligne['denominateur']} invalide"
+                    f" au {jour.isoformat()}"
+                )
+            valeur = Fraction(ligne["numerateur"], ligne["denominateur"])
+        points.append(_Point(jour, statut, ligne["motif"], valeur))
+    if not points or points[-1].date != arrete:
+        raise UsineErreur(
+            f"Risque {entite} {code} : Date d'arrêté {arrete.isoformat()} absente de la table"
+        )
+    return points
