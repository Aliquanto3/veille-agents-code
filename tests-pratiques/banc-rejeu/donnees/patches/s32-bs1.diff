+def test_conservation_des_flux(journal_genere: tuple[pl.DataFrame, pl.DataFrame]) -> None:
+    _, table = journal_genere
+
+    def serie(code: str, perimetre: str) -> pl.DataFrame:
+        return (
+            table.filter((pl.col("perimetre") == perimetre) & (pl.col("code_kpi") == code))
+            .sort("date")
+            .select("date", pl.col("numerateur").alias(code))
+        )
+
+    for perimetre in table["perimetre"].unique():
+        serie_totale = (
+            serie("anomalies_ouvertes", perimetre)
+            .join(serie("entrees_jour", perimetre), on="date")
+            .join(serie("sorties_jour", perimetre), on="date")
+            .sort("date")
+            .with_columns(pl.col("anomalies_ouvertes").shift(1).fill_null(0).alias("veille"))
+        )
+        ecart = serie_totale["anomalies_ouvertes"] - serie_totale["veille"]
+        assert (ecart == serie_totale["entrees_jour"] - serie_totale["sorties_jour"]).all()
+
