@@ -0,0 +1,243 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11).
+
+Fonction pure : les Entités arrivent en paramètre, les états par ticket de chaque Jour ouvré
+(`SCHEMA_TICKET_ETAT`, détail de l'Instantané) en entrée. La sortie est dense (zéro explicite,
+jamais de ligne absente), en nombres entiers : un taux est porté par `numerateur` et
+`denominateur`, jamais par un flottant (AD-10). `0/0` signifie « pas de valeur ».
+
+Définitions H-17 : Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée = création ou
+réouverture (`date_derniere_entree`) ; Sortie = passage à Fermée ou Rejetée. Fenêtre
+glissante H-19 : `contrats.calendrier.fenetre_glissante`.
+"""
+
+from collections import Counter, defaultdict
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+from functools import cache
+from typing import Any
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des `code_kpi`, dans l'ordre de sortie."""
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = {
+    "anomalies_ouvertes": ("",),
+    "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+    "anomalies_ouvertes_phase": tuple(p.value for p in Phase),
+    "entrees_jour": ("",),
+    "sorties_jour": ("",),
+    "entrees_fenetre": ("",),
+    "sorties_fenetre": ("",),
+    "age_median_anomalies_ouvertes": ("",),
+    "age_max_anomalies_ouvertes": ("",),
+    "taux_ko_cas_de_test": tuple(p.value for p in Phase),
+    "taux_non_execution_cas_de_test": tuple(p.value for p in Phase),
+    "certifications": tuple(s.value for s in StatutCertification),
+}
+"""Dimensions de chaque `code_kpi`, dans l'ordre de l'énumération ; `""` si non ventilé."""
+
+_FERMES = frozenset(statut.value for statut in STATUTS_FERMES)
+
+_Cle = tuple[str, str, str]
+"""Clé de comptage : `(perimetre, code, dimension)`."""
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée « {PERIMETRE_PROGRAMME} » : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Les dates couvrent chaque Jour ouvré de la première à la dernière, sans autre date."""
+    attendues = jours_ouvres(dates[0], dates[-1])
+    presentes = set(dates)
+    for jour in attendues:
+        if jour not in presentes:
+            raise UsineErreur(
+                f"Date manquante dans l'état des tickets : {jour.isoformat()} (Jours ouvrés"
+                f" contigus attendus du {dates[0].isoformat()} au {dates[-1].isoformat()})"
+            )
+    for jour in dates:
+        if jour not in attendues:
+            raise UsineErreur(f"{jour.isoformat()} n'est pas un Jour ouvré")
+
+
+@cache
+def _age(entree: date, jour: date) -> int:
+    """Jours ouvrés écoulés depuis l'Entrée (0 le jour même)."""
+    return len(jours_ouvres(entree, jour)) - 1
+
+
+def _mediane(ages: list[int]) -> Fraction:
+    tries = sorted(ages)
+    milieu = len(tries) // 2
+    if len(tries) % 2:
+        return Fraction(tries[milieu])
+    return Fraction(tries[milieu - 1] + tries[milieu], 2)
+
+
+def _comptes_du_jour(
+    lignes: list[dict[str, Any]],
+    veille: Mapping[str, bool],
+    jour: date,
+    entites: Sequence[str],
+) -> tuple[Counter[_Cle], dict[str, list[int]], dict[str, bool]]:
+    """Comptes bruts du jour par périmètre, âges des ouvertes, et statut ouvert de chaque ticket."""
+    comptes: Counter[_Cle] = Counter()
+    ages: dict[str, list[int]] = defaultdict(list)
+    ouverts: dict[str, bool] = {}
+    for ligne in lignes:
+        perimetres = [PERIMETRE_PROGRAMME]
+        if ligne["entite"] in entites:
+            perimetres.append(ligne["entite"])
+
+        def compter(
+            code: str, dimension: str = "", valeur: int = 1, cibles: list[str] = perimetres
+        ) -> None:
+            for perimetre in cibles:
+                comptes[(perimetre, code, dimension)] += valeur
+
+        type_ticket = ligne["type_ticket"]
+        if type_ticket == TypeTicket.anomalie.value:
+            ouvert = ligne["statut"] is not None and ligne["statut"] not in _FERMES
+            ouverts[ligne["cle_ticket"]] = ouvert
+            entree = 1 if ligne["date_derniere_entree"] == jour else 0
+            sortie = entree - (int(ouvert) - int(veille.get(ligne["cle_ticket"], False)))
+            compter("entrees_jour", valeur=entree)
+            compter("sorties_jour", valeur=sortie)
+            if ouvert:
+                compter("anomalies_ouvertes")
+                if ligne["gravite"] is not None:
+                    compter("anomalies_ouvertes_gravite", ligne["gravite"])
+                if ligne["phase"] is not None:
+                    compter("anomalies_ouvertes_phase", ligne["phase"])
+                if ligne["date_derniere_entree"] is not None:
+                    age = _age(ligne["date_derniere_entree"], jour)
+                    for perimetre in perimetres:
+                        ages[perimetre].append(age)
+        elif type_ticket == TypeTicket.cas_de_test.value:
+            statut, phase = ligne["statut_test"], ligne["phase"]
+            if statut is not None and phase is not None:
+                if statut in (StatutTest.ok.value, StatutTest.ko.value):
+                    compter("_ok_ko", phase)
+                if statut == StatutTest.ko.value:
+                    compter("_ko", phase)
+                compter("_avec_statut", phase)
+                if statut == StatutTest.non_execute.value:
+                    compter("_non_execute", phase)
+        elif type_ticket == TypeTicket.certification.value:
+            if ligne["statut_certification"] is not None:
+                compter("certifications", ligne["statut_certification"])
+    return comptes, ages, ouverts
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : une ligne par date, périmètre, code et dimension du catalogue.
+
+    Périmètres : les `entites` (dans l'ordre reçu), puis `PROGRAMME`, qui agrège toutes les
+    lignes de la table, y compris des Entités hors de `entites`. Lignes triées par date,
+    périmètre, code (`CODES_KPI`), dimension (ordre de l'énumération).
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date
+    (sinon `UsineErreur`) ; à sa première date, la veille est vide (début de l'historique).
+    Mouvements d'une Anomalie en D : Entrée E = 1 si `date_derniere_entree == D`, Sortie
+    S = E − (ouvert(D) − ouvert(D−1)), donc stock(D) − stock(D−1) = entrées − sorties.
+    Un âge ou un taux sans valeur vaut `0/0`.
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    if etats.is_empty():
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    etats = etats.with_columns(
+        pl.col(
+            "type_ticket", "gravite", "phase", "statut", "statut_test", "statut_certification"
+        ).cast(pl.Utf8)
+    )
+    dates = sorted(etats.get_column("date").unique().to_list())
+    _verifier_dates(dates)
+
+    par_jour = {
+        cle[0]: groupe.iter_rows(named=True)
+        for cle, groupe in etats.partition_by("date", as_dict=True).items()
+    }
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    quotidiens: dict[date, Counter[_Cle]] = {}
+    ages_par_jour: dict[date, dict[str, list[int]]] = {}
+    veille: Mapping[str, bool] = {}
+    for jour in dates:
+        comptes, ages, veille = _comptes_du_jour(list(par_jour[jour]), veille, jour, entites)
+        quotidiens[jour] = comptes
+        ages_par_jour[jour] = ages
+
+    colonnes: dict[str, list[Any]] = {nom: [] for nom in SCHEMA_KPI.colonnes}
+
+    def ajouter(jour: date, perimetre: str, code: str, dimension: str, num: int, den: int) -> None:
+        for nom, valeur in zip(colonnes, (jour, perimetre, code, dimension, num, den), strict=True):
+            colonnes[nom].append(valeur)
+
+    for jour in dates:
+        comptes = quotidiens[jour]
+        fenetre = fenetre_glissante(jour)
+        for perimetre in perimetres:
+
+            def compte(
+                code: str, dimension: str = "", jour_: date = jour, p: str = perimetre
+            ) -> int:
+                return quotidiens.get(jour_, Counter())[(p, code, dimension)]
+
+            ouvertes = ages_par_jour[jour].get(perimetre, [])
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    num, den = 0, 1
+                    if code in ("entrees_fenetre", "sorties_fenetre"):
+                        base = code.replace("fenetre", "jour")
+                        num = sum(compte(base, "", j) for j in fenetre)
+                    elif code == "age_median_anomalies_ouvertes":
+                        mediane = _mediane(ouvertes) if ouvertes else Fraction(0)
+                        num, den = (mediane.numerator, mediane.denominator) if ouvertes else (0, 0)
+                    elif code == "age_max_anomalies_ouvertes":
+                        num, den = (max(ouvertes), 1) if ouvertes else (0, 0)
+                    elif code == "taux_ko_cas_de_test":
+                        num, den = compte("_ko", dimension), compte("_ok_ko", dimension)
+                    elif code == "taux_non_execution_cas_de_test":
+                        num = compte("_non_execute", dimension)
+                        den = compte("_avec_statut", dimension)
+                    else:
+                        num = comptes[(perimetre, code, dimension)]
+                    ajouter(jour, perimetre, code, dimension, num, den)
+
+    return valider(pl.DataFrame(colonnes, schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
