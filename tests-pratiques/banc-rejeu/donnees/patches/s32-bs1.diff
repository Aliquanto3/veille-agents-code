+def test_stock_egal_instantane(journal_genere: tuple[pl.DataFrame, pl.DataFrame]) -> None:
+    etats, table = journal_genere
+    ouvertes = (
+        instantane(etats)
+        .filter(
+            (pl.col("type_ticket") == TypeTicket.anomalie.value)
+            & ~pl.col("statut").cast(pl.Utf8).is_in(["fermee", "rejetee"])
+        )
+        .group_by("date")
+        .agg(pl.col("nombre").sum().alias("ouvertes"))
+    )
+    stock = table.filter(
+        (pl.col("perimetre") == PERIMETRE_PROGRAMME) & (pl.col("code_kpi") == "anomalies_ouvertes")
+    ).select("date", "numerateur")
+    joint = stock.join(ouvertes, on="date", how="left").with_columns(
+        pl.col("ouvertes").fill_null(0)
+    )
+    assert (joint["numerateur"] == joint["ouvertes"]).all()
