@@ -0,0 +1,276 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import Champ, Gravite, Phase, StatutCertification, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer
+
+RACINE = Path(__file__).resolve().parents[3]
+
+ENTITES = ["ENT-A", "ENT-B"]
+J1 = date(2026, 10, 1)
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, debut: date, fin: date, entites: list[str] = ENTITES) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, jours_ouvres(debut, fin)), entites)
+
+
+def _val(
+    table: pl.DataFrame, jour: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    lignes = table.filter(
+        (pl.col("date") == jour)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert lignes.height == 1
+    return lignes["numerateur"][0], lignes["denominateur"][0]
+
+
+def _flux_mouvements() -> Flux:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))  # lundi 5 : création
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")  # mardi : fermeture
+    flux.transition("DEMO-1", _ts(7, 9), "fermee", "en_analyse")  # mercredi : réouverture
+    flux.transition("DEMO-1", _ts(7, 10), "en_analyse", "fermee")  # puis fermeture
+    return flux
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(1))
+    flux.anomalie("DEMO-3", _ts(1), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, J1, J1)
+    assert _val(table, J1, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(table, J1, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(table, J1, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(table, J1, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(table, J1, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(table, J1, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+
+
+def test_flux_du_jour() -> None:
+    table = _kpi(_flux_mouvements(), date(2026, 10, 5), date(2026, 10, 7))
+    jours = jours_ouvres(date(2026, 10, 5), date(2026, 10, 7))
+    entrees = [_val(table, j, "ENT-A", "entrees_jour")[0] for j in jours]
+    sorties = [_val(table, j, "ENT-A", "sorties_jour")[0] for j in jours]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    jours = jours_ouvres(J1, date(2026, 10, 9))
+    assert len(jours) == 7
+    for i, jour in enumerate(jours):
+        flux.anomalie(f"DEMO-{i + 1}", _ts(jour.day))
+    flux.transition("DEMO-1", _ts(9), "nouvelle", "fermee")
+    table = _kpi(flux, J1, date(2026, 10, 9))
+    assert _val(table, date(2026, 10, 9), "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(table, date(2026, 10, 9), "ENT-A", "sorties_fenetre") == (1, 1)
+    # Les jours antérieurs à la table comptent 0.
+    assert _val(table, J1, "ENT-A", "entrees_fenetre") == (1, 1)
+    assert _val(table, date(2026, 10, 5), "ENT-A", "entrees_fenetre") == (3, 1)
+
+
+def test_age_median_et_maximum() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    jour = date(2026, 10, 7)
+    table = _kpi(flux, J1, jour)
+    assert _val(table, jour, PERIMETRE_PROGRAMME, "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(table, jour, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (4, 1)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))  # J0
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")  # J2
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")  # J5
+    jour = date(2026, 10, 9)  # J6
+    table = _kpi(flux, J1, jour)
+    assert _val(table, jour, "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(table, jour, "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_age_sans_anomalie_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1), statut="fermee")
+    table = _kpi(flux, J1, J1)
+    assert _val(table, J1, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(table, J1, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux_ko_et_non_execution() -> None:
+    flux = Flux()
+    statuts = ["ok", "ok", "ok", "ko", "non_execute", "non_execute"]
+    for i, statut in enumerate(statuts):
+        flux.creer(
+            f"DEMO-{i + 1}",
+            TypeTicket.cas_de_test,
+            _ts(1),
+            {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: "recette"},
+        )
+    table = _kpi(flux, J1, J1)
+    assert _val(table, J1, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(table, J1, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(table, J1, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(table, J1, "ENT-B", "taux_non_execution_cas_de_test", "recette") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["accordee", "reservee", "reservee"]):
+        flux.creer(
+            f"DEMO-{i + 1}",
+            TypeTicket.certification,
+            _ts(1),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    table = _kpi(flux, J1, J1)
+    assert _val(table, J1, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(table, J1, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(table, J1, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [date(2026, 10, 5), date(2026, 10, 7)])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"),
+    [(["ENT-A", "ENT-A"], "ENT-A"), (["ENT-A", PERIMETRE_PROGRAMME], PERIMETRE_PROGRAMME)],
+)
+def test_entites_invalides(entites: list[str], valeur: str) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    with pytest.raises(UsineErreur, match=valeur):
+        _kpi(flux, J1, J1, entites)
+
+
+def test_table_vide() -> None:
+    table = kpi(tickets_etats([], []), ENTITES)
+    assert table.is_empty()
+    assert table.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+
+
+def test_schema_dense_et_sans_flottant() -> None:
+    table = _kpi(_flux_mouvements(), date(2026, 10, 5), date(2026, 10, 7))
+    valider(table, SCHEMA_KPI)
+    assert not any(dtype.is_float() for dtype in table.schema.values())
+    par_perimetre = sum(len(valeurs) for valeurs in DIMENSIONS_KPI.values())
+    assert set(DIMENSIONS_KPI) == set(CODES_KPI)
+    assert table.height == 3 * 3 * par_perimetre
+    assert table.select("date", "perimetre", "code_kpi", "dimension").is_unique().all()
+
+
+def test_programme_somme_des_entites() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(1), entite="ENT-B", gravite="mineure")
+    flux.transition("DEMO-2", _ts(2), "nouvelle", "fermee")
+    table = _kpi(flux, J1, date(2026, 10, 2))
+    comptes = table.filter(~pl.col("code_kpi").str.starts_with("age_"))
+    comptes = comptes.filter(~pl.col("code_kpi").str.starts_with("taux_"))
+    somme = (
+        comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by("date", "code_kpi", "dimension")
+        .agg(pl.col("numerateur").sum())
+    )
+    programme = comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME).select(
+        "date", "code_kpi", "dimension", "numerateur"
+    )
+    cles = ["date", "code_kpi", "dimension"]
+    assert somme.sort(cles).equals(programme.sort(cles))
+
+
+def test_deterministe() -> None:
+    flux = _flux_mouvements()
+    premier = _kpi(flux, date(2026, 10, 5), date(2026, 10, 7))
+    second = _kpi(flux, date(2026, 10, 5), date(2026, 10, 7))
+    assert premier.equals(second)
