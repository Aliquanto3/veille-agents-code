@@ -0,0 +1,272 @@
+"""Outils de consultation de l'Agent : matrice I/O, lecture seule, intégration (Story 7.8)."""
+
+import ast
+from datetime import date
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, get_args, get_type_hints
+
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+import usine.contrats.agent as contrats_agent
+import usine.ia.agent as paquet_agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.contrats.agent import (
+    AnomalieResume,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent.outils import (
+    NOMS_OUTILS,
+    DefinitionOutil,
+    OutilsConsultation,
+    outils_consultation,
+)
+
+JOUR = date(2026, 3, 11)
+AUTRE = date(2026, 3, 10)
+MESSAGE = "aucune donnée pour cette date"
+
+
+def _anomalie(cle: str, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=cle,
+        entite="ENT-A",
+        gravite=Gravite.bloquante,
+        phase=Phase.recette,
+        domaine="D1",
+        statut=statut,
+        age_jours_ouvres=3,
+    )
+
+
+ANOMALIES = (
+    _anomalie("A-1", StatutAnomalie.en_analyse),
+    _anomalie("A-2", StatutAnomalie.nouvelle),
+    _anomalie("A-3", StatutAnomalie.en_analyse),
+    _anomalie("A-4", StatutAnomalie.en_analyse),
+)
+
+
+class ConsultationFactice:
+    """Lectures minimales ; enregistre les appels."""
+
+    def __init__(self, dates: tuple[date, ...] = (AUTRE, JOUR)) -> None:
+        self.dates = dates
+        self.appels: list[tuple[str, Any]] = []
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self.dates
+
+    def manifeste(self) -> Any:
+        self.appels.append(("manifeste", None))
+        return SimpleNamespace(date_arrete=JOUR)
+
+    def meteo(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.appels.append(("meteo", date_arrete))
+        return ()
+
+    def evolution_meteo(self, date_arrete: date | None = None) -> tuple[()]:
+        self.appels.append(("evolution_meteo", date_arrete))
+        return ()
+
+    def anomalies(self, limite: int | None = None, **filtres: Any) -> ResultatListAnomalies:
+        self.appels.append(("anomalies", limite))
+        retenues = ANOMALIES if limite is None else ANOMALIES[:limite]
+        return ResultatListAnomalies(
+            date_arrete=filtres["date_arrete"], anomalies=retenues, total=len(ANOMALIES)
+        )
+
+    def tendances(self, entite: str | None = None, code_kpi: str | None = None) -> pl.DataFrame:
+        return pl.DataFrame(
+            dict(
+                date=[JOUR],
+                perimetre=["ENT-A"],
+                code_kpi=["K1"],
+                dimension=["total"],
+                numerateur=[1],
+                denominateur=[2],
+                colonne_en_plus=["x"],
+            )
+        )
+
+    def previsions(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.appels.append(("previsions", date_arrete))
+        return ()
+
+    def risques(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.appels.append(("risques", date_arrete))
+        return ()
+
+
+def _definitions(consultation: Any) -> tuple[DefinitionOutil, ...]:
+    return outils_consultation(consultation)
+
+
+def _outil(consultation: Any, nom: str) -> Any:
+    return next(o for o in _definitions(consultation) if o.nom == nom)
+
+
+DATES_OUTILS = ("get_meteo", "list_anomalies", "get_prevision", "get_risques")
+
+
+def test_noms_exacts() -> None:
+    assert NOMS_OUTILS == (
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    )
+    assert tuple(o.nom for o in _definitions(ConsultationFactice())) == NOMS_OUTILS
+
+
+def test_arguments_de_contrats_agent() -> None:
+    for outil in _definitions(ConsultationFactice()):
+        assert outil.arguments.__module__ == contrats_agent.__name__
+        assert outil.description
+
+
+def test_resultats_de_contrats_agent() -> None:
+    for nom in NOMS_OUTILS:
+        retour = get_type_hints(getattr(OutilsConsultation, nom))["return"]
+        for classe in get_args(retour) or (retour,):
+            assert classe.__module__ == contrats_agent.__name__
+
+
+@pytest.mark.parametrize("nom", DATES_OUTILS)
+def test_date_absente_prend_le_manifeste(nom: str) -> None:
+    resultat = _outil(ConsultationFactice(), nom).executer({})
+    assert resultat.date_arrete == JOUR
+
+
+@pytest.mark.parametrize("nom", DATES_OUTILS)
+def test_date_disponible(nom: str) -> None:
+    resultat = _outil(ConsultationFactice(), nom).executer({"date_arrete": "2026-03-10"})
+    assert resultat.date_arrete == AUTRE
+
+
+@pytest.mark.parametrize("nom", DATES_OUTILS)
+def test_date_sans_passage(nom: str) -> None:
+    resultat = _outil(ConsultationFactice(), nom).executer({"date_arrete": "2026-01-01"})
+    assert resultat == AucuneDonnee(date_arrete=date(2026, 1, 1))
+    assert resultat.message == MESSAGE
+
+
+@pytest.mark.parametrize("nom", DATES_OUTILS)
+def test_aucune_date_du_tout(nom: str) -> None:
+    consultation = ConsultationFactice(dates=())
+    resultat = _outil(consultation, nom).executer({})
+    assert resultat == AucuneDonnee(date_arrete=None)
+    assert ("manifeste", None) not in consultation.appels
+
+
+def test_filtre_statut_total_filtre_avant_limite() -> None:
+    resultat = _outil(ConsultationFactice(), "list_anomalies").executer(
+        {"statut": "en_analyse", "limite": 2}
+    )
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert [a.cle_ticket for a in resultat.anomalies] == ["A-1", "A-3"]
+    assert resultat.total == 3
+
+
+def test_sans_statut_limite_transmise() -> None:
+    consultation = ConsultationFactice()
+    resultat = _outil(consultation, "list_anomalies").executer({"limite": 2})
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert len(resultat.anomalies) == 2
+    assert resultat.total == len(ANOMALIES)
+    assert ("anomalies", 2) in consultation.appels
+
+
+def test_tendance_ignore_les_colonnes_en_plus() -> None:
+    resultat = _outil(ConsultationFactice(dates=()), "get_tendance").executer({})
+    assert isinstance(resultat, ResultatGetTendance)
+    assert resultat.points[0].code_kpi == "K1"
+
+
+def test_arguments_invalides() -> None:
+    with pytest.raises(ValidationError):
+        _outil(ConsultationFactice(), "list_anomalies").executer({"limite": 0})
+    with pytest.raises(ValidationError):
+        _outil(ConsultationFactice(), "get_meteo").executer({"inconnu": 1})
+
+
+# --- Lecture seule -------------------------------------------------------------------------
+
+VERBES_ECRITURE = ("write", "create", "update", "delete", "send", "post", "set_", "put", "add_")
+
+
+def _sources() -> list[Path]:
+    racine = Path(paquet_agent.__file__).parent
+    return [p for p in racine.glob("*.py") if p.name != "cli.py"]
+
+
+def test_aucun_outil_n_ecrit() -> None:
+    for nom in NOMS_OUTILS:
+        assert not any(v in nom for v in VERBES_ECRITURE)
+    publiques = [n for n in vars(OutilsConsultation) if not n.startswith("_")]
+    assert sorted(publiques) == sorted(NOMS_OUTILS)
+
+
+def test_imports_de_ia_agent() -> None:
+    autorises = ("usine.contrats", "usine.ports.consultation", "usine.consultation")
+    for source in _sources():
+        for noeud in ast.walk(ast.parse(source.read_text(encoding="utf-8"))):
+            if isinstance(noeud, ast.ImportFrom) and noeud.module and noeud.level == 0:
+                modules = [noeud.module]
+            elif isinstance(noeud, ast.Import):
+                modules = [a.name for a in noeud.names]
+            else:
+                continue
+            for module in modules:
+                if module.split(".")[0] == "usine":
+                    assert module.startswith(autorises), f"{source.name} importe {module}"
+                assert not module.startswith(("pydantic_ai", "httpx", "usine.adaptateurs"))
+
+
+def test_aucun_acces_jira() -> None:
+    for source in _sources():
+        texte = source.read_text(encoding="utf-8")
+        assert "url_ticket" not in texte
+        assert "SourceTickets" not in texte
+
+
+# --- Intégration ---------------------------------------------------------------------------
+
+
+def test_integration_passage_palier_2() -> None:
+    consultation = passage_palier_2().consultation
+    jour = consultation.manifeste().date_arrete
+    types = {
+        "get_meteo": ResultatGetMeteo,
+        "list_anomalies": ResultatListAnomalies,
+        "get_prevision": ResultatGetPrevision,
+        "get_risques": ResultatGetRisques,
+    }
+    for nom, type_resultat in types.items():
+        outil = _outil(consultation, nom)
+        resultat = outil.executer({})
+        assert isinstance(resultat, type_resultat)
+        assert resultat.date_arrete == jour
+        assert outil.executer({"date_arrete": "1999-01-01"}) == AucuneDonnee(
+            date_arrete=date(1999, 1, 1)
+        )
+    tendance = _outil(consultation, "get_tendance").executer({})
+    assert isinstance(tendance, ResultatGetTendance)
+    assert tendance.points
+    assert _outil(consultation, "get_meteo").executer({}).meteos
+    assert _outil(consultation, "get_prevision").executer({}).previsions
+    toutes = _outil(consultation, "list_anomalies").executer({})
+    statut = toutes.anomalies[0].statut
+    filtrees = _outil(consultation, "list_anomalies").executer({"statut": statut, "limite": 1})
+    attendu = sum(1 for a in toutes.anomalies if a.statut == statut)
+    assert filtrees.total == attendu
+    assert all(a.statut == statut for a in filtrees.anomalies)
