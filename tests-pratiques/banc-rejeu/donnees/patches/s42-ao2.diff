@@ -0,0 +1,382 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Table de référence ENT-C : 10 Jours ouvrés du lundi
+28/09/2026 au vendredi 09/10/2026 (D), Météo orange, Grille par défaut (rouge : IND-1 `>= 3`,
+IND-3 `>= 20`, IND-4 `>= 1/5`). x = 0..9, x̄ = 9/2, Σ(x − x̄)² = 165/2 ; projection en
+x = 9 + h. D + 1 JO = lundi 12/10, D + 5 JO = vendredi 16/10.
+
+    IND-3 = 10..19            : b = 1, a = 10 ; p(1) = 20 ≥ 20 → risque au 12/10
+    IND-1 = 0 0 0 0 0 1 1 1 2 2 : ȳ = 7/10, Σ(x − x̄)y = 41/2 → b = 41/165, a = −23/55 ;
+                                p(4) = 464/165 < 3, p(5) = 101/33 ≥ 3 → risque au 16/10
+    IND-4 = 5/100..14/100     : b = 1/100, a = 1/20 ; p(5) = 19/100 < 1/5 → aucun risque
+"""
+
+import re
+from collections.abc import Sequence
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from types import MappingProxyType
+
+import polars as pl
+import pytest
+
+from usine.config import charger_yaml
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo, RegleIndicateur
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.commun import avancer, declenche
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+GRILLE = charger_yaml(RACINE / "config" / "grille_meteo.yaml", GrilleMeteo)
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+MOTIF = "en deçà du garde-fou (12 Cas de test exécutés, 20 attendus)"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Valeur = int | tuple[int, int] | None
+"""Compte `n/1`, fraction `(n, d)` évaluée, ou `None` : non évaluable (0/0, `MOTIF`)."""
+
+STABLES: dict[CodeIndicateur, Sequence[Valeur]] = {
+    IND_1: [1] * 10,
+    IND_3: [5] * 10,
+    IND_4: [(1, 10)] * 10,
+}
+
+
+def _table(
+    series: dict[CodeIndicateur, Sequence[Valeur]], fin: date = D, entite: str = ENTITE
+) -> pl.DataFrame:
+    """Table d'indicateurs dense finissant à `fin` ; `series` complète les séries stables."""
+    lignes: list[dict[str, object]] = []
+    for code, valeurs in (STABLES | series).items():
+        dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :] if valeurs else ()
+        for jour, valeur in zip(dates, valeurs, strict=True):
+            if valeur is None:
+                numerateur, denominateur, motif = 0, 0, MOTIF
+            elif isinstance(valeur, int):
+                numerateur, denominateur, motif = valeur, 1, ""
+            else:
+                (numerateur, denominateur), motif = valeur, ""
+            lignes.append(
+                {
+                    "date": jour,
+                    "entite": entite,
+                    "code": code.value,
+                    "statut": (
+                        StatutIndicateur.non_evaluable
+                        if valeur is None
+                        else StatutIndicateur.evalue
+                    ).value,
+                    "motif": motif,
+                    "numerateur": numerateur,
+                    "denominateur": denominateur,
+                    "couleur": Couleur.vert.value,
+                }
+            )
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regle = RegleDeclenchante(
+        code=IND_1,
+        couleur=couleur,
+        operateur=Operateur.superieur_ou_egal,
+        numerateur=1,
+        denominateur=1,
+        seuil_numerateur=1,
+        seuil_denominateur=1,
+        tickets_en_cause=(),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(regle,),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _grille_avec(code: CodeIndicateur, regle: RegleIndicateur) -> GrilleMeteo:
+    return GRILLE.model_copy(
+        update={"indicateurs": MappingProxyType({**GRILLE.indicateurs, code: regle})}
+    )
+
+
+def _calculer(
+    series: dict[CodeIndicateur, Sequence[Valeur]],
+    grille: GrilleMeteo = GRILLE,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    return risques_entree_rouge(_table(series), _meteo(), grille, parametres)
+
+
+def _resumes(resultat: ResultatRisque) -> list[tuple[CodeIndicateur, date, Fraction]]:
+    return [
+        (r.risque.indicateur, r.risque.date_franchissement_estimee, r.valeur_projetee)
+        for r in resultat.risques
+    ]
+
+
+def test_franchissement_ind3() -> None:
+    resultat = _calculer({IND_3: list(range(10, 20))})
+
+    assert _resumes(resultat) == [(IND_3, date(2026, 10, 12), Fraction(20))]
+    assert resultat.exclus == ()
+    risque_ind3 = resultat.risques[0].risque
+    assert (risque_ind3.date_arrete, risque_ind3.entite) == (D, ENTITE)
+    assert (risque_ind3.numerateur, risque_ind3.denominateur) == (19, 1)
+    assert (risque_ind3.seuil_numerateur, risque_ind3.seuil_denominateur) == (20, 1)
+    assert risque_ind3.horizon_jours_ouvres == 5
+    assert risque_ind3.version_grille == VERSION_GRILLE
+
+
+def test_tendance_non_lineaire_ind1() -> None:
+    serie: list[Valeur] = [0, 0, 0, 0, 0, 1, 1, 1, 2, 2]
+
+    resultat = _calculer({IND_1: serie})
+
+    assert _resumes(resultat) == [(IND_1, date(2026, 10, 16), Fraction(101, 33))]
+    assert (resultat.risques[0].risque.numerateur, resultat.risques[0].risque.denominateur) == (
+        2,
+        1,
+    )
+    # p(4) = 464/165 < 3 : aucun franchissement sur un horizon de 4 Jours ouvrés.
+    assert _calculer({IND_1: serie}, parametres=ParametresRisque(horizon=4)).risques == ()
+
+
+def test_hausse_insuffisante_ind4() -> None:
+    resultat = _calculer({IND_4: [(n, 100) for n in range(5, 15)]})
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind4_franchit_seuil_fractionnaire() -> None:
+    # IND-4 = 10/100..19/100 : p(1) = 20/100 = 1/5 ≥ 1/5.
+    resultat = _calculer({IND_4: [(n, 100) for n in range(10, 20)]})
+
+    assert _resumes(resultat) == [(IND_4, date(2026, 10, 12), Fraction(1, 5))]
+    risque_ind4 = resultat.risques[0].risque
+    assert (risque_ind4.numerateur, risque_ind4.denominateur) == (19, 100)
+    assert (risque_ind4.seuil_numerateur, risque_ind4.seuil_denominateur) == (1, 5)
+
+
+def test_stable_ou_en_baisse() -> None:
+    resultat = _calculer({IND_1: [2] * 10, IND_3: list(range(19, 9, -1)), IND_4: [(19, 100)] * 10})
+
+    assert resultat == ResultatRisque(risques=(), exclus=())
+
+
+def test_risques_dans_l_ordre_des_codes() -> None:
+    resultat = _calculer(
+        {
+            IND_4: [(n, 100) for n in range(10, 20)],
+            IND_3: list(range(10, 20)),
+            IND_1: [0, 0, 0, 0, 0, 1, 1, 1, 2, 2],
+        }
+    )
+
