+def _sans_ligne(table: pl.DataFrame, code: CodeIndicateur, jour: date) -> pl.DataFrame:
+    return table.filter(~((pl.col("code") == code.value) & (pl.col("date") == jour)))
+
+
+def _ligne(code: CodeIndicateur, jour: date, numerateur: int, denominateur: int) -> pl.DataFrame:
+    return pl.DataFrame(
+        [
+            {
+                "date": jour,
+                "entite": ENTITE,
+                "code": code.value,
+                "statut": StatutIndicateur.evalue.value,
+                "motif": "",
+                "numerateur": numerateur,
+                "denominateur": denominateur,
+                "couleur": Couleur.vert.value,
+            }
+        ],
+        schema=dict(SCHEMA_INDICATEUR.colonnes),
+    )
+
+
+@pytest.mark.parametrize(
+    ("table", "cause"),
+    [
+        (_sans_ligne(_table({}), IND_1, D), "absent à la Date d'arrêté"),
+        (_sans_ligne(_table({}), IND_3, date(2026, 10, 5)), "trou de Jours ouvrés"),
+        (
+            pl.concat([_table({}), _ligne(IND_4, date(2026, 10, 3), 1, 10)]),
+            "n'est pas un Jour ouvré",
+        ),
+        (pl.concat([_table({}), _ligne(IND_1, date(2026, 10, 5), 1, 1)]), "en double"),
+        (
+            pl.concat(
+                [
+                    _sans_ligne(_table({}), IND_4, date(2026, 10, 5)),
+                    _ligne(IND_4, date(2026, 10, 5), 1, 0),
+                ]
+            ),
+            "dénominateur 0",
+        ),
+        (_table({}).drop("motif"), "motif"),
+    ],
+)
+def test_table_invalide(table: pl.DataFrame, cause: str) -> None:
+    with pytest.raises(UsineErreur, match=ENTITE) as erreur:
+        risques_entree_rouge(table, _meteo(), GRILLE)
+    assert cause in str(erreur.value)
