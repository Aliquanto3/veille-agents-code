+def test_primitives_uniques_ad_18() -> None:
+    motif = re.compile(r"^\s*def\s+_?(avancer|declenche)\s*\(")
+    prevision = RACINE / "src" / "usine" / "domaine" / "prevision"
+    definitions = [
+        f"{chemin.name}:{ligne.strip()}"
+        for chemin in sorted(prevision.rglob("*.py"))
+        for ligne in chemin.read_text(encoding="utf-8").splitlines()
+        if motif.match(ligne)
+    ]
+    assert definitions == [
+        "commun.py:def avancer(jour: date, n: int) -> date:",
+        "commun.py:def declenche(valeur: Fraction, operateur: Operateur, seuil: Fraction) -> bool:",
+    ]
