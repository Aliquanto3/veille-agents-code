+"""Risque d'entrée en rouge d'une Entité non rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Elle
+lit la table des indicateurs (`SCHEMA_INDICATEUR`) d'une Entité, sa `MeteoEntite` non rouge à
+la Date d'arrêté D et la Grille, et projette IND-1, IND-3 et IND-4 :
+
+- régression linéaire aux moindres carrés sur les `fenetre` derniers Jours ouvrés finissant à
+  D (x = 0..n−1, n ≥ 2) : b = Σ(x − x̄)(y − ȳ) / Σ(x − x̄)², a = ȳ − b·x̄ ;
+- projection p(h) = a + b·(n − 1 + h) pour h = 1..`horizon` ; au premier h où p(h) déclenche
+  la règle rouge de la Grille, un `RisqueEntreeRouge` daté de D avancée de h Jours ouvrés,
+  rendu avec la valeur projetée (`RisqueProjete`) ;
+- un indicateur inactif, sans seuil rouge, non évaluable sur la fenêtre ou d'historique
+  insuffisant est écarté avec son motif (`IndicateurExclu`).
+
+Les primitives partagées avec la Baseline (avance en Jours ouvrés, test de seuil) sont dans
+`commun` ; la vélocité nette de la Baseline n'est pas réutilisée : elle n'a pas de sens pour
+un taux de KO (IND-4).
+"""
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+"""Indicateurs projetés (FR-21), dans l'ordre de `CodeIndicateur`."""
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque d'entrée en rouge : paramètre {nom} invalide {valeur!r}"
+                    " (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée à la date de franchissement estimée."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs écartés, chacun dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+@dataclass(frozen=True)
+class _Point:
+    date: date
+    statut: StatutIndicateur
+    motif: str
+    numerateur: int
+    denominateur: int
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de `meteo.entite` datées au plus
+    D sont lues, et celles de chaque indicateur projeté actif doivent former des Jours ouvrés
+    consécutifs finissant à D. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge
+    ou si la table est invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque d'entrée en rouge {entite} : Météo rouge, non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque d'entrée en rouge {entite} : {exc}") from exc
+    table = table.filter((pl.col("entite") == entite) & (pl.col("date") <= meteo.date_arrete))
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in PROJETES:
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, f"{code} inactif dans la Grille"))
+            continue
+        seuil_rouge = regle.seuils.get(Couleur.rouge)
+        if seuil_rouge is None:
+            exclus.append(IndicateurExclu(code, f"{code} sans seuil rouge dans la Grille"))
+            continue
+        fenetre = _points(table, meteo, code)[-parametres.fenetre :]
+        non_evaluable = next(
+            (p for p in fenetre if p.statut is StatutIndicateur.non_evaluable), None
+        )
+        if non_evaluable is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"{code} non évaluable le {non_evaluable.date.isoformat()} :"
+                    f" {non_evaluable.motif}",
+                )
+            )
+            continue
+        if len(fenetre) < 2:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"{code} : historique insuffisant ({len(fenetre)} Jour ouvré,"
+                    " 2 au moins pour une régression)",
+                )
+            )
+            continue
+        operateur, seuil = seuil_rouge
+        ordonnee, pente = _regression([Fraction(p.numerateur, p.denominateur) for p in fenetre])
+        dernier = len(fenetre) - 1
+        for h in range(1, parametres.horizon + 1):
+            projetee = ordonnee + pente * (dernier + h)
+            if declenche(projetee, operateur, seuil):
+                courant = fenetre[-1]
+                risque = RisqueEntreeRouge(
+                    date_arrete=meteo.date_arrete,
+                    entite=entite,
+                    indicateur=code,
+                    date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                    horizon_jours_ouvres=parametres.horizon,
+                    numerateur=courant.numerateur,
+                    denominateur=courant.denominateur,
+                    seuil_numerateur=seuil.numerator,
+                    seuil_denominateur=seuil.denominator,
+                    version_grille=meteo.version_grille,
+                )
+                risques.append(RisqueProjete(risque=risque, valeur_projetee=projetee))
+                break
+    return ResultatRisque(risques=tuple(risques), exclus=tuple(exclus))
+
+
+def _points(table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur) -> list[_Point]:
+    """Valeurs de l'indicateur `code` de l'Entité jusqu'à D, contrôlées et dans l'ordre."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = table.filter(pl.col("code") == code.value).sort("date").to_dicts()
+    points: list[_Point] = []
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque d'entrée en rouge {entite} : {code} au {jour.isoformat()},"
+                " qui n'est pas un Jour ouvré"
+            )
+        if points and points[-1].date == jour:
+            raise UsineErreur(
+                f"Risque d'entrée en rouge {entite} : {code} en double au {jour.isoformat()}"
+            )
+        if points and jour_ouvre_suivant(points[-1].date) != jour:
+            raise UsineErreur(
+                f"Risque d'entrée en rouge {entite} : {code}, trou de Jours ouvrés entre"
+                f" {points[-1].date.isoformat()} et {jour.isoformat()}"
+            )
+        statut = StatutIndicateur(ligne["statut"])
+        if statut is StatutIndicateur.evalue and ligne["denominateur"] <= 0:
+            raise UsineErreur(
+                f"Risque d'entrée en rouge {entite} : {code} évalué au {jour.isoformat()} de"
+                f" dénominateur {ligne['denominateur']}, positif attendu"
+            )
+        points.append(
+            _Point(
+                date=jour,
+                statut=statut,
+                motif=ligne["motif"],
+                numerateur=ligne["numerateur"],
+                denominateur=ligne["denominateur"],
+            )
+        )
+    if not points or points[-1].date != arrete:
+        raise UsineErreur(
+            f"Risque d'entrée en rouge {entite} : {code} absent à la Date d'arrêté"
+            f" {arrete.isoformat()}"
+        )
+    return points
+
+
+def _regression(valeurs: Sequence[Fraction]) -> tuple[Fraction, Fraction]:
+    """Ordonnée à l'origine et pente des moindres carrés de `valeurs` en x = 0..n−1 (n ≥ 2)."""
+    n = len(valeurs)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(valeurs, Fraction(0)) / n
+    covariance = sum(((x - x_moyen) * (y - y_moyen) for x, y in enumerate(valeurs)), Fraction(0))
+    variance = sum(((x - x_moyen) ** 2 for x in range(n)), Fraction(0))
+    pente = covariance / variance
+    return y_moyen - pente * x_moyen, pente
