@@ -0,0 +1,330 @@
+"""Outils de consultation de l'Agent (Story 7.8) : lecture seule, servis par `Consultation`."""
+
+import ast
+from datetime import date, timedelta
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, cast
+
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+import usine.contrats.agent as contrats_agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.contrats.agent import (
+    AnomalieResume,
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.meteo import Couleur, EvolutionMeteo, MeteoEntite
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent import outils as module_outils
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+from usine.ports.consultation import Consultation
+
+J0 = date(2026, 10, 9)
+J1 = date(2026, 10, 8)
+ABSENTE = date(2026, 1, 5)
+NOMS_ATTENDUS = ("get_meteo", "list_anomalies", "get_tendance", "get_prevision", "get_risques")
+RESULTATS = {
+    "get_meteo": ResultatGetMeteo,
+    "list_anomalies": ResultatListAnomalies,
+    "get_tendance": ResultatGetTendance,
+    "get_prevision": ResultatGetPrevision,
+    "get_risques": ResultatGetRisques,
+}
+OUTILS_DATES = ("get_meteo", "list_anomalies", "get_prevision", "get_risques")
+
+
+def _anomalie(numero: int, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=f"DEMO-{numero}",
+        entite="ENT-A",
+        gravite=Gravite.majeure,
+        phase=Phase.recette,
+        domaine="paiements",
+        statut=statut,
+        age_jours_ouvres=numero,
+    )
+
+
+ANOMALIES = (
+    _anomalie(1, StatutAnomalie.nouvelle),
+    _anomalie(2, StatutAnomalie.en_analyse),
+    _anomalie(3, StatutAnomalie.en_analyse),
+    _anomalie(4, StatutAnomalie.en_correction),
+    _anomalie(5, StatutAnomalie.en_analyse),
+)
+
+
+class ConsultationFactice:
+    """Consultation en mémoire : seules les lectures utilisées par les outils, appels notés."""
+
+    def __init__(self, dates: tuple[date, ...] = (J1, J0)) -> None:
+        self.dates = dates
+        self.appels: list[tuple[str, dict[str, Any]]] = []
+
+    def _noter(self, nom: str, **arguments: Any) -> None:
+        self.appels.append((nom, arguments))
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self.dates
+
+    def manifeste(self) -> SimpleNamespace:
+        return SimpleNamespace(date_arrete=J0)
+
+    def meteo(
+        self, date_arrete: date | None = None, entite: str | None = None
+    ) -> tuple[MeteoEntite, ...]:
+        self._noter("meteo", date_arrete=date_arrete, entite=entite)
+        return tuple(
+            MeteoEntite(
+                date_arrete=date_arrete or J0,
+                entite=e,
+                couleur=Couleur.vert,
+                regles=(),
+                version_grille="grille",
+            )
+            for e in ("ENT-A", "ENT-B")
+            if entite in (None, e)
+        )
+
+    def evolution_meteo(self, date_arrete: date | None = None) -> tuple[EvolutionMeteo, ...]:
+        self._noter("evolution_meteo", date_arrete=date_arrete)
+        jour = date_arrete or J0
+        return tuple(
+            EvolutionMeteo(
+                entite=e,
+                date_arrete=jour,
+                couleur=Couleur.vert,
+                date_j1=jour - timedelta(days=1),
+                couleur_j1=Couleur.vert,
+                date_j5=jour - timedelta(days=7),
+                couleur_j5=None,
+            )
+            for e in ("ENT-A", "ENT-B")
+        )
+
+    def anomalies(
+        self, date_arrete: date | None = None, *args: Any, **kwargs: Any
+    ) -> ResultatListAnomalies:
+        limite = kwargs.get("limite")
+        self._noter("anomalies", date_arrete=date_arrete, limite=limite)
+        return ResultatListAnomalies(
+            date_arrete=date_arrete or J0,
+            anomalies=ANOMALIES if limite is None else ANOMALIES[:limite],
+            total=len(ANOMALIES),
+        )
+
+    def tendances(self, entite: str | None = None, code_kpi: str | None = None) -> pl.DataFrame:
+        self._noter("tendances", entite=entite, code_kpi=code_kpi)
+        return pl.DataFrame(
+            {
+                "date": [J0],
+                "perimetre": ["ENT-A"],
+                "code_kpi": ["K1"],
+                "dimension": [""],
+                "numerateur": [3],
+                "denominateur": [4],
+            }
+        )
+
+    def previsions(
+        self, date_arrete: date | None = None, entite: str | None = None
+    ) -> tuple[Any, ...]:
+        self._noter("previsions", date_arrete=date_arrete, entite=entite)
+        return ()
+
+    def risques(
+        self, date_arrete: date | None = None, entite: str | None = None
+    ) -> tuple[Any, ...]:
+        self._noter("risques", date_arrete=date_arrete, entite=entite)
+        return ()
+
+
+def _outils(factice: ConsultationFactice) -> OutilsConsultation:
+    return OutilsConsultation(cast(Consultation, factice))
+
+
+def _par_nom(factice: ConsultationFactice) -> dict[str, Any]:
+    return {o.nom: o for o in outils_consultation(cast(Consultation, factice))}
+
+
+# --- Inventaire ---
+
+
+def test_exactement_les_cinq_outils() -> None:
+    definitions = outils_consultation(cast(Consultation, ConsultationFactice()))
+    assert NOMS_OUTILS == NOMS_ATTENDUS
+    assert tuple(d.nom for d in definitions) == NOMS_ATTENDUS
+    assert all(d.description for d in definitions)
+
+
+def test_arguments_et_resultats_de_contrats_agent() -> None:
+    for definition in outils_consultation(cast(Consultation, ConsultationFactice())):
+        assert definition.arguments.__module__ == contrats_agent.__name__
+        resultat = definition.executer({})
+        assert isinstance(resultat, RESULTATS[definition.nom])
+        assert type(resultat).__module__ == contrats_agent.__name__
+
+
+# --- Lecture seule (AD-5) ---
+
+
+def test_aucun_outil_n_ecrit() -> None:
+    verbes = ("set", "create", "update", "delete", "write", "send", "post", "put", "patch")
+    publiques = {n for n in vars(OutilsConsultation) if not n.startswith("_")}
+    assert publiques == set(NOMS_ATTENDUS)
+    assert not [n for n in NOMS_OUTILS if n.split("_", 1)[0] in verbes]
+
+
+def test_aucun_port_d_ecriture_ni_jira_dans_ia_agent() -> None:
+    importes: set[str] = set()
+    for fichier in Path(module_outils.__file__).parent.glob("*.py"):
+        if fichier.stem == "cli":
+            continue
+        for noeud in ast.walk(ast.parse(fichier.read_text(encoding="utf-8"))):
+            if isinstance(noeud, ast.ImportFrom) and noeud.module:
+                importes.add(noeud.module)
+            elif isinstance(noeud, ast.Import):
+                importes |= {alias.name for alias in noeud.names}
+    internes = {m for m in importes if m.startswith("usine")}
+    assert all(m.split(".")[1] in {"contrats", "ports", "consultation"} for m in internes)
+    assert {m for m in internes if m.startswith("usine.ports")} == {"usine.ports.consultation"}
+    assert not [m for m in importes if m.startswith(("usine.adaptateurs", "httpx", "pydantic_ai"))]
+
+
+def test_url_ticket_jamais_lu() -> None:
+    factice = ConsultationFactice()
+    for definition in outils_consultation(cast(Consultation, factice)):
+        definition.executer({})
+    assert {nom for nom, _ in factice.appels} <= {
+        "meteo", "evolution_meteo", "anomalies", "tendances", "previsions", "risques",
+    }  # fmt: skip
+
+
+# --- Dates ---
+
+
+@pytest.mark.parametrize("nom", OUTILS_DATES)
+def test_date_absente_prend_celle_du_manifeste(nom: str) -> None:
+    resultat = _par_nom(ConsultationFactice())[nom].executer({})
+    assert resultat.date_arrete == J0
+
+
+@pytest.mark.parametrize("nom", OUTILS_DATES)
+def test_date_disponible(nom: str) -> None:
+    factice = ConsultationFactice()
+    resultat = _par_nom(factice)[nom].executer({"date_arrete": J1.isoformat()})
+    assert isinstance(resultat, RESULTATS[nom])
+    assert resultat.date_arrete == J1
+    assert all(arguments["date_arrete"] == J1 for _, arguments in factice.appels)
+
+
+@pytest.mark.parametrize("nom", OUTILS_DATES)
+def test_date_sans_passage(nom: str) -> None:
+    factice = ConsultationFactice()
+    resultat = _par_nom(factice)[nom].executer({"date_arrete": ABSENTE.isoformat()})
+    assert resultat == AucuneDonnee(date_arrete=ABSENTE)
+    assert resultat.message == "aucune donnée pour cette date"
+    assert factice.appels == []
+
+
+@pytest.mark.parametrize("nom", OUTILS_DATES)
+def test_passage_sans_aucune_date(nom: str) -> None:
+    resultat = _par_nom(ConsultationFactice(dates=()))[nom].executer({})
+    assert resultat == AucuneDonnee(date_arrete=None)
+
+
+def test_tendance_sans_date_jamais_aucune_donnee() -> None:
+    factice = ConsultationFactice(dates=())
+    resultat = _outils(factice).get_tendance(ArgumentsGetTendance(entite="ENT-A", code_kpi="K1"))
+    assert isinstance(resultat, ResultatGetTendance)
+    assert [(p.code_kpi, p.numerateur, p.denominateur) for p in resultat.points] == [("K1", 3, 4)]
+    assert factice.appels == [("tendances", {"entite": "ENT-A", "code_kpi": "K1"})]
+
+
+# --- Filtres ---
+
+
+def test_meteo_filtree_par_entite() -> None:
+    resultat = _outils(ConsultationFactice()).get_meteo(ArgumentsGetMeteo(entite="ENT-B"))
+    assert isinstance(resultat, ResultatGetMeteo)
+    assert [m.entite for m in resultat.meteos] == ["ENT-B"]
+    assert [e.entite for e in resultat.evolutions] == ["ENT-B"]
+
+
+def test_anomalies_sans_statut_limite_par_consultation() -> None:
+    factice = ConsultationFactice()
+    resultat = _outils(factice).list_anomalies(ArgumentsListAnomalies(limite=2))
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert [a.cle_ticket for a in resultat.anomalies] == ["DEMO-1", "DEMO-2"]
+    assert resultat.total == 5
+    assert factice.appels == [("anomalies", {"date_arrete": J0, "limite": 2})]
+
+
+def test_anomalies_filtrees_par_statut() -> None:
+    factice = ConsultationFactice()
+    resultat = _outils(factice).list_anomalies(
+        ArgumentsListAnomalies(statut=StatutAnomalie.en_analyse, limite=2)
+    )
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert [a.cle_ticket for a in resultat.anomalies] == ["DEMO-2", "DEMO-3"]
+    assert resultat.total == 3
+    assert factice.appels == [("anomalies", {"date_arrete": J0, "limite": None})]
+
+
+@pytest.mark.parametrize(
+    "arguments",
