@@ -0,0 +1,182 @@
+"""Outils de consultation de l'Agent, en lecture seule (FR-39, FR-41, AD-5, AD-11).
+
+Chaque outil prend un `Arguments*` de `contrats.agent` et rend le `Resultat*` lu par le seul
+port `Consultation`, ou `AucuneDonnee` quand le Passage ne couvre pas la Date d'arrêté
+demandée. Aucun chiffre n'est calculé ici : le filtre `statut` ne fait que sélectionner des
+lignes. La sérialisation, la Pseudonymisation et la trace reviennent à la passerelle.
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS = ("get_meteo", "list_anomalies", "get_tendance", "get_prevision", "get_risques")
+"""Noms des outils exposés à l'Agent, dans l'ordre de `outils_consultation`."""
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Outil avant enveloppe : la passerelle (Story 7.9) en fait un `OutilAgent`.
+
+    `executer` valide les arguments JSON par `arguments.model_validate` (une
+    `ValidationError` remonte) et rend le résultat typé.
+    """
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+
+
+class OutilsConsultation:
+    """Les cinq outils de l'Agent, servis par une `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _jour(self, date_arrete: date | None) -> date | AucuneDonnee:
+        """Date d'arrêté couverte par le Passage, sinon `AucuneDonnee`."""
+        dates = self._consultation.dates_disponibles()
+        if not dates:
+            return AucuneDonnee(date_arrete=date_arrete)
+        jour = (
+            date_arrete if date_arrete is not None else self._consultation.manifeste().date_arrete
+        )
+        if jour not in dates:
+            return AucuneDonnee(date_arrete=jour)
+        return jour
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        evolutions = self._consultation.evolution_meteo(jour)
+        if arguments.entite is not None:
+            evolutions = tuple(e for e in evolutions if e.entite == arguments.entite)
+        return ResultatGetMeteo(
+            date_arrete=jour,
+            meteos=self._consultation.meteo(jour, arguments.entite),
+            evolutions=evolutions,
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées ; `total` les compte avant la limite."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        # Filtré par statut, le résultat est lu entier puis borné ici, pour que `total` compte
+        # les seules Anomalies retenues.
+        toutes = self._consultation.anomalies(
+            jour,
+            arguments.entite,
+            arguments.gravite,
+            arguments.phase,
+            arguments.domaine,
+            limite=arguments.limite if arguments.statut is None else None,
+        )
+        if arguments.statut is None:
+            return toutes
+        retenues = tuple(a for a in toutes.anomalies if a.statut == arguments.statut)
+        return ResultatListAnomalies(
+            date_arrete=toutes.date_arrete,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire ; sans date, jamais `AucuneDonnee`."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        return ResultatGetTendance(
+            points=tuple(
+                PointTendance.model_validate(ligne) for ligne in table.iter_rows(named=True)
+            )
+        )
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetPrevision(
+            date_arrete=jour, previsions=self._consultation.previsions(jour, arguments.entite)
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if isinstance(jour, AucuneDonnee):
+            return jour
+        return ResultatGetRisques(
+            date_arrete=jour, risques=self._consultation.risques(jour, arguments.entite)
+        )
+
+
+def _definition[A: Enregistrement](
+    nom: str, description: str, arguments: type[A], methode: Callable[[A], Enregistrement]
+) -> DefinitionOutil:
+    def executer(valeurs: Mapping[str, Any]) -> Enregistrement:
+        return methode(arguments.model_validate(valeurs))
+
+    return DefinitionOutil(nom, description, arguments, executer)
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Définitions des cinq outils, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+    return (
+        _definition(
+            "get_meteo",
+            "Météo par Entité, Règles déclenchantes et évolution J-1 / J-5, à une Date"
+            " d'arrêté (par défaut celle du Passage).",
+            ArgumentsGetMeteo,
+            outils.get_meteo,
+        ),
+        _definition(
+            "list_anomalies",
+            "Anomalies ouvertes, filtrées par Entité, Gravité, Phase, domaine et statut ;"
+            " `total` compte les Anomalies filtrées avant la limite.",
+            ArgumentsListAnomalies,
+            outils.list_anomalies,
+        ),
+        _definition(
+            "get_tendance",
+            "Tendances hebdomadaires des KPI, filtrées par Entité et par code KPI.",
+            ArgumentsGetTendance,
+            outils.get_tendance,
+        ),
+        _definition(
+            "get_prevision",
+            "Prévisions de sortie du rouge par Entité, à une Date d'arrêté.",
+            ArgumentsGetPrevision,
+            outils.get_prevision,
+        ),
+        _definition(
+            "get_risques",
+            "Risques d'entrée en rouge par Entité, à une Date d'arrêté.",
+            ArgumentsGetRisques,
+            outils.get_risques,
+        ),
+    )
