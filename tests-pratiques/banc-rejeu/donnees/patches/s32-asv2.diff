@@ -0,0 +1,287 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11, AD-10)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.adaptateurs.journal import SourceJournal
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jour_ouvre_de, jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+
+LUNDI = date(2026, 10, 5)
+MARDI = date(2026, 10, 6)
+MERCREDI = date(2026, 10, 7)
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, dates: tuple[date, ...], entites: list[str] | None = None) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, dates), entites or ENTITES)
+
+
+def _mesure(
+    table: pl.DataFrame, code: str, perimetre: str, jour: date, dimension: str = ""
+) -> tuple[int, int]:
+    lignes = table.filter(
+        (pl.col("code_kpi") == code)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("date") == jour)
+        & (pl.col("dimension") == dimension)
+    )
+    assert lignes.height == 1, (code, perimetre, jour, dimension)
+    return lignes.item(0, "numerateur"), lignes.item(0, "denominateur")
+
+
+def _cas_de_test(flux: Flux, cle: str, statut: str, phase: str = "recette") -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(5),
+        {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: phase},
+    )
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), entite="ENT-A")
+    flux.anomalie("DEMO-2", _ts(5), entite="ENT-A")
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure")
+    flux.transition("DEMO-3", _ts(5, 10), "nouvelle", "fermee")
+    table = _kpi(flux, (LUNDI,))
+    for perimetre, attendu in (("ENT-A", 2), ("ENT-B", 0), (PERIMETRE_PROGRAMME, 2)):
+        assert _mesure(table, "anomalies_ouvertes", perimetre, LUNDI) == (attendu, 1)
+    assert _mesure(table, "anomalies_ouvertes_gravite", "ENT-A", LUNDI, "bloquante") == (2, 1)
+    assert _mesure(table, "anomalies_ouvertes_gravite", "ENT-A", LUNDI, "majeure") == (0, 1)
+    assert _mesure(table, "anomalies_ouvertes_gravite", PERIMETRE_PROGRAMME, LUNDI, "majeure") == (
+        0,
+        1,
+    )
+    assert _mesure(table, "anomalies_ouvertes_phase", "ENT-A", LUNDI, "recette") == (2, 1)
+    assert _mesure(table, "anomalies_ouvertes_phase", "ENT-A", LUNDI, "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 9), "fermee", "a_retester")
+    flux.transition("DEMO-1", _ts(7, 10), "a_retester", "fermee")
+    table = _kpi(flux, (LUNDI, MARDI, MERCREDI))
+    entrees = [_mesure(table, "entrees_jour", "ENT-A", j)[0] for j in (LUNDI, MARDI, MERCREDI)]
+    sorties = [_mesure(table, "sorties_jour", "ENT-A", j)[0] for j in (LUNDI, MARDI, MERCREDI)]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+    assert _mesure(table, "entrees_jour", PERIMETRE_PROGRAMME, MERCREDI) == (1, 1)
+
+
+def test_creee_et_fermee_le_meme_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(5, 10), "nouvelle", "fermee")
+    table = _kpi(flux, (LUNDI,))
+    assert _mesure(table, "entrees_jour", "ENT-A", LUNDI) == (1, 1)
+    assert _mesure(table, "sorties_jour", "ENT-A", LUNDI) == (1, 1)
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    dates = jours_ouvres(date(2026, 10, 5), date(2026, 10, 13))
+    assert len(dates) == 7
+    for jour in dates:
+        flux.anomalie(f"DEMO-{jour.day}", _ts(jour.day))
+    flux.transition("DEMO-5", _ts(6), "nouvelle", "fermee")
+    table = _kpi(flux, dates)
+    entrees = [_mesure(table, "entrees_fenetre", "ENT-A", j)[0] for j in dates]
+    assert entrees == [1, 2, 3, 4, 5, 5, 5]
+    sorties = [_mesure(table, "sorties_fenetre", "ENT-A", j)[0] for j in dates]
+    assert sorties == [0, 1, 1, 1, 1, 1, 0]
+
+
+def test_age_depuis_la_derniere_entree() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    mercredi = date(2026, 10, 7)
+    table = _kpi(flux, jours_ouvres(date(2026, 10, 1), mercredi))
+    for perimetre in ("ENT-A", PERIMETRE_PROGRAMME):
+        assert _mesure(table, "age_median_anomalies_ouvertes", perimetre, mercredi) == (7, 2)
+        assert _mesure(table, "age_max_anomalies_ouvertes", perimetre, mercredi) == (4, 1)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(7), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(12), "fermee", "a_retester")
+    j6 = date(2026, 10, 13)
+    table = _kpi(flux, jours_ouvres(LUNDI, j6))
+    assert _mesure(table, "age_median_anomalies_ouvertes", "ENT-A", j6) == (1, 1)
+    assert _mesure(table, "age_max_anomalies_ouvertes", "ENT-A", j6) == (1, 1)
+
+
+def test_aucune_anomalie_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(5, 10), "nouvelle", "rejetee")
+    table = _kpi(flux, (LUNDI,))
+    assert _mesure(table, "age_median_anomalies_ouvertes", "ENT-A", LUNDI) == (0, 0)
+    assert _mesure(table, "age_max_anomalies_ouvertes", "ENT-A", LUNDI) == (0, 0)
+    assert _mesure(table, "age_max_anomalies_ouvertes", "ENT-B", LUNDI) == (0, 0)
+
+
+def test_taux_de_cas_de_test() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["ok"] * 3 + ["ko"] + ["non_execute"] * 2):
+        _cas_de_test(flux, f"DEMO-{i + 1}", statut)
+    table = _kpi(flux, (LUNDI,))
+    assert _mesure(table, "taux_ko_cas_de_test", "ENT-A", LUNDI, "recette") == (1, 4)
+    assert _mesure(table, "taux_non_execution_cas_de_test", "ENT-A", LUNDI, "recette") == (2, 6)
+    assert _mesure(table, "taux_ko_cas_de_test", PERIMETRE_PROGRAMME, LUNDI, "recette") == (1, 4)
+    assert _mesure(table, "taux_ko_cas_de_test", "ENT-A", LUNDI, "tnr") == (0, 0)
+    assert _mesure(table, "taux_non_execution_cas_de_test", "ENT-B", LUNDI, "recette") == (0, 0)
+
+
+def test_certifications_par_statut() -> None:
+    flux = Flux()
+    for cle, statut in (("DEMO-1", "accordee"), ("DEMO-2", "reservee"), ("DEMO-3", "reservee")):
+        flux.creer(
+            cle,
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    table = _kpi(flux, (LUNDI,))
