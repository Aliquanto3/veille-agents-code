+def test_conservation_sur_le_journal_genere(tmp_path: Path) -> None:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generer(config, 42, date(2026, 10, 12))))
+    source = SourceJournal(chemin)
+    evenements = list(source.evenements())
+    debut = min(jour_ouvre_de(e.horodatage) for e in evenements)
+    dates = jours_ouvres(debut, source.entete.date_injection)
+    entites = [e.code for e in config.entites]
+    table = kpi(tickets_etats(evenements, dates), entites)
+    for perimetre in (*entites, PERIMETRE_PROGRAMME):
+        for veille, jour in zip(dates, dates[1:], strict=False):
+            stock = _mesure(table, "anomalies_ouvertes", perimetre, jour)[0]
+            stock_veille = _mesure(table, "anomalies_ouvertes", perimetre, veille)[0]
+            entrees = _mesure(table, "entrees_jour", perimetre, jour)[0]
+            sorties = _mesure(table, "sorties_jour", perimetre, jour)[0]
+            assert stock - stock_veille == entrees - sorties, (perimetre, jour)
