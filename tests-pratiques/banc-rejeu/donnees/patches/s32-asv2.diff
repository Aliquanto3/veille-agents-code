+def test_programme_somme_des_entites() -> None:
+    flux, dates = _scenario()
+    table = _kpi(flux, dates)
+    comptes = table.filter(
+        ~pl.col("code_kpi").str.starts_with("age_")
+        & ~pl.col("code_kpi").str.starts_with("taux_")
+    )
+    somme = (
+        comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by("date", "code_kpi", "dimension")
+        .agg(pl.col("numerateur").sum())
+        .sort("date", "code_kpi", "dimension")
+    )
+    programme = (
+        comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME)
+        .select("date", "code_kpi", "dimension", "numerateur")
+        .sort("date", "code_kpi", "dimension")
+    )
+    assert somme.equals(programme)
+
+
+def test_stock_egal_a_l_instantane() -> None:
+    flux, dates = _scenario()
+    etats = tickets_etats(flux.evenements, dates)
+    table = kpi(etats, ENTITES)
+    fermes = {statut.value for statut in STATUTS_FERMES}
+    for jour in dates:
+        ouvertes = (
+            instantane(etats)
+            .filter(
+                (pl.col("date") == jour)
+                & (pl.col("type_ticket") == TypeTicket.anomalie.value)
+                & ~pl.col("statut").cast(pl.Utf8).is_in(fermes)
+            )
+            .get_column("nombre")
+            .sum()
+        )
+        assert _mesure(table, "anomalies_ouvertes", PERIMETRE_PROGRAMME, jour) == (ouvertes, 1)
+
+
+def test_determinisme() -> None:
+    flux, dates = _scenario()
+    etats = tickets_etats(flux.evenements, dates)
+    premier, second = kpi(etats, ENTITES), kpi(etats, ENTITES)
+    assert premier.equals(second)
+    assert premier.sort("date", maintain_order=True).equals(premier)
