+def test_schema_dense_et_sans_flottant() -> None:
+    flux, dates = _scenario()
+    table = _kpi(flux, dates)
+    valider(table, SCHEMA_KPI)
+    par_perimetre = sum(len(dimensions) for dimensions in DIMENSIONS_KPI.values())
+    assert table.height == len(dates) * 3 * par_perimetre
+    assert not any(dtype.is_float() for dtype in table.schema.values())
+    assert table.get_column("code_kpi").unique().sort().to_list() == sorted(CODES_KPI)
+    assert table.filter(pl.col("denominateur") < 0).height == 0
+
