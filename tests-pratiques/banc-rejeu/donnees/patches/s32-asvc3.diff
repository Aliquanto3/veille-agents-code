+def test_journal_stock_egal_instantane(journal_genere: tuple[pl.DataFrame, pl.DataFrame]) -> None:
+    etats, table = journal_genere
+    inst = valider(instantane(etats), SCHEMA_INSTANTANE)
+    ouvertes = (
+        inst.filter(
+            (pl.col("type_ticket") == TypeTicket.anomalie.value)
+            & ~pl.col("statut").cast(pl.Utf8).is_in([s.value for s in STATUTS_FERMES])
+        )
+        .group_by("date")
+        .agg(pl.col("nombre").sum())
+    )
+    stock = table.filter(
+        (pl.col("perimetre") == PERIMETRE_PROGRAMME) & (pl.col("code_kpi") == "anomalies_ouvertes")
+    ).select("date", pl.col("numerateur").alias("stock"))
+    joint = stock.join(ouvertes, on="date", how="left").with_columns(pl.col("nombre").fill_null(0))
+    assert joint.filter(pl.col("stock") != pl.col("nombre")).is_empty()
