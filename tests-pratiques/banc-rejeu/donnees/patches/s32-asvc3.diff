+def test_journal_conservation_du_stock(journal_genere: tuple[pl.DataFrame, pl.DataFrame]) -> None:
+    _, table = journal_genere
+
+    def serie(code: str) -> list[int]:
+        return (
+            table.filter((pl.col("perimetre") == PERIMETRE_PROGRAMME) & (pl.col("code_kpi") == code))
+            .sort("date")["numerateur"]
+            .to_list()
+        )
+
+    stock, entrees, sorties = (
+        serie("anomalies_ouvertes"),
+        serie("entrees_jour"),
+        serie("sorties_jour"),
+    )
+    assert sum(entrees) > 0
+    precedent = 0
+    for s, e, so in zip(stock, entrees, sorties, strict=True):
+        assert s - precedent == e - so
+        precedent = s
