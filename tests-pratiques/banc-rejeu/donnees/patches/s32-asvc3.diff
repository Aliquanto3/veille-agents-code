+"""KPI quotidiens (Story 3.2, FR-11, AD-9, AD-10, H-17, H-19)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_INSTANTANE, SCHEMA_KPI
+from usine.contrats.calendrier import jour_ouvre_de, jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _d(jour: int) -> date:
+    return date(2026, 10, jour)
+
+
+def _kpi(
+    flux: Flux, jours: list[int], entites: list[str] | None = None
+) -> dict[tuple[date, str, str, str], tuple[int, int]]:
+    etats = tickets_etats(flux.evenements, [_d(j) for j in jours])
+    table = kpi(etats, ENTITES if entites is None else entites)
+    return {
+        (d, p, c, dim): (n, den)
+        for d, p, c, dim, n, den in table.select(
+            "date", "perimetre", "code_kpi", "dimension", "numerateur", "denominateur"
+        ).iter_rows()
+    }
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(1))
+    flux.anomalie("DEMO-3", _ts(1), entite="ENT-B", gravite="majeure")
+    flux.transition("DEMO-3", _ts(1, 10), "nouvelle", "fermee")
+    k = _kpi(flux, [1])
+    d = _d(1)
+    assert k[(d, "ENT-A", "anomalies_ouvertes", "")] == (2, 1)
+    assert k[(d, "ENT-B", "anomalies_ouvertes", "")] == (0, 1)
+    assert k[(d, PERIMETRE_PROGRAMME, "anomalies_ouvertes", "")] == (2, 1)
+    assert k[(d, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "bloquante")] == (2, 1)
+    assert k[(d, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "majeure")] == (0, 1)
+    assert k[(d, "ENT-A", "anomalies_ouvertes_phase", "recette")] == (2, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 8), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(7, 10), "en_analyse", "fermee")
+    k = _kpi(flux, [5, 6, 7])
+    entrees = [k[(_d(j), "ENT-A", "entrees_jour", "")][0] for j in (5, 6, 7)]
+    sorties = [k[(_d(j), "ENT-A", "sorties_jour", "")][0] for j in (5, 6, 7)]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    jours = [1, 2, 5, 6, 7, 8, 9]
+    for i, j in enumerate(jours, start=1):
+        flux.anomalie(f"DEMO-{i}", _ts(j))
+    flux.transition("DEMO-1", _ts(9), "nouvelle", "fermee")
+    k = _kpi(flux, jours)
+    assert k[(_d(1), "ENT-A", "entrees_fenetre", "")] == (1, 1)
+    assert k[(_d(7), "ENT-A", "entrees_fenetre", "")] == (5, 1)
+    # Fenêtre du 9 : 5, 6, 7, 8, 9 (le 1 et le 2 sortent)
+    assert k[(_d(9), "ENT-A", "entrees_fenetre", "")] == (5, 1)
+    assert k[(_d(9), "ENT-A", "sorties_fenetre", "")] == (1, 1)
+    assert k[(_d(8), "ENT-A", "sorties_fenetre", "")] == (0, 1)
+
+
+def test_age_median_et_maximum() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    k = _kpi(flux, [1, 2, 5, 6, 7])
+    assert k[(_d(7), "ENT-A", "age_median_anomalies_ouvertes", "")] == (7, 2)
+    assert k[(_d(7), "ENT-A", "age_max_anomalies_ouvertes", "")] == (4, 1)
+    assert k[(_d(1), "ENT-A", "age_median_anomalies_ouvertes", "")] == (0, 1)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")
+    k = _kpi(flux, [1, 2, 5, 6, 7, 8, 9])
+    assert k[(_d(9), "ENT-A", "age_max_anomalies_ouvertes", "")] == (1, 1)
+    assert k[(_d(8), "ENT-A", "age_max_anomalies_ouvertes", "")] == (0, 1)
+
+
+def test_aucune_anomalie_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.transition("DEMO-1", _ts(1, 10), "nouvelle", "rejetee")
+    k = _kpi(flux, [1])
+    assert k[(_d(1), "ENT-A", "age_median_anomalies_ouvertes", "")] == (0, 0)
+    assert k[(_d(1), "ENT-A", "age_max_anomalies_ouvertes", "")] == (0, 0)
+    assert k[(_d(1), "ENT-B", "age_max_anomalies_ouvertes", "")] == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["ok", "ok", "ok", "ko", "non_execute", "non_execute"], start=1):
+        flux.creer(
+            f"DEMO-{i}",
+            TypeTicket.cas_de_test,
+            _ts(1),
+            {Champ.entite: "ENT-A", Champ.phase: "recette", Champ.statut_test: statut},
+        )
+    k = _kpi(flux, [1])
+    assert k[(_d(1), "ENT-A", "taux_ko_cas_de_test", "recette")] == (1, 4)
+    assert k[(_d(1), "ENT-A", "taux_non_execution_cas_de_test", "recette")] == (2, 6)
+    assert k[(_d(1), "ENT-A", "taux_ko_cas_de_test", "tnr")] == (0, 0)
+    assert k[(_d(1), "ENT-A", "taux_non_execution_cas_de_test", "tnr")] == (0, 0)
+    assert k[(_d(1), PERIMETRE_PROGRAMME, "taux_ko_cas_de_test", "recette")] == (1, 4)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["accordee", "reservee", "reservee"], start=1):
+        flux.creer(
+            f"DEMO-{i}",
+            TypeTicket.certification,
+            _ts(1),
+            {Champ.entite: "ENT-A", Champ.statut_certification: statut},
+        )
+    k = _kpi(flux, [1])
+    assert k[(_d(1), "ENT-A", "certifications", "accordee")] == (1, 1)
+    assert k[(_d(1), "ENT-A", "certifications", "reservee")] == (2, 1)
+    assert k[(_d(1), "ENT-A", "certifications", "refusee")] == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [_d(5), _d(7)])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+def test_entites_invalides() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [_d(5)])
+    with pytest.raises(UsineErreur, match="ENT-A"):
+        kpi(etats, ["ENT-A", "ENT-A"])
+    with pytest.raises(UsineErreur, match=PERIMETRE_PROGRAMME):
+        kpi(etats, ["ENT-A", PERIMETRE_PROGRAMME])
+
+
+def test_table_vide() -> None:
+    table = kpi(tickets_etats([], []), ENTITES)
+    assert table.is_empty()
+    assert table.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+
+
+def test_sortie_dense_ordonnee_et_sans_flottant() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(6), entite="ENT-HORS")
+    etats = tickets_etats(flux.evenements, [_d(5), _d(6)])
+    table = kpi(etats, ["ENT-B", "ENT-A"])
+    valider(table, SCHEMA_KPI)
+    assert not any(t.is_float() for t in table.schema.values())
+    par_perimetre = sum(len(dims) for dims in DIMENSIONS_KPI.values())
+    assert table.height == 2 * 3 * par_perimetre
+    premier = table.filter(pl.col("date") == _d(5))
+    assert premier["perimetre"].unique(maintain_order=True).to_list() == [
+        "ENT-B",
+        "ENT-A",
+        PERIMETRE_PROGRAMME,
+    ]
+    assert premier.filter(pl.col("perimetre") == "ENT-B")["code_kpi"].unique(
+        maintain_order=True
+    ).to_list() == list(CODES_KPI)
+    certifs = premier.filter(
+        (pl.col("perimetre") == "ENT-B") & (pl.col("code_kpi") == "certifications")
+    )
+    assert certifs["dimension"].to_list() == ["accordee", "reservee", "refusee"]
+    # L'Entité hors `entites` ne compte que dans le Programme.
+    k = {
+        (d, p): n
+        for d, p, c, n in table.filter(pl.col("code_kpi") == "anomalies_ouvertes")
+        .select("date", "perimetre", "code_kpi", "numerateur")
+        .iter_rows()
+    }
+    assert k[(_d(6), PERIMETRE_PROGRAMME)] == 2
+    assert k[(_d(6), "ENT-A")] == 1
+    assert table.equals(kpi(etats, ["ENT-B", "ENT-A"]))
+
+
+@pytest.fixture(scope="module")
+def journal_genere() -> tuple[pl.DataFrame, pl.DataFrame]:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    generation = generer(config, 42, date(2026, 10, 12))
+    debut = jour_ouvre_de(min(e.horodatage for e in generation.evenements))
+    jours = jours_ouvres(debut, generation.entete.date_injection)
+    etats = tickets_etats(generation.evenements, jours)
+    entites = sorted({e for e in etats["entite"].drop_nulls().unique().to_list()})
+    return etats, kpi(etats, entites)
+
+
+def test_journal_programme_somme_des_entites(
+    journal_genere: tuple[pl.DataFrame, pl.DataFrame],
+) -> None:
+    etats, table = journal_genere
+    valider(table, SCHEMA_KPI)
+    comptes = table.filter(
+        pl.col("code_kpi").is_in(
+            [c for c in CODES_KPI if not c.startswith(("age_", "taux_"))]
+        )
+    )
+    entites = comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+    somme = (
+        entites.group_by("date", "code_kpi", "dimension")
+        .agg(pl.col("numerateur").sum().alias("somme"))
+    )
+    programme = comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME)
+    joint = programme.join(somme, on=["date", "code_kpi", "dimension"])
+    assert joint.height == programme.height
+    assert joint.filter(pl.col("numerateur") != pl.col("somme")).is_empty()
+    assert etats.height > 0
