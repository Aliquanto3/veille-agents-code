@@ -0,0 +1,238 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : les états des tickets de chaque Jour ouvré et les Entités arrivent en paramètre.
+Entrée, Sortie et Anomalie ouverte suivent le Glossaire (H-17), la Fenêtre glissante vient de
+`contrats.calendrier` (H-19). Aucun flottant : comptes en `n/1`, taux et âges en
+`numerateur` / `denominateur` entiers, `0/0` quand il n'y a pas de valeur.
+"""
+
+from collections import defaultdict
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import (
+    fenetre_glissante,
+    jour_ouvre_precedent,
+    jours_ouvres,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des KPI, dans l'ordre des lignes de sortie."""
+
+_GRAVITES = tuple(g.value for g in Gravite)
+_PHASES = tuple(p.value for p in Phase)
+_CERTIFICATIONS = tuple(s.value for s in StatutCertification)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "anomalies_ouvertes": ("",),
+        "anomalies_ouvertes_gravite": _GRAVITES,
+        "anomalies_ouvertes_phase": _PHASES,
+        "entrees_jour": ("",),
+        "sorties_jour": ("",),
+        "entrees_fenetre": ("",),
+        "sorties_fenetre": ("",),
+        "age_median_anomalies_ouvertes": ("",),
+        "age_max_anomalies_ouvertes": ("",),
+        "taux_ko_cas_de_test": _PHASES,
+        "taux_non_execution_cas_de_test": _PHASES,
+        "certifications": _CERTIFICATIONS,
+    }
+)
+"""Valeurs de `dimension` de chaque KPI, dans l'ordre de sortie (`""` : non ventilé)."""
+
+_FERMES = frozenset(statut.value for statut in STATUTS_FERMES)
+
+_Cle = tuple[str, str]
+"""(code, dimension)."""
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité {PERIMETRE_PROGRAMME} réservée au périmètre du Programme : "
+            "valeur refusée dans les Entités demandées"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Les dates doivent être chaque Jour ouvré de la première à la dernière."""
+    attendues = jours_ouvres(dates[0], dates[-1])
+    presentes = set(dates)
+    for jour in attendues:
+        if jour not in presentes:
+            raise UsineErreur(
+                f"KPI : date {jour.isoformat()} absente de l'état des tickets reçu "
+                "(chaque Jour ouvré de la première à la dernière date est attendu)"
+            )
+    if tuple(dates) != attendues:
+        intrus = sorted(presentes - set(attendues))
+        raison = f" : {intrus[0].isoformat()} n'est pas un Jour ouvré" if intrus else ""
+        raise UsineErreur(f"KPI : dates de l'état des tickets invalides{raison}")
+
+
+def _mediane(ages: list[int]) -> Fraction:
+    ordonnes = sorted(ages)
+    milieu = len(ordonnes) // 2
+    if len(ordonnes) % 2:
+        return Fraction(ordonnes[milieu])
+    return Fraction(ordonnes[milieu - 1] + ordonnes[milieu], 2)
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : une ligne par date, périmètre, code et dimension (sortie dense).
+
+    Périmètres : chaque Entité de `entites` (dans l'ordre), puis `PROGRAMME`, qui agrège toutes
+    les lignes de la table. Un mouvement est rattaché à l'Entité du ticket à la date. Pour une
+    Anomalie, `E = 1` si `date_derniere_entree == D` et `S = E − (ouvert(D) − ouvert(D−1))`.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date ;
+    à la première, la veille est vide (début de l'historique).
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    if etats.is_empty():
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = sorted(etats.get_column("date").unique().to_list())
+    _verifier_dates(dates)
+
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    valeurs: dict[tuple[date, str], dict[_Cle, int]] = defaultdict(lambda: defaultdict(int))
+    ages: dict[tuple[date, str], list[int]] = defaultdict(list)
+    ages_par_entree: dict[tuple[date, date], int] = {}
+    ouvert_veille: dict[str, bool] = {}
+
+    for jour, groupe in etats.partition_by("date", as_dict=True, maintain_order=True).items():
+        d = jour[0]
+        assert isinstance(d, date)
+        ouvert_jour: dict[str, bool] = {}
+        for ligne in groupe.iter_rows(named=True):
+            entite = ligne["entite"]
+            cibles = [PERIMETRE_PROGRAMME]
+            if entite in entites:
+                cibles.append(entite)
+            cumul = [valeurs[(d, p)] for p in cibles]
+            type_ticket = ligne["type_ticket"]
+            if type_ticket == TypeTicket.anomalie.value:
+                statut = ligne["statut"]
+                ouvert = statut is not None and statut not in _FERMES
+                ouvert_jour[ligne["cle_ticket"]] = ouvert
+                entree = ligne["date_derniere_entree"]
+                e = 1 if entree == d else 0
+                s = e - (int(ouvert) - int(ouvert_veille.get(ligne["cle_ticket"], False)))
+                for c in cumul:
+                    c[("entrees_jour", "")] += e
+                    c[("sorties_jour", "")] += s
+                if ouvert:
+                    if (entree, d) not in ages_par_entree:
+                        ages_par_entree[(entree, d)] = len(jours_ouvres(entree, d)) - 1
+                    age = ages_par_entree[(entree, d)]
+                    for p in cibles:
+                        ages[(d, p)].append(age)
+                    for c in cumul:
+                        c[("anomalies_ouvertes", "")] += 1
+                        if ligne["gravite"] is not None:
+                            c[("anomalies_ouvertes_gravite", ligne["gravite"])] += 1
+                        if ligne["phase"] is not None:
+                            c[("anomalies_ouvertes_phase", ligne["phase"])] += 1
+            elif type_ticket == TypeTicket.cas_de_test.value:
+                statut_test = ligne["statut_test"]
+                phase = ligne["phase"]
+                if statut_test is not None and phase is not None:
+                    for c in cumul:
+                        c[("tests", f"{phase}/{statut_test}")] += 1
+            elif ligne["statut_certification"] is not None:
+                for c in cumul:
+                    c[("certifications", ligne["statut_certification"])] += 1
+        ouvert_veille = ouvert_jour
+
+    fenetres = {d: fenetre_glissante(d) for d in dates}
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+
+    def ajouter(d: date, perimetre: str, code: str, dimension: str, n: int, den: int) -> None:
+        lignes["date"].append(d)
+        lignes["perimetre"].append(perimetre)
+        lignes["code_kpi"].append(code)
+        lignes["dimension"].append(dimension)
+        lignes["numerateur"].append(n)
+        lignes["denominateur"].append(den)
+
+    for d in dates:
+        for perimetre in perimetres:
+            v = valeurs[(d, perimetre)]
+            age_du_jour = ages[(d, perimetre)]
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    if code in ("entrees_fenetre", "sorties_fenetre"):
+                        jour_code = code.replace("fenetre", "jour")
+                        n = sum(
+                            valeurs[(j, perimetre)][(jour_code, "")]
+                            for j in fenetres[d]
+                            if (j, perimetre) in valeurs
+                        )
+                        ajouter(d, perimetre, code, dimension, n, 1)
+                    elif code == "age_median_anomalies_ouvertes":
+                        m = _mediane(age_du_jour) if age_du_jour else Fraction(0, 1)
+                        ajouter(
+                            d,
+                            perimetre,
+                            code,
+                            dimension,
+                            m.numerator if age_du_jour else 0,
+                            m.denominator if age_du_jour else 0,
+                        )
+                    elif code == "age_max_anomalies_ouvertes":
+                        ajouter(
+                            d,
+                            perimetre,
+                            code,
+                            dimension,
+                            max(age_du_jour, default=0),
+                            1 if age_du_jour else 0,
+                        )
+                    elif code == "taux_ko_cas_de_test":
+                        ok = v[("tests", f"{dimension}/{StatutTest.ok.value}")]
+                        ko = v[("tests", f"{dimension}/{StatutTest.ko.value}")]
+                        ajouter(d, perimetre, code, dimension, ko, ok + ko)
+                    elif code == "taux_non_execution_cas_de_test":
+                        par_statut = [
+                            v[("tests", f"{dimension}/{s.value}")] for s in StatutTest
+                        ]
+                        ne = v[("tests", f"{dimension}/{StatutTest.non_execute.value}")]
+                        ajouter(d, perimetre, code, dimension, ne, sum(par_statut))
+                    else:
+                        ajouter(d, perimetre, code, dimension, v[(code, dimension)], 1)
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
