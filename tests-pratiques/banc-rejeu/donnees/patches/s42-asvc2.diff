+def test_avancer_defini_uniquement_dans_commun() -> None:
+    motif = re.compile(r"^\s*def\s+_?avancer\s*\(")
+    definitions = [
+        chemin.relative_to(RACINE).as_posix()
+        for chemin in sorted((RACINE / "src" / "usine" / "domaine" / "prevision").rglob("*.py"))
+        if any(motif.match(ligne) for ligne in chemin.read_text("utf-8").splitlines())
+    ]
+    assert definitions == ["src/usine/domaine/prevision/commun.py"]
