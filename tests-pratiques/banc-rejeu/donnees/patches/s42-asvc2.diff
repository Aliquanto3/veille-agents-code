+def test_lignes_posterieures_a_d_et_autres_entites_ignorees() -> None:
+    base = _table(_series())
+    autre = _table({**_series(), IND_3: IND_3_MONTANT}, entite="ENT-X")
+    futur = _table({IND_3: [(99, 1)]}, fin=date(2026, 10, 12))
+    table = pl.concat([base, autre, futur])
+
+    assert risques_entree_rouge(table, _meteo(), _grille()) == ResultatRisque((), ())
