+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Fenêtre de 10 Jours ouvrés finissant à D = vendredi
+09/10/2026 (x = 0..9), projection à x = 9 + h. Grille par défaut : rouge IND-1 `>= 3`,
+IND-3 `>= 20`, IND-4 `>= 1/5`.
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → franchissement à D + 1 JO (lundi 12/10).
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : Σy = 7, ȳ = 7/10, Σxy = 52, Sxx = 165/2, Sxy = 41/2, pente
+  41/165, ordonnée −23/55 ; p(4) = 464/165 < 3 ; p(5) = 101/33 ≥ 3 → D + 5 JO (16/10).
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+import re
+from dataclasses import FrozenInstanceError, replace
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+import yaml
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import risque
+from usine.domaine.prevision.commun import avancer, declenche
+from usine.domaine.prevision.risque import (
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Valeur = tuple[int, int] | str
+"""`(numérateur, dénominateur)` d'une valeur évaluée, ou motif d'un indicateur non évaluable."""
+
+CONSTANTE: list[Valeur] = [(0, 1)] * 10
+IND_3_MONTANT: list[Valeur] = [(v, 1) for v in range(10, 20)]
+IND_1_NON_LINEAIRE: list[Valeur] = [(v, 1) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+IND_4_INSUFFISANT: list[Valeur] = [(v, 100) for v in range(5, 15)]
+
+
+def _grille(modifie: dict[str, Any] | None = None) -> GrilleMeteo:
+    donnees = yaml.safe_load((RACINE / "config" / "grille_meteo.yaml").read_text("utf-8"))
+    for code, remplacement in (modifie or {}).items():
+        donnees["indicateurs"][code].update(remplacement)
+    return GrilleMeteo.model_validate(donnees)
+
+
+def _table(
+    series: dict[CodeIndicateur, list[Valeur]], fin: date = D, entite: str = ENTITE
+) -> pl.DataFrame:
+    """Table d'indicateurs : chaque série finit à `fin` ; indicateurs absents de `series` omis."""
+    lignes: list[dict[str, Any]] = []
+    for code, valeurs in series.items():
+        jours = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+        for jour, valeur in zip(jours, valeurs, strict=True):
+            evalue = isinstance(valeur, tuple)
+            lignes.append(
+                {
+                    "date": jour,
+                    "entite": entite,
+                    "code": code.value,
+                    "statut": "evalue" if evalue else "non_evaluable",
+                    "motif": "" if evalue else valeur,
+                    "numerateur": valeur[0] if isinstance(valeur, tuple) else 0,
+                    "denominateur": valeur[1] if isinstance(valeur, tuple) else 0,
+                    "couleur": "vert",
+                }
+            )
+    return valider(
+        pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR
+    )
+
+
+def _series() -> dict[CodeIndicateur, list[Valeur]]:
+    return {IND_1: list(CONSTANTE), IND_3: list(CONSTANTE), IND_4: list(CONSTANTE)}
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regle = RegleDeclenchante(
+        code=CodeIndicateur.ind_5,
+        couleur=couleur,
+        operateur=Operateur.superieur_ou_egal,
+        numerateur=1,
+        denominateur=1,
+        seuil_numerateur=1,
+        seuil_denominateur=1,
+        tickets_en_cause=(),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(regle,),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _calcul(
+    series: dict[CodeIndicateur, list[Valeur]],
+    grille: GrilleMeteo | None = None,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    return risques_entree_rouge(_table(series), _meteo(), grille or _grille(), parametres)
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = _calcul({**_series(), IND_3: IND_3_MONTANT})
+
+    assert [p.risque.indicateur for p in resultat.risques] == [IND_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    risque_ = projete.risque
+    assert risque_.date_franchissement_estimee == date(2026, 10, 12)
+    assert (risque_.numerateur, risque_.denominateur) == (19, 1)
+    assert (risque_.seuil_numerateur, risque_.seuil_denominateur) == (20, 1)
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = _calcul({**_series(), IND_1: IND_1_NON_LINEAIRE})
+
+    assert [p.risque.indicateur for p in resultat.risques] == [IND_1]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_regression_exacte_ind_1() -> None:
+    valeurs = [Fraction(v) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+    pente, ordonnee = risque._regression(valeurs)
