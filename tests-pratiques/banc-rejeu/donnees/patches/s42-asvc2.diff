+def _sans(table: pl.DataFrame, **egalite: Any) -> pl.DataFrame:
+    condition = pl.lit(True)
+    for colonne, valeur in egalite.items():
+        condition = condition & (pl.col(colonne) == valeur)
+    return table.filter(~condition)
+
+
+def test_entrees_invalides() -> None:
+    table = _table(_series())
+    jour = jours_ouvres(date(2026, 1, 1), D)[-10:]
+    samedi = _table({IND_3: [(0, 1)]}).with_columns(pl.lit(date(2026, 10, 3)).alias("date"))
+    cas = {
+        "Météo rouge": (table, _meteo(Couleur.rouge)),
+        "absente de la table": (_table(_series(), fin=date(2026, 10, 8)), _meteo()),
+        "trou de Jours ouvrés": (_sans(table, code="IND-3", date=jour[4]), _meteo()),
+        "en double": (pl.concat([table, table.filter(pl.col("code") == "IND-3")]), _meteo()),
+        "n'est pas un Jour ouvré": (pl.concat([table, samedi]), _meteo()),
+        "dénominateur 0": (_table({**_series(), IND_3: [(1, 0)] * 10}), _meteo()),
+    }
+    for cause, (entree, meteo) in cas.items():
+        with pytest.raises(UsineErreur, match=ENTITE) as exc:
+            risques_entree_rouge(entree, meteo, _grille())
+        assert cause in str(exc.value)
+
