@@ -0,0 +1,225 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Elle
+lit la table des indicateurs (`SCHEMA_INDICATEUR`) et la `MeteoEntite` non rouge d'une Entité à
+la Date d'arrêté D, et renvoie un `ResultatRisque` :
+
+- régression linéaire (moindres carrés) de l'indicateur sur les `fenetre` derniers Jours
+  ouvrés finissant à D (au moins 2 points), projetée de 1 à `horizon` Jours ouvrés après D ;
+- un `RisqueEntreeRouge` par indicateur (IND-1, IND-3, IND-4) dont une projection déclenche la
+  règle rouge de la Grille, à la date du premier Jour ouvré projeté qui la déclenche ;
+- les indicateurs écartés (inactifs ou sans seuil rouge, non évaluables sur la fenêtre,
+  historique insuffisant) sont restitués avec leur motif.
+
+`RisqueEntreeRouge` porte la valeur courante (contrat gelé) ; la valeur projetée est rendue
+à côté, dans `RisqueProjete`. L'avance en Jours ouvrés et le test de seuil viennent de `commun`.
+"""
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+"""Indicateurs projetés, dans l'ordre de `CodeIndicateur`."""
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque d'entrée en rouge : paramètre {nom} invalide {valeur!r}"
+                    " (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée à la date de franchissement estimée."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+@dataclass(frozen=True)
+class _Point:
+    date: date
+    statut: StatutIndicateur
+    motif: str
+    numerateur: int
+    denominateur: int
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D
+    sont lues, et chaque indicateur actif doit former des Jours ouvrés consécutifs finissant à
+    D. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la table est
+    invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, Entité non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in PROJETES:
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, f"{code} inactif dans la Grille"))
+            continue
+        if Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, f"{code} sans seuil rouge dans la Grille"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        points = _points(table, meteo, code)
+        fenetre = points[-parametres.fenetre :]
+        non_evaluable = next(
+            (p for p in fenetre if p.statut is StatutIndicateur.non_evaluable), None
+        )
+        if non_evaluable is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"{code} non évaluable le {non_evaluable.date.isoformat()} :"
+                    f" {non_evaluable.motif}",
+                )
+            )
+            continue
+        if len(fenetre) < 2:
+            exclus.append(IndicateurExclu(code, f"{code} : historique insuffisant"))
+            continue
+        valeurs = [_valeur(entite, code, p) for p in fenetre]
+        pente, ordonnee = _regression(valeurs)
+        n = len(valeurs)
+        for h in range(1, parametres.horizon + 1):
+            projetee = ordonnee + pente * (n - 1 + h)
+            if declenche(projetee, operateur, seuil):
+                courant = fenetre[-1]
+                risques.append(
+                    RisqueProjete(
+                        RisqueEntreeRouge(
+                            date_arrete=meteo.date_arrete,
+                            entite=entite,
+                            indicateur=code,
+                            date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                            horizon_jours_ouvres=parametres.horizon,
+                            numerateur=courant.numerateur,
+                            denominateur=courant.denominateur,
+                            seuil_numerateur=seuil.numerator,
+                            seuil_denominateur=seuil.denominator,
+                            version_grille=meteo.version_grille,
+                        ),
+                        projetee,
+                    )
+                )
+                break
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _points(table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur) -> list[_Point]:
+    """Historique de l'indicateur de l'Entité jusqu'à D : Jours ouvrés consécutifs, contrôlés."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = (
+        table.filter(
+            (pl.col("entite") == entite)
+            & (pl.col("code").cast(pl.Utf8) == code.value)
+            & (pl.col("date") <= arrete)
+        )
+        .sort("date")
+        .to_dicts()
+    )
+    points: list[_Point] = []
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} {code} : {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if points and points[-1].date == jour:
+            raise UsineErreur(f"Risque {entite} {code} : date {jour.isoformat()} en double")
+        if points and jour_ouvre_suivant(points[-1].date) != jour:
+            raise UsineErreur(
+                f"Risque {entite} {code} : trou de Jours ouvrés entre"
+                f" {points[-1].date.isoformat()} et {jour.isoformat()}"
+            )
+        points.append(
+            _Point(
+                date=jour,
+                statut=StatutIndicateur(ligne["statut"]),
+                motif=ligne["motif"],
+                numerateur=ligne["numerateur"],
+                denominateur=ligne["denominateur"],
+            )
+        )
+    if not points or points[-1].date != arrete:
+        raise UsineErreur(
+            f"Risque {entite} {code} : Date d'arrêté {arrete.isoformat()} absente de la table"
+        )
+    return points
+
+
+def _valeur(entite: str, code: CodeIndicateur, point: _Point) -> Fraction:
+    """Valeur d'un point évalué ; dénominateur nul invalide."""
+    if point.denominateur <= 0:
+        raise UsineErreur(
+            f"Risque {entite} {code} : valeur évaluée de dénominateur {point.denominateur}"
+            f" le {point.date.isoformat()}"
+        )
+    return Fraction(point.numerateur, point.denominateur)
+
+
+def _regression(valeurs: Sequence[Fraction]) -> tuple[Fraction, Fraction]:
+    """Pente et ordonnée à l'origine des moindres carrés de `valeurs` en x = 0..n−1 (n ≥ 2)."""
+    n = len(valeurs)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(valeurs, Fraction(0)) / n
+    sxx = sum(((Fraction(x) - x_moyen) ** 2 for x in range(n)), Fraction(0))
+    sxy = sum(((Fraction(x) - x_moyen) * (y - y_moyen) for x, y in enumerate(valeurs)), Fraction(0))
+    pente = sxy / sxx
+    return pente, y_moyen - pente * x_moyen
