@@ -0,0 +1,195 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Pour une
+Entité non rouge à la Date d'arrêté D, elle ajuste par moindres carrés une droite sur les
+`fenetre` derniers Jours ouvrés d'IND-1, IND-3 et IND-4 (x = 0..n−1), la projette de 1 à
+`horizon` Jours ouvrés après D et émet un `RisqueEntreeRouge` par indicateur dont une projection
+déclenche sa règle rouge ; la valeur projetée est rendue à côté (`RisqueProjete`, le contrat
+gelé ne porte que la valeur courante).
+
+Un indicateur écarté (non évaluable sur la fenêtre, historique insuffisant, règle inactive ou
+sans seuil rouge) est restitué dans `exclus` avec son motif. La vélocité de la Baseline n'est
+pas réutilisée ; l'avance en Jours ouvrés et le test de seuil viennent de `commun`.
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+from typing import Any
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+INDICATEURS_PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque : paramètre {nom} invalide {valeur!r} (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Un `RisqueEntreeRouge` et la valeur projetée à sa date de franchissement."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D
+    sont lues. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la table
+    est invalide pour un indicateur actif.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, une Entité non rouge est attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in CodeIndicateur:
+        if code not in INDICATEURS_PROJETES:
+            continue
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, "indicateur inactif dans la Grille"))
+            continue
+        if Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, "aucun seuil rouge dans la Grille"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        lignes = _fenetre(table, meteo, code, parametres.fenetre)
+        non_evaluable = next(
+            (ligne for ligne in lignes if ligne["statut"] == StatutIndicateur.non_evaluable),
+            None,
+        )
+        if non_evaluable is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"non évaluable le {non_evaluable['date'].isoformat()} :"
+                    f" {non_evaluable['motif']}",
+                )
+            )
+            continue
+        if len(lignes) < 2:
+            exclus.append(IndicateurExclu(code, "historique insuffisant"))
+            continue
+        valeurs = [Fraction(ligne["numerateur"], ligne["denominateur"]) for ligne in lignes]
+        pente, ordonnee = _regression(valeurs)
+        n = len(valeurs)
+        for h in range(1, parametres.horizon + 1):
+            projetee = ordonnee + pente * (n - 1 + h)
+            if declenche(projetee, operateur, seuil):
+                courante = lignes[-1]
+                risque = RisqueEntreeRouge(
+                    date_arrete=meteo.date_arrete,
+                    entite=entite,
+                    indicateur=code,
+                    date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                    horizon_jours_ouvres=parametres.horizon,
+                    numerateur=courante["numerateur"],
+                    denominateur=courante["denominateur"],
+                    seuil_numerateur=seuil.numerator,
+                    seuil_denominateur=seuil.denominator,
+                    version_grille=meteo.version_grille,
+                )
+                risques.append(RisqueProjete(risque, projetee))
+                break
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _fenetre(
+    table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur, taille: int
+) -> list[dict[str, Any]]:
+    """Les `taille` derniers Jours ouvrés de l'indicateur jusqu'à D, contrôlés et dans l'ordre."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = (
+        table.filter(
+            (pl.col("entite") == entite) & (pl.col("code") == code) & (pl.col("date") <= arrete)
+        )
+        .sort("date")
+        .to_dicts()
+    )
+    precedent: date | None = None
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} {code} : {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if precedent == jour:
+            raise UsineErreur(f"Risque {entite} {code} : date {jour.isoformat()} en double")
+        if precedent is not None and jour_ouvre_suivant(precedent) != jour:
+            raise UsineErreur(
+                f"Risque {entite} {code} : trou de Jours ouvrés entre"
+                f" {precedent.isoformat()} et {jour.isoformat()}"
+            )
+        if ligne["statut"] == StatutIndicateur.evalue and ligne["denominateur"] <= 0:
+            raise UsineErreur(
+                f"Risque {entite} {code} : valeur évaluée de dénominateur"
+                f" {ligne['denominateur']} le {jour.isoformat()}"
+            )
+        precedent = jour
+    if precedent != arrete:
+        raise UsineErreur(
+            f"Risque {entite} {code} : Date d'arrêté {arrete.isoformat()} absente de la table"
+        )
+    return lignes[-taille:]
+
+
+def _regression(valeurs: list[Fraction]) -> tuple[Fraction, Fraction]:
+    """Pente b et ordonnée a de la droite des moindres carrés, x = 0..n−1 (n ≥ 2)."""
+    n = len(valeurs)
+    x_moy = Fraction(n - 1, 2)
+    y_moy = sum(valeurs, Fraction(0)) / n
+    sxx = sum(((Fraction(x) - x_moy) * (Fraction(x) - x_moy) for x in range(n)), Fraction(0))
+    sxy = sum(((Fraction(x) - x_moy) * (y - y_moy) for x, y in enumerate(valeurs)), Fraction(0))
+    pente = sxy / sxx
+    return pente, y_moy - pente * x_moy
