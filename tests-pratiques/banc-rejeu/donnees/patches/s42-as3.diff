+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. 10 Jours ouvrés finissant au vendredi 09/10/2026 (D),
+x = 0..9, projection à x = 9 + h. Grille par défaut : rouge IND-1 `>= 3`, IND-3 `>= 20`,
+IND-4 `>= 1/5`.
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 ≥ 20 → risque à D + 1 JO (lundi 12/10).
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : pente 41/165, ordonnée −23/55 ; p(4) = 464/165 < 3,
+  p(5) = 101/33 ≥ 3 → D + 5 JO (vendredi 16/10).
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+import re
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from usine.config.chargeur import charger_yaml
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+GRILLE = charger_yaml(RACINE / "config" / "grille_meteo.yaml", GrilleMeteo)
+
+Point = tuple[int, int]
+CONSTANTS = {
+    CodeIndicateur.ind_1: [(0, 1)] * 10,
+    CodeIndicateur.ind_3: [(0, 1)] * 10,
+    CodeIndicateur.ind_4: [(1, 100)] * 10,
+}
+
+
+def _table(
+    series: dict[CodeIndicateur, list[Point]] | None = None,
+    entite: str = ENTITE,
+) -> pl.DataFrame:
+    """Table d'indicateurs ; chaque série finit à D, un point par Jour ouvré."""
+    donnees = {**CONSTANTS, **(series or {})}
+    lignes: list[dict[str, object]] = []
+    for code, points in donnees.items():
+        jours = jours_ouvres(date(2026, 1, 1), D)[-len(points) :]
+        for jour, (num, den) in zip(jours, points, strict=True):
+            lignes.append(_ligne(jour, code, num, den, entite))
+    return _frame(lignes)
+
+
+def _ligne(
+    jour: date,
+    code: CodeIndicateur,
+    num: int,
+    den: int,
+    entite: str = ENTITE,
+    statut: StatutIndicateur = StatutIndicateur.evalue,
+    motif: str = "",
+) -> dict[str, object]:
+    return {
+        "date": jour,
+        "entite": entite,
+        "code": code,
+        "statut": statut,
+        "motif": motif,
+        "numerateur": num,
+        "denominateur": den,
+        "couleur": Couleur.vert,
+    }
+
+
+def _frame(lignes: list[dict[str, object]]) -> pl.DataFrame:
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regle = RegleDeclenchante(
+        code=CodeIndicateur.ind_5,
+        couleur=couleur,
+        operateur=Operateur.superieur_ou_egal,
+        numerateur=1,
+        denominateur=1,
+        seuil_numerateur=1,
+        seuil_denominateur=1,
+        tickets_en_cause=(),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(regle,),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _calculer(
+    series: dict[CodeIndicateur, list[Point]] | None = None,
+    grille: GrilleMeteo = GRILLE,
+) -> ResultatRisque:
+    return risques_entree_rouge(_table(series), _meteo(), grille)
+
+
+def _un(resultat: ResultatRisque, code: CodeIndicateur) -> risque.RisqueProjete:
+    trouves = [r for r in resultat.risques if r.risque.indicateur is code]
+    assert len(trouves) == 1
+    return trouves[0]
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = _calculer({CodeIndicateur.ind_3: [(k, 1) for k in range(10, 20)]})
+
+    assert [r.risque.indicateur for r in resultat.risques] == [CodeIndicateur.ind_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.date_franchissement_estimee == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert r.date_arrete == D
+    assert r.entite == ENTITE
+    assert r.horizon_jours_ouvres == 5
+    assert r.version_grille == VERSION_GRILLE
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    serie = [(v, 1) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+    resultat = _calculer({CodeIndicateur.ind_1: serie})
+
+    projete = _un(resultat, CodeIndicateur.ind_1)
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert len(resultat.risques) == 1
+
+
+def test_regression_exacte() -> None:
+    pente, ordonnee = risque._regression([Fraction(v) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)])
+
+    assert pente == Fraction(41, 165)
+    assert ordonnee == Fraction(-23, 55)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = _calculer({CodeIndicateur.ind_4: [(k, 100) for k in range(5, 15)]})
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_franchissement_ind_4() -> None:
+    # 10/100..19/100 : pente 1/100, p(h) = 19/100 + h/100 ≥ 1/5 dès h = 1
+    resultat = _calculer({CodeIndicateur.ind_4: [(k, 100) for k in range(10, 20)]})
+
+    projete = _un(resultat, CodeIndicateur.ind_4)
+    assert projete.valeur_projetee == Fraction(1, 5)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (1, 5)
+
+
+@pytest.mark.parametrize("sens", ["constante", "baisse"])
+def test_stable_ou_en_baisse(sens: str) -> None:
+    if sens == "constante":
+        series = {
+            CodeIndicateur.ind_1: [(2, 1)] * 10,
+            CodeIndicateur.ind_3: [(19, 1)] * 10,
+            CodeIndicateur.ind_4: [(19, 100)] * 10,
+        }
+    else:
+        series = {
+            CodeIndicateur.ind_1: [(k, 1) for k in range(2, -8, -1)],
+            CodeIndicateur.ind_3: [(k, 1) for k in range(19, 9, -1)],
+            CodeIndicateur.ind_4: [(k, 100) for k in range(19, 9, -1)],
+        }
+
+    resultat = _calculer(series)
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    jours = jours_ouvres(date(2026, 1, 1), D)[-10:]
+    lignes = [
+        _ligne(j, CodeIndicateur.ind_4, 1, 100)
+        if i != 3
+        else _ligne(
+            j,
+            CodeIndicateur.ind_4,
+            0,
+            0,
+            statut=StatutIndicateur.non_evaluable,
+            motif="moins de 20 tests exécutés",
+        )
+        for i, j in enumerate(jours)
+    ]
+    autres = _table().filter(pl.col("code") != CodeIndicateur.ind_4).to_dicts()
+    table = _frame(autres + lignes)
+    # IND-3 montante : toujours projeté malgré l'exclusion d'IND-4
+    table = pl.concat(
+        [
+            table.filter(pl.col("code") != CodeIndicateur.ind_3),
+            _table({CodeIndicateur.ind_3: [(k, 1) for k in range(10, 20)]}).filter(
+                pl.col("code") == CodeIndicateur.ind_3
+            ),
+        ]
+    )
+
+    resultat = risques_entree_rouge(table, _meteo(), GRILLE)
+
+    assert [r.risque.indicateur for r in resultat.risques] == [CodeIndicateur.ind_3]
+    assert len(resultat.exclus) == 1
+    exclu = resultat.exclus[0]
+    assert exclu.code is CodeIndicateur.ind_4
+    assert jours[3].isoformat() in exclu.motif
+    assert "moins de 20 tests exécutés" in exclu.motif
+
+
+def test_historique_court() -> None:
+    resultat = _calculer(
+        {
+            CodeIndicateur.ind_1: [(0, 1), (1, 1), (2, 1)],  # 3 JO : p(1) = 3 ≥ 3
+            CodeIndicateur.ind_3: [(5, 1)],  # 1 seul JO
+        }
+    )
+
+    assert resultat.exclus == (IndicateurExclu(CodeIndicateur.ind_3, "historique insuffisant"),)
+    projete = _un(resultat, CodeIndicateur.ind_1)
+    assert projete.valeur_projetee == Fraction(3)
