+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from itertools import pairwise
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.adaptateurs.journal import SourceJournal
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.tickets import Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+JEUDI = date(2026, 10, 1)
+
+
+def _ts(jour: int, heure: int = 10) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, debut: date, fin: date, entites: list[str] | None = None) -> pl.DataFrame:
+    etats = tickets_etats(flux.evenements, jours_ouvres(debut, fin))
+    return kpi(etats, ENTITES if entites is None else entites)
+
+
+def _v(
+    table: pl.DataFrame, d: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == d)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne["numerateur"].item(), ligne["denominateur"].item()
+
+
+def _cas(flux: Flux, cle: str, statut: str, phase: str = "recette", jour: int = 1) -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(jour),
+        {
+            Champ.statut_test: statut,
+            Champ.entite: "ENT-A",
+            Champ.vague: "V1",
+            Champ.domaine: "paie",
+            Champ.phase: phase,
+        },
+    )
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(1))
+    flux.anomalie("DEMO-3", _ts(1), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, JEUDI, JEUDI)
+    assert _v(table, JEUDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _v(table, JEUDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _v(table, JEUDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _v(table, JEUDI, "ENT-A", "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _v(table, JEUDI, "ENT-A", "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _v(table, JEUDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _v(table, JEUDI, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))  # lundi
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")  # mardi
+    flux.transition("DEMO-1", _ts(7, 8), "fermee", "en_analyse")  # mercredi
+    flux.transition("DEMO-1", _ts(7, 9), "en_analyse", "fermee")
+    lundi, mercredi = date(2026, 10, 5), date(2026, 10, 7)
+    table = _kpi(flux, lundi, mercredi)
+    jours = jours_ouvres(lundi, mercredi)
+    assert [_v(table, d, "ENT-A", "entrees_jour")[0] for d in jours] == [1, 0, 1]
+    assert [_v(table, d, "ENT-A", "sorties_jour")[0] for d in jours] == [0, 1, 1]
+    assert [_v(table, d, PERIMETRE_PROGRAMME, "sorties_jour")[0] for d in jours] == [0, 1, 1]
+
+
+def test_fenetre() -> None:
+    flux = Flux()
+    for i in range(7):  # une création par Jour ouvré, du lundi 5 au mardi 13
+        flux.anomalie(f"DEMO-{i + 1}", _ts(5 + i + (2 if i >= 5 else 0)))
+    debut, fin = date(2026, 10, 5), date(2026, 10, 13)
+    table = _kpi(flux, debut, fin)
+    jours = jours_ouvres(debut, fin)
+    assert [_v(table, d, "ENT-A", "entrees_fenetre")[0] for d in jours] == [1, 2, 3, 4, 5, 5, 5]
+    assert [_v(table, d, "ENT-A", "sorties_fenetre")[0] for d in jours] == [0] * 7
+
+
+def test_age() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    d = date(2026, 10, 7)
+    table = _kpi(flux, JEUDI, d)
+    assert _v(table, d, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _v(table, d, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _v(table, d, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (4, 1)
+
+
+def test_age_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))  # J0 jeudi
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")  # J2 lundi
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")  # J5 jeudi
+    j6 = date(2026, 10, 9)
+    table = _kpi(flux, JEUDI, j6)
+    assert _v(table, j6, "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _v(table, j6, "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1), statut="fermee")
+    table = _kpi(flux, JEUDI, JEUDI)
+    assert _v(table, JEUDI, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _v(table, JEUDI, "ENT-B", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["ok", "ok", "ok", "ko", "non_execute", "non_execute"]):
+        _cas(flux, f"DEMO-{i + 1}", statut)
+    table = _kpi(flux, JEUDI, JEUDI)
+    assert _v(table, JEUDI, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _v(table, JEUDI, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _v(table, JEUDI, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _v(table, JEUDI, "ENT-A", "taux_non_execution_cas_de_test", "tnr") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["accordee", "reservee", "reservee"]):
+        flux.creer(
+            f"DEMO-{i + 1}",
+            TypeTicket.certification,
+            _ts(1),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A", Champ.vague: "V1"},
+        )
+    table = _kpi(flux, JEUDI, JEUDI)
+    assert _v(table, JEUDI, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _v(table, JEUDI, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _v(table, JEUDI, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [date(2026, 10, 5), date(2026, 10, 7)])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"),
+    [(["ENT-A", "ENT-A"], "ENT-A"), (["ENT-A", PERIMETRE_PROGRAMME], PERIMETRE_PROGRAMME)],
+)
+def test_entites_invalides(entites: list[str], valeur: str) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    with pytest.raises(UsineErreur, match=valeur):
+        _kpi(flux, JEUDI, JEUDI, entites)
+
+
+def test_table_vide() -> None:
+    etats = tickets_etats([], [])
+    table = kpi(etats, ENTITES)
+    assert table.height == 0
+    assert dict(table.schema) == dict(SCHEMA_KPI.colonnes)
+
+
+def test_schema_dense_et_sans_flottant() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(1), entite="ENT-X")
+    table = _kpi(flux, JEUDI, date(2026, 10, 2))
+    assert dict(table.schema) == dict(SCHEMA_KPI.colonnes)
+    assert not any(t.is_float() for t in table.schema.values())
+    par_jour = sum(len(dims) for dims in DIMENSIONS_KPI.values())
+    assert table.height == 2 * 3 * par_jour
+    assert table["code_kpi"].unique(maintain_order=True).to_list() == list(CODES_KPI)
+    assert len(CODES_KPI) == 12
+    # Programme = toutes les lignes, y compris les Entités hors de `entites`
+    assert _v(table, JEUDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _v(table, JEUDI, "ENT-A", "anomalies_ouvertes") == (1, 1)
+
+
+def test_programme_somme_des_entites() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(1), entite="ENT-B", gravite="mineure")
+    flux.transition("DEMO-2", _ts(2), "nouvelle", "fermee")
+    table = _kpi(flux, JEUDI, date(2026, 10, 2))
+    sommables = [c for c in CODES_KPI if not c.startswith(("taux", "age_median"))]
+    for d in jours_ouvres(JEUDI, date(2026, 10, 2)):
+        for code in sommables:
+            if code == "age_max_anomalies_ouvertes":
+                continue
+            for dimension in DIMENSIONS_KPI[code]:
+                total = sum(_v(table, d, e, code, dimension)[0] for e in ENTITES)
+                assert _v(table, d, PERIMETRE_PROGRAMME, code, dimension)[0] == total
+
+
+def test_deterministe() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2), entite="ENT-B")
+    assert _kpi(flux, JEUDI, date(2026, 10, 5)).equals(_kpi(flux, JEUDI, date(2026, 10, 5)))
+
+
+def test_journal_genere_conservation_et_instantane(tmp_path: Path) -> None:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generer(config, 42, date(2026, 10, 12))))
+    source = SourceJournal(chemin)
+    evenements = list(source.evenements())
+    etats = tickets_etats(evenements, jours_ouvres(date(2026, 9, 1), source.entete.date_injection))
+    entites = [e.code for e in config.entites]
