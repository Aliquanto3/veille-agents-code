+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : les états par ticket et les Entités arrivent en paramètre. Définitions H-17 :
+Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée = création ou réouverture (lue dans
+`date_derniere_entree`) ; Sortie = passage à Fermée ou Rejetée. Fenêtre glissante H-19.
+"""
+
+from collections import Counter
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass, field
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = {
+    "anomalies_ouvertes": ("",),
+    "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+    "anomalies_ouvertes_phase": tuple(p.value for p in Phase),
+    "entrees_jour": ("",),
+    "sorties_jour": ("",),
+    "entrees_fenetre": ("",),
+    "sorties_fenetre": ("",),
+    "age_median_anomalies_ouvertes": ("",),
+    "age_max_anomalies_ouvertes": ("",),
+    "taux_ko_cas_de_test": tuple(p.value for p in Phase),
+    "taux_non_execution_cas_de_test": tuple(p.value for p in Phase),
+    "certifications": tuple(s.value for s in StatutCertification),
+}
+"""Catalogue : `code_kpi` → valeurs de `dimension`, dans l'ordre de sortie."""
+
+CODES_KPI: tuple[str, ...] = tuple(DIMENSIONS_KPI)
+"""Les douze codes de KPI, dans l'ordre de sortie."""
+
+_FERMES = frozenset(s.value for s in STATUTS_FERMES)
+
+
+@dataclass
+class _Jour:
+    """Mesures d'un périmètre pour un jour."""
+
+    gravite: Counter[str] = field(default_factory=Counter)
+    phase: Counter[str] = field(default_factory=Counter)
+    ages: list[int] = field(default_factory=list)
+    tests: dict[str, Counter[str]] = field(default_factory=dict)
+    certifications: Counter[str] = field(default_factory=Counter)
+    ouvertes: int = 0
+    entrees: int = 0
+    sorties: int = 0
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée {PERIMETRE_PROGRAMME} : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    presentes = set(dates)
+    for jour in sorted(presentes):
+        if jour.weekday() >= 5:
+            raise UsineErreur(f"État des tickets : {jour.isoformat()} n'est pas un Jour ouvré")
+    for jour in jours_ouvres(min(presentes), max(presentes)):
+        if jour not in presentes:
+            raise UsineErreur(
+                f"État des tickets : date manquante {jour.isoformat()} (Jours ouvrés contigus"
+                " attendus)"
+            )
+
+
+def _mediane(ages: list[int]) -> Fraction:
+    tries = sorted(ages)
+    milieu = len(tries) // 2
+    if len(tries) % 2:
+        return Fraction(tries[milieu])
+    return Fraction(tries[milieu - 1] + tries[milieu], 2)
+
+
+def _jours_mesures(etats: pl.DataFrame, entites: Sequence[str]) -> dict[date, dict[str, _Jour]]:
+    """Mesures par date puis par périmètre (Entité demandée ou Programme)."""
+    connues = set(entites)
+    par_date: dict[date, dict[str, _Jour]] = {}
+    veille: dict[str, bool] = {}
+    date_courante: date | None = None
+    ouverts_du_jour: dict[str, bool] = {}
+    premiere = etats.get_column("date").min()
+
+    def _cloturer() -> None:
+        nonlocal veille, ouverts_du_jour
+        veille = ouverts_du_jour
+        ouverts_du_jour = {}
+
+    for ligne in etats.sort("date").iter_rows(named=True):
+        jour: date = ligne["date"]
+        if jour != date_courante:
+            if date_courante is not None:
+                _cloturer()
+            date_courante = jour
+        mesures = par_date.setdefault(jour, {})
+        entite = ligne["entite"]
+        perimetres = [PERIMETRE_PROGRAMME]
+        if entite in connues:
+            perimetres.append(entite)
+        type_ticket = ligne["type_ticket"]
+        phase = ligne["phase"]
+        for perimetre in perimetres:
+            m = mesures.setdefault(perimetre, _Jour())
+            if type_ticket == TypeTicket.anomalie.value:
+                statut = ligne["statut"]
+                ouvert = statut is not None and statut not in _FERMES
+                cle = ligne["cle_ticket"]
+                ouverts_du_jour[cle] = ouvert
+                entree_ce_jour = ligne["date_derniere_entree"] == jour
+                delta = int(ouvert) - int(veille.get(cle, False))
+                if jour == premiere and not entree_ce_jour:
+                    # Début de l'historique : un mouvement antérieur n'est pas observable.
+                    delta = 0
+                m.entrees += int(entree_ce_jour)
+                m.sorties += int(entree_ce_jour) - delta
+                if ouvert:
+                    m.ouvertes += 1
+                    if ligne["gravite"] is not None:
+                        m.gravite[ligne["gravite"]] += 1
+                    if phase is not None:
+                        m.phase[phase] += 1
+                    entree = ligne["date_derniere_entree"]
+                    if entree is not None:
+                        m.ages.append(len(jours_ouvres(entree, jour)) - 1)
+            elif type_ticket == TypeTicket.cas_de_test.value:
+                if phase is not None and ligne["statut_test"] is not None:
+                    m.tests.setdefault(phase, Counter())[ligne["statut_test"]] += 1
+            elif ligne["statut_certification"] is not None:
+                m.certifications[ligne["statut_certification"]] += 1
+    return par_date
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` dense : une ligne par date, périmètre, code et dimension.
+
+    Périmètres : `entites` dans l'ordre reçu, puis `PROGRAMME` (toutes les lignes de la table,
+    Entités hors de `entites` comprises). Lignes triées par date, périmètre, code, dimension.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date,
+    sinon `UsineErreur`. À sa première date la veille est vide (début de l'historique) : un
+    ticket déjà ouvert sans Entrée ce jour-là ne compte ni Entrée ni Sortie. Les jours
+    antérieurs à la table comptent 0 dans les Fenêtres glissantes. Âge sans Anomalie ouverte
+    et taux sans dénominateur valent `0/0`.
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    if etats.height == 0:
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = sorted(set(etats.get_column("date").to_list()))
+    _verifier_dates(dates)
+    par_date = _jours_mesures(etats, entites)
+    vide = _Jour()
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+
+    def ajouter(d: date, perimetre: str, code: str, dimension: str, num: int, den: int) -> None:
+        lignes["date"].append(d)
+        lignes["perimetre"].append(perimetre)
+        lignes["code_kpi"].append(code)
+        lignes["dimension"].append(dimension)
+        lignes["numerateur"].append(num)
+        lignes["denominateur"].append(den)
+
+    for d in dates:
+        fenetre = [j for j in fenetre_glissante(d) if j in par_date]
+        for perimetre in perimetres:
+            m = par_date[d].get(perimetre, vide)
+            entrees_fenetre = sum(par_date[j].get(perimetre, vide).entrees for j in fenetre)
+            sorties_fenetre = sum(par_date[j].get(perimetre, vide).sorties for j in fenetre)
+            for code, dimensions in DIMENSIONS_KPI.items():
+                for dimension in dimensions:
+                    num, den = 0, 1
+                    if code == "anomalies_ouvertes":
+                        num = m.ouvertes
+                    elif code == "anomalies_ouvertes_gravite":
+                        num = m.gravite[dimension]
+                    elif code == "anomalies_ouvertes_phase":
+                        num = m.phase[dimension]
+                    elif code == "entrees_jour":
+                        num = m.entrees
+                    elif code == "sorties_jour":
+                        num = m.sorties
+                    elif code == "entrees_fenetre":
+                        num = entrees_fenetre
+                    elif code == "sorties_fenetre":
+                        num = sorties_fenetre
+                    elif code == "age_median_anomalies_ouvertes":
+                        num, den = (0, 0)
+                        if m.ages:
+                            mediane = _mediane(m.ages)
+                            num, den = mediane.numerator, mediane.denominator
+                    elif code == "age_max_anomalies_ouvertes":
+                        num, den = (max(m.ages), 1) if m.ages else (0, 0)
+                    elif code == "certifications":
+                        num = m.certifications[dimension]
+                    else:
+                        statuts = m.tests.get(dimension, Counter())
+                        ok = statuts[StatutTest.ok.value]
+                        ko = statuts[StatutTest.ko.value]
+                        non = statuts[StatutTest.non_execute.value]
+                        if code == "taux_ko_cas_de_test":
+                            num, den = ko, ok + ko
+                        else:
+                            num, den = non, ok + ko + non
+                    ajouter(d, perimetre, code, dimension, num, den)
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
