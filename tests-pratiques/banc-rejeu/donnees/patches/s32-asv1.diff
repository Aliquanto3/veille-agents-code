@@ -0,0 +1,242 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.adaptateurs.journal import SourceJournal
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import fenetre_generation, generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, dates: list[date], entites: list[str] | None = None) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, dates), entites or ENTITES)
+
+
+def _val(
+    table: pl.DataFrame, jour: int, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == date(2026, 10, jour))
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne.item(0, "numerateur"), ligne.item(0, "denominateur")
+
+
+def _cas(flux: Flux, cle: str, statut: str, phase: str = "recette") -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(5),
+        {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: phase},
+    )
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5))
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure")
+    flux.transition("DEMO-3", _ts(5, 12), "nouvelle", "fermee")
+    t = _kpi(flux, [date(2026, 10, 5)])
+    assert _val(t, 5, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(t, 5, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(t, 5, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(t, 5, "ENT-A", "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(t, 5, "ENT-A", "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(t, 5, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _val(t, 5, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 9), "fermee", "nouvelle")
+    flux.transition("DEMO-1", _ts(7, 10), "nouvelle", "fermee")
+    t = _kpi(flux, list(jours_ouvres(date(2026, 10, 5), date(2026, 10, 7))))
+    entrees = [_val(t, j, "ENT-A", "entrees_jour")[0] for j in (5, 6, 7)]
+    sorties = [_val(t, j, "ENT-A", "sorties_jour")[0] for j in (5, 6, 7)]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+
+
+def test_fenetre() -> None:
+    flux = Flux()
+    jours = [5, 6, 7, 8, 9, 12, 13]
+    for rang, jour in enumerate(jours):
+        flux.anomalie(f"DEMO-{rang + 1}", _ts(jour))
+    flux.transition("DEMO-1", _ts(6, 12), "nouvelle", "fermee")
+    t = _kpi(flux, list(jours_ouvres(date(2026, 10, 5), date(2026, 10, 13))))
+    entrees = [_val(t, j, "ENT-A", "entrees_fenetre")[0] for j in jours]
+    assert entrees == [1, 2, 3, 4, 5, 5, 5]
+    sorties = [_val(t, j, "ENT-A", "sorties_fenetre")[0] for j in jours]
+    assert sorties == [0, 1, 1, 1, 1, 1, 0]
+
+
+def test_age() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    t = _kpi(flux, [date(2026, 10, 7)])
+    assert _val(t, 7, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(t, 7, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(t, 7, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (4, 1)
+
+
+def test_age_apres_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(7), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(12), "fermee", "nouvelle")
+    t = _kpi(flux, [date(2026, 10, 13)])
+    assert _val(t, 13, "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(t, 13, "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_anomalie_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    t = _kpi(flux, [date(2026, 10, 6)])
+    assert _val(t, 6, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(t, 6, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for rang, statut in enumerate(["ok"] * 3 + ["ko"] + ["non_execute"] * 2):
+        _cas(flux, f"DEMO-{rang + 1}", statut)
+    t = _kpi(flux, [date(2026, 10, 5)])
+    assert _val(t, 5, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(t, 5, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(t, 5, PERIMETRE_PROGRAMME, "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(t, 5, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(t, 5, "ENT-B", "taux_non_execution_cas_de_test", "recette") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for rang, statut in enumerate(["accordee", "reservee", "reservee"]):
+        flux.creer(
+            f"DEMO-{rang + 1}",
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    t = _kpi(flux, [date(2026, 10, 5)])
+    assert _val(t, 5, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(t, 5, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(t, 5, "ENT-A", "certifications", "refusee") == (0, 1)
+    assert _val(t, 5, PERIMETRE_PROGRAMME, "certifications", "reservee") == (2, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [date(2026, 10, 5), date(2026, 10, 7)])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"),
+    [(["ENT-A", "ENT-A"], "ENT-A"), (["ENT-A", PERIMETRE_PROGRAMME], PERIMETRE_PROGRAMME)],
+)
+def test_entites_invalides(entites: list[str], valeur: str) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    with pytest.raises(UsineErreur, match=valeur):
+        _kpi(flux, [date(2026, 10, 5)], entites)
+
+
+def test_table_vide() -> None:
+    t = kpi(tickets_etats([], []), ENTITES)
+    assert t.height == 0
+    assert t.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+
+
+def test_forme_de_la_sortie() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    dates = list(jours_ouvres(date(2026, 10, 5), date(2026, 10, 6)))
+    t = _kpi(flux, dates)
+    valider(t, SCHEMA_KPI)
+    nb_perimetres = len([*ENTITES, PERIMETRE_PROGRAMME])
+    par_jour = nb_perimetres * sum(len(d) for d in DIMENSIONS_KPI.values())
+    assert t.height == par_jour * len(dates)
+    assert len(CODES_KPI) == 12
+    assert not [c for c, type_ in t.schema.items() if type_.is_float()]
+    assert t.head(par_jour).get_column("perimetre").unique(maintain_order=True).to_list() == [
+        *ENTITES,
+        PERIMETRE_PROGRAMME,
+    ]
+    assert t.get_column("code_kpi").unique(maintain_order=True).to_list() == list(CODES_KPI)
+
+
+def test_journal_genere(tmp_path: Path) -> None:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generer(config, 42, date(2026, 10, 12))))
+    source = SourceJournal(chemin)
+    evenements = list(source.evenements())
+    ancrage, injection = fenetre_generation(date(2026, 10, 12), config.nb_semaines)
+    dates = list(jours_ouvres(ancrage, injection))
+    entites = [e.code for e in config.entites]
+    etats = tickets_etats(evenements, dates)
+    t = kpi(etats, entites)
+    assert t.equals(kpi(etats, entites))
+    valider(t, SCHEMA_KPI)
+
+    def serie(perimetre: str, code: str) -> list[int]:
+        return (
+            t.filter((pl.col("perimetre") == perimetre) & (pl.col("code_kpi") == code))
+            .sort("date")
+            .get_column("numerateur")
+            .to_list()
+        )
+
+    for perimetre in (*entites, PERIMETRE_PROGRAMME):
+        stock = serie(perimetre, "anomalies_ouvertes")
+        entrees = serie(perimetre, "entrees_jour")
+        sorties = serie(perimetre, "sorties_jour")
+        for i in range(1, len(stock)):
+            assert stock[i] - stock[i - 1] == entrees[i] - sorties[i], (perimetre, dates[i])
+    for code in ("anomalies_ouvertes", "entrees_jour", "sorties_jour"):
+        somme = [sum(valeurs) for valeurs in zip(*(serie(e, code) for e in entites), strict=True)]
+        assert somme == serie(PERIMETRE_PROGRAMME, code)
+
+    fermes = [s.value for s in STATUTS_FERMES]
+    attendu = (
+        instantane(etats)
+        .filter(
+            (pl.col("type_ticket") == TypeTicket.anomalie.value)
+            & ~pl.col("statut").cast(pl.Utf8).is_in(fermes)
+        )
+        .group_by("date")
+        .agg(pl.col("nombre").sum())
+        .sort("date")
+        .get_column("nombre")
+        .to_list()
+    )
+    assert serie(PERIMETRE_PROGRAMME, "anomalies_ouvertes") == attendu
