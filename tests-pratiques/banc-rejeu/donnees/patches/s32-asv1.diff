@@ -0,0 +1,298 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11).
+
+Stocks, flux, âges, taux et Certifications. Fonction pure : les états des tickets (le détail
+de l'Instantané) et les Entités arrivent en paramètre. Tout est en entiers ; un taux ou un
+ratio est porté en `numerateur` / `denominateur` (AD-10), un compte valant `n/1` et une
+valeur sans objet `0/0`.
+"""
+
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jour_ouvre_precedent, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+_SANS_DIMENSION: tuple[str, ...] = ("",)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = {
+    "anomalies_ouvertes": _SANS_DIMENSION,
+    "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+    "anomalies_ouvertes_phase": tuple(p.value for p in Phase),
+    "entrees_jour": _SANS_DIMENSION,
+    "sorties_jour": _SANS_DIMENSION,
+    "entrees_fenetre": _SANS_DIMENSION,
+    "sorties_fenetre": _SANS_DIMENSION,
+    "age_median_anomalies_ouvertes": _SANS_DIMENSION,
+    "age_max_anomalies_ouvertes": _SANS_DIMENSION,
+    "taux_ko_cas_de_test": tuple(p.value for p in Phase),
+    "taux_non_execution_cas_de_test": tuple(p.value for p in Phase),
+    "certifications": tuple(s.value for s in StatutCertification),
+}
+"""Valeurs de `dimension` de chaque `code_kpi`, dans l'ordre des lignes produites."""
+
+CODES_KPI: tuple[str, ...] = tuple(DIMENSIONS_KPI)
+"""Les douze codes du catalogue, dans l'ordre des lignes produites."""
+
+_FENETRES: Mapping[str, str] = {
+    "entrees_fenetre": "entrees_jour",
+    "sorties_fenetre": "sorties_jour",
+}
+_TAUX = frozenset({"taux_ko_cas_de_test", "taux_non_execution_cas_de_test"})
+_AGES = frozenset({"age_median_anomalies_ouvertes", "age_max_anomalies_ouvertes"})
+
+_Cle = tuple[date, str | None, str, str]
+"""(date, périmètre, code, dimension) ; le périmètre est `None` pour un ticket sans Entité."""
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée {PERIMETRE_PROGRAMME} : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Les dates de la table couvrent chaque Jour ouvré de la première à la dernière."""
+    presentes = set(dates)
+    attendues = jours_ouvres(dates[0], dates[-1])
+    hors_jour_ouvre = sorted(presentes.difference(attendues))
+    if hors_jour_ouvre:
+        raise UsineErreur(f"{hors_jour_ouvre[0].isoformat()} n'est pas un Jour ouvré")
+    manquantes = [jour for jour in attendues if jour not in presentes]
+    if manquantes:
+        raise UsineErreur(
+            f"état des tickets manquant pour le Jour ouvré {manquantes[0].isoformat()}"
+            f" (entre {dates[0].isoformat()} et {dates[-1].isoformat()})"
+        )
+
+
+def _cumuler(cible: dict[_Cle, int], table: pl.DataFrame, code: str, colonne: str) -> None:
+    """Ajoute `colonne` à `cible` ; `table` porte `date`, `entite`, `dimension` et `colonne`."""
+    for jour, entite, dimension, valeur in table.select(
+        "date", "entite", "dimension", colonne
+    ).iter_rows():
+        cle = (jour, entite, code, dimension)
+        cible[cle] = cible.get(cle, 0) + valeur
+
+
+def _par_dimension(table: pl.DataFrame, dimension: pl.Expr, *mesures: pl.Expr) -> pl.DataFrame:
+    """Mesures par date, Entité et dimension ; un ticket sans dimension n'est pas ventilé."""
+    return (
+        table.with_columns(dimension.alias("dimension"))
+        .filter(pl.col("dimension").is_not_null())
+        .group_by("date", "entite", "dimension")
+        .agg(*mesures)
+    )
+
+
+def _mouvements(anomalies: pl.DataFrame, dates: Sequence[date]) -> pl.DataFrame:
+    """Anomalies avec `ouvert`, `entree` (E) et `sortie` (S = E − variation de `ouvert`)."""
+    veilles = pl.DataFrame(
+        {
+            "date": list(dates),
+            "date_veille": [jour_ouvre_precedent(jour) for jour in dates],
+        },
+        schema={"date": pl.Date(), "date_veille": pl.Date()},
+    )
+    veille = anomalies.select(
+        pl.col("date").alias("date_veille"),
+        "cle_ticket",
+        pl.col("ouvert").alias("ouvert_veille"),
+    )
+    return (
+        anomalies.join(veilles, on="date", how="left")
+        .join(veille, on=["date_veille", "cle_ticket"], how="left")
+        .with_columns(
+            pl.col("ouvert_veille").fill_null(0),
+            (pl.col("date_derniere_entree") == pl.col("date"))
+            .fill_null(value=False)
+            .cast(pl.Int64)
+            .alias("entree"),
+        )
+        .with_columns(
+            (pl.col("entree") - (pl.col("ouvert") - pl.col("ouvert_veille"))).alias("sortie")
+        )
+    )
+
+
+def _mediane(ages: Sequence[int]) -> Fraction:
+    ordonnes = sorted(ages)
+    milieu = len(ordonnes) // 2
+    if len(ordonnes) % 2:
+        return Fraction(ordonnes[milieu])
+    return Fraction(ordonnes[milieu - 1] + ordonnes[milieu], 2)
+
+
+def _ages(ouvertes: pl.DataFrame) -> dict[tuple[date, str | None], list[int]]:
+    """Âges en Jours ouvrés depuis la dernière Entrée, par date et périmètre (Programme compris)."""
+    ages: dict[tuple[date, str | None], list[int]] = {}
+    par_couple: dict[tuple[date, date], int] = {}
+    for jour, entite, entree in ouvertes.select(
+        "date", "entite", "date_derniere_entree"
+    ).iter_rows():
+        if entree is None:
+            continue
+        age = par_couple.get((entree, jour))
+        if age is None:
+            age = par_couple[(entree, jour)] = len(jours_ouvres(entree, jour)) - 1
+        ages.setdefault((jour, entite), []).append(age)
+        ages.setdefault((jour, PERIMETRE_PROGRAMME), []).append(age)
+    return ages
+
+
+def _ajouter_programme(cumul: dict[_Cle, int]) -> None:
+    """Le Programme somme toutes les lignes, y compris celles d'Entités hors de `entites`."""
+    total: dict[_Cle, int] = {}
+    for (jour, _entite, code, dimension), valeur in cumul.items():
+        cle = (jour, PERIMETRE_PROGRAMME, code, dimension)
+        total[cle] = total.get(cle, 0) + valeur
+    cumul.update(total)
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : une ligne par date, périmètre, code et dimension, zéros explicites compris.
+
+    Périmètres : `entites` dans leur ordre, puis `PROGRAMME`. Lignes triées par date, périmètre,
+    code (ordre de `CODES_KPI`) puis dimension (ordre de `DIMENSIONS_KPI`).
+
+    Anomalie ouverte, Entrée et Sortie suivent le Glossaire (H-17) ; la Fenêtre glissante vient
+    de `contrats.calendrier` (H-19). L'âge est le nombre de Jours ouvrés depuis la dernière
+    Entrée ; la médiane d'un nombre pair d'âges est la moyenne des deux centraux.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date,
+    sinon erreur ; à sa première date, la veille est vide (début de l'historique).
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    if etats.is_empty():
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = sorted(set(etats.get_column("date").to_list()))
+    _verifier_dates(dates)
+
+    est_anomalie = pl.col("type_ticket") == TypeTicket.anomalie.value
+    ouvert = (
+        (
+            pl.col("statut").is_not_null()
+            & ~pl.col("statut").cast(pl.Utf8).is_in([s.value for s in STATUTS_FERMES])
+        )
+        .fill_null(value=False)
+        .cast(pl.Int64)
+    )
+    anomalies = _mouvements(etats.filter(est_anomalie).with_columns(ouvert.alias("ouvert")), dates)
+    ouvertes = anomalies.filter(pl.col("ouvert") == 1)
+    tests = etats.filter(
+        (pl.col("type_ticket") == TypeTicket.cas_de_test.value)
+        & pl.col("statut_test").is_not_null()
+    )
+    certifications = etats.filter(pl.col("type_ticket") == TypeTicket.certification.value)
+
+    numerateurs: dict[_Cle, int] = {}
+    denominateurs: dict[_Cle, int] = {}
+    nombre = pl.len().cast(pl.Int64).alias("nombre")
+    _cumuler(
+        numerateurs,
+        _par_dimension(ouvertes, pl.lit(""), nombre),
+        "anomalies_ouvertes",
+        "nombre",
+    )
+    _cumuler(
+        numerateurs,
+        _par_dimension(ouvertes, pl.col("gravite").cast(pl.Utf8), nombre),
+        "anomalies_ouvertes_gravite",
+        "nombre",
+    )
+    _cumuler(
+        numerateurs,
+        _par_dimension(ouvertes, pl.col("phase").cast(pl.Utf8), nombre),
+        "anomalies_ouvertes_phase",
+        "nombre",
+    )
+    flux = _par_dimension(
+        anomalies,
+        pl.lit(""),
+        pl.col("entree").sum().alias("entrees"),
+        pl.col("sortie").sum().alias("sorties"),
+    )
+    _cumuler(numerateurs, flux, "entrees_jour", "entrees")
+    _cumuler(numerateurs, flux, "sorties_jour", "sorties")
+
+    statut_test = pl.col("statut_test").cast(pl.Utf8)
+    par_phase = _par_dimension(
+        tests,
+        pl.col("phase").cast(pl.Utf8),
+        (statut_test == StatutTest.ok.value).sum().cast(pl.Int64).alias("ok"),
+        (statut_test == StatutTest.ko.value).sum().cast(pl.Int64).alias("ko"),
+        nombre.alias("total"),
+    ).with_columns(
+        (pl.col("ok") + pl.col("ko")).alias("executes"),
+        (pl.col("total") - pl.col("ok") - pl.col("ko")).alias("non_executes"),
+    )
+    _cumuler(numerateurs, par_phase, "taux_ko_cas_de_test", "ko")
+    _cumuler(denominateurs, par_phase, "taux_ko_cas_de_test", "executes")
+    _cumuler(numerateurs, par_phase, "taux_non_execution_cas_de_test", "non_executes")
+    _cumuler(denominateurs, par_phase, "taux_non_execution_cas_de_test", "total")
+    _cumuler(
+        numerateurs,
+        _par_dimension(certifications, pl.col("statut_certification").cast(pl.Utf8), nombre),
+        "certifications",
+        "nombre",
+    )
+    _ajouter_programme(numerateurs)
+    _ajouter_programme(denominateurs)
+    ages = _ages(ouvertes)
+
+    fenetres = {jour: fenetre_glissante(jour) for jour in dates}
+
+    def valeur(jour: date, perimetre: str, code: str, dimension: str) -> tuple[int, int]:
+        if code in _AGES:
+            liste = ages.get((jour, perimetre))
+            if not liste:
+                return 0, 0
+            if code == "age_max_anomalies_ouvertes":
+                return max(liste), 1
+            mediane = _mediane(liste)
+            return mediane.numerator, mediane.denominator
+        if code in _FENETRES:
+            return (
+                sum(
+                    numerateurs.get((j, perimetre, _FENETRES[code], dimension), 0)
+                    for j in fenetres[jour]
+                ),
+                1,
+            )
+        cle = (jour, perimetre, code, dimension)
+        if code in _TAUX:
+            return numerateurs.get(cle, 0), denominateurs.get(cle, 0)
+        return numerateurs.get(cle, 0), 1
+
+    colonnes: dict[str, list[object]] = {nom: [] for nom in SCHEMA_KPI.colonnes}
+    for jour in dates:
+        for perimetre in (*entites, PERIMETRE_PROGRAMME):
+            for code, dimensions in DIMENSIONS_KPI.items():
+                for dimension in dimensions:
+                    numerateur, denominateur = valeur(jour, perimetre, code, dimension)
+                    colonnes["date"].append(jour)
+                    colonnes["perimetre"].append(perimetre)
+                    colonnes["code_kpi"].append(code)
+                    colonnes["dimension"].append(dimension)
+                    colonnes["numerateur"].append(numerateur)
+                    colonnes["denominateur"].append(denominateur)
+    table = pl.DataFrame(colonnes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
diff --git a/tests/unit/domaine/test_kpi.py b/tests/unit/domaine/test_kpi.py
