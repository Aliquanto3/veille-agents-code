@@ -0,0 +1,303 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17, H-17, H-19).
+
+Fonction pure : l'état des tickets de chaque Jour ouvré et les Entités arrivent en paramètre.
+Anomalie ouverte = statut hors `STATUTS_FERMES` ; Entrée = création ou réouverture, lue dans
+`date_derniere_entree` ; Sortie = passage à Fermée ou Rejetée (H-17). Tout taux est porté en
+`numerateur` / `denominateur` entiers ; `0/0` = pas de valeur (aucune Anomalie ouverte, aucun
+Cas de test). La sortie est dense : zéro explicite, jamais de ligne absente.
+"""
+
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+from itertools import pairwise
+from types import MappingProxyType
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import est_jour_ouvre, fenetre_glissante, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+ANOMALIES_OUVERTES = "anomalies_ouvertes"
+ANOMALIES_OUVERTES_GRAVITE = "anomalies_ouvertes_gravite"
+ANOMALIES_OUVERTES_PHASE = "anomalies_ouvertes_phase"
+ENTREES_JOUR = "entrees_jour"
+SORTIES_JOUR = "sorties_jour"
+ENTREES_FENETRE = "entrees_fenetre"
+SORTIES_FENETRE = "sorties_fenetre"
+AGE_MEDIAN = "age_median_anomalies_ouvertes"
+AGE_MAX = "age_max_anomalies_ouvertes"
+TAUX_KO = "taux_ko_cas_de_test"
+TAUX_NON_EXECUTION = "taux_non_execution_cas_de_test"
+CERTIFICATIONS = "certifications"
+
+CODES_KPI: tuple[str, ...] = (
+    ANOMALIES_OUVERTES,
+    ANOMALIES_OUVERTES_GRAVITE,
+    ANOMALIES_OUVERTES_PHASE,
+    ENTREES_JOUR,
+    SORTIES_JOUR,
+    ENTREES_FENETRE,
+    SORTIES_FENETRE,
+    AGE_MEDIAN,
+    AGE_MAX,
+    TAUX_KO,
+    TAUX_NON_EXECUTION,
+    CERTIFICATIONS,
+)
+"""Catalogue des KPI quotidiens, dans l'ordre de sortie."""
+
+_SANS_DIMENSION: tuple[str, ...] = ("",)
+_GRAVITES = tuple(g.value for g in Gravite)
+_PHASES = tuple(p.value for p in Phase)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        ANOMALIES_OUVERTES: _SANS_DIMENSION,
+        ANOMALIES_OUVERTES_GRAVITE: _GRAVITES,
+        ANOMALIES_OUVERTES_PHASE: _PHASES,
+        ENTREES_JOUR: _SANS_DIMENSION,
+        SORTIES_JOUR: _SANS_DIMENSION,
+        ENTREES_FENETRE: _SANS_DIMENSION,
+        SORTIES_FENETRE: _SANS_DIMENSION,
+        AGE_MEDIAN: _SANS_DIMENSION,
+        AGE_MAX: _SANS_DIMENSION,
+        TAUX_KO: _PHASES,
+        TAUX_NON_EXECUTION: _PHASES,
+        CERTIFICATIONS: tuple(s.value for s in StatutCertification),
+    }
+)
+"""Dimensions de chaque KPI, dans l'ordre de sortie (`""` = KPI non ventilé)."""
+
+_CODES_SANS_VALEUR_PAR_DEFAUT = frozenset({AGE_MEDIAN, AGE_MAX, TAUX_KO, TAUX_NON_EXECUTION})
+"""KPI valant `0/0` (pas de valeur) faute de données ; les comptes valent `0/1`."""
+
+_FERMES = [statut.value for statut in STATUTS_FERMES]
+
+_Cle = tuple[date, str, str, str]
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité {PERIMETRE_PROGRAMME!r} refusée : valeur réservée au périmètre du Programme"
+        )
+
+
+def _dates(etats: pl.DataFrame) -> list[date]:
+    """Dates de la table ; refuse un jour non ouvré ou un Jour ouvré manquant entre deux dates."""
+    dates: list[date] = sorted(etats.get_column("date").unique().to_list())
+    non_ouvres = [d.isoformat() for d in dates if not est_jour_ouvre(d)]
+    if non_ouvres:
+        raise UsineErreur(f"état des tickets : date(s) non ouvrée(s) : {', '.join(non_ouvres)}")
+    if dates:
+        presentes = set(dates)
+        attendues = jours_ouvres(dates[0], dates[-1])
+        manquantes = [d.isoformat() for d in attendues if d not in presentes]
+        if manquantes:
+            raise UsineErreur(
+                f"état des tickets : Jour(s) ouvré(s) manquant(s) entre {dates[0].isoformat()}"
+                f" et {dates[-1].isoformat()} : {', '.join(manquantes)}"
+            )
+    return dates
+
+
+def _par_perimetre(etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """Chaque ligne une fois sous son Entité (si demandée), et une fois sous le Programme."""
+    return pl.concat(
+        [
+            etats.filter(pl.col("entite").is_in(list(entites))).with_columns(
+                pl.col("entite").alias("perimetre")
+            ),
+            etats.with_columns(pl.lit(PERIMETRE_PROGRAMME, dtype=pl.Utf8).alias("perimetre")),
+        ],
+        how="vertical",
+    )
+
+
+def _anomalies(etats: pl.DataFrame, dates: list[date]) -> pl.DataFrame:
+    """Anomalies avec `ouvert`, `entree` et `sortie` (0 ou 1, ou 2 pour `sortie`) du jour.
+
+    `sortie = entree − (ouvert(D) − ouvert(D−1))` ; la veille de la première date est vide.
+    Pour un ticket antérieur à la première date, la Sortie ne peut être négative (bornée à 0).
+    """
+    lendemain = dict(pairwise(dates))
+    anomalies = etats.filter(pl.col("type_ticket") == TypeTicket.anomalie.value).with_columns(
+        (pl.col("statut").is_not_null() & ~pl.col("statut").is_in(_FERMES))
+        .cast(pl.Int64)
+        .alias("ouvert"),
+        (pl.col("date_derniere_entree") == pl.col("date"))
+        .fill_null(False)
+        .cast(pl.Int64)
+        .alias("entree"),
+    )
+    veille = anomalies.filter(pl.col("date").is_in(list(lendemain))).select(
+        pl.col("date").replace_strict(lendemain, return_dtype=pl.Date()),
+        "cle_ticket",
+        pl.col("ouvert").alias("ouvert_veille"),
+    )
+    return anomalies.join(veille, on=["date", "cle_ticket"], how="left").with_columns(
+        (pl.col("entree") - pl.col("ouvert") + pl.col("ouvert_veille").fill_null(0))
+        .clip(lower_bound=0)
+        .alias("sortie")
+    )
+
+
+def _compter(
+    valeurs: dict[_Cle, tuple[int, int]],
+    table: pl.DataFrame,
+    code: str,
+    dimension: str | None = None,
+) -> None:
+    """Compte les lignes de `table` par date, périmètre (et dimension), en `n/1`."""
+    cles = ["date", "perimetre"] + ([dimension] if dimension else [])
+    if dimension:
+        table = table.filter(pl.col(dimension).is_not_null())
+    for ligne in table.group_by(cles).len().iter_rows():
+        dim = ligne[2] if dimension else ""
+        valeurs[(ligne[0], ligne[1], code, dim)] = (ligne[-1], 1)
+
+
+def _age(entree: date | None, jour: date, cle: str) -> int:
+    """Jours ouvrés après la dernière Entrée jusqu'à `jour` (0 le jour même)."""
+    if entree is None or entree > jour:
+        raise UsineErreur(
+            f"Anomalie ouverte {cle} en {jour.isoformat()} : date de dernière Entrée invalide"
+            f" ({entree.isoformat() if entree else 'absente'})"
+        )
+    return len(jours_ouvres(entree, jour)) - 1
+
+
+def _ages(valeurs: dict[_Cle, tuple[int, int]], ouvertes: pl.DataFrame) -> None:
+    """Âge médian (moyenne des deux centraux si pair, `Fraction` réduite) et maximum."""
+    groupes = ouvertes.group_by(["date", "perimetre"]).agg(
+        pl.col("cle_ticket"), pl.col("date_derniere_entree")
+    )
+    memo: dict[tuple[date | None, date], int] = {}
+    for jour, perimetre, cles, entrees in groupes.iter_rows():
+        ages: list[int] = []
+        for cle, entree in zip(cles, entrees, strict=True):
+            if (entree, jour) not in memo:
+                memo[(entree, jour)] = _age(entree, jour, cle)
+            ages.append(memo[(entree, jour)])
+        ages.sort()
+        milieu = len(ages) // 2
+        mediane = (
+            Fraction(ages[milieu])
+            if len(ages) % 2
+            else Fraction(ages[milieu - 1] + ages[milieu], 2)
+        )
+        valeurs[(jour, perimetre, AGE_MEDIAN, "")] = (mediane.numerator, mediane.denominator)
+        valeurs[(jour, perimetre, AGE_MAX, "")] = (ages[-1], 1)
+
+
+def _taux(valeurs: dict[_Cle, tuple[int, int]], cas: pl.DataFrame) -> None:
+    """Taux de KO = KO / (OK + KO) ; taux de non-exécution = non exécutés / Cas avec statut."""
+    comptes = (
+        cas.filter(pl.col("phase").is_not_null() & pl.col("statut_test").is_not_null())
+        .group_by(["date", "perimetre", "phase"])
+        .agg(
+            (pl.col("statut_test") == statut.value).sum().cast(pl.Int64).alias(statut.value)
+            for statut in StatutTest
+        )
+    )
+    ok, ko, non_execute = StatutTest.ok.value, StatutTest.ko.value, StatutTest.non_execute.value
+    for ligne in comptes.iter_rows(named=True):
+        base = (ligne["date"], ligne["perimetre"])
+        valeurs[(*base, TAUX_KO, ligne["phase"])] = (ligne[ko], ligne[ok] + ligne[ko])
+        valeurs[(*base, TAUX_NON_EXECUTION, ligne["phase"])] = (
+            ligne[non_execute],
+            ligne[ok] + ligne[ko] + ligne[non_execute],
+        )
+
+
+def _flux(
+    valeurs: dict[_Cle, tuple[int, int]],
+    anomalies: pl.DataFrame,
+    dates: list[date],
+    perimetres: Sequence[str],
+) -> None:
+    """Entrées et Sorties du jour, puis sur la Fenêtre glissante (jours hors table : 0)."""
+    jour: dict[tuple[date, str, str], int] = {}
+    sommes = anomalies.group_by(["date", "perimetre"]).agg(
+        pl.col("entree").sum().cast(pl.Int64), pl.col("sortie").sum().cast(pl.Int64)
+    )
+    for d, perimetre, entrees, sorties in sommes.iter_rows():
+        jour[(d, perimetre, ENTREES_JOUR)] = entrees
+        jour[(d, perimetre, SORTIES_JOUR)] = sorties
+    for d in dates:
+        fenetre = fenetre_glissante(d)
+        for perimetre in perimetres:
+            for code_jour, code_fenetre in (
+                (ENTREES_JOUR, ENTREES_FENETRE),
+                (SORTIES_JOUR, SORTIES_FENETRE),
+            ):
+                valeurs[(d, perimetre, code_jour, "")] = (jour.get((d, perimetre, code_jour), 0), 1)
+                total = sum(jour.get((f, perimetre, code_jour), 0) for f in fenetre)
+                valeurs[(d, perimetre, code_fenetre, "")] = (total, 1)
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : les KPI de `CODES_KPI` pour chaque date de `tickets_etats`.
+
+    Une ligne par date, périmètre (Entités dans l'ordre de `entites`, puis `PROGRAMME`), code
+    (ordre de `CODES_KPI`) et dimension (ordre de `DIMENSIONS_KPI`). Le Programme compte toutes
+    les lignes de la table, y compris celles d'Entités hors de `entites`. Le périmètre d'un
+    ticket est son Entité en D. Un ticket sans Gravité ou sans Phase compte dans les totaux,
+    dans aucune ventilation.
+
+    Précondition : la table couvre chaque Jour ouvré de sa première à sa dernière date (sinon
+    `UsineErreur`) ; à la première date, la veille est vide (début de l'historique).
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    dates = _dates(etats)
+    perimetres = (*entites, PERIMETRE_PROGRAMME)
+    etats = etats.with_columns(pl.col(pl.Enum).cast(pl.Utf8))
+
+    anomalies = _par_perimetre(_anomalies(etats, dates), entites)
+    ouvertes = anomalies.filter(pl.col("ouvert") == 1)
+    par_perimetre = _par_perimetre(etats, entites)
+    valeurs: dict[_Cle, tuple[int, int]] = {}
+    _compter(valeurs, ouvertes, ANOMALIES_OUVERTES)
+    _compter(valeurs, ouvertes, ANOMALIES_OUVERTES_GRAVITE, "gravite")
+    _compter(valeurs, ouvertes, ANOMALIES_OUVERTES_PHASE, "phase")
+    _flux(valeurs, anomalies, dates, perimetres)
+    _ages(valeurs, ouvertes)
+    _taux(valeurs, par_perimetre.filter(pl.col("type_ticket") == TypeTicket.cas_de_test.value))
+    _compter(
+        valeurs,
+        par_perimetre.filter(pl.col("type_ticket") == TypeTicket.certification.value),
+        CERTIFICATIONS,
+        "statut_certification",
+    )
+
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+    for d in dates:
+        for perimetre in perimetres:
+            for code in CODES_KPI:
+                defaut = (0, 0) if code in _CODES_SANS_VALEUR_PAR_DEFAUT else (0, 1)
+                for dimension in DIMENSIONS_KPI[code]:
+                    numerateur, denominateur = valeurs.get((d, perimetre, code, dimension), defaut)
+                    lignes["date"].append(d)
+                    lignes["perimetre"].append(perimetre)
+                    lignes["code_kpi"].append(code)
+                    lignes["dimension"].append(dimension)
+                    lignes["numerateur"].append(numerateur)
+                    lignes["denominateur"].append(denominateur)
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
