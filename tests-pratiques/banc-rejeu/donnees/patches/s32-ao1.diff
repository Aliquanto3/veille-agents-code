@@ -0,0 +1,374 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import Generation, generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ("ENT-A", "ENT-B")
+
+JEUDI = date(2026, 10, 1)
+VENDREDI = date(2026, 10, 2)
+LUNDI = date(2026, 10, 5)
+MARDI = date(2026, 10, 6)
+MERCREDI = date(2026, 10, 7)
+
+
+def _ts(d: date, heure: int) -> datetime:
+    return datetime(d.year, d.month, d.day, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, dates: list[date], entites: tuple[str, ...] = ENTITES) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, dates), entites)
+
+
+def _valeur(
+    table: pl.DataFrame, d: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == d)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne["numerateur"].item(), ligne["denominateur"].item()
+
+
+def _cas(flux: Flux, cle: str, d: date, phase: str, statut: str) -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(d, 9),
+        {Champ.entite: "ENT-A", Champ.phase: phase, Champ.statut_test: statut},
+    )
+
+
+def _certification(flux: Flux, cle: str, d: date, statut: str) -> None:
+    flux.creer(
+        cle,
+        TypeTicket.certification,
+        _ts(d, 9),
+        {Champ.entite: "ENT-A", Champ.statut_certification: statut},
+    )
+
+
+def test_schema_et_sortie_dense() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    table = _kpi(flux, [LUNDI, MARDI])
+    valider(table, SCHEMA_KPI)
+    par_perimetre = sum(len(DIMENSIONS_KPI[code]) for code in CODES_KPI)
+    assert table.height == 2 * 3 * par_perimetre
+    assert set(table["code_kpi"]) == set(CODES_KPI)
+    assert len(CODES_KPI) == 12
+    assert table.select(["date", "perimetre", "code_kpi", "dimension"]).is_unique().all()
+
+
+def test_ordre_des_lignes() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    table = _kpi(flux, [LUNDI, MARDI], ("ENT-B", "ENT-A"))
+    attendu = [
+        (d, perimetre, code, dimension)
+        for d in (LUNDI, MARDI)
+        for perimetre in ("ENT-B", "ENT-A", PERIMETRE_PROGRAMME)
+        for code in CODES_KPI
+        for dimension in DIMENSIONS_KPI[code]
+    ]
+    assert table.select(["date", "perimetre", "code_kpi", "dimension"]).rows() == attendu
+
+
+def test_aucune_colonne_flottante() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(JEUDI, 9))
+    flux.anomalie("DEMO-2", _ts(VENDREDI, 9))
+    table = _kpi(flux, [JEUDI, VENDREDI, LUNDI])
+    assert not any(dtype.is_float() for dtype in table.dtypes)
+    assert table["numerateur"].dtype == pl.Int64
+    assert table["denominateur"].dtype == pl.Int64
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    flux.anomalie("DEMO-2", _ts(LUNDI, 10))
+    flux.anomalie("DEMO-3", _ts(LUNDI, 11), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, [LUNDI])
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _valeur(table, LUNDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _valeur(table, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    programme = PERIMETRE_PROGRAMME
+    assert _valeur(table, LUNDI, programme, "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _valeur(table, LUNDI, programme, "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _valeur(table, LUNDI, programme, "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _valeur(table, LUNDI, programme, "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def test_sans_gravite_ni_phase_compte_dans_le_total_seulement() -> None:
+    flux = Flux()
+    flux.creer(
+        "DEMO-1",
+        TypeTicket.anomalie,
+        _ts(LUNDI, 9),
+        {Champ.statut: "nouvelle", Champ.entite: "ENT-A"},
+    )
+    table = _kpi(flux, [LUNDI])
+    assert _valeur(table, LUNDI, "ENT-A", "anomalies_ouvertes") == (1, 1)
+    gravites = table.filter(
+        (pl.col("perimetre") == "ENT-A")
+        & pl.col("code_kpi").is_in(["anomalies_ouvertes_gravite", "anomalies_ouvertes_phase"])
+    )
+    assert gravites["numerateur"].sum() == 0
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    flux.transition("DEMO-1", _ts(MARDI, 9), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(MERCREDI, 9), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(MERCREDI, 10), "en_analyse", "fermee")
+    table = _kpi(flux, [LUNDI, MARDI, MERCREDI])
+    entrees = [_valeur(table, d, "ENT-A", "entrees_jour")[0] for d in (LUNDI, MARDI, MERCREDI)]
+    sorties = [_valeur(table, d, "ENT-A", "sorties_jour")[0] for d in (LUNDI, MARDI, MERCREDI)]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+
+
+def test_creee_et_fermee_le_meme_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(LUNDI, 9))
+    flux.transition("DEMO-1", _ts(LUNDI, 10), "nouvelle", "rejetee")
+    table = _kpi(flux, [LUNDI])
+    assert _valeur(table, LUNDI, "ENT-A", "entrees_jour") == (1, 1)
+    assert _valeur(table, LUNDI, "ENT-A", "sorties_jour") == (1, 1)
