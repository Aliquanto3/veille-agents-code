+def test_determinisme(etats_generes: pl.DataFrame, entites_generees: tuple[str, ...]) -> None:
+    premier = kpi(etats_generes, entites_generees)
+    second = kpi(etats_generes.reverse(), entites_generees)
+    assert premier.equals(second)
