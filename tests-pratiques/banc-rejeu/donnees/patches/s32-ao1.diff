+def test_stock_egal_a_l_instantane(etats_generes: pl.DataFrame, kpi_generes: pl.DataFrame) -> None:
+    table = instantane(etats_generes)
+    ouvertes = (
+        table.filter(
+            (pl.col("type_ticket") == TypeTicket.anomalie.value)
+            & ~pl.col("statut").cast(pl.Utf8).is_in([s.value for s in STATUTS_FERMES])
+        )
+        .group_by("date")
+        .agg(pl.col("nombre").sum())
+    )
+    stock = kpi_generes.filter(
+        (pl.col("perimetre") == PERIMETRE_PROGRAMME) & (pl.col("code_kpi") == "anomalies_ouvertes")
+    ).select("date", "numerateur")
+    joint = stock.join(ouvertes, on="date", how="left").with_columns(pl.col("nombre").fill_null(0))
+    assert joint["numerateur"].to_list() == joint["nombre"].to_list()
+
+
+def test_conservation_du_stock(
+    kpi_generes: pl.DataFrame, entites_generees: tuple[str, ...]
+) -> None:
+    def serie(perimetre: str, code: str) -> list[int]:
+        return (
+            kpi_generes.filter((pl.col("perimetre") == perimetre) & (pl.col("code_kpi") == code))
+            .sort("date")["numerateur"]
+            .to_list()
+        )
+
+    for perimetre in (*entites_generees, PERIMETRE_PROGRAMME):
+        stock = serie(perimetre, "anomalies_ouvertes")
+        entrees = serie(perimetre, "entrees_jour")
+        sorties = serie(perimetre, "sorties_jour")
+        assert stock[0] == entrees[0] - sorties[0]
+        for i in range(1, len(stock)):
+            assert stock[i] - stock[i - 1] == entrees[i] - sorties[i], (perimetre, i)
+        assert all(s >= 0 for s in sorties)
+
