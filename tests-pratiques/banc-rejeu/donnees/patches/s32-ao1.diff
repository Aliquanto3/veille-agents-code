+def test_programme_somme_des_entites(kpi_generes: pl.DataFrame) -> None:
+    comptes = kpi_generes.filter(pl.col("code_kpi").is_in(_CODES_COMPTES))
+    cles = ["date", "code_kpi", "dimension"]
+    entites = (
+        comptes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by(cles)
+        .agg(pl.col("numerateur").sum())
+        .sort(cles)
+    )
+    programme = comptes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME).sort(cles)
+    assert entites["numerateur"].to_list() == programme["numerateur"].to_list()
+    assert programme["numerateur"].sum() > 0
+
