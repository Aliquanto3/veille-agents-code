+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : les états par ticket de chaque Jour ouvré et les Entités arrivent en paramètre.
+Tous les nombres sont des entiers ; un taux ou une valeur sans objet se lit `numerateur` /
+`denominateur`, `0/0` signifiant « pas de valeur ».
+"""
+
+from collections import defaultdict
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+_SANS_DIMENSION = ("",)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "anomalies_ouvertes": _SANS_DIMENSION,
+        "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+        "anomalies_ouvertes_phase": tuple(p.value for p in Phase),
+        "entrees_jour": _SANS_DIMENSION,
+        "sorties_jour": _SANS_DIMENSION,
+        "entrees_fenetre": _SANS_DIMENSION,
+        "sorties_fenetre": _SANS_DIMENSION,
+        "age_median_anomalies_ouvertes": _SANS_DIMENSION,
+        "age_max_anomalies_ouvertes": _SANS_DIMENSION,
+        "taux_ko_cas_de_test": tuple(p.value for p in Phase),
+        "taux_non_execution_cas_de_test": tuple(p.value for p in Phase),
+        "certifications": tuple(s.value for s in StatutCertification),
+    }
+)
+"""Catalogue : dimensions de chaque `code_kpi`, dans l'ordre des lignes produites."""
+
+CODES_KPI: tuple[str, ...] = tuple(DIMENSIONS_KPI)
+"""Codes de KPI, dans l'ordre figé des lignes produites."""
+
+_FERMES = frozenset(s.value for s in STATUTS_FERMES)
+
+_Cle = tuple[date, str, str, str]
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée {PERIMETRE_PROGRAMME} : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Chaque Jour ouvré de la première à la dernière date doit être présent, et lui seul."""
+    presentes = set(dates)
+    attendues = jours_ouvres(min(presentes), max(presentes))
+    manquantes = [jour for jour in attendues if jour not in presentes]
+    if manquantes:
+        raise UsineErreur(
+            "États des tickets : Jour ouvré manquant "
+            f"{', '.join(jour.isoformat() for jour in manquantes)}"
+        )
+    en_trop = sorted(presentes - set(attendues))
+    if en_trop:
+        raise UsineErreur(
+            f"États des tickets : date qui n'est pas un Jour ouvré {en_trop[0].isoformat()}"
+        )
+
+
+def _mediane(ages: list[int]) -> tuple[int, int]:
+    if not ages:
+        return 0, 0
+    ages = sorted(ages)
+    milieu = len(ages) // 2
+    if len(ages) % 2:
+        valeur = Fraction(ages[milieu])
+    else:
+        valeur = Fraction(ages[milieu - 1] + ages[milieu], 2)
+    return valeur.numerator, valeur.denominator
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : les KPI de chaque Jour ouvré de `tickets_etats`, par périmètre.
+
+    Périmètres : chaque Entité de `entites` (dans l'ordre), puis `PROGRAMME` (toutes les lignes
+    de la table, y compris des Entités hors de `entites`). Sortie dense, triée par date,
+    périmètre, code puis dimension.
+
+    Précondition : la table couvre chaque Jour ouvré de sa première à sa dernière date ; à la
+    première, la veille est vide. Entrée = `date_derniere_entree` ; Sortie = Entrée moins la
+    variation du nombre d'Anomalies ouvertes du ticket (au moins 0).
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    if etats.is_empty():
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = sorted(set(etats.get_column("date").to_list()))
+    _verifier_dates(dates)
+
+    par_date: dict[date, list[dict[str, object]]] = defaultdict(list)
+    for ligne in etats.iter_rows(named=True):
+        par_date[ligne["date"]].append(ligne)  # type: ignore[index]
+
+    nombres: defaultdict[_Cle, int] = defaultdict(int)
+    taux: defaultdict[tuple[date, str, str, str], int] = defaultdict(int)
+    ages: defaultdict[tuple[date, str], list[int]] = defaultdict(list)
+    ouverts_veille: set[str] = set()
+    suivis = set(entites)
+
+    for jour in dates:
+        ouverts: set[str] = set()
+        for ligne in par_date[jour]:
+            cle = str(ligne["cle_ticket"])
+            entite = ligne["entite"]
+            cibles = [PERIMETRE_PROGRAMME]
+            if isinstance(entite, str) and entite in suivis:
+                cibles.append(entite)
+            type_ticket = ligne["type_ticket"]
+            if type_ticket == TypeTicket.anomalie.value:
+                statut = ligne["statut"]
+                ouvert = statut is not None and statut not in _FERMES
+                if ouvert:
+                    ouverts.add(cle)
+                entree = int(ligne["date_derniere_entree"] == jour)
+                variation = int(ouvert) - int(cle in ouverts_veille)
+                sortie = max(entree - variation, 0)
+                for p in cibles:
+                    nombres[jour, p, "entrees_jour", ""] += entree
+                    nombres[jour, p, "sorties_jour", ""] += sortie
+                    if not ouvert:
+                        continue
+                    nombres[jour, p, "anomalies_ouvertes", ""] += 1
+                    if ligne["gravite"] is not None:
+                        nombres[jour, p, "anomalies_ouvertes_gravite", str(ligne["gravite"])] += 1
+                    if ligne["phase"] is not None:
+                        nombres[jour, p, "anomalies_ouvertes_phase", str(ligne["phase"])] += 1
+                    derniere_entree = ligne["date_derniere_entree"]
+                    if isinstance(derniere_entree, date):
+                        ages[jour, p].append(len(jours_ouvres(derniere_entree, jour)) - 1)
+            elif type_ticket == TypeTicket.cas_de_test.value:
+                statut_test = ligne["statut_test"]
+                if statut_test is None:
+                    continue
+                for p in cibles:
+                    if ligne["phase"] is not None:
+                        taux[jour, p, str(ligne["phase"]), str(statut_test)] += 1
+            elif ligne["statut_certification"] is not None:
+                for p in cibles:
+                    nombres[jour, p, "certifications", str(ligne["statut_certification"])] += 1
+        ouverts_veille = ouverts
+
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+
+    def ajouter(jour: date, p: str, code: str, dimension: str, num: int, den: int) -> None:
+        for colonne, valeur in zip(
+            lignes, (jour, p, code, dimension, num, den), strict=True
+        ):
+            lignes[colonne].append(valeur)
+
+    connues = set(dates)
+    for jour in dates:
+        fenetre = [d for d in fenetre_glissante(jour) if d in connues]
+        for p in perimetres:
+            for code, dimensions in DIMENSIONS_KPI.items():
+                for dimension in dimensions:
+                    num, den = 0, 1
+                    if code in ("entrees_fenetre", "sorties_fenetre"):
+                        jour_code = code.replace("fenetre", "jour")
+                        num = sum(nombres[d, p, jour_code, ""] for d in fenetre)
+                    elif code == "age_median_anomalies_ouvertes":
+                        num, den = _mediane(ages[jour, p])
+                    elif code == "age_max_anomalies_ouvertes":
+                        valeurs = ages[jour, p]
+                        num, den = (max(valeurs), 1) if valeurs else (0, 0)
+                    elif code == "taux_ko_cas_de_test":
+                        ok = taux[jour, p, dimension, StatutTest.ok.value]
+                        ko = taux[jour, p, dimension, StatutTest.ko.value]
+                        num, den = ko, ok + ko
+                    elif code == "taux_non_execution_cas_de_test":
+                        statuts = [taux[jour, p, dimension, s.value] for s in StatutTest]
+                        num = taux[jour, p, dimension, StatutTest.non_execute.value]
+                        den = sum(statuts)
+                    else:
+                        num = nombres[jour, p, code, dimension]
+                    ajouter(jour, p, code, dimension, num, den)
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
