+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+JEUDI = date(2026, 10, 1)
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, jours: list[date], entites: list[str] | None = None) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, jours), ENTITES if entites is None else entites)
+
+
+def _val(
+    table: pl.DataFrame, d: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    (ligne,) = table.filter(
+        (pl.col("date") == d)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    ).to_dicts()
+    return ligne["numerateur"], ligne["denominateur"]
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(1))
+    flux.anomalie("DEMO-3", _ts(1), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, [JEUDI])
+    assert _val(table, JEUDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(table, JEUDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(table, JEUDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(table, JEUDI, "ENT-A", "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(table, JEUDI, "ENT-A", "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(table, JEUDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))  # lundi
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 8), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(7, 9), "en_analyse", "fermee")
+    jours = list(jours_ouvres(date(2026, 10, 5), date(2026, 10, 7)))
+    table = _kpi(flux, jours)
+    entrees = [_val(table, d, "ENT-A", "entrees_jour")[0] for d in jours]
+    sorties = [_val(table, d, "ENT-A", "sorties_jour")[0] for d in jours]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    jours = list(jours_ouvres(JEUDI, date(2026, 10, 9)))  # 7 Jours ouvrés
+    for numero, jour in enumerate((1, 2, 5, 6, 7, 8, 9), start=1):
+        flux.anomalie(f"DEMO-{numero}", _ts(jour))
+    table = _kpi(flux, jours)
+    assert _val(table, jours[1], "ENT-A", "entrees_fenetre") == (2, 1)  # avant la table : 0
+    assert _val(table, jours[4], "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(table, jours[6], "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(table, jours[6], "ENT-A", "sorties_fenetre") == (0, 1)
+
+
+def test_age_median_et_maximum() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    jours = list(jours_ouvres(JEUDI, date(2026, 10, 7)))
+    table = _kpi(flux, jours)
+    d = date(2026, 10, 7)
+    assert _val(table, d, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(table, d, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(table, JEUDI, "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))  # J0 = jeudi
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")  # J2
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")  # J5
+    jours = list(jours_ouvres(JEUDI, date(2026, 10, 9)))  # J6 = vendredi 9
+    table = _kpi(flux, jours)
+    assert _val(table, jours[-1], "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(table, jours[-1], "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1), statut="fermee")
+    table = _kpi(flux, [JEUDI])
+    assert _val(table, JEUDI, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(table, JEUDI, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def _cas_de_test(flux: Flux, numero: int, statut: str, phase: str = "recette") -> None:
+    flux.creer(
+        f"DEMO-{numero}",
+        TypeTicket.cas_de_test,
+        _ts(1),
+        {
+            Champ.statut_test: statut,
+            Champ.entite: "ENT-A",
+            Champ.vague: "V1",
+            Champ.domaine: "paie",
+            Champ.phase: phase,
+        },
+    )
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for numero, statut in enumerate(("ok", "ok", "ok", "ko", "non_execute", "non_execute")):
+        _cas_de_test(flux, numero + 1, statut)
+    table = _kpi(flux, [JEUDI])
+    assert _val(table, JEUDI, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(table, JEUDI, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(table, JEUDI, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(table, JEUDI, "ENT-A", "taux_non_execution_cas_de_test", "tnr") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for numero, statut in enumerate(("accordee", "reservee", "reservee"), start=1):
+        flux.creer(
+            f"DEMO-{numero}",
+            TypeTicket.certification,
+            _ts(1),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A", Champ.vague: "V1"},
+        )
+    table = _kpi(flux, [JEUDI])
+    assert _val(table, JEUDI, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(table, JEUDI, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(table, JEUDI, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        _kpi(flux, [date(2026, 10, 5), date(2026, 10, 7)])
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"), [(["ENT-A", "ENT-A"], "ENT-A"), (["ENT-A", "PROGRAMME"], "PROGRAMME")]
+)
+def test_entites_invalides(entites: list[str], valeur: str) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    with pytest.raises(UsineErreur, match=valeur):
+        _kpi(flux, [JEUDI], entites)
+
+
+def test_table_vide() -> None:
+    table = kpi(tickets_etats([], []), ENTITES)
+    assert table.is_empty()
+    valider(table, SCHEMA_KPI)
+
+
+@pytest.fixture(scope="module")
+def generation_kpi() -> tuple[pl.DataFrame, pl.DataFrame]:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    gen = generer(config, 42, date(2026, 10, 12))
+    jours = jours_ouvres(gen.entete.ancrage_semaines, gen.entete.date_injection)
+    etats = tickets_etats(gen.evenements, jours)
+    entites = [e.code if hasattr(e, "code") else str(e) for e in config.entites]
+    return etats, kpi(etats, entites)
+
+
+def test_schema_sans_flottant_et_catalogue(
+    generation_kpi: tuple[pl.DataFrame, pl.DataFrame],
+) -> None:
+    _, table = generation_kpi
+    valider(table, SCHEMA_KPI)
+    assert not any(dtype.is_float() for dtype in table.schema.values())
+    assert list(dict.fromkeys(table["code_kpi"])) == list(CODES_KPI)
+    un_jour = table.filter(
+        (pl.col("date") == table["date"][0]) & (pl.col("perimetre") == PERIMETRE_PROGRAMME)
+    )
+    assert un_jour.height == sum(len(d) for d in DIMENSIONS_KPI.values())
+
+
+def test_programme_somme_des_entites_et_instantane(
+    generation_kpi: tuple[pl.DataFrame, pl.DataFrame],
+) -> None:
+    etats, table = generation_kpi
+    comptes = table.filter(
+        pl.col("code_kpi").is_in(["anomalies_ouvertes", "entrees_jour", "sorties_fenetre"])
+    )
+    par_perimetre = comptes.group_by("date", "code_kpi", "perimetre").agg(
+        pl.col("numerateur").sum()
+    )
+    programme = par_perimetre.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME)
+    entites = (
+        par_perimetre.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+        .group_by("date", "code_kpi")
+        .agg(pl.col("numerateur").sum().alias("somme"))
+    )
+    joint = programme.join(entites, on=["date", "code_kpi"])
+    assert joint.height == programme.height
+    assert (joint["numerateur"] == joint["somme"]).all()
+    inst = instantane(etats)
+    ouvertes = (
+        inst.filter(
+            (pl.col("type_ticket") == "anomalie") & ~pl.col("statut").is_in(["fermee", "rejetee"])
+        )
+        .group_by("date")
+        .agg(pl.col("nombre").sum())
+    )
+    stock = table.filter(
+        (pl.col("code_kpi") == "anomalies_ouvertes") & (pl.col("perimetre") == PERIMETRE_PROGRAMME)
+    )
+    verifie = stock.join(ouvertes, on="date", how="left").with_columns(pl.col("nombre").fill_null(0))
+    assert (verifie["numerateur"] == verifie["nombre"]).all()
+
+
+def test_determinisme_et_conservation(generation_kpi: tuple[pl.DataFrame, pl.DataFrame]) -> None:
+    etats, table = generation_kpi
+    entites = sorted(set(table["perimetre"]) - {PERIMETRE_PROGRAMME})
+    # Même entrée, même sortie (ordre compris) ; l'ordre des Entités fixe celui des périmètres.
+    assert kpi(etats, entites).equals(kpi(etats, entites))
+    for perimetre in set(table["perimetre"]):
+        def serie(code: str, perimetre: str = perimetre) -> list[int]:
+            return table.filter(
+                (pl.col("code_kpi") == code) & (pl.col("perimetre") == perimetre)
+            )["numerateur"].to_list()
+
+        stock, entrees, sorties = (
+            serie("anomalies_ouvertes"),
+            serie("entrees_jour"),
+            serie("sorties_jour"),
+        )
+        for i in range(1, len(stock)):
+            assert stock[i] - stock[i - 1] == entrees[i] - sorties[i]
