@@ -0,0 +1,231 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : les états par ticket et les Entités arrivent en paramètre. Définitions H-17
+(Anomalie ouverte, Entrée, Sortie) et Fenêtre glissante H-19 (`contrats.calendrier`). Tous les
+nombres sont des entiers : un taux est porté en `numerateur`/`denominateur`, `0/0` valant
+« pas de valeur ».
+"""
+
+from collections import defaultdict
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import (
+    est_jour_ouvre,
+    fenetre_glissante,
+    jours_ouvres,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = {
+    "anomalies_ouvertes": ("",),
+    "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+    "anomalies_ouvertes_phase": tuple(p.value for p in Phase),
+    "entrees_jour": ("",),
+    "sorties_jour": ("",),
+    "entrees_fenetre": ("",),
+    "sorties_fenetre": ("",),
+    "age_median_anomalies_ouvertes": ("",),
+    "age_max_anomalies_ouvertes": ("",),
+    "taux_ko_cas_de_test": tuple(p.value for p in Phase),
+    "taux_non_execution_cas_de_test": tuple(p.value for p in Phase),
+    "certifications": tuple(s.value for s in StatutCertification),
+}
+"""Catalogue : `code_kpi` → valeurs de `dimension`, dans l'ordre de sortie."""
+
+CODES_KPI: tuple[str, ...] = tuple(DIMENSIONS_KPI)
+"""Codes des KPI, dans l'ordre de sortie."""
+
+_FERMES = frozenset(s.value for s in STATUTS_FERMES)
+
+_Mesure = tuple[int, int]
+_Cle = tuple[str, str]  # (code_kpi, dimension)
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée {PERIMETRE_PROGRAMME} : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Les dates couvrent chaque Jour ouvré de la première à la dernière."""
+    for jour in dates:
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(f"KPI : {jour.isoformat()} n'est pas un Jour ouvré")
+    attendues = jours_ouvres(dates[0], dates[-1])
+    manquantes = [jour for jour in attendues if jour not in set(dates)]
+    if manquantes:
+        raise UsineErreur(
+            "KPI : date(s) manquante(s) dans l'état des tickets reçu : "
+            + ", ".join(jour.isoformat() for jour in manquantes)
+        )
+
+
+def _statistiques(lignes: list[tuple[object, ...]], jour: date, ouverts_veille: set[str]) -> dict[
+    _Cle, _Mesure
+]:
+    """Mesures d'un périmètre en `jour` (hors Fenêtre glissante) ; `lignes` = états du jour."""
+    ouvertes = 0
+    par_gravite: dict[str, int] = defaultdict(int)
+    par_phase: dict[str, int] = defaultdict(int)
+    entrees = sorties = 0
+    ages: list[int] = []
+    tests: dict[str, dict[str, int]] = defaultdict(lambda: defaultdict(int))
+    certifications: dict[str, int] = defaultdict(int)
+    for cle, type_ticket, gravite, phase, statut, statut_test, statut_cert, entree in lignes:
+        if type_ticket == TypeTicket.anomalie.value:
+            ouverte = statut is not None and statut not in _FERMES
+            e = 1 if entree == jour else 0
+            entrees += e
+            sorties += e - (int(ouverte) - int(cle in ouverts_veille))
+            if ouverte:
+                ouvertes += 1
+                if gravite is not None:
+                    par_gravite[str(gravite)] += 1
+                if phase is not None:
+                    par_phase[str(phase)] += 1
+                if isinstance(entree, date):
+                    ages.append(len(jours_ouvres(entree, jour)) - 1)
+        elif type_ticket == TypeTicket.cas_de_test.value:
+            if statut_test is not None and phase is not None:
+                tests[str(phase)][str(statut_test)] += 1
+        elif statut_cert is not None:
+            certifications[str(statut_cert)] += 1
+    mesures: dict[_Cle, _Mesure] = {
+        ("anomalies_ouvertes", ""): (ouvertes, 1),
+        ("entrees_jour", ""): (entrees, 1),
+        ("sorties_jour", ""): (sorties, 1),
+        ("age_max_anomalies_ouvertes", ""): (max(ages), 1) if ages else (0, 0),
+    }
+    if ages:
+        triees = sorted(ages)
+        milieu = len(triees) // 2
+        mediane = (
+            Fraction(triees[milieu])
+            if len(triees) % 2
+            else Fraction(triees[milieu - 1] + triees[milieu], 2)
+        )
+        mesures[("age_median_anomalies_ouvertes", "")] = (mediane.numerator, mediane.denominator)
+    else:
+        mesures[("age_median_anomalies_ouvertes", "")] = (0, 0)
+    for gravite_v in DIMENSIONS_KPI["anomalies_ouvertes_gravite"]:
+        mesures[("anomalies_ouvertes_gravite", gravite_v)] = (par_gravite[gravite_v], 1)
+    for phase_v in DIMENSIONS_KPI["taux_ko_cas_de_test"]:
+        mesures[("anomalies_ouvertes_phase", phase_v)] = (par_phase[phase_v], 1)
+        compte = tests[phase_v]
+        executes = compte[StatutTest.ok.value] + compte[StatutTest.ko.value]
+        mesures[("taux_ko_cas_de_test", phase_v)] = (compte[StatutTest.ko.value], executes)
+        mesures[("taux_non_execution_cas_de_test", phase_v)] = (
+            compte[StatutTest.non_execute.value],
+            executes + compte[StatutTest.non_execute.value],
+        )
+    for statut_v in DIMENSIONS_KPI["certifications"]:
+        mesures[("certifications", statut_v)] = (certifications[statut_v], 1)
+    return mesures
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : pour chaque date de `tickets_etats`, chaque périmètre, code et dimension.
+
+    Périmètres : `entites` dans l'ordre reçu, puis `PROGRAMME` (toutes les lignes de la table,
+    y compris des Entités hors de `entites`). Sortie dense, triée par date, périmètre, code et
+    dimension. Entrées et Sorties du jour viennent de `date_derniere_entree` et de la variation
+    du statut ouvert ; la Fenêtre glissante somme les Jours ouvrés antérieurs à la table pour 0.
+
+    Précondition : la table couvre chaque Jour ouvré de sa première à sa dernière date ; à sa
+    première date, la veille est vide.
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    if etats.height == 0:
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = sorted(set(etats.get_column("date").to_list()))
+    _verifier_dates(dates)
+
+    lignes_par_date: dict[date, list[tuple[object, ...]]] = defaultdict(list)
+    entite_par_ligne: dict[date, list[str | None]] = defaultdict(list)
+    selection = etats.select(
+        "date",
+        "cle_ticket",
+        pl.col("type_ticket").cast(pl.Utf8),
+        pl.col("gravite").cast(pl.Utf8),
+        pl.col("phase").cast(pl.Utf8),
+        pl.col("statut").cast(pl.Utf8),
+        pl.col("statut_test").cast(pl.Utf8),
+        pl.col("statut_certification").cast(pl.Utf8),
+        "date_derniere_entree",
+        "entite",
+    )
+    for jour, *reste, entite in selection.iter_rows():
+        lignes_par_date[jour].append(tuple(reste))
+        entite_par_ligne[jour].append(entite)
+
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    quotidien: dict[tuple[date, str], dict[_Cle, _Mesure]] = {}
+    ouverts_veille: set[str] = set()
+    for jour in dates:
+        lignes = lignes_par_date[jour]
+        proprietaires = entite_par_ligne[jour]
+        for perimetre in perimetres:
+            if perimetre == PERIMETRE_PROGRAMME:
+                choisies = lignes
+            else:
+                choisies = [
+                    ligne
+                    for ligne, proprietaire in zip(lignes, proprietaires, strict=True)
+                    if proprietaire == perimetre
+                ]
+            quotidien[(jour, perimetre)] = _statistiques(choisies, jour, ouverts_veille)
+        # « Ouvert la veille » se lit par ticket, quelle que soit son Entité.
+        ouverts_veille = {
+            str(ligne[0])
+            for ligne in lignes
+            if ligne[1] == TypeTicket.anomalie.value
+            and ligne[4] is not None
+            and ligne[4] not in _FERMES
+        }
+
+    colonnes_sortie: dict[str, list[object]] = {nom: [] for nom in SCHEMA_KPI.colonnes}
+    premiere = dates[0]
+    for jour in dates:
+        fenetre = fenetre_glissante(jour)
+        for perimetre in perimetres:
+            mesures = quotidien[(jour, perimetre)]
+            for code, valeurs in DIMENSIONS_KPI.items():
+                for dimension in valeurs:
+                    if code in ("entrees_fenetre", "sorties_fenetre"):
+                        source = ("entrees" if code.startswith("entrees") else "sorties") + "_jour"
+                        numerateur = sum(
+                            quotidien[(j, perimetre)][(source, "")][0] for j in fenetre if j >= premiere
+                        )
+                        mesure: _Mesure = (numerateur, 1)
+                    else:
+                        mesure = mesures[(code, dimension)]
+                    colonnes_sortie["date"].append(jour)
+                    colonnes_sortie["perimetre"].append(perimetre)
+                    colonnes_sortie["code_kpi"].append(code)
+                    colonnes_sortie["dimension"].append(dimension)
+                    colonnes_sortie["numerateur"].append(mesure[0])
+                    colonnes_sortie["denominateur"].append(mesure[1])
+    table = pl.DataFrame(colonnes_sortie, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
+
diff --git a/tests/unit/domaine/test_kpi.py b/tests/unit/domaine/test_kpi.py
