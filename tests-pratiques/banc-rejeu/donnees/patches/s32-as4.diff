@@ -0,0 +1,249 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.adaptateurs.journal import SourceJournal
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+J1 = date(2026, 10, 1)  # jeudi
+J2 = date(2026, 10, 2)  # vendredi
+J3 = date(2026, 10, 5)  # lundi
+J4 = date(2026, 10, 6)
+J5 = date(2026, 10, 7)  # mercredi
+J6 = date(2026, 10, 8)
+J7 = date(2026, 10, 9)
+
+
+def _ts(jour: date, heure: int = 9) -> datetime:
+    return datetime(jour.year, jour.month, jour.day, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, debut: date, fin: date) -> pl.DataFrame:
+    return kpi(tickets_etats(flux.evenements, jours_ouvres(debut, fin)), ENTITES)
+
+
+def _val(
+    table: pl.DataFrame, jour: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == jour)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne.item(0, "numerateur"), ligne.item(0, "denominateur")
+
+
+def _cas(flux: Flux, cle: str, statut: str, phase: str = "recette") -> None:
+    flux.creer(
+        cle,
+        TypeTicket.cas_de_test,
+        _ts(J1),
+        {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: phase},
+    )
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J1))
+    flux.anomalie("DEMO-2", _ts(J1))
+    flux.anomalie("DEMO-3", _ts(J1), entite="ENT-B", gravite="majeure", statut="fermee")
+    t = _kpi(flux, J1, J1)
+    assert _val(t, J1, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(t, J1, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(t, J1, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(t, J1, "ENT-A", "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(t, J1, "ENT-A", "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(t, J1, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J3))
+    flux.transition("DEMO-1", _ts(J4), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(J5, 8), "fermee", "nouvelle")
+    flux.transition("DEMO-1", _ts(J5, 9), "nouvelle", "fermee")
+    t = _kpi(flux, J3, J5)
+    assert [_val(t, j, "ENT-A", "entrees_jour")[0] for j in (J3, J4, J5)] == [1, 0, 1]
+    assert [_val(t, j, "ENT-A", "sorties_jour")[0] for j in (J3, J4, J5)] == [0, 1, 1]
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    jours = jours_ouvres(J1, J7)
+    assert len(jours) == 7
+    for rang, jour in enumerate(jours):
+        flux.anomalie(f"DEMO-{rang + 1}", _ts(jour))
+    flux.transition("DEMO-1", _ts(J7), "nouvelle", "fermee")
+    t = _kpi(flux, J1, J7)
+    assert _val(t, J2, "ENT-A", "entrees_fenetre") == (2, 1)
+    assert _val(t, J7, "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(t, J7, "ENT-A", "sorties_fenetre") == (1, 1)
+    assert _val(t, J6, "ENT-A", "sorties_fenetre") == (0, 1)
+
+
+def test_age() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J1))
+    flux.anomalie("DEMO-2", _ts(J2))
+    t = _kpi(flux, J1, J5)
+    assert _val(t, J5, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(t, J5, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(t, J1, "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+
+
+def test_age_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J1))
+    flux.transition("DEMO-1", _ts(J3), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(J6), "fermee", "nouvelle")
+    t = _kpi(flux, J1, J7)
+    assert _val(t, J7, "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(t, J7, "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J1), statut="fermee")
+    t = _kpi(flux, J1, J1)
+    assert _val(t, J1, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(t, J1, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for rang, statut in enumerate(["ok", "ok", "ok", "ko", "non_execute", "non_execute"]):
+        _cas(flux, f"DEMO-{rang + 1}", statut)
+    t = _kpi(flux, J1, J1)
+    assert _val(t, J1, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(t, J1, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(t, J1, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(t, J1, "ENT-A", "taux_non_execution_cas_de_test", "tnr") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for rang, statut in enumerate(["accordee", "reservee", "reservee"]):
+        flux.creer(
+            f"DEMO-{rang + 1}",
+            TypeTicket.certification,
+            _ts(J1),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    t = _kpi(flux, J1, J1)
+    assert _val(t, J1, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(t, J1, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(t, J1, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J3))
+    etats = tickets_etats(flux.evenements, [J3, J5])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize("entites", [["ENT-A", "ENT-A"], ["ENT-A", PERIMETRE_PROGRAMME]])
+def test_entites_invalides(entites: list[str]) -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J1))
+    etats = tickets_etats(flux.evenements, [J1])
+    with pytest.raises(UsineErreur, match=entites[1]):
+        kpi(etats, entites)
+
+
+def test_table_vide() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J1))
+    vide = tickets_etats(flux.evenements, [J1]).head(0)
+    t = kpi(vide, ENTITES)
+    assert t.height == 0
+    assert t.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+
+
+def test_schema_dense_et_sans_flottant() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(J1))
+    t = _kpi(flux, J1, J2)
+    valider(t, SCHEMA_KPI)
+    par_perimetre = sum(len(v) for v in DIMENSIONS_KPI.values())
+    assert t.height == 2 * 3 * par_perimetre
+    assert list(DIMENSIONS_KPI) == list(CODES_KPI)
+    assert len(CODES_KPI) == 12
+    assert not any(dtype.is_float() for dtype in t.schema.values())
+    assert t.get_column("perimetre").unique(maintain_order=True).to_list() == [
+        *ENTITES,
+        PERIMETRE_PROGRAMME,
+    ]
+
+
+def test_journal_genere(tmp_path: Path) -> None:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generer(config, 42, date(2026, 10, 12))))
+    source = SourceJournal(chemin)
+    evenements = list(source.evenements())
+    fin = source.entete.date_injection
+    dates = jours_ouvres(min(e.horodatage.date() for e in evenements), fin)
+    etats = tickets_etats(evenements, dates)
+    entites = [e.code for e in config.entites]
+    t = kpi(etats, entites)
+    assert t.equals(kpi(etats, entites))
+
+    simples = t.filter(pl.col("dimension") == "")
+    for code in ("anomalies_ouvertes", "entrees_jour", "sorties_jour"):
+        lignes = simples.filter(pl.col("code_kpi") == code)
+        somme = (
+            lignes.filter(pl.col("perimetre") != PERIMETRE_PROGRAMME)
+            .group_by("date")
+            .agg(pl.col("numerateur").sum())
+        )
+        programme = lignes.filter(pl.col("perimetre") == PERIMETRE_PROGRAMME)
+        assert somme.sort("date").get_column("numerateur").to_list() == (
+            programme.sort("date").get_column("numerateur").to_list()
+        )
+
+    fermes = [s.value for s in STATUTS_FERMES]
+    stock_instantane = (
+        instantane(etats)
+        .filter(
+            (pl.col("type_ticket") == TypeTicket.anomalie.value)
+            & ~pl.col("statut").cast(pl.Utf8).is_in(fermes)
+        )
+        .group_by("date")
+        .agg(pl.col("nombre").sum())
+        .sort("date")
+    )
+    stock = _serie(t, "anomalies_ouvertes")
+    assert [stock[d] for d in stock_instantane.get_column("date")] == (
+        stock_instantane.get_column("nombre").to_list()
+    )
+
+    entrees, sorties = _serie(t, "entrees_jour"), _serie(t, "sorties_jour")
+    precedent = 0
+    for jour in dates:
+        assert stock[jour] - precedent == entrees[jour] - sorties[jour], jour
+        precedent = stock[jour]
+
+
+def _serie(t: pl.DataFrame, code: str) -> dict[date, int]:
+    lignes = t.filter((pl.col("code_kpi") == code) & (pl.col("perimetre") == PERIMETRE_PROGRAMME))
+    return dict(zip(lignes.get_column("date"), lignes.get_column("numerateur"), strict=True))
