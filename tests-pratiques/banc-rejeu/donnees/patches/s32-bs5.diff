@@ -0,0 +1,255 @@
+"""KPI quotidiens par Entité et pour le Programme (FR-11).
+
+Fonction pure : les Entités arrivent en paramètre, le temps vient de `contrats.calendrier` (AD-17).
+Entrée et Sortie suivent H-17 ; la Fenêtre glissante est celle de H-19. Tout est en entiers :
+un compte vaut `n/1`, un taux ou un âge sans valeur vaut `0/0` (AD-10).
+"""
+
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des KPI, dans l'ordre de sortie ; `code_kpi` est un texte libre (D10)."""
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = {
+    "anomalies_ouvertes": ("",),
+    "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+    "anomalies_ouvertes_phase": tuple(p.value for p in Phase),
+    "entrees_jour": ("",),
+    "sorties_jour": ("",),
+    "entrees_fenetre": ("",),
+    "sorties_fenetre": ("",),
+    "age_median_anomalies_ouvertes": ("",),
+    "age_max_anomalies_ouvertes": ("",),
+    "taux_ko_cas_de_test": tuple(p.value for p in Phase),
+    "taux_non_execution_cas_de_test": tuple(p.value for p in Phase),
+    "certifications": tuple(s.value for s in StatutCertification),
+}
+"""Dimensions de chaque KPI, dans l'ordre des énumérations ; `""` si le KPI n'est pas ventilé."""
+
+_Cle = tuple[date, str, str]
+_Valeur = tuple[int, int]
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité demandée {PERIMETRE_PROGRAMME} : valeur réservée au périmètre du Programme"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Refuse une table qui ne couvre pas chaque Jour ouvré de sa première à sa dernière date."""
+    presentes = set(dates)
+    attendues = jours_ouvres(dates[0], dates[-1])
+    manquantes = [d for d in attendues if d not in presentes]
+    if manquantes:
+        raise UsineErreur(
+            "États des tickets : date manquante "
+            + ", ".join(d.isoformat() for d in manquantes)
+            + " (chaque Jour ouvré doit être calculé)"
+        )
+    hors_ouvres = sorted(presentes - set(attendues))
+    if hors_ouvres:
+        raise UsineErreur(
+            "États des tickets : date qui n'est pas un Jour ouvré "
+            + ", ".join(d.isoformat() for d in hors_ouvres)
+        )
+
+
+def _anomalies(etats: pl.DataFrame) -> pl.DataFrame:
+    """Anomalies avec leur état ouvert et leurs mouvements du jour (`entree`, `sortie`)."""
+    fermes = [s.value for s in STATUTS_FERMES]
+    ouvert = pl.col("statut").is_not_null() & ~pl.col("statut").cast(pl.Utf8).is_in(fermes)
+    return (
+        etats.filter(pl.col("type_ticket") == TypeTicket.anomalie.value)
+        .sort("cle_ticket", "date")
+        .with_columns(ouvert.alias("ouvert"))
+        .with_columns(
+            pl.col("ouvert").shift(1).over("cle_ticket").fill_null(False).alias("ouvert_veille"),
+            (pl.col("date_derniere_entree") == pl.col("date"))
+            .fill_null(False)
+            .cast(pl.Int64)
+            .alias("entree"),
+        )
+        .with_columns(
+            (
+                pl.col("entree")
+                - pl.col("ouvert").cast(pl.Int64)
+                + pl.col("ouvert_veille").cast(pl.Int64)
+            ).alias("sortie")
+        )
+    )
+
+
+def _compter(
+    frame: pl.DataFrame, cles: Sequence[str], somme: str | None = None
+) -> dict[tuple, int]:  # type: ignore[type-arg]
+    """Nombre de lignes (ou somme de `somme`) par combinaison de `cles`."""
+    mesure = pl.len() if somme is None else pl.col(somme).sum()
+    agrege = frame.group_by(list(cles)).agg(mesure.cast(pl.Int64).alias("_n"))
+    return {tuple(ligne[:-1]): int(ligne[-1]) for ligne in agrege.iter_rows()}
+
+
+def _mediane(ages: list[int]) -> Fraction:
+    ordonnes = sorted(ages)
+    milieu = len(ordonnes) // 2
+    if len(ordonnes) % 2:
+        return Fraction(ordonnes[milieu])
+    return Fraction(ordonnes[milieu - 1] + ordonnes[milieu], 2)
+
+
+def _ages(ouvertes: pl.DataFrame) -> dict[date, list[int]]:
+    """Âges en Jours ouvrés depuis la dernière Entrée, des Anomalies ouvertes de chaque date."""
+    ages: dict[date, list[int]] = {}
+    memo: dict[tuple[date, date], int] = {}
+    for jour, entree, cle in ouvertes.select(
+        "date", "date_derniere_entree", "cle_ticket"
+    ).iter_rows():
+        if entree is None:
+            raise UsineErreur(
+                f"Anomalie {cle} ouverte le {jour.isoformat()} sans date de dernière Entrée"
+            )
+        if entree > jour:
+            raise UsineErreur(
+                f"Anomalie {cle} : dernière Entrée {entree.isoformat()} postérieure"
+                f" au {jour.isoformat()}"
+            )
+        if (entree, jour) not in memo:
+            memo[(entree, jour)] = len(jours_ouvres(entree, jour)) - 1
+        ages.setdefault(jour, []).append(memo[(entree, jour)])
+    return ages
+
+
+def _perimetre(
+    anomalies: pl.DataFrame,
+    tests: pl.DataFrame,
+    certifications: pl.DataFrame,
+    dates: Sequence[date],
+) -> dict[_Cle, _Valeur]:
+    """Valeurs `(numerateur, denominateur)` de chaque (date, code, dimension) d'un périmètre."""
+    ouvertes = anomalies.filter(pl.col("ouvert"))
+    stock = _compter(ouvertes, ["date"])
+    par_gravite = _compter(ouvertes, ["date", "gravite"])
+    par_phase = _compter(ouvertes, ["date", "phase"])
+    entrees = _compter(anomalies, ["date"], "entree")
+    sorties = _compter(anomalies, ["date"], "sortie")
+    ages = _ages(ouvertes)
+    resultats = _compter(
+        tests.filter(pl.col("phase").is_not_null()), ["date", "phase", "statut_test"]
+    )
+    par_certification = _compter(certifications, ["date", "statut_certification"])
+
+    valeurs: dict[_Cle, _Valeur] = {}
+    for jour in dates:
+        fenetre = fenetre_glissante(jour)
+        valeurs[(jour, "anomalies_ouvertes", "")] = (stock.get((jour,), 0), 1)
+        for gravite in Gravite:
+            n = par_gravite.get((jour, gravite.value), 0)
+            valeurs[(jour, "anomalies_ouvertes_gravite", gravite.value)] = (n, 1)
+        for phase in Phase:
+            n = par_phase.get((jour, phase.value), 0)
+            valeurs[(jour, "anomalies_ouvertes_phase", phase.value)] = (n, 1)
+        valeurs[(jour, "entrees_jour", "")] = (entrees.get((jour,), 0), 1)
+        valeurs[(jour, "sorties_jour", "")] = (sorties.get((jour,), 0), 1)
+        valeurs[(jour, "entrees_fenetre", "")] = (sum(entrees.get((d,), 0) for d in fenetre), 1)
+        valeurs[(jour, "sorties_fenetre", "")] = (sum(sorties.get((d,), 0) for d in fenetre), 1)
+        ages_jour = ages.get(jour, [])
+        if ages_jour:
+            mediane = _mediane(ages_jour)
+            valeurs[(jour, "age_median_anomalies_ouvertes", "")] = (
+                mediane.numerator,
+                mediane.denominator,
+            )
+            valeurs[(jour, "age_max_anomalies_ouvertes", "")] = (max(ages_jour), 1)
+        else:
+            valeurs[(jour, "age_median_anomalies_ouvertes", "")] = (0, 0)
+            valeurs[(jour, "age_max_anomalies_ouvertes", "")] = (0, 0)
+        for phase in Phase:
+            ok, ko, non = (
+                resultats.get((jour, phase.value, statut.value), 0)
+                for statut in (StatutTest.ok, StatutTest.ko, StatutTest.non_execute)
+            )
+            valeurs[(jour, "taux_ko_cas_de_test", phase.value)] = (ko, ok + ko)
+            valeurs[(jour, "taux_non_execution_cas_de_test", phase.value)] = (non, ok + ko + non)
+        for statut_certification in StatutCertification:
+            n = par_certification.get((jour, statut_certification.value), 0)
+            valeurs[(jour, "certifications", statut_certification.value)] = (n, 1)
+    return valeurs
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : KPI de chaque Jour ouvré de `tickets_etats`, par Entité puis Programme.
+
+    Lignes denses (zéro explicite) triées par date, périmètre (ordre de `entites`, puis
+    `PROGRAMME`), code et dimension. Le périmètre Programme couvre toutes les lignes de la table,
+    y compris les Entités absentes de `entites`.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date ;
+    à sa première date, la veille est vide (début de l'historique).
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+    if etats.height:
+        dates = sorted(etats.get_column("date").unique().to_list())
+        _verifier_dates(dates)
+        anomalies = _anomalies(etats)
+        tests = etats.filter(pl.col("type_ticket") == TypeTicket.cas_de_test.value)
+        certifications = etats.filter(pl.col("type_ticket") == TypeTicket.certification.value)
+        perimetres = {
+            perimetre: _perimetre(
+                anomalies.filter(pl.col("entite") == perimetre),
+                tests.filter(pl.col("entite") == perimetre),
+                certifications.filter(pl.col("entite") == perimetre),
+                dates,
+            )
+            for perimetre in entites
+        }
+        perimetres[PERIMETRE_PROGRAMME] = _perimetre(anomalies, tests, certifications, dates)
+        for jour in dates:
+            for perimetre, valeurs in perimetres.items():
+                for code in CODES_KPI:
+                    for dimension in DIMENSIONS_KPI[code]:
+                        numerateur, denominateur = valeurs[(jour, code, dimension)]
+                        lignes["date"].append(jour)
+                        lignes["perimetre"].append(perimetre)
+                        lignes["code_kpi"].append(code)
+                        lignes["dimension"].append(dimension)
+                        lignes["numerateur"].append(numerateur)
+                        lignes["denominateur"].append(denominateur)
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
