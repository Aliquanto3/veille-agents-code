+def test_journal_genere(tmp_path: Path) -> None:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    chemin = tmp_path / "journal.jsonl"
+    chemin.write_bytes(serialiser_journal(generer(config, 42, date(2026, 10, 12))))
+    source = SourceJournal(chemin)
+    evenements = list(source.evenements())
+    fin = source.entete.date_injection
+    dates = jours_ouvres(date(2026, 10, 1), fin)
+    etats = tickets_etats(evenements, dates)
+    entites = [e.code for e in config.entites]
+    t = kpi(etats, entites)
+    valider(t, SCHEMA_KPI)
+
+    for perimetre in (*entites, PERIMETRE_PROGRAMME):
+        stock_veille = 0
+        for jour in dates:
+            stock = _val(t, jour, perimetre, "anomalies_ouvertes")[0]
+            entrees = _val(t, jour, perimetre, "entrees_jour")[0]
+            sorties = _val(t, jour, perimetre, "sorties_jour")[0]
+            assert stock - stock_veille == entrees - sorties, (perimetre, jour)
+            stock_veille = stock
+
+    for code in ("anomalies_ouvertes", "entrees_jour", "sorties_jour"):
+        for jour in dates:
+            somme = sum(_val(t, jour, e, code)[0] for e in entites)
+            assert _val(t, jour, PERIMETRE_PROGRAMME, code)[0] == somme
+
+    inst = instantane(etats).filter(
+        (pl.col("type_ticket") == TypeTicket.anomalie.value)
+        & (pl.col("date") == fin)
+        & ~pl.col("statut").cast(pl.Utf8).is_in([s.value for s in STATUTS_FERMES])
+    )
+    assert _val(t, fin, PERIMETRE_PROGRAMME, "anomalies_ouvertes")[0] == inst["nombre"].sum()
