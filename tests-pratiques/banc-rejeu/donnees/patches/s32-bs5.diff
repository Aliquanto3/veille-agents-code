@@ -0,0 +1,236 @@
+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.adaptateurs.journal import SourceJournal
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer, serialiser_journal
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+LUNDI = date(2026, 10, 5)
+MARDI = date(2026, 10, 6)
+MERCREDI = date(2026, 10, 7)
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, debut: date, fin: date, entites: list[str] | None = None) -> pl.DataFrame:
+    etats = tickets_etats(flux.evenements, jours_ouvres(debut, fin))
+    return kpi(etats, ENTITES if entites is None else entites)
+
+
+def _val(
+    table: pl.DataFrame, jour: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    ligne = table.filter(
+        (pl.col("date") == jour)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return (ligne["numerateur"][0], ligne["denominateur"][0])
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5))
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure", statut="fermee")
+    t = _kpi(flux, LUNDI, LUNDI)
+    assert _val(t, LUNDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(t, LUNDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(t, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(t, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(t, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(t, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _val(t, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def _flux_mouvements() -> Flux:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 8), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(7, 10), "en_analyse", "fermee")
+    return flux
+
+
+def test_flux_du_jour() -> None:
+    t = _kpi(_flux_mouvements(), LUNDI, MERCREDI)
+    entrees = [_val(t, d, "ENT-A", "entrees_jour")[0] for d in (LUNDI, MARDI, MERCREDI)]
+    sorties = [_val(t, d, "ENT-A", "sorties_jour")[0] for d in (LUNDI, MARDI, MERCREDI)]
+    assert entrees == [1, 0, 1]
+    assert sorties == [0, 1, 1]
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    for i, jour in enumerate((5, 6, 7, 8, 9, 12, 13), start=1):
+        flux.anomalie(f"DEMO-{i}", _ts(jour))
+    t = _kpi(flux, LUNDI, date(2026, 10, 13))
+    assert _val(t, LUNDI, "ENT-A", "entrees_fenetre") == (1, 1)
+    assert _val(t, date(2026, 10, 9), "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(t, date(2026, 10, 13), "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(t, date(2026, 10, 13), "ENT-A", "sorties_fenetre") == (0, 1)
+
+
+def test_age_median_et_maximum() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    d = MERCREDI
+    t = _kpi(flux, date(2026, 10, 1), d)
+    assert _val(t, d, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(t, d, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")
+    t = _kpi(flux, date(2026, 10, 1), date(2026, 10, 9))
+    assert _val(t, date(2026, 10, 9), "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(t, date(2026, 10, 8), "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+
+
+def test_aucune_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    t = _kpi(flux, LUNDI, LUNDI)
+    assert _val(t, LUNDI, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(t, LUNDI, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+    assert _val(t, LUNDI, "ENT-B", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for i, statut in enumerate(("ok", "ok", "ok", "ko", "non_execute", "non_execute"), start=1):
+        flux.creer(
+            f"DEMO-{i}",
+            TypeTicket.cas_de_test,
+            _ts(5),
+            {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: "recette"},
+        )
+    t = _kpi(flux, LUNDI, LUNDI)
+    assert _val(t, LUNDI, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(t, LUNDI, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(t, LUNDI, PERIMETRE_PROGRAMME, "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(t, LUNDI, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(t, LUNDI, "ENT-B", "taux_non_execution_cas_de_test", "recette") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for i, statut in enumerate(("accordee", "reservee", "reservee"), start=1):
+        flux.creer(
+            f"DEMO-{i}",
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    t = _kpi(flux, LUNDI, LUNDI)
+    assert _val(t, LUNDI, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(t, LUNDI, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(t, LUNDI, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI, MERCREDI])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+def test_entites_invalides() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI])
+    with pytest.raises(UsineErreur, match="ENT-A"):
+        kpi(etats, ["ENT-A", "ENT-A"])
+    with pytest.raises(UsineErreur, match=PERIMETRE_PROGRAMME):
+        kpi(etats, ["ENT-A", PERIMETRE_PROGRAMME])
+
+
+def test_table_vide() -> None:
+    vide = pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes))
+    etats = tickets_etats([], [])
+    resultat = kpi(etats, ENTITES)
+    assert resultat.height == 0
+    assert resultat.schema == vide.schema
+
+
+def test_schema_dense_et_sans_flottant() -> None:
+    t = _kpi(_flux_mouvements(), LUNDI, MERCREDI)
+    valider(t, SCHEMA_KPI)
+    assert not [c for c, type_ in t.schema.items() if type_.is_float()]
+    par_perimetre = sum(len(DIMENSIONS_KPI[code]) for code in CODES_KPI)
+    assert t.height == 3 * 3 * par_perimetre
+    assert t.select("date", "perimetre", "code_kpi", "dimension").is_unique().all()
+
+
+def test_programme_inclut_les_entites_hors_liste() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5), entite="ENT-C")
+    t = _kpi(flux, LUNDI, LUNDI)
+    assert _val(t, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert set(t["perimetre"]) == {"ENT-A", "ENT-B", PERIMETRE_PROGRAMME}
+
+
+def test_determinisme() -> None:
+    flux = _flux_mouvements()
