+import pytest
+
+from tests.doublures.fournisseur_factice import FournisseurFactice
+from tests.unit.ia.espions import (
+    NUMERO_COMPTE,
+    PASSAGE_ID,
+    CacheMemoire,
+    horloge_espion,
+    jeton_compte,
+    meteo_rouge,
+    pseudonymiseur,
+    textes,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import (
+    ReponseClassification,
+    ReponseExplication,
+    StatutControle,
+)
+from usine.contrats.tickets import CauseRacine
+from usine.contrats.versions import version_prompt
+from usine.ia.classification import (
+    PART_PLAFOND_CLASSIFICATION,
+    ContexteClassification,
+    classer,
+    lire_prompt,
+    rendre_prompt,
+)
+from usine.ia.explication import ContexteExplication, expliquer
+from usine.ia.explication import lire_prompt as lire_prompt_explication
+from usine.ia.passerelle import Passerelle
+
+RACINE = Path(__file__).resolve().parents[3]
+TEXTES = textes(
+    {
+        "DEMO-1": ("Virement rejeté", "Le virement échoue."),
+        "DEMO-2": ("Écart de solde", "Le solde diffère."),
+        "DEMO-10": ("Lot en erreur", "Le lot de reprise plante."),
+    }
+)
+
+
+def _reponse(
+    cause: CauseRacine = CauseRacine.parametrage, justification: str = ""
+) -> ReponseClassification:
+    return ReponseClassification(cause_racine=cause, justification=justification)
+
+
+def _contexte(plafond: Decimal | None = None) -> ContexteClassification:
+    return ContexteClassification(
+        passage_id=PASSAGE_ID,
+        version_donnees="d" * 64,
+        version_grille="g" * 12,
+        gabarit=lire_prompt(),
+        plafond_eur=plafond,
+    )
+
+
+def _passerelle(
+    factice: FournisseurFactice, cache: CacheMemoire | None = None, **options: object
+) -> Passerelle:
+    return Passerelle(
+        factice,
+        pseudonymiseur(),
+        cache if cache is not None else CacheMemoire(),
+        horloge_espion([]),
+        **options,  # type: ignore[arg-type]
+    )
+
+
+def test_premier_passage_trois_appels_tries_par_rang() -> None:
+    factice = FournisseurFactice([_reponse(c) for c in list(CauseRacine)[:3]])
+    sorties, traces = classer(_passerelle(factice), TEXTES, date(2026, 10, 9), _contexte())
+    assert len(factice.appels) == 3
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert [s.cause_racine for s in sorties] == list(CauseRacine)[:3]
+    assert all(s.statut_controle is StatutControle.conforme for s in sorties)
+    assert [t.cible for t in traces] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert not any(t.depuis_cache for t in traces)
+
+
+def test_rejeu_autre_date_arrete_sans_appel() -> None:
+    cache = CacheMemoire()
+    premier = FournisseurFactice([_reponse(), _reponse(), _reponse()])
+    sorties, _ = classer(_passerelle(premier, cache), TEXTES, date(2026, 10, 9), _contexte())
+    second = FournisseurFactice()
+    rejeu, traces = classer(_passerelle(second, cache), TEXTES, date(2026, 10, 16), _contexte())
+    assert second.appels == []
+    assert rejeu == sorties
+    assert all(t.depuis_cache for t in traces)
+
+
+def test_incremental_nouvelle_et_modifiee() -> None:
+    cache = CacheMemoire()
+    ancien = textes({"DEMO-1": ("A", "a"), "DEMO-2": ("B", "b")})
+    classer(
+        _passerelle(FournisseurFactice([_reponse(), _reponse()]), cache),
+        ancien,
+        date(2026, 10, 9),
+        _contexte(),
+    )
+    nouveau = textes({"DEMO-1": ("A", "a"), "DEMO-2": ("B", "b modifié"), "DEMO-3": ("C", "c")})
+    factice = FournisseurFactice([_reponse(), _reponse()])
+    sorties, traces = classer(_passerelle(factice, cache), nouveau, date(2026, 10, 16), _contexte())
+    assert len(factice.appels) == 2
+    assert len(sorties) == 3
+    assert [t.depuis_cache for t in traces] == [True, False, False]
+
+
+def test_hors_anomalie_ignore() -> None:
+    table = TEXTES.with_columns(
+        pl.Series("type_ticket", ["cas_de_test", "certification", "anomalie"]).cast(
+            TEXTES.schema["type_ticket"]
+        )
+    )
+    factice = FournisseurFactice([_reponse()])
+    sorties, traces = classer(_passerelle(factice), table, date(2026, 10, 9), _contexte())
+    assert len(factice.appels) == 1
+    assert [s.cle_ticket for s in sorties] == ["DEMO-10"]
+    assert len(traces) == 1
+
+
+def test_aucune_anomalie() -> None:
+    factice = FournisseurFactice()
+    sorties, traces = classer(_passerelle(factice), TEXTES.clear(), date(2026, 10, 9), _contexte())
+    assert (sorties, traces) == ((), ())
+    assert factice.appels == []
+
