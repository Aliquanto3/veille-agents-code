+def test_adaptateurs_jira_sans_cause_racine() -> None:
+    fichiers = [
+        f
+        for motif in ("jira_*", "composite")
+        for dossier in (RACINE / "src/usine/adaptateurs").glob(motif)
+        for f in dossier.rglob("*.py")
+    ]
+    assert fichiers
+    for fichier in fichiers:
+        source = fichier.read_text(encoding="utf-8")
+        for terme in ("SortieClassification", "cause_racine", "classification"):
+            assert terme not in source, f"{terme} dans {fichier.name}"
