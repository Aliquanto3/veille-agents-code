+def test_part_du_plafond_appel_frais_refuse_cache_servi() -> None:
+    cache = CacheMemoire()
+    classer(
+        _passerelle(FournisseurFactice([_reponse()]), cache),
+        TEXTES.head(1),
+        date(2026, 10, 9),
+        _contexte(),
+    )
+    factice = FournisseurFactice([_reponse()])
+    passerelle = _passerelle(
+        factice,
+        cache,
+        tarif=lambda modele, entree, sortie: Decimal(1),
+        plafond_cout_passage_eur=Decimal(10),
+    )
+    contexte = _contexte(Decimal(10) * PART_PLAFOND_CLASSIFICATION)
+    # DEMO-1 en cache ; DEMO-2 coûte 1 €, DEMO-10 est refusé au-delà de 0,5 € de part.
+    sorties, _ = classer(passerelle, TEXTES, date(2026, 10, 16), _contexte(Decimal("0.5")))
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2"]
+    assert len(factice.appels) == 1
+    assert contexte.plafond_eur == Decimal(5)
+
+
+def test_explications_encore_appelees_apres_classification_arretee() -> None:
+    factice = FournisseurFactice([_reponse(), ReponseExplication(texte="DEMO-1 est bloqué.")])
+    passerelle = _passerelle(
+        factice,
+        tarif=lambda modele, entree, sortie: Decimal(1),
+        plafond_cout_passage_eur=Decimal(10),
+    )
+    sorties, _ = classer(passerelle, TEXTES, date(2026, 10, 9), _contexte(Decimal(1)))
+    assert len(sorties) == 1
+    explication, traces = expliquer(
+        passerelle,
+        meteo_rouge(tickets=("DEMO-1",)),
+        TEXTES,
+        ContexteExplication(
+            passage_id=PASSAGE_ID, version_donnees="d" * 64, gabarit=lire_prompt_explication()
+        ),
+    )
+    assert len(factice.appels) == 2
+    assert len(traces) == 1
+    assert explication.statut_controle is StatutControle.conforme
+
