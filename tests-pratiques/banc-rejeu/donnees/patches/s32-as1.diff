+def test_journal_genere_conservation_et_instantane() -> None:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    generation = generer(config, 42, date(2026, 10, 12))
+    jours = jours_ouvres(generation.entete.ancrage_semaines,generation.entete.date_injection)
+    etats = tickets_etats(generation.evenements, jours)
+    entites = [e.code for e in config.entites]
+    table = kpi(etats, entites)
+    for perimetre in (*entites, PERIMETRE_PROGRAMME):
+        stocks = [_val(table, d, perimetre, "anomalies_ouvertes")[0] for d in jours]
+        for precedent, courant, d in zip(stocks, stocks[1:], jours[1:], strict=True):
+            entrees = _val(table, d, perimetre, "entrees_jour")[0]
+            sorties = _val(table, d, perimetre, "sorties_jour")[0]
+            assert courant - precedent == entrees - sorties, (perimetre, d)
+    derniere = jours[-1]
+    ouvertes = (
+        instantane(etats)
+        .filter(
