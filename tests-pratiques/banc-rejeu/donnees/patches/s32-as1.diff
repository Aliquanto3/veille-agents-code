+            & (pl.col("type_ticket") == TypeTicket.anomalie.value)
+            & ~pl.col("statut").cast(pl.Utf8).is_in(["fermee", "rejetee"])
+        )["nombre"]
+        .sum()
+    )
+    assert _val(table, derniere, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (ouvertes, 1)
