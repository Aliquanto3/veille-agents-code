+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+LUNDI = date(2026, 10, 5)
+JOURS = jours_ouvres(LUNDI, date(2026, 10, 16))
+
+
+def _ts(jour: int, heure: int = 10) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, fin: date, debut: date = LUNDI, entites: list[str] | None = None) -> pl.DataFrame:
+    etats = tickets_etats(flux.evenements, jours_ouvres(debut, fin))
+    return kpi(etats, ENTITES if entites is None else entites)
+
+
+def _val(
+    table: pl.DataFrame, jour: date, perimetre: str, code: str, dimension: str = ""
+) -> tuple[int, int]:
+    lignes = table.filter(
+        (pl.col("date") == jour)
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert lignes.height == 1
+    return lignes["numerateur"][0], lignes["denominateur"][0]
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5))
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, LUNDI)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(table, LUNDI, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(table, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes_gravite", "bloquante") == (2, 1)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes_gravite", "majeure") == (0, 1)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes_phase", "tnr") == (0, 1)
+
+
+def _flux_trois_jours() -> Flux:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7), "fermee", "nouvelle")
+    flux.transition("DEMO-1", _ts(7, 15), "nouvelle", "fermee")
+    return flux
+
+
+def test_flux_du_jour() -> None:
+    table = _kpi(_flux_trois_jours(), date(2026, 10, 7))
+    for jour, entrees, sorties in [(5, 1, 0), (6, 0, 1), (7, 1, 1)]:
+        d = date(2026, 10, jour)
+        assert _val(table, d, "ENT-A", "entrees_jour") == (entrees, 1)
+        assert _val(table, d, "ENT-A", "sorties_jour") == (sorties, 1)
+        assert _val(table, d, PERIMETRE_PROGRAMME, "entrees_jour") == (entrees, 1)
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    for i, jour in enumerate(JOURS[:7], start=1):
+        flux.anomalie(f"DEMO-{i}", datetime(jour.year, jour.month, jour.day, 10, tzinfo=UTC))
+    table = _kpi(flux, JOURS[6])
+    # Les 5 premiers jours : la fenêtre déborde avant la table (comptée 0).
+    assert _val(table, JOURS[2], "ENT-A", "entrees_fenetre") == (3, 1)
+    assert _val(table, JOURS[4], "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(table, JOURS[6], "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(table, JOURS[6], "ENT-A", "sorties_fenetre") == (0, 1)
+
+
+def test_fenetre_sorties() -> None:
+    table = _kpi(_flux_trois_jours(), date(2026, 10, 9))
+    assert _val(table, date(2026, 10, 9), "ENT-A", "sorties_fenetre") == (2, 1)
+    assert _val(table, date(2026, 10, 9), "ENT-A", "entrees_fenetre") == (2, 1)
+
+
+def test_age() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    d = date(2026, 10, 7)
+    table = _kpi(flux, d, debut=date(2026, 10, 1))
+    assert _val(table, d, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(table, d, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(table, d, PERIMETRE_PROGRAMME, "age_max_anomalies_ouvertes") == (4, 1)
+
+
+def test_age_apres_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(7), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(12), "fermee", "nouvelle")
+    d = date(2026, 10, 13)
+    table = _kpi(flux, d)
+    assert _val(table, d, "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+    assert _val(table, d, "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+
+
+def test_age_sans_anomalie_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    table = _kpi(flux, LUNDI)
+    assert _val(table, LUNDI, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(table, LUNDI, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["ok", "ok", "ok", "ko", "non_execute", "non_execute"], start=1):
+        flux.creer(
+            f"DEMO-{i}",
+            TypeTicket.cas_de_test,
+            _ts(5),
+            {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: "recette"},
+        )
+    table = _kpi(flux, LUNDI)
+    assert _val(table, LUNDI, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(table, LUNDI, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(table, LUNDI, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(table, LUNDI, "ENT-B", "taux_non_execution_cas_de_test", "recette") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for i, statut in enumerate(["accordee", "reservee", "reservee"], start=1):
+        flux.creer(
+            f"DEMO-{i}",
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    table = _kpi(flux, LUNDI)
+    assert _val(table, LUNDI, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(table, LUNDI, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(table, LUNDI, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [LUNDI, date(2026, 10, 7)])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+@pytest.mark.parametrize(
+    ("entites", "valeur"),
+    [(["ENT-A", "ENT-A"], "ENT-A"), (["ENT-A", PERIMETRE_PROGRAMME], PERIMETRE_PROGRAMME)],
+)
+def test_entites_invalides(entites: list[str], valeur: str) -> None:
+    etats = tickets_etats(Flux().evenements, [LUNDI])
+    with pytest.raises(UsineErreur, match=valeur):
+        kpi(etats, entites)
+
+
+def test_table_vide() -> None:
+    table = kpi(tickets_etats([], []), ENTITES)
+    assert table.is_empty()
+    assert table.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+
+
+def test_sortie_dense_valide_et_sans_flottant() -> None:
+    flux = _flux_trois_jours()
+    fin = date(2026, 10, 9)
+    table = _kpi(flux, fin)
+    valider(table, SCHEMA_KPI)
+    lignes_par_perimetre = sum(len(d) for d in DIMENSIONS_KPI.values())
+    assert set(DIMENSIONS_KPI) == set(CODES_KPI)
+    assert table.height == 5 * 3 * lignes_par_perimetre
+    assert not any(t.is_float() for t in table.schema.values())
+    assert table.get_column("code_kpi").unique().len() == 12
+
+
+def test_programme_somme_des_entites() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.anomalie("DEMO-2", _ts(5), entite="ENT-B")
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-C")
+    flux.transition("DEMO-2", _ts(6), "nouvelle", "fermee")
+    table = _kpi(flux, date(2026, 10, 6))
+    comptes = [c for c in CODES_KPI if c.startswith(("anomalies", "entrees", "sorties"))]
+    for ligne in table.filter(pl.col("code_kpi").is_in(comptes)).filter(
+        pl.col("perimetre") == PERIMETRE_PROGRAMME
+    ).iter_rows(named=True):
+        parties = table.filter(
+            (pl.col("date") == ligne["date"])
+            & (pl.col("code_kpi") == ligne["code_kpi"])
+            & (pl.col("dimension") == ligne["dimension"])
+            & pl.col("perimetre").is_in(ENTITES)
+        )["numerateur"].sum()
+        # ENT-C n'est pas demandée : seul le Programme la compte.
+        assert ligne["numerateur"] - parties in (0, 1)
+    assert _val(table, LUNDI, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (3, 1)
+    assert _val(table, LUNDI, "ENT-A", "anomalies_ouvertes") == (1, 1)
+
