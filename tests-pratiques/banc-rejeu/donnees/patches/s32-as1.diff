+"""KPI quotidiens par Entité et pour le Programme (FR-11, AD-9, AD-10, AD-17).
+
+Fonction pure : les états par ticket (`SCHEMA_TICKET_ETAT`, le détail de l'Instantané) et les
+Entités arrivent en paramètre. Anomalie ouverte, Entrée et Sortie suivent H-17 ; la Fenêtre
+glissante vient de `contrats.calendrier` (H-19). Tout est en entiers : un compte vaut `n/1`,
+un taux ou un âge sans valeur vaut `0/0`.
+"""
+
+from collections import Counter
+from collections.abc import Mapping, Sequence
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jour_ouvre_precedent, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des `code_kpi`, dans l'ordre de sortie (texte libre côté contrat, D10)."""
+
+_PHASES = tuple(p.value for p in Phase)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "anomalies_ouvertes": ("",),
+        "anomalies_ouvertes_gravite": tuple(g.value for g in Gravite),
+        "anomalies_ouvertes_phase": _PHASES,
+        "entrees_jour": ("",),
+        "sorties_jour": ("",),
+        "entrees_fenetre": ("",),
+        "sorties_fenetre": ("",),
+        "age_median_anomalies_ouvertes": ("",),
+        "age_max_anomalies_ouvertes": ("",),
+        "taux_ko_cas_de_test": _PHASES,
+        "taux_non_execution_cas_de_test": _PHASES,
+        "certifications": tuple(s.value for s in StatutCertification),
+    }
+)
+"""Dimensions de chaque code, dans l'ordre de sortie ; `""` quand le KPI n'est pas ventilé."""
+
+_FERMES = [s.value for s in STATUTS_FERMES]
+
+_Cle = tuple[date, str, str, str]
+"""(date, périmètre, code, dimension)."""
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité {PERIMETRE_PROGRAMME} réservée au Programme : valeur refusée dans `entites`"
+        )
+
+
+def _verifier_dates(dates: list[date]) -> None:
+    """Les dates couvrent chaque Jour ouvré de la première à la dernière, sans autre date."""
+    attendues = jours_ouvres(dates[0], dates[-1])
+    presentes = set(dates)
+    for jour in dates:
+        if jour not in attendues:
+            raise UsineErreur(
+                f"KPI : la date {jour.isoformat()} de l'état des tickets n'est pas un Jour ouvré"
+            )
+    manquantes = [jour for jour in attendues if jour not in presentes]
+    if manquantes:
+        raise UsineErreur(
+            f"KPI : date {manquantes[0].isoformat()} absente de l'état des tickets reçu"
+            " (chaque Jour ouvré doit être calculé)"
+        )
+
+
+def _perimetres(entite: str | None, connues: frozenset[str]) -> tuple[str, ...]:
+    if entite is not None and entite in connues:
+        return (entite, PERIMETRE_PROGRAMME)
+    return (PERIMETRE_PROGRAMME,)
+
+
+def _mouvements(anomalies: pl.DataFrame, dates: list[date]) -> pl.DataFrame:
+    """Entrées `e` et Sorties `s` (0, 1 ou 2) de chaque ticket et de chaque date."""
+    veilles = pl.DataFrame(
+        {
+            "date": dates,
+            "veille": [None] + [jour_ouvre_precedent(d) for d in dates[1:]],
+        },
+        schema={"date": pl.Date(), "veille": pl.Date()},
+    )
+    precedent = anomalies.select(
+        "cle_ticket",
+        pl.col("date").alias("veille"),
+        pl.col("ouvert").alias("ouvert_veille"),
+    )
+    return (
+        anomalies.join(veilles, on="date", how="left")
+        .join(precedent, on=["cle_ticket", "veille"], how="left")
+        .with_columns(
+            (pl.col("date_derniere_entree") == pl.col("date")).fill_null(False).cast(pl.Int64).alias("e"),
+            (pl.col("ouvert").cast(pl.Int64) - pl.col("ouvert_veille").fill_null(False).cast(pl.Int64)).alias("delta"),
+        )
+        .with_columns((pl.col("e") - pl.col("delta")).alias("s"))
+    )
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` dense : une ligne par date, périmètre (Entités puis Programme), code et dimension.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date ;
+    à sa première date, la veille est vide (début de l'historique). Le Programme totalise toutes
+    les lignes, y compris celles d'Entités hors de `entites`.
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    if etats.is_empty():
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates: list[date] = sorted(etats.get_column("date").unique().to_list())
+    _verifier_dates(dates)
+    connues = frozenset(entites)
+    perimetres = (*entites, PERIMETRE_PROGRAMME)
+
+    comptes: Counter[_Cle] = Counter()
+    taux: Counter[tuple[date, str, str, str]] = Counter()  # (date, périmètre, phase, statut)
+    ages: dict[tuple[date, str], list[int]] = {}
+
+    anomalies = (
+        etats.filter(pl.col("type_ticket") == TypeTicket.anomalie.value)
+        .with_columns(
+            (
+                pl.col("statut").is_not_null()
+                & ~pl.col("statut").cast(pl.Utf8).is_in(_FERMES).fill_null(False)
+            ).alias("ouvert")
+        )
+        .select(
+            "date", "cle_ticket", "entite", "gravite", "phase", "date_derniere_entree", "ouvert"
+        )
+    )
+    mouvements = _mouvements(anomalies, dates)
+
+    for jour, entite, e, s in (
+        mouvements.group_by("date", "entite").agg(pl.col("e").sum(), pl.col("s").sum()).iter_rows()
+    ):
+        for perimetre in _perimetres(entite, connues):
+            comptes[(jour, perimetre, "entrees_jour", "")] += e
+            comptes[(jour, perimetre, "sorties_jour", "")] += s
+
+    ouvertes = mouvements.filter(pl.col("ouvert"))
+    for jour, entite, gravite, phase, nombre in (
+        ouvertes.group_by("date", "entite", "gravite", "phase")
+        .agg(pl.len())
+        .iter_rows()
+    ):
+        for perimetre in _perimetres(entite, connues):
+            comptes[(jour, perimetre, "anomalies_ouvertes", "")] += nombre
+            if gravite is not None:
+                comptes[(jour, perimetre, "anomalies_ouvertes_gravite", gravite)] += nombre
+            if phase is not None:
+                comptes[(jour, perimetre, "anomalies_ouvertes_phase", phase)] += nombre
+
+    cache_age: dict[tuple[date, date], int] = {}
+    for jour, entite, entree, nombre in (
+        ouvertes.filter(pl.col("date_derniere_entree").is_not_null())
+        .group_by("date", "entite", "date_derniere_entree")
+        .agg(pl.len())
+        .iter_rows()
+    ):
+        age = cache_age.setdefault((entree, jour), len(jours_ouvres(entree, jour)) - 1)
+        for perimetre in _perimetres(entite, connues):
+            ages.setdefault((jour, perimetre), []).extend([age] * nombre)
+
+    cas = etats.filter(
+        (pl.col("type_ticket") == TypeTicket.cas_de_test.value)
+        & pl.col("phase").is_not_null()
+        & pl.col("statut_test").is_not_null()
+    )
+    for jour, entite, phase, statut, nombre in (
+        cas.group_by("date", "entite", pl.col("phase").cast(pl.Utf8), pl.col("statut_test").cast(pl.Utf8))
+        .agg(pl.len())
+        .iter_rows()
+    ):
+        for perimetre in _perimetres(entite, connues):
+            taux[(jour, perimetre, phase, statut)] += nombre
+
+    certifications = etats.filter(
+        (pl.col("type_ticket") == TypeTicket.certification.value)
+        & pl.col("statut_certification").is_not_null()
+    )
+    for jour, entite, statut, nombre in (
+        certifications.group_by("date", "entite", pl.col("statut_certification").cast(pl.Utf8))
+        .agg(pl.len())
+        .iter_rows()
+    ):
+        for perimetre in _perimetres(entite, connues):
+            comptes[(jour, perimetre, "certifications", statut)] += nombre
+
+    lignes: dict[str, list[object]] = {colonne: [] for colonne in SCHEMA_KPI.colonnes}
+
+    def ajouter(jour: date, perimetre: str, code: str, dimension: str, num: int, den: int) -> None:
+        lignes["date"].append(jour)
+        lignes["perimetre"].append(perimetre)
+        lignes["code_kpi"].append(code)
+        lignes["dimension"].append(dimension)
+        lignes["numerateur"].append(num)
+        lignes["denominateur"].append(den)
+
+    for jour in dates:
+        fenetre = fenetre_glissante(jour)
+        for perimetre in perimetres:
+            liste_ages = sorted(ages.get((jour, perimetre), []))
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    num, den = 0, 1
+                    if code in ("entrees_fenetre", "sorties_fenetre"):
+                        jour_code = code.replace("fenetre", "jour")
+                        num = sum(comptes[(d, perimetre, jour_code, "")] for d in fenetre)
+                    elif code == "age_max_anomalies_ouvertes":
+                        num, den = (liste_ages[-1], 1) if liste_ages else (0, 0)
+                    elif code == "age_median_anomalies_ouvertes":
+                        if liste_ages:
+                            milieu = len(liste_ages) // 2
+                            if len(liste_ages) % 2:
+                                mediane = Fraction(liste_ages[milieu])
+                            else:
+                                mediane = Fraction(liste_ages[milieu - 1] + liste_ages[milieu], 2)
+                            num, den = mediane.numerator, mediane.denominator
+                        else:
+                            num, den = 0, 0
+                    elif code.startswith("taux_"):
+                        ok = taux[(jour, perimetre, dimension, StatutTest.ok.value)]
+                        ko = taux[(jour, perimetre, dimension, StatutTest.ko.value)]
+                        non_execute = taux[(jour, perimetre, dimension, StatutTest.non_execute.value)]
+                        den = ok + ko + non_execute
+                        if code == "taux_ko_cas_de_test":
+                            num, den = ko, ok + ko
+                        else:
+                            num = non_execute
+                    else:
+                        num = comptes[(jour, perimetre, code, dimension)]
+                    ajouter(jour, perimetre, code, dimension, num, den)
+
+    table = pl.DataFrame(lignes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
