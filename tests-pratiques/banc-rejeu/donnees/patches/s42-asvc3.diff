@@ -0,0 +1,382 @@
+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Fenêtre de 10 Jours ouvrés finissant le vendredi
+09/10/2026 (D), x = 0..9, x̄ = 9/2, Σ(x − x̄)² = 165/2, projection à x = 9 + h.
+
+- IND-3 = 10..19 : pente 1, ordonnée 10 ; h = 1 → 20 ≥ 20 (lundi 12/10).
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : ȳ = 7/10, Σ(x − x̄)(y − ȳ) = 41/2, pente 41/165, ordonnée
+  −23/55 ; h = 4 → 464/165 < 3 ; h = 5 → 101/33 ≥ 3 (vendredi 16/10).
+- IND-4 = 5/100..14/100 : pente 1/100 ; h = 5 → 19/100 < 1/5.
+"""
+
+import re
+from collections.abc import Sequence
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+
+from usine.config import charger_yaml
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite, Operateur, RegleDeclenchante
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.commun import avancer, declenche
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+PLAT_1 = [0] * 10
+PLAT_3 = [5] * 10
+PLAT_4 = [Fraction(1, 100)] * 10
+IND_3_HAUSSE = list(range(10, 20))
+IND_1_NON_LINEAIRE = [0, 0, 0, 0, 0, 1, 1, 1, 2, 2]
+IND_4_HAUSSE = [Fraction(k, 100) for k in range(5, 15)]
+
+
+def _grille(**changements: dict[str, Any]) -> GrilleMeteo:
+    donnees = charger_yaml(RACINE / "config" / "grille_meteo.yaml", GrilleMeteo).model_dump()
+    donnees["indicateurs"] = {c.value: r for c, r in donnees["indicateurs"].items()}
+    for code, regle in changements.items():
+        donnees["indicateurs"][code].update(regle)
+    return GrilleMeteo.model_validate(donnees)
+
+
+GRILLE = charger_yaml(RACINE / "config" / "grille_meteo.yaml", GrilleMeteo)
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=(
+            RegleDeclenchante(
+                code=CodeIndicateur.ind_5,
+                couleur=couleur,
+                operateur=Operateur.superieur_ou_egal,
+                numerateur=1,
+                denominateur=1,
+                seuil_numerateur=1,
+                seuil_denominateur=1,
+                tickets_en_cause=(),
+            ),
+        ),
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _lignes(
+    code: CodeIndicateur,
+    valeurs: Sequence[Fraction | int | None],
+    motifs: dict[int, str] | None = None,
+    entite: str = ENTITE,
+    fin: date = D,
+) -> list[dict[str, Any]]:
+    dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+    lignes: list[dict[str, Any]] = []
+    for i, (jour, valeur) in enumerate(zip(dates, valeurs, strict=True)):
+        non_evaluable = valeur is None
+        fraction = Fraction(0) if valeur is None else Fraction(valeur)
+        lignes.append(
+            {
+                "date": jour,
+                "entite": entite,
+                "code": code.value,
+                "statut": "non_evaluable" if non_evaluable else "evalue",
+                "motif": (motifs or {}).get(i, "m") if non_evaluable else "",
+                "numerateur": 0 if non_evaluable else fraction.numerator,
+                "denominateur": 0 if non_evaluable else fraction.denominator,
+                "couleur": "vert",
+            }
+        )
+    return lignes
+
+
+def _table(*groupes: list[dict[str, Any]]) -> pl.DataFrame:
+    lignes = [ligne for groupe in groupes for ligne in groupe]
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _table_plate(**series: Any) -> pl.DataFrame:
+    """Séries plates par défaut, remplacées par `ind_1`, `ind_3`, `ind_4`."""
+    return _table(
+        _lignes(IND_1, series.get("ind_1", PLAT_1)),
+        _lignes(IND_3, series.get("ind_3", PLAT_3)),
+        _lignes(IND_4, series.get("ind_4", PLAT_4)),
+    )
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = risques_entree_rouge(_table_plate(ind_3=IND_3_HAUSSE), _meteo(), GRILLE)
+
+    assert resultat.exclus == ()
+    (projete,) = resultat.risques
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.indicateur is IND_3
+    assert r.date_franchissement_estimee == avancer(D, 1) == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert (r.date_arrete, r.entite) == (D, ENTITE)
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = risques_entree_rouge(_table_plate(ind_1=IND_1_NON_LINEAIRE), _meteo(), GRILLE)
+
+    (projete,) = resultat.risques
+    assert projete.risque.indicateur is IND_1
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == avancer(D, 5) == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+    # Sans la 5e projection (horizon 4), 464/165 < 3 : pas de risque.
+    court = risques_entree_rouge(
+        _table_plate(ind_1=IND_1_NON_LINEAIRE), _meteo(), GRILLE, ParametresRisque(horizon=4)
+    )
+    assert court.risques == ()
+
+
+def test_franchissement_ind_4() -> None:
+    ind_4 = [Fraction(2 * k, 100) for k in range(10)]  # pente 2/100, 18/100 = 9/50 à D
+
+    resultat = risques_entree_rouge(_table_plate(ind_4=ind_4), _meteo(), GRILLE)
+
+    (projete,) = resultat.risques
+    assert projete.risque.indicateur is IND_4
+    assert projete.valeur_projetee == Fraction(1, 5)  # h = 1 : 20/100 ≥ 1/5
+    assert projete.risque.date_franchissement_estimee == avancer(D, 1)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (9, 50)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (1, 5)
+
+
+def test_valeur_courante_non_reduite_reprise_telle_quelle() -> None:
+    lignes = _lignes(IND_4, [Fraction(2 * k, 100) for k in range(10)])
+    lignes[-1]["numerateur"], lignes[-1]["denominateur"] = 18, 100
+    table = _table(_lignes(IND_1, PLAT_1), _lignes(IND_3, PLAT_3), lignes)
+
+    (projete,) = risques_entree_rouge(table, _meteo(), GRILLE).risques
+
