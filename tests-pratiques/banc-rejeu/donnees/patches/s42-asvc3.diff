@@ -0,0 +1,217 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Pour une
+Entité non rouge à la Date d'arrêté D, elle projette par régression linéaire (moindres carrés)
+les séries d'IND-1, IND-3 et IND-4 des `fenetre` derniers Jours ouvrés finissant à D, de 1 à
+`horizon` Jours ouvrés après D. Un `RisqueEntreeRouge` est émis, avec la valeur projetée, pour
+chaque indicateur dont une projection déclenche la règle rouge de la Grille (premier horizon
+concerné). Les indicateurs écartés (sans règle rouge active, non évaluables sur la fenêtre,
+historique insuffisant) sont restitués avec leur motif.
+
+La valeur courante portée par le contrat est celle de la ligne de D, `numerateur` et
+`denominateur` repris tels quels de la table (non réduits, comme dans `RegleDeclenchante`).
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+PROJETABLES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque : paramètre {nom} invalide {valeur!r} (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée à la date de franchissement estimée."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+@dataclass(frozen=True)
+class _Point:
+    date: date
+    evalue: bool
+    motif: str
+    valeur: Fraction
+    numerateur: int
+    denominateur: int
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D sont
+    lues. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la table est
+    invalide pour un indicateur actif.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+    lignes = (
+        table.filter((pl.col("entite") == entite) & (pl.col("date") <= meteo.date_arrete))
+        .sort("date")
+        .to_dicts()
+    )
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in CodeIndicateur:
+        if code not in PROJETABLES:
+            continue
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, "indicateur inactif dans la Grille"))
+            continue
+        if Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, "sans seuil rouge dans la Grille"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+        points = _points([ligne for ligne in lignes if ligne["code"] == code.value], code, meteo)[
+            -parametres.fenetre :
+        ]
+        non_evaluable = next((p for p in points if not p.evalue), None)
+        if non_evaluable is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"non évaluable le {non_evaluable.date.isoformat()} : {non_evaluable.motif}",
+                )
+            )
+            continue
+        if len(points) < 2:
+            exclus.append(IndicateurExclu(code, "historique insuffisant"))
+            continue
+        ordonnee, pente = _regression([p.valeur for p in points])
+        for h in range(1, parametres.horizon + 1):
+            projetee = ordonnee + pente * (len(points) - 1 + h)
+            if declenche(projetee, operateur, seuil):
+                courante = points[-1]
+                risques.append(
+                    RisqueProjete(
+                        risque=RisqueEntreeRouge(
+                            date_arrete=meteo.date_arrete,
+                            entite=entite,
+                            indicateur=code,
+                            date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                            horizon_jours_ouvres=parametres.horizon,
+                            numerateur=courante.numerateur,
+                            denominateur=courante.denominateur,
+                            seuil_numerateur=seuil.numerator,
+                            seuil_denominateur=seuil.denominator,
+                            version_grille=meteo.version_grille,
+                        ),
+                        valeur_projetee=projetee,
+                    )
+                )
+                break
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _points(
+    lignes: list[dict[str, object]], code: CodeIndicateur, meteo: MeteoEntite
+) -> list[_Point]:
+    """Points de l'indicateur `code` jusqu'à D, contrôlés et dans l'ordre (`lignes` triées)."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    points: list[_Point] = []
+    for ligne in lignes:
+        jour = ligne["date"]
+        assert isinstance(jour, date)
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} : {code} {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if points and points[-1].date == jour:
+            raise UsineErreur(f"Risque {entite} : {code} date {jour.isoformat()} en double")
+        if points and jour_ouvre_suivant(points[-1].date) != jour:
+            raise UsineErreur(
+                f"Risque {entite} : {code} trou de Jours ouvrés entre"
+                f" {points[-1].date.isoformat()} et {jour.isoformat()}"
+            )
+        evalue = ligne["statut"] == StatutIndicateur.evalue.value
+        numerateur, denominateur = ligne["numerateur"], ligne["denominateur"]
+        assert isinstance(numerateur, int) and isinstance(denominateur, int)
+        if evalue and denominateur <= 0:
+            raise UsineErreur(
+                f"Risque {entite} : {code} {jour.isoformat()} évalué avec le dénominateur"
+                f" {denominateur}"
+            )
+        motif = ligne["motif"]
+        assert isinstance(motif, str)
+        points.append(
+            _Point(
+                jour,
+                evalue,
+                motif,
+                Fraction(numerateur, denominateur) if evalue else Fraction(0),
+                numerateur,
+                denominateur,
+            )
+        )
+    if not points or points[-1].date != arrete:
+        raise UsineErreur(
+            f"Risque {entite} : {code} absent à la Date d'arrêté {arrete.isoformat()}"
+        )
+    return points
+
+
+def _regression(valeurs: list[Fraction]) -> tuple[Fraction, Fraction]:
+    """Droite des moindres carrés y = a + b·x pour x = 0..n−1 (n ≥ 2) : renvoie (a, b)."""
+    n = len(valeurs)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(valeurs, Fraction(0)) / n
+    zero = Fraction(0)
+    covariance = sum(((x - x_moyen) * (y - y_moyen) for x, y in enumerate(valeurs)), zero)
+    variance = sum(((x - x_moyen) * (x - x_moyen) for x in range(n)), zero)
+    pente = covariance / variance
+    return y_moyen - pente * x_moyen, pente
