+    elif cas == "denominateur_zero":
+        ind_3[2]["denominateur"] = 0
+    table = _table(_lignes(IND_1, PLAT_1), ind_3, _lignes(IND_4, PLAT_4))
+
+    with pytest.raises(UsineErreur, match=ENTITE):
+        risques_entree_rouge(table, meteo, GRILLE)
