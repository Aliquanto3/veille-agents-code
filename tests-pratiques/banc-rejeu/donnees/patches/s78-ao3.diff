+def test_date_sans_passage_sur_un_passage_reel() -> None:
+    cas = passage_palier_2()
+    hors_passage = date(2020, 1, 6)
+    assert hors_passage not in cas.consultation.dates_disponibles()
+
+    resultat = OutilsConsultation(cas.consultation).get_meteo(
+        ArgumentsGetMeteo(date_arrete=hors_passage)
+    )
+
+    assert resultat == AucuneDonnee(date_arrete=hors_passage)
