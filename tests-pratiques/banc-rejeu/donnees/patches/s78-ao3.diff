+def test_filtre_statut_sur_un_passage_palier_2() -> None:
+    cas = passage_palier_2()
+    toutes = cas.consultation.anomalies(limite=None)
+    statut = toutes.anomalies[0].statut
+    attendues = tuple(a for a in toutes.anomalies if a.statut == statut)
+
+    resultat = OutilsConsultation(cas.consultation).list_anomalies(
+        ArgumentsListAnomalies(statut=statut, limite=1)
+    )
+
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert resultat.anomalies == attendues[:1]
+    assert resultat.total == len(attendues)
+
