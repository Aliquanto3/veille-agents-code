@@ -0,0 +1,370 @@
+"""Outils de consultation de l'Agent (Story 7.8) : noms, lecture seule, Date d'arrêté."""
+
+import re
+from datetime import date
+from types import SimpleNamespace
+from typing import Any, cast
+
+import grimp
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+from tests.contrat.consultation.fabriques import passage_palier_2
+from tests.unit.ia.espions import DATE_ARRETE, meteo_rouge, prevision_rouge, risque_entree_rouge
+from usine.contrats import agent
+from usine.contrats.agent import (
+    AnomalieResume,
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.calcul import SCHEMA_TENDANCE
+from usine.contrats.meteo import Couleur, EvolutionMeteo
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+from usine.ports import Consultation
+
+VEILLE = date(2026, 10, 8)
+SANS_PASSAGE = date(2026, 9, 1)
+
+
+def _anomalie(numero: int, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=f"DEMO-{numero}",
+        entite="ENT-A",
+        gravite=Gravite.majeure,
+        phase=Phase.recette,
+        domaine="paie",
+        statut=statut,
+        age_jours_ouvres=numero,
+    )
+
+
+ANOMALIES = (
+    _anomalie(1, StatutAnomalie.nouvelle),
+    _anomalie(2, StatutAnomalie.en_analyse),
+    _anomalie(3, StatutAnomalie.en_analyse),
+    _anomalie(4, StatutAnomalie.a_retester),
+    _anomalie(5, StatutAnomalie.en_analyse),
+)
+
+
+class ConsultationFactice:
+    """Consultation d'un Passage du 2026-10-08 au 2026-10-09 (Palier 1), qui note ses appels."""
+
+    def __init__(self, dates: tuple[date, ...] = (VEILLE, DATE_ARRETE)) -> None:
+        self.dates = dates
+        self.appels: list[tuple[str, dict[str, Any]]] = []
+
+    def manifeste(self) -> Any:
+        return SimpleNamespace(date_arrete=DATE_ARRETE, palier=1)
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self.dates
+
+    def meteo(self, date_arrete: date | None = None, entite: str | None = None) -> Any:
+        self.appels.append(("meteo", {"date_arrete": date_arrete, "entite": entite}))
+        return (meteo_rouge(),)
+
+    def evolution_meteo(self, date_arrete: date | None = None) -> Any:
+        return tuple(
+            EvolutionMeteo(
+                entite=entite,
+                date_arrete=DATE_ARRETE,
+                couleur=Couleur.rouge,
+                date_j1=VEILLE,
+                couleur_j1=Couleur.orange,
+                date_j5=date(2026, 10, 2),
+                couleur_j5=None,
+            )
+            for entite in ("ENT-A", "ENT-B")
+        )
+
+    def anomalies(self, date_arrete: date | None = None, **filtres: Any) -> ResultatListAnomalies:
+        self.appels.append(("anomalies", {"date_arrete": date_arrete, **filtres}))
+        limite = filtres.get("limite")
+        return ResultatListAnomalies(
+            date_arrete=date_arrete or DATE_ARRETE,
+            anomalies=ANOMALIES[:limite],
+            total=len(ANOMALIES),
+        )
+
+    def tendances(self, entite: str | None = None, code_kpi: str | None = None) -> pl.DataFrame:
+        self.appels.append(("tendances", {"entite": entite, "code_kpi": code_kpi}))
+        return pl.DataFrame(
+            {
+                "date": [DATE_ARRETE],
+                "perimetre": ["ENT-A"],
+                "code_kpi": ["KPI-1"],
+                "dimension": [""],
+                "numerateur": [3],
+                "denominateur": [4],
+            },
+            schema=dict(SCHEMA_TENDANCE.colonnes),
+        )
+
+    def previsions(self, date_arrete: date | None = None, entite: str | None = None) -> Any:
+        self.appels.append(("previsions", {"date_arrete": date_arrete, "entite": entite}))
+        return (prevision_rouge(),)
+
+    def risques(self, date_arrete: date | None = None, entite: str | None = None) -> Any:
+        self.appels.append(("risques", {"date_arrete": date_arrete, "entite": entite}))
+        return (risque_entree_rouge(),)
+
+
+def _outils(factice: ConsultationFactice) -> OutilsConsultation:
+    return OutilsConsultation(cast(Consultation, factice))
+
+
+# --- Inventaire ---
+
+
+def test_noms_exacts_et_classes_de_contrats_agent() -> None:
+    definitions = outils_consultation(cast(Consultation, ConsultationFactice()))
+
+    assert tuple(d.nom for d in definitions) == NOMS_OUTILS
+    assert set(NOMS_OUTILS) == {
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    }
+    for definition in definitions:
+        assert definition.arguments.__module__ == agent.__name__
+        assert definition.description
+        resultat = definition.executer({})
+        assert type(resultat).__module__ == agent.__name__
+
+
+def test_methodes_publiques_sont_les_outils() -> None:
+    publiques = {nom for nom in vars(OutilsConsultation) if not nom.startswith("_")}
+
+    assert publiques == set(NOMS_OUTILS)
+
+
+# --- Lecture seule (AD-5) ---
+
+_VERBES_ECRITURE = re.compile(
+    r"(^|_)(set|create|update|delete|write|send|post|put|patch|ecrire|creer|modifier|supprimer"
+    r"|envoyer|publier|commenter|transitionner)(_|$)"
+)
+
+
+def test_aucun_outil_n_ecrit() -> None:
+    assert [nom for nom in NOMS_OUTILS if _VERBES_ECRITURE.search(nom)] == []
+    assert all(nom.split("_")[0] in {"get", "list"} for nom in NOMS_OUTILS)
+
+
+def test_ia_agent_n_importe_ni_jira_ni_port_d_ecriture() -> None:
+    graphe = grimp.build_graph("usine", include_external_packages=True, cache_dir=None)
+    modules = {
+        m
+        for m in graphe.find_descendants("usine.ia.agent") | {"usine.ia.agent"}
+        if m != "usine.ia.agent.cli"
+    }
+    autorises = ("usine.contrats", "usine.ports.consultation", "usine.consultation")
+    importes = {
+        cible
+        for module in modules
+        for cible in graphe.find_modules_directly_imported_by(module)
+        if cible.startswith("usine.")
+    }
+
+    assert importes, "graphe vide : modules de usine.ia.agent introuvables"
+    assert sorted(m for m in importes if not m.startswith(autorises)) == []
+    externes = {
+        cible
+        for module in modules
+        for cible in graphe.find_modules_directly_imported_by(module)
+        if not cible.startswith("usine")
+    }
+    assert externes & {"pydantic_ai", "httpx", "anthropic", "mistralai"} == set()
+
+
+# --- Date d'arrêté ---
+
+
+def test_date_absente_rend_la_date_du_manifeste() -> None:
+    factice = ConsultationFactice()
+    outils = _outils(factice)
+
+    meteo = outils.get_meteo(ArgumentsGetMeteo())
+    previsions = outils.get_prevision(ArgumentsGetPrevision(entite="ENT-A"))
+    risques = outils.get_risques(ArgumentsGetRisques())
+
+    assert isinstance(meteo, ResultatGetMeteo)
+    assert meteo.date_arrete == DATE_ARRETE
+    assert meteo.meteos == (meteo_rouge(),)
+    assert isinstance(previsions, ResultatGetPrevision)
+    assert previsions.previsions == (prevision_rouge(),)
+    assert isinstance(risques, ResultatGetRisques)
+    assert risques.risques == (risque_entree_rouge(),)
+    assert ("previsions", {"date_arrete": DATE_ARRETE, "entite": "ENT-A"}) in factice.appels
+
+
+def test_date_disponible_est_transmise() -> None:
+    factice = ConsultationFactice()
+
+    resultat = _outils(factice).get_risques(ArgumentsGetRisques(date_arrete=VEILLE))
+
+    assert isinstance(resultat, ResultatGetRisques)
+    assert resultat.date_arrete == VEILLE
+    assert factice.appels == [("risques", {"date_arrete": VEILLE, "entite": None})]
+
+
+def test_meteo_filtre_l_evolution_par_entite() -> None:
+    resultat = _outils(ConsultationFactice()).get_meteo(ArgumentsGetMeteo(entite="ENT-B"))
+
+    assert isinstance(resultat, ResultatGetMeteo)
+    assert [e.entite for e in resultat.evolutions] == ["ENT-B"]
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_date_sans_passage_rend_aucune_donnee(nom: str) -> None:
+    factice = ConsultationFactice()
+    definition = next(d for d in outils_consultation(cast(Consultation, factice)) if d.nom == nom)
+
+    resultat = definition.executer({"date_arrete": SANS_PASSAGE.isoformat()})
+
+    assert resultat == AucuneDonnee(date_arrete=SANS_PASSAGE)
+    assert isinstance(resultat, AucuneDonnee)
+    assert resultat.message == "aucune donnée pour cette date"
+    assert factice.appels == []
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_passage_sans_date_rend_aucune_donnee(nom: str) -> None:
+    definitions = outils_consultation(cast(Consultation, ConsultationFactice(dates=())))
+    definition = next(d for d in definitions if d.nom == nom)
+
+    assert definition.executer({}) == AucuneDonnee(date_arrete=None)
+
+
+def test_tendance_sans_date_ne_rend_jamais_aucune_donnee() -> None:
+    factice = ConsultationFactice(dates=())
+
+    resultat = _outils(factice).get_tendance(ArgumentsGetTendance(entite="ENT-A", code_kpi="K"))
+
+    assert isinstance(resultat, ResultatGetTendance)
+    assert [(p.perimetre, p.numerateur, p.denominateur) for p in resultat.points] == [
+        ("ENT-A", 3, 4)
+    ]
+    assert factice.appels == [("tendances", {"entite": "ENT-A", "code_kpi": "K"})]
+
+
+# --- list_anomalies ---
+
+
+def test_anomalies_transmet_filtres_limite_et_palier_du_manifeste() -> None:
+    factice = ConsultationFactice()
+
+    resultat = _outils(factice).list_anomalies(
+        ArgumentsListAnomalies(
+            entite="ENT-A", gravite=Gravite.majeure, phase=Phase.recette, domaine="paie", limite=2
+        )
+    )
+
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert len(resultat.anomalies) == 2
+    assert resultat.total == 5
+    assert factice.appels == [
+        (
+            "anomalies",
+            {
+                "date_arrete": DATE_ARRETE,
+                "entite": "ENT-A",
+                "gravite": Gravite.majeure,
+                "phase": Phase.recette,
+                "domaine": "paie",
+                "limite": 2,
+                "palier": 1,
+            },
+        )
+    ]
+
+
+def test_filtre_statut_compte_avant_la_limite() -> None:
+    factice = ConsultationFactice()
+
+    resultat = _outils(factice).list_anomalies(
+        ArgumentsListAnomalies(statut=StatutAnomalie.en_analyse, limite=2)
+    )
+
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert [a.cle_ticket for a in resultat.anomalies] == ["DEMO-2", "DEMO-3"]
+    assert resultat.total == 3
+    assert factice.appels[0][1]["limite"] is None
+
+
+def test_arguments_json_invalides_levent_validation_error() -> None:
+    definition = outils_consultation(cast(Consultation, ConsultationFactice()))[1]
+
+    with pytest.raises(ValidationError):
+        definition.executer({"limite": 0})
+    with pytest.raises(ValidationError):
+        definition.executer({"statut": "inconnu"})
+
+
+# --- Intégration sur un Passage Palier 2 réel ---
+
+
+def test_outils_sur_un_passage_palier_2() -> None:
+    cas = passage_palier_2()
+    jour = cas.consultation.manifeste().date_arrete
+    resultats = {d.nom: d.executer({}) for d in outils_consultation(cas.consultation)}
+
+    meteo = resultats["get_meteo"]
+    assert isinstance(meteo, ResultatGetMeteo)
+    assert meteo.date_arrete == jour
+    assert meteo.meteos == cas.consultation.meteo(jour)
+    anomalies = resultats["list_anomalies"]
+    assert isinstance(anomalies, ResultatListAnomalies)
+    assert anomalies == cas.consultation.anomalies(jour, limite=50)
+    tendance = resultats["get_tendance"]
+    assert isinstance(tendance, ResultatGetTendance)
+    assert len(tendance.points) == cas.consultation.tendances().height
+    previsions = resultats["get_prevision"]
+    assert isinstance(previsions, ResultatGetPrevision)
+    assert previsions.previsions
+    assert previsions.previsions == cas.consultation.previsions(jour)
+    risques = resultats["get_risques"]
+    assert isinstance(risques, ResultatGetRisques)
+    assert risques.risques
+    assert risques.risques == cas.consultation.risques(jour)
