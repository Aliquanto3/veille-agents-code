+"""Outils de consultation de l'Agent : lecture seule, dates, filtres (Story 7.8)."""
+
+import ast
+from datetime import date
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+import usine.ia.agent as paquet_agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.contrats import agent as contrats_agent
+from usine.contrats.agent import (
+    AnomalieResume,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+
+JOUR = date(2026, 10, 9)
+AUTRE_JOUR = date(2026, 10, 8)
+
+
+def _anomalie(cle: str, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=cle,
+        entite="ENT-A",
+        gravite=Gravite.bloquante,
+        phase=Phase.recette,
+        domaine="D1",
+        statut=statut,
+        age_jours_ouvres=3,
+    )
+
+
+class ConsultationFactice:
+    """Seules les lectures utilisées par les outils ; compte les appels à `anomalies`."""
+
+    def __init__(self, dates: tuple[date, ...] = (JOUR,)) -> None:
+        self._dates = dates
+        self.appels: list[dict[str, Any]] = []
+        self._toutes = (
+            _anomalie("A-1", StatutAnomalie.en_analyse),
+            _anomalie("A-2", StatutAnomalie.nouvelle),
+            _anomalie("A-3", StatutAnomalie.en_analyse),
+            _anomalie("A-4", StatutAnomalie.en_analyse),
+        )
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self._dates
+
+    def manifeste(self) -> Any:
+        class _Manifeste:
+            date_arrete = JOUR
+
+        return _Manifeste()
+
+    def meteo(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        return ()
+
+    def evolution_meteo(self, date_arrete: date | None = None) -> tuple[()]:
+        return ()
+
+    def previsions(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        return ()
+
+    def risques(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        return ()
+
+    def tendances(self, entite: str | None = None, code_kpi: str | None = None) -> pl.DataFrame:
+        return pl.DataFrame(
+            {
+                "date": [],
+                "perimetre": [],
+                "code_kpi": [],
+                "dimension": [],
+                "numerateur": [],
+                "denominateur": [],
+            }
+        )
+
+    def anomalies(
+        self,
+        date_arrete: date | None = None,
+        entite: str | None = None,
+        gravite: Gravite | None = None,
+        phase: Phase | None = None,
+        domaine: str | None = None,
+        limite: int | None = None,
+        palier: int = 2,
+    ) -> ResultatListAnomalies:
+        self.appels.append({"date_arrete": date_arrete, "limite": limite})
+        lues = self._toutes if limite is None else self._toutes[:limite]
+        return ResultatListAnomalies(
+            date_arrete=date_arrete or JOUR, anomalies=lues, total=len(self._toutes)
+        )
+
+
+def _outils(consultation: Any) -> dict[str, Any]:
+    return {o.nom: o for o in outils_consultation(consultation)}
+
+
+def test_noms_exacts_et_contrats() -> None:
+    definitions = outils_consultation(ConsultationFactice())  # type: ignore[arg-type]
+    assert tuple(d.nom for d in definitions) == NOMS_OUTILS
+    assert set(NOMS_OUTILS) == {
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    }
+    for d in definitions:
+        assert d.arguments.__module__ == contrats_agent.__name__
+        assert d.description
+
+
+def test_methodes_publiques_sont_les_cinq_outils() -> None:
+    publiques = {n for n in vars(OutilsConsultation) if not n.startswith("_")}
+    assert publiques == set(NOMS_OUTILS)
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_date_sans_passage(nom: str) -> None:
+    outil = _outils(ConsultationFactice())[nom]
+    resultat = outil.executer({"date_arrete": AUTRE_JOUR.isoformat()})
+    assert resultat == AucuneDonnee(date_arrete=AUTRE_JOUR)
+    assert resultat.message == "aucune donnée pour cette date"
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_aucune_date_disponible(nom: str) -> None:
+    outil = _outils(ConsultationFactice(dates=()))[nom]
+    assert outil.executer({}) == AucuneDonnee(date_arrete=None)
+
+
+def test_date_absente_prend_celle_du_manifeste() -> None:
+    outils = _outils(ConsultationFactice())
+    assert isinstance(outils["get_meteo"].executer({}), ResultatGetMeteo)
+    assert outils["get_prevision"].executer({}).date_arrete == JOUR
+    assert outils["get_risques"].executer({}).date_arrete == JOUR
+
+
+def test_tendance_vide_sans_aucune_donnee() -> None:
+    assert _outils(ConsultationFactice())["get_tendance"].executer({}) == ResultatGetTendance(
+        points=()
+    )
+
+
+def test_filtre_statut_et_limite() -> None:
+    consultation = ConsultationFactice()
+    resultat = _outils(consultation)["list_anomalies"].executer(
+        {"statut": "en_analyse", "limite": 2}
+    )
+    assert [a.cle_ticket for a in resultat.anomalies] == ["A-1", "A-3"]
+    assert resultat.total == 3
+    assert consultation.appels[-1]["limite"] is None
+
+
+def test_sans_statut_la_limite_est_deleguee() -> None:
+    consultation = ConsultationFactice()
+    resultat = _outils(consultation)["list_anomalies"].executer({"limite": 2})
+    assert len(resultat.anomalies) == 2
+    assert resultat.total == 4
+    assert consultation.appels[-1]["limite"] == 2
+
+
+def test_arguments_invalides() -> None:
+    outil = _outils(ConsultationFactice())["list_anomalies"]
+    with pytest.raises(ValidationError):
+        outil.executer({"limite": 0})
+    with pytest.raises(ValidationError):
+        outil.executer({"statut": "inconnu"})
+    assert ArgumentsListAnomalies.model_fields["statut"] is not None
+
+
+def test_lecture_seule() -> None:
+    interdits = ("write", "update", "create", "delete", "send", "post", "set", "save", "ecrire")
+    for nom in NOMS_OUTILS:
+        assert nom.startswith(("get_", "list_"))
+        assert not any(v in nom for v in interdits)
+    publiques = [n for n in dir(OutilsConsultation) if not n.startswith("_")]
+    assert not any(n.startswith(interdits) for n in publiques)
+
+    importes: set[str] = set()
+    for fichier in Path(paquet_agent.__file__).parent.glob("*.py"):
+        if fichier.name == "cli.py":
+            continue
+        for noeud in ast.walk(ast.parse(fichier.read_text(encoding="utf-8"))):
+            if isinstance(noeud, ast.ImportFrom) and noeud.module:
+                importes.add(noeud.module)
+            elif isinstance(noeud, ast.Import):
+                importes.update(a.name for a in noeud.names)
+    assert importes
+    for module in importes:
+        assert not module.startswith(("usine.adaptateurs", "pydantic_ai", "httpx"))
+        assert module not in {
+            "usine.ports.source_tickets",
+            "usine.ports.entrepot",
+            "usine.ports.etape",
+            "usine.ports.fournisseur_llm",
+            "usine.ports.cache_llm",
+        }
+
+
+def test_integration_passage_palier_2() -> None:
+    cas = passage_palier_2()
+    outils = _outils(cas.consultation)
+    jour = cas.consultation.dates_disponibles()[-1]
+    entite = cas.entite
+
+    meteo = outils["get_meteo"].executer({"date_arrete": jour.isoformat(), "entite": entite})
+    assert isinstance(meteo, ResultatGetMeteo)
+    assert meteo.meteos
+    assert all(m.entite == entite for m in meteo.meteos)
+    assert all(e.entite == entite for e in meteo.evolutions)
+
+    assert isinstance(outils["get_prevision"].executer({"entite": entite}), ResultatGetPrevision)
+    assert outils["get_prevision"].executer({"entite": entite}).previsions
+    assert isinstance(outils["get_risques"].executer({}), ResultatGetRisques)
+    assert outils["get_risques"].executer({}).risques
+
+    tendance = outils["get_tendance"].executer({})
+    assert isinstance(tendance, ResultatGetTendance)
+
+    toutes = outils["list_anomalies"].executer({})
+    assert isinstance(toutes, ResultatListAnomalies)
+    if toutes.anomalies:
+        statut = toutes.anomalies[0].statut
+        filtrees = outils["list_anomalies"].executer({"statut": statut.value})
+        assert filtrees.total == sum(a.statut == statut for a in toutes.anomalies) or (
+            filtrees.total <= toutes.total
+        )
+        assert all(a.statut == statut for a in filtrees.anomalies)
+
+    hors = date(2000, 1, 3).isoformat()
+    assert outils["get_meteo"].executer({"date_arrete": hors}) == AucuneDonnee(
+        date_arrete=date(2000, 1, 3)
+    )
