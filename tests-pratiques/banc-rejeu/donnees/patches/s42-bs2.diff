+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main. Série de x = 0..9 (10 Jours ouvrés finissant à D) ;
+régression par moindres carrés, projection à x = 9 + h.
+
+- IND-3 = 10..19 : pente 1, projection h = 1 → 20 ≥ 20.
+- IND-1 = 0,0,0,0,0,1,1,1,2,2 : Σy = 7, ȳ = 7/10, x̄ = 9/2, Σ(x − x̄)² = 165/2,
+  Σ(x − x̄)(y − ȳ) = Σx·y − n·x̄·ȳ = 5+6+7+16+18 − 63/2·… = 52 − 63/2·1 = 41/2 → pente 41/165,
+  ordonnée 7/10 − 41/165·9/2 = −23/55 ; p(4) = −23/55 + 41/165·13 = 464/165 < 3,
+  p(5) = −23/55 + 41/165·14 = 101/33 ≥ 3.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5.
+"""
+
+from dataclasses import FrozenInstanceError
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import jour_ouvre_suivant, jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import (
+    CodeIndicateur,
+    Couleur,
+    MeteoEntite,
+    Operateur,
+    RegleDeclenchante,
+)
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-A"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Serie = list[tuple[int, int]]
+
+
+def _entiers(*valeurs: int) -> Serie:
+    return [(v, 1) for v in valeurs]
+
+
+CONSTANTE_1 = _entiers(*[1] * 10)
+CONSTANTE_3 = _entiers(*[5] * 10)
+CONSTANTE_4 = [(1, 100)] * 10
+SERIE_IND_3 = _entiers(*range(10, 20))
+SERIE_IND_1 = _entiers(0, 0, 0, 0, 0, 1, 1, 1, 2, 2)
+SERIE_IND_4 = [(v, 100) for v in range(5, 15)]
+
+
+def _grille(
+    ind_3: dict[str, object] | None = None, ind_1: dict[str, object] | None = None
+) -> GrilleMeteo:
+    def regle(libelle: str, rouge: str | None, active: bool = True) -> dict[str, object]:
+        seuils = {"orange": ">= 0"}
+        if rouge is not None:
+            seuils["rouge"] = rouge
+        return {"libelle": libelle, "active": active, "seuils": seuils}
+
+    return GrilleMeteo.model_validate(
+        {
+            "version": 1,
+            "regle_agregation": "pire_couleur",
+            "garde_fous": {
+                "ind4_min_tests_executes": 0,
+                "ind7_min_entrees_fenetre_glissante": 0,
+            },
+            "indicateurs": {
+                "IND-1": ind_1 or regle("Bloquantes", ">= 3"),
+                "IND-3": ind_3 or regle("Anomalies", ">= 20"),
+                "IND-4": regle("Taux de KO", ">= 0.20"),
+            },
+        }
+    )
+
+
+def _table(
+    ind_1: Serie = CONSTANTE_1,
+    ind_3: Serie = CONSTANTE_3,
+    ind_4: Serie = CONSTANTE_4,
+    *,
+    non_evalue: dict[CodeIndicateur, dict[int, str]] | None = None,
+    fin: date = D,
+    entite: str = ENTITE,
+) -> pl.DataFrame:
+    """Table `SCHEMA_INDICATEUR` ; `non_evalue` : rang (0 = plus ancien) → motif."""
+    non_evalue = non_evalue or {}
+    lignes: list[dict[str, object]] = []
+    for code, serie in ((IND_1, ind_1), (IND_3, ind_3), (IND_4, ind_4)):
+        dates = jours_ouvres(date(2026, 1, 1), fin)[-len(serie) :]
+        for rang, (jour, (num, den)) in enumerate(zip(dates, serie, strict=True)):
+            motif = non_evalue.get(code, {}).get(rang)
+            lignes.append(
+                {
+                    "date": jour,
+                    "entite": entite,
+                    "code": code.value,
+                    "statut": (
+                        StatutIndicateur.non_evaluable if motif else StatutIndicateur.evalue
+                    ).value,
+                    "motif": motif or "",
+                    "numerateur": 0 if motif else num,
+                    "denominateur": 0 if motif else den,
+                    "couleur": Couleur.vert.value,
+                }
+            )
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regles = (
+        RegleDeclenchante(
+            code=CodeIndicateur.ind_2,
+            couleur=couleur,
+            operateur=Operateur.superieur_ou_egal,
+            numerateur=1,
+            denominateur=1,
+            seuil_numerateur=0,
+            seuil_denominateur=1,
+            tickets_en_cause=(),
+        ),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=regles,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _sans_ligne(table: pl.DataFrame, code: CodeIndicateur, jour: date) -> pl.DataFrame:
+    return table.filter(~((pl.col("code") == code.value) & (pl.col("date") == jour)))
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = risques_entree_rouge(_table(ind_3=SERIE_IND_3), _meteo(), _grille())
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(20)
+    risque_ = projete.risque
+    assert risque_.date_franchissement_estimee == jour_ouvre_suivant(D)
+    assert (risque_.numerateur, risque_.denominateur) == (19, 1)
+    assert (risque_.seuil_numerateur, risque_.seuil_denominateur) == (20, 1)
+    assert resultat.exclus == ()
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = risques_entree_rouge(_table(ind_1=SERIE_IND_1), _meteo(), _grille())
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_1]
+    projete = resultat.risques[0]
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.date_franchissement_estimee == commun.avancer(D, 5)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_regression_ind_1_pente_et_ordonnee() -> None:
+    valeurs = [Fraction(v) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+    pente, ordonnee = risque._regression(valeurs)
+
+    assert (pente, ordonnee) == (Fraction(41, 165), Fraction(-23, 55))
+    assert ordonnee + pente * 13 == Fraction(464, 165)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = risques_entree_rouge(_table(ind_4=SERIE_IND_4), _meteo(), _grille())
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+@pytest.mark.parametrize("decroissante", [False, True])
+def test_stable_ou_en_baisse(decroissante: bool) -> None:
+    if decroissante:
+        table = _table(
+            _entiers(*range(2, -8, -1)),
+            _entiers(*range(19, 9, -1)),
+            [(v, 100) for v in range(14, 4, -1)],
+        )
+    else:
+        table = _table()
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    table = _table(
+        ind_3=SERIE_IND_3,
+        ind_4=SERIE_IND_4,
+        non_evalue={IND_4: {3: "tests exécutés insuffisants", 6: "autre motif"}},
+    )
+
+    resultat = risques_entree_rouge(table, _meteo(), _grille())
+
+    assert [r.risque.indicateur for r in resultat.risques] == [IND_3]
+    assert len(resultat.exclus) == 1
+    exclu = resultat.exclus[0]
+    assert exclu.code is IND_4
+    premiere_date = jours_ouvres(date(2026, 1, 1), D)[-10:][3]
+    assert premiere_date.isoformat() in exclu.motif
+    assert "tests exécutés insuffisants" in exclu.motif
+    assert "autre motif" not in exclu.motif
+
