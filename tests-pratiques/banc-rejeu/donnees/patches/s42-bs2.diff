+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Elle lit
+les séries d'IND-1, IND-3 et IND-4 d'une Entité non rouge (table `SCHEMA_INDICATEUR`) et sa
+`MeteoEntite` à la Date d'arrêté D :
+
+- régression linéaire (moindres carrés) sur les `fenetre` derniers Jours ouvrés finissant à D,
+  x = 0..n−1, projetée de 1 à `horizon` Jours ouvrés après D ;
+- un `RisqueEntreeRouge` par indicateur dont une projection déclenche la règle rouge de la
+  Grille, au premier horizon h concerné, avec la valeur projetée ;
+- les indicateurs écartés (non évaluables sur la fenêtre, historique insuffisant, sans seuil
+  rouge actif) sont restitués avec leur motif.
+
+La Baseline et la vélocité nette ne sont pas réutilisées : seules les primitives de `commun`
+(avance en Jours ouvrés, test de seuil) sont partagées.
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+INDICATEURS_PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8 du Risque d'entrée en rouge, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque : paramètre {nom} invalide {valeur!r} (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class _Point:
+    date: date
+    motif: str | None
+    """Motif de non-évaluabilité ; `None` si évalué."""
+    valeur: Fraction | None
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Risque d'entrée en rouge et valeur projetée à la date de franchissement estimée."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete` (H-8).
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D sont
+    lues, et elles doivent former des Jours ouvrés consécutifs finissant à D pour chaque
+    indicateur actif. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la
+    table est invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, Entité non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in CodeIndicateur:
+        if code not in INDICATEURS_PROJETES:
+            continue
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, f"{code} inactif dans la Grille"))
+            continue
+        if Couleur.rouge not in regle.seuils:
+            exclus.append(IndicateurExclu(code, f"{code} sans seuil rouge dans la Grille"))
+            continue
+        operateur, seuil = regle.seuils[Couleur.rouge]
+
+        lignes = _lignes(table, meteo, code)[-parametres.fenetre :]
+        non_evalue = next((point for point in lignes if point.valeur is None), None)
+        if non_evalue is not None:
+            exclus.append(
+                IndicateurExclu(
+                    code,
+                    f"{code} non évaluable le {non_evalue.date.isoformat()} ({non_evalue.motif})",
+                )
+            )
+            continue
+        if len(lignes) < 2:
+            exclus.append(IndicateurExclu(code, f"{code} : historique insuffisant"))
+            continue
+
+        valeurs = [point.valeur for point in lignes if point.valeur is not None]
+        n = len(valeurs)
+        pente, ordonnee = _regression(valeurs)
+        for h in range(1, parametres.horizon + 1):
+            projetee = ordonnee + pente * (n - 1 + h)
+            if declenche(projetee, operateur, seuil):
+                courante = valeurs[-1]
+                risque = RisqueEntreeRouge(
+                    date_arrete=meteo.date_arrete,
+                    entite=entite,
+                    indicateur=code,
+                    date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                    horizon_jours_ouvres=parametres.horizon,
+                    numerateur=courante.numerator,
+                    denominateur=courante.denominator,
+                    seuil_numerateur=seuil.numerator,
+                    seuil_denominateur=seuil.denominator,
+                    version_grille=meteo.version_grille,
+                )
+                risques.append(RisqueProjete(risque, projetee))
+                break
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _lignes(table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur) -> list[_Point]:
+    """Points de l'indicateur jusqu'à D, contrôlés et dans l'ordre."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    brutes = (
+        table.filter(
+            (pl.col("entite") == entite) & (pl.col("code") == code) & (pl.col("date") <= arrete)
+        )
+        .sort("date")
+        .to_dicts()
+    )
+    lignes: list[_Point] = []
+    precedente: date | None = None
+    for brute in brutes:
+        jour: date = brute["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} {code} : {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if precedente == jour:
+            raise UsineErreur(f"Risque {entite} {code} : date {jour.isoformat()} en double")
+        if precedente is not None and jour_ouvre_suivant(precedente) != jour:
+            raise UsineErreur(
+                f"Risque {entite} {code} : trou de Jours ouvrés entre"
+                f" {precedente.isoformat()} et {jour.isoformat()}"
+            )
+        precedente = jour
+        if brute["statut"] == StatutIndicateur.non_evaluable:
+            lignes.append(_Point(jour, brute["motif"], None))
+            continue
+        if brute["denominateur"] <= 0:
+            raise UsineErreur(
+                f"Risque {entite} {code} : dénominateur {brute['denominateur']} invalide"
+                f" le {jour.isoformat()}"
+            )
+        lignes.append(_Point(jour, None, Fraction(brute["numerateur"], brute["denominateur"])))
+    if precedente != arrete:
+        raise UsineErreur(
+            f"Risque {entite} {code} : Date d'arrêté {arrete.isoformat()} absente de la table"
+        )
+    return lignes
+
+
+def _regression(valeurs: list[Fraction]) -> tuple[Fraction, Fraction]:
+    """Pente et ordonnée à l'origine des moindres carrés de `valeurs` en x = 0..n−1 (n ≥ 2)."""
+    n = len(valeurs)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(valeurs, Fraction(0)) / n
+    ecarts = [Fraction(x) - x_moyen for x in range(n)]
+    variance = sum((e * e for e in ecarts), Fraction(0))
+    covariance = sum((e * (y - y_moyen) for e, y in zip(ecarts, valeurs, strict=True)), Fraction(0))
+    pente = covariance / variance
+    return pente, y_moyen - pente * x_moyen
