+
+
+def test_part_du_plafond_refuse_l_appel_frais_mais_sert_le_cache() -> None:
+    cache = CacheMemoire()
+    deja = textes({"DEMO-2": ("Flux bloqué", "Le flux de virements est rejeté.")})
+    classer(_passerelle(FournisseurFactice([REPONSE]), cache), deja, DATE_ARRETE, _contexte())
+
+    plafond = Decimal(4)
+    part = plafond * PART_PLAFOND_CLASSIFICATION
+    factice = FournisseurFactice([REPONSE] * 2 + [ReponseExplication(texte="DEMO-1 est en cause.")])
+    passerelle = _passerelle(factice, cache, plafond=plafond)
+    sorties, traces = classer(passerelle, TEXTES, DATE_ARRETE, _contexte(part))
+    # DEMO-1 (1 €), DEMO-2 (cache, 0 €), DEMO-10 (1 €) : cumul 2 € = part ; rien d'autre.
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert [t.depuis_cache for t in traces] == [False, True, False]
+    assert passerelle.cout_cumule_eur(PASSAGE_ID) == part
+
+    plus = textes({"DEMO-11": ("Encore", "Une autre.")})
+    assert classer(passerelle, plus, DATE_ARRETE, _contexte(part)) == ((), ())
+    servies, _ = classer(passerelle, deja, DATE_ARRETE, _contexte(part))
+    assert [s.cle_ticket for s in servies] == ["DEMO-2"]
+
+    # Les explications gardent le reste du plafond du Passage.
+    sortie, traces_explication = explication.expliquer(
+        passerelle,
+        meteo_rouge(tickets=("DEMO-1",)),
+        TEXTES,
+        explication.ContexteExplication(PASSAGE_ID, "d" * 64, explication.lire_prompt()),
+    )
+    assert sortie.statut_controle is StatutControle.conforme
+    assert len(traces_explication) == 1
+    assert len(factice.appels) == 3
+
