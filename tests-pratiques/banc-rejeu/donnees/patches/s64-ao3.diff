+def test_justification_hors_cible_retiree() -> None:
+    reponse = ReponseClassification(
+        cause_racine=CauseRacine.reprise_donnees,
+        justification="Le solde DEMO-1 est mal migré. Comme pour DEMO-9.",
+    )
+    seul = textes({"DEMO-1": ("Solde faux", "Le solde migré diffère.")})
+    (sortie,), (trace,) = classer(
+        _passerelle(FournisseurFactice([reponse])), seul, DATE_ARRETE, _contexte()
+    )
+    assert sortie.justification == "Le solde DEMO-1 est mal migré."
+    assert "DEMO-9" not in sortie.justification
+    assert sortie.statut_controle is StatutControle.corrige
+    assert trace.statut_controle is StatutControle.corrige
+    assert trace.phrases_retirees == 1
