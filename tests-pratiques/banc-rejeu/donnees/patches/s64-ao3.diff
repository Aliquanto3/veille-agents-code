+"""Tâche `classification` : Cause racine par Anomalie, incrémentale par le cache (FR-35)."""
+
+import logging
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.doublures.fournisseur_factice import FournisseurFactice
+from tests.unit.ia.espions import (
+    DATE_ARRETE,
+    NUMERO_COMPTE,
+    PASSAGE_ID,
+    CacheMemoire,
+    horloge_espion,
+    jeton_compte,
+    meteo_rouge,
+    pseudonymiseur,
+    textes,
+)
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import (
+    ReponseClassification,
+    ReponseExplication,
+    StatutControle,
+    Tache,
+)
+from usine.contrats.tickets import SCHEMA_TICKET_TEXTE, CauseRacine
+from usine.contrats.versions import version_prompt
+from usine.ia import explication
+from usine.ia.classification import (
+    DELIMITEUR,
+    PART_PLAFOND_CLASSIFICATION,
+    ContexteClassification,
+    classer,
+    lire_prompt,
+    rendre_prompt,
+)
+from usine.ia.passerelle import Passerelle
+
+RACINE = Path(__file__).resolve().parents[3]
+TEXTES = textes(
+    {
+        "DEMO-10": ("Solde faux", "Le solde migré diffère de l'ancien SI."),
+        "DEMO-2": ("Flux bloqué", "Le flux de virements est rejeté."),
+        "DEMO-1": ("Table absente", "La table des devises n'est pas paramétrée."),
+    }
+)
+REPONSE = ReponseClassification(cause_racine=CauseRacine.parametrage, justification="")
+
+
+def _contexte(plafond_eur: Decimal | None = None) -> ContexteClassification:
+    return ContexteClassification(
+        passage_id=PASSAGE_ID,
+        version_donnees="d" * 64,
+        version_grille="grille123456",
+        gabarit=lire_prompt(),
+        plafond_eur=plafond_eur,
+    )
+
+
+def _passerelle(
+    factice: FournisseurFactice,
+    cache: CacheMemoire | None = None,
+    plafond: Decimal | None = None,
+) -> Passerelle:
+    return Passerelle(
+        factice,
+        pseudonymiseur(),
+        cache if cache is not None else CacheMemoire(),
+        horloge_espion([]),
+        tarif=lambda modele, entree, sortie: Decimal(1),
+        plafond_cout_passage_eur=plafond,
+    )
+
+
+def test_premier_passage_une_sortie_par_anomalie_triee() -> None:
+    factice = FournisseurFactice([REPONSE] * 3)
+    sorties, traces = classer(_passerelle(factice), TEXTES, DATE_ARRETE, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert {s.cause_racine for s in sorties} == {CauseRacine.parametrage}
+    assert {s.statut_controle for s in sorties} == {StatutControle.conforme}
+    assert len(factice.appels) == 3
+    assert [t.cible for t in traces] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert {t.tache for t in traces} == {Tache.classification}
+    assert {t.depuis_cache for t in traces} == {False}
+    assert {t.version_grille for t in traces} == {"grille123456"}
+    assert {t.entite for t in traces} == {"ENT-A"}
+    assert {t.version_prompt for t in traces} == {version_prompt(lire_prompt())}
+    assert {t.date_arrete for t in traces} == {DATE_ARRETE}
+
+
+def test_rejeu_autre_date_d_arrete_servi_par_le_cache() -> None:
+    cache = CacheMemoire()
+    premier, _ = classer(
+        _passerelle(FournisseurFactice([REPONSE] * 3), cache), TEXTES, DATE_ARRETE, _contexte()
+    )
+    factice = FournisseurFactice()
+    second, traces = classer(_passerelle(factice, cache), TEXTES, date(2026, 10, 12), _contexte())
+    assert factice.appels == []
+    assert second == premier
+    assert len(traces) == 3
+    assert {t.depuis_cache for t in traces} == {True}
+
+
+def test_incremental_seules_les_anomalies_nouvelles_ou_modifiees_partent() -> None:
+    cache = CacheMemoire()
+    avant = textes({"DEMO-1": ("Table absente", "Avant."), "DEMO-2": ("Flux bloqué", "Inchangé.")})
+    classer(_passerelle(FournisseurFactice([REPONSE] * 2), cache), avant, DATE_ARRETE, _contexte())
+    apres = textes(
+        {
+            "DEMO-1": ("Table absente", "Description modifiée."),
+            "DEMO-2": ("Flux bloqué", "Inchangé."),
+            "DEMO-3": ("Nouvelle", "Anomalie nouvelle."),
+        }
+    )
+    factice = FournisseurFactice([REPONSE] * 2)
+    sorties, traces = classer(_passerelle(factice, cache), apres, DATE_ARRETE, _contexte())
+    assert len(factice.appels) == 2
+    assert [(t.cible, t.depuis_cache) for t in traces] == [
+        ("DEMO-1", False),
+        ("DEMO-2", True),
+        ("DEMO-3", False),
+    ]
+    assert len(sorties) == 3
+
+
+def test_cas_de_test_et_certifications_ignores() -> None:
+    table = pl.DataFrame(
+        {
+            "cle_ticket": ["DEMO-4", "DEMO-5"],
+            "type_ticket": ["cas_de_test", "certification"],
+            "entite": ["ENT-A", "ENT-A"],
