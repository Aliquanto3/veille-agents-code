@@ -0,0 +1,220 @@
+"""Outils de consultation de l'Agent : matrice I/O, lecture seule, intégration sur un Passage."""
+
+import ast
+import importlib
+from datetime import date
+from pathlib import Path
+from typing import Any
+
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+import usine.contrats.agent as contrats_agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.contrats.agent import (
+    AnomalieResume,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+
+DATE = date(2026, 10, 9)
+ABSENTE = date(2026, 1, 5)
+MESSAGE = "aucune donnée pour cette date"
+DATES_DATEES = ["get_meteo", "list_anomalies", "get_prevision", "get_risques"]
+
+
+def _anomalie(cle: str, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=cle,
+        entite="ENT-B",
+        gravite=Gravite.bloquante,
+        phase=Phase.recette,
+        domaine="D",
+        statut=statut,
+        age_jours_ouvres=1,
+    )
+
+
+class _Manifeste:
+    date_arrete = DATE
+
+
+class ConsultationFactice:
+    def __init__(self, dates: tuple[date, ...] = (DATE,)) -> None:
+        self.dates = dates
+        self.appels: list[tuple[str, Any]] = []
+        self.toutes = (
+            _anomalie("A-1", StatutAnomalie.nouvelle),
+            _anomalie("A-2", StatutAnomalie.en_analyse),
+            _anomalie("A-3", StatutAnomalie.en_analyse),
+            _anomalie("A-4", StatutAnomalie.en_analyse),
+        )
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self.dates
+
+    def manifeste(self) -> _Manifeste:
+        return _Manifeste()
+
+    def meteo(self, date_arrete: Any = None, entite: Any = None) -> tuple[()]:
+        return ()
+
+    def evolution_meteo(self, date_arrete: Any = None) -> tuple[()]:
+        return ()
+
+    def anomalies(
+        self,
+        date_arrete: Any = None,
+        entite: Any = None,
+        gravite: Any = None,
+        phase: Any = None,
+        domaine: Any = None,
+        limite: int | None = None,
+    ) -> ResultatListAnomalies:
+        self.appels.append(("anomalies", limite))
+        rendues = self.toutes if limite is None else self.toutes[:limite]
+        return ResultatListAnomalies(
+            date_arrete=date_arrete or DATE, anomalies=rendues, total=len(self.toutes)
+        )
+
+    def tendances(self, entite: Any = None, code_kpi: Any = None) -> pl.DataFrame:
+        return pl.DataFrame(
+            {
+                "date": [DATE],
+                "perimetre": ["ENT-B"],
+                "code_kpi": ["K"],
+                "dimension": ["d"],
+                "numerateur": [1],
+                "denominateur": [2],
+            }
+        )
+
+    def previsions(self, date_arrete: Any = None, entite: Any = None) -> tuple[()]:
+        return ()
+
+    def risques(self, date_arrete: Any = None, entite: Any = None) -> tuple[()]:
+        return ()
+
+
+def _outils(consultation: Any) -> dict[str, Any]:
+    return {o.nom: o for o in outils_consultation(consultation)}
+
+
+def test_noms_exacts() -> None:
+    assert NOMS_OUTILS == (
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    )
+    assert tuple(_outils(ConsultationFactice())) == NOMS_OUTILS
+
+
+@pytest.mark.parametrize("nom", DATES_DATEES)
+def test_date_sans_passage(nom: str) -> None:
+    resultat = _outils(ConsultationFactice())[nom].executer({"date_arrete": ABSENTE.isoformat()})
+    assert resultat == AucuneDonnee(date_arrete=ABSENTE, message=MESSAGE)
+
+
+@pytest.mark.parametrize("nom", DATES_DATEES)
+def test_aucune_date_du_tout(nom: str) -> None:
+    resultat = _outils(ConsultationFactice(dates=()))[nom].executer({})
+    assert resultat == AucuneDonnee(date_arrete=None, message=MESSAGE)
+
+
+def test_date_absente_prend_celle_du_manifeste() -> None:
+    resultat = _outils(ConsultationFactice())["get_meteo"].executer({})
+    assert isinstance(resultat, ResultatGetMeteo)
+    assert resultat.date_arrete == DATE
+
+
+def test_filtre_statut_et_limite() -> None:
+    outil = _outils(ConsultationFactice())["list_anomalies"]
+    resultat = outil.executer({"statut": "en_analyse", "limite": 2})
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert [a.cle_ticket for a in resultat.anomalies] == ["A-2", "A-3"]
+    assert resultat.total == 3
+
+
+def test_sans_statut_la_limite_est_deleguee() -> None:
+    consultation = ConsultationFactice()
+    resultat = _outils(consultation)["list_anomalies"].executer({"limite": 2})
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert len(resultat.anomalies) == 2
+    assert resultat.total == 4
+    assert ("anomalies", 2) in consultation.appels
+
+
+def test_tendance_sans_date() -> None:
+    resultat = _outils(ConsultationFactice(dates=()))["get_tendance"].executer({})
+    assert isinstance(resultat, ResultatGetTendance)
+    assert len(resultat.points) == 1
+
+
+def test_arguments_invalides() -> None:
+    outils = _outils(ConsultationFactice())
+    with pytest.raises(ValidationError):
+        outils["list_anomalies"].executer({"limite": 0})
+    with pytest.raises(ValidationError):
+        outils["get_meteo"].executer({"inconnu": 1})
+
+
+def test_arguments_de_contrats_agent() -> None:
+    for outil in _outils(ConsultationFactice()).values():
+        assert outil.arguments.__module__ == contrats_agent.__name__
+        assert outil.description
+
+
+def test_lecture_seule() -> None:
+    verbes = ("create", "update", "write", "send", "delete", "set_", "post", "push", "save")
+    publiques = [n for n in dir(OutilsConsultation) if not n.startswith("_")]
+    assert sorted(publiques) == sorted(NOMS_OUTILS)
+    assert not [n for n in NOMS_OUTILS if any(v in n for v in verbes)]
+
+    interdits = {
+        "usine.ports.source_tickets",
+        "usine.ports.entrepot",
+        "usine.ports.etape",
+        "usine.ports.fournisseur_llm",
+        "usine.ports.cache_llm",
+        "usine.ports",
+        "pydantic_ai",
+        "httpx",
+    }
+    paquet = Path(importlib.import_module("usine.ia.agent").__file__ or "").parent
+    for source in paquet.glob("*.py"):
+        if source.stem == "cli":
+            continue
+        for noeud in ast.walk(ast.parse(source.read_text(encoding="utf-8"))):
+            if isinstance(noeud, ast.ImportFrom) and noeud.module:
+                assert noeud.module not in interdits, f"{source.name} importe {noeud.module}"
+                assert not noeud.module.startswith("usine.adaptateurs")
+            elif isinstance(noeud, ast.Import):
+                for alias in noeud.names:
+                    assert alias.name not in interdits
+
+
+def test_integration_passage_palier_2() -> None:
+    cas = passage_palier_2()
+    outils = _outils(cas.consultation)
+    meteo = outils["get_meteo"].executer({"entite": cas.entite})
+    assert isinstance(meteo, ResultatGetMeteo)
+    assert {m.entite for m in meteo.meteos} == {cas.entite}
+    anomalies = outils["list_anomalies"].executer({"entite": cas.entite, "limite": 1})
+    assert isinstance(anomalies, ResultatListAnomalies)
+    assert len(anomalies.anomalies) <= 1
+    assert anomalies.total >= len(anomalies.anomalies)
+    assert isinstance(outils["get_tendance"].executer({}), ResultatGetTendance)
+    assert isinstance(outils["get_prevision"].executer({}), ResultatGetPrevision)
+    assert isinstance(outils["get_risques"].executer({}), ResultatGetRisques)
+    assert outils["get_risques"].executer({"date_arrete": "2020-01-06"}) == AucuneDonnee(
+        date_arrete=date(2020, 1, 6)
+    )
