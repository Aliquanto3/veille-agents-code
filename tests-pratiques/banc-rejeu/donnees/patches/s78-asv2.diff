@@ -0,0 +1,182 @@
+"""Outils de consultation de l'Agent : cinq lectures d'un Passage, sans écriture (FR-39, FR-41).
+
+Chaque outil lit par le seul port `Consultation` (AD-11) ; l'Agent n'a aucun accès à Jira (AD-5).
+Une Date d'arrêté que le Passage ne couvre pas donne `AucuneDonnee`, jamais une exception. La
+sérialisation en texte et la Pseudonymisation reviennent à la passerelle (Story 7.9).
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    AnomalieResume,
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS = ("get_meteo", "list_anomalies", "get_tendance", "get_prevision", "get_risques")
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Un outil : nom, description pour le modèle, classe d'arguments et exécution typée."""
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+
+
+class OutilsConsultation:
+    """Les cinq outils de lecture de l'Agent, servis par une `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _sans_passage(self, date_arrete: date | None) -> AucuneDonnee | None:
+        """`AucuneDonnee` si la date demandée (ou celle du manifeste) n'a pas de Passage."""
+        if self._date(date_arrete) in self._consultation.dates_disponibles():
+            return None
+        return AucuneDonnee(date_arrete=date_arrete)
+
+    def _date(self, date_arrete: date | None) -> date:
+        if date_arrete is not None:
+            return date_arrete
+        return self._consultation.manifeste().date_arrete
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5 à la date demandée."""
+        if (absent := self._sans_passage(arguments.date_arrete)) is not None:
+            return absent
+        date_arrete = self._date(arguments.date_arrete)
+        evolutions = self._consultation.evolution_meteo(date_arrete)
+        if arguments.entite is not None:
+            evolutions = tuple(e for e in evolutions if e.entite == arguments.entite)
+        return ResultatGetMeteo(
+            date_arrete=date_arrete,
+            meteos=self._consultation.meteo(date_arrete, arguments.entite),
+            evolutions=evolutions,
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées par Entité, Gravité, Phase, domaine et statut."""
+        if (absent := self._sans_passage(arguments.date_arrete)) is not None:
+            return absent
+        date_arrete = self._date(arguments.date_arrete)
+        # Sans filtre `statut`, la limite est appliquée par la Consultation ; sinon on la
+        # applique ici, après avoir sélectionné les lignes, pour que `total` reste filtré.
+        limite = arguments.limite if arguments.statut is None else None
+        toutes = self._consultation.anomalies(
+            date_arrete,
+            arguments.entite,
+            arguments.gravite,
+            arguments.phase,
+            arguments.domaine,
+            limite,
+        )
+        if arguments.statut is None:
+            return toutes
+        retenues: tuple[AnomalieResume, ...] = tuple(
+            a for a in toutes.anomalies if a.statut == arguments.statut
+        )
+        return ResultatListAnomalies(
+            date_arrete=date_arrete,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire ; sans date, donc jamais `AucuneDonnee`."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        colonnes = list(PointTendance.model_fields)
+        points = tuple(PointTendance(**ligne) for ligne in table.select(colonnes).to_dicts())
+        return ResultatGetTendance(points=points)
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge à la date demandée."""
+        if (absent := self._sans_passage(arguments.date_arrete)) is not None:
+            return absent
+        date_arrete = self._date(arguments.date_arrete)
+        return ResultatGetPrevision(
+            date_arrete=date_arrete,
+            previsions=self._consultation.previsions(date_arrete, arguments.entite),
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge à la date demandée."""
+        if (absent := self._sans_passage(arguments.date_arrete)) is not None:
+            return absent
+        date_arrete = self._date(arguments.date_arrete)
+        return ResultatGetRisques(
+            date_arrete=date_arrete,
+            risques=self._consultation.risques(date_arrete, arguments.entite),
+        )
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Les cinq outils de l'Agent, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+
+    def definition[A: Enregistrement](
+        nom: str,
+        description: str,
+        arguments: type[A],
+        appel: Callable[[A], Enregistrement],
+    ) -> DefinitionOutil:
+        return DefinitionOutil(
+            nom,
+            description,
+            arguments,
+            lambda brut: appel(arguments.model_validate(dict(brut))),
+        )
+
+    return (
+        definition(
+            "get_meteo",
+            "Météo des Entités, Règles déclenchantes et évolution J-1 / J-5 à une Date d'arrêté.",
+            ArgumentsGetMeteo,
+            outils.get_meteo,
+        ),
+        definition(
+            "list_anomalies",
+            "Anomalies ouvertes, filtrables par Entité, Gravité, Phase, domaine et statut.",
+            ArgumentsListAnomalies,
+            outils.list_anomalies,
+        ),
+        definition(
+            "get_tendance",
+            "Tendance hebdomadaire des KPI, par Entité et par KPI.",
+            ArgumentsGetTendance,
+            outils.get_tendance,
+        ),
+        definition(
+            "get_prevision",
+            "Prévisions de sortie du rouge à une Date d'arrêté.",
+            ArgumentsGetPrevision,
+            outils.get_prevision,
+        ),
+        definition(
+            "get_risques",
+            "Risques d'entrée en rouge à une Date d'arrêté.",
+            ArgumentsGetRisques,
+            outils.get_risques,
+        ),
+    )
