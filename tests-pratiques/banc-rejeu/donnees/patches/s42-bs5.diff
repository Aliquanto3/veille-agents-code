@@ -0,0 +1,200 @@
+"""Risque d'entrée en rouge (FR-21, AD-18, addendum PRD § E, H-8).
+
+Fonction pure et déterministe, sans horloge ni hasard, en nombres exacts (`Fraction`). Pour une
+Entité non rouge à la Date d'arrêté D, elle ajuste par moindres carrés une droite sur les
+`fenetre` derniers Jours ouvrés d'IND-1, IND-3 et IND-4 (x = 0..n−1), la projette de 1 à
+`horizon` Jours ouvrés après D et émet un `RisqueEntreeRouge` par indicateur dont une
+projection déclenche la règle rouge de la Grille, avec la valeur projetée (que le contrat gelé
+ne porte pas : `RisqueEntreeRouge.numerateur/denominateur` est la valeur courante).
+
+Les indicateurs écartés (inactifs ou sans seuil rouge, non évaluables sur la fenêtre,
+historique insuffisant) sont restitués avec leur motif. Avance en Jours ouvrés et test de seuil
+viennent de `commun` ; la Baseline n'est pas réécrite (AD-18).
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR, StatutIndicateur
+from usine.contrats.calendrier import est_jour_ouvre, jour_ouvre_suivant
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision.commun import avancer, declenche
+
+PROJETES = (CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4)
+"""Indicateurs projetés, dans l'ordre de `CodeIndicateur`."""
+
+
+@dataclass(frozen=True)
+class ParametresRisque:
+    """Paramètres H-8, en Jours ouvrés (chacun entier ≥ 1)."""
+
+    fenetre: int = 10
+    horizon: int = 5
+
+    def __post_init__(self) -> None:
+        for nom in ("fenetre", "horizon"):
+            valeur = getattr(self, nom)
+            if type(valeur) is not int or valeur < 1:
+                raise UsineErreur(
+                    f"Risque d'entrée en rouge : paramètre {nom} invalide {valeur!r}"
+                    " (entier ≥ 1 attendu)"
+                )
+
+
+@dataclass(frozen=True)
+class RisqueProjete:
+    """Un `RisqueEntreeRouge` et la valeur projetée de l'indicateur à la date de franchissement."""
+
+    risque: RisqueEntreeRouge
+    valeur_projetee: Fraction
+
+
+@dataclass(frozen=True)
+class IndicateurExclu:
+    """Indicateur écarté de la projection, avec son motif."""
+
+    code: CodeIndicateur
+    motif: str
+
+
+@dataclass(frozen=True)
+class ResultatRisque:
+    """Risques émis et indicateurs exclus, chacun dans l'ordre de `CodeIndicateur`."""
+
+    risques: tuple[RisqueProjete, ...]
+    exclus: tuple[IndicateurExclu, ...]
+
+
+@dataclass(frozen=True)
+class _Point:
+    date: date
+    evalue: bool
+    motif: str
+    numerateur: int
+    denominateur: int
+
+
+def risques_entree_rouge(
+    indicateurs: pl.DataFrame,
+    meteo: MeteoEntite,
+    grille: GrilleMeteo,
+    parametres: ParametresRisque = ParametresRisque(),  # noqa: B008 (dataclass gelée)
+) -> ResultatRisque:
+    """Risques d'entrée en rouge de `meteo.entite` à `meteo.date_arrete`.
+
+    `indicateurs` suit `SCHEMA_INDICATEUR` ; seules les lignes de l'Entité datées au plus D sont
+    lues, et elles doivent former des Jours ouvrés consécutifs finissant à D pour chaque
+    indicateur actif. Lève une `UsineErreur` nommant l'Entité si la Météo est rouge ou si la
+    table est invalide.
+    """
+    entite = meteo.entite
+    if meteo.couleur is Couleur.rouge:
+        raise UsineErreur(f"Risque {entite} : Météo rouge, Entité non rouge attendue")
+    try:
+        table = valider(indicateurs, SCHEMA_INDICATEUR)
+    except UsineErreur as exc:
+        raise UsineErreur(f"Risque {entite} : {exc}") from exc
+
+    risques: list[RisqueProjete] = []
+    exclus: list[IndicateurExclu] = []
+    for code in PROJETES:
+        regle = grille.indicateurs.get(code)
+        if regle is None or not regle.active:
+            exclus.append(IndicateurExclu(code, f"{code} inactif dans la Grille"))
+            continue
+        rouge = regle.seuils.get(Couleur.rouge)
+        if rouge is None:
+            exclus.append(IndicateurExclu(code, f"{code} sans seuil rouge dans la Grille"))
+            continue
+        operateur, seuil = rouge
+        points = _points(table, meteo, code)[-parametres.fenetre :]
+        non_evaluable = next((p for p in points if not p.evalue), None)
+        if non_evaluable is not None:
+            motif = (
+                f"{code} non évaluable le {non_evaluable.date.isoformat()} : {non_evaluable.motif}"
+            )
+            exclus.append(IndicateurExclu(code, motif))
+            continue
+        if len(points) < 2:
+            exclus.append(IndicateurExclu(code, f"{code} : historique insuffisant"))
+            continue
+        ordonnees = [Fraction(p.numerateur, p.denominateur) for p in points]
+        a, b = _droite(ordonnees)
+        n = len(points)
+        for h in range(1, parametres.horizon + 1):
+            projetee = a + b * (n - 1 + h)
+            if declenche(projetee, operateur, seuil):
+                courant = points[-1]
+                risque = RisqueEntreeRouge(
+                    date_arrete=meteo.date_arrete,
+                    entite=entite,
+                    indicateur=code,
+                    date_franchissement_estimee=avancer(meteo.date_arrete, h),
+                    horizon_jours_ouvres=parametres.horizon,
+                    numerateur=courant.numerateur,
+                    denominateur=courant.denominateur,
+                    seuil_numerateur=seuil.numerator,
+                    seuil_denominateur=seuil.denominator,
+                    version_grille=meteo.version_grille,
+                )
+                risques.append(RisqueProjete(risque, projetee))
+                break
+    return ResultatRisque(tuple(risques), tuple(exclus))
+
+
+def _points(table: pl.DataFrame, meteo: MeteoEntite, code: CodeIndicateur) -> list[_Point]:
+    """Points de l'indicateur de l'Entité jusqu'à D, contrôlés et dans l'ordre."""
+    entite, arrete = meteo.entite, meteo.date_arrete
+    lignes = (
+        table.filter(
+            (pl.col("entite") == entite) & (pl.col("code") == code) & (pl.col("date") <= arrete)
+        )
+        .sort("date")
+        .to_dicts()
+    )
+    points: list[_Point] = []
+    for ligne in lignes:
+        jour: date = ligne["date"]
+        if not est_jour_ouvre(jour):
+            raise UsineErreur(
+                f"Risque {entite} : {code} {jour.isoformat()} n'est pas un Jour ouvré"
+            )
+        if points and points[-1].date == jour:
+            raise UsineErreur(f"Risque {entite} : {code} date {jour.isoformat()} en double")
+        if points and jour_ouvre_suivant(points[-1].date) != jour:
+            raise UsineErreur(
+                f"Risque {entite} : {code} trou de Jours ouvrés entre"
+                f" {points[-1].date.isoformat()} et {jour.isoformat()}"
+            )
+        evalue = ligne["statut"] == StatutIndicateur.evalue
+        if evalue and ligne["denominateur"] <= 0:
+            raise UsineErreur(
+                f"Risque {entite} : {code} {jour.isoformat()} valeur évaluée de dénominateur"
+                f" {ligne['denominateur']}"
+            )
+        points.append(
+            _Point(jour, evalue, ligne["motif"], ligne["numerateur"], ligne["denominateur"])
+        )
+    if not points or points[-1].date != arrete:
+        raise UsineErreur(
+            f"Risque {entite} : Date d'arrêté {arrete.isoformat()} absente pour {code}"
+        )
+    return points
+
+
+def _droite(ordonnees: list[Fraction]) -> tuple[Fraction, Fraction]:
+    """Ordonnée à l'origine et pente des moindres carrés pour x = 0..n−1 (n ≥ 2)."""
+    n = len(ordonnees)
+    x_moyen = Fraction(n - 1, 2)
+    y_moyen = sum(ordonnees, Fraction(0)) / n
+    pente = sum(
+        ((x - x_moyen) * (y - y_moyen) for x, y in enumerate(ordonnees)), Fraction(0)
+    ) / sum(((x - x_moyen) ** 2 for x in range(n)), Fraction(0))
+    return y_moyen - pente * x_moyen, pente
