+"""Risque d'entrée en rouge (Story 4.2, FR-21, AD-18).
+
+Valeurs attendues calculées à la main sur 10 Jours ouvrés finissant à D (x = 0..9).
+Grille de référence : rouge IND-1 `>= 3`, IND-3 `>= 20`, IND-4 `>= 1/5`.
+
+- IND-3 = 10..19 : pente 1, p(1) = 20 → franchissement à D + 1 JO.
+- IND-1 = 0 0 0 0 0 1 1 1 2 2 : x̄ = 9/2, ȳ = 7/10, Σ(x − x̄)² = 165/2, Σ(x − x̄)(y − ȳ) = 41/2,
+  pente 41/165, ordonnée −23/55 ; p(4) = 464/165 < 3, p(5) = 101/33 ≥ 3 → D + 5 JO.
+- IND-4 = 5/100..14/100 : pente 1/100, p(5) = 19/100 < 1/5 → aucun risque.
+"""
+
+import re
+from collections.abc import Sequence
+from datetime import date
+from fractions import Fraction
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from usine.contrats.calcul import SCHEMA_INDICATEUR
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import GrilleMeteo
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.meteo import CodeIndicateur, Couleur, MeteoEntite, Operateur, RegleDeclenchante
+from usine.contrats.prevision import RisqueEntreeRouge
+from usine.contrats.schemas import valider
+from usine.domaine.prevision import commun, risque
+from usine.domaine.prevision.risque import (
+    IndicateurExclu,
+    ParametresRisque,
+    ResultatRisque,
+    risques_entree_rouge,
+)
+
+RACINE = Path(__file__).resolve().parents[4]
+D = date(2026, 10, 9)
+ENTITE = "ENT-C"
+VERSION_GRILLE = "grille-test"
+IND_1, IND_3, IND_4 = CodeIndicateur.ind_1, CodeIndicateur.ind_3, CodeIndicateur.ind_4
+
+Valeur = tuple[int, int] | str
+"""Valeur évaluée `(numérateur, dénominateur)` ou motif d'un indicateur non évaluable."""
+
+STABLE: list[Valeur] = [(1, 1)] * 10
+IND_4_STABLE: list[Valeur] = [(1, 10)] * 10
+IND_1_TENDANCE: list[Valeur] = [(v, 1) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+IND_3_HAUSSE: list[Valeur] = [(v, 1) for v in range(10, 20)]
+IND_4_HAUSSE: list[Valeur] = [(v, 100) for v in range(5, 15)]
+
+
+def _grille(
+    ind_3: dict[str, object] | None = None,
+) -> GrilleMeteo:
+    def regle(seuil: str) -> dict[str, object]:
+        return {"libelle": "x", "active": True, "seuils": {"rouge": seuil}}
+
+    return GrilleMeteo.model_validate(
+        {
+            "version": 1,
+            "regle_agregation": "pire_couleur",
+            "garde_fous": {"ind4_min_tests_executes": 20, "ind7_min_entrees_fenetre_glissante": 5},
+            "indicateurs": {
+                "IND-1": regle(">= 3"),
+                "IND-3": ind_3 or regle(">= 20"),
+                "IND-4": regle(">= 0.20"),
+            },
+        }
+    )
+
+
+def _table(
+    series: dict[CodeIndicateur, Sequence[Valeur]],
+    fin: date = D,
+    entite: str = ENTITE,
+) -> pl.DataFrame:
+    lignes: list[dict[str, object]] = []
+    for code, valeurs in series.items():
+        dates = jours_ouvres(date(2026, 1, 1), fin)[-len(valeurs) :]
+        for jour, valeur in zip(dates, valeurs, strict=True):
+            evalue = isinstance(valeur, tuple)
+            lignes.append(
+                {
+                    "date": jour,
+                    "entite": entite,
+                    "code": code.value,
+                    "statut": "evalue" if evalue else "non_evaluable",
+                    "motif": "" if evalue else valeur,
+                    "numerateur": valeur[0] if isinstance(valeur, tuple) else 0,
+                    "denominateur": valeur[1] if isinstance(valeur, tuple) else 0,
+                    "couleur": "orange" if evalue else "vert",
+                }
+            )
+    return valider(pl.DataFrame(lignes, schema=dict(SCHEMA_INDICATEUR.colonnes)), SCHEMA_INDICATEUR)
+
+
+def _meteo(couleur: Couleur = Couleur.orange) -> MeteoEntite:
+    regles: tuple[RegleDeclenchante, ...] = (
+        RegleDeclenchante(
+            code=IND_3,
+            couleur=couleur,
+            operateur=Operateur.superieur_ou_egal,
+            numerateur=15,
+            denominateur=1,
+            seuil_numerateur=10,
+            seuil_denominateur=1,
+            tickets_en_cause=(),
+        ),
+    )
+    return MeteoEntite(
+        date_arrete=D,
+        entite=ENTITE,
+        couleur=couleur,
+        regles=regles,
+        version_grille=VERSION_GRILLE,
+    )
+
+
+def _calculer(
+    series: dict[CodeIndicateur, Sequence[Valeur]], grille: GrilleMeteo | None = None
+) -> ResultatRisque:
+    return risques_entree_rouge(_table(series), _meteo(), grille or _grille())
+
+
+def _tous(**surcharges: Sequence[Valeur]) -> dict[CodeIndicateur, Sequence[Valeur]]:
+    series: dict[CodeIndicateur, Sequence[Valeur]] = {
+        IND_1: STABLE,
+        IND_3: STABLE,
+        IND_4: IND_4_STABLE,
+    }
+    for nom, valeurs in surcharges.items():
+        series[CodeIndicateur(nom.replace("ind_", "IND-"))] = valeurs
+    return series
+
+
+def test_franchissement_ind_3() -> None:
+    resultat = _calculer(_tous(ind_3=IND_3_HAUSSE))
+
+    assert resultat.exclus == ()
+    (projete,) = resultat.risques
+    assert projete.valeur_projetee == Fraction(20)
+    r = projete.risque
+    assert r.indicateur is IND_3
+    assert r.date_franchissement_estimee == date(2026, 10, 12)
+    assert (r.numerateur, r.denominateur) == (19, 1)
+    assert (r.seuil_numerateur, r.seuil_denominateur) == (20, 1)
+    assert r.entite == ENTITE
+    assert r.date_arrete == D
+
+
+def test_tendance_non_lineaire_ind_1() -> None:
+    resultat = _calculer(_tous(ind_1=IND_1_TENDANCE))
+
+    (projete,) = resultat.risques
+    assert projete.valeur_projetee == Fraction(101, 33)
+    assert projete.risque.indicateur is IND_1
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 16)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (2, 1)
+    assert (projete.risque.seuil_numerateur, projete.risque.seuil_denominateur) == (3, 1)
+
+
+def test_droite_exacte() -> None:
+    ordonnees = [Fraction(v) for v in (0, 0, 0, 0, 0, 1, 1, 1, 2, 2)]
+    assert risque._droite(ordonnees) == (Fraction(-23, 55), Fraction(41, 165))
+    assert Fraction(-23, 55) + Fraction(41, 165) * 13 == Fraction(464, 165)
+
+
+def test_hausse_insuffisante_ind_4() -> None:
+    resultat = _calculer(_tous(ind_4=IND_4_HAUSSE))
+
+    assert resultat.risques == ()
+    assert resultat.exclus == ()
+
+
+def test_horizon_etendu_franchit_ind_4() -> None:
+    # p(h) = (5 + 9 + h)/100 : 20/100 à h = 6, hors de l'horizon 5 mais dans un horizon 6.
+    table = _table(_tous(ind_4=IND_4_HAUSSE))
+    (projete,) = risques_entree_rouge(
+        table, _meteo(), _grille(), ParametresRisque(horizon=6)
+    ).risques
+    assert projete.valeur_projetee == Fraction(1, 5)
+    assert projete.risque.horizon_jours_ouvres == 6
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 19)
+    assert (projete.risque.numerateur, projete.risque.denominateur) == (14, 100)
+
+
+@pytest.mark.parametrize(
+    "serie",
+    [STABLE, [(v, 1) for v in range(9, -1, -1)]],
+    ids=["constante", "decroissante"],
+)
+def test_stable_ou_en_baisse(serie: list[tuple[int, int]]) -> None:
+    ind_4: list[Valeur] = [(n, 10 * d) for n, d in serie]
+    resultat = _calculer(_tous(ind_1=serie, ind_3=serie, ind_4=ind_4))
+
+    assert resultat == ResultatRisque((), ())
+
+
+def test_ind_4_non_evaluable_en_partie() -> None:
+    ind_4: list[Valeur] = [*IND_4_HAUSSE]
+    ind_4[3] = "tests insuffisants"
+    resultat = _calculer(_tous(ind_1=IND_1_TENDANCE, ind_3=IND_3_HAUSSE, ind_4=ind_4))
+
+    assert [p.risque.indicateur for p in resultat.risques] == [IND_1, IND_3]
+    (exclu,) = resultat.exclus
+    assert exclu.code is IND_4
+    premiere = jours_ouvres(date(2026, 1, 1), D)[-10:][3].isoformat()
+    assert premiere in exclu.motif
+    assert "tests insuffisants" in exclu.motif
+
+
+def test_ordre_des_codes() -> None:
+    resultat = _calculer(_tous(ind_1=IND_1_TENDANCE, ind_3=IND_3_HAUSSE))
+
+    assert [p.risque.indicateur for p in resultat.risques] == [IND_1, IND_3]
+
+
+def test_historique_court() -> None:
+    un: list[Valeur] = [(25, 1)]
+    resultat = _calculer(_tous(ind_3=un))
+    assert resultat.risques == ()
+    (exclu,) = resultat.exclus
+    assert exclu.code is IND_3
+    assert "historique insuffisant" in exclu.motif
+
+    trois: list[Valeur] = [(10, 1), (15, 1), (19, 1)]
+    # Pente 9/2, ȳ = 44/3, x̄ = 1 : p(1) = 44/3 + 9/2 × 2 = 71/3 ≥ 20.
+    (projete,) = _calculer(_tous(ind_3=trois)).risques
+    assert projete.valeur_projetee == Fraction(71, 3)
+    assert projete.risque.date_franchissement_estimee == date(2026, 10, 12)
