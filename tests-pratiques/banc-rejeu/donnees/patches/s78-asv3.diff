@@ -0,0 +1,170 @@
+"""Outils de consultation de l'Agent, en lecture seule (FR-39, FR-41, AD-2, AD-5, AD-11).
+
+Chaque outil lit le Passage par le seul port `Consultation` et rend un résultat de
+`contrats.agent`, ou `AucuneDonnee` quand la Date d'arrêté demandée n'est pas couverte.
+La sérialisation en texte et la Pseudonymisation reviennent à la passerelle (Story 7.9).
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS: tuple[str, ...] = (
+    "get_meteo",
+    "list_anomalies",
+    "get_tendance",
+    "get_prevision",
+    "get_risques",
+)
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Un outil de l'Agent : nom, description, schéma d'arguments et exécution."""
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+    """Valide les arguments (`ValidationError` Pydantic si invalides) puis lit le Passage."""
+
+
+class OutilsConsultation:
+    """Les cinq outils de lecture de l'Agent, servis par une `Consultation`."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _jour(self, date_arrete: date | None) -> date | None:
+        """Date à lire, ou `None` si le Passage ne la couvre pas."""
+        disponibles = self._consultation.dates_disponibles()
+        if date_arrete is None:
+            return self._consultation.manifeste().date_arrete if disponibles else None
+        return date_arrete if date_arrete in disponibles else None
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        meteos = self._consultation.meteo(jour, arguments.entite)
+        evolutions = self._consultation.evolution_meteo(jour)
+        if arguments.entite is not None:
+            evolutions = tuple(e for e in evolutions if e.entite == arguments.entite)
+        return ResultatGetMeteo(date_arrete=jour, meteos=meteos, evolutions=evolutions)
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées ; `total` compte avant la limite."""
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        filtres = {
+            "entite": arguments.entite,
+            "gravite": arguments.gravite,
+            "phase": arguments.phase,
+            "domaine": arguments.domaine,
+        }
+        if arguments.statut is None:
+            return self._consultation.anomalies(jour, limite=arguments.limite, **filtres)
+        toutes = self._consultation.anomalies(jour, limite=None, **filtres)
+        retenues = tuple(a for a in toutes.anomalies if a.statut == arguments.statut)
+        return ResultatListAnomalies(
+            date_arrete=toutes.date_arrete,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Points de Tendance hebdomadaire ; pas de date, donc jamais `AucuneDonnee`."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        lignes = table.select(list(PointTendance.model_fields)).iter_rows(named=True)
+        return ResultatGetTendance(points=tuple(PointTendance(**ligne) for ligne in lignes))
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        previsions = self._consultation.previsions(jour, arguments.entite)
+        return ResultatGetPrevision(date_arrete=jour, previsions=previsions)
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        risques = self._consultation.risques(jour, arguments.entite)
+        return ResultatGetRisques(date_arrete=jour, risques=risques)
+
+
+def _definir(
+    nom: str,
+    description: str,
+    arguments: type[Any],
+    methode: Callable[[Any], Enregistrement],
+) -> DefinitionOutil:
+    return DefinitionOutil(
+        nom=nom,
+        description=description,
+        arguments=arguments,
+        executer=lambda brut: methode(arguments.model_validate(brut)),
+    )
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Définitions des cinq outils, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+    return (
+        _definir(
+            "get_meteo",
+            "Météo de chaque Entité, Règles déclenchantes et évolution J-1 / J-5.",
+            ArgumentsGetMeteo,
+            outils.get_meteo,
+        ),
+        _definir(
+            "list_anomalies",
+            "Anomalies ouvertes, filtrables par Entité, Gravité, Phase, domaine et statut.",
+            ArgumentsListAnomalies,
+            outils.list_anomalies,
+        ),
+        _definir(
+            "get_tendance",
+            "Tendances hebdomadaires des KPI, par Entité et par code de KPI.",
+            ArgumentsGetTendance,
+            outils.get_tendance,
+        ),
+        _definir(
+            "get_prevision",
+            "Prévisions de sortie du rouge par Entité.",
+            ArgumentsGetPrevision,
+            outils.get_prevision,
+        ),
+        _definir(
+            "get_risques",
+            "Risques d'entrée en rouge par Entité.",
+            ArgumentsGetRisques,
+            outils.get_risques,
+        ),
+    )
