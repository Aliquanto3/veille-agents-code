+"""Outils de consultation de l'Agent : matrice I/O, lecture seule, intégration sur un Passage."""
+
+import ast
+import inspect
+from datetime import date
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, cast
+
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+import usine.ia.agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.contrats import agent as contrats_agent
+from usine.contrats.agent import (
+    AnomalieResume,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+from usine.ports.consultation import Consultation
+
+JOUR = date(2026, 10, 9)
+AUTRE_JOUR = date(2026, 10, 8)
+ABSENT = date(2026, 1, 5)
+
+
+def _anomalie(cle: str, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=cle,
+        entite="ENT-A",
+        gravite=Gravite.majeure,
+        phase=Phase.recette,
+        domaine="",
+        statut=statut,
+        age_jours_ouvres=1,
+    )
+
+
+ANOMALIES = (
+    _anomalie("A-1", StatutAnomalie.en_cours),
+    _anomalie("A-2", StatutAnomalie.en_analyse),
+    _anomalie("A-3", StatutAnomalie.en_cours),
+    _anomalie("A-4", StatutAnomalie.en_cours),
+)
+
+
+class _Factice:
+    """Consultation factice : seules les lectures des outils sont servies."""
+
+    def __init__(self, dates: tuple[date, ...] = (AUTRE_JOUR, JOUR)) -> None:
+        self.dates = dates
+        self.appels: list[dict[str, Any]] = []
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self.dates
+
+    def manifeste(self) -> Any:
+        return SimpleNamespace(date_arrete=JOUR)
+
+    def meteo(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        return ()
+
+    def evolution_meteo(self, date_arrete: date | None = None) -> tuple[()]:
+        return ()
+
+    def previsions(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        return ()
+
+    def risques(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        return ()
+
+    def tendances(self, entite: str | None = None, code_kpi: str | None = None) -> pl.DataFrame:
+        return pl.DataFrame(
+            {
+                "date": [JOUR],
+                "perimetre": ["ENT-A"],
+                "code_kpi": ["K1"],
+                "dimension": [""],
+                "numerateur": [1],
+                "denominateur": [4],
+                "extra": ["ignoré"],
+            }
+        )
+
+    def anomalies(self, date_arrete: date | None = None, **filtres: Any) -> Any:
+        self.appels.append({"date_arrete": date_arrete, **filtres})
+        limite = filtres.get("limite")
+        retenues = ANOMALIES if limite is None else ANOMALIES[:limite]
+        return ResultatListAnomalies(
+            date_arrete=date_arrete or JOUR, anomalies=retenues, total=len(ANOMALIES)
+        )
+
+
+def _outils(factice: _Factice) -> dict[str, Any]:
+    consultation = cast(Consultation, factice)
+    return {o.nom: o for o in outils_consultation(consultation)}
+
+
+def test_noms_exacts_et_classes_de_contrats() -> None:
+    definitions = outils_consultation(cast(Consultation, _Factice()))
+    assert tuple(o.nom for o in definitions) == NOMS_OUTILS
+    assert set(NOMS_OUTILS) == {
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    }
+    for outil in definitions:
+        assert outil.description
+        assert issubclass(outil.arguments, Enregistrement)
+        assert outil.arguments.__module__ == contrats_agent.__name__
+
+
+def test_resultats_annotes_par_des_classes_de_contrats() -> None:
+    for nom in NOMS_OUTILS:
+        retour = inspect.signature(getattr(OutilsConsultation, nom)).return_annotation
+        assert "Resultat" in str(retour)
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_date_sans_passage(nom: str) -> None:
+    resultat = _outils(_Factice())[nom].executer({"date_arrete": ABSENT.isoformat()})
+    assert resultat == AucuneDonnee(date_arrete=ABSENT)
+    assert resultat.message == "aucune donnée pour cette date"
+
+
+@pytest.mark.parametrize("nom", ["get_meteo", "list_anomalies", "get_prevision", "get_risques"])
+def test_aucune_date_du_tout(nom: str) -> None:
+    resultat = _outils(_Factice(dates=()))[nom].executer({})
+    assert resultat == AucuneDonnee(date_arrete=None)
+
+
+def test_date_absente_prend_celle_du_manifeste() -> None:
+    outils = _outils(_Factice())
+    assert outils["get_meteo"].executer({}) == ResultatGetMeteo(
+        date_arrete=JOUR, meteos=(), evolutions=()
+    )
+    assert outils["get_prevision"].executer({}) == ResultatGetPrevision(
+        date_arrete=JOUR, previsions=()
+    )
+    assert outils["get_risques"].executer({}) == ResultatGetRisques(date_arrete=JOUR, risques=())
+
+
+def test_date_disponible() -> None:
+    resultat = _outils(_Factice())["get_risques"].executer({"date_arrete": AUTRE_JOUR})
+    assert resultat.date_arrete == AUTRE_JOUR
+
+
+def test_filtre_statut_et_limite() -> None:
+    factice = _Factice()
+    resultat = _outils(factice)["list_anomalies"].executer({"statut": "en_cours", "limite": 2})
+    assert [a.cle_ticket for a in resultat.anomalies] == ["A-1", "A-3"]
+    assert resultat.total == 3
+    assert factice.appels[0]["limite"] is None
+
+
+def test_sans_statut_la_limite_est_deleguee() -> None:
+    factice = _Factice()
+    resultat = _outils(factice)["list_anomalies"].executer({"limite": 2})
+    assert len(resultat.anomalies) == 2
+    assert factice.appels[0]["limite"] == 2
+
+
+def test_tendance_sans_date() -> None:
+    resultat = _outils(_Factice(dates=()))["get_tendance"].executer({})
+    assert resultat == ResultatGetTendance(
+        points=(
+            PointTendance(
+                date=JOUR,
+                perimetre="ENT-A",
+                code_kpi="K1",
+                dimension="",
+                numerateur=1,
+                denominateur=4,
+            ),
+        )
+    )
+
+
+def test_arguments_invalides() -> None:
+    with pytest.raises(ValidationError):
+        _outils(_Factice())["list_anomalies"].executer({"limite": 0})
+    with pytest.raises(ValidationError):
+        _outils(_Factice())["get_meteo"].executer({"inconnu": 1})
+
+
+# --- Lecture seule -----------------------------------------------------------------------
+
+_VERBES_ECRITURE = ("write", "create", "update", "delete", "send", "post", "set_", "save", "comment")
+_INTERDITS = (
+    "usine.ports.source_tickets",
+    "usine.ports.entrepot",
+    "usine.ports.etape",
+    "usine.ports.fournisseur_llm",
+    "usine.ports.cache_llm",
+    "usine.adaptateurs",
+    "pydantic_ai",
+    "httpx",
+)
+
+
+def test_aucun_verbe_d_ecriture() -> None:
+    for nom in NOMS_OUTILS:
+        assert nom.startswith(("get_", "list_"))
+        assert not any(verbe in nom for verbe in _VERBES_ECRITURE)
+
+
+def _imports(chemin: Path) -> set[str]:
+    modules: set[str] = set()
+    for noeud in ast.walk(ast.parse(chemin.read_text(encoding="utf-8"))):
+        if isinstance(noeud, ast.Import):
+            modules.update(a.name for a in noeud.names)
+        elif isinstance(noeud, ast.ImportFrom) and noeud.module:
+            modules.add(noeud.module)
+            modules.update(f"{noeud.module}.{a.name}" for a in noeud.names)
+    return modules
+
+
+def test_modules_de_l_agent_sans_port_ecriture_ni_jira() -> None:
+    racine = Path(cast(list[str], usine.ia.agent.__path__)[0])
+    for chemin in racine.glob("*.py"):
+        if chemin.name == "cli.py":
+            continue
+        for module in _imports(chemin):
+            assert not module.startswith(_INTERDITS), f"{chemin.name} importe {module}"
+
+
+def test_outils_sans_acces_a_url_ticket_ni_source() -> None:
+    source = inspect.getsource(usine.ia.agent.outils)
+    assert "url_ticket" not in source
+    assert "SourceTickets" not in source
+
+
+# --- Intégration -------------------------------------------------------------------------
+
+
+def test_integration_passage_palier_2() -> None:
+    cas = passage_palier_2()
+    outils = _outils(cast(Any, SimpleNamespace()))  # définitions indépendantes de l'instance
+    assert set(outils) == set(NOMS_OUTILS)
+    reel = {o.nom: o for o in outils_consultation(cas.consultation)}
+    jour = cas.consultation.manifeste().date_arrete
+
+    meteo = reel["get_meteo"].executer({"entite": cas.entite})
+    assert isinstance(meteo, ResultatGetMeteo)
+    assert meteo.date_arrete == jour
+    assert all(m.entite == cas.entite for m in meteo.meteos)
+
+    anomalies = reel["list_anomalies"].executer({"date_arrete": jour, "limite": 1})
+    assert isinstance(anomalies, ResultatListAnomalies)
+    assert len(anomalies.anomalies) <= 1
+
+    previsions = reel["get_prevision"].executer({"entite": cas.entite})
+    assert isinstance(previsions, ResultatGetPrevision)
+    assert previsions.previsions
+
+    risques = reel["get_risques"].executer({})
+    assert isinstance(risques, ResultatGetRisques)
+    assert risques.risques
+
+    assert isinstance(reel["get_tendance"].executer({}), ResultatGetTendance)
+    assert reel["get_meteo"].executer({"date_arrete": ABSENT}) == AucuneDonnee(date_arrete=ABSENT)
