+def test_adaptateurs_jira_sans_cause_racine() -> None:
+    adaptateurs = Path(usine.__file__).parent / "adaptateurs"
+    fichiers = [*adaptateurs.glob("jira_*.py"), adaptateurs / "composite.py"]
+    assert len(fichiers) >= 2
