@@ -0,0 +1,305 @@
+"""Tâche `classification` : Cause racine proposée par Anomalie, incrémentale par le cache (FR-35)."""
+
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+from typing import cast
+
+import polars as pl
+import pytest
+
+import usine
+from tests.doublures.fournisseur_factice import FournisseurFactice
+from tests.unit.ia.espions import (
+    DATE_ARRETE,
+    NUMERO_COMPTE,
+    PASSAGE_ID,
+    CacheMemoire,
+    horloge_espion,
+    jeton_compte,
+    pseudonymiseur,
+    textes,
+)
+from usine.contrats.config import ConfigChaine, ConfigUsine
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.llm import (
+    ReponseClassification,
+    ReponseExplication,
+    StatutControle,
+)
+from usine.contrats.passage import ContextePassage, StatutEtape
+from usine.contrats.tickets import CauseRacine
+from usine.contrats.versions import version_prompt
+from usine.ia.classification import (
+    PART_PLAFOND_CLASSIFICATION,
+    ContexteClassification,
+    EtapeClassification,
+    classer,
+    lire_prompt,
+    rendre_prompt,
+)
+from usine.ia.explication import ContexteExplication
+from usine.ia.explication import lire_prompt as lire_prompt_explication
+from usine.ia.passerelle import Passerelle
+from usine.ports.consultation import Consultation
+
+AUTRE_DATE = date(2026, 10, 16)
+
+
+def _contexte(plafond: Decimal | None = None) -> ContexteClassification:
+    return ContexteClassification(
+        passage_id=PASSAGE_ID,
+        version_donnees="d" * 64,
+        gabarit=lire_prompt(),
+        version_grille="grille123456",
+        plafond_eur=plafond,
+    )
+
+
+def _reponse(cause: CauseRacine = CauseRacine.parametrage, justification: str = "") -> object:
+    return ReponseClassification(cause_racine=cause, justification=justification)
+
+
+def _passerelle(
+    factice: FournisseurFactice, cache: CacheMemoire | None = None, **options: object
+) -> Passerelle:
+    return Passerelle(
+        factice,
+        pseudonymiseur(),
+        cache if cache is not None else CacheMemoire(),
+        horloge_espion([]),
+        **options,  # type: ignore[arg-type]
+    )
+
+
+TROIS = {"DEMO-1": ("T1", "D1"), "DEMO-2": ("T2", "D2"), "DEMO-10": ("T10", "D10")}
+
+
+def test_premier_passage_un_appel_par_anomalie_trie_par_cle() -> None:
+    factice = FournisseurFactice([_reponse(CauseRacine.reprise_donnees)] * 3)
+    sorties, traces = classer(
+        _passerelle(factice), textes(dict(reversed(TROIS.items()))), DATE_ARRETE, _contexte()
+    )
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert {s.cause_racine for s in sorties} == {CauseRacine.reprise_donnees}
+    assert {s.statut_controle for s in sorties} == {StatutControle.conforme}
+    assert len(factice.appels) == 3
+    assert [t.cible for t in traces] == ["DEMO-1", "DEMO-2", "DEMO-10"]
+    assert not any(t.depuis_cache for t in traces)
+
+
+def test_rejeu_autre_date_arrete_sans_appel() -> None:
+    cache = CacheMemoire()
+    premier = FournisseurFactice([_reponse()] * 3)
+    avant, _ = classer(_passerelle(premier, cache), textes(TROIS), DATE_ARRETE, _contexte())
+    rejeu = FournisseurFactice()
+    apres, traces = classer(_passerelle(rejeu, cache), textes(TROIS), AUTRE_DATE, _contexte())
+    assert rejeu.appels == []
+    assert apres == avant
+    assert all(t.depuis_cache for t in traces)
+
+
+def test_incremental_nouvelle_et_modifiee() -> None:
+    cache = CacheMemoire()
+    classer(
+        _passerelle(FournisseurFactice([_reponse()] * 2), cache),
+        textes({"DEMO-1": ("T1", "D1"), "DEMO-2": ("T2", "D2")}),
+        DATE_ARRETE,
+        _contexte(),
+    )
+    factice = FournisseurFactice([_reponse(CauseRacine.environnement)] * 2)
+    sorties, traces = classer(
+        _passerelle(factice, cache),
+        textes({"DEMO-1": ("T1", "D1"), "DEMO-2": ("T2", "D2 modifiée"), "DEMO-3": ("T3", "D3")}),
+        AUTRE_DATE,
+        _contexte(),
+    )
+    assert len(factice.appels) == 2
+    assert [t.depuis_cache for t in traces] == [True, False, False]
+    assert [s.cause_racine for s in sorties] == [
+        CauseRacine.parametrage,
+        CauseRacine.environnement,
+        CauseRacine.environnement,
+    ]
+
+
+def test_hors_anomalie_ignore() -> None:
+    table = pl.concat(
+        [
+            textes({"DEMO-1": ("T1", "D1")}),
+            textes({"DEMO-2": ("T2", "D2")}).with_columns(
+                pl.lit("cas_de_test").alias("type_ticket")
+            ),
+            textes({"DEMO-3": ("T3", "D3")}).with_columns(
+                pl.lit("certification").alias("type_ticket")
+            ),
+        ]
+    )
+    factice = FournisseurFactice([_reponse()])
+    sorties, _ = classer(_passerelle(factice), table, DATE_ARRETE, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1"]
+    assert len(factice.appels) == 1
+
+
+def test_aucune_anomalie() -> None:
+    factice = FournisseurFactice()
+    sorties, traces = classer(_passerelle(factice), textes({}), DATE_ARRETE, _contexte())
+    assert (sorties, traces, factice.appels) == ((), (), [])
+
+
+def test_plafond_atteint_anomalie_non_classee() -> None:
+    factice = FournisseurFactice([_reponse()] * 3)
+    passerelle = _passerelle(
+        factice, tarif=lambda *_: Decimal("1"), plafond_cout_passage_eur=Decimal("1")
+    )
+    sorties, traces = classer(passerelle, textes(TROIS), DATE_ARRETE, _contexte())
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1"]
+    assert len(traces) == 1
+    assert len(factice.appels) == 1
+
+
+def test_part_du_plafond_refuse_l_appel_frais_mais_sert_le_cache() -> None:
+    cache = CacheMemoire()
+    classer(
+        _passerelle(FournisseurFactice([_reponse()]), cache),
+        textes({"DEMO-1": ("T1", "D1")}),
+        DATE_ARRETE,
+        _contexte(),
+    )
+    factice = FournisseurFactice([_reponse()] * 3)
+    passerelle = _passerelle(
+        factice, cache, tarif=lambda *_: Decimal("1"), plafond_cout_passage_eur=Decimal("10")
+    )
+    sorties, traces = classer(
+        passerelle,
+        textes({"DEMO-1": ("T1", "D1"), "DEMO-2": ("T2", "D2"), "DEMO-3": ("T3", "D3")}),
+        DATE_ARRETE,
+        _contexte(Decimal("1")),
+    )
+    assert [s.cle_ticket for s in sorties] == ["DEMO-1", "DEMO-2"]
+    assert [t.depuis_cache for t in traces] == [True, False]
+    assert len(factice.appels) == 1
