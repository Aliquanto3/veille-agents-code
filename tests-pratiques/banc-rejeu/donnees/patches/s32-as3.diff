+"""KPI quotidiens par Entité et pour le Programme : stocks, flux, âges, taux, Certifications.
+
+Fonctions pures (FR-11, AD-9) : les Entités arrivent en paramètre, le temps vient de
+`contrats.calendrier` (AD-17). Tout est en entiers : un compte vaut `n/1`, un taux est porté en
+`numerateur` / `denominateur` (AD-10), et `0/0` signifie « pas de valeur ».
+"""
+
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass, replace
+from datetime import date
+from fractions import Fraction
+
+import polars as pl
+
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import fenetre_glissante, jour_ouvre_precedent, jours_ouvres
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import (
+    SCHEMA_TICKET_ETAT,
+    STATUTS_FERMES,
+    Gravite,
+    Phase,
+    StatutCertification,
+    StatutTest,
+    TypeTicket,
+)
+
+CODES_KPI: tuple[str, ...] = (
+    "anomalies_ouvertes",
+    "anomalies_ouvertes_gravite",
+    "anomalies_ouvertes_phase",
+    "entrees_jour",
+    "sorties_jour",
+    "entrees_fenetre",
+    "sorties_fenetre",
+    "age_median_anomalies_ouvertes",
+    "age_max_anomalies_ouvertes",
+    "taux_ko_cas_de_test",
+    "taux_non_execution_cas_de_test",
+    "certifications",
+)
+"""Catalogue des `code_kpi`, dans l'ordre de sortie."""
+
+_GRAVITES = tuple(g.value for g in Gravite)
+_PHASES = tuple(p.value for p in Phase)
+_CERTIFICATIONS = tuple(s.value for s in StatutCertification)
+
+DIMENSIONS_KPI: Mapping[str, tuple[str, ...]] = {
+    "anomalies_ouvertes": ("",),
+    "anomalies_ouvertes_gravite": _GRAVITES,
+    "anomalies_ouvertes_phase": _PHASES,
+    "entrees_jour": ("",),
+    "sorties_jour": ("",),
+    "entrees_fenetre": ("",),
+    "sorties_fenetre": ("",),
+    "age_median_anomalies_ouvertes": ("",),
+    "age_max_anomalies_ouvertes": ("",),
+    "taux_ko_cas_de_test": _PHASES,
+    "taux_non_execution_cas_de_test": _PHASES,
+    "certifications": _CERTIFICATIONS,
+}
+"""Dimensions de chaque `code_kpi` ; `""` quand le KPI n'est pas ventilé."""
+
+_FERMES = frozenset(s.value for s in STATUTS_FERMES)
+
+Mesure = tuple[int, int]
+
+
+@dataclass(frozen=True)
+class _Ticket:
+    """État d'un ticket à une date, avec ses mouvements du jour (Anomalies)."""
+
+    entite: str | None
+    type_ticket: str
+    gravite: str | None
+    phase: str | None
+    statut: str | None
+    statut_test: str | None
+    statut_certification: str | None
+    derniere_entree: date | None
+    entree: int
+    sortie: int
+
+    @property
+    def ouvert(self) -> bool:
+        return (
+            self.type_ticket == TypeTicket.anomalie.value
+            and self.statut is not None
+            and self.statut not in _FERMES
+        )
+
+
+def _verifier_entites(entites: Sequence[str]) -> None:
+    doublons = sorted({e for e in entites if list(entites).count(e) > 1})
+    if doublons:
+        raise UsineErreur(f"Entités demandées en double : {', '.join(doublons)}")
+    if PERIMETRE_PROGRAMME in entites:
+        raise UsineErreur(
+            f"Entité {PERIMETRE_PROGRAMME} réservée au périmètre du Programme : "
+            "valeur refusée parmi les Entités demandées"
+        )
+
+
+def _verifier_dates(dates: Sequence[date]) -> None:
+    """Chaque Jour ouvré de la première à la dernière date doit être présent."""
+    attendues = jours_ouvres(dates[0], dates[-1])
+    presentes = set(dates)
+    manquantes = [jour for jour in attendues if jour not in presentes]
+    if manquantes:
+        raise UsineErreur(
+            "États des tickets non calculés pour : "
+            + ", ".join(jour.isoformat() for jour in manquantes)
+        )
+    autres = sorted(presentes - set(attendues))
+    if autres:
+        raise UsineErreur(
+            "États des tickets à une date qui n'est pas un Jour ouvré : "
+            + ", ".join(jour.isoformat() for jour in autres)
+        )
+
+
+def _tickets_du_jour(lignes: pl.DataFrame, jour: date, veille: Mapping[str, bool]) -> list[_Ticket]:
+    """Tickets du jour avec Entrée (`date_derniere_entree == jour`) et Sortie (E − δ)."""
+    tickets: list[_Ticket] = []
+    for ligne in lignes.with_columns(
+        pl.col(c).cast(pl.Utf8)
+        for c in ("type_ticket", "gravite", "phase", "statut", "statut_test", "statut_certification")
+    ).iter_rows(named=True):
+        brut = _Ticket(
+            entite=ligne["entite"],
+            type_ticket=ligne["type_ticket"],
+            gravite=ligne["gravite"],
+            phase=ligne["phase"],
+            statut=ligne["statut"],
+            statut_test=ligne["statut_test"],
+            statut_certification=ligne["statut_certification"],
+            derniere_entree=ligne["date_derniere_entree"],
+            entree=0,
+            sortie=0,
+        )
+        if brut.type_ticket == TypeTicket.anomalie.value:
+            entree = int(brut.derniere_entree == jour)
+            delta = int(brut.ouvert) - int(veille.get(ligne["cle_ticket"], False))
+            brut = replace(brut, entree=entree, sortie=entree - delta)
+        tickets.append(brut)
+    return tickets
+
+
+def _age(entree: date, jour: date) -> int:
+    return len(jours_ouvres(entree, jour)) - 1
+
+
+def _fraction(valeur: Fraction) -> Mesure:
+    return valeur.numerator, valeur.denominator
+
+
+def _ages(ouvertes: Sequence[_Ticket], jour: date) -> list[int]:
+    ages: list[int] = []
+    for ticket in ouvertes:
+        if ticket.derniere_entree is None:
+            raise UsineErreur(
+                f"Anomalie ouverte sans date de dernière Entrée au {jour.isoformat()}"
+            )
+        ages.append(_age(ticket.derniere_entree, jour))
+    return sorted(ages)
+
+
+def _mediane(ages: Sequence[int]) -> Mesure:
+    if not ages:
+        return 0, 0
+    milieu = len(ages) // 2
+    if len(ages) % 2:
+        return ages[milieu], 1
+    return _fraction(Fraction(ages[milieu - 1] + ages[milieu], 2))
+
+
+def _mesures_statiques(tickets: Sequence[_Ticket], jour: date) -> dict[tuple[str, str], Mesure]:
+    """Mesures du jour qui ne dépendent pas de la Fenêtre glissante."""
+    ouvertes = [t for t in tickets if t.ouvert]
+    ages = _ages(ouvertes, jour)
+    mesures: dict[tuple[str, str], Mesure] = {
+        ("anomalies_ouvertes", ""): (len(ouvertes), 1),
+        ("entrees_jour", ""): (sum(t.entree for t in tickets), 1),
+        ("sorties_jour", ""): (sum(t.sortie for t in tickets), 1),
+        ("age_median_anomalies_ouvertes", ""): _mediane(ages),
+        ("age_max_anomalies_ouvertes", ""): (ages[-1], 1) if ages else (0, 0),
+    }
+    for gravite in _GRAVITES:
+        mesures["anomalies_ouvertes_gravite", gravite] = (
+            sum(t.gravite == gravite for t in ouvertes),
+            1,
+        )
+    for phase in _PHASES:
+        mesures["anomalies_ouvertes_phase", phase] = (sum(t.phase == phase for t in ouvertes), 1)
+        tests = [
+            t
+            for t in tickets
+            if t.type_ticket == TypeTicket.cas_de_test.value and t.phase == phase
+        ]
+        ok = sum(t.statut_test == StatutTest.ok.value for t in tests)
+        ko = sum(t.statut_test == StatutTest.ko.value for t in tests)
+        non_executes = sum(t.statut_test == StatutTest.non_execute.value for t in tests)
+        mesures["taux_ko_cas_de_test", phase] = (ko, ok + ko)
+        mesures["taux_non_execution_cas_de_test", phase] = (non_executes, ok + ko + non_executes)
+    for statut in _CERTIFICATIONS:
+        mesures["certifications", statut] = (
+            sum(
+                t.type_ticket == TypeTicket.certification.value
+                and t.statut_certification == statut
+                for t in tickets
+            ),
+            1,
+        )
+    return mesures
+
+
+def kpi(tickets_etats: pl.DataFrame, entites: Sequence[str]) -> pl.DataFrame:
+    """`SCHEMA_KPI` : les douze codes du catalogue, par Jour ouvré, Entité et Programme.
+
+    Sortie dense (zéro explicite), triée par date, périmètre (ordre de `entites`, puis
+    `PROGRAMME`), code (ordre de `CODES_KPI`) et dimension. Le Programme couvre toutes les lignes
+    de la table, y compris des Entités hors de `entites`.
+
+    Précondition : `tickets_etats` couvre chaque Jour ouvré de sa première à sa dernière date,
+    sinon erreur ; à la première date, la veille est vide (début de l'historique).
+    """
+    _verifier_entites(entites)
+    etats = valider(tickets_etats, SCHEMA_TICKET_ETAT)
+    perimetres = [*entites, PERIMETRE_PROGRAMME]
+    if etats.is_empty():
+        return valider(pl.DataFrame(schema=dict(SCHEMA_KPI.colonnes)), SCHEMA_KPI)
+    dates = sorted(etats.get_column("date").unique().to_list())
+    _verifier_dates(dates)
+
+    par_jour = etats.partition_by("date", as_dict=True, maintain_order=True)
+    statiques: dict[date, dict[str, dict[tuple[str, str], Mesure]]] = {}
+    ouverts: dict[date, dict[str, bool]] = {}
+    for jour in dates:
+        lignes = par_jour[(jour,)]
+        tickets = _tickets_du_jour(lignes, jour, ouverts.get(jour_ouvre_precedent(jour), {}))
+        statiques[jour] = {
+            perimetre: _mesures_statiques(
+                tickets
+                if perimetre == PERIMETRE_PROGRAMME
+                else [t for t in tickets if t.entite == perimetre],
+                jour,
+            )
+            for perimetre in perimetres
+        }
+        ouverts[jour] = {
+            cle: ticket.ouvert
+            for cle, ticket in zip(lignes.get_column("cle_ticket"), tickets, strict=True)
+        }
+
+    colonnes: dict[str, list[object]] = {nom: [] for nom in SCHEMA_KPI.colonnes}
+    for jour in dates:
+        fenetre = fenetre_glissante(jour)
+        for perimetre in perimetres:
+            mesures = dict(statiques[jour][perimetre])
+            for code, base in (("entrees_fenetre", "entrees_jour"), ("sorties_fenetre", "sorties_jour")):
+                mesures[code, ""] = (
+                    sum(
+                        statiques[j][perimetre][base, ""][0] for j in fenetre if j in statiques
+                    ),
+                    1,
+                )
+            for code in CODES_KPI:
+                for dimension in DIMENSIONS_KPI[code]:
+                    numerateur, denominateur = mesures[code, dimension]
+                    colonnes["date"].append(jour)
+                    colonnes["perimetre"].append(perimetre)
+                    colonnes["code_kpi"].append(code)
+                    colonnes["dimension"].append(dimension)
+                    colonnes["numerateur"].append(numerateur)
+                    colonnes["denominateur"].append(denominateur)
+    table = pl.DataFrame(colonnes, schema=dict(SCHEMA_KPI.colonnes))
+    return valider(table, SCHEMA_KPI)
