+"""KPI quotidiens par Entité et pour le Programme (Story 3.2, FR-11, AD-10)."""
+
+from datetime import UTC, date, datetime
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from tests.unit.domaine.constructeur import Flux
+from usine.config import charger_yaml
+from usine.contrats.calcul import PERIMETRE_PROGRAMME, SCHEMA_KPI
+from usine.contrats.calendrier import jours_ouvres
+from usine.contrats.config import ConfigProgramme
+from usine.contrats.erreurs import UsineErreur
+from usine.contrats.schemas import valider
+from usine.contrats.tickets import STATUTS_FERMES, Champ, TypeTicket
+from usine.domaine.instantanes import instantane, tickets_etats
+from usine.domaine.kpi import CODES_KPI, DIMENSIONS_KPI, kpi
+from usine.generateur.journal import Generation, generer
+
+RACINE = Path(__file__).resolve().parents[3]
+ENTITES = ["ENT-A", "ENT-B"]
+Mesure = tuple[int, int]
+
+
+def _ts(jour: int, heure: int = 9) -> datetime:
+    return datetime(2026, 10, jour, heure, tzinfo=UTC)
+
+
+def _kpi(flux: Flux, premier: int, dernier: int, entites: list[str] | None = None) -> pl.DataFrame:
+    jours = jours_ouvres(date(2026, 10, premier), date(2026, 10, dernier))
+    return kpi(tickets_etats(flux.evenements, jours), ENTITES if entites is None else entites)
+
+
+def _val(table: pl.DataFrame, jour: int, perimetre: str, code: str, dimension: str = "") -> Mesure:
+    ligne = table.filter(
+        (pl.col("date") == date(2026, 10, jour))
+        & (pl.col("perimetre") == perimetre)
+        & (pl.col("code_kpi") == code)
+        & (pl.col("dimension") == dimension)
+    )
+    assert ligne.height == 1
+    return ligne["numerateur"][0], ligne["denominateur"][0]
+
+
+def test_stock() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), entite="ENT-A")
+    flux.anomalie("DEMO-2", _ts(5), entite="ENT-A")
+    flux.anomalie("DEMO-3", _ts(5), entite="ENT-B", gravite="majeure", statut="fermee")
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes") == (2, 1)
+    assert _val(table, 5, "ENT-B", "anomalies_ouvertes") == (0, 1)
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    code = "anomalies_ouvertes_gravite"
+    assert _val(table, 5, PERIMETRE_PROGRAMME, code, "bloquante") == (2, 1)
+    assert _val(table, 5, PERIMETRE_PROGRAMME, code, "majeure") == (0, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes_phase", "recette") == (2, 1)
+
+
+def test_flux_du_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    flux.transition("DEMO-1", _ts(6), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(7, 9), "fermee", "en_analyse")
+    flux.transition("DEMO-1", _ts(7, 10), "en_analyse", "fermee")
+    table = _kpi(flux, 5, 7)
+    assert [_val(table, j, "ENT-A", "entrees_jour")[0] for j in (5, 6, 7)] == [1, 0, 1]
+    assert [_val(table, j, "ENT-A", "sorties_jour")[0] for j in (5, 6, 7)] == [0, 1, 1]
+
+
+def test_creee_et_fermee_le_meme_jour() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "entrees_jour") == (1, 1)
+    assert _val(table, 5, "ENT-A", "sorties_jour") == (1, 1)
+
+
+def test_fenetre_glissante() -> None:
+    flux = Flux()
+    for rang, jour in enumerate((1, 2, 5, 6, 7, 8, 9), start=1):
+        flux.anomalie(f"DEMO-{rang}", _ts(jour))
+    flux.transition("DEMO-1", _ts(9), "nouvelle", "fermee")
+    table = _kpi(flux, 1, 9)
+    assert _val(table, 1, "ENT-A", "entrees_fenetre") == (1, 1)
+    assert _val(table, 2, "ENT-A", "entrees_fenetre") == (2, 1)
+    assert _val(table, 9, "ENT-A", "entrees_fenetre") == (5, 1)
+    assert _val(table, 9, "ENT-A", "sorties_fenetre") == (1, 1)
+    assert _val(table, 8, "ENT-A", "sorties_fenetre") == (0, 1)
+
+
+def test_age_median_et_maximum() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.anomalie("DEMO-2", _ts(2))
+    table = _kpi(flux, 1, 7)
+    assert _val(table, 7, "ENT-A", "age_median_anomalies_ouvertes") == (7, 2)
+    assert _val(table, 7, "ENT-A", "age_max_anomalies_ouvertes") == (4, 1)
+    assert _val(table, 1, "ENT-A", "age_max_anomalies_ouvertes") == (0, 1)
+
+
+def test_age_part_de_la_reouverture() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(1))
+    flux.transition("DEMO-1", _ts(5), "nouvelle", "fermee")
+    flux.transition("DEMO-1", _ts(8), "fermee", "en_analyse")
+    table = _kpi(flux, 1, 9)
+    assert _val(table, 9, "ENT-A", "age_max_anomalies_ouvertes") == (1, 1)
+    assert _val(table, 9, "ENT-A", "age_median_anomalies_ouvertes") == (1, 1)
+
+
+def test_aucune_ouverte() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), statut="fermee")
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "age_median_anomalies_ouvertes") == (0, 0)
+    assert _val(table, 5, "ENT-A", "age_max_anomalies_ouvertes") == (0, 0)
+    assert _val(table, 5, "ENT-B", "age_max_anomalies_ouvertes") == (0, 0)
+
+
+def test_taux() -> None:
+    flux = Flux()
+    for rang, statut in enumerate(("ok", "ok", "ok", "ko", "non_execute", "non_execute")):
+        flux.creer(
+            f"DEMO-{rang + 1}",
+            TypeTicket.cas_de_test,
+            _ts(5),
+            {Champ.statut_test: statut, Champ.entite: "ENT-A", Champ.phase: "recette"},
+        )
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "taux_ko_cas_de_test", "recette") == (1, 4)
+    assert _val(table, 5, "ENT-A", "taux_non_execution_cas_de_test", "recette") == (2, 6)
+    assert _val(table, 5, "ENT-A", "taux_ko_cas_de_test", "tnr") == (0, 0)
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "taux_non_execution_cas_de_test", "tnr") == (0, 0)
+
+
+def test_certifications() -> None:
+    flux = Flux()
+    for rang, statut in enumerate(("accordee", "reservee", "reservee"), start=1):
+        flux.creer(
+            f"DEMO-{rang}",
+            TypeTicket.certification,
+            _ts(5),
+            {Champ.statut_certification: statut, Champ.entite: "ENT-A"},
+        )
+    table = _kpi(flux, 5, 5)
+    assert _val(table, 5, "ENT-A", "certifications", "accordee") == (1, 1)
+    assert _val(table, 5, "ENT-A", "certifications", "reservee") == (2, 1)
+    assert _val(table, 5, "ENT-A", "certifications", "refusee") == (0, 1)
+
+
+def test_trou_de_dates() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    etats = tickets_etats(flux.evenements, [date(2026, 10, 5), date(2026, 10, 7)])
+    with pytest.raises(UsineErreur, match="2026-10-06"):
+        kpi(etats, ENTITES)
+
+
+def test_entites_invalides() -> None:
+    etats = tickets_etats([], [])
+    with pytest.raises(UsineErreur, match="ENT-A"):
+        kpi(etats, ["ENT-A", "ENT-A"])
+    with pytest.raises(UsineErreur, match=PERIMETRE_PROGRAMME):
+        kpi(etats, ["ENT-A", PERIMETRE_PROGRAMME])
+
+
+def test_table_vide() -> None:
+    table = kpi(tickets_etats([], []), ENTITES)
+    assert table.is_empty()
+    assert table.schema == pl.Schema(dict(SCHEMA_KPI.colonnes))
+
+
+def test_schema_dense_et_sans_flottant() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5))
+    table = _kpi(flux, 5, 6)
+    valider(table, SCHEMA_KPI)
+    assert not any(t.is_float() for t in table.schema.values())
+    par_perimetre = sum(len(dims) for dims in DIMENSIONS_KPI.values())
+    assert table.height == 2 * (len(ENTITES) + 1) * par_perimetre
+    assert tuple(dict.fromkeys(table["code_kpi"])) == CODES_KPI
+    assert table["perimetre"].head(1).to_list() == ["ENT-A"]
+
+
+def test_programme_inclut_les_entites_hors_liste() -> None:
+    flux = Flux()
+    flux.anomalie("DEMO-1", _ts(5), entite="ENT-A")
+    flux.anomalie("DEMO-2", _ts(5), entite="ENT-C")
+    table = _kpi(flux, 5, 5, ["ENT-A"])
+    assert _val(table, 5, PERIMETRE_PROGRAMME, "anomalies_ouvertes") == (2, 1)
+    assert _val(table, 5, "ENT-A", "anomalies_ouvertes") == (1, 1)
+
+
+@pytest.fixture(scope="module")
+def generation() -> Generation:
+    config = charger_yaml(RACINE / "config" / "programme.yaml", ConfigProgramme)
+    return generer(config, 42, date(2026, 10, 12))
+
+
+def test_journal_genere(generation: Generation) -> None:
+    entete = generation.entete
+    jours = jours_ouvres(entete.ancrage_semaines, entete.date_injection)
+    etats = tickets_etats(generation.evenements, jours)
+    entites = sorted(set(etats["entite"].drop_nulls()))
+    table = kpi(etats, entites)
+    assert table.equals(kpi(etats, entites))
+
