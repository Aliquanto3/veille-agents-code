@@ -0,0 +1,166 @@
+"""Outils de consultation de l'Agent, en lecture seule, servis par `Consultation` (FR-39, FR-41).
+
+Chaque outil prend un `Arguments*` de `contrats.agent` et rend un `Resultat*`, ou `AucuneDonnee`
+quand le Passage ne couvre pas la Date d'arrêté demandée. Aucun chiffre n'est calculé ici : les
+filtres ne font que sélectionner des lignes. La sérialisation en texte et la Pseudonymisation
+reviennent à la passerelle (Story 7.9).
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import date
+from typing import Any
+
+from usine.contrats.agent import (
+    ArgumentsGetMeteo,
+    ArgumentsGetPrevision,
+    ArgumentsGetRisques,
+    ArgumentsGetTendance,
+    ArgumentsListAnomalies,
+    AucuneDonnee,
+    PointTendance,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.ports.consultation import Consultation
+
+NOMS_OUTILS: tuple[str, ...] = (
+    "get_meteo",
+    "list_anomalies",
+    "get_tendance",
+    "get_prevision",
+    "get_risques",
+)
+"""Les cinq outils de l'Agent, tous en lecture seule."""
+
+
+@dataclass(frozen=True)
+class DefinitionOutil:
+    """Un outil : nom, description pour le modèle, classe d'arguments et exécution."""
+
+    nom: str
+    description: str
+    arguments: type[Enregistrement]
+    executer: Callable[[Mapping[str, Any]], Enregistrement]
+    """Valide les arguments JSON (`ValidationError` si invalides) puis lit la Consultation."""
+
+
+class OutilsConsultation:
+    """Les cinq outils de lecture de l'Agent sur un Passage."""
+
+    def __init__(self, consultation: Consultation) -> None:
+        self._consultation = consultation
+
+    def _jour(self, date_arrete: date | None) -> date | None:
+        """Date d'arrêté à lire, ou `None` si le Passage ne la couvre pas."""
+        disponibles = self._consultation.dates_disponibles()
+        if not disponibles:
+            return None
+        jour = (
+            date_arrete if date_arrete is not None else self._consultation.manifeste().date_arrete
+        )
+        return jour if jour in disponibles else None
+
+    def get_meteo(self, arguments: ArgumentsGetMeteo) -> ResultatGetMeteo | AucuneDonnee:
+        """Météo, Règles déclenchantes et évolution J-1 / J-5."""
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        evolutions = self._consultation.evolution_meteo(jour)
+        if arguments.entite is not None:
+            evolutions = tuple(e for e in evolutions if e.entite == arguments.entite)
+        return ResultatGetMeteo(
+            date_arrete=jour,
+            meteos=self._consultation.meteo(jour, arguments.entite),
+            evolutions=evolutions,
+        )
+
+    def list_anomalies(
+        self, arguments: ArgumentsListAnomalies
+    ) -> ResultatListAnomalies | AucuneDonnee:
+        """Anomalies ouvertes filtrées (Entité, Gravité, Phase, domaine, statut)."""
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        filtres: dict[str, Any] = {
+            "entite": arguments.entite,
+            "gravite": arguments.gravite,
+            "phase": arguments.phase,
+            "domaine": arguments.domaine,
+        }
+        if arguments.statut is None:
+            return self._consultation.anomalies(jour, limite=arguments.limite, **filtres)
+        toutes = self._consultation.anomalies(jour, limite=None, **filtres)
+        retenues = tuple(a for a in toutes.anomalies if a.statut is arguments.statut)
+        return ResultatListAnomalies(
+            date_arrete=toutes.date_arrete,
+            anomalies=retenues[: arguments.limite],
+            total=len(retenues),
+        )
+
+    def get_tendance(self, arguments: ArgumentsGetTendance) -> ResultatGetTendance:
+        """Tendances hebdomadaires ; sans date, une liste vide plutôt qu'`AucuneDonnee`."""
+        table = self._consultation.tendances(arguments.entite, arguments.code_kpi)
+        lignes = table.select(list(PointTendance.model_fields)).iter_rows(named=True)
+        return ResultatGetTendance(points=tuple(PointTendance(**ligne) for ligne in lignes))
+
+    def get_prevision(
+        self, arguments: ArgumentsGetPrevision
+    ) -> ResultatGetPrevision | AucuneDonnee:
+        """Prévisions de sortie du rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetPrevision(
+            date_arrete=jour, previsions=self._consultation.previsions(jour, arguments.entite)
+        )
+
+    def get_risques(self, arguments: ArgumentsGetRisques) -> ResultatGetRisques | AucuneDonnee:
+        """Risques d'entrée en rouge."""
+        jour = self._jour(arguments.date_arrete)
+        if jour is None:
+            return AucuneDonnee(date_arrete=arguments.date_arrete)
+        return ResultatGetRisques(
+            date_arrete=jour, risques=self._consultation.risques(jour, arguments.entite)
+        )
+
+
+def outils_consultation(consultation: Consultation) -> tuple[DefinitionOutil, ...]:
+    """Définitions des cinq outils, dans l'ordre de `NOMS_OUTILS`."""
+    outils = OutilsConsultation(consultation)
+    return (
+        DefinitionOutil(
+            "get_meteo",
+            "Météo par Entité, Règles déclenchantes et évolution J-1 / J-5 à une Date d'arrêté.",
+            ArgumentsGetMeteo,
+            lambda brut: outils.get_meteo(ArgumentsGetMeteo.model_validate(brut)),
+        ),
+        DefinitionOutil(
+            "list_anomalies",
+            "Anomalies ouvertes, filtrées par Entité, Gravité, Phase, domaine et statut.",
+            ArgumentsListAnomalies,
+            lambda brut: outils.list_anomalies(ArgumentsListAnomalies.model_validate(brut)),
+        ),
+        DefinitionOutil(
+            "get_tendance",
+            "Tendances hebdomadaires des KPI, par Entité et par KPI.",
+            ArgumentsGetTendance,
+            lambda brut: outils.get_tendance(ArgumentsGetTendance.model_validate(brut)),
+        ),
+        DefinitionOutil(
+            "get_prevision",
+            "Prévisions de sortie du rouge à une Date d'arrêté.",
+            ArgumentsGetPrevision,
+            lambda brut: outils.get_prevision(ArgumentsGetPrevision.model_validate(brut)),
+        ),
+        DefinitionOutil(
+            "get_risques",
+            "Risques d'entrée en rouge à une Date d'arrêté.",
+            ArgumentsGetRisques,
+            lambda brut: outils.get_risques(ArgumentsGetRisques.model_validate(brut)),
+        ),
+    )
