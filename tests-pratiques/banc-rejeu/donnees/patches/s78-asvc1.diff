@@ -0,0 +1,282 @@
+"""Outils de consultation de l'Agent : matrice d'entrées, lecture seule, Passage réel."""
+
+import ast
+from datetime import date
+from pathlib import Path
+from typing import Any, get_args, get_type_hints
+
+import polars as pl
+import pytest
+from pydantic import ValidationError
+
+import usine.contrats.agent as contrats_agent
+from tests.contrat.consultation.fabriques import passage_palier_2
+from usine.contrats.agent import (
+    AnomalieResume,
+    AucuneDonnee,
+    ResultatGetMeteo,
+    ResultatGetPrevision,
+    ResultatGetRisques,
+    ResultatGetTendance,
+    ResultatListAnomalies,
+)
+from usine.contrats.modele import Enregistrement
+from usine.contrats.tickets import Gravite, Phase, StatutAnomalie
+from usine.ia.agent import outils as module_outils
+from usine.ia.agent.outils import NOMS_OUTILS, OutilsConsultation, outils_consultation
+
+JOUR = date(2026, 10, 12)
+AUTRE = date(2026, 10, 9)
+HORS = date(2026, 1, 5)
+MESSAGE = "aucune donnée pour cette date"
+
+
+def _anomalie(cle: str, statut: StatutAnomalie) -> AnomalieResume:
+    return AnomalieResume(
+        cle_ticket=cle,
+        entite="ENT-B",
+        gravite=Gravite.majeure,
+        phase=Phase.recette,
+        domaine="D",
+        statut=statut,
+        age_jours_ouvres=3,
+    )
+
+
+ANOMALIES = (
+    _anomalie("A-1", StatutAnomalie.en_analyse),
+    _anomalie("A-2", StatutAnomalie.nouvelle),
+    _anomalie("A-3", StatutAnomalie.en_analyse),
+    _anomalie("A-4", StatutAnomalie.en_analyse),
+)
+
+
+class _Manifeste:
+    date_arrete = JOUR
+
+
+class ConsultationFactice:
+    """Implémente les seules lectures des outils ; enregistre les dates lues."""
+
+    def __init__(self, dates: tuple[date, ...] = (AUTRE, JOUR)) -> None:
+        self.dates = dates
+        self.lues: list[date | None] = []
+
+    def dates_disponibles(self) -> tuple[date, ...]:
+        return self.dates
+
+    def manifeste(self) -> Any:
+        return _Manifeste()
+
+    def meteo(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.lues.append(date_arrete)
+        return ()
+
+    def evolution_meteo(self, date_arrete: date | None = None) -> tuple[()]:
+        return ()
+
+    def anomalies(self, date_arrete: date | None = None, **filtres: Any) -> Any:
+        self.lues.append(date_arrete)
+        limite = filtres["limite"]
+        gardees = ANOMALIES if limite is None else ANOMALIES[:limite]
+        return ResultatListAnomalies(
+            date_arrete=date_arrete or JOUR, anomalies=gardees, total=len(ANOMALIES)
+        )
+
+    def tendances(self, entite: str | None = None, code_kpi: str | None = None) -> pl.DataFrame:
+        return pl.DataFrame(
+            {
+                "date": [JOUR],
+                "perimetre": ["ENT-B"],
+                "code_kpi": ["K"],
+                "dimension": ["d"],
+                "numerateur": [1],
+                "denominateur": [2],
+                "colonne_en_trop": ["x"],
+            }
+        )
+
+    def previsions(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.lues.append(date_arrete)
+        return ()
+
+    def risques(self, date_arrete: date | None = None, entite: str | None = None) -> tuple[()]:
+        self.lues.append(date_arrete)
+        return ()
+
+
+def _outil(consultation: Any, nom: str) -> Any:
+    return next(o for o in outils_consultation(consultation) if o.nom == nom)
+
+
+OUTILS_DATES = ("get_meteo", "list_anomalies", "get_prevision", "get_risques")
+RESULTATS = {
+    "get_meteo": ResultatGetMeteo,
+    "list_anomalies": ResultatListAnomalies,
+    "get_prevision": ResultatGetPrevision,
+    "get_risques": ResultatGetRisques,
+}
+
+
+def test_noms_exacts_et_classes_des_contrats() -> None:
+    factice: Any = ConsultationFactice()
+    outils = outils_consultation(factice)
+    assert tuple(o.nom for o in outils) == NOMS_OUTILS
+    assert set(NOMS_OUTILS) == {
+        "get_meteo",
+        "list_anomalies",
+        "get_tendance",
+        "get_prevision",
+        "get_risques",
+    }
+    for outil in outils:
+        assert outil.description
+        assert outil.arguments.__module__ == contrats_agent.__name__
+        assert issubclass(outil.arguments, Enregistrement)
+
+
+@pytest.mark.parametrize("nom", NOMS_OUTILS)
+def test_resultats_issus_des_contrats(nom: str) -> None:
+    retour = get_type_hints(getattr(OutilsConsultation, nom))["return"]
+    membres = get_args(retour) or (retour,)
+    assert membres
+    for membre in membres:
+        assert membre.__module__ == contrats_agent.__name__
+
+
+@pytest.mark.parametrize("nom", OUTILS_DATES)
+def test_date_absente_prend_la_date_du_manifeste(nom: str) -> None:
+    consultation = ConsultationFactice()
+    resultat = _outil(consultation, nom).executer({})
+    assert isinstance(resultat, RESULTATS[nom])
+    assert resultat.date_arrete == JOUR
+    assert set(consultation.lues) == {JOUR}
+
+
+@pytest.mark.parametrize("nom", OUTILS_DATES)
+def test_date_disponible(nom: str) -> None:
+    resultat = _outil(ConsultationFactice(), nom).executer({"date_arrete": "2026-10-09"})
+    assert isinstance(resultat, RESULTATS[nom])
+    assert resultat.date_arrete == AUTRE
+
+
+@pytest.mark.parametrize("nom", OUTILS_DATES)
+def test_date_sans_passage(nom: str) -> None:
+    consultation = ConsultationFactice()
+    resultat = _outil(consultation, nom).executer({"date_arrete": HORS.isoformat()})
+    assert resultat == AucuneDonnee(date_arrete=HORS, message=MESSAGE)
+    assert consultation.lues == []
+
+
+@pytest.mark.parametrize("nom", OUTILS_DATES)
+def test_aucune_date_du_tout(nom: str) -> None:
+    consultation = ConsultationFactice(dates=())
+    assert _outil(consultation, nom).executer({}) == AucuneDonnee(date_arrete=None)
+    assert _outil(consultation, nom).executer({"date_arrete": "2026-10-12"}) == AucuneDonnee(
+        date_arrete=JOUR
+    )
+
+
+def test_filtre_statut_avec_limite() -> None:
+    resultat = _outil(ConsultationFactice(), "list_anomalies").executer(
+        {"statut": "en_analyse", "limite": 2}
+    )
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert [a.cle_ticket for a in resultat.anomalies] == ["A-1", "A-3"]
+    assert resultat.total == 3
+
+
+def test_sans_statut_la_limite_est_passee_au_port() -> None:
+    resultat = _outil(ConsultationFactice(), "list_anomalies").executer({"limite": 1})
+    assert isinstance(resultat, ResultatListAnomalies)
+    assert len(resultat.anomalies) == 1
+    assert resultat.total == len(ANOMALIES)
+
+
+def test_tendance_sans_date_et_liste_vide_possible() -> None:
+    resultat = _outil(ConsultationFactice(dates=()), "get_tendance").executer({})
+    assert isinstance(resultat, ResultatGetTendance)
+    assert len(resultat.points) == 1
+    assert resultat.points[0].code_kpi == "K"
+    vide = ConsultationFactice()
+    vide.tendances = lambda *_a, **_k: pl.DataFrame(  # type: ignore[method-assign]
+        schema={
+            "date": pl.Date,
+            "perimetre": pl.String,
+            "code_kpi": pl.String,
+            "dimension": pl.String,
+            "numerateur": pl.Int64,
+            "denominateur": pl.Int64,
+        }
+    )
+    assert _outil(vide, "get_tendance").executer({}) == ResultatGetTendance(points=())
+
+
+@pytest.mark.parametrize("nom", NOMS_OUTILS)
+def test_arguments_invalides(nom: str) -> None:
+    with pytest.raises(ValidationError):
+        _outil(ConsultationFactice(), nom).executer({"inconnu": 1, "limite": 0, "date_arrete": "x"})
+
+
+# --- Lecture seule ---
+
+DOSSIER_AGENT = Path(module_outils.__file__).parent
+VERBES_ECRITURE = ("set", "create", "update", "delete", "send", "write", "post", "put", "add")
+
+
+def test_aucun_outil_d_ecriture() -> None:
+    for nom in NOMS_OUTILS:
+        assert nom.split("_")[0] in {"get", "list"}
+    publiques = [n for n in dir(OutilsConsultation) if not n.startswith("_")]
+    assert sorted(publiques) == sorted(NOMS_OUTILS)
+    assert not [n for n in publiques if n.startswith(VERBES_ECRITURE)]
+
+
+def test_modules_agent_n_importent_que_contrats_et_consultation() -> None:
+    autorises = {"usine.contrats", "usine.ports.consultation", "usine.ia.agent"}
+    for fichier in DOSSIER_AGENT.glob("*.py"):
+        if fichier.name == "cli.py":
+            continue
+        source = fichier.read_text(encoding="utf-8")
+        assert "url_ticket" not in source
+        assert "source_tickets" not in source
+        for noeud in ast.walk(ast.parse(source)):
+            noms: list[str] = []
+            if isinstance(noeud, ast.ImportFrom) and noeud.level == 0 and noeud.module:
+                noms = [noeud.module]
+            elif isinstance(noeud, ast.Import):
+                noms = [a.name for a in noeud.names]
+            for nom in noms:
+                if nom.startswith("usine"):
+                    assert any(nom == a or nom.startswith(a + ".") for a in autorises), (
+                        f"{fichier.name} importe {nom}"
+                    )
+                assert not nom.startswith(("pydantic_ai", "httpx", "anthropic"))
+
+
+# --- Passage réel ---
+
+
+def test_integration_passage_palier_2() -> None:
+    cas = passage_palier_2()
+    outils: dict[str, Any] = {o.nom: o for o in outils_consultation(cas.consultation)}
+    jour = cas.consultation.manifeste().date_arrete
+    for nom in OUTILS_DATES:
+        resultat = outils[nom].executer({"entite": cas.entite})
+        assert isinstance(resultat, RESULTATS[nom]), nom
+        assert resultat.date_arrete == jour
+    meteo = outils["get_meteo"].executer({"entite": cas.entite})
+    assert meteo.meteos
+    assert all(e.entite == cas.entite for e in meteo.evolutions)
+    assert outils["get_prevision"].executer({"entite": cas.entite}).previsions
+    assert outils["get_tendance"].executer({}).points
+    anomalies = outils["list_anomalies"].executer({"entite": cas.entite})
+    assert anomalies.total >= len(anomalies.anomalies) > 0
+    statut = anomalies.anomalies[0].statut
+    toutes = outils["list_anomalies"].executer({"entite": cas.entite, "limite": 10_000})
+    attendu = sum(a.statut is statut for a in toutes.anomalies)
+    filtre = outils["list_anomalies"].executer({"entite": cas.entite, "statut": statut.value})
+    assert filtre.total == attendu > 0
+    assert all(a.statut is statut for a in filtre.anomalies)
+    sans = outils["get_meteo"].executer({"date_arrete": "2020-01-01"})
+    assert sans == AucuneDonnee(date_arrete=date(2020, 1, 1))
